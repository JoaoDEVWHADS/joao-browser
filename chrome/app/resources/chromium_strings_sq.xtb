<!DOCTYPE translationbundle>
<translationbundle lang="sq">
<translation id="1026101648481255140">Rifillo instalimin</translation>
<translation id="1029669172902658969">Nise sërish për të përditësuar ChromiumOS</translation>
<translation id="4711726241445951349">João Browser rekomandon që ta rinovosh këtë shtesë</translation>
<translation id="1042552502243217427">Kur një sajt kërkon të ngarkojë paraprakisht lidhje në mënyrë private në faqen e tij, Chromium përdor serverët e Google. Kjo e fsheh identitetin tënd nga sajti i ngarkuar paraprakisht, por Google mëson se çfarë sajtesh ngarkohen paraprakisht.</translation>
<translation id="1051793555070215510">Na ndihmo të përmirësojmë modalitetin "I fshehtë" duke plotësuar këtë anketë 1-minutëshe.</translation>
<translation id="1065672644894730302">Preferencat e tua nuk mund të lexohen.

Disa funksione mund të mos ofrohen dhe ndryshimet në preferenca nuk do të ruhen.</translation>
<translation id="3937976866851867994">Prindi yt ka çaktivizuar "Lejet për sajtet, aplikacionet dhe shtesat" për João Browser</translation>
<translation id="8626021334348319355">Për të kërkuar një veçori ose shtesë specifike të João Browser, shkruaj shkurtoren e saj në shiritin e adresave, të ndjekur nga tasti i zgjedhur i tastierës</translation>
<translation id="9157778882771986870">João Browser dëshiron të eksportojë fjalëkalimet e tua. Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="112640046208448578">Identifiko gjërat ose vendet dhe kopjo ose përkthe tekstin. Kur përdor "Kërkimin nëpërmjet imazheve", një pamje ekrani e faqes dërgohet te serveri. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium është shfletuesi yt i parazgjedhur</translation>
<translation id="1131805035311359397">Për të kontrolluar nëse fjalëkalimet e tua janë të sigurta nga nxjerrjet e paautorizuara të të dhënave dhe probleme të tjera të sigurisë, <ph name="BEGIN_LINK" />identifikohu në Chromium<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">Kliko te menyja e João Browser</translation>
<translation id="1157985233335035034">Gjuhët e fundit</translation>
<translation id="1184145431117212167">Instalimi dështoi pasi versioni yt i Windows nuk mbështetet.</translation>
<translation id="1185134272377778587">Rreth Chromium</translation>
<translation id="667420476518265356">Merr sinjalizime për monitorimin e çmimeve me João Browser në telefonin tënd</translation>
<translation id="1203500561924088507">Faleminderit që e instalove. Duhet të rinisësh shfletuesin përpara se të përdorësh <ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">Kur hap "Kërkimin e imazheve", titulli i faqes, URL-ja dhe përmbajtja, duke përfshirë skedarët PDF, do të dërgohen automatikisht te serveri. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">Kur je i identifikuar, mund të përdorësh fjalëkalimet dhe më shumë nga "Llogaria jote e Google" në João Browser. Për ta ndryshuar këtë, shko te "Llogaria jote në João Browser".</translation>
<translation id="4866003137980530528">Shfaq Gemini në João Browser në shiritin e menysë së Mac</translation>
<translation id="2526294198551578217">Për të zgjedhur një pjesë të ekranit në Gemini në João Browser, përdor shkurtoren e tastierës.</translation>
<translation id="7068536367561625920">Kur kjo skedë ishte joaktive, memoria u lirua që João Browser të vazhdojë të jetë i shpejtë. Mund të zgjedhësh që ta përjashtosh gjithmonë këtë sajt nga caktimi si joaktiv.</translation>
<translation id="3669854427836618143">João Browser e bllokoi këtë shkarkim sepse skedari është i rrezikshëm</translation>
<translation id="126567311906253476">Kur identifikohesh me <ph name="USER_EMAIL" /> në shërbimet e Google, si p.sh. Gmail ose YouTube, mund të identifikohesh automatikisht në Chromium me të njëjtën llogari</translation>
<translation id="8094399825947986050">Merr João Browser në telefonin tënd</translation>
<translation id="1290883685122687410">Gabim në konfigurim: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">Konfiguro profilin tënd të ri të João Browser</translation>
<translation id="7591029065989504977">Provo me Gemini në João Browser</translation>
<translation id="8408989583029959522">João Browser ka nevojë për qasje te Bluetooth-i për të eksploruar pajisjet me Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">Identifikohu në João Browser në telefonin tënd</translation>
<translation id="1330562121671411446">Zbulo gjuhën</translation>
<translation id="6026568602942276348">Fshi po ashtu të dhënat nga João Browser (<ph name="URL" />)</translation>
<translation id="1345251407431278948">U gozhdua! Mund të qasesh përsëri te "Kërkimi nëpërmjet imazheve" nga butoni i ri në shiritin e veglave</translation>
<translation id="1356661055722410047">E re! Mund të përkthesh tekstet dhe imazhet në ekranin tënd</translation>
<translation id="1383876407941801731">Kërko</translation>
<translation id="5807085300679014096">Përdor aplikacionin e João Browser për të vazhduar të shfletosh kur je në lëvizje</translation>
<translation id="141901961143729572">Ndaj mendimet e tua</translation>
<translation id="3736947618013031173">Për të ndarë dritaren tënde, lejo regjistrimin e ekranit për João Browser te "Cilësimet e sistemit".</translation>
<translation id="1478370723027452770">Merr ndihmë për Chrome for Testing</translation>
<translation id="1497802159252041924">Gabim gjatë instalimit: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Kjo faqe është e mbrojtur</translation>
<translation id="4379865404970367448">Ndaj një skedë të João Browser</translation>
<translation id="4436275659297289591">Identifikohu në João Browser</translation>
<translation id="1547469039832541117">Përfundon detyrën e theksuar.</translation>
<translation id="449712764049695153">Gozhdo João Browser</translation>
<translation id="1574377791422810894">Veglat e sigurisë të Chromium</translation>
<translation id="5480232403718129394">João Browser dëshiron të fshijë të dhënat e tua të "Menaxherit të fjalëkalimeve". Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{Administratori yt kërkon që të hapësh përsëri João Browser për të zbatuar këtë përditësim}=1{Administratori yt kërkon që të hapësh përsëri João Browser për të zbatuar këtë përditësim Dritarja jote "e fshehtë" nuk do të rihapet.}other{Administratori yt kërkon që të hapësh përsëri João Browser për të zbatuar këtë përditësim # dritaret e tua "të fshehta" nuk do të rihapen.}}</translation>
<translation id="980976428162070137">Merr më të mirën e Google me aplikacionin e João Browser në telefonin tënd</translation>
<translation id="1625909126243026060">Shqyrto kontrollet kryesore të sigurisë dhe privatësisë në Chromium</translation>
<translation id="1640672724030957280">Po shkarkohet...</translation>
<translation id="1665602916345474427">Identifikuar si <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, anëtarësim. Hap menynë e llogarisë</translation>
<translation id="1708414395296835197">Mund të përdorësh Chromium sa herë që klikon te lidhjet në mesazhe, dokumente dhe aplikacione të tjera. Ai do të gozhdohet gjithashtu te shiriti i detyrave.</translation>
<translation id="1709772298389099340">Ofron privilegje të larta për <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Kjo do të të lejojë që të zgjedhësh nga pajisjet e disponueshme dhe të shfaqësh përmbajtjet në to.</translation>
<translation id="6972087163510342335">João Browser do t'i fshijë së shpejti të dhënat e shfletimit</translation>
<translation id="1736443181683099871">Chromium do të përpiqet t'i përmirësojë navigimet në HTTPS</translation>
<translation id="3879288383593333401">Të dhënat e João Browser u pastruan</translation>
<translation id="656496276885630888">João Browser do të riniset pas <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Kur HTTPS nuk ofrohet, Chromium do të përdorë një lidhje të pasigurt pa të të paralajmëruar</translation>
<translation id="1226290419185955779">Lejo që João Browser të ekzekutohet në sfond</translation>
<translation id="4231366995273072370">Për ta bërë më të sigurt João Browser, çaktivizuam disa shtesa që nuk janë të listuara në <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> dhe që mund të jenë shtuar pa dijeninë tënde.</translation>
<translation id="1822049153969905781">Kliko te <ph name="BEGIN_BOLD" />Po<ph name="END_BOLD" /> në njoftimin e Windows për të gozhduar João Browser te shiriti i detyrave për qasje të shpejtë.</translation>
<translation id="1321831992638405531">Instalo përsëri João Browser</translation>
<translation id="3386967202064865436">João Browser po përpiqet <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="70054449700528483">Herën tjetër që të hapësh João Browser në <ph name="DEVICE_TYPE" />, do të shikosh një kërkesë për të përdorur "Menaxherin e fjalëkalimeve të Google".</translation>
<translation id="1838374766361614909">Fshi kërkimin</translation>
<translation id="5807096362853316123">Për t'i fshirë të dhënat e shfletimit vetëm nga kjo pajisje, ndërkohë që i mban ato në "Llogarinë tënde të Google", <ph name="BEGIN_LINK" />dil nga llogaria në João Browser<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">Shkarko João Browser në telefon për të hapur ose krijuar grupe të reja skedash kur je në lëvizje.</translation>
<translation id="185970820835152459">Mund t'i menaxhosh "Llogaritë e Google" ku je identifikuar. "Llogaritë e tua të Google" përdoren për shfletuesin Chromium, Play Store, Gmail etj. Nëse do të shtosh një llogari për dikë tjetër, si p.sh. anëtar të familjes, shto më mirë një person të ri te <ph name="DEVICE_TYPE" /> yt. <ph name="LINK_BEGIN" />Mëso më shumë<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Kërko me "Kërkimin nëpërmjet imazheve"</translation>
<translation id="65457771685016683"><ph name="EXISTING_USER" /> është identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në João Browser në profilin tënd si <ph name="USER_EMAIL_ADDRESS" />. Do të marrësh gjithashtu faqeshënuesit e tu etj. nga <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Përzgjidh tekstin</translation>
<translation id="2634119629547215883">Po identifikohesh me një llogari të menaxhuar dhe po i jep administratorit të saj kontrollin mbi profilin tënd të João Browser. Të dhënat e tua të João Browser, si aplikacionet, faqeshënuesit, historiku, fjalëkalimet dhe cilësimet e tjera do të bëhen të lidhura përgjithmonë me <ph name="USER_NAME" />. Do të mund t'i fshish këto të dhëna nëpërmjet "Panelit të llogarive të Google", por nuk do të mund t'i lidhësh këto të dhëna me një llogari tjetër. Mund të krijosh si opsion një profil të ri për t'i mbajtur më vete të dhënat ekzistuese të João Browser. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium kursen energjinë e baterisë duke kufizuar aktivitetin në sfond dhe efektet vizuale, si p.sh. lëvizjen e butë dhe shpejtësitë e kuadrove të videove. <ph name="BEGIN_LINK" />Mëso më shumë për "Kursyesin e energjisë"<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">João Browser Updater Service</translation>
<translation id="1911763535808217981">Duke çaktivizuar këtë, mund të identifikohesh në sajtet e Google si Gmail pa u identifikuar në Chromium</translation>
<translation id="4037729269678342163">João Browser nuk përgjigjet. Dëshiron ta hapësh sërish tani?</translation>
<translation id="7563750688920581112">Organizata jote, <ph name="MANAGER" />, kërkon që të identifikohesh në João Browser</translation>
<translation id="193439633299369377">ChromiumOS ka nevojë të riniset për të zbatuar përditësimin.</translation>
<translation id="7099143775283792684">João Browser e bllokoi këtë shkarkim sepse lloji i skedarit nuk është shkarkuar zakonisht dhe mund të jetë i rrezikshëm</translation>
<translation id="1953553007165777902">Po shkarkohet... Kanë mbetur edhe <ph name="MINUTE" /> minuta</translation>
<translation id="1966382378801805537">Chromium nuk mund të përcaktojë ose caktojë shfletuesin e parazgjedhur</translation>
<translation id="197326043290947695">Shfleto në mënyrë më inteligjente me "Kërkimin e imazheve"</translation>
<translation id="6185556991023272801">Mëso se pse João Browser i bllokon disa skedarë, hapet në një skedë të re</translation>
<translation id="4053636705816895911">E mban të përditësuar softuerin e João Browser. Nëse ky shërbim çaktivizohet ose ndalohet, softueri yt i João Browser nuk do të mbahet i përditësuar, që do të thotë se dobësitë e sigurisë që mund të lindin nuk mund të rregullohen dhe veçoritë mund të mos funksionojnë. Ky shërbim çinstalohet vetë kur nuk ka një softuer të João Browser që e përdor atë.</translation>
<translation id="2008474315282236005">Kjo do të fshijë 1 artikull nga kjo pajisje. Për t'i marrë më vonë të dhënat, identifikohu te Chromium si <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Instalimi nuk u krye. Provo përsëri.</translation>
<translation id="2039417478970545937">Cilësimet.</translation>
<translation id="2049376729098081731">Zgjidh nëse do ta përfshish historikun e Chromium për përvoja më të personalizuara në shërbimet e Google</translation>
<translation id="6768767091114123654">I integruar në João Browser për të të ndihmuar të krijosh, ruash dhe plotësosh automatikisht fjalëkalime të forta. Shto shkurtoren për qasje të lehtë.</translation>
<translation id="3571664229232252557">Kliko te butoni "Personalizo João Browser" në faqen e skedës së re për t'i dhënë João Browser një pamje të re</translation>
<translation id="4273287215573278663">João Browser e bllokoi këtë shkarkim sepse skedari është mashtrues dhe mund të bëjë ndryshime të papritura në pajisjen tënde</translation>
<translation id="9063967192437499581">Do të shikosh një kërkesë për të provuar <ph name="FEATURE_NAME" /> herën tjetër kur të hapësh João Browser për iOS.</translation>
<translation id="8511569826706775962">Fjalëkalimet e tua dhe të dhënat e tjera të João Browser që ke ruajtur në "Llogarinë tënde të Google" do të hiqen nga kjo pajisje. Për t'i përdorur përsëri në João Browser, identifikohu përsëri.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{Organizata jote i fshin automatikisht të dhënat e shfletimit kur João Browser nuk përdoret për 1 minutë. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet. Skedat e tua do të qëndrojnë të hapura.}other{Organizata jote i fshin automatikisht të dhënat e shfletimit kur João Browser nuk përdoret për # minuta. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet. Skedat e tua do të qëndrojnë të hapura.}}</translation>
<translation id="2125838419757773031">Zgjidh rajonin e ekranit për të kërkuar</translation>
<translation id="2126108037660393668">Skedari i shkarkuar nuk u verifikua.</translation>
<translation id="2135919691573380097">Raportoje këtë sajt</translation>
<translation id="2137162749895930932">Mbyll ekranin e përkthimit</translation>
<translation id="1308845716497059117">João Browser e bllokoi këtë shkarkim sepse sajti nuk po përdor një lidhje të sigurt dhe mund të ketë pasur ndërhyrje te skedari</translation>
<translation id="2170098639895543546">Zgjidh çdo gjë në faqe</translation>
<translation id="6705844023496387932">Personalizo João Browser</translation>
<translation id="2174917724755363426">Instalimi nuk përfundoi. E konfirmon që dëshiron ta anulosh?</translation>
<translation id="7728290795259244895">João Browser - identifikimi në rrjet - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Gabim në kontrollin e përditësimeve: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">Hiqe llogarinë nga João Browser</translation>
<translation id="4648870374540039667">Përdor aplikacionin e João Browser për të marrë veglat më të mira të blerjeve kur je në lëvizje</translation>
<translation id="2106116820042118250">Qëndro më i sigurt në lëvizje me "Shfletimin e sigurt të përmirësuar" në João Browser për iOS</translation>
<translation id="2210682093923538346">Sajt i rrezikshëm. Chromium ka hequr njoftimet.</translation>
<translation id="2236949375853147973">Aktiviteti im</translation>
<translation id="118764235932893741">Për të marrë adresat etj. në të gjitha pajisjet e tua, identifikohu në João Browser. Kjo adresë do të ruhet në "Llogarinë tënde të Google" pasi të identifikohesh.</translation>
<translation id="7254578863532089400">Nëse e ndan një kompjuter, miqtë dhe familja mund të shfletojnë veçmas dhe ta konfigurojnë João Browser pikërisht ashtu si dëshirojnë.</translation>
<translation id="22571759390241347">"Aftësitë" në Chromium</translation>
<translation id="2283803047247799269">Kërko në këtë skedë me "Kërkimin e imazheve"</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{João Browser rekomandon vendosjen në pauzë të skedës që ngadalëson shfletuesin}other{João Browser rekomandon vendosjen në pauzë të skedave që ngadalësojnë shfletuesin}}</translation>
<translation id="2307973900865360088">Mbaje në "Stacion"</translation>
<translation id="2313870531055795960">Kontrollon URL-të kundrejt një liste sajtesh të pasigurta të ruajtur në Chromium. Nëse një sajt përpiqet të vjedhë fjalëkalimin tënd ose kur shkarkon një skedar të dëmshëm, Chromium mund t'i dërgojë gjithashtu URL-të, duke përfshirë pjesë të përmbajtjes së faqes, te "Shfletimi i sigurt".</translation>
<translation id="2356070529366658676">Pyet</translation>
<translation id="2359808026110333948">Vazhdo</translation>
<translation id="3800730051093461113">Shtesa "<ph name="EXTENSION_NAME" />" kërkon që të identifikohesh në João Browser</translation>
<translation id="8758735062658446604">Çaktivizo ekzekutimin e João Browser në sfond për aplikacionet</translation>
<translation id="2623595027619107207">Për ta përdorur këtë shtesë si <ph name="USER_EMAIL_ADDRESS" />, identifikohu në João Browser.</translation>
<translation id="2384373936468275798">ChromiumOS nuk mund t'i sinkronizonte të dhënat e tua sepse detajet e identifikimit të llogarisë janë të papërditësuara.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{Një ose disa shtesa të João Browser kanë pasur qasje në 1 pajisje HID}=1{Një ose disa shtesa të João Browser kanë qasje në 1 pajisje HID}other{Një ose disa shtesa të João Browser kanë qasje në # pajisje HID}}</translation>
<translation id="6254788431480237503">João Browser ka nevojë për lejet e kamerës dhe të mikrofonit për këtë sajt</translation>
<translation id="2403703063067034158">Gabim në nisje: aktualisht po ekzekutohet një shembull tjetër i konfigurimit; provo përsëri më vonë.</translation>
<translation id="3028975423343897358">Hap lidhjet në João Browser nga çdo aplikacion dhe mbaje shfletuesin të qasshëm në shiritin e detyrave</translation>
<translation id="579079006139156831">Kliko te butoni "Përmblidh" për ta ndarë këtë dokument me Gemini në João Browser për të marrë një përmbledhje të shpejtë dhe për të bërë pyetje vijuese</translation>
<translation id="2440750600860946460">Me <ph name="BEGIN_LINK" />veglat nga Chromium<ph name="END_LINK" />, mund të shfletosh në mënyrë të sigurt dhe të qëndrosh në kontroll</translation>
<translation id="7114471809991869757"><ph name="EXISTING_USER" /> është identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në João Browser në profilin tënd si <ph name="USER_EMAIL_ADDRESS" />. Do të marrësh gjithashtu fjalëkalimet etj. në të gjitha pajisjet e tua.</translation>
<translation id="2451727308784734061">Përdor shkurtoren tënde për të shkuar me shpejtësi te "Menaxheri i fjalëkalimeve". Mund ta zhvendosësh shkurtoren tënde tek ekrani bazë i kompjuterit ose te nisësi i aplikacionit.</translation>
<translation id="2709136733469807397">João Browser do të mbyllet së shpejti</translation>
<translation id="3652225684487279741">Në João Browser</translation>
<translation id="2485422356828889247">Çinstalo</translation>
<translation id="2513154137948333830">Nevojitet rindezja: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Zgjidh tekstin nga "Kërkimi nëpërmjet imazheve"</translation>
<translation id="1527474262707362156">João Browser po përpiqet të zëvendësojë fjalëkalimet ekzistuese. Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="6480371226914552131">João Browser ka nevojë për qasje te hapësira ruajtëse për të shkarkuar skedarë</translation>
<translation id="6318568902186985084">Ndihmuesi i João Browser</translation>
<translation id="2575822587468774919">Zgjidh çdo gjë për të kërkuar me "Kërkimin nëpërmjet imazheve"</translation>
<translation id="4557210258834653476">Për të marrë fjalëkalimet etj. në të gjitha pajisjet e tua, identifikohu në João Browser</translation>
<translation id="1148164459654218834">Skano kodin QR me telefonin tënd për të shkarkuar João Browser dhe identifikohu në "Llogarinë tënde të Google".</translation>
<translation id="235892353478111963">Vazhdo të përdorësh João Browser</translation>
<translation id="259935314519650377">Instaluesi i shkarkuar nuk u ruajt te memoria specifike. Gabim: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Sistemi</translation>
<translation id="8471946631262724853">Organizata jote mund të shikojë dhe të menaxhojë të dhënat e shfletimit, si p.sh. faqeshënuesit, historikun dhe fjalëkalimet e tua. Ajo nuk mund të shikojë të dhënat e shfletimit në profilet e tjera të João Browser</translation>
<translation id="2870759219964376597">Verifiko që je ti për të përdorur dhe ruajtur të dhënat e João Browser në llogarinë tënde <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="2955972712254986678">{COUNT,plural, =0{"Mbrojtja e përparuar" kërkon që të hapësh përsëri João Browser për të zbatuar një përditësim}=1{"Mbrojtja e përparuar" kërkon që të hapësh përsëri João Browser për të zbatuar një përditësim. Dritarja jote "e fshehtë" nuk do të rihapet.}other{"Mbrojtja e përparuar" kërkon që të hapësh përsëri João Browser për të zbatuar një përditësim. # dritaret e tua "të fshehta" nuk do të rihapen.}}</translation>
<translation id="8949462882238006192">Nis João Browser</translation>
<translation id="4224214204752803768">Ndodhi një gabim në sistemin operativ gjatë instalimit. Shkarko përsëri João Browser.</translation>
<translation id="3141414135710372892">Nëse e ndan një pajisje, miqtë dhe familja mund të shfletojnë veçmas dhe ta konfigurojnë João Browser pikërisht ashtu si dëshirojnë</translation>
<translation id="8838607803339100223">Qasu me lehtësi për të përdorur Gemini në João Browser në pajisjen tënde, edhe nëse João Browser është i minimizuar.</translation>
<translation id="1679364578146271696">Skeda João Browser</translation>
<translation id="2718390899429598676">Për më shumë siguri, Chromium do t'i enkriptojë të dhënat e tua.</translation>
<translation id="1874696651662237927">Për ta hequr "Llogarinë tënde të Google" nga João Browser, dil nga llogaria</translation>
<translation id="6850669719663104304">Për të marrë fjalëkalimet, faqeshënuesit etj. në të gjitha pajisjet e tua, identifikohu në João Browser</translation>
<translation id="2738871930057338499">Lidhja me internetin nuk mund të kryhej. HTTP 403 (E ndaluar). Kontrollo konfigurimin e proxy-t.</translation>
<translation id="2753623023919742414">Kliko për të kërkuar</translation>
<translation id="4193420110872590792">Cakto João Browser si shikuesin e parazgjedhur të skedarëve PDF</translation>
<translation id="6614401181366354261">Kjo shtesë përmban softuerë keqdashës dhe nuk është e sigurt. Hiqe atë nga João Browser që të mos arrijë të shikojë dhe të ndryshojë më të dhënat e tua në sajtin që viziton ti, duke përfshirë informacionet e tua personale.</translation>
<translation id="2799223571221894425">Nis sërish</translation>
<translation id="6299858290790311689">Shfletuesi yt João Browser</translation>
<translation id="2816462166102338036">Kërkoje këtë video me "Kërkimin e imazheve"</translation>
<translation id="5896458971800337862">Zbulo produkte me kamerën tënde, monitoro uljet e çmimeve etj. kur je në lëvizje me João Browser në iOS.</translation>
<translation id="2841525013647267359">Përkthe nga</translation>
<translation id="2846251086934905009">Gabim gjatë instalimit: Instaluesi nuk përfundoi. Instalimi është ndërprerë.</translation>
<translation id="4357241592510111611">Hiqe nga João Browser...</translation>
<translation id="2850691299438350830">Të mban të sigurt në Chromium dhe mund të përdoret për të përmirësuar sigurinë tënde në aplikacionet e tjera të Google kur je i identifikuar</translation>
<translation id="2885378588091291677">Menaxheri i detyrave</translation>
<translation id="8887040619780090085">Rreth &amp;João Browser</translation>
<translation id="2915996080311180594">Rinise më vonë</translation>
<translation id="6619708652934279502">Të dhënat e tua janë të enkriptuara me frazën tënde të kalimit. Fute atë për të përdorur dhe ruajtur të dhënat e João Browser në "Llogarinë tënde të Google".</translation>
<translation id="2945997411976714835">Gabim gjatë instalimit: Nisja e procesit të instaluesit dështoi.</translation>
<translation id="4566114009566397386">Identifikohu më shpejt në sajte duke përdorur fjalëkalimet e ruajtura për João Browser në iOS</translation>
<translation id="562175540137901632">Organizata jote menaxhon João Browser</translation>
<translation id="2977470724722393594">Chromium është i përditësuar</translation>
<translation id="2977506796191543575">Nëse një sajt përpiqet të vjedhë fjalëkalimin tënd ose kur shkarkon një skedar të dëmshëm, Chromium mund t'i dërgojë gjithashtu URL-të, duke përfshirë pjesë të përmbajtjes së faqeve, te "Shfletimi i sigurt".</translation>
<translation id="1776205510657237623">Për të qëndruar më i sigurt online me zgjedhjet e prindit tënd, identifikohu në João Browser</translation>
<translation id="3003694935412297923">Të gjitha detyrat</translation>
<translation id="3374694374267805392">{count,plural, =1{João Browser duhet të verifikojë që je ti përpara se të mund të ruhen disa të dhëna në "Llogarinë tënde të Google" dhe të përdoren në të gjitha pajisjet e tua. Nëse del tani, këto të dhëna (1 artikull) do të fshihen.}other{João Browser duhet të verifikojë që je ti përpara se të mund të ruhen disa të dhëna në "Llogarinë tënde të Google" dhe të përdoren në të gjitha pajisjet e tua. Nëse del tani, këto të dhëna ({count} artikuj) do të fshihen.}}</translation>
<translation id="4915792193596835645">Hap <ph name="URL" /> në një skedë të re në João Browser.</translation>
<translation id="302551344979399011">Novacionet e IA-së, si p.sh. aftësitë, ruhen në "Llogarinë tënde të Google" dhe menaxhohen veçmas nga sinkronizimi i Chromium</translation>
<translation id="8367114375553489372">Po shton në João Browser...</translation>
<translation id="3038232873781883849">Në pritje të instalimit...</translation>
<translation id="3045032126857188731">Gjuha e përkthyer: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Mbyll dialogun e komenteve</translation>
<translation id="6168172692486433600">Profilet e tjera të João Browser</translation>
<translation id="884929993636327">Shtesat janë veçori shtesë që të lejojnë të personalizosh João Browser. Nga ruajtja e organizimit e deri te thjeshtimi i detyrave të përditshme, shtesat të ndihmojnë të personalizosh João Browser.</translation>
<translation id="1525897524206034002">Ndihmo në përmirësimin e João Browser duke dërguar te Google raportet e ndërprerjeve aksidentale dhe <ph name="UMA_LINK" /></translation>
<translation id="2766971658743453990">Përdor aplikacionin e João Browser për të marrë sigurinë e Google në lëvizje</translation>
<translation id="4387884830246074210">{NUM_DEVICES,plural, =0{Një ose disa shtesa të João Browser kanë pasur qasje në 1 pajisje USB}=1{Një ose disa shtesa të João Browser kanë qasje në 1 pajisje USB}other{Një ose disa shtesa të João Browser kanë qasje në # pajisje USB}}</translation>
<translation id="3413144813287436446">Historiku i João Browser</translation>
<translation id="9192419056064225629">Instaluesi nuk arriti ta nxjerrë arkivin. Shkarko përsëri João Browser.</translation>
<translation id="310459126943037700">Përfundimi i detyrave dështoi.</translation>
<translation id="3104828284009500087">Kërko për çdo gjë në faqe</translation>
<translation id="3508468328135806512">Mbaji fjalëkalimet, faqeshënuesit dhe historikun të sinkronizuar në mënyrë të përsosur në pajisje. Qasu me lehtësi te veçoritë që njeh dhe që të pëlqejnë duke e përditësuar shfletuesin tënd të parazgjedhur në João Browser.</translation>
<translation id="3216151988142306917">João Browser po përdor mikrofonin tënd.</translation>
<translation id="3130333203120345554">Kërkim i ri</translation>
<translation id="3137969841538672700">Zvarrit për të kërkuar</translation>
<translation id="7493177208577109722">Kjo skedë po përdor burime shtesë. Për të përmirësuar performancën tënde, lejo që João Browser ta bëjë atë joaktive.</translation>
<translation id="7239354789967255675">Për të ndarë ekranin, lejo regjistrimin e ekranit për João Browser te "Cilësimet e sistemit"</translation>
<translation id="4955872590603594814">Rinis João Browser</translation>
<translation id="3161522574479303604">Të gjitha gjuhët</translation>
<translation id="4697739132113629685">Hape lidhjen në një dritare të fshe&amp;htë të João Browser</translation>
<translation id="1629247860984475766">Personalizo profilin tënd të ri të João Browser</translation>
<translation id="1905008150929775692">Mund të vazhdosh të bisedosh me "Modalitetin e IA-së" pa ndërruar skedat. Për të filluar, identifikohu në João Browser. Do të marrësh gjithashtu fjalëkalimet dhe më shumë në të gjitha pajisjet e tua.</translation>
<translation id="4232381420311815141">Për ta hequr "Llogarinë tënde të Google" nga João Browser, dil nga llogaria në João Browser te faqja e "Cilësimeve"</translation>
<translation id="3234316605225071811">Më vonë, Chromium mund të të pyesë nëse dëshiron të përdorësh informacionet e ruajtura për të plotësuar automatikisht formularët për ty</translation>
<translation id="6676749542734993844">João Browser nuk mund të lexojë dhe shkruajë në direktorinë e tij të të dhënave:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">Merr veglat e tua të preferuara të IA-së së Google kur je në lëvizje me João Browser në iOS.</translation>
<translation id="3286538390144397061">Rindiz tani</translation>
<translation id="532528773927600103">Çelësat API të Google mungojnë. Disa funksione të João Browser do të çaktivizohen.</translation>
<translation id="3296368748942286671">Vazhdo funksionimin e aplikacioneve në sfond kur Chromium është i mbyllur</translation>
<translation id="3313189106987092621">Chromium do të të paralajmërojë para se të ngarkojë një sajt duke përdorur një lidhje të pasigurt</translation>
<translation id="8095477191923518137">Do të dalësh nga shumica e sajteve kur të mbyllësh të gjitha dritaret e João Browser, përveçse nga "Llogaria jote e Google" nëse je i identifikuar në João Browser. Për t'i lejuar sajtet që të të kujtojnë, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">këndi lart djathtas i zonës së kërkimit: djathtas <ph name="RIGHT" />%, lart<ph name="TOP" />%</translation>
<translation id="3366305173356742781">Të dhënat e Chromium në llogarinë tënde</translation>
<translation id="3234882977104294240">Përdor fjalëkalimet e tua me João Browser në telefonin tënd</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="2974199599420431595">Të kalohet te profili ekzistues i João Browser?</translation>
<translation id="3412460710772753638">Në "Menaxherin e fjalëkalimeve" në këtë pajisje</translation>
<translation id="3438772217992559640">Kërkoje këtë skedë me "Kërkimin e imazheve"</translation>
<translation id="8318147705317768982">Zgjero "Shfletimin e sigurt të përmirësuar" me João Browser në telefonin tënd</translation>
<translation id="347392028839310978">João Browser po personalizohet...</translation>
<translation id="3474745554856756813">Kjo do të fshijë <ph name="ITEMS_COUNT" /> artikuj nga kjo pajisje. Për t'i marrë më vonë të dhënat, identifikohu te Chromium si <ph name="USER_EMAIL" />.</translation>
<translation id="5805833167703404998"><ph name="SHORTCUT" /> mund të kalojë nga një profil i João Browser te një tjetër</translation>
<translation id="1835124883585653877">Mbyll të gjitha dritaret e João Browser dhe provo sërish.</translation>
<translation id="7106246566966568195">Për të ndarë dritaren tënde, lejo regjistrimin e ekranit për João Browser te "Cilësimet e sistemit"</translation>
<translation id="6017005873246021363"><ph name="EXISTING_USER" /> është i identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në João Browser në profilin tënd si <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="1146681170626381319">Kodi QR për të shkarkuar shfletuesin João Browser në pajisjet celulare</translation>
<translation id="354621070532799440">Rikujtesë: Veçoritë më të mira të sigurisë të Google në xhepin tënd</translation>
<translation id="2488701737291439763">Për të ndarë ekranin, lejo regjistrimin e ekranit për João Browser te "Cilësimet e sistemit".</translation>
<translation id="3588112919289558122">Mbrojtja e përmirësuar e çaktivizon optimizimin e JavaScript për sajtet që Chromium nuk i njeh</translation>
<translation id="3597003331831379823">Ekzekutimi i konfigurimit me privilegje të larta dështoi. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">Identifikohu në João Browser</translation>
<translation id="5985252758124395804">Të dhënat e shfletimit të këtij personi do të fshihen nga kjo pajisje. Për të rikuperuar të dhënat, identifikohu në João Browser si <ph name="USER_EMAIL" />.</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{Ka një përditësim të ri për João Browser dhe do të zbatohet sapo ta rinisësh.}=1{Ka një përditësim të ri për João Browser dhe do të zbatohet sapo ta rinisësh. Dritarja jote "e fshehtë" nuk do të rihapet.}other{Ka një përditësim të ri për João Browser dhe do të zbatohet sapo ta rinisësh. # dritaret e tua "të fshehta" nuk do të rihapen.}}</translation>
<translation id="3667616615096815454">Instalimi nuk mund të kryhej. Aplikacioni është i panjohur për serverin.</translation>
<translation id="3675854891107786059">Përdor <ph name="BEGIN_LINK" />frazën tënde të kalimit<ph name="END_LINK" /> për të enkriptuar të gjitha të dhënat e Chromium në "Llogarinë tënde të Google". Mënyrat e pagesës dhe adresat nga Google Pay nuk do të enkriptohen. Historiku i shfletimit nga Chromium nuk do të sinkronizohet.</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{Administratori yt kërkon që të hapësh përsëri João Browser për të zbatuar këtë përditësim}=1{Administratori yt kërkon që të hapësh përsëri João Browser për të zbatuar këtë përditësim Dritarja jote "e fshehtë" nuk do të rihapet.}other{Administratori yt kërkon që të hapësh përsëri João Browser për të zbatuar këtë përditësim # dritaret e tua "të fshehta" nuk do të rihapen.}}</translation>
<translation id="4134769722455445399">Hape lidhjen në një &amp;skedë të re të João Browser</translation>
<translation id="3728124580182886854">Lidh Chromium dhe shërbimet e tjera të Google për personalizimin dhe qëllime të tjera</translation>
<translation id="3729187154190517324">Thelloje kërkimin duke shtuar disa skeda, skedarë dhe vegla duke përdorur butonin "Shto një skedë dhe më shumë".</translation>
<translation id="655691042235349825">Menaxho profilet e João Browser</translation>
<translation id="8494798931804571569">Mëso se pse João Browser i bllokon disa shkarkime</translation>
<translation id="379589255253486813">Chromium do të të informojë nëse duhet të rishikosh diçka</translation>
<translation id="3802055581630249637">Chromium ngarkon paraprakisht faqet që mund t'i vizitosh që ato të ngarkohen më shpejt kur t'i vizitosh</translation>
<translation id="3810973564298564668">Menaxho</translation>
<translation id="6945066279282141856">Për të përdorur fjalëkalimet e ruajtura, ndiq kodin QR, shkarko João Browser për iOS dhe identifikohu në "Llogarinë tënde të Google"</translation>
<translation id="3846683726093018685">**Përmblidh:** Në një fjali të vetme deri në 30 fjalë, përshkruaj subjektin kryesor dhe qëllimin e përmbajtjes në pamjen e ekranit.

          **Sugjero pyetje:** Gjenero një listë me pika prej 3 deri në 5 pyetje që nxisin të menduarit dhe që mund të bëhen nga një përdorues për të kuptuar më mirë pamjen e ekranit. Këto pyetje duhet të përfshijnë të paktën një pyetje që ka të bëjë në mënyrë specifike me një objekt vizual, dizajnin ose vendosjen e tij.</translation>
<translation id="4996569675441627032"><ph name="PAGE_TITLE" /> - João Browser</translation>
<translation id="6008740052107737825">João Browser ka nevojë për lejen e rrjetit lokal për këtë sajt</translation>
<translation id="3885770153807205175">Zgjedhësi i gjuhës</translation>
<translation id="2390004682597453662">Personalizo dhe kontrollo João Browser. Diçka ka nevojë për vëmendjen tënde - kliko për detaje.</translation>
<translation id="8262407643678629134">Kliko emrin tënd për të hapur João Browser dhe fillo shfletimin.</translation>
<translation id="3892148308691398805">Kopjo tekstin</translation>
<translation id="2168201717554927204"><ph name="EXISTING_USER" /> është i identifikuar tashmë në këtë profil të João Browser. Për ta mbajtur shfletimin tënd të ndarë, João Browser mund të krijojë profilin tënd personal për ty.</translation>
<translation id="1046732460303790107">Kjo shtesë shkel politikën e "Dyqanit të uebit të Chrome" dhe mund të mos jetë e sigurt. Hiqe atë nga João Browser që të mos arrijë të shikojë dhe të ndryshojë më të dhënat e tua në sajtin që viziton ti, duke përfshirë informacionet e tua personale.</translation>
<translation id="3941890832296813527">Gabim gjatë instalimit: Emri i skedarit të instaluesit është i pavlefshëm ose nuk mbështetet.</translation>
<translation id="3879366121647289622">João Browser po përpiqet të kopjojë fjalëkalimet. Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="7332365758981378072">Fjalëkalimet e tua, mënyrat e pagesës dhe adresat që ke ruajtur në "Llogarinë tënde të Google" do të hiqen nga kjo pajisje. Për t'i përdorur përsëri në João Browser, identifikohu përsëri.</translation>
<translation id="395904275706073188">Faqet e mbrojtura nuk mund të lexohen. Provo një faqe tjetër.</translation>
<translation id="3962647064319009959">Mëso se si të mban të sigurt Chromium</translation>
<translation id="3967822245660637423">Shkarkimi përfundoi</translation>
<translation id="3971865010372729242">Kur shkruan në shiritin e adresave ose kutinë e kërkimit, Chromium i dërgon ato që ti shkruan te veglat e kërkimit, IA-së dhe agjentit të organizatës sate për të marrë sugjerime.</translation>
<translation id="3975724895399328945">Rreth &amp;Google Chrome for Testing</translation>
<translation id="3997429360543082038">Rreth ChromiumOS</translation>
<translation id="4010059961270896984">Kur ti viziton një sajt, Chromium dërgon një pjesë të pakuptueshme të URL-së te <ph name="BEGIN_LINK" />"Shfletimi i sigurt" i Google<ph name="END_LINK" /> nëpërmjet një serveri të privatësisë që e fsheh adresën tënde IP. Nëse një sajt bën diçka të dyshimtë, dërgohen edhe URL-të e plota dhe pjesët e përmbajtjeve të faqeve.</translation>
<translation id="4016217212818346953">Qëndro i sigurt me "Menaxherin e fjalëkalimeve"</translation>
<translation id="4019629340646866719">ChromiumOS mundësohet nga <ph name="BEGIN_LINK_CROS_OSS" />softuerë shtesë me burim të hapur<ph name="END_LINK_CROS_OSS" />, si p.sh. <ph name="BEGIN_LINK_LINUX_OSS" />mjedisi i zhvillimit të Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">Përkthe ekranin</translation>
<translation id="4023601594785368013">Gjuha origjinale: <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">Hap lidhjet në João Browser nga çdo aplikacion. Dhe për qasje të lehtë, ai gozhdohet te shiriti yt i veglave.</translation>
<translation id="4036079820698952681">Ndihmo në përmirësimin e Chromium duke raportuar <ph name="BEGIN_LINK" />cilësimet aktuale<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Përmirësime të rëndësishme sigurie dhe funksione të reja ofrohen në versionin e fundit.</translation>
<translation id="4055805654398742145">Men&amp;axheri i fjalëkalimeve</translation>
<translation id="615818333141511791">{COUNT,plural, =1{Organizata jote e mbyll automatikisht João Browser kur ai nuk përdoret për 1 minutë. Të dhënat e shfletimit do të fshihen. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet.}other{Organizata jote e mbyll automatikisht João Browser kur ai nuk përdoret për # minuta. Të dhënat e shfletimit do të fshihen. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet.}}</translation>
<translation id="4118474109249235144">Modaliteti "i fshehtë" i Chromium</translation>
<translation id="4122186850977583290">Shko te faqja "Rreth Chromium"</translation>
<translation id="9207280419664362385">Personalizo João Browser për t'i dhënë një pamje të re shfletuesit tënd</translation>
<translation id="3719803995198923598">Personalizo João Browser</translation>
<translation id="4148957013307229264">Po instalohet...</translation>
<translation id="2954462321765112214"><ph name="PAGE_TITLE" /> - identifikimi në rrjet - João Browser</translation>
<translation id="7812363663832111420">Zbulo aplikacione, lojëra, shtesa dhe tema të mrekullueshme për João Browser.</translation>
<translation id="69200600645763018">Për të marrë këtë shtesë dhe më shumë në të gjithë kompjuterët e tu, identifikohu në João Browser</translation>
<translation id="7505863944027312744">Për të qëndruar më i sigurt online me zgjedhjet e prindit tënd, kalo te profili yt i João Browser ku je i identifikuar tashmë si <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Po e anulon...</translation>
<translation id="4224210481850767180">Instalimi është anuluar.</translation>
<translation id="8090594705972340646">Të lidhen të dhënat e tua të João Browser me këtë llogari?</translation>
<translation id="4251772536351901305">Të paralajmëron për sajtet e rrezikshme, edhe ato që Google nuk i ka njohur më parë, duke analizuar më shumë të dhëna nga sajtet sesa nga mbrojtja standarde. Mund të zgjedhësh që t'i kapërcesh paralajmërimet e Chromium.</translation>
<translation id="5696119579094527589">Dil nga João Browser</translation>
<translation id="4271805377592243930">Merr ndihmë me Chromium</translation>
<translation id="4281844954008187215">Kushtet e shërbimit</translation>
<translation id="1245307320228150348">Instalimi dështoi për shkak të një gabimi të paspecifikuar. Nëse João Browser është aktualisht në ekzekutim, mbylle dhe provo përsëri.</translation>
<translation id="7405356088321579627">Eksporto fjalëkalimet nga João Browser</translation>
<translation id="4304713468139749426">Menaxheri i fjalëkalimeve</translation>
<translation id="4334241893986177674">Kërko në këtë pamje ekrani</translation>
<translation id="212570256141568951">Nis João Browser kur të niset Windows</translation>
<translation id="4400772909124543403">Nuk ofrohet asnjë përditësim</translation>
<translation id="7463042547966071103">Dëshiron të dalësh nga João Browser gjithsesi?</translation>
<translation id="4413205837991854510">Shfaq gjithmonë shkurtoren e "Kërkimit nëpërmjet imazheve"</translation>
<translation id="4736206301215400753">Lejo që João Browser të ekzekutohet në sfond</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{João Browser rekomandon që ta heqësh atë. <ph name="BEGIN_LINK" />Mëso më shumë rreth shtesave të mbështetura<ph name="END_LINK" />}other{João Browser rekomandon që t'i heqësh ato. <ph name="BEGIN_LINK" />Mëso më shumë rreth shtesave të mbështetura<ph name="END_LINK" />}}</translation>
<translation id="5305058100936019600">Personalizo dhe kontrollo João Browser</translation>
<translation id="4427306783828095590">Mbrojtja e përmirësuar bën edhe më shumë për bllokimin e mashtrimeve dhe softuerëve keqdashës</translation>
<translation id="4434353761996769206">Gabim i instaluesit: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3461955321878243607"><ph name="MANAGER" /> menaxhon João Browser</translation>
<translation id="3379477508903866078">Shto profilin e João Browser</translation>
<translation id="4447409407328223819">Rreth Chrome for Testing</translation>
<translation id="4074057296993529937">Për të përdorur dhe për të ruajtur të dhënat e João Browser në "Llogarinë tënde të Google", fut frazën tënde të kalimit</translation>
<translation id="4493028449971051158">Gabim në nisje: ekzekuto instaluesin si administrator.</translation>
<translation id="4501471624619070934">Instalimi nuk u krye sepse qasja është e kufizuar në këtë shtet.</translation>
<translation id="8624811527667906941">Kjo shtesë nuk i ka publikuar praktikat e privatësisë, si p.sh. se si i mbledh dhe i përdor të dhënat. João Browser rekomandon që ta heqësh atë.</translation>
<translation id="5571435860030744559">Mirë se erdhe në João Browser. U hap një dritare e re e shfletuesit</translation>
<translation id="8132016625974854930">João Browser ka nevojë për leje për të krijuar një hartë të ambientit rrethues dhe për të ndjekur duart e tua</translation>
<translation id="6599071882590417739">Je i identifikuar tashmë si <ph name="USER_EMAIL_ADDRESS" /> në një profil tjetër të João Browser</translation>
<translation id="4548534452171747496">Chromium i ngarkon paraprakisht faqet, gjë që e bën më të shpejtë shfletimin dhe kërkimin. <ph name="BEGIN_LINK" />Mëso më shumë për ngarkimin paraprak të faqeve<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Përmirëso sigurinë online për të gjithë kur raporton një sajt që mendon se është i dëmshëm.</translation>
<translation id="202208802191333704">João Browser e bllokoi këtë shkarkim sepse ke çaktivizuar "Shfletimin e sigurt" dhe skedari nuk mund të verifikohet</translation>
<translation id="3128308674776200516">Provo "Lenten e Google" me João Browser në telefonin tënd</translation>
<translation id="4594305310729380060">Te "Menaxheri i Fjalëkalimeve" në këtë pajisje</translation>
<translation id="7653380076752216509">Aplikacionet João Browser</translation>
<translation id="4598116752460667024">Kërko për çdo proces nga lista.</translation>
<translation id="4613863813562375431">Versioni i ChromiumOS</translation>
<translation id="4621240073146040695">Pothuajse i përditësuar! Hape përsëri Chromium për të përfunduar përditësimin.</translation>
<translation id="1497446027991908251">Shpejton sajtet me motorin V8 të João Browser, por e bën João Browser disi më pak rezistent ndaj sulmeve</translation>
<translation id="7523749920868634278">Paralajmërim: João Browser nuk mund të parandalojë regjistrimin e historikut të shfletimit nga shtesat. Për të çaktivizuar këtë shtesë në modalitetin "e fshehtë", anulo zgjedhjen e këtij opsioni.</translation>
<translation id="4673151026126227699">Nëse ndan edhe raportet e përdorimit të Chromium, ato raporte përfshijnë URL-të që ti viziton</translation>
<translation id="4673710618874938871">Identifikuar si <ph name="USER_NAME" />, anëtarësim. Hap menynë e llogarisë</translation>
<translation id="6608258642372806522">Profili duket të jetë në përdorim nga një tjetër proces i João Browser (<ph name="PROCESS_ID" />) në një tjetër kompjuter (<ph name="HOST_NAME" />). João Browser ka kyçur profilin që të mos dëmtohet. Nëse je i sigurt që asnjë proces tjetër nuk po e përdor këtë profil, mund të shkyçësh profilin dhe ta nisësh sërish João Browser.</translation>
<translation id="4680828127924988555">Anulo instalimin</translation>
<translation id="3912572071294857936">Disa nga të dhënat e tua të João Browser nuk janë ruajtur ende në "Llogarinë tënde të Google". Provo të presësh për disa minuta para se të dalësh nga ajo. Nëse del tani, këto të dhëna do të fshihen.</translation>
<translation id="1077152188344040592">Kur je i identifikuar, mund të përdorësh fjalëkalimet dhe më shumë nga "Llogaria jote e Google" në João Browser. <ph name="SHORTCUT" /> mund të ndryshojë cilësimet e shërbimeve të tua të Google.</translation>
<translation id="5729536702149847030">Dikush është identifikuar më parë në João Browser në këtë kompjuter si <ph name="ACCOUNT_EMAIL_LAST" />. Krijo një përdorues të ri të João Browser për t'i mbajtur të ndara informacionet e tua.</translation>
<translation id="4724676981607797757">Instalimi dështoi për shkak të një gabimi të protokollit të pambështetur.</translation>
<translation id="6273241729694500032">Dëshiron ta mbyllësh João Browser gjithsesi?</translation>
<translation id="3239680024825449390">Sapo është zbatuar një përditësim special i sigurisë për João Browser. Rinise tani dhe do të restaurojmë skedat e tua.</translation>
<translation id="4771701986670315895">Nuk ke vizituar së fundi. Chromium ka hequr lejen "<ph name="PERMISSION_1" />", "<ph name="PERMISSION_2" />" dhe <ph name="COUNT" /> më shumë.</translation>
<translation id="1908292729364083164">Nëse Gemini në João Browser është i hapur, paneli anësor qëndron i hapur kur krijohen skeda të reja</translation>
<translation id="479167709087336770">Kjo përdor të njëjtin kontrollues drejtshkrimor që përdoret në kërkimin e Google. Teksti që shkruan në shfletues dërgohet te Google. Mund ta ndryshosh këtë sjellje gjithmonë te cilësimet.</translation>
<translation id="189382710647501724">Përdor João Browser pa pasur llogari</translation>
<translation id="4456919965836032212">Rregulli hyrës për João Browser për të lejuar trafikun mDNS.</translation>
<translation id="3486986778673504636">Nise përsëri për të përditësuar &amp;João Browser</translation>
<translation id="4918086044614829423">Prano</translation>
<translation id="4918844574251943176">Imazhi u kopjua</translation>
<translation id="1571932028747131277">João Browser është në modalitetin e sfondit.</translation>
<translation id="7612124006067933008">Kliko për të mbyllur dialogun e identifikimit në João Browser</translation>
<translation id="2598788273876744576">Me profilet e João Browser, mund t'i ndash të gjitha gjërat e tua të João Browser. Krijo profile për miqtë dhe familjen ose ndaje punën nga argëtimi.</translation>
<translation id="2115498792600385171">Vizitorët mund të përdorin João Browser pa lënë asgjë prapa.</translation>
<translation id="6870732303439257966">Llogaria jote në João Browser</translation>
<translation id="4366792189726044065">Shtoje veten te João Browser</translation>
<translation id="504699503110800016">Hap menynë e tejkalimit</translation>
<translation id="4340125167559705618">Qasu te të gjitha të preferuarat e tua të Google me João Browser në <ph name="DEVICE_TYPE" /></translation>
<translation id="4916697359431064123">João Browser ka nevojë për leje për të gjurmuar duart e tua</translation>
<translation id="5141988424377517949">Nuk ke vizituar së fundi. Chromium ka hequr lejen "<ph name="PERMISSION_1" />", "<ph name="PERMISSION_2" />", "<ph name="PERMISSION_3" />".</translation>
<translation id="5174969993834422967">Ti i bllokon zakonisht njoftimet. Për ta lejuar këtë sajt që të të njoftojë, kliko tek ikona e njoftimit në këndin e djathtë të shiritit të vendndodhjes.</translation>
<translation id="5174983315706567306">Nuk ka hapësirë të mjaftueshme në disk.</translation>
<translation id="961070648267203077">Llogaria e João Browser kërkon rivërtetim</translation>
<translation id="69363826605946518">Vazhdo pikërisht aty ku e ke lënë me João Browser në iOS.</translation>
<translation id="471694954923709047">Dil nga João Browser</translation>
<translation id="5234764350956374838">Hiq</translation>
<translation id="5782956358171235578">Hape lidhjen në një dritare të fshe&amp;htë të João Browser</translation>
<translation id="903712329052383264">Merr aplikacionin e João Browser për t'i ruajtur fjalëkalimet kur je në lëvizje</translation>
<translation id="5277894862589591112">Për të zbatuar ndryshimet, rinis Chromium</translation>
<translation id="5286907366254680517">Zbuluar</translation>
<translation id="5593827909938092728">Merr aplikacionin e João Browser</translation>
<translation id="5294316920224716406">Kur shfleton në "Modalitetin 'e fshehtë'", Chromium do të të paralajmërojë para se të ngarkojë një sajt duke përdorur një lidhje të pasigurt</translation>
<translation id="1066981078513393795">João Browser Updater Internal Service</translation>
<translation id="5324450571874973775">Përdori ato bashkë me veçoritë e tjera të Gemini në Chromium</translation>
<translation id="5346389065299425353">Thelloje kërkimin duke shtuar disa skeda, skedarë dhe vegla</translation>
<translation id="1884203704972162365">Merr një përmbledhje të shpejtë të këtij dokumenti dhe bëj pyetje me Gemini në João Browser</translation>
<translation id="5352264705793813212">Chromium gjeti disa rekomandime për sigurinë për t'u rishikuar nga ti</translation>
<translation id="4819697639570429319">Profilet e tjera të João Browser</translation>
<translation id="7878591304929138776">ChromiumOS nuk mund t'i ruante të dhënat e João Browser në "Llogarinë tënde të Google" sepse detajet e identifikimit të llogarisë janë të papërditësuara</translation>
<translation id="5249614051186670898">Po identifikohesh me një llogari të menaxhuar dhe po i jep administratorit të saj kontroll mbi profilin tënd të João Browser. Të dhënat e tua të João Browser, siç janë aplikacionet, faqeshënuesit, fjalëkalimet dhe cilësime të tjera do të lidhen në mënyrë të përhershme me <ph name="USER_NAME" />. Ti do të jesh në gjendje t'i fshish këto të dhëna përmes Panelit të llogarive të Google, por nuk do të jesh në gjendje t'i shoqërosh këto të dhëna me një llogari tjetër. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Kodi shtesë: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Për të marrë personalizimin, përfshi Chromium në "Aktivitetin e uebit dhe të aplikacioneve"</translation>
<translation id="108952623091824942">Mëso se pse João Browser i bllokon disa skedarë</translation>
<translation id="5386450000063123300">Po përditëson Chromium (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Lejo identifikimin në Chromium</translation>
<translation id="1265086181910844216">Hiq nga João Browser</translation>
<translation id="1500700851187484222">Zvogëlon performancën, por e bën João Browser më rezistent ndaj sulmeve</translation>
<translation id="6665657403278704382">Caktoje João Browser si shfletuesin tënd të parazgjedhur</translation>
<translation id="3520901681432894293"><ph name="PAGE_TITLE" /> - João Browser Beta</translation>
<translation id="5994273394215159270">{NUM_TABS,plural, =1{João Browser rekomandon vendosjen në pauzë të skedës që ngadalëson shfletuesin}other{João Browser rekomandon vendosjen në pauzë të skedave që ngadalësojnë shfletuesin}}</translation>
<translation id="646791423998269453">João Browser mund të mos funksionojë si duhet sepse nuk mbështetet më në këtë version të Linux</translation>
<translation id="7249139852479053716">João Browser e bllokoi këtë shkarkim sepse skedari mund të dëmtojë llogaritë e tua personale dhe të rrjeteve sociale</translation>
<translation id="478612683981218420">Prit ndërsa João Browser instalon përditësimet më të fundit të sistemit.</translation>
<translation id="3466187211963597724">João Browser po përpiqet t'i modifikojë fjalëkalimet. Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="3133978491361824131">Puno pa ndërprerje me aplikacionet e tua të preferuara si "Disku i Google" dhe YouTube kur je në lëvizje me João Browser.</translation>
<translation id="5524890928877629608">këndi lart majtas i zonës së kërkimit: majtas <ph name="LEFT" />%, lart <ph name="TOP" />%</translation>
<translation id="5527463683072221100">Hap PDF-të në Chromium</translation>
<translation id="5536164441519929134">Pyet<ph name="LINE_BREAK" />për këtë skedë</translation>
<translation id="3902123582863904748">Për arsye sigurie, João Browser e çaktivizon optimizimin e JavaScript kur ti viziton një sajt për herë të parë.

Nëse kjo faqe nuk funksionon siç pritet, provo të lejosh optimizimin.</translation>
<translation id="5924481826213021755">Shfaq Gemini në João Browser në shiritin e menysë së Mac dhe aktivizo shkurtoren e tastierës</translation>
<translation id="4988760628116707723"><ph name="EXISTING_USER" /> është identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në João Browser në profilin tënd si <ph name="USER_EMAIL_ADDRESS" />. Do të marrësh gjithashtu informacionet e tua të ruajtura etj. nga <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">Gabim në nisje: ekzekuto instaluesin si përdorues i rregullt, jo si administrator.</translation>
<translation id="697769674160644707">Përdor João Browser si parazgjedhje dhe gozhdoje</translation>
<translation id="5596627076506792578">Më shumë opsione</translation>
<translation id="5605834417512968703">Zgjidh çdo gjë për të kërkuar me "Kërkimin nëpërmjet imazheve" ose shtyp tastin "Escape" për të dalë nga "Kërkimi nëpërmjet imazheve"</translation>
<translation id="5618818588972826921">Zgjidh një tekst ose imazh çfarëdo për të kërkuar me "Kërkimin i imazheve" ose shtyp tastin "Escape" për të dalë nga "Kërkimi i imazheve"</translation>
<translation id="2497422928854452258">{0,plural, =0{Ofrohet një përditësim i João Browser}=1{Ofrohet një përditësim i João Browser}other{Një përditësim i João Browser ofrohet prej # ditësh}}</translation>
<translation id="5643865575100044307">Fshi gjithmonë të dhënat e sajteve nga pajisja jote kur të mbyllësh Chromium</translation>
<translation id="620465883043431255">Rinise João Browser tani</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Shfaqe Chromium në këtë gjuhë</translation>
<translation id="569897634095159764">Lidhja me internetin nuk mund të kryhej. Serveri proxy kërkon vërtetim.</translation>
<translation id="5768371961535086509">Chromium liron memorien nga skedat joaktive. Kjo u jep më shumë burime kompjuterike skedave aktive dhe aplikacioneve të tjera dhe bën që Chromium të jetë i shpejtë. Skedat e tua joaktive bëhen përsëri aktive në mënyrë automatike kur kthehesh tek ato. <ph name="BEGIN_LINK" />Mëso më shumë për "Kursyesin e memories"<ph name="END_LINK" /></translation>
<translation id="8866372822266732235">Nëse ke harruar frazën tënde të kalimit apo dëshiron ta ndryshosh këtë cilësim, <ph name="SETTINGS_LINK" /> të dhënat e João Browser në llogarinë tënde</translation>
<translation id="2106070764285625641">Personalizo dhe kontrollo João Browser. Cakto João Browser si parazgjedhje.</translation>
<translation id="9077878413488413377">Mbaji fjalëkalimet, faqeshënuesit dhe historikun të sinkronizuar në mënyrë të përsosur në pajisje duke caktuar João Browser si shfletuesin tënd të parazgjedhur.</translation>
<translation id="5809516625706423866">Lidhja me internetin nuk mund të kryhej. HTTP 401 (E paautorizuar). Kontrollo konfigurimin e proxy-t.</translation>
<translation id="614221876503883218">Shpejton sajtet me motorin V8 të João Browser, por e bën João Browser disi më pak rezistent ndaj sulmeve. Ky cilësim është joaktiv.</translation>
<translation id="8788365803279840995">Për të përdorur dhe ruajtur të dhënat e João Browser te "Llogaria jote e Google", përditëso João Browser</translation>
<translation id="5824893331272123205">Ky panel nuk mund të ngarkohej. Provo përsëri</translation>
<translation id="5805760187441013922">Mirë se vjen në João Browser</translation>
<translation id="5867606647614813312">Aktivizon veçori shtesë për të ofruar mbrojtjet më të forta të Chromium</translation>
<translation id="5871205389137001634">Kliko për të dalë nga "Kërkimi nëpërmjet imazheve"</translation>
<translation id="8367098380158627809">João Browser vuri re se këta artikuj përmbajnë softuer keqdashës:</translation>
<translation id="5889361821821684993">Chromium kontrollon rregullisht për t'u siguruar që shfletuesi yt ka cilësimet më të sigurta. Do të të informojmë nëse ka nevojë të rishikosh diçka.</translation>
<translation id="5895138241574237353">Rinis</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - identifikimi në rrjet</translation>
<translation id="5924017743176219022">Po lidhet me internetin...</translation>
<translation id="7627350220326904504">Le ta bëjmë gati João Browser</translation>
<translation id="5941711191222866238">Minimizo</translation>
<translation id="8680863040348007215">Për të marrë këtë faqeshënues dhe më shumë në të gjitha pajisjet e tua, identifikohu në João Browser</translation>
<translation id="2008232276062354182">Personalizo João Browser sipas dëshirës</translation>
<translation id="5960071705175224773">Cilësimet e tua u ndryshuan nga një aplikacion i panjohur</translation>
<translation id="5977420883993828287">Gozhduar! Përdor përsëri "Detyrat kontekstuale" nga shiriti i veglave</translation>
<translation id="5889362640603897718">{COUNT,plural, =1{Organizata jote e mbyll automatikisht João Browser kur ai nuk përdoret për 1 minutë.}other{Organizata jote e mbyll automatikisht João Browser kur ai nuk përdoret për # minuta.}}</translation>
<translation id="4971097497342057998">Përditëso João Browser për të nisur sinkronizimin</translation>
<translation id="5990360079535151574">Nga butoni "Detyrat kontekstuale" në shiritin e veglave, mund t'i rihapësh "Detyrat kontekstuale" për të bërë pyetje ndërkohë që shfleton</translation>
<translation id="6003112304606738118">Po shkarkohet... Kanë mbetur edhe <ph name="HOURS" /> orë</translation>
<translation id="6009821354356307391">Kërko një përgjigje vijuese</translation>
<translation id="6040143037577758943">Mbyll</translation>
<translation id="2100398097168307292">Përfito më shumë nga blerjet online kur përdor aplikacionin e João Browser në <ph name="DEVICE_TYPE" /></translation>
<translation id="6058380562449900225">Për të mbrojtur të dhënat e tua, lejo që Chromium të heqë lejet nga sajtet që nuk i ke vizituar së fundi. Kjo nuk i ndalon njoftimet.</translation>
<translation id="4735359759698689867">&amp;Hape në João Browser</translation>
<translation id="6069027071882229820">Kopjo si imazh</translation>
<translation id="2274675514456642321"><ph name="EXTENSION_NAME" /> është shtuar te João Browser</translation>
<translation id="147381942282490529">Personalizo dhe kontrollo João Browser. Ofrohet përditësim.</translation>
<translation id="8775234022739879423">Aktive • João Browser nuk mund të verifikojë se nga vjen kjo shtesë</translation>
<translation id="6634821567165410381">Llogaria jote në João Browser</translation>
<translation id="4398707227122702993">Lejo që shtesat të shfaqin kërkesat për qasje në shiritin e veglave të João Browser</translation>
<translation id="5370941509199989624"><ph name="FILE_NAME" /> është i rrezikshëm, prandaj João Browser e ka bllokuar.</translation>
<translation id="5119118887583954582">João Browser do të mbyllet dhe do t'i fshijë të dhënat së shpejti</translation>
<translation id="576637711620229618">Këtu mund të kalosh nga një profil i João Browser te një tjetër</translation>
<translation id="615103374448673771">Nëse lejon kukit, Chromium mund t'i përdorë ato gjatë ngarkimit paraprak</translation>
<translation id="6165508094623778733">Mëso më shumë</translation>
<translation id="3738215896821824918">Pastro të dhënat e João Browser në llogarinë tënde</translation>
<translation id="2145111683361496197">Ky skedar mund të jetë i rrezikshëm<ph name="LINE_BREAK" />João Browser mund ta kontrollojë këtë shkarkim për ty nëse ti jep fjalëkalimin. Informacionet për skedarin dërgohen te "Shfletimi i sigurt i Google", por përmbajtjet dhe fjalëkalimi i skedarit qëndrojnë në pajisjen tënde.</translation>
<translation id="6182736845697986886">Instalimi dështoi për shkak të një gabimi të brendshëm të serverit të përditësimit.</translation>
<translation id="6050294746023477088">Sigurohu që të jesh i identifikuar në João Browser në pajisjen tënde <ph name="TARGET_DEVICE_NAME" /> dhe më pas provo ta dërgosh përsëri.</translation>
<translation id="3395167674702947885">Ky kompjuter e ka tashmë një version më të ri të João Browser. Nëse softueri nuk punon, çinstaloje João Browser dhe provo përsëri.</translation>
<translation id="4384214545531685923">{0,plural, =0{João Browser do të hapet përsëri tani}=1{João Browser do të hapet përsëri për 1 sekondë}other{João Browser do të hapet përsëri për # sekonda}}</translation>
<translation id="5880255774989397049">João Browser ka nevojë për leje qasjeje te hapësira ruajtëse për të shkarkuar skedarë</translation>
<translation id="6245734527075554892">Kontrollon URL-të kundrejt një liste sajtesh të pasigurta të ruajtur në Chromium.</translation>
<translation id="1959823478027154444">Bëje João Browser, shfletuesin tënd të parazgjedhur</translation>
<translation id="6248988683584659830">Cilësimet e kërkimit</translation>
<translation id="9191635841540101343">Merr veçoritë më të mira të sigurisë të Google kur je në lëvizje me aplikacionin e João Browser në telefonin tënd</translation>
<translation id="538350741885862188">Dëshiron të dalësh nga João Browser?</translation>
<translation id="161121067714522736">Këto skeda po përdorin burime shtesë. Për të përmirësuar performancën tënde, lejo që João Browser t'i bëjë ato joaktive.</translation>
<translation id="2095090272560293574">Personalizo profilin tënd të João Browser</translation>
<translation id="6290827346642914212">Emërto profilin tënd të Chromium</translation>
<translation id="6472525517562723285">Një shtesë kërkon që të identifikohesh në João Browser</translation>
<translation id="2069878195899746465"><ph name="FILE_NAME" /> mund të jetë i rrezikshëm, prandaj João Browser e ka bllokuar.</translation>
<translation id="1283909912629029170">João Browser po përdor kamerën tënde.</translation>
<translation id="323902744000752306">Një veprim tjetër në João Browser është në vazhdim. Provo përsëri më vonë.</translation>
<translation id="1292164882596462877">Tani është më e lehtë të përdorësh João Browser me llogarinë tënde të Google dhe në kompjuter të ndarë.</translation>
<translation id="6411450594978516531">Përfito qasje të lehtë te veçoritë që njeh, që të pëlqejnë dhe që u beson duke caktuar João Browser si shfletuesin tënd të parazgjedhur.</translation>
<translation id="3344301749774719950">Shkurtorja e João Browser</translation>
<translation id="8395825163097750991">João Browser e bllokoi këtë shkarkim sepse skedari nuk është shkarkuar zakonisht dhe mund të jetë i rrezikshëm</translation>
<translation id="7683737657427846440">Je i sigurt që dëshiron ta çinstalosh João Browser?</translation>
<translation id="6375219077595103062">Shto një shkurtore për te "Menaxheri i fjalëkalimeve"</translation>
<translation id="6388799252195623474">më ndihmo me këtë</translation>
<translation id="6966523531135953867">Për të vazhduar, identifikohu në João Browser si <ph name="EMAIL" />. Kjo siguron që të kesh politikat e organizatës sate.</translation>
<translation id="5146608242127807773">Logoja e João Browser brenda një ekrani kompjuteri.</translation>
<translation id="6361476216650509195">João Browser është një shfletues uebi që ekzekuton faqe uebi dhe aplikacione me një shpejtësi jashtëzakonisht të lartë. Është i shpejtë, i qëndrueshëm dhe i lehtë në përdorim. Shfleto në ueb në mënyrë më të sigurt, me mbrojtje të integruar në João Browser kundër mashtrimeve dhe softuerëve keqdashës.</translation>
<translation id="7864687914956920860">Për t'u siguruar që mund t'i përdorësh dhe t'i ruash gjithmonë të dhënat e João Browser në "Llogarinë tënde të Google", verifiko që je ti</translation>
<translation id="1160920197193662978">João Browser funksionon më shpejt dhe veçoritë që përdorin JavaScript do të punojnë siç pritet</translation>
<translation id="6436260184216827876">"Kërkimi nëpërmjet imazheve" nuk ofrohet. Provo përsëri më vonë.</translation>
<translation id="6442900851116057561">Rinis ChromiumOS</translation>
<translation id="6443470774889161065">Chromium ngarkon paraprakisht edhe faqe të tjera që mund t'i vizitosh që ato të ngarkohen më shpejt kur t'i vizitosh.</translation>
<translation id="3730564967922511625">Shkarko João Browser në telefon për të monitoruar çmimet dhe për të marrë sinjalizime kur ka rënie çmimi në ndonjë sajt</translation>
<translation id="3753019081686930624">Joaktive • João Browser nuk mund të verifikojë se nga vjen kjo shtesë</translation>
<translation id="5444641426058108434">Mirë se vjen në profilet e João Browser</translation>
<translation id="5103470775766355478">Herën tjetër që të hapësh João Browser në <ph name="DEVICE_TYPE" />, do të shikosh një kërkesë për të përdorur grupet e skedave.</translation>
<translation id="9087231386723579740">Hiqe llogarinë nga João Browser</translation>
<translation id="4984395209542302039">Gjithashtu kontrollon se cila faqe shfaqet kur fillon João Browser</translation>
<translation id="648319183876919572">"Shfletimi i sigurt i përmirësuar" bën më shumë për të të mbrojtur nga uebsajtet dhe shkarkimet e rrezikshme</translation>
<translation id="1524792685704191751">Çinstaloje João Browser</translation>
<translation id="6637504267182028286">Shkurtoret janë hapur në João Browser</translation>
<translation id="1478247638436966279">Organizata jote e mbyll João Browser kur ai nuk përdoret për <ph name="TIMEOUT_DURATION" />. Të dhënat e shfletimit u fshinë. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet.</translation>
<translation id="1311233187253046133">Secili profil duhet të zotërojë informacionin e vet të João Browser, si: faqeshënuesit, historikun, fjalëkalimet etj.</translation>
<translation id="6563921047760808519">Mëso më shumë se <ph name="BEGIN_LINK" />si Chromium i mban private të dhënat e tua<ph name="END_LINK" /></translation>
<translation id="1643078533228697915">Ndryshimet në këtë cilësim do të zbatohen pasi João Browser të riniset.</translation>
<translation id="1918630514771863338">Menaxho shtesat e tua duke klikuar te "Shtesat" në menynë kryesore të João Browser.</translation>
<translation id="4229328298978407243">Mund ta ndërrosh për të parë fjalëkalimet nga një profil tjetër i João Browser</translation>
<translation id="7717252965531997879">Përdor aplikacionin e João Browser për të marrë veglat më të mira me IA kur je në lëvizje</translation>
<translation id="6570579332384693436">Për të korrigjuar gabimet drejtshkrimore, Chromium e dërgon te Google tekstin që ti shkruan në fushat e tekstit</translation>
<translation id="5374627817618267090">Shko te "Cilësimet e njoftimeve" të João Browser</translation>
<translation id="6600016381025017075">Kërko për çdo gjë në këtë faqe</translation>
<translation id="264335610358256197">Ndryshimet e tua do të hyjnë në fuqi herën tjetër kur të rinisësh João Browser.</translation>
<translation id="2657584510687441826">João Browser tani niset kur niset Windows që të mund të fillosh të shfletosh menjëherë. Mund ta çaktivizosh këtë te cilësimet.</translation>
<translation id="5482413402708094860">Vazhdo aty ku e ke lënë: João Browser i restauroi skedat e tua nga sesioni yt i fundit. Mund ta çaktivizosh këtë te</translation>
<translation id="5022765692226673603">João Browser ka nevojë për lejen e kamerës për të krijuar një hartë 3D të ambientit tënd rrethues</translation>
<translation id="6669284030132180248">Nëse i ruan faqeshënuesit e tu vetëm në "Llogarinë tënde të Google", mund t'i monitorosh çmimet e produkteve në Chromium dhe të marrësh njoftime kur të ulet çmimi</translation>
<translation id="6676384891291319759">Qasu në internet</translation>
<translation id="668175097507315160">ChromiumOS nuk mund t'i sinkronizonte të dhënat e tua për shkak të një gabimi gjatë identifikimit.</translation>
<translation id="3982573751008180181">Hiq të dhënat e këtij aplikacioni nga João Browser</translation>
<translation id="5613723096388999601">João Browser ka nevojë për lejen e mikrofonit për këtë sajt</translation>
<translation id="6712881677154121168">Gabim shkarkimi: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="9190188975825967506">Profili yt nuk mund të përdoret sepse është nga një version më i ri i João Browser.

Disa funksione mund të mos ofrohen. Specifiko një direktori tjetër profili ose përdor një version më të ri të João Browser.</translation>
<translation id="6729124504294600478">Për të marrë personalizimin dhe veçoritë e tjera, përfshi Chromium në "Aktivitetin e uebit dhe të aplikacioneve" dhe në shërbimet e lidhura të Google</translation>
<translation id="6957684879859415418">João Browser është i instaluar tashmë për të gjithë përdoruesit në kompjuterin tënd.</translation>
<translation id="4411262692912917677">Për të marrë fjalëkalimet, faqeshënuesit etj. në të gjitha pajisjet e tua, identifikohu në João Browser. Ky faqeshënues do të ruhet në "Llogarinë tënde të Google" pasi të identifikohesh.</translation>
<translation id="6064901610880747710">Shpejton sajtet me motorin V8 të João Browser, por e bën João Browser disi më pak rezistent ndaj sulmeve. Ky cilësim është aktiv.</translation>
<translation id="4530735110472079436">{count,plural, =1{Disa nga të dhënat e tua të João Browser nuk janë ruajtur ende në "Llogarinë tënde të Google". Provo të presësh për disa minuta para se të dalësh nga ajo. Nëse del tani, këto të dhëna (1 artikull) do të fshihen.}other{Disa nga të dhënat e tua të João Browser nuk janë ruajtur ende në "Llogarinë tënde të Google". Provo të presësh për disa minuta para se të dalësh nga ajo. Nëse del tani, këto të dhëna ({count} artikuj) do të fshihen.}}</translation>
<translation id="9176853308971176490">João Browser rekomandon ta skanosh këtë skedar, sepse ai mund të jetë i rrezikshëm.</translation>
<translation id="6779406956731413166">ChromiumOS mundësohet nga <ph name="BEGIN_LINK_CROS_OSS" />softuerë shtesë me burim të hapur<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6831043979455480757">Përkthe</translation>
<translation id="6412488898785231889">João Browser të informon nëse fjalëkalimet e tua komprometohen ndonjëherë</translation>
<translation id="684888714667046800">Lidhja me internetin nuk mund të kryhej. Nëse përdor një mur mbrojtës, sigurohu që <ph name="PRODUCT_EXE_NAME" /> të jetë në listën e lejimeve.</translation>
<translation id="6750640664545078431">João Browser - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Shtyp tastin Tab për të vazhduar</translation>
<translation id="6862030660799253820">Kërkoje këtë imazh me "Kërkimin e imazheve"</translation>
<translation id="4260365383290377081">João Browser vuri re se "<ph name="EXTENSION_NAME" />" përmban softuer keqdashës</translation>
<translation id="6877155553248388166">këndi poshtë djathtas i zonës së kërkimit: djathtas <ph name="RIGHT" />%, poshtë <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">Kopjo</translation>
<translation id="6898028264630240901">Mund t'i gozhdosh "Detyrat kontekstuale" për të bërë pyetje ndërkohë që shfleton</translation>
<translation id="6985817498888719203">Cakto João Browser si shfletuesin tënd të parazgjedhur dhe gozhdoje te shiriti i detyrave</translation>
<translation id="5277424858974213042">&amp;Menaxho profilet e João Browser</translation>
<translation id="2726137364317931343">Ky veprim:
          <ph name="LINE_BREAKS" />
            • Do të rivendosë faqen e parë, faqen e skedës së re, motorin e kërkimit dhe skedat e gozhduara
            <ph name="LINE_BREAK" />
            • Do të çaktivizojë shtesat
            <ph name="LINE_BREAK" />
            • Do të fshijë kukit dhe të dhënat e tjera të përkohshme të sajtit
            <ph name="LINE_BREAK" />
            • Do të rivendosë shkurtoret e João Browser
            <ph name="LINE_BREAKS" />
            Faqeshënuesit, historiku dhe fjalëkalimet e ruajtura nuk do të preken.</translation>
<translation id="2901988969322822496">Ke arritur kufirin e João Browser prej <ph name="BOOKMARK_LIMIT" /> faqeshënuesish, prandaj disa nga faqeshënuesit e tu nuk janë ruajtur ende në "Llogarinë tënde të Google".

Faqeshënuesit e rinj nuk mund të ruhen në llogarinë tënde derisa të fshish disa. Nëse del tani, faqeshënuesit e paruajtur do të fshihen.</translation>
<translation id="6203410920314218280">Hape lidhjen në një dritare të fshe&amp;htë të João Browser</translation>
<translation id="6965382102122355670">Në rregull</translation>
<translation id="6985329841647292029">Kushtet e ChromiumOS</translation>
<translation id="8064285182627814996">Fut frazën e kalimit për të përdorur dhe ruajtur të dhënat e João Browser në llogarinë tënde <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="7011190694940573312">Instalimi dështoi sepse ky version i sistemit operativ nuk mbështetet.</translation>
<translation id="7024536598735240744">Gabim shpaketimi: <ph name="UNPACK_ERROR" />.</translation>
<translation id="181803036615530330">Bëje João Browser tëndin</translation>
<translation id="7047386856539490735">A janë të dobishme këto rezultate?</translation>
<translation id="2478245051737698828">Përditëso João Browser</translation>
<translation id="452909342278940733">Nëse një imazh nuk ka një përshkrim të dobishëm, João Browser do të përpiqet të të japë një përshkrim. Për të krijuar përshkrime, imazhet dërgohen te Google.</translation>
<translation id="8606769615526968368">Merr fuqinë e IA-së kur përdor aplikacionin e João Browser në <ph name="DEVICE_TYPE" /></translation>
<translation id="2061960765882453684">Merr fjalëkalimet, skedat etj. kur je në lëvizje me aplikacionin e João Browser në telefonin tënd</translation>
<translation id="7141270731789036260">Personalizo Chrome for Testing</translation>
<translation id="7147227333672430807">Mund të përdorësh Chromium sa herë që klikon te lidhjet në mesazhe, dokumente dhe aplikacione të tjera</translation>
<translation id="6949173677980969871">Hiq <ph name="EXTENSION_NAME" /> nga João Browser</translation>
<translation id="3556355753960287061">Organizata jote i fshin të dhënat e João Browser kur ato nuk përdoren për <ph name="TIMEOUT_DURATION" />. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet.</translation>
<translation id="8689006320829658442">João Browser ka nevojë për lejen e kamerës për këtë sajt</translation>
<translation id="7501884108538572227">João Browser nuk mund të hapej. Provo përsëri.</translation>
<translation id="5484563502710761706">Pyet për çdo gjë, pikërisht aty ku je, me Gemini në João Browser</translation>
