<translation id="2145111683361496197">‏یہ فائل خطرناک ہو سکتی ہے<ph name="LINE_BREAK" />اگر آپ پاس ورڈ فراہم کرتے ہیں تو João Browser آپ کے لیے اس ڈاؤن لوڈ کو چیک کر سکتا ہے۔ فائل کے بارے میں معلومات Google محفوظ براؤزنگ کو بھیجی جاتی ہے، لیکن فائل کا مواد اور پاس ورڈ آپ کے آلے پر رہتا ہے۔</translation>
<translation id="6182736845697986886">اپ ڈیٹ سرور کی اندرونی خرابی کی وجہ سے انسٹالیشن ناکام ہو گئی۔</translation>
<translation id="6050294746023477088">‏یقینی بنائیں کہ آپ اپنے <ph name="TARGET_DEVICE_NAME" /> پر João Browser میں سائن ان ہیں اور پھر دوبارہ بھیج کر دیکھیں۔</translation>
<translation id="3395167674702947885">‏اس کمپیوٹر پر João Browser کا ایک مزید حالیہ ورژن پہلے سے ہے۔ اگر سافٹ ویئر کام نہیں کر رہا ہے تو براہ کرم João Browser کو ان انسٹال کریں اور دوبارہ کوشش کریں۔</translation>
<translation id="4384214545531685923">{0,plural, =0{‏ابھی João Browser دوبارہ لانچ ہوگا}=1{‏1 سیکنڈ میں João Browser دوبارہ لانچ ہوگا}other{‏# سیکنڈ میں João Browser دوبارہ لانچ ہوگا}}</translation>
<translation id="5880255774989397049">‏João Browser کو فائلز ڈاؤن لوڈ کرنے کیلئے اسٹوریج تک رسائی کی اجازت درکار ہے</translation>
<translation id="6245734527075554892">‏Chromium میں اسٹور کردہ غیر محفوظ سائٹس کی فہرست کے URLs چیک کرتا ہے</translation>
