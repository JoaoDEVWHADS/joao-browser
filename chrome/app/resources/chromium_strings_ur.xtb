<translation id="1640672724030957280">ڈاؤن لوڈ ہو رہی ہے…</translation>
<translation id="1665602916345474427">بطور <ph name="USER_NAME" />، <ph name="USER_EMAIL" />، رکنیت سائن ان ہے۔ اکاؤنٹ مینیو کھولیں</translation>
<translation id="1708414395296835197">‏آپ ہر بار پیغامات، دستاویزات اور دیگر ایپس میں موجود لنکس پر کلک کرتے وقت Chromium کا استعمال کر سکتے ہیں۔ اسے آپ کے ٹاسک بار میں بھی پن کر دیا جائے گا۔</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> کے لیے زیادہ مراعات فراہم کرتا ہے۔</translation>
<translation id="1722488837206509557">یہ آپ کو دستیاب آلات میں سے انتخاب کرنے اور ان پر مواد ڈسپلے کرنے کی اجازت دے گا۔</translation>
<translation id="6972087163510342335">‏João Browser جلد ہی براؤزنگ ڈیٹا کو حذف کر دے گا</translation>
<translation id="1736443181683099871">‏Chromium نیویگیشنز کو HTTPS میں اپ گریڈ کرنے کی کوشش کرے گا</translation>
<translation id="3879288383593333401">‏João Browser ڈیٹا کو صاف کر دیا گیا</translation>
<translation id="656496276885630888">‏João Browser <ph name="REMAINING_TIME" /> میں ری سٹارٹ ہو جائے گا</translation>
<translation id="1749104137266986751">‏HTTPS دستیاب نہ ہونے پر، Chromium آپ کو وارننگ دیے بغیر ایک غیر محفوظ کنکشن استعمال کرے گا</translation>
<translation id="1226290419185955779">‏João Browser کو پس منظر میں چلنے دیں</translation>
<translation id="4231366995273072370">‏João Browser کو محفوظ تر بنانے کیلئے، ہم نے کچھ ایکسٹینشنز کو غیر فعال کر دیا ہے جو <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> میں مندرج نہیں ہیں اور ہو سکتا ہے ان کو آپ کے علم کے بغیر شامل کیا گیا ہو۔</translation>
<translation id="1822049153969905781">‏فوری رسائی کے لیے João Browser کو اپنے ٹاسک بار میں پن کرنے کی خاطر ونڈو اطلاع میں <ph name="BEGIN_BOLD" />ہاں<ph name="END_BOLD" /> پر کلک کریں۔</translation>
<translation id="1321831992638405531">‏João Browser کو دوبارہ انسٹال کریں</translation>
<translation id="3386967202064865436">‏João Browser <ph name="AUTHENTICATION_PURPOSE" /> کی کوشش کر رہا ہے</translation>
<translation id="70054449700528483">‏اگلی بار جب آپ اپنے <ph name="DEVICE_TYPE" /> پر João Browser کھولیں گے تو آپ کو Google پاس ورڈ مینیجر استعمال کرنے کے لیے ایک پرامپٹ نظر آئے گا۔</translation>
<translation id="1838374766361614909">تلاش صاف کریں</translation>
<translation id="5807096362853316123">‏براؤزنگ ڈیٹا کو اپنے Google اکاؤنٹ میں برقرار رکھتے ہوئے، صرف اس آلہ سے اسے حذف کرنے کیلئے، <ph name="BEGIN_LINK" />João Browser سے سائن آؤٹ کریں<ph name="END_LINK" />۔</translation>
<translation id="6396384011117650379">‏چلتے پھرتے نئے ٹیب گروپس کھولنے یا تخلیق کرنے کے لیے اپنے فون پر João Browser ڈاؤن لوڈ کریں۔</translation>
<translation id="185970820835152459">‏آپ اپنے سائن ان کردہ Google اکاؤنٹس کا نظم کر سکتے ہیں۔ آپ کے Google اکاؤنٹس Chromium براؤزر، Play اسٹور، Gmail اور مزید کے لیے استعمال ہوتے ہیں۔ اگر آپ کسی اور کے لیے کوئی اکاؤنٹ شامل کرنا چاہتے ہیں جیسے آپ کی فیملی کا کوئی ممبر تو اس کی بجائے اپنے <ph name="DEVICE_TYPE" /> میں ایک نیا شخص شامل کریں۔ <ph name="LINK_BEGIN" />مزید جانیں<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">تصاویر کا استعمال کر کے تلاش کے ساتھ تلاش کریں</translation>
<translation id="65457771685016683">‏‫<ph name="EXISTING_USER" /> پہلے سے ہی سائن ان ہے۔ اپنی براؤزنگ کو الگ رکھنے کے لیے، اپنی پروفائل میں João Browser میں بطور <ph name="USER_EMAIL_ADDRESS" /> سائن ان کریں۔ آپ کو <ph name="DEVICE" /> سے اپنے بُک مارکس اور مزید چیزیں بھی مل جائیں گی۔</translation>
<translation id="1880677175115548835">متن منتخب کریں</translation>
<translation id="2634119629547215883">‏آپ ایک منظم اکاؤنٹ کے ساتھ سائن ان کر رہے ہیں اور اپنے João Browser پروفائل پر اس کا انتظامی کنٹرول دے رہے ہیں۔ آپ کا João Browser ڈیٹا جیسے آپ کی ایپس، بُک مارکس، سرگزشت، پاس ورڈز اور دیگر ترتیبات <ph name="USER_NAME" /> سے مستقل طور پر جڑ جائیں گی۔ آپ اس ڈیٹا کو Google اکاؤنٹس ڈیش بورڈ کے ذریعے حذف کر سکیں گے لیکن آپ اس ڈیٹا کو دوسرے اکاؤنٹ کے ساتھ وابستہ نہیں کر سکیں گے۔ آپ اپنا موجودہ João Browser ڈیٹا الگ رکھنے کیلئے اختیاری طور پر ایک نیا پروفائل بنا سکتے ہیں۔ <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">‏‫Chromium ہموار اسکرولنگ اور ویڈیو فریم ریٹس جیسی پس منظر کی سرگرمی اور ویژوئل ایفیکٹس کو محدود کر کے بیٹری پاور کی بچت کرتا ہے۔ <ph name="BEGIN_LINK" />اپنے انرجی سیور کے بارے میں مزید جانیں<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">‏‫João Browser اپ ڈیٹر سروس</translation>
<translation id="1911763535808217981">‏اسے آف کر کے، آپ Chromium میں سائن ان کیے بغیر Gmail جیسی Google سائٹس میں سائن ان کر سکتے ہیں</translation>
<translation id="4037729269678342163">‏João Browser جواب نہیں دے رہا ہے۔ ابھی دوبارہ شروع کریں؟</translation>
<translation id="7563750688920581112">‏آپ کی تنظیم، <ph name="MANAGER" />، چاہتی ہے کہ آپ João Browser میں سائن ان کریں</translation>
