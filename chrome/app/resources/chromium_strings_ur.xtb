<translation id="6637504267182028286">‏شارٹ کٹس João Browser میں کھلتے ہیں</translation>
<translation id="1478247638436966279">‏آپ کی تنظیم João Browser کو بند کر دیتی ہے جب اسے <ph name="TIMEOUT_DURATION" /> کے لیے استعمال نہیں کیا جاتا ہے۔ براؤزنگ ڈیٹا کو حذف کر دیا گیا تھا۔ اس میں سرگزشت، آٹو فل اور ڈاؤن لوڈز شامل ہو سکتے ہیں۔</translation>
<translation id="1311233187253046133">‏ہر پروفائل میں بُک مارکس، سرگزشت اور پاس ورڈز وغیرہ جیسی João Browser کی اپنی ذاتی معلومات ہوتی ہے</translation>
<translation id="6563921047760808519">‏اس بارے میں مزید جانیں کہ <ph name="BEGIN_LINK" />Chromium آپ کے ڈیٹا کو کس طرح نجی رکھتا ہے<ph name="END_LINK" /></translation>
<translation id="1643078533228697915">‏اس ترتیب پر تبدیلیوں کا اطلاق João Browser ری سٹارٹ ہونے کے بعد ہوگا۔</translation>
<translation id="1918630514771863338">‏‫João Browser کے مرکزی مینیو میں ایکسٹینشنز پر کلک کر کے اپنی ایکسٹینشنز کا نظم کریں۔</translation>
<translation id="4229328298978407243">‏آپ دوسرے João Browser پروفائل سے پاس ورڈز دیکھنے کے لیے سوئچ کر سکتے ہیں</translation>
<translation id="7717252965531997879">‏چلتے پھرتے بہترین AI ٹولز کا استعمال کرنے کے لیے João Browser ایپ کا استعمال کریں</translation>
<translation id="6570579332384693436">‏ہجے کی غلطیاں ٹھیک کرنے کے لیے آپ ٹیکسٹ فیلڈز میں جو ٹیکسٹ ٹائپ کرتے ہیں Chromium اسے Google کو بھیجتا ہے</translation>
<translation id="5374627817618267090">‏João Browser کی اطلاع کی ترتیبات پر جائیں</translation>
<translation id="6600016381025017075">اس صفحہ پر کچھ بھی تلاش کریں</translation>
<translation id="264335610358256197">‏آپ کی تبدیلیاں João Browser کو اگلی بار آپ کے دوبارہ شروع کرنے کے وقت نافذ ہوں گی۔</translation>
<translation id="2657584510687441826">‏‫Windows کے شروع ہونے پر João Browser اب لانچ ہوتا ہے تاکہ آپ فوری طور پر براؤزنگ شروع کر سکیں۔ آپ اسے ترتیبات میں آف کر سکتے ہیں۔</translation>
<translation id="5482413402708094860">‏جہاں آپ نے چھوڑا تھا وہیں سے جاری رکھیں: João Browser نے آپ کے آخری سیشن سے آپ کے ٹیبز کو بحال کیا۔ آپ اسے درج ذیل میں آف کر سکتے ہیں</translation>
<translation id="5022765692226673603">‏João Browser کو آپ کے اطراف کا 3D نقشہ تخلیق کرنے کے لیے کیمرے کی اجازت درکار ہے</translation>
<translation id="6669284030132180248">‏اگر آپ اپنے بُک مارکس کو اپنے Google اکاؤنٹ میں بھی محفوظ کرتے ہیں تو آپ Chromium میں پروڈکٹ کی قیمتوں کو ٹریک کر سکتے ہیں اور قیمت میں گراوٹ ہونے پر اطلاع حاصل کر سکتے ہیں</translation>
<translation id="6676384891291319759">انٹرنیٹ تک رسائی حاصل کریں</translation>
<translation id="668175097507315160">‏ChromiumOS سائن ان میں ایک خرابی کی وجہ سے آپ کے ڈیٹا کی مطابقت پذیری نہیں کر سکا۔</translation>
<translation id="3982573751008180181">‏‫João Browser سے اس ایپس کا ڈیٹا ہٹائیں</translation>
<translation id="5613723096388999601">‏João Browser کو اس سائٹ کے لیے مائیکروفون کی اجازت درکار ہے</translation>
<translation id="6712881677154121168">ڈاؤن لوڈ سے متعلق خرابی: <ph name="DOWNLOAD_ERROR" />۔</translation>
<translation id="9190188975825967506">‏آپ کا پروفائل استعمال نہیں کیا جا سکتا ہے کیونکہ یہ João Browser کے ایک جدید تر ورژن سے ہے۔

ممکن ہے کچھ خصوصیات غیر دستیاب ہوں۔ براہ کرم ایک مختلف پروفائل ڈائریکٹری متعین کریں یا João Browser کا ایک جدید تر ورژن استعمال کریں۔</translation>
<translation id="6729124504294600478">‏ذاتی نوعیت سازی اور دیگر خصوصیات حاصل کرنے کے لیے، ویب اور ایپ سرگرمی اور لنک کردہ Google سروسز میں Chromium شامل کریں</translation>
<translation id="6957684879859415418">‏João Browser پہلے سے آپ کے کمپیوٹر پر سبھی صارفین کیلئے انسٹال ہے۔</translation>
<translation id="4411262692912917677">‏اپنے تمام آلات پر اپنے بُک مارکس اور مزید حاصل کرنے کے لیے، João Browser میں سائن ان کریں۔ آپ کے سائن ان کرنے کے بعد یہ بُک مارک آپ کے Google اکاؤنٹ میں محفوظ ہو جائے گا۔</translation>
<translation id="6064901610880747710">‏‫João Browser کے V8 انجن کے ساتھ سائٹس کو تیز رفتار بناتا ہے لیکن João Browser کو حملوں کے خلاف قدرے کم مزاحم بناتا ہے۔ یہ ترتیب آن ہے۔</translation>
<translation id="4530735110472079436">{count,plural, =1{‏آپ کا کچھ João Browser ڈیٹا ابھی تک آپ کے Google اکاؤنٹ میں محفوظ نہیں ہوا ہے۔ سائن آؤٹ کرنے سے پہلے چند منٹ انتظار کرنے کی کوشش کریں۔ اگر آپ ابھی سائن آؤٹ کرتے ہیں تو یہ ڈیٹا (1 آئٹم) حذف ہو جائے گا۔}other{‏آپ کا کچھ João Browser ڈیٹا ابھی تک آپ کے Google اکاؤنٹ میں محفوظ نہیں ہوا ہے۔ سائن آؤٹ کرنے سے پہلے چند منٹ انتظار کرنے کی کوشش کریں۔ اگر آپ ابھی سائن آؤٹ کرتے ہیں تو یہ ڈیٹا ({count} آئٹمز) حذف ہو جائے گا۔}}</translation>
