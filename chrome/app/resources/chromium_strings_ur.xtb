<translation id="6388799252195623474">اس کے ساتھ میری مدد کریں</translation>
<translation id="6966523531135953867">‏جاری رکھنے کے لئے João Browser میں <ph name="EMAIL" /> سے سائن ان کریں۔ یہ یقینی بناتا ہے کہ آپ کو اپنی تنظیم کی پالیسیاں مل گئی ہیں۔</translation>
<translation id="5146608242127807773">‏کمپیوٹر اسکرین کے اندر João Browser لوگو۔</translation>
<translation id="6361476216650509195">‏João Browser ایک ایسا ویب براؤزر ہے جو ویب صفحات اور ایپلیکیشنز کو روشنی کی رفتار سے چلاتا ہے۔ João Browser میں پہلے سے شامل میلویئر اور فریب دہی تحفظ کے ساتھ ویب کو مزید محفوظ طور پر براؤز کریں۔</translation>
<translation id="7864687914956920860">‏یہ یقینی بنانے کے لیے کہ آپ اپنے Google اکاؤنٹ میں João Browser ڈیٹا ہمیشہ استعمال اور محفوظ کر سکیں، تصدیق کریں کہ یہ آپ ہی ہیں</translation>
<translation id="1160920197193662978">‏‫João Browser تیزی سے چلتا ہے اور JavaScript استعمال کرنے والی خصوصیات کو ڈیزائن کے مطابق کام کرنا چاہیے (تجویز کردہ)</translation>
<translation id="6436260184216827876">تصاویر کا استعمال کر کے تلاش دستیاب نہیں ہے۔ بعد میں دوبارہ کوشش کریں۔</translation>
<translation id="6442900851116057561">‏ChromiumOS کو ری سٹارٹ کریں</translation>
<translation id="6443470774889161065">‏Chromium ایسے اور بھی مزید صفحات کو پیشگی لوڈ کرتا ہے جنہیں آپ ممکنہ طور پر ملاحظہ کر سکتے ہیں، تاکہ وہ آپ کے ملاحظہ کرتے وقت مزید تیزی سے لوڈ ہو سکیں</translation>
<translation id="3730564967922511625">‏قیمتوں کو ٹریک کرنے اور کسی بھی سائٹ پر قیمت کم ہونے پر الرٹس حاصل کرنے کے لیے اپنے فون پر João Browser ڈاؤن لوڈ کریں</translation>
<translation id="3753019081686930624">‏آف • João Browser اس بات کی تصدیق نہیں کر سکتا کہ یہ ایکسٹینشن کہاں سے آتی ہے</translation>
<translation id="5444641426058108434">‏João Browser کی پروفائلز میں خوش آمدید</translation>
<translation id="5103470775766355478">‏اگلی بار جب آپ اپنے <ph name="DEVICE_TYPE" /> پر João Browser کھولیں گے تو آپ کو ٹیب گروپس استعمال کرنے کے لیے ایک پرامپٹ نظر آئے گا۔</translation>
<translation id="9087231386723579740">‏‫João Browser سے اکاؤنٹ ہٹائیں</translation>
<translation id="4984395209542302039">‏یہ اس کو بھی کنٹرول کرتا ہے جب آپ João Browser کو اسٹارٹ کرتے ہیں تو کون سا صفحہ دکھایا جاتا ہے۔</translation>
<translation id="648319183876919572">بہتر کردہ محفوظ براؤزنگ آپ کو خطرناک ویب سائٹس اور ڈاؤن لوڈز سے بچانے کے لیے بہت کچھ کرتی ہے</translation>
