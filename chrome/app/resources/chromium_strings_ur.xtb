<translation id="4711726241445951349">‏João Browser تجویز کرتا ہے کہ آپ اس ایکسٹینشن کا جائزہ لیں</translation>
<translation id="1042552502243217427">‏جب کوئی سائٹ اپنے صفحے پر لنکس کو نجی طور پر پیشگی لوڈ کرنے کا مطالبہ کرتی ہے تو Chromium براؤزر ‏Google سرورز کا استعمال کرتا ہے۔ اس سے پیشگی لوڈ کردہ سائٹ سے آپ کی شناخت پوشیدہ ہو جاتی ہے، لیکن Google جانتا ہے کہ کونسی سائٹس پیشگی لوڈ ہوتی ہیں۔</translation>
<translation id="1051793555070215510">اس 1 منٹ کے سروے میں حصہ لے کر پوشیدگی کو بہتر بنانے میں ہماری مدد کریں۔</translation>
<translation id="1065672644894730302">آپ کی ترجیحات کو نہیں پڑھا جا سکتا ہے۔

کچھ خصوصیات غیر دستیاب ہو سکتی ہیں اور ترجیحات میں تبدیلیاں محفوظ نہیں ہونگی۔</translation>
<translation id="3937976866851867994">‏آپ کے والدین نے "João Browser کی خاطر سائٹس، ایپس اور ایکسٹینشنز کے لیے اجازتوں" کو آف کر دیا ہے</translation>
<translation id="8626021334348319355">‏کسی مخصوص João Browser خصوصیت یا ایکسٹینشن کو تلاش کرنے کے لیے، ایڈریس بار میں اس کا شارٹ کٹ ٹائپ کریں، پھر اپنی منتخب کردہ کی بورڈ کلید دبائیں</translation>
<translation id="9157778882771986870">‏João Browser آپ کے پاس ورڈز برآمد کرنا چاہتا ہے۔ اس کی اجازت دینے کیلئے، اپنا Windows پاس ورڈ ٹائپ کریں۔</translation>
<translation id="112640046208448578">چیزوں یا مقامات کی شناخت کریں اور ٹیکسٹ کو کاپی یا اس کا ترجمہ کریں۔ جب آپ تصاویر کا استعمال کر کے تلاش استعمال کرتے ہیں تو صفحہ کا اسکرین شاٹ سرور کو بھیجا جاتا ہے۔ <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">‏Chromium آپ کا ڈیفالٹ براؤزر ہے</translation>
<translation id="1131805035311359397">‏یہ دیکھنے کے لئے کہ آیا آپ کے پاس ورڈز ڈیٹا کی خلاف ورزیوں اور دیگر سیکیورٹی مسائل سے محفوظ ہیں، <ph name="BEGIN_LINK" />Chromium میں سائن ان کریں<ph name="END_LINK" />۔</translation>
<translation id="2795895511109336240">‏João Browser مینو پر کلک کریں</translation>
<translation id="1157985233335035034">حالیہ زبانیں</translation>
<translation id="1184145431117212167">‏انسٹالیشن ناکام ہوگئی کیونکہ Windows کا آپ کا ورژن تعاون یافتہ نہیں ہے۔</translation>
<translation id="1185134272377778587">‏Chromium کے بارے میں</translation>
<translation id="667420476518265356">‏اپنے فون پر João Browser کے ساتھ قیمت کی ٹریکنگ کے الرٹس حاصل کریں</translation>
<translation id="1203500561924088507">انسٹال کرنے کا شکریہ۔ آپ کو <ph name="BUNDLE_NAME" /> استعمال کرنے سے پہلے اپنا براؤزر لازمی طور سے ری اسٹارٹ کرنا چاہیے۔</translation>
<translation id="1232234696885483911">‏جب آپ تصاویر کا استعمال کر کے تلاش کھولتے ہیں تو صفحہ کا عنوان، URL اور مواد بشمول PDFs خودکار طور پر سرور کو بھیجے جائیں گے۔ <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">‏جب آپ سائن ان ہوتے ہیں، آپ João Browser میں اپنے Google اکاؤنٹ سے اپنے پاس ورڈز وغیرہ استعمال کر سکتے ہیں۔ اسے تبدیل کرنے کے لیے، "João Browser میں آپ کا اکاؤنٹ" پر جائیں۔</translation>
<translation id="4866003137980530528">‏‫Mac مینیو بار میں João Browser میں Gemini دکھائیں</translation>
<translation id="2526294198551578217">‏‫João Browser میں Gemini میں اسکرین کے حصے کو منتخب کرنے کے لیے، کی بورڈ شارٹ کٹ استعمال کریں۔</translation>
<translation id="7068536367561625920">‏جب یہ ٹیب غیر فعال تھا تو João Browser کو تیز رکھنے کے لیے میموری خالی کر دی گئی تھی۔ آپ اس سائٹ کو ہمیشہ غیر فعال ہونے سے خارج کرنے کا انتخاب کر سکتے ہیں۔</translation>
