<translation id="6472525517562723285">‏ایکسٹینشن چاہتی ہے کہ آپ João Browser میں سائن ان کریں</translation>
<translation id="2069878195899746465">‏<ph name="FILE_NAME" /> خطرناک ہو سکتی ہے، اس لیے João Browser نے اسے مسدود کر دیا ہے۔</translation>
<translation id="1283909912629029170">‏João Browser آپ کا کیمرا استعمال کر رہا ہے۔</translation>
<translation id="323902744000752306">‏João Browser پر ایک اور کارروائی کی جا رہی ہے۔ براہ کرم بعد میں دوبارہ کوشش کریں۔</translation>
<translation id="1292164882596462877">‏اب آپ کے Google اکاؤنٹ کے ساتھ اور اشتراک کردہ کمپیوٹرز پر João Browser کا استعمال زيادہ آسان ہے۔</translation>
<translation id="6411450594978516531">‏‫João Browser کو اپنے ڈیفالٹ براؤزر کے طور پر سیٹ کر کے ان خصوصیات تک آسان رسائی حاصل کریں جنہیں آپ جانتے، پسند کرتے اور ان پر بھروسہ کرتے ہیں۔</translation>
<translation id="3344301749774719950">‏‫João Browser شارٹ کٹ</translation>
<translation id="8395825163097750991">‏João Browser نے اس ڈاؤن لوڈ کو مسدود کر دیا کیونکہ فائل عام طور پر ڈاؤن لوڈ نہیں ہوتی ہے اور یہ خطرناک ہو سکتی ہے</translation>
<translation id="7683737657427846440">‏کیا آپ واقعی João Browser کو ان انسٹال کرنا چاہتے ہیں؟</translation>
