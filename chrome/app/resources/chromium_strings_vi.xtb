<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="vi">
<translation id="1026101648481255140">Tiếp tục cài đặt</translation>
<translation id="1029669172902658969">Chạy lại để cập nhật &amp;ChromiumOS</translation>
<translation id="4711726241445951349">João Browser khuyên bạn nên xem xét tiện ích này</translation>
<translation id="1042552502243217427">Khi một trang web yêu cầu tải trước các đường liên kết trên trang ở chế độ riêng tư, Chromium sẽ sử dụng các máy chủ của Google. Điều này giúp ẩn danh tính của bạn khỏi trang web được tải trước, nhưng Google sẽ biết những trang web được tải trước.</translation>
<translation id="1051793555070215510">Vui lòng dành một phút làm bản khảo sát này để giúp chúng tôi cải thiện chế độ ẩn danh.</translation>
<translation id="1065672644894730302">Không thể đọc tùy chọn của bạn. Một số tính năng có thể không khả dụng và các thay đổi đối với tùy chọn sẽ không được lưu.</translation>
<translation id="3937976866851867994">Cha mẹ bạn đã tắt tuỳ chọn "Quyền của các trang web, ứng dụng và tiện ích" đối với João Browser</translation>
<translation id="8626021334348319355">Để tìm kiếm một tính năng hoặc tiện ích cụ thể của João Browser, hãy nhập lối tắt của tính năng hoặc tiện ích đó vào thanh địa chỉ, sau đó nhấn phím bạn chọn trên bàn phím</translation>
<translation id="9157778882771986870">João Browser muốn xuất các mật khẩu của bạn. Hãy nhập mật khẩu Windows để cho phép thực hiện việc này.</translation>
<translation id="112640046208448578">Xác định đồ vật hoặc địa điểm, sao chép hoặc dịch văn bản. Khi bạn sử dụng tính năng Tìm kiếm hình ảnh, ảnh chụp màn hình trang sẽ được gửi đến máy chủ. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium là trình duyệt mặc định của bạn</translation>
<translation id="1131805035311359397">Để kiểm tra xem mật khẩu của bạn có bị ảnh hưởng bởi các vụ rò rỉ dữ liệu và sự cố bảo mật khác hay không, hãy <ph name="BEGIN_LINK" />đăng nhập vào Chromium<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">Nhấp vào trình đơn João Browser</translation>
<translation id="1157985233335035034">Ngôn ngữ gần đây</translation>
<translation id="1184145431117212167">Không cài đặt được vì phiên bản Windows bạn đang sử dụng chưa được hỗ trợ.</translation>
<translation id="1185134272377778587">Giới thiệu về Chromium</translation>
<translation id="667420476518265356">Nhận thông báo theo dõi giá từ João Browser trên điện thoại</translation>
<translation id="1203500561924088507">Cảm ơn bạn đã cài đặt. Bạn phải khởi động lại trình duyệt trước khi sử dụng <ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">Khi bạn mở tính năng Tìm kiếm hình ảnh, thì tiêu đề, URL và nội dung của trang, bao gồm cả tệp PDF, sẽ được tự động gửi đến máy chủ. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">Khi đăng nhập, bạn có thể sử dụng mật khẩu và nhiều nội dung khác từ Tài khoản Google của mình trong João Browser. Để thay đổi chế độ cài đặt này, hãy chuyển đến phần "Tài khoản của bạn trong João Browser".</translation>
<translation id="4866003137980530528">Hiện Gemini trong João Browser trên thanh trình đơn của máy Mac</translation>
<translation id="2526294198551578217">Để chọn một phần màn hình trong Gemini trong João Browser, hãy dùng phím tắt.</translation>
<translation id="7068536367561625920">Mặc dù thẻ này không hoạt động nhưng bộ nhớ đã được giải phóng để giúp João Browser luôn hoạt động nhanh. Bạn có thể chọn luôn loại trừ trang web này khỏi trạng thái không hoạt động.</translation>
<translation id="3669854427836618143">João Browser đã chặn tệp tải xuống này vì đây là tệp nguy hiểm</translation>
<translation id="126567311906253476">Khi đăng nhập vào các dịch vụ của Google như Gmail hoặc YouTube bằng <ph name="USER_EMAIL" />, bạn có thể tự động được đăng nhập vào Chromium bằng cùng một tài khoản</translation>
<translation id="8094399825947986050">Tải João Browser về điện thoại</translation>
<translation id="1290883685122687410">Lỗi thiết lập: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">Thiết lập hồ sơ João Browser mới</translation>
<translation id="7591029065989504977">Dùng thử với Gemini trong João Browser</translation>
<translation id="8408989583029959522">João Browser cần có quyền truy cập Bluetooth để tìm&#32;
 các thiết bị Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">Đăng nhập vào João Browser trên điện thoại</translation>
<translation id="1330562121671411446">Phát hiện ngôn ngữ</translation>
<translation id="6026568602942276348">Cũng xoá dữ liệu khỏi João Browser (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Đã ghim! Bạn có thể nhấn vào nút mới trên thanh công cụ để truy cập lại vào tính năng Tìm kiếm hình ảnh</translation>
<translation id="1356661055722410047">Mới! Bạn có thể dịch cả văn bản và hình ảnh trên màn hình</translation>
<translation id="1383876407941801731">Tìm kiếm</translation>
<translation id="5807085300679014096">Dùng ứng dụng João Browser để tiếp tục duyệt web mọi lúc, mọi nơi</translation>
<translation id="141901961143729572">Chia sẻ suy nghĩ của bạn</translation>
<translation id="3736947618013031173">Để chia sẻ cửa sổ, hãy cho phép João Browser ghi màn hình trong phần Cài đặt hệ thống.</translation>
<translation id="1478370723027452770">Nhận trợ giúp về Chrome for Testing</translation>
<translation id="1497802159252041924">Lỗi cài đặt: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Trang này được bảo vệ</translation>
<translation id="4379865404970367448">Chia sẻ một thẻ João Browser</translation>
<translation id="4436275659297289591">Đăng nhập vào João Browser</translation>
<translation id="1547469039832541117">Kết thúc tác vụ được làm nổi bật.</translation>
<translation id="449712764049695153">Ghim João Browser</translation>
<translation id="1574377791422810894">Công cụ đảm bảo an toàn của Chromium</translation>
<translation id="5480232403718129394">João Browser muốn xoá dữ liệu của bạn trong Trình quản lý mật khẩu. Nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{Quản trị viên của bạn yêu cầu bạn chạy lại João Browser để áp dụng bản cập nhật}=1{Quản trị viên của bạn yêu cầu bạn chạy lại João Browser để áp dụng bản cập nhật. Cửa sổ ẩn danh của bạn sẽ không mở lại.}other{Quản trị viên của bạn yêu cầu bạn chạy lại João Browser để áp dụng bản cập nhật. # cửa sổ ẩn danh của bạn sẽ không mở lại.}}</translation>
<translation id="980976428162070137">Tận hưởng những tính năng tuyệt vời nhất của Google nhờ ứng dụng João Browser trên điện thoại</translation>
<translation id="1625909126243026060">Xem các chế độ kiểm soát quan trọng đối với quyền riêng tư và tính bảo mật trong Chromium</translation>
<translation id="1640672724030957280">Đang tải xuống...</translation>
<translation id="1665602916345474427">Đã đăng nhập bằng tài khoản <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, gói thành viên. Mở trình đơn tài khoản</translation>
<translation id="1708414395296835197">Bạn có thể sử dụng Chromium mỗi khi bạn nhấp vào đường liên kết trong thư/tin nhắn, tài liệu và các ứng dụng khác. Chromium cũng sẽ được ghim vào thanh tác vụ.</translation>
<translation id="1709772298389099340">Cung cấp đặc quyền cấp cao cho <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Thao tác này sẽ cho phép bạn chọn trong số các thiết bị có sẵn và hiển thị nội dung trên các thiết bị đó.</translation>
<translation id="6972087163510342335">João Browser sắp xoá dữ liệu duyệt web</translation>
<translation id="1736443181683099871">Chromium sẽ cố gắng nâng các hình thức chuyển hướng lên giao thức HTTPS</translation>
<translation id="3879288383593333401">Đã xóa dữ liệu João Browser</translation>
<translation id="656496276885630888">João Browser sẽ khởi động lại sau <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Khi không có giao thức HTTPS, Chromium sẽ sử dụng kết nối không an toàn mà không cảnh báo bạn</translation>
<translation id="1226290419185955779">Cho phép João Browser chạy dưới nền</translation>
<translation id="4231366995273072370">Để làm cho João Browser an toàn hơn, chúng tôi đã vô hiệu hóa một số tiện ích không được liệt kê trong <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> và có thể đã được thêm mà bạn không biết.</translation>
<translation id="1822049153969905781">Nhấp vào <ph name="BEGIN_BOLD" />Có<ph name="END_BOLD" /> trong thông báo của Windows để ghim João Browser vào thanh tác vụ giúp truy cập nhanh.</translation>
<translation id="1321831992638405531">Cài đặt lại João Browser</translation>
<translation id="3386967202064865436">João Browser đang cố gắng <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="70054449700528483">Lần tới, khi mở João Browser trên <ph name="DEVICE_TYPE" />, bạn sẽ thấy lời nhắc sử dụng Trình quản lý mật khẩu của Google.</translation>
<translation id="1838374766361614909">Xóa tìm kiếm</translation>
<translation id="5807096362853316123">Để xoá dữ liệu duyệt web chỉ trên thiết bị này mà không xoá trong Tài khoản Google, hãy <ph name="BEGIN_LINK" />đăng xuất khỏi João Browser<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">Tải João Browser xuống điện thoại để mở hoặc tạo nhóm thẻ mới trong khi di chuyển.</translation>
<translation id="185970820835152459">Bạn có thể quản lý các Tài khoản Google đã đăng nhập của mình. Tài khoản Google của bạn được sử dụng cho trình duyệt Chromium, Cửa hàng Play, Gmail, v.v. Nếu bạn muốn thêm tài khoản cho người khác, chẳng hạn như thành viên gia đình, hãy thêm người dùng mới trên chiếc <ph name="DEVICE_TYPE" /> của bạn. <ph name="LINK_BEGIN" />Tìm hiểu thêm<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Tìm kiếm bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="65457771685016683"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào João Browser bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng dấu trang và nhiều dữ liệu khác trên <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Chọn văn bản</translation>
<translation id="2634119629547215883">Bạn đang đăng nhập bằng tài khoản được quản lý và cấp cho quản trị viên của tài khoản quyền kiểm soát cấu hình João Browser của bạn. Dữ liệu João Browser của bạn, chẳng hạn như ứng dụng, dấu trang, lịch sử, mật khẩu và các cài đặt khác sẽ vĩnh viễn được liên kết với <ph name="USER_NAME" />. Bạn có thể xóa dữ liệu này thông qua Trang tổng quan của tài khoản Google nhưng không thể liên kết dữ liệu này với tài khoản khác. Bạn có thể tùy chọn tạo cấu hình mới để giữ cho dữ liệu João Browser hiện có của bạn riêng biệt. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium sẽ tiết kiệm pin bằng cách hạn chế hoạt động trong nền và hiệu ứng hình ảnh, chẳng hạn như hiệu ứng cuộn mượt mà và tốc độ khung hình của video. <ph name="BEGIN_LINK" />Tìm hiểu thêm về Trình tiết kiệm pin<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">Dịch vụ Trình cập nhật João Browser</translation>
<translation id="1911763535808217981">Bằng việc tắt tính năng này, bạn có thể đăng nhập vào các trang web của Google, chẳng hạn như Gmail mà không cần đăng nhập vào Chromium</translation>
<translation id="4037729269678342163">João Browser không phản hồi. Chạy lại ngay bây giờ?</translation>
<translation id="7563750688920581112">Tổ chức <ph name="MANAGER" /> của bạn yêu cầu bạn đăng nhập vào João Browser</translation>
<translation id="193439633299369377">ChromiumOS cần được khởi động lại để áp dụng bản cập nhật.</translation>
<translation id="7099143775283792684">João Browser đã chặn tệp tải xuống này vì loại tệp này ít được tải xuống và có thể nguy hiểm</translation>
<translation id="1953553007165777902">Đang tải xuống... Còn <ph name="MINUTE" /> phút</translation>
<translation id="1966382378801805537">Chromium không thể xác định hoặc đặt trình duyệt mặc định</translation>
<translation id="197326043290947695">Duyệt web thông minh hơn với tính năng Tìm kiếm hình ảnh</translation>
<translation id="6185556991023272801">Tìm hiểu lý do João Browser chặn một số tệp, mở trong thẻ mới</translation>
<translation id="4053636705816895911">Dịch vụ này giúp cập nhật phần mềm João Browser của bạn. Nếu dịch vụ này bị vô hiệu hoá hoặc bị dừng, phần mềm João Browser của bạn sẽ không được cập nhật. Điều này có nghĩa là lỗ hổng bảo mật phát sinh sẽ không thể khắc phục được và các tính năng có thể không hoạt động. Dịch vụ này sẽ tự gỡ cài đặt khi không được phần mềm João Browser nào dùng.</translation>
<translation id="2008474315282236005">Thao tác này sẽ xóa 1 mục khỏi thiết bị này. Để truy xuất dữ liệu của bạn sau, hãy đăng nhập vào Chromium dưới dạng <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Không cài đặt được. Vui lòng thử lại.</translation>
<translation id="2039417478970545937">Cài đặt.</translation>
<translation id="2049376729098081731">Chọn xem có bao gồm nhật ký duyệt web trên Chromium hay không để mang lại trải nghiệm phù hợp hơn trong các dịch vụ của Google</translation>
<translation id="6768767091114123654">Tích hợp sẵn trong João Browser để giúp bạn tạo, lưu và tự động điền mật khẩu mạnh. Thêm lối tắt để dễ dàng truy cập.</translation>
<translation id="3571664229232252557">Nhấp vào nút Tuỳ chỉnh João Browser trên trang Thẻ mới để mang lại giao diện mới cho João Browser</translation>
<translation id="4273287215573278663">João Browser đã chặn tệp tải xuống này vì tệp này chứa nội dung lừa đảo và có thể thực hiện các thay đổi không mong muốn đối với thiết bị của bạn</translation>
<translation id="9063967192437499581">Lần tới, khi mở João Browser iOS, bạn sẽ thấy lời nhắc dùng thử <ph name="FEATURE_NAME" />.</translation>
<translation id="8511569826706775962">Mật khẩu và các dữ liệu khác trên João Browser mà bạn đã lưu trong Tài khoản Google của mình sẽ bị xoá khỏi thiết bị này. Để tiếp tục sử dụng các dữ liệu đó trong João Browser, hãy đăng nhập lại.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{Tổ chức của bạn sẽ tự động xoá dữ liệu duyệt web sau 1 phút bạn không dùng đến João Browser. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống. Các thẻ sẽ vẫn mở.}other{Tổ chức của bạn sẽ tự động xoá dữ liệu duyệt web sau # phút bạn không dùng đến João Browser. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống. Các thẻ sẽ vẫn mở.}}</translation>
<translation id="2125838419757773031">Chọn vùng trên màn hình để tìm kiếm</translation>
<translation id="2126108037660393668">Không xác minh được tệp tải xuống.</translation>
<translation id="2135919691573380097">Báo cáo trang web này</translation>
<translation id="2137162749895930932">Đóng màn hình dịch</translation>
<translation id="1308845716497059117">João Browser đã chặn tệp tải xuống này vì trang web không sử dụng kết nối an toàn và tệp có thể đã bị can thiệp</translation>
<translation id="2170098639895543546">Chọn nội dung bất kỳ trên trang</translation>
<translation id="6705844023496387932">Tùy chỉnh João Browser</translation>
<translation id="2174917724755363426">Chưa cài đặt xong. Bạn có chắc chắn muốn huỷ không?</translation>
<translation id="7728290795259244895">João Browser – Đăng nhập vào mạng – <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Lỗi khi kiểm tra bản cập nhật: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">Xoá tài khoản khỏi João Browser</translation>
<translation id="4648870374540039667">Dùng ứng dụng João Browser để mang theo các công cụ mua sắm tốt nhất mọi lúc, mọi nơi</translation>
<translation id="2106116820042118250">An toàn hơn khi di chuyển nhờ tính năng Duyệt web an toàn có tăng cường bảo vệ trên João Browser cho iOS</translation>
<translation id="2210682093923538346">Đây là trang web nguy hiểm. Chromium đã xoá quyền thông báo.</translation>
<translation id="2236949375853147973">Hoạt động của tôi</translation>
<translation id="118764235932893741">Để sử dụng địa chỉ và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào João Browser. Địa chỉ này sẽ được lưu trong Tài khoản Google của bạn sau khi bạn đăng nhập.</translation>
<translation id="7254578863532089400">Nếu bạn chia sẻ máy tính, bạn bè và gia đình có thể duyệt web một cách riêng biệt và thiết lập João Browser theo ý của họ.</translation>
<translation id="22571759390241347">Kỹ năng trong Chromium</translation>
<translation id="2283803047247799269">Tìm kiếm thẻ này bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{João Browser đề xuất tạm dừng thẻ làm chậm trình duyệt của bạn}other{João Browser đề xuất tạm dừng các thẻ làm chậm trình duyệt của bạn}}</translation>
<translation id="2307973900865360088">Ghim vào thanh Dock</translation>
<translation id="2313870531055795960">Kiểm tra đối chiếu các URL với danh sách trang web không an toàn được lưu trữ trong Chromium. Nếu một trang web cố ăn cắp mật khẩu của bạn hoặc nếu bạn tải một tệp gây hại xuống, thì Chrome cũng có thể gửi các URL đến tính năng Duyệt web an toàn, bao gồm cả các đoạn nội dung trên trang.</translation>
<translation id="2356070529366658676">Yêu cầu</translation>
<translation id="2359808026110333948">Tiếp tục</translation>
<translation id="3800730051093461113">Tiện ích "<ph name="EXTENSION_NAME" />" muốn bạn đăng nhập vào João Browser</translation>
<translation id="8758735062658446604">Tắt João Browser đối với các ứng dụng chạy trong nền</translation>
<translation id="2623595027619107207">Để sử dụng tiện ích này bằng tài khoản <ph name="USER_EMAIL_ADDRESS" />, hãy đăng nhập vào João Browser.</translation>
<translation id="2384373936468275798">ChromiumOS không thể đồng bộ hoá dữ liệu của bạn vì thông tin đăng nhập vào tài khoản của bạn đã lỗi thời.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{Một hoặc nhiều tiện ích João Browser đã truy cập vào 1 thiết bị HID}=1{Một hoặc nhiều tiện ích João Browser đang truy cập vào 1 thiết bị HID}other{Một hoặc nhiều tiện ích João Browser đang truy cập vào # thiết bị HID}}</translation>
<translation id="6254788431480237503">João Browser cần có quyền truy cập máy ảnh và micrô đối với trang web này</translation>
<translation id="2403703063067034158">Lỗi khi khởi động: một phiên bản thiết lập khác đang chạy, vui lòng thử lại sau.</translation>
<translation id="3028975423343897358">Mở đường liên kết trong João Browser từ ứng dụng bất kỳ và giữ cho trình duyệt luôn xuất hiện trên thanh tác vụ</translation>
<translation id="579079006139156831">Nhấp vào nút Tóm tắt để chia sẻ tài liệu này với Gemini trong João Browser nhằm xem nhanh nội dung tổng quan và đặt các câu hỏi nối tiếp</translation>
<translation id="2440750600860946460">Với <ph name="BEGIN_LINK" />các công cụ của Chromium<ph name="END_LINK" />, bạn có thể duyệt web an toàn và luôn nắm quyền kiểm soát</translation>
<translation id="7114471809991869757"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào João Browser bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng mật khẩu và nhiều dữ liệu khác trên mọi thiết bị của mình.</translation>
<translation id="2451727308784734061">Sử dụng lối tắt để nhanh chóng truy cập vào Trình quản lý mật khẩu. Bạn có thể di chuyển lối tắt đến màn hình chính hoặc trình chạy ứng dụng của máy tính.</translation>
<translation id="2709136733469807397">João Browser sắp đóng</translation>
<translation id="3652225684487279741">Trong João Browser</translation>
<translation id="2485422356828889247">Gỡ cài đặt</translation>
<translation id="2513154137948333830">Yêu cầu khởi động lại: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Chọn văn bản bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="1527474262707362156">João Browser đang cố gắng thay thế các mật khẩu hiện tại. Nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="6480371226914552131">João Browser cần quyền truy cập vào bộ nhớ để tải tệp xuống</translation>
<translation id="6318568902186985084">Trình trợ giúp của João Browser</translation>
<translation id="2575822587468774919">Chọn nội dung bạn muốn tìm bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="4557210258834653476">Để sử dụng mật khẩu và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào João Browser</translation>
<translation id="1148164459654218834">Quét mã QR bằng điện thoại để tải João Browser xuống rồi đăng nhập vào Tài khoản Google của bạn.</translation>
<translation id="235892353478111963">Tiếp tục sử dụng João Browser</translation>
<translation id="259935314519650377">Không thể lưu trình cài đặt đã tải xuống vào bộ nhớ đệm. Lỗi: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Hệ thống</translation>
<translation id="8471946631262724853">Tổ chức của bạn có thể xem và quản lý dữ liệu duyệt web (chẳng hạn như dấu trang, nhật ký và mật khẩu). Tổ chức không thể xem dữ liệu duyệt web trong các hồ sơ João Browser khác</translation>
<translation id="2870759219964376597">Xác minh danh tính của bạn để sử dụng và lưu dữ liệu João Browser trong tài khoản <ph name="ACCOUNT_EMAIL" /> của bạn</translation>
<translation id="2955972712254986678">{COUNT,plural, =0{Chế độ Bảo vệ nâng cao yêu cầu bạn chạy lại João Browser để áp dụng bản cập nhật}=1{Chế độ Bảo vệ nâng cao yêu cầu bạn chạy lại João Browser để áp dụng bản cập nhật. Cửa sổ ẩn danh của bạn sẽ không mở lại.}other{Chế độ Bảo vệ nâng cao yêu cầu bạn chạy lại João Browser để áp dụng bản cập nhật. # cửa sổ ẩn danh của bạn sẽ không mở lại.}}</translation>
<translation id="8949462882238006192">Khởi động João Browser</translation>
<translation id="4224214204752803768">Đã xảy ra lỗi hệ điều hành khi cài đặt. Hãy tải xuống João Browser lại lần nữa.</translation>
<translation id="3141414135710372892">Nếu các bạn dùng chung một thiết bị, thì bạn bè và gia đình có thể duyệt web một cách riêng biệt cũng như thiết lập João Browser theo ý muốn</translation>
<translation id="8838607803339100223">Dễ dàng truy cập để sử dụng Gemini trong João Browser trên thiết bị của bạn, ngay cả khi João Browser đang ở trạng thái thu nhỏ.</translation>
<translation id="1679364578146271696">Thẻ João Browser</translation>
<translation id="2718390899429598676">Để bảo mật hơn, Chromium sẽ mã hóa dữ liệu của bạn.</translation>
<translation id="1874696651662237927">Để xoá Tài khoản Google của bạn khỏi João Browser, hãy đăng xuất</translation>
<translation id="6850669719663104304">Để sử dụng mật khẩu, dấu trang và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào João Browser</translation>
<translation id="2738871930057338499">Không thể kết nối với Internet. HTTP 403 bị cấm. Vui lòng kiểm tra cấu hình proxy.</translation>
<translation id="2753623023919742414">Nhấp để tìm</translation>
<translation id="4193420110872590792">Đặt João Browser làm trình xem PDF mặc định</translation>
<translation id="6614401181366354261">Tiện ích này chứa phần mềm độc hại và không an toàn. Hãy xoá khỏi João Browser để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web bạn truy cập nữa.</translation>
<translation id="2799223571221894425">Chạy lại</translation>
<translation id="6299858290790311689">João Browser của bạn</translation>
<translation id="2816462166102338036">Sử dụng tính năng Tìm kiếm hình ảnh để tìm kiếm video này</translation>
<translation id="5896458971800337862">Khám phá sản phẩm bằng camera, theo dõi thông tin giảm giá và thực hiện nhiều việc khác mọi lúc, mọi nơi nhờ João Browser trên iOS.</translation>
<translation id="2841525013647267359">Dịch từ</translation>
<translation id="2846251086934905009">Lỗi cài đặt: Chưa hoàn tất trình cài đặt. Hoạt động cài đặt đã bị huỷ.</translation>
<translation id="4357241592510111611">Xóa khỏi João Browser...</translation>
<translation id="2850691299438350830">Giúp bạn an toàn trên Chrome và có thể dùng để cải thiện mức độ bảo mật cho bạn trong các ứng dụng khác của Google sau khi đăng nhập</translation>
<translation id="2885378588091291677">Trình quản lý tác vụ</translation>
<translation id="8887040619780090085">Giới thiệu về &amp;João Browser</translation>
<translation id="2915996080311180594">Khởi động lại sau</translation>
<translation id="6619708652934279502">Dữ liệu của bạn được mã hoá bằng cụm mật khẩu. Nhập cụm mật khẩu để sử dụng và lưu dữ liệu trên João Browser vào Tài khoản Google của bạn.</translation>
<translation id="2945997411976714835">Lỗi cài đặt: Trình cài đặt không thể bắt đầu quá trình.</translation>
<translation id="4566114009566397386">Đăng nhập vào các trang web nhanh hơn bằng mật khẩu đã lưu cho João Browser trên iOS</translation>
<translation id="562175540137901632">Tổ chức bạn quản lý João Browser</translation>
<translation id="2977470724722393594">Chromium đã được cập nhật</translation>
<translation id="2977506796191543575">Nếu một trang web cố ăn cắp mật khẩu của bạn hoặc nếu bạn tải một tệp gây hại xuống, thì Chromium cũng có thể gửi các URL đến tính năng Duyệt web an toàn, bao gồm cả các đoạn nội dung trên trang</translation>
<translation id="1776205510657237623">Đăng nhập vào João Browser để an toàn hơn trên mạng nhờ các lựa chọn của cha mẹ bạn</translation>
<translation id="3003694935412297923">Tất cả tác vụ</translation>
<translation id="3374694374267805392">{count,plural, =1{João Browser cần xác minh danh tính của bạn thì mới có thể lưu một số dữ liệu vào Tài khoản Google và cho phép bạn sử dụng dữ liệu đó trên tất cả các thiết bị. Nếu bạn đăng xuất ngay, dữ liệu này (1 mục) sẽ bị xoá.}other{João Browser cần xác minh danh tính của bạn thì mới có thể lưu một số dữ liệu vào Tài khoản Google và cho phép bạn sử dụng dữ liệu đó trên tất cả các thiết bị. Nếu bạn đăng xuất ngay, dữ liệu này ({count}) sẽ bị xoá.}}</translation>
<translation id="4915792193596835645">Mở <ph name="URL" /> trong một thẻ mới trên João Browser.</translation>
<translation id="302551344979399011">Các phát kiến về AI, chẳng hạn như kỹ năng, được lưu vào Tài khoản Google của bạn và được quản lý riêng với tính năng đồng bộ hoá Chromium</translation>
<translation id="8367114375553489372">Đang thêm vào João Browser...</translation>
<translation id="3038232873781883849">Đang chờ cài đặt...</translation>
<translation id="3045032126857188731">Ngôn ngữ dịch: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Đóng hộp thoại phản hồi</translation>
<translation id="6168172692486433600">Các hồ sơ khác trên João Browser</translation>
<translation id="884929993636327">Tiện ích là các phần bổ sung giúp bạn tuỳ chỉnh João Browser. Từ sắp xếp khoa học đến đơn giản hoá các công việc hằng ngày, tiện ích giúp bạn biến João Browser thành trình duyệt của riêng mình.</translation>
<translation id="1525897524206034002">Giúp cải thiện João Browser bằng cách gửi báo cáo sự cố và <ph name="UMA_LINK" /> tới Google</translation>
<translation id="2766971658743453990">Dùng ứng dụng João Browser để mang theo các tính năng an toàn của Google mọi lúc, mọi nơi</translation>
<translation id="4387884830246074210">{NUM_DEVICES,plural, =0{Một hoặc nhiều tiện ích João Browser đã truy cập vào 1 thiết bị USB}=1{Một hoặc nhiều tiện ích João Browser đang truy cập vào 1 thiết bị USB}other{Một hoặc nhiều tiện ích João Browser đang truy cập vào # thiết bị USB}}</translation>
<translation id="3413144813287436446">Nhật ký duyệt web trên João Browser</translation>
<translation id="9192419056064225629">Trình cài đặt không thể giải nén tệp lưu trữ. Hãy tải xuống João Browser lại lần nữa.</translation>
<translation id="310459126943037700">Chưa thể kết thúc nhiệm vụ.</translation>
<translation id="3104828284009500087">Tìm nội dung bất kỳ trên trang</translation>
<translation id="3508468328135806512">Đồng bộ hoá hoàn toàn mật khẩu, dấu trang và nhật ký trên các thiết bị. Dễ dàng sử dụng các tính năng bạn quen thuộc và yêu thích bằng cách cập nhật trình duyệt mặc định thành João Browser.</translation>
<translation id="3216151988142306917">João Browser đang sử dụng micrô của bạn.</translation>
<translation id="3130333203120345554">Lượt tìm kiếm mới</translation>
<translation id="3137969841538672700">Kéo để tìm</translation>
<translation id="7493177208577109722">Thẻ này đang sử dụng thêm tài nguyên. Để cải thiện hiệu suất, hãy cho phép João Browser dừng hoạt động của thẻ này.</translation>
<translation id="7239354789967255675">Để chia sẻ màn hình, hãy cho phép João Browser ghi màn hình trong phần Cài đặt hệ thống</translation>
<translation id="4955872590603594814">Chạy lại João Browser</translation>
<translation id="3161522574479303604">Tất cả ngôn ngữ</translation>
<translation id="4697739132113629685">Mở đường liên kết trong cửa sổ ẩn danh của João Browser</translation>
<translation id="1629247860984475766">Tùy chỉnh hồ sơ mới của bạn trên João Browser</translation>
<translation id="1905008150929775692">Bạn có thể tiếp tục trò chuyện với Chế độ AI mà không cần chuyển đổi giữa các thẻ. Để bắt đầu, hãy đăng nhập vào João Browser. Bạn cũng có thể sử dụng mật khẩu và nhiều dữ liệu khác trên mọi thiết bị của mình.</translation>
<translation id="4232381420311815141">Để xoá Tài khoản Google của bạn khỏi João Browser, hãy vào trang Cài đặt rồi đăng xuất khỏi João Browser</translation>
<translation id="3234316605225071811">Sau đó, Chromium có thể hỏi xem bạn có muốn sử dụng thông tin đã lưu để tự động điền vào biểu mẫu hay không</translation>
<translation id="6676749542734993844">João Browser không thể đọc và ghi vào thư mục dữ liệu:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">Mang theo các công cụ AI của Google mà bạn yêu thích mọi lúc, mọi nơi nhờ João Browser trên iOS.</translation>
<translation id="3286538390144397061">Khởi động lại Ngay bây giờ</translation>
<translation id="532528773927600103">Khóa API của Google bị thiếu. Một số chức năng của João Browser sẽ bị tắt.</translation>
<translation id="3296368748942286671">Tiếp tục chạy các ứng dụng dưới nền khi Chromium bị đóng</translation>
<translation id="3313189106987092621">Chromium sẽ cảnh báo bạn trước khi tải trang web bằng kết nối không an toàn</translation>
<translation id="8095477191923518137">Khi đóng tất cả các cửa sổ João Browser, bạn sẽ bị đăng xuất khỏi hầu hết các trang web, ngoại trừ Tài khoản Google nếu bạn đã đăng nhập vào João Browser. Để cho phép trang web ghi nhớ bạn, hãy <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">góc trên cùng bên phải của khu vực tìm kiếm: <ph name="RIGHT" />% từ bên phải sang, <ph name="TOP" />% từ trên cùng xuống</translation>
<translation id="3366305173356742781">Dữ liệu Chromium trong tài khoản của bạn</translation>
<translation id="3234882977104294240">Sử dụng mật khẩu của bạn với João Browser trên điện thoại</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="2974199599420431595">Chuyển sang hồ sơ hiện có trên João Browser?</translation>
<translation id="3412460710772753638">Trong Trình quản lý mật khẩu trên thiết bị này</translation>
<translation id="3438772217992559640">Tìm kiếm thẻ này bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="8318147705317768982">Mở rộng phạm vi của tính năng Duyệt web an toàn có tăng cường bảo vệ với João Browser trên điện thoại</translation>
<translation id="347392028839310978">Đang tuỳ chỉnh João Browser cho phù hợp với bạn...</translation>
<translation id="3474745554856756813">Thao tác này sẽ xóa <ph name="ITEMS_COUNT" /> mục khỏi thiết bị này. Để truy xuất dữ liệu của bạn sau, hãy đăng nhập vào Chromium dưới dạng <ph name="USER_EMAIL" />.</translation>
<translation id="5805833167703404998">Phím tắt <ph name="SHORTCUT" /> có thể giúp chuyển đổi giữa các hồ sơ trên João Browser</translation>
<translation id="1835124883585653877">Hãy đóng tất cả cửa sổ João Browser và thử lại.</translation>
<translation id="7106246566966568195">Để chia sẻ cửa sổ, hãy cho phép João Browser ghi màn hình trong phần Cài đặt hệ thống</translation>
<translation id="6017005873246021363"><ph name="EXISTING_USER" /> đã đăng nhập.  Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào João Browser bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="1146681170626381319">Mã QR để tải trình duyệt João Browser xuống thiết bị di động</translation>
<translation id="354621070532799440">Lời nhắc: Các tính năng an toàn tốt nhất của Google ngay trên điện thoại của bạn</translation>
<translation id="2488701737291439763">Để chia sẻ màn hình, hãy cho phép João Browser ghi màn hình trong phần Cài đặt hệ thống.</translation>
<translation id="3588112919289558122">Chế độ bảo vệ nâng cao sẽ tắt tính năng tối ưu hoá JavaScript đối với những trang web mà Chromium không nhận ra</translation>
<translation id="3597003331831379823">Không thể chạy quy trình thiết lập bằng đặc quyền cấp cao. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">Đăng nhập vào João Browser</translation>
<translation id="5985252758124395804">Dữ liệu duyệt web của người này sẽ bị xóa khỏi thiết bị này. Để khôi phục dữ liệu, hãy đăng nhập vào João Browser bằng <ph name="USER_EMAIL" />.</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{Đã có bản cập nhật João Browser mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại João Browser.}=1{Đã có bản cập nhật João Browser mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại João Browser. Cửa sổ ẩn danh của bạn sẽ không mở lại.}other{Đã có bản cập nhật João Browser mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại João Browser. # cửa sổ ẩn danh của bạn sẽ không mở lại.}}</translation>
<translation id="3667616615096815454">Không thể cài đặt, máy chủ không xác định được ứng dụng.</translation>
<translation id="3675854891107786059">Sử dụng <ph name="BEGIN_LINK" />cụm mật khẩu của riêng bạn<ph name="END_LINK" /> để mã hoá tất cả dữ liệu Chrome trong Tài khoản Google Các địa chỉ và phương thức thanh toán từ Google Pay sẽ không được mã hoá. Nhật ký duyệt web trên Chromium sẽ không đồng bộ hoá.</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{Quản trị viên của bạn yêu cầu bạn chạy lại João Browser để áp dụng bản cập nhật này}=1{Quản trị viên của bạn yêu cầu bạn chạy lại João Browser để áp dụng bản cập nhật này. Cửa sổ ẩn danh của bạn sẽ không mở lại.}other{Quản trị viên của bạn yêu cầu bạn chạy lại João Browser để áp dụng bản cập nhật này. # cửa sổ ẩn danh của bạn sẽ không mở lại.}}</translation>
<translation id="4134769722455445399">Mở đường liên kết trong thẻ mới của João Browser</translation>
<translation id="3728124580182886854">Liên kết Chromium và các dịch vụ khác của Google cho mục đích cá nhân hoá và các mục đích khác</translation>
<translation id="3729187154190517324">Mở rộng phạm vi tìm kiếm bằng cách thêm nhiều thẻ, tệp và công cụ bằng nút "Thêm một thẻ và các nội dung khác".</translation>
<translation id="655691042235349825">Quản lý hồ sơ trên João Browser</translation>
<translation id="8494798931804571569">Tìm hiểu lý do João Browser chặn một số nội dung tải xuống</translation>
<translation id="379589255253486813">Chromium sẽ thông báo cho bạn nếu có vấn đề cần bạn xem xét</translation>
<translation id="3802055581630249637">Chromium tải trước các trang mà bạn có thể sẽ truy cập để các trang đó tải nhanh hơn khi bạn truy cập</translation>
<translation id="3810973564298564668">Quản lý</translation>
<translation id="6945066279282141856">Để sử dụng mật khẩu bạn đã lưu, hãy quét mã QR, tải João Browser dành cho iOS xuống rồi đăng nhập vào Tài khoản Google của bạn</translation>
<translation id="3846683726093018685">**Tóm tắt:** Hãy mô tả chủ đề và mục đích chính của nội dung trong ảnh chụp màn hình này bằng một câu dưới 30 từ.

          **Đề xuất câu hỏi:** Tạo một danh sách có dấu đầu dòng gồm 3 đến 5 câu hỏi gợi mở mà người dùng có thể đặt ra để hiểu rõ hơn về ảnh chụp màn hình này. Danh sách này phải có ít nhất một câu hỏi cụ thể về một đối tượng trực quan trong ảnh và thiết kế hoặc vị trí của đối tượng đó.</translation>
<translation id="4996569675441627032"><ph name="PAGE_TITLE" /> - João Browser</translation>
<translation id="6008740052107737825">João Browser cần có quyền truy cập vào mạng cục bộ đối với trang web này</translation>
<translation id="3885770153807205175">Bộ chọn ngôn ngữ</translation>
<translation id="2390004682597453662">Tùy chỉnh và kiểm soát João Browser. Bạn cần lưu ý - nhấp để xem thông tin chi tiết.</translation>
<translation id="8262407643678629134">Nhấp vào tên của bạn để mở João Browser và bắt đầu duyệt web.</translation>
<translation id="3892148308691398805">Sao chép văn bản</translation>
<translation id="2168201717554927204"><ph name="EXISTING_USER" /> đã đăng nhập vào hồ sơ này trên João Browser. Để tách biệt hoạt động duyệt web của bạn, João Browser có thể tạo hồ sơ riêng cho bạn.</translation>
<translation id="1046732460303790107">Tiện ích này vi phạm chính sách của Cửa hàng Chrome trực tuyến và có thể không an toàn. Hãy xoá khỏi João Browser để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web bạn truy cập nữa.</translation>
<translation id="3941890832296813527">Lỗi cài đặt: Tên tệp của trình cài đặt không hợp lệ hoặc không được hỗ trợ.</translation>
<translation id="3879366121647289622">João Browser đang cố gắng sao chép mật khẩu. Hãy nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="7332365758981378072">Mật khẩu, phương thức thanh toán và địa chỉ mà bạn đã lưu trong Tài khoản Google sẽ bị xoá khỏi thiết bị này. Để tiếp tục sử dụng các dữ liệu đó trong João Browser, hãy đăng nhập lại.</translation>
<translation id="395904275706073188">Không thể đọc các trang được bảo vệ. Hãy thử đọc một trang khác.</translation>
<translation id="3962647064319009959">Tìm hiểu cách Chromium bảo vệ bạn</translation>
<translation id="3967822245660637423">Đã tải xuống xong</translation>
<translation id="3971865010372729242">Khi bạn nhập vào thanh địa chỉ hoặc hộp tìm kiếm, Chromium sẽ gửi nội dung bạn nhập đến công cụ tìm kiếm, AI và công cụ hỗ trợ của tổ chức bạn để đưa ra đề xuất.</translation>
<translation id="3975724895399328945">Giới thiệu về &amp;Google Chrome for Testing</translation>
<translation id="3997429360543082038">Giới thiệu về ChromiumOS</translation>
<translation id="4010059961270896984">Khi bạn truy cập vào một trang web, Chromium sẽ gửi một phần URL đã làm rối mã nguồn cho tính năng <ph name="BEGIN_LINK" />Duyệt web An toàn của Google<ph name="END_LINK" /> thông qua một máy chủ đảm bảo quyền riêng tư giúp ẩn địa chỉ IP của bạn. Nếu một trang web có hành vi đáng ngờ, Chrome cũng sẽ gửi URL đầy đủ và các đoạn nội dung trên trang cho Google.</translation>
<translation id="4016217212818346953">Giữ an toàn với Trình quản lý mật khẩu</translation>
<translation id="4019629340646866719">ChromiumOS có thể hoạt động được là nhờ <ph name="BEGIN_LINK_CROS_OSS" />phần mềm nguồn mở<ph name="END_LINK_CROS_OSS" /> bổ sung, tương tự như <ph name="BEGIN_LINK_LINUX_OSS" />môi trường phát triển Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">Dịch màn hình</translation>
<translation id="4023601594785368013">Ngôn ngữ gốc: <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">Mở đường liên kết trong João Browser từ ứng dụng bất kỳ. Ngoài ra, João Browser sẽ được ghim vào thanh tác vụ để bạn dễ dàng truy cập.</translation>
<translation id="4036079820698952681">Giúp cải thiện Chromium bằng cách báo cáo <ph name="BEGIN_LINK" />cài đặt hiện tại<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Cải thiện bảo mật quan trọng và tính năng mới có trong phiên bản mới nhất.</translation>
<translation id="4055805654398742145">Trình quản lý mật khẩu</translation>
<translation id="615818333141511791">{COUNT,plural, =1{Tổ chức sẽ tự động đóng João Browser sau 1 phút bạn không dùng đến. Dữ liệu duyệt web sẽ bị xoá. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.}other{Tổ chức sẽ tự động đóng João Browser sau # phút bạn không dùng đến. Dữ liệu duyệt web sẽ bị xoá. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.}}</translation>
<translation id="4118474109249235144">Chế độ ẩn danh của Chromium</translation>
<translation id="4122186850977583290">Chuyển đến trang Giới thiệu về Chromium</translation>
<translation id="9207280419664362385">Tuỳ chỉnh João Browser để mang lại giao diện mới cho trình duyệt</translation>
<translation id="3719803995198923598">Tuỳ chỉnh João Browser</translation>
<translation id="4148957013307229264">Đang cài đặt...</translation>
<translation id="2954462321765112214"><ph name="PAGE_TITLE" /> – Đăng nhập vào mạng – João Browser</translation>
<translation id="7812363663832111420">Khám phá các ứng dụng, trò chơi, tiện ích và chủ đề tuyệt vời cho João Browser.</translation>
<translation id="69200600645763018">Để sử dụng tiện ích này và các tiện ích khác trên tất cả máy tính của bạn, hãy đăng nhập vào João Browser</translation>
<translation id="7505863944027312744">Để giúp bạn an toàn hơn trên mạng với các lựa chọn của cha mẹ, hãy chuyển sang hồ sơ João Browser mà bạn đã đăng nhập bằng <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Đang hủy...</translation>
<translation id="4224210481850767180">Quá trình cài đặt đã bị huỷ.</translation>
<translation id="8090594705972340646">Bạn muốn liên kết dữ liệu João Browser của bạn với tài khoản này?</translation>
<translation id="4251772536351901305">Cảnh báo cho bạn về các trang web nguy hiểm, kể cả trang web mà Google chưa từng biết, bằng cách phân tích nhiều dữ liệu trên các trang web hơn so với chế độ bảo vệ tiêu chuẩn. Bạn có thể chọn bỏ qua cảnh báo của Chromium.</translation>
<translation id="5696119579094527589">Đăng xuất khỏi João Browser</translation>
<translation id="4271805377592243930">Nhận trợ giúp về Chromium</translation>
<translation id="4281844954008187215">Điều khoản dịch vụ</translation>
<translation id="1245307320228150348">Không thể cài đặt do lỗi chưa xác định. Nếu João Browser hiện đang chạy, hãy đóng João Browser và thử lại.</translation>
<translation id="7405356088321579627">Xuất mật khẩu từ João Browser</translation>
<translation id="4304713468139749426">Trình quản lý mật khẩu</translation>
<translation id="4334241893986177674">Tìm kiếm thông tin trên ảnh chụp màn hình này</translation>
<translation id="212570256141568951">Khởi chạy João Browser khi Windows khởi động</translation>
<translation id="4400772909124543403">Hiện không có bản cập nhật nào</translation>
<translation id="7463042547966071103">Bạn vẫn muốn thoát khỏi João Browser?</translation>
<translation id="4413205837991854510">Luôn hiện lối tắt Tìm kiếm hình ảnh</translation>
<translation id="4736206301215400753">Cho phép João Browser chạy trong nền</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{João Browser khuyên bạn nên loại bỏ tiện ích này. <ph name="BEGIN_LINK" />Tìm hiểu thêm về các tiện ích được hỗ trợ<ph name="END_LINK" />}other{João Browser khuyên bạn nên loại bỏ các tiện ích này. <ph name="BEGIN_LINK" />Tìm hiểu thêm về các tiện ích được hỗ trợ<ph name="END_LINK" />.}}</translation>
<translation id="5305058100936019600">Tùy chỉnh và điều khiển João Browser</translation>
<translation id="4427306783828095590">Chế độ bảo vệ tăng cường giúp chặn phần mềm độc hại và hành vi lừa đảo hiệu quả hơn</translation>
<translation id="4434353761996769206">Lỗi trình cài đặt: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3461955321878243607"><ph name="MANAGER" /> quản lý João Browser</translation>
<translation id="3379477508903866078">Thêm hồ sơ João Browser</translation>
<translation id="4447409407328223819">Giới thiệu về Chrome for Testing</translation>
<translation id="4074057296993529937">Để sử dụng và lưu dữ liệu João Browser trong Tài khoản Google, hãy nhập cụm mật khẩu của bạn</translation>
<translation id="4493028449971051158">Lỗi khi khởi động: vui lòng chạy trình cài đặt với tư cách quản trị viên.</translation>
<translation id="4501471624619070934">Không cài đặt được do quyền truy cập bị giới hạn tại quốc gia này.</translation>
<translation id="8624811527667906941">Tiện ích này chưa công bố các phương thức bảo vệ quyền riêng tư, chẳng hạn như cách tiện ích thu thập và sử dụng dữ liệu. João Browser khuyên bạn nên xoá tiện ích này.</translation>
<translation id="5571435860030744559">Chào mừng bạn đến với João Browser. Cửa sổ trình duyệt mới đã mở ra</translation>
<translation id="8132016625974854930">João Browser cần có quyền tạo bản đồ về các khu vực xung quanh và theo dõi tay bạn</translation>
<translation id="6599071882590417739">Bạn đã đăng nhập bằng <ph name="USER_EMAIL_ADDRESS" /> trong một hồ sơ João Browser khác</translation>
<translation id="4548534452171747496">Chromium tải trước các trang để giúp bạn duyệt web và tìm kiếm nhanh hơn. <ph name="BEGIN_LINK" />Tìm hiểu thêm về tính năng tải trước trang<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Cải thiện mức độ an toàn trên mạng cho mọi người khi bạn báo cáo một trang web mà bạn cho là có hại.</translation>
<translation id="202208802191333704">João Browser đã chặn tệp tải xuống này do không thể xác minh tệp (vì bạn đã tắt tính năng Duyệt web an toàn)</translation>
<translation id="3128308674776200516">Dùng thử Google Ống kính với João Browser trên điện thoại</translation>
<translation id="4594305310729380060">Vào Trình quản lý mật khẩu trên thiết bị này</translation>
<translation id="7653380076752216509">Ứng dụng João Browser</translation>
<translation id="4598116752460667024">Tìm quy trình bất kỳ trong danh sách.</translation>
<translation id="4613863813562375431">Phiên bản ChromiumOS</translation>
<translation id="4621240073146040695">Gần được cập nhật! Hãy khởi chạy lại Chromium để hoàn tất cập nhật.</translation>
<translation id="1497446027991908251">Tăng tốc độ tải trang web bằng công cụ V8 của João Browser nhưng làm giảm khả năng chống lại các cuộc tấn công của João Browser</translation>
<translation id="7523749920868634278">Cảnh báo: João Browser không thể ngăn các tiện ích ghi lại nhật ký duyệt web của bạn. Để tắt tiện ích này trong chế độ Ẩn danh, hãy bỏ chọn tùy chọn này.</translation>
<translation id="4673151026126227699">Nếu bạn cũng chia sẻ báo cáo sử dụng của Chromium, thì các báo cáo đó sẽ bao gồm cả những URL bạn truy cập</translation>
<translation id="4673710618874938871">Đã đăng nhập bằng tài khoản <ph name="USER_NAME" />, gói thành viên. Mở trình đơn tài khoản</translation>
<translation id="6608258642372806522">Dường như cấu hình này đang được quy trình João Browser khác (<ph name="PROCESS_ID" />) trên máy tính khác (<ph name="HOST_NAME" />) sử dụng. João Browser đã khóa cấu hình này để cấu hình không bị lỗi. Nếu bạn chắc chắn không có quy trình nào khác đang sử dụng cấu hình này, bạn có thể mở khóa cấu hình và chạy lại João Browser.</translation>
<translation id="4680828127924988555">Huỷ cài đặt</translation>
<translation id="3912572071294857936">Một số dữ liệu João Browser của bạn chưa được lưu vào Tài khoản Google. Hãy đợi một vài phút trước khi đăng xuất. Nếu bạn đăng xuất ngay, dữ liệu này sẽ bị xoá.</translation>
<translation id="1077152188344040592">Khi đăng nhập, bạn có thể sử dụng mật khẩu và nhiều nội dung khác từ Tài khoản Google của mình trong João Browser. <ph name="SHORTCUT" /> có thể thay đổi chế độ cài đặt cho các dịch vụ của Google mà bạn sử dụng.</translation>
<translation id="5729536702149847030">Ai đó trước đây đã đăng nhập vào João Browser trên máy tính này bằng <ph name="ACCOUNT_EMAIL_LAST" />. Vui lòng tạo người dùng João Browser mới để giữ riêng biệt thông tin của bạn.</translation>
<translation id="4724676981607797757">Không cài đặt được do lỗi giao thức không được hỗ trợ.</translation>
<translation id="6273241729694500032">Bạn vẫn muốn thoát khỏi João Browser?</translation>
<translation id="3239680024825449390">João Browser vừa áp dụng một bản cập nhật bảo mật đặc biệt. Vui lòng khởi động lại ngay bây giờ và chúng tôi sẽ khôi phục các thẻ của bạn.</translation>
<translation id="4771701986670315895">Gần đây bạn không truy cập trang web này. Chromium đã xoá <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> và <ph name="COUNT" /> quyền khác.</translation>
<translation id="1908292729364083164">Nếu Gemini trong João Browser đang mở, thì bảng điều khiển bên sẽ vẫn mở khi bạn tạo thẻ mới</translation>
<translation id="479167709087336770">Dịch vụ này sử dụng cùng một trình kiểm tra chính tả dùng trong Google Tìm kiếm. Thông tin bạn nhập vào trình duyệt sẽ được gửi tới Google. Bạn luôn có thể thay đổi hành động này trong phần cài đặt.</translation>
<translation id="189382710647501724">Dùng João Browser mà không cần tài khoản</translation>
<translation id="4456919965836032212">Quy tắc kết nối để João Browser cho phép lưu lượng truy cập mDNS.</translation>
<translation id="3486986778673504636">Chạy lại để cập nhật &amp;João Browser</translation>
<translation id="4918086044614829423">Chấp nhận</translation>
<translation id="4918844574251943176">Đã sao chép hình ảnh</translation>
<translation id="1571932028747131277">João Browser đang chạy trong nền.</translation>
<translation id="7612124006067933008">Nhấp để đóng hộp thoại đăng nhập vào João Browser</translation>
<translation id="2598788273876744576">Với các hồ sơ trên João Browser, bạn có thể tách biệt mọi nội dung của mình khi dùng trình duyệt này. Hãy tạo hồ sơ cho bạn bè và gia đình hoặc phân tách nội dung công việc với nội dung giải trí.</translation>
<translation id="2115498792600385171">Khách có thể sử dụng João Browser mà không phải thoát khỏi bất cứ nội dung nào.</translation>
<translation id="6870732303439257966">Tài khoản của bạn trong João Browser</translation>
<translation id="4366792189726044065">Thêm chính bạn vào João Browser</translation>
<translation id="504699503110800016">Mở trình đơn mục bổ sung</translation>
<translation id="4340125167559705618">Truy cập vào tất cả tính năng của Google mà bạn yêu thích nhờ João Browser trên <ph name="DEVICE_TYPE" /></translation>
<translation id="4916697359431064123">João Browser cần có quyền theo dõi cử chỉ tay của bạn</translation>
<translation id="5141988424377517949">Gần đây bạn không truy cập trang web này. Chromium đã xoá <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />.</translation>
<translation id="5174969993834422967">Bạn thường chặn các thông báo. Để trang web này có thể gửi thông báo cho bạn, hãy nhấp vào biểu tượng thông báo ở góc bên phải của thanh vị trí.</translation>
<translation id="5174983315706567306">Dung lượng ổ đĩa không đủ.</translation>
<translation id="961070648267203077">Tài khoản João Browser cần được xác thực lại</translation>
<translation id="69363826605946518">Tiếp tục ngay tại nơi bạn đã dừng lại với João Browser trên iOS.</translation>
<translation id="471694954923709047">Đăng xuất khỏi João Browser</translation>
<translation id="5234764350956374838">Bỏ qua</translation>
<translation id="5782956358171235578">Mở đường liên kết trong cửa sổ ẩn d&amp;anh của João Browser</translation>
<translation id="903712329052383264">Tải ứng dụng João Browser để lưu mật khẩu mọi lúc, mọi nơi</translation>
<translation id="5277894862589591112">Để áp dụng các mục thay đổi của bạn, hãy chạy lại Chromium</translation>
<translation id="5286907366254680517">Đã phát hiện</translation>
<translation id="5593827909938092728">Tải ứng dụng João Browser</translation>
<translation id="5294316920224716406">Khi bạn duyệt web ở Chế độ ẩn danh, Chromium sẽ cảnh báo bạn trước khi tải một trang web bằng kết nối không an toàn</translation>
<translation id="1066981078513393795">João Browser Updater Internal Service</translation>
<translation id="5324450571874973775">Sử dụng các kỹ năng này cùng với các tính năng khác của Gemini trong Chromium</translation>
<translation id="5346389065299425353">Mở rộng phạm vi tìm kiếm bằng cách thêm nhiều thẻ, tệp và công cụ</translation>
<translation id="1884203704972162365">Xem tổng quan nhanh về tài liệu này và đặt câu hỏi cho Gemini trong João Browser</translation>
<translation id="5352264705793813212">Chromium có một số ý kiến đề xuất về sự an toàn cần bạn xem xét</translation>
<translation id="4819697639570429319">Các hồ sơ khác trên João Browser</translation>
<translation id="7878591304929138776">ChromiumOS không thể lưu dữ liệu João Browser vào Tài khoản Google của bạn vì thông tin đăng nhập tài khoản đã lỗi thời</translation>
<translation id="5249614051186670898">Bạn đang đăng nhập bằng tài khoản được quản lý và cấp cho quản trị viên của tài khoản quyền kiểm soát cấu hình João Browser của bạn. Dữ liệu João Browser của bạn, chẳng hạn như ứng dụng, dấu trang, lịch sử, mật khẩu và các cài đặt khác sẽ vĩnh viễn được liên kết với <ph name="USER_NAME" />. Bạn có thể xóa dữ liệu này thông qua Trang tổng quan của tài khoản Google nhưng không thể liên kết dữ liệu này với tài khoản khác. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Mã bổ sung: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Để sử dụng chế độ cá nhân hoá, hãy thêm Chromium vào mục Hoạt động trên web và ứng dụng</translation>
<translation id="108952623091824942">Tìm hiểu lý do João Browser chặn một số tệp</translation>
<translation id="5386450000063123300">Đang cập nhật Chromium (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Cho phép đăng nhập vào Chromium</translation>
<translation id="1265086181910844216">Xóa khỏi João Browser</translation>
<translation id="1500700851187484222">Làm giảm hiệu suất nhưng giúp João Browser tăng khả năng chống lại các cuộc tấn công</translation>
<translation id="6665657403278704382">Đặt João Browser là trình duyệt mặc định của bạn</translation>
<translation id="3520901681432894293"><ph name="PAGE_TITLE" /> - João Browser phiên bản beta</translation>
<translation id="5994273394215159270">{NUM_TABS,plural, =1{João Browser đề xuất tạm dừng thẻ làm chậm trình duyệt của bạn}other{João Browser đề xuất tạm dừng các thẻ làm chậm trình duyệt của bạn}}</translation>
<translation id="646791423998269453">João Browser có thể không hoạt động đúng cách do không còn được hỗ trợ trên bản phân phối Linux này</translation>
<translation id="7249139852479053716">João Browser đã chặn tệp tải xuống này vì tệp có thể gây hại cho tài khoản cá nhân và tài khoản mạng xã hội của bạn</translation>
<translation id="478612683981218420">Vui lòng đợi khi João Browser cài đặt các bản cập nhật hệ thống mới nhất.</translation>
<translation id="3466187211963597724">João Browser đang cố gắng chỉnh sửa mật khẩu. Hãy nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="3133978491361824131">Làm việc liền mạch với các ứng dụng bạn yêu thích như Google Drive và YouTube mọi lúc, mọi nơi nhờ João Browser.</translation>
<translation id="5524890928877629608">góc trên cùng bên trái của khu vực tìm kiếm: <ph name="LEFT" />% từ bên trái sang, <ph name="TOP" />% từ trên cùng xuống</translation>
<translation id="5527463683072221100">Mở tệp PDF trong Chromium</translation>
<translation id="5536164441519929134">Hỏi<ph name="LINE_BREAK" />về thẻ này</translation>
<translation id="3902123582863904748">Để đảm bảo an toàn, João Browser sẽ tắt tính năng tối ưu hoá JavaScript khi bạn truy cập vào một trang web lần đầu tiên.

Nếu trang này không hoạt động như mong đợi, hãy thử cho phép tính năng tối ưu hoá.</translation>
<translation id="5924481826213021755">Hiện Gemini trong João Browser trong thanh trình đơn của máy Mac và bật phím tắt</translation>
<translation id="4988760628116707723"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào João Browser bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng sẽ nhận được thông tin đã lưu và nhiều dữ liệu khác trên <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">Lỗi khi khởi động: vui lòng chạy trình cài đặt với tư cách người dùng thông thường, không phải quản trị viên.</translation>
<translation id="697769674160644707">Sử dụng João Browser theo mặc định và ghim João Browser</translation>
<translation id="5596627076506792578">Tuỳ chọn khác</translation>
<translation id="5605834417512968703">Chọn nội dung bạn muốn tìm bằng tính năng Tìm kiếm hình ảnh hoặc nhấn phím Escape để thoát khỏi chế độ Tìm kiếm hình ảnh</translation>
<translation id="5618818588972826921">Chọn văn bản hoặc hình ảnh bất kỳ mà bạn muốn tìm kiếm bằng tính năng Tìm kiếm hình ảnh hoặc nhấn phím Escape để thoát khỏi chế độ Tìm kiếm hình ảnh</translation>
<translation id="2497422928854452258">{0,plural, =0{Đã có bản cập nhật João Browser}=1{Đã có bản cập nhật João Browser}other{Đã có bản cập nhật João Browser từ # ngày trước}}</translation>
<translation id="5643865575100044307">Luôn xoá dữ liệu trang web khỏi thiết bị của bạn khi bạn đóng Chromium</translation>
<translation id="620465883043431255">Vui lòng khởi động lại João Browser ngay bây giờ</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Hiển thị Chromium bằng ngôn ngữ này</translation>
<translation id="569897634095159764">Không thể kết nối với Internet. Máy chủ proxy yêu cầu xác thực.</translation>
<translation id="5768371961535086509">Chromium giải phóng bộ nhớ khỏi các thẻ không hoạt động. Nhờ đó, các thẻ đang hoạt động và ứng dụng khác sẽ được sử dụng nhiều tài nguyên máy tính hơn, còn Chromium thì hoạt động nhanh chóng. Các thẻ không hoạt động sẽ tự động hoạt động trở lại khi bạn quay lại các thẻ đó. <ph name="BEGIN_LINK" />Tìm hiểu thêm về Trình tiết kiệm bộ nhớ<ph name="END_LINK" /></translation>
<translation id="8866372822266732235">Nếu bạn quên cụm mật khẩu hoặc muốn thay đổi chế độ cài đặt này, hãy <ph name="SETTINGS_LINK" /> dữ liệu João Browser trong tài khoản của bạn</translation>
<translation id="2106070764285625641">Tuỳ chỉnh và kiểm soát João Browser. Đặt João Browser làm trình duyệt mặc định.</translation>
<translation id="9077878413488413377">Đặt João Browser làm trình duyệt mặc định để mật khẩu, dấu trang và nhật ký của bạn được đồng bộ hoá liền mạch trên mọi thiết bị.</translation>
<translation id="5809516625706423866">Không thể kết nối với Internet. HTTP 401 không được phép. Vui lòng kiểm tra cấu hình proxy.</translation>
<translation id="614221876503883218">Tăng tốc độ tải trang web bằng công cụ V8 của João Browser nhưng làm giảm khả năng chống lại các cuộc tấn công của João Browser. Chế độ cài đặt này đang tắt.</translation>
<translation id="8788365803279840995">Để sử dụng và lưu dữ liệu João Browser trong Tài khoản Google, hãy cập nhật João Browser</translation>
<translation id="5824893331272123205">Không tải được bảng điều khiển này, hãy thử lại</translation>
<translation id="5805760187441013922">Chào mừng bạn đến với João Browser</translation>
<translation id="5867606647614813312">Bật các tính năng bổ sung để sử dụng các biện pháp bảo vệ mạnh nhất của Chromium</translation>
<translation id="5871205389137001634">Nhấp để thoát khỏi chế độ Tìm kiếm hình ảnh</translation>
<translation id="8367098380158627809">João Browser nhận thấy rằng các mục này chứa phần mềm độc hại:</translation>
<translation id="5889361821821684993">Chromium thường xuyên kiểm tra để đảm bảo trình duyệt của bạn có các chế độ cài đặt an toàn nhất. Chúng tôi sẽ thông báo cho bạn biết nếu có nội dung nào cần bạn xem xét.</translation>
<translation id="5895138241574237353">Khởi động lại</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – Đăng nhập vào mạng</translation>
<translation id="5924017743176219022">Đang kết nối Internet...</translation>
<translation id="7627350220326904504">Hãy bắt đầu thiết lập João Browser</translation>
<translation id="5941711191222866238">Thu nhỏ</translation>
<translation id="8680863040348007215">Để sử dụng dấu trang này và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào João Browser</translation>
<translation id="2008232276062354182">Biến João Browser thành trình duyệt của riêng bạn</translation>
<translation id="5960071705175224773">Một ứng dụng lạ đã thay đổi chế độ cài đặt của bạn</translation>
<translation id="5977420883993828287">Đã ghim! Bạn có thể sử dụng lại tính năng Tác vụ theo bối cảnh trên thanh công cụ</translation>
<translation id="5889362640603897718">{COUNT,plural, =1{Tổ chức sẽ tự động đóng João Browser sau 1 phút bạn không dùng đến.}other{Tổ chức sẽ tự động đóng João Browser sau # phút bạn không dùng đến.}}</translation>
<translation id="4971097497342057998">Cập nhật João Browser để bắt đầu đồng bộ hóa</translation>
<translation id="5990360079535151574">Từ nút "Thao tác theo ngữ cảnh" trên thanh công cụ, bạn có thể mở lại Thao tác theo ngữ cảnh để đặt câu hỏi trong khi duyệt web</translation>
<translation id="6003112304606738118">Đang tải xuống... Còn <ph name="HOURS" /> giờ.</translation>
<translation id="6009821354356307391">Đặt câu hỏi nối tiếp</translation>
<translation id="6040143037577758943">Đóng</translation>
<translation id="2100398097168307292">Tận hưởng nhiều lợi ích hơn khi mua sắm trực tuyến bằng ứng dụng João Browser trên <ph name="DEVICE_TYPE" /></translation>
<translation id="6058380562449900225">Để bảo vệ dữ liệu của bạn, hãy cho phép Chromium loại bỏ quyền khỏi các trang web mà gần đây bạn không truy cập. Bạn sẽ vẫn nhận được thông báo.</translation>
<translation id="4735359759698689867">&amp;Mở trong João Browser</translation>
<translation id="6069027071882229820">Sao chép dưới dạng hình ảnh</translation>
<translation id="2274675514456642321"><ph name="EXTENSION_NAME" /> đã được thêm vào João Browser</translation>
<translation id="147381942282490529">Tùy chỉnh và kiểm soát João Browser. Đã có bản cập nhật.</translation>
<translation id="8775234022739879423">Bật • João Browser không thể xác minh nguồn gốc của tiện ích này</translation>
<translation id="6634821567165410381">Tài khoản của bạn trong João Browser</translation>
<translation id="4398707227122702993">Cho phép tiện ích hiện các yêu cầu truy cập trong thanh công cụ của João Browser</translation>
<translation id="5370941509199989624"><ph name="FILE_NAME" /> nguy hiểm, do đó João Browser đã chặn tệp.</translation>
<translation id="5119118887583954582">João Browser sắp đóng và xoá dữ liệu</translation>
<translation id="576637711620229618">Bạn có thể chuyển đổi giữa các hồ sơ trên João Browser tại đây</translation>
<translation id="615103374448673771">Nếu bạn cho phép cookie thì Chromium có thể dùng các cookie này khi tải trước</translation>
<translation id="6165508094623778733">Tìm hiểu thêm</translation>
<translation id="3738215896821824918">Xoá dữ liệu João Browser trong tài khoản của bạn</translation>
<translation id="2145111683361496197">Tệp này có thể nguy hiểm<ph name="LINE_BREAK" />João Browser có thể giúp bạn kiểm tra nội dung tải xuống này nếu bạn cung cấp mật khẩu. Thông tin về tệp sẽ được gửi tới dịch vụ Duyệt web An toàn của Google nhưng nội dung tệp và mật khẩu vẫn nằm trên thiết bị của bạn.</translation>
<translation id="6182736845697986886">Không cài đặt được do lỗi nội bộ của máy chủ cập nhật.</translation>
<translation id="6050294746023477088">Đảm bảo bạn đã đăng nhập vào João Browser trên <ph name="TARGET_DEVICE_NAME" /> của mình rồi thử gửi lại.</translation>
<translation id="3395167674702947885">Máy tính này đã có phiên bản João Browser mới hơn. Nếu phần mềm không hoạt động, hãy gỡ cài đặt João Browser và thử lại.</translation>
<translation id="4384214545531685923">{0,plural, =0{João Browser sẽ khởi động lại ngay bây giờ}=1{João Browser sẽ khởi động lại sau 1 giây}other{João Browser sẽ khởi động lại sau # giây}}</translation>
<translation id="5880255774989397049">João Browser cần có quyền truy cập vào bộ nhớ để tải tệp xuống</translation>
<translation id="6245734527075554892">Kiểm tra đối chiếu các URL với danh sách trang web không an toàn được lưu trữ trong Chromium</translation>
<translation id="1959823478027154444">Đặt João Browser làm trình duyệt mặc định</translation>
<translation id="6248988683584659830">Tìm kiếm cài đặt</translation>
<translation id="9191635841540101343">Tận hưởng các tính năng an toàn tốt nhất của Google mọi lúc, mọi nơi nhờ ứng dụng João Browser trên điện thoại</translation>
<translation id="538350741885862188">Đăng xuất khỏi João Browser?</translation>
<translation id="161121067714522736">Các thẻ này đang sử dụng thêm tài nguyên. Để cải thiện hiệu suất, hãy cho phép João Browser dừng hoạt động của các thẻ này.</translation>
<translation id="2095090272560293574">Tùy chỉnh hồ sơ João Browser của bạn</translation>
<translation id="6290827346642914212">Đặt tên cho hồ sơ của bạn trên Chromium</translation>
<translation id="6472525517562723285">Một tiện ích muốn bạn đăng nhập vào João Browser</translation>
<translation id="2069878195899746465"><ph name="FILE_NAME" /> có thể nguy hiểm, do đó João Browser đã chặn tệp.</translation>
<translation id="1283909912629029170">João Browser đang sử dụng máy ảnh của bạn.</translation>
<translation id="323902744000752306">Một hoạt động khác trên João Browser đang diễn ra. Vui lòng thử lại sau.</translation>
<translation id="1292164882596462877">Giờ đây, việc sử dụng João Browser bằng tài khoản Google của bạn và trên máy tính dùng chung trở nên dễ dàng hơn.</translation>
<translation id="6411450594978516531">Dễ dàng truy cập các tính năng bạn biết, yêu thích và tin tưởng bằng cách đặt João Browser làm trình duyệt mặc định.</translation>
<translation id="3344301749774719950">Lối tắt tới João Browser</translation>
<translation id="8395825163097750991">João Browser đã chặn tệp tải xuống này vì tệp này ít được tải xuống và có thể nguy hiểm</translation>
<translation id="7683737657427846440">Bạn có chắc chắn muốn gỡ cài đặt João Browser không?</translation>
<translation id="6375219077595103062">Thêm lối tắt vào Trình quản lý mật khẩu</translation>
<translation id="6388799252195623474">giúp tôi tra cứu về nội dung này</translation>
<translation id="6966523531135953867">Để tiếp tục, hãy đăng nhập vào João Browser bằng <ph name="EMAIL" />. Việc này sẽ đảm bảo các chính sách của tổ chức bạn được áp dụng.</translation>
<translation id="5146608242127807773">Biểu trưng João Browser trên màn hình máy tính.</translation>
<translation id="6361476216650509195">João Browser là trình duyệt web chạy các trang web và ứng dụng với tốc độ cực nhanh. Đây là một trình duyệt web nhanh, ổn định và dễ sử dụng. Duyệt web trở nên an toàn hơn với tính năng bảo vệ chống lại phần mềm độc hại và lừa đảo được tích hợp sẵn vào João Browser.</translation>
<translation id="7864687914956920860">Xác minh danh tính của bạn để đảm bảo bạn luôn sử dụng và lưu dữ liệu João Browser trong Tài khoản Google</translation>
<translation id="1160920197193662978">João Browser sẽ hoạt động nhanh hơn và các tính năng sử dụng JavaScript sẽ hoạt động như dự kiến</translation>
<translation id="6436260184216827876">Không dùng được tính năng Tìm kiếm hình ảnh. Hãy thử lại sau.</translation>
<translation id="6442900851116057561">Khởi động lại ChromiumOS</translation>
<translation id="6443470774889161065">Chromium tải trước thêm nhiều trang mà bạn có thể sẽ truy cập để những trang đó tải nhanh hơn khi bạn truy cập</translation>
<translation id="3730564967922511625">Tải João Browser xuống điện thoại để theo dõi giá và nhận thông báo khi có chương trình giảm giá trên bất cứ trang web nào</translation>
<translation id="3753019081686930624">Tắt • João Browser không thể xác minh nguồn gốc của tiện ích này</translation>
<translation id="5444641426058108434">Chào mừng bạn đến với hồ sơ trên João Browser</translation>
<translation id="5103470775766355478">Lần tới, khi mở João Browser trên <ph name="DEVICE_TYPE" />, bạn sẽ thấy lời nhắc sử dụng nhóm thẻ.</translation>
<translation id="9087231386723579740">Xoá tài khoản khỏi João Browser</translation>
<translation id="4984395209542302039">Tiện ích này cũng điều khiển trang nào được hiển thị khi bạn khởi động João Browser.</translation>
<translation id="648319183876919572">Tính năng Duyệt web an toàn có tăng cường bảo vệ hoạt động hiệu quả hơn để bảo vệ bạn khỏi các tệp đã tải xuống và trang web nguy hiểm</translation>
<translation id="1524792685704191751">Gỡ cài đặt João Browser</translation>
<translation id="6637504267182028286">Phím tắt mở ra trong João Browser</translation>
<translation id="1478247638436966279">Tổ chức của bạn sẽ đóng João Browser khi João Browser không được dùng đến trong <ph name="TIMEOUT_DURATION" />. Dữ liệu duyệt web đã bị xoá. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.</translation>
<translation id="1311233187253046133">Mỗi hồ sơ đều có thông tin riêng trên João Browser, chẳng hạn như dấu trang, các trang web đã truy cập, mật khẩu và nhiều thông tin khác</translation>
<translation id="6563921047760808519">Tìm hiểu thêm về <ph name="BEGIN_LINK" />cách Chromium bảo mật dữ liệu của bạn<ph name="END_LINK" /></translation>
<translation id="1643078533228697915">Các thay đổi đối với chế độ cài đặt này sẽ được áp dụng sau khi João Browser khởi động lại.</translation>
<translation id="1918630514771863338">Quản lý các tiện ích bằng cách nhấp vào phần Tiện ích trong trình đơn chính của João Browser.</translation>
<translation id="4229328298978407243">Bạn có thể chuyển để xem mật khẩu trong một hồ sơ João Browser khác</translation>
<translation id="7717252965531997879">Dùng ứng dụng João Browser để mang theo các công cụ AI tốt nhất mọi lúc, mọi nơi</translation>
<translation id="6570579332384693436">Để sửa lỗi chính tả, Chromium sẽ gửi cho Google nội dung bạn nhập vào các trường văn bản</translation>
<translation id="5374627817618267090">Chuyển đến phần cài đặt thông báo của João Browser</translation>
<translation id="6600016381025017075">Tìm nội dung bất kỳ trên trang này</translation>
<translation id="264335610358256197">Các thay đổi của bạn sẽ có hiệu lực vào lần tới khi bạn chạy lại João Browser.</translation>
<translation id="2657584510687441826">João Browser hiện khởi chạy khi Windows khởi động để bạn có thể bắt đầu duyệt web ngay lập tức. Bạn có thể tắt lựa chọn này trong phần cài đặt.</translation>
<translation id="5482413402708094860">Tiếp tục từ nơi bạn đã dừng lại: João Browser đã khôi phục các thẻ của bạn từ phiên trước đó. Bạn có thể tắt tính năng này trong phần</translation>
<translation id="5022765692226673603">João Browser cần có quyền truy cập camera để tạo bản đồ 3D khu vực xung quanh bạn</translation>
<translation id="6669284030132180248">Nếu cũng lưu dấu trang trong Tài khoản Google, bạn có thể theo dõi giá sản phẩm trong Chromium và nhận thông báo khi sản phẩm giảm giá</translation>
<translation id="6676384891291319759">Truy cập Internet</translation>
<translation id="668175097507315160">ChromiumOS không thể đồng bộ hoá dữ liệu của bạn do lỗi khi đăng nhập.</translation>
<translation id="3982573751008180181">Xoá dữ liệu của ứng dụng này khỏi João Browser</translation>
<translation id="5613723096388999601">João Browser cần có quyền truy cập micrô đối với trang web này</translation>
<translation id="6712881677154121168">Lỗi khi tải xuống: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="9190188975825967506">Không thể sử dụng cấu hình của bạn do cấu hình này đến từ một phiên bản João Browser mới hơn.

Một số tính năng có thể không khả dụng. Hãy chỉ định thư mục cấu hình khác hoặc sử dụng phiên bản João Browser mới hơn.</translation>
<translation id="6729124504294600478">Để sử dụng chế độ cá nhân hoá và các tính năng khác, hãy thêm Chromium vào mục Hoạt động trên web và ứng dụng cũng như các dịch vụ của Google được liên kết</translation>
<translation id="6957684879859415418">João Browser đã được cài đặt cho tất cả người dùng trên máy tính của bạn.</translation>
<translation id="4411262692912917677">Để sử dụng mật khẩu, dấu trang và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào João Browser. Dấu trang này sẽ được lưu trong Tài khoản Google của bạn sau khi bạn đăng nhập.</translation>
<translation id="6064901610880747710">Tăng tốc độ tải trang web bằng công cụ V8 của João Browser nhưng làm giảm khả năng chống lại các cuộc tấn công của João Browser. Chế độ cài đặt này đang bật.</translation>
<translation id="4530735110472079436">{count,plural, =1{Một số dữ liệu João Browser của bạn chưa được lưu vào Tài khoản Google. Hãy đợi một vài phút trước khi đăng xuất. Nếu bạn đăng xuất ngay, dữ liệu này (1 mục) sẽ bị xoá.}other{Một số dữ liệu João Browser của bạn chưa được lưu vào Tài khoản Google. Hãy đợi một vài phút trước khi đăng xuất. Nếu bạn đăng xuất ngay, dữ liệu này ({count}) sẽ bị xoá.}}</translation>
<translation id="9176853308971176490">João Browser đề xuất quét tệp này vì tệp này có thể nguy hiểm.</translation>
<translation id="6779406956731413166">ChromiumOS có thể hoạt động được là nhờ <ph name="BEGIN_LINK_CROS_OSS" />phần mềm nguồn mở<ph name="END_LINK_CROS_OSS" /> bổ sung.</translation>
<translation id="6831043979455480757">Dịch</translation>
<translation id="6412488898785231889">João Browser cho bạn biết mật khẩu của bạn có bị đánh cắp hay không</translation>
<translation id="684888714667046800">Không kết nối được với Internet. Nếu bạn sử dụng tường lửa, vui lòng đảm bảo <ph name="PRODUCT_EXE_NAME" /> có trong danh sách cho phép.</translation>
<translation id="6750640664545078431">João Browser - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Nhấn phím Tab để tiếp tục</translation>
<translation id="6862030660799253820">Sử dụng tính năng Tìm kiếm hình ảnh để tìm kiếm hình ảnh này</translation>
<translation id="4260365383290377081">João Browser nhận thấy rằng "<ph name="EXTENSION_NAME" />" chứa phần mềm độc hại</translation>
<translation id="6877155553248388166">góc dưới cùng bên phải của khu vực tìm kiếm: <ph name="RIGHT" />% từ bên phải sang, <ph name="BOTTOM" />% từ dưới cùng lên</translation>
<translation id="6896758677409633944">Sao chép</translation>
<translation id="6898028264630240901">Bạn có thể ghim tính năng Tác vụ theo bối cảnh để đặt câu hỏi trong khi duyệt web</translation>
<translation id="6985817498888719203">Đặt João Browser làm trình duyệt mặc định và ghim João Browser vào thanh tác vụ</translation>
<translation id="5277424858974213042">&amp;Quản lý hồ sơ trên João Browser</translation>
<translation id="2726137364317931343">Hành động này sẽ:
          <ph name="LINE_BREAKS" />
            • Đặt lại trang khởi động, trang thẻ mới, công cụ tìm kiếm và các thẻ được ghim.
            <ph name="LINE_BREAK" />
            • Tắt tiện ích
            <ph name="LINE_BREAK" />
            • Xoá cookie và dữ liệu trang web tạm thời khác
            <ph name="LINE_BREAK" />
            • Đặt lại phím tắt João Browser
            <ph name="LINE_BREAKS" />
            Dấu trang, nhật ký và mật khẩu đã lưu sẽ không bị ảnh hưởng.</translation>
<translation id="2901988969322822496">Bạn đã đạt đến hạn mức <ph name="BOOKMARK_LIMIT" /> dấu trang của João Browser nên một số dấu trang chưa được lưu vào Tài khoản Google của bạn.

Bạn phải xoá bớt một số dấu trang thì mới có thể lưu dấu trang mới vào tài khoản. Nếu bạn đăng xuất ngay bây giờ, các dấu trang chưa lưu sẽ bị xoá.</translation>
<translation id="6203410920314218280">Mở đường liên kết trong cửa sổ ẩn danh của João Browser</translation>
<translation id="6965382102122355670">OK</translation>
<translation id="6985329841647292029">Điều khoản của ChromiumOS</translation>
<translation id="8064285182627814996">Nhập cụm mật khẩu để sử dụng và lưu dữ liệu João Browser trong tài khoản <ph name="ACCOUNT_EMAIL" /> của bạn</translation>
<translation id="7011190694940573312">Cài đặt không thành công vì phiên bản hệ điều hành này không được hỗ trợ.</translation>
<translation id="7024536598735240744">Lỗi khi giải nén: <ph name="UNPACK_ERROR" />.</translation>
<translation id="181803036615530330">Biến João Browser thành trình duyệt của riêng bạn</translation>
<translation id="7047386856539490735">Những kết quả này có hữu ích không?</translation>
<translation id="2478245051737698828">Cập nhật João Browser</translation>
<translation id="452909342278940733">João Browser sẽ cố gắng mô tả cho bạn những hình ảnh không có nội dung mô tả hữu ích. Để tạo nội dung mô tả, các hình ảnh sẽ được gửi đến Google.</translation>
<translation id="8606769615526968368">Khai thác sức mạnh của AI khi bạn dùng ứng dụng João Browser trên <ph name="DEVICE_TYPE" /></translation>
<translation id="2061960765882453684">Mang theo mật khẩu, thẻ và nhiều dữ liệu khác mọi lúc, mọi nơi nhờ ứng dụng João Browser trên điện thoại</translation>
<translation id="7141270731789036260">Tuỳ chỉnh Chrome for Testing</translation>
<translation id="7147227333672430807">Bạn có thể sử dụng Chromium mỗi khi bạn nhấp vào đường liên kết trong thư/tin nhắn, tài liệu và các ứng dụng khác</translation>
<translation id="6949173677980969871">Xoá <ph name="EXTENSION_NAME" /> khỏi João Browser</translation>
<translation id="3556355753960287061">Tổ chức của bạn sẽ xoá dữ liệu João Browser khi dữ liệu này không được dùng đến trong <ph name="TIMEOUT_DURATION" />. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.</translation>
<translation id="8689006320829658442">João Browser cần có quyền truy cập máy ảnh đối với trang web này</translation>
<translation id="7501884108538572227">Không thể mở João Browser. Hãy thử lại.</translation>
<translation id="5484563502710761706">Hỏi bất cứ điều gì và từ bất cứ đâu với Gemini trong João Browser</translation>
<translation id="3823264355161086552">Ghim João Browser vào thanh Dock để truy cập nhanh chóng bất kỳ lúc nào</translation>
<translation id="9153902741226700840">Dùng João Browser mỗi khi bạn nhấp vào đường liên kết trong thư/tin nhắn, tài liệu và các ứng dụng khác</translation>
<translation id="7216228761061470870">Khi bạn sử dụng tính năng Tìm kiếm hình ảnh trên máy tính thì nội dung, URL và tiêu đề của trang, bao gồm cả tệp PDF, sẽ được gửi đến máy chủ</translation>
<translation id="7950844619283784703">Trình quản lý tác vụ - João Browser</translation>
<translation id="133513825972536773"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào João Browser bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể truy cập thông tin đã lưu và nhiều dữ liệu khác trên mọi thiết bị của mình.</translation>
<translation id="4558982617284733740">Bắt đầu duyệt web ngay lập tức: Giờ đây, João Browser có thể khởi chạy khi Windows khởi động.</translation>
<translation id="7274695763216404502">Đã ghim! Sử dụng lại tính năng Tìm kiếm hình ảnh trên thanh công cụ</translation>
<translation id="7288567540154601580">Thẻ và tiện ích</translation>
<translation id="5494571279964989269">{NUM_EXTENSIONS,plural, =1{João Browser khuyên bạn nên xoá tiện ích đó}other{João Browser khuyên bạn nên xoá các tiện ích đó}}</translation>
<translation id="2269053214123323740">Để chia sẻ âm thanh hệ thống, hãy mở phần Cài đặt hệ thống rồi bật chế độ "Chỉ ghi âm thanh hệ thống" cho João Browser. Sau đó, bạn cần khởi động lại João Browser.</translation>
<translation id="731795002583552498">Đang cập nhật Chromium</translation>
<translation id="9065168747010082551">Tệp tùy chọn của bạn bị hỏng hoặc không hợp lệ.&#32;

João Browser không thể khôi phục cài đặt của bạn.</translation>
<translation id="7324051657739063017">Bạn có thể mở lại Thao tác theo ngữ cảnh để đặt câu hỏi trong khi duyệt web</translation>
<translation id="4159250197688136733">Web, dấu trang và các nội dung khác của bạn trên João Browser đều có ở đây.</translation>
<translation id="7347827960336370838">Chỉ những người có cụm mật khẩu mới đọc được dữ liệu đã mã hoá của bạn. Cụm mật khẩu không được gửi tới Google hay được Google lưu trữ. Nếu quên cụm mật khẩu hoặc muốn thay đổi chế độ cài đặt này, bạn sẽ cần <ph name="BEGIN_LINK" />xoá dữ liệu Chromium khỏi tài khoản của bạn<ph name="END_LINK" />.</translation>
<translation id="1062903713270840396">Quản trị viên hệ thống đã định cấu hình João Browser để mở <ph name="ALTERNATIVE_BROWSER_NAME" /> khi truy cập vào <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">Đã xảy ra lỗi</translation>
<translation id="5817362738974335084">Để nhận các bản cập nhật João Browser sau này, bạn cần có macOS 13 trở lên. Máy tính này đang sử dụng macOS 12.</translation>
<translation id="7376384068949534168">Gần đây bạn không truy cập trang web này. Chromium đã xoá <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />.</translation>
<translation id="73786666777299047">Mở cửa hàng Chrome trực tuyến</translation>
<translation id="5724625487458697703">Hiện Gemini trong João Browser trong khay hệ thống</translation>
<translation id="7401687852903179959">Tìm kiếm video này bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="1088684725931971005">João Browser đang là trình duyệt mặc định của bạn</translation>
<translation id="7479848806300971661">Tiếp tục từ nơi bạn đã dừng lại: João Browser khôi phục các thẻ của bạn mỗi khi bạn khởi động lại. Để tắt tính năng này, hãy chuyển đến</translation>
<translation id="1258077876605261365">Nhập mật khẩu vào João Browser</translation>
<translation id="5293062713751091377">1. Nhấp vào <ph name="BUTTON_LABEL" /> bên dưới
2. Nhấp vào <ph name="BUTTON_2" /> trong phần cài đặt Windows
3. Nhấp vào <ph name="BUTTON_3" /> trong thông báo của Windows để ghim João Browser vào thanh tác vụ giúp truy cập nhanh</translation>
<translation id="1941496545060769345"><ph name="PAGE_TITLE" /> - João Browser dành cho nhà phát triển</translation>
<translation id="7450541714075000668">Đã sao chép văn bản</translation>
<translation id="7458892263350425044">Để cho phép Chromium dùng micrô, hãy cấp quyền sử dụng trong phần <ph name="BEGIN_LINK" />cài đặt hệ thống<ph name="END_LINK" /></translation>
<translation id="5422859338435319909">Để nhận các bản cập nhật João Browser sau này, bạn cần có Windows 10 trở lên. Máy tính này đang sử dụng Windows 7.</translation>
<translation id="7467949745582939695">Chạy lại Chromium?</translation>
<translation id="7707324976708178089">Không thể cài đặt phiên bản João Browser giống với phiên bản hiện đang chạy. Hãy đóng João Browser và thử lại.</translation>
<translation id="7510190804000607802">Lời nhắc: Các tính năng tốt nhất của Google ngay trên điện thoại của bạn</translation>
<translation id="751935028865900641">Các trang web có thể sẽ hoạt động như dự kiến. Khi đóng tất cả các cửa sổ Chromium, bạn sẽ bị đăng xuất khỏi hầu hết các trang web, ngoại trừ Tài khoản Google nếu bạn đã đăng nhập vào Chromium.</translation>
<translation id="5325102834460669866">{0,plural, =1{João Browser sẽ khởi động lại sau 1 phút}other{João Browser sẽ khởi động lại sau # phút}}</translation>
<translation id="7565444033145385702">Để bảo vệ dữ liệu của bạn, hãy cho phép Chromium loại bỏ quyền của các trang web mà gần đây bạn không truy cập.</translation>
<translation id="8099958128052689767">Tự động khởi chạy João Browser để bắt đầu duyệt web ngay lập tức.</translation>
<translation id="7583399374488819119">Trình cài đặt <ph name="COMPANY_NAME" /></translation>
<translation id="7125257608567714221">João Browser đang sử dụng máy ảnh và micrô của bạn.</translation>
<translation id="227045421902171569">João Browser được cải tiến hơn</translation>
<translation id="5356567285381070312">Giờ đây, bạn có thể sử dụng nhiều tính năng hơn trong João Browser</translation>
<translation id="7624307931717240213">Chúng tôi sử dụng thông tin để cải thiện dịch vụ này. Vui lòng xem Chính sách quyền riêng tư và Điều khoản dịch vụ.</translation>
<translation id="7649070708921625228">Trợ giúp</translation>
<translation id="5714374331629713291">Tải ứng dụng João Browser</translation>
<translation id="7658239707568436148">Huỷ</translation>
<translation id="549378870470819535">João Browser không phải là trình duyệt mặc định của bạn</translation>
<translation id="6574348346278803862">Đồng bộ hóa và cá nhân hóa João Browser trên các thiết bị của bạn</translation>
<translation id="7699779824407626136">Cập nhật Chromium</translation>
<translation id="3304080024230377341">Bảo mật công việc của bạn trên João Browser</translation>
<translation id="7716950018788545737">Nhiệm vụ đã kết thúc.</translation>
<translation id="77283119132245232">Cung cấp dịch vụ theo dõi hệ thống cho <ph name="BROWSER_NAME" />. Nếu dịch vụ này bị vô hiệu hoá thì dấu vết hiệu suất do trình duyệt tạo ra sẽ không bao gồm các sự kiện trên toàn hệ thống như chuyển đổi ngữ cảnh và sự kiện luồng ở trạng thái sẵn sàng.</translation>
<translation id="7745317241717453663">Thao tác này sẽ xóa dữ liệu duyệt web của bạn khỏi thiết bị này. Để truy xuất dữ liệu của bạn sau, hãy đăng nhập vào Chromium dưới dạng <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Trình cài đặt không thể tạo thư mục tạm thời. Vui lòng kiểm tra dung lượng ổ đĩa còn trống và quyền cài đặt phần mềm.</translation>
<translation id="4713120944298974980">Tìm kiếm trong João Browser</translation>
<translation id="5804390944809171853">Đặt lại về João Browser mặc định</translation>
<translation id="6930487390575519812">Để bảo mật công việc của bạn trên João Browser, tổ chức bạn sẽ có thể xem hoặc quản lý một số thông tin khi bạn đăng nhập vào João Browser.</translation>
<translation id="5214761769821670245">Đặt João Browser làm trình duyệt mặc định và ghim vào thanh tác vụ</translation>
<translation id="1294697217796985566">Giúp João Browser hoạt động nhanh hơn</translation>
<translation id="1278345486417353853"><ph name="PAGE_TITLE" /> - João Browser Canary</translation>
<translation id="7803986347287457849">Đảm bảo những người có quyền truy cập vào dữ liệu lưu lượng truy cập Internet của bạn khó biết được các trang web bạn truy cập hơn. Chromium dùng một kết nối bảo mật để tra cứu địa chỉ IP của mỗi trang web trong DNS (Hệ thống tên miền).</translation>
<translation id="7810005234485217901">Bạn có thể ghim tính năng Tìm kiếm hình ảnh để thuận tiện sử dụng</translation>
<translation id="489728561211958943">Thiết bị này đã có một hồ sơ trên João Browser sử dụng tài khoản này</translation>
<translation id="7845233973568007926">Cảm ơn bạn đã cài đặt. Bạn phải khởi động lại máy tính trước khi sử dụng <ph name="BUNDLE_NAME" />.</translation>
<translation id="5294768452950207882">Công cụ tìm kiếm của bạn đã bị thay đổi từ bên ngoài João Browser. Để bảo vệ bạn, João Browser đã đặt lại công cụ này về chế độ mặc định ban đầu. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3244974069468656925">Tuỳ chỉnh João Browser để có giao diện mới</translation>
<translation id="7859018312476869945">Khi bạn nhập vào thanh địa chỉ hoặc hộp tìm kiếm, Chromium sẽ gửi nội dung bạn nhập đến công cụ tìm kiếm mặc định để đề xuất cho bạn cụm từ phù hợp hơn. Tính năng này bị tắt trong chế độ Ẩn danh.</translation>
<translation id="6517519572778941051">João Browser không thể cập nhật lên phiên bản mới nhất nên bạn đang bỏ lỡ các tính năng và bản vá bảo mật mới.</translation>
<translation id="7872446069773932638">Đang tải xuống... Còn <ph name="SECONDS" /> giây</translation>
<translation id="7873537467422636035">Nếu bạn quên cụm mật khẩu hoặc muốn thay đổi chế độ cài đặt này, hãy <ph name="BEGIN_LINK" />xoá dữ liệu Chromium khỏi tài khoản của bạn<ph name="END_LINK" /></translation>
<translation id="1722038268139386345">Nhanh chóng mở Gemini trong João Browser bất cứ khi nào bạn cần</translation>
<translation id="8344320926817290924">Đặt João Browser làm trình duyệt mặc định</translation>
<translation id="7934340546140346950">Chromium tự động nâng cấp các kết nối không an toàn lên HTTPS mỗi khi có thể</translation>
<translation id="3755057387338907970">Bạn đã đăng nhập vào João Browser là <ph name="USER_EMAIL_ADDRESS" />. Vui lòng sử dụng cùng tài khoản để đăng nhập lại.</translation>
<translation id="929903348843569380"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào João Browser bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể truy cập dấu trang và nhiều dữ liệu khác trên mọi thiết bị của mình.</translation>
<translation id="7975919845073681630">Đây là cài đặt thứ cấp của Chromium và không thể trở thành trình duyệt mặc định của bạn.</translation>
<translation id="8905411496853397218">Các tiện ích, ứng dụng và giao diện không rõ nguồn gốc có thể làm hại thiết bị của bạn. João Browser đề xuất bạn chỉ nền cài đặt những mục nói trên qua <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /></translation>
<translation id="6306672714476596428">Tận hưởng những tính năng tốt nhất của Google nhờ ứng dụng João Browser trên <ph name="DEVICE_TYPE" /></translation>
<translation id="8004582292198964060">Trình duyệt</translation>
<translation id="8010081455002666927">Tự động phát hiện</translation>
<translation id="2172829664765531568">Sau khi João Browser có quyền truy cập, các trang web sẽ có thể yêu cầu bạn cấp quyền truy cập.</translation>
<translation id="74641100973032765">Ghim João Browser vào thanh tác vụ để truy cập nhanh bất cứ lúc nào</translation>
<translation id="80471789339884597">Cảm ơn bạn đã cài đặt. Bạn phải khởi động lại tất cả trình duyệt trước khi sử dụng <ph name="BUNDLE_NAME" />.</translation>
<translation id="8054112667659782652">Luôn hiện lối tắt Tìm kiếm hình ảnh</translation>
<translation id="8069447462453318634">Chọn "Ghim vào thanh công cụ"</translation>
<translation id="5039671129725402518">Tắt João Browser đối với các ứng dụng chạy trong nền</translation>
<translation id="80790299200510644">Tìm kiếm hình ảnh</translation>
<translation id="8086881907087796310">Cài đặt không thành công vì máy tính của bạn không đáp ứng được các yêu cầu tối thiểu về phần cứng.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> – Google Chrome for Testing</translation>
<translation id="2430877582155731716">João Browser cần có quyền truy cập thông tin vị trí đối với trang web này</translation>
<translation id="8298045348217323">Lần tới, khi mở João Browser trên <ph name="DEVICE_TYPE" />, bạn sẽ thấy lời nhắc bật thông báo theo dõi giá.</translation>
<translation id="3827347991254458074">Nhận thông báo giảm giá cho những mặt hàng bạn quan tâm nhờ ứng dụng João Browser trên điện thoại</translation>
<translation id="8118331347066725040">Gửi ý kiến phản hồi về tính năng tìm kiếm bằng Ống kính</translation>
<translation id="2580039965224265556">Biến João Browser thành trình duyệt của riêng bạn</translation>
<translation id="8133124826068723441">ChromiumOS không thể đồng bộ hoá dữ liệu của bạn vì miền của bạn không dùng được tính năng Đồng bộ hoá.</translation>
<translation id="813913629614996137">Đang khởi chạy...</translation>
<translation id="7940955011992997426">Mở Gemini trong João Browser bằng một phím tắt.</translation>
<translation id="7560319627203819845">Điều khoản dịch vụ bổ sung của João Browser</translation>
<translation id="7133741820744999589">Tệp này nguy hiểm, do đó João Browser đã chặn tệp.</translation>
<translation id="8177472873527554730">Không tìm thấy nội dung trong trang</translation>
<translation id="8200109504272824693">Nhập cụm mật khẩu để sử dụng và lưu dữ liệu Chromium trong tài khoản <ph name="USER_EMAIL" /> của bạn</translation>
<translation id="820759916613250543">Tìm kiếm hình ảnh này bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="8221491193165283816">Bạn thường chặn các thông báo. Để cho phép trang web này thông báo cho bạn, hãy nhấp vào đây.</translation>
<translation id="8223363452568144035">Để cho phép Chromium dùng camera, hãy cấp quyền sử dụng trong phần <ph name="BEGIN_LINK" />cài đặt hệ thống<ph name="END_LINK" /></translation>
<translation id="8132864687089402359">João Browser không thể xác minh nguồn gốc của tiện ích này. Tiện ích này có thể không an toàn. Hãy xoá khỏi João Browser để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web mà bạn truy cập nữa.</translation>
<translation id="7600652022483599804">João Browser sẽ cố gắng mô tả cho bạn những hình ảnh không có nội dung mô tả hữu ích. Để tạo nội dung mô tả, các hình ảnh sẽ được gửi đến Google. Bạn có thể tắt dịch vụ này trong phần cài đặt bất kỳ lúc nào.</translation>
<translation id="8703735741562140394">Bạn muốn đăng nhập vào João Browser bằng hồ sơ mới?</translation>
<translation id="2830039647655087365"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào João Browser bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng mật khẩu và nhiều dữ liệu khác trên <ph name="DEVICE" />.</translation>
<translation id="1802935470126307750">Hiện Gemini trong João Browser trong khay hệ thống và bật phím tắt</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Chromium cảnh báo bạn<ph name="END_LINK" /> về các trang web và nội dung tải xuống không an toàn</translation>
<translation id="8295827201165805317">Gần đây bạn không truy cập trang web này. Chromium đã xoá <ph name="PERMISSION" />.</translation>
<translation id="481989138594406896">Mua sắm, dịch văn bản và nhận dạng những thứ bạn thấy bằng camera trên ứng dụng João Browser dành cho iOS</translation>
<translation id="5242426961520127942">Mã QR để đăng nhập vào João Browser bằng <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">Lỗi khi khởi động: <ph name="STARTUP_ERROR" />.</translation>
<translation id="3644336211313412429">Tổ chức của bạn sẽ đóng João Browser khi João Browser không được dùng đến trong <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8321888067342493336">Lưu dưới dạng hình ảnh</translation>
<translation id="3150519286474936594"><ph name="USER_EMAIL_ADDRESS" /> trước đó đã sử dụng João Browser</translation>
<translation id="8351551329754447960">Bật tính năng Kỹ năng trong Chromium</translation>
<translation id="4566781614303801262">Cập nhật João Browser để tiếp tục sử dụng dữ liệu João Browser trong Tài khoản Google <ph name="ACCOUNT_EMAIL" /> của bạn</translation>
<translation id="8404636483124146663">Để nhận các bản cập nhật João Browser sau này, bạn cần có Windows 10 trở lên. Máy tính này đang sử dụng Windows 8.</translation>
<translation id="8362914115861174987">Dịch sang</translation>
<translation id="8367705492654390392">Đặt câu hỏi bất kỳ</translation>
<translation id="8370517070665726704">Bản quyền <ph name="YEAR" /> Google LLC. Mọi quyền được bảo lưu.</translation>
<translation id="8954225380790220359">Để sử dụng mật khẩu và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào João Browser. Mật khẩu này sẽ được lưu trong Tài khoản Google của bạn sau khi bạn đăng nhập.</translation>
<translation id="208035402574338948">Sau đó, bạn cần khởi động lại João Browser.</translation>
<translation id="7458698097055456629">João Browser khuyên bạn nên loại bỏ tiện ích này. <ph name="BEGIN_LINK" />Tìm hiểu thêm về các tiện ích được hỗ trợ<ph name="END_LINK" /></translation>
<translation id="3428558977667883100">Tiện ích này đã bị nhà phát triển huỷ phát hành và có thể không an toàn. Hãy xoá khỏi João Browser để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web bạn truy cập nữa.</translation>
<translation id="5012944467031125860">João Browser cần xác minh danh tính của bạn thì mới có thể lưu một số dữ liệu vào Tài khoản Google và cho phép bạn sử dụng dữ liệu đó trên tất cả các thiết bị. Nếu bạn đăng xuất bây giờ, dữ liệu này sẽ bị xoá.</translation>
<translation id="8822543678238892300">{0,plural, =1{Khởi động lại João Browser trong vòng một ngày}other{Khởi động lại João Browser trong vòng # ngày}}</translation>
<translation id="8438543370129609977">Khi bạn sử dụng tính năng Tìm kiếm hình ảnh thì nội dung, URL và tiêu đề của trang, bao gồm cả tệp PDF, sẽ được gửi đến máy chủ. <ph name="LEARN_MORE" /></translation>
<translation id="4307944272317199640">Tìm hiểu thêm về cách tìm kiếm bằng tính năng Tìm kiếm hình ảnh trong João Browser</translation>
<translation id="6024135746436350583">Tệp lưu trữ trình cài đặt bị hỏng hoặc không hợp lệ. Hãy tải xuống João Browser lại lần nữa.</translation>
<translation id="4933173390191738516">João Browser yêu cầu Windows 10 trở lên.</translation>
<translation id="8463672209299734063">Không bắt buộc: Giúp cải thiện hiệu suất và các tính năng của ChromiumOS bằng cách tự động gửi dữ liệu sử dụng và chẩn đoán cho Google.</translation>
<translation id="4499703930846496679">Để sử dụng và lưu dữ liệu João Browser trong Tài khoản Google, hãy xác minh danh tính của bạn</translation>
<translation id="8482493977473846331">Hiện lời nhắc đăng nhập vào Chromium</translation>
<translation id="2129903037617090425">João Browser đã lỗi thời</translation>
<translation id="850264194101621529">Cảm ơn bạn đã chọn Chromium làm trình duyệt mặc định!</translation>
<translation id="8522801943730206384">Chromium có thể kiểm tra mật khẩu của bạn khi bạn lưu các mật khẩu đó</translation>
<translation id="8525579356836940628">Đã dừng cài đặt</translation>
<translation id="2445505893586445499">Mang theo mật khẩu, thẻ và nhiều dữ liệu khác mọi lúc, mọi nơi nhờ ứng dụng João Browser trên <ph name="DEVICE_TYPE" /></translation>
<translation id="8548787790260785208">Nhận cảnh báo nếu Chromium phát hiện một trong những mật khẩu của bạn bị lộ trong sự cố rò rỉ dữ liệu công khai</translation>
<translation id="8555465886620020932">Lỗi dịch vụ: <ph name="SERVICE_ERROR" />.</translation>
<translation id="8871890913961794658">Một số tính năng và tiện ích của João Browser đi kèm lối tắt. Bạn có thể chọn bật lại các lối tắt này.</translation>
<translation id="8556420416730706394">Bạn có thể ghim tính năng Tìm kiếm hình ảnh để thuận tiện sử dụng; hãy nhấp vào nút Ghim ở đầu bảng điều khiển bên</translation>
<translation id="856656450041460113">Tìm kiếm trong danh sách ngôn ngữ</translation>
<translation id="9044172203094901282">Nhiều tổ chức quản lý João Browser</translation>
<translation id="8586442755830160949">Bản quyền <ph name="YEAR" /> Tác giả Chromium. Mọi quyền được bảo lưu.</translation>
<translation id="8601359445272098721">Mới! Bạn có thể dịch cả văn bản và hình ảnh trên màn hình bằng cách chọn nút "dịch màn hình"</translation>
<translation id="1071663705626404814">Đang khởi động João Browser...</translation>
<translation id="8624541899164515475">Trang Cài đặt, mở trong thẻ mới.</translation>
<translation id="8648201657708811153">Bạn không thể đặt Google Chrome for Testing làm trình duyệt mặc định.</translation>
<translation id="5975137268566279898">Tiện ích này cũng điều khiển trang nào được hiển thị khi bạn khởi động João Browser hoặc tìm kiếm từ Thanh địa chỉ.</translation>
<translation id="6358904712334248114">Đây là João Browser của bạn</translation>
<translation id="8712637175834984815">Tôi hiểu</translation>
<translation id="5380190167074430719">Bạn muốn đăng nhập vào João Browser?</translation>
<translation id="8747073452963259673">góc dưới cùng bên trái của khu vực tìm kiếm: <ph name="LEFT" />% từ bên trái sang, <ph name="BOTTOM" />% từ dưới cùng lên</translation>
<translation id="878572486461146056">Lỗi cài đặt: Quản trị viên mạng của bạn đã áp dụng Chính sách nhóm ngăn chặn hoạt động cài đặt: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Nhắc tôi sau</translation>
<translation id="8871607387186266158">Chia sẻ tài liệu này với Gemini trong João Browser để xem thông tin tổng quan nhanh và đặt các câu hỏi nối tiếp</translation>
<translation id="3009329613270131861">Bạn muốn đăng nhập vào João Browser?</translation>
<translation id="8823401858233292222">Đặt Chromium làm trình duyệt mặc định và ghim vào thanh tác vụ</translation>
<translation id="8826492472752484139">Nhấp vào "Trình quản lý mật khẩu"</translation>
<translation id="8833697763442816810">Hệ thống ChromiumOS</translation>
<translation id="8852026904190808918">Ngôn ngữ này dùng để hiển thị trình đơn, chế độ cài đặt, cảnh báo và các nội dung khác trong Chromium</translation>
<translation id="8862326446509486874">Bạn không có quyền thích hợp để cài đặt cấp hệ thống. Thử chạy lại trình cài đặt với vai trò Quản trị viên.</translation>
<translation id="6821836710312478344">Thêm Hồ sơ João Browser</translation>
<translation id="5139769635207740615">ChromiumOS không thể lưu dữ liệu João Browser vào Tài khoản Google của bạn do xảy ra lỗi khi đăng nhập</translation>
<translation id="6814613825007700341">Tổ chức của bạn yêu cầu bạn đăng nhập vào João Browser</translation>
<translation id="1009831347869773172">João Browser đang cố gắng hiển thị mật khẩu. Nhập mật khẩu Windows của bạn để cho phép thực hiện việc này.</translation>
<translation id="690637523240192979">João Browser không còn là trình duyệt mặc định của bạn. Đặt João Browser làm trình duyệt mặc định?</translation>
<translation id="225046375773654931">Không thể cập nhật João Browser</translation>
<translation id="8944232836376404813">Hành động này sẽ:
          <ph name="LINE_BREAKS" />
            • Đặt lại trang khởi động, trang thẻ mới, công cụ tìm kiếm và các thẻ được ghim
            <ph name="LINE_BREAK" />
            • Tắt tiện ích
            <ph name="LINE_BREAK" />
            • Xoá cookie và dữ liệu trang web tạm thời khác
            <ph name="LINE_BREAKS" />
            Dấu trang, nhật ký và mật khẩu đã lưu sẽ không bị ảnh hưởng.</translation>
<translation id="4349474976990059197">Biểu tượng João Browser Enterprise</translation>
<translation id="3227699293368317033">Mang theo các tính năng an toàn của Google mọi lúc, mọi nơi nhờ ứng dụng João Browser trên <ph name="DEVICE_TYPE" /></translation>
<translation id="6527164294507620103">Không thể khởi động João Browser vì đã xảy ra lỗi khi mở hồ sơ của bạn. Hãy thử khởi động lại João Browser.</translation>
<translation id="6741767563284518125">Quản lý hồ sơ trên João Browser</translation>
<translation id="3101491883380219087">Dùng bàn phím để di chuyển giữa Gemini trong João Browser và thẻ đang mở.</translation>
<translation id="9018218886431812662">Đã cài đặt xong</translation>
<translation id="3370247132646333337">Để làm cho João Browser an toàn hơn, chúng tôi đã vô hiệu hóa tiện ích không được liệt kê trong <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> và có thể đã được thêm mà bạn không biết.</translation>
<translation id="1940116386572548863">Đăng nhập vào João Browser</translation>
<translation id="8381652653666868014">João Browser đã chặn tệp tải xuống này vì tệp lưu trữ gồm các tệp khác có thể ẩn chứa phần mềm độc hại</translation>
<translation id="8374335201144490555">Mật khẩu, dấu trang và nhật ký của bạn sẽ được đồng bộ hoá liền mạch trên mọi thiết bị. Hãy cập nhật trình duyệt mặc định thành João Browser để dễ dàng sử dụng các tính năng bạn quen thuộc và yêu thích. João Browser sẽ được ghim vào thanh tác vụ để bạn có thể truy cập nhanh chóng.</translation>
<translation id="6176486087616698123">Sử dụng các công cụ AI tốt nhất của Google nhờ ứng dụng João Browser trên điện thoại</translation>
<translation id="9062666675513499497">Đăng nhập vào Chromium khi bạn đăng nhập vào các dịch vụ khác của Google</translation>
<translation id="724802823738504651">João Browser đã tự động đóng</translation>
<translation id="2689333215784698609">João Browser đã lỗi thời</translation>
<translation id="8049510467237146160">{0,plural, =1{João Browser sẽ khởi động lại sau một giờ}other{João Browser sẽ khởi động lại sau # giờ}}</translation>
<translation id="9106236359747881194">Chọn văn bản bạn muốn tìm</translation>
<translation id="8558551666630075184">Để nhận các bản cập nhật João Browser sau này, bạn cần có Windows 10 trở lên. Máy tính này đang sử dụng Windows 8.1.</translation>
<translation id="1194819784870407331">Mở đường liên kết trong thẻ mới của João Browser</translation>
<translation id="911206726377975832">Bạn cũng muốn xóa dữ liệu duyệt web của mình?</translation>
<translation id="9134482777260927479">Trợ giúp làm bài tập về nhà</translation>
<translation id="9148058034647219655">Thoát</translation>
<translation id="548951409840319583">Tiếp tục từ nơi bạn đã dừng lại: João Browser có thể khôi phục các thẻ của bạn mỗi khi bạn khởi động lại. Để bật tính năng này, hãy chuyển đến</translation>
<translation id="7614949510548815395">Quản trị viên hệ thống của bạn đã định cấu hình João Browser để mở một trình duyệt thay thế khi truy cập vào <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="3441698750089879771">Chạy lại để cập nhật &amp;João Browser</translation>
<translation id="369689859238510548">João Browser (mDNS-In)</translation>
<translation id="8336832914816665097">Biến João Browser thành trình duyệt của riêng bạn</translation>
<translation id="7698429329590050365">João Browser có thể không hoạt động chính xác do không được hỗ trợ trên Windows XP hoặc Windows Vista nữa</translation>
<translation id="190261805571697214">Tận hưởng các tính năng an toàn tốt nhất của Google mọi lúc, mọi nơi nhờ João Browser.</translation>
<translation id="945522503751344254">Gửi phản hồi</translation>
<translation id="5554799509799759090">Ai đang sử dụng João Browser?</translation>
<translation id="9153108844196984904">Có được chế độ bảo mật mạnh nhất của João Browser</translation>
<translation id="983803489796659991">Không cài đặt được do máy chủ cập nhật không có dữ liệu băm nào cho ứng dụng.</translation>
<translation id="6230710687825107323">Dùng João Browser mà không cần tài khoản</translation>
<translation id="985602178874221306">Tác giả Chromium</translation>
<translation id="989970834842471429">Chọn văn bản hoặc hình ảnh bất kỳ mà bạn muốn tìm kiếm bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="992780518932311116">Để cho phép Chromium dùng thông tin vị trí, hãy cấp quyền sử dụng trong phần <ph name="BEGIN_LINK" />cài đặt hệ thống<ph name="END_LINK" /></translation>
</translationbundle>