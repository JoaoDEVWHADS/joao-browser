<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="1026101648481255140">Συνέχιση εγκατάστασης</translation>
<translation id="1029669172902658969">Επανεκκίνηση για ενημέρωση του &amp;Chromium OS</translation>
<translation id="4711726241445951349">Το João Browser συνιστά να ελέγξετε αυτή την επέκταση</translation>
<translation id="1042552502243217427">Όταν ένας ιστότοπος ζητά την ιδιωτική προφόρτωση συνδέσμων στη σελίδα του, το Chromium χρησιμοποιεί τους διακομιστές της Google. Με αυτόν τον τρόπο, η ταυτότητά σας αποκρύπτεται από τον προφορτωμένο ιστότοπο, αλλά η Google μαθαίνει ποιοι ιστότοποι προφορτώνονται.</translation>
<translation id="1051793555070215510">Βοηθήστε μας να βελτιώσουμε την ανώνυμη περιήγηση, συμμετέχοντας σε αυτή την έρευνα διάρκειας 1 λεπτού.</translation>
<translation id="1065672644894730302">Δεν είναι δυνατή η ανάγνωση των προτιμήσεών σας. Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες και οι αλλαγές στις προτιμήσεις δεν θα αποθηκευτούν.</translation>
<translation id="3937976866851867994">Ο γονέας σου απενεργοποίησε την επιλογή "Άδειες για ιστοτόπους, εφαρμογές και επεκτάσεις" για το João Browser</translation>
<translation id="8626021334348319355">Για να αναζητήσετε μια συγκεκριμένη λειτουργία ή επέκταση του João Browser, πληκτρολογήστε τη συντόμευσή της στη γραμμή διευθύνσεων και, στη συνέχεια, το επιλεγμένο πλήκτρο πληκτρολογίου</translation>
<translation id="571817873405657554">Εμφάνιση της αναζήτησης με το João Browser στην περιοχή ειδοποιήσεων και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="9157778882771986870">Το João Browser θέλει να εξαγάγει τους κωδικούς πρόσβασής σας. Για να το επιτρέψετε αυτό, πληκτρολογήστε τον κωδικό πρόσβασης για τα Windows.</translation>
<translation id="112640046208448578">Αναγνωρίστε αντικείμενα ή μέρη και αντιγράψτε ή μεταφράστε κείμενο. Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες, ένα στιγμιότυπο οθόνης της σελίδας αποστέλλεται στον διακομιστή. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Το Chromium είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="1131805035311359397">Για να ελέγξετε αν οι κωδικοί πρόσβασής σας είναι ασφαλείς από παραβιάσεις δεδομένων και άλλα ζητήματα ασφαλείας, <ph name="BEGIN_LINK" />συνδεθείτε στο Chromium<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">Κάντε κλικ στο μενού του João Browser</translation>
<translation id="1157985233335035034">Πρόσφατες γλώσσες</translation>
<translation id="1184145431117212167">Η εγκατάσταση απέτυχε επειδή η έκδοση των Windows που χρησιμοποιείτε δεν υποστηρίζεται.</translation>
<translation id="1185134272377778587">Σχετικά με το Chromium</translation>
<translation id="667420476518265356">Λήψη ειδοποιήσεων παρακολούθησης τιμής με το João Browser στο τηλέφωνό σας</translation>
<translation id="1203500561924088507">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε το πρόγραμμα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">Όταν ανοίγετε την Αναζήτηση με εικόνες, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, θα αποστέλλονται αυτόματα στον διακομιστή. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας Google στο João Browser. Για να αλλάξετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα Ο λογαριασμός σας στο João Browser.</translation>
<translation id="4866003137980530528">Εμφάνιση του Gemini στο João Browser στη γραμμή μενού του Mac</translation>
<translation id="2526294198551578217">Για να επιλέξετε ένα μέρος της οθόνης στο Gemini στο João Browser, χρησιμοποιήστε μια συντόμευση πληκτρολογίου.</translation>
<translation id="7068536367561625920">Ενώ αυτή η καρτέλα ήταν ανενεργή, ελευθερώθηκε μνήμη για να παραμείνει γρήγορο το João Browser. Μπορείτε να επιλέξετε να εξαιρείται πάντα αυτός ο ιστότοπος, ώστε να παραμένει ενεργός.</translation>
<translation id="3669854427836618143">Το João Browser απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι επικίνδυνο</translation>
<translation id="126567311906253476">Όταν συνδέεστε σε υπηρεσίες Google, όπως το Gmail ή το YouTube, με τον λογαριασμό <ph name="USER_EMAIL" />, μπορείτε να συνδέεστε αυτόματα στο Chromium με τον ίδιο λογαριασμό</translation>
<translation id="8094399825947986050">Λήψη του João Browser στο τηλέφωνό σας</translation>
<translation id="1290883685122687410">Σφάλμα ρύθμισης: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">Ρυθμίστε το νέο σας προφίλ στο João Browser</translation>
<translation id="7591029065989504977">Δοκιμάστε τη με το Gemini στο João Browser</translation>
<translation id="8408989583029959522">Το João Browser χρειάζεται πρόσβαση στο Bluetooth για εξερεύνηση&#32;
 Συσκευών Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">Συνδεθείτε στο João Browser από το τηλέφωνό σας</translation>
<translation id="1330562121671411446">Εντοπισμός γλώσσας</translation>
<translation id="6026568602942276348">Να διαγραφούν επίσης δεδομένα από το João Browser (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Καρφιτσώθηκε! Μπορείτε να αποκτήσετε ξανά πρόσβαση στην Αναζήτηση με εικόνες από το νέο κουμπί στη γραμμή εργαλείων</translation>
<translation id="1356661055722410047">Νέο! Μπορείτε να μεταφράσετε κείμενο και εικόνες που εμφανίζονται στην οθόνη σας</translation>
<translation id="1383876407941801731">Αναζήτηση</translation>
<translation id="5807085300679014096">Χρησιμοποιήστε την εφαρμογή João Browser για να συνεχίσετε την περιήγηση εν κινήσει</translation>
<translation id="141901961143729572">Μοιραστείτε τις σκέψεις σας</translation>
<translation id="3736947618013031173">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το João Browser στις Ρυθμίσεις συστήματος.</translation>
<translation id="1478370723027452770">Λήψη βοήθειας για το Chrome for Testing</translation>
<translation id="1497802159252041924">Σφάλμα εγκατάστασης: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Αυτή η σελίδα είναι προστατευμένη</translation>
<translation id="4379865404970367448">Μοιραστείτε μια καρτέλα του João Browser</translation>
<translation id="4436275659297289591">Σύνδεση στο João Browser</translation>
<translation id="1547469039832541117">Τερματίζει την επισημασμένη εργασία.</translation>
<translation id="449712764049695153">Καρφίτσωμα João Browser</translation>
<translation id="1574377791422810894">Εργαλεία ασφάλειας του Chromium</translation>
<translation id="5480232403718129394">Το João Browser θέλει να διαγράψει τα δεδομένα της Διαχείρισης κωδικών πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το João Browser, προκειμένου να εφαρμοστεί μια ενημέρωση.}=1{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το João Browser, προκειμένου να εφαρμοστεί μια ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το João Browser, προκειμένου να εφαρμοστεί μια ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="980976428162070137">Αξιοποιήστε τις καλύτερες λειτουργίες της Google με την εφαρμογή João Browser στο τηλέφωνό σας</translation>
<translation id="1625909126243026060">Ελέγξτε σημαντικά στοιχεία ελέγχου για το απόρρητο και την ασφάλεια στο Chromium</translation>
<translation id="1640672724030957280">Γίνεται λήψη…</translation>
<translation id="1665602916345474427">Συνδεθήκατε ως <ph name="USER_NAME" />, <ph name="USER_EMAIL" />: με συνδρομή. Άνοιγμα του μενού λογαριασμού</translation>
<translation id="1708414395296835197">Μπορείτε να χρησιμοποιείτε το Chromium κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές. Επίσης, θα καρφιτσωθεί στη γραμμή εργαλείων.</translation>
<translation id="1709772298389099340">Παρέχει αναβαθμισμένα προνόμια για το <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Αυτό θα σας επιτρέψει να επιλέγετε μία από τις διαθέσιμες συσκευές και να προβάλλετε περιεχόμενο σε αυτήν.</translation>
<translation id="6972087163510342335">Το João Browser θα διαγράψει σύντομα τα δεδομένα περιήγησης</translation>
<translation id="1736443181683099871">Το Chromium θα προσπαθήσει να αναβαθμίσει τις πλοηγήσεις σε HTTPS</translation>
<translation id="3879288383593333401">Διαγρ. δεδ. João Browser</translation>
<translation id="656496276885630888">Θα γίνει επανεκκίνηση του João Browser σε <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Όταν δεν είναι διαθέσιμο το HTTPS, το Chromium θα χρησιμοποιεί μια μη ασφαλή σύνδεση χωρίς να σας ειδοποιεί</translation>
<translation id="1226290419185955779">Να επιτρέπεται στο João Browser να εκτελείται στο παρασκήνιο</translation>
<translation id="4231366995273072370">Για να κάνουμε το João Browser πιο ασφαλές, απενεργοποιήσαμε ορισμένες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="1822049153969905781">Κάντε κλικ στο κουμπί <ph name="BEGIN_BOLD" />Ναι<ph name="END_BOLD" /> στην ειδοποίηση των Windows, για να καρφιτσώσετε το João Browser στη γραμμή εργαλείων για γρήγορη πρόσβαση.</translation>
<translation id="1321831992638405531">Επανεγκατάσταση του João Browser</translation>
<translation id="3386967202064865436">Το João Browser προσπαθεί να <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="70054449700528483">Την επόμενη φορά που θα ανοίξετε το João Browser στη συσκευή <ph name="DEVICE_TYPE" />, θα δείτε μια προτροπή για χρήση της Διαχείρισης κωδικών πρόσβασης Google.</translation>
<translation id="1838374766361614909">Διαγραφή αναζητήσεων</translation>
<translation id="5807096362853316123">Για να διαγράψετε τα δεδομένα περιήγησης μόνο από αυτή τη συσκευή και να τα διατηρήσετε στον Λογαριασμό σας Google, <ph name="BEGIN_LINK" />αποσυνδεθείτε από το João Browser<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">Κατεβάστε το João Browser στο τηλέφωνό σας για άνοιγμα ή δημιουργία νέων ομάδων καρτελών εν κινήσει.</translation>
<translation id="185970820835152459">Μπορείτε να διαχειριστείτε τους συνδεδεμένους Λογαριασμούς σας Google. Οι Λογαριασμοί σας Google χρησιμοποιούνται για το πρόγραμμα περιήγησης Chromium, το Play Store, το Gmail κ.ά. Εάν θέλετε να προσθέσετε έναν λογαριασμό για κάποιο άλλο άτομο, όπως για ένα μέλος της οικογένειας, προσθέστε, αντ' αυτού, ένα νέο άτομο στη συσκευή σας <ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />Μάθετε περισσότερα<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Αναζητήστε με την Αναζήτηση με εικόνες</translation>
<translation id="65457771685016683">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο João Browser με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία από <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Επιλογή κειμένου</translation>
<translation id="2634119629547215883">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο João Browser. Τα δεδομένα σας στο João Browser, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME" />. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών Google, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. Αν θέλετε, μπορείτε να δημιουργήσετε ένα νέο προφίλ στο οποίο θα διατηρηθούν ξεχωριστά τα υπάρχοντα δεδομένα του João Browser. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Το Chromium εξοικονομεί μπαταρία περιορίζοντας τη δραστηριότητα στο παρασκήνιο και τα οπτικά εφέ, όπως είναι η ομαλή κύλιση και οι ρυθμοί καρέ βίντεο. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με την Εξοικονόμηση ενέργειας<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">Υπηρεσία João Browser Updater</translation>
<translation id="1911763535808217981">Με την απενεργοποίηση αυτής της λειτουργίας, μπορείτε να συνδεθείτε σε ιστοτόπους Google, όπως το Gmail, χωρίς να συνδεθείτε στο Chromium</translation>
<translation id="4037729269678342163">Το João Browser δεν ανταποκρίνεται. Να γίνει επανεκκίνηση τώρα;</translation>
<translation id="7563750688920581112">Ο οργανισμός σας, <ph name="MANAGER" />, απαιτεί να συνδεθείτε στο João Browser</translation>
<translation id="193439633299369377">Για να εφαρμοστεί η ενημέρωση, πρέπει να γίνει επανεκκίνηση του Chromium OS.</translation>
<translation id="7099143775283792684">Το João Browser απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του τύπου αρχείου και ενδέχεται να είναι επικίνδυνος</translation>
<translation id="1953553007165777902">Λήψη… Απομένουν <ph name="MINUTE" /> λεπτά</translation>
<translation id="1966382378801805537">Το Chromium δεν μπορεί να καθορίσει ή να ορίσει το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="197326043290947695">Περιηγηθείτε πιο έξυπνα με την Αναζήτηση με εικόνες</translation>
<translation id="6185556991023272801">Μάθετε γιατί το João Browser αποκλείει ορισμένα αρχεία, ανοίγει σε νέα καρτέλα</translation>
<translation id="4053636705816895911">Διατηρεί το λογισμικό João Browser ενημερωμένο. Εάν αυτή η υπηρεσία απενεργοποιηθεί ή σταματήσει, το λογισμικό João Browser δεν θα ενημερώνεται, πράγμα που σημαίνει ότι δεν θα είναι δυνατή η επιδιόρθωση ευπαθειών ασφάλειας που μπορεί να εμφανιστούν και μπορεί να μη λειτουργούν ορισμένα χαρακτηριστικά. Η εγκατάσταση της υπηρεσίας αυτής καταργείται αυτόματα, όταν δεν υπάρχει λογισμικό João Browser που να τη χρησιμοποιεί.</translation>
<translation id="2008474315282236005">Με αυτή την ενέργεια θα διαγραφεί 1 στοιχείο από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Chromium ως <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Αποτυχία εγκατάστασης. Δοκιμάστε ξανά.</translation>
<translation id="2039417478970545937">Ρυθμίσεις.</translation>
<translation id="2049376729098081731">Επιλέξτε αν θέλετε να συμπεριλαμβάνεται το ιστορικό Chromium για πιο εξατομικευμένες εμπειρίες στις υπηρεσίες Google.</translation>
<translation id="6768767091114123654">Είναι ενσωματωμένη στο João Browser για να σας βοηθά να δημιουργείτε, να αποθηκεύετε και να συμπληρώνετε αυτόματα ισχυρούς κωδικούς πρόσβασης. Προσθέστε τη συντόμευση για εύκολη πρόσβαση.</translation>
<translation id="3571664229232252557">Κάντε κλικ στο κουμπί Προσαρμογή João Browser στη σελίδα Νέα καρτέλα, για να δώσετε μια νέα εμφάνιση στο João Browser</translation>
<translation id="4273287215573278663">Το João Browser απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι παραπλανητικό και μπορεί να κάνει μη αναμενόμενες αλλαγές στη συσκευή σας</translation>
<translation id="9063967192437499581">Την επόμενη φορά που θα ανοίξετε το João Browser iOS, θα δείτε μια προτροπή για να δοκιμάσετε τη λειτουργία <ph name="FEATURE_NAME" />.</translation>
<translation id="8511569826706775962">Οι κωδικοί πρόσβασης και άλλα δεδομένα του João Browser που αποθηκεύσατε στον Λογαριασμό σας Google θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο João Browser, συνδεθείτε ξανά.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το João Browser δεν χρησιμοποιείται για 1 λεπτό. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}other{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το João Browser δεν χρησιμοποιείται για # λεπτά. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}}</translation>
<translation id="2125838419757773031">Επιλέξτε περιοχή της οθόνης για αναζήτηση</translation>
<translation id="2126108037660393668">Η επιβεβαίωση του ληφθέντος αρχείου απέτυχε.</translation>
<translation id="2135919691573380097">Αναφορά αυτού του ιστοτόπου</translation>
<translation id="2137162749895930932">Κλείσιμο οθόνης μετάφρασης</translation>
<translation id="1308845716497059117">Το João Browser απέκλεισε αυτή τη λήψη επειδή ο ιστότοπος δεν χρησιμοποιεί ασφαλή σύνδεση και το αρχείο μπορεί να έχει παραβιαστεί</translation>
<translation id="2170098639895543546">Επιλέξτε οτιδήποτε στη σελίδα</translation>
<translation id="6705844023496387932">Προσαρμογή του João Browser</translation>
<translation id="2174917724755363426">Η εγκατάσταση δεν έχει ολοκληρωθεί. Είστε βέβαιοι ότι θέλετε να την ακυρώσετε;</translation>
<translation id="7728290795259244895">João Browser - Σύνδεση δικτύου - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Σφάλμα ελέγχου για ενημερώσεις: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">Κατάργηση λογαριασμού από το João Browser</translation>
<translation id="4648870374540039667">Χρησιμοποιήστε την εφαρμογή João Browser για να έχετε τα καλύτερα εργαλεία αγορών εν κινήσει</translation>
<translation id="2106116820042118250">Παραμείνετε ασφαλείς εν κινήσει με τη Βελτιωμένη Ασφαλή περιήγηση στο João Browser για iOS</translation>
<translation id="2210682093923538346">Επικίνδυνος ιστότοπος. Το Chromium κατάργησε ειδοποιήσεις.</translation>
<translation id="2236949375853147973">Η δραστηριότητά μου</translation>
<translation id="118764235932893741">Για να έχετε πρόσβαση στις διευθύνσεις σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο João Browser. Αυτή η διεύθυνση θα αποθηκευτεί στον Λογαριασμό σας Google μετά τη σύνδεσή σας.</translation>
<translation id="7254578863532089400">Αν χρησιμοποιείτε έναν υπολογιστή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το João Browser ακριβώς όπως θέλουν.</translation>
<translation id="22571759390241347">Δεξιότητες στο Chromium</translation>
<translation id="2283803047247799269">Αναζήτηση σε αυτή την καρτέλα με την Αναζήτηση με εικόνες</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{Το João Browser συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το João Browser συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="2307973900865360088">Διατήρηση στο Dock</translation>
<translation id="2313870531055795960">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο Chromium. Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το Chromium μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση.</translation>
<translation id="2356070529366658676">Να γίνεται ερώτηση</translation>
<translation id="2359808026110333948">Συνέχεια</translation>
<translation id="3800730051093461113">Η επέκταση <ph name="EXTENSION_NAME" /> θέλει να συνδεθείτε στο João Browser</translation>
<translation id="8758735062658446604">Απενεργοποίηση του João Browser, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="2623595027619107207">Για να χρησιμοποιήσετε αυτή την επέκταση με τον λογαριασμό <ph name="USER_EMAIL_ADDRESS" />, συνδεθείτε στο João Browser.</translation>
<translation id="2384373936468275798">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chromium OS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις João Browser}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις João Browser}other{Αποκτήθηκε πρόσβαση σε # συσκευές HID από μία ή περισσότερες επεκτάσεις João Browser}}</translation>
<translation id="6254788431480237503">Το João Browser χρειάζεται άδεια μικροφώνου και κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="2403703063067034158">Σφάλμα εκκίνησης: Αυτή τη στιγμή εκτελείται μια άλλη παρουσία της ρύθμισης. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="3028975423343897358">Ανοίξτε συνδέσμους στο João Browser από οποιαδήποτε εφαρμογή και διατηρήστε το πρόγραμμα περιήγησης προσβάσιμο στη γραμμή εργαλείων</translation>
<translation id="579079006139156831">Κάντε κλικ στο κουμπί Σύνοψη, για να κοινοποιήσετε αυτό το έγγραφο στο Gemini στο João Browser, να λάβετε μια γρήγορη επισκόπηση και να κάνετε επιπλέον ερωτήσεις</translation>
<translation id="2440750600860946460">Με τα <ph name="BEGIN_LINK" />εργαλεία του Chromium<ph name="END_LINK" />, μπορείτε να περιηγείστε με ασφάλεια και να διατηρείτε τον έλεγχο</translation>
<translation id="7114471809991869757">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο João Browser με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="2451727308784734061">Χρησιμοποιήστε τη συντόμευση για να μεταβείτε γρήγορα στον Διαχειριστή κωδικών πρόσβασης. Μπορείτε να μετακινήσετε τη συντόμευση στην αρχική οθόνη ή στην εφαρμογή εκκίνησης του υπολογιστή.</translation>
<translation id="2709136733469807397">Το João Browser θα κλείσει σύντομα</translation>
<translation id="3652225684487279741">Στο João Browser</translation>
<translation id="2485422356828889247">Απεγκατάσταση</translation>
<translation id="2513154137948333830">Απαιτείται επανεκκίνηση: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Επιλογή κειμένου με την Αναζήτηση με εικόνες</translation>
<translation id="1527474262707362156">Το João Browser προσπαθεί να αντικαταστήσει τους υπάρχοντες κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="6480371226914552131">Το João Browser χρειάζεται πρόσβαση στον αποθηκευτικό χώρο για τη λήψη αρχείων</translation>
<translation id="6318568902186985084">Πρόγραμμα βοήθειας João Browser</translation>
<translation id="2575822587468774919">Επιλέξτε οτιδήποτε για αναζήτηση με την Αναζήτηση με εικόνες</translation>
<translation id="4557210258834653476">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο João Browser</translation>
<translation id="1148164459654218834">Σαρώστε τον κωδικό QR με το τηλέφωνό σας, για να κατεβάσετε το João Browser και να συνδεθείτε στον Λογαριασμό σας Google.</translation>
<translation id="235892353478111963">Συνέχεια χρήσης του João Browser</translation>
<translation id="259935314519650377">Απέτυχε η αποθήκευση του ληφθέντος προγράμματος εγκατάστασης στην κρυφή μνήμη. Σφάλμα: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Σύστημα</translation>
<translation id="8471946631262724853">Ο οργανισμός σας μπορεί να βλέπει και να διαχειρίζεται τα δεδομένα περιήγησης, όπως σελιδοδείκτες, ιστορικό και κωδικούς πρόσβασης. Δεν μπορεί να βλέπει τα δεδομένα περιήγησης σε άλλα προφίλ στο João Browser</translation>
<translation id="2870759219964376597">Επαληθεύστε την ταυτότητά σας, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα João Browser στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="2955972712254986678">{COUNT,plural, =0{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το João Browser, προκειμένου να εφαρμοστεί μια ενημέρωση}=1{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το João Browser, προκειμένου να εφαρμοστεί μια ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το João Browser, προκειμένου να εφαρμοστεί μια ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="8949462882238006192">Έναρξη του João Browser</translation>
<translation id="4224214204752803768">Παρουσιάστηκε σφάλμα στο λειτουργικό σύστημα κατά την εγκατάσταση. Κατεβάστε το João Browser ξανά.</translation>
<translation id="3141414135710372892">Εάν χρησιμοποιείτε μια συσκευή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το João Browser ακριβώς όπως θέλουν.</translation>
<translation id="8838607803339100223">Εύκολη πρόσβαση για χρήση του Gemini στο João Browser σε όλη τη συσκευή σας, ακόμα και αν το João Browser είναι ελαχιστοποιημένο.</translation>
<translation id="1679364578146271696">Καρτέλα João Browser</translation>
<translation id="2718390899429598676">Για επιπλέον ασφάλεια, το Chromium θα κρυπτογραφήσει τα δεδομένα σας.</translation>
<translation id="1874696651662237927">Για να καταργήσετε τον Λογαριασμό σας Google από το João Browser, αποσυνδεθείτε</translation>
<translation id="6850669719663104304">Για να έχετε πρόσβαση στους κωδικούς πρόσβασης, στους σελιδοδείκτες και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο João Browser</translation>
<translation id="2738871930057338499">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 403 Forbidden. Ελέγξτε τη διαμόρφωση των παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="2753623023919742414">Κάντε κλικ για αναζήτηση</translation>
<translation id="4193420110872590792">Ορισμός του João Browser ως προεπιλεγμένου προγράμματος προβολής PDF</translation>
<translation id="6614401181366354261">Αυτή η επέκταση περιέχει κακόβουλο πρόγραμμα και δεν είναι ασφαλής. Καταργήστε την από το João Browser, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="2799223571221894425">Επανεκκίνηση</translation>
<translation id="6299858290790311689">Το δικό σας João Browser</translation>
<translation id="2816462166102338036">Αναζήτηση αυτού του βίντεο με την Αναζήτηση με εικόνες</translation>
<translation id="5896458971800337862">Ανακαλύψτε προϊόντα με την κάμερα, παρακολουθήστε τις πτώσεις τιμών και πολλά άλλα εν κινήσει με το João Browser σε iOS.</translation>
<translation id="2841525013647267359">Μετάφραση από</translation>
<translation id="2846251086934905009">Σφάλμα εγκατάστασης: Το πρόγραμμα εγκατάστασης δεν ολοκληρώθηκε. Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="4357241592510111611">Κατάργηση από το João Browser…</translation>
<translation id="2850691299438350830">Διατηρεί την ασφάλειά σας στο Chromium και μπορεί να χρησιμοποιηθεί για τη βελτίωση της ασφάλειάς σας σε άλλες εφαρμογές Google όταν είστε συνδεδεμένοι.</translation>
<translation id="2885378588091291677">Διαχείριση εργασιών</translation>
<translation id="8887040619780090085">Σχετικά με το &amp;João Browser</translation>
<translation id="2915996080311180594">Επανεκκίνηση αργότερα</translation>
<translation id="6619708652934279502">Τα δεδομένα σας κρυπτογραφούνται με τη φράση πρόσβασης. Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα João Browser στον Λογαριασμό σας Google.</translation>
<translation id="2945997411976714835">Σφάλμα εγκατάστασης: Απέτυχε η εκκίνηση της διεργασίας του προγράμματος εγκατάστασης.</translation>
<translation id="4566114009566397386">Συνδεθείτε πιο γρήγορα σε ιστοτόπους χρησιμοποιώντας αποθηκευμένους κωδικούς πρόσβασης για το João Browser σε iOS</translation>
<translation id="562175540137901632">Ο οργανισμός σας διαχειρίζεται το João Browser</translation>
<translation id="2977470724722393594">Το Chromium έχει ενημερωθεί</translation>
<translation id="2977506796191543575">Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το Chromium μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση</translation>
<translation id="1776205510657237623">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, συνδέσου στο João Browser</translation>
<translation id="3003694935412297923">Όλες οι εργασίες</translation>
<translation id="3374694374267805392">{count,plural, =1{Το João Browser πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Google και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα (1 στοιχείο) θα διαγραφούν.}other{Το João Browser πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Google και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα ({count} στοιχεία) θα διαγραφούν.}}</translation>
<translation id="4915792193596835645">Άνοιγμα της διεύθυνσης <ph name="URL" /> σε νέα καρτέλα στο João Browser.</translation>
<translation id="302551344979399011">Οι καινοτομίες AI, όπως οι δεξιότητες, αποθηκεύονται στον Λογαριασμό σας Google και η διαχείρισή τους γίνεται ξεχωριστά από τον συγχρονισμό του Chromium</translation>
<translation id="8367114375553489372">Προσθήκη στο João Browser…</translation>
<translation id="3038232873781883849">Αναμονή για εγκατάσταση…</translation>
<translation id="3045032126857188731">Γλώσσα μετάφρασης: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Κλείσιμο παραθύρου διαλόγου σχολίων</translation>
<translation id="6168172692486433600">Άλλα προφίλ João Browser</translation>
<translation id="884929993636327">Οι επεκτάσεις είναι πρόσθετα που σας επιτρέπουν να προσαρμόζετε το João Browser. Από την οργάνωση έως την απλοποίηση των καθημερινών εργασιών, οι επεκτάσεις σάς βοηθούν να προσαρμόζετε το João Browser στις ανάγκες σας.</translation>
<translation id="1525897524206034002">Βοηθήστε μας να κάνουμε το João Browser καλύτερο, αποστέλλωντας αναφορές σφαλμάτων και <ph name="UMA_LINK" /> στην Google</translation>
<translation id="2766971658743453990">Χρησιμοποιήστε την εφαρμογή João Browser για να έχετε μαζί σας την ασφάλεια της Google</translation>
<translation id="4387884830246074210">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις João Browser}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις João Browser}other{Αποκτήθηκε πρόσβαση σε # συσκευές USB από μία ή περισσότερες επεκτάσεις João Browser}}</translation>
<translation id="3413144813287436446">Ιστορικό João Browser</translation>
<translation id="9192419056064225629">Η αποσυμπίεση του αρχείου από το πρόγραμμα εγκατάστασης απέτυχε. Κατεβάστε το João Browser ξανά.</translation>
<translation id="310459126943037700">Ο τερματισμός των εργασιών απέτυχε.</translation>
<translation id="3104828284009500087">Αναζητήστε οτιδήποτε στη σελίδα</translation>
<translation id="3508468328135806512">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές. Αποκτήστε εύκολα πρόσβαση στις λειτουργίες που γνωρίζετε και αγαπάτε, ορίζοντας το João Browser ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="3216151988142306917">Το João Browser χρησιμοποιεί το μικρόφωνό σας.</translation>
<translation id="3130333203120345554">Νέα αναζήτηση</translation>
<translation id="3137969841538672700">Σύρετε για αναζήτηση</translation>
<translation id="7493177208577109722">Αυτή η καρτέλα χρησιμοποιεί επιπλέον πόρους. Για να βελτιώσετε την απόδοση, επιτρέψτε στο João Browser να την απενεργοποιήσει.</translation>
<translation id="7239354789967255675">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το João Browser στις Ρυθμίσεις συστήματος</translation>
<translation id="4955872590603594814">Επανεκκίνηση João Browser</translation>
<translation id="3161522574479303604">Όλες οι γλώσσες</translation>
<translation id="4697739132113629685">Άνοιγμα Συνδέσμου σε Παράθυρο ανών&amp;υμης περιήγησης João Browser</translation>
<translation id="1629247860984475766">Προσαρμόστε το νέο σας προφίλ João Browser</translation>
<translation id="1905008150929775692">Μπορείτε να συνεχίσετε να συνομιλείτε με τη Λειτουργία AI χωρίς να αλλάξετε καρτέλες. Για να ξεκινήσετε, συνδεθείτε στο João Browser. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="4232381420311815141">Για να καταργήσετε τον Λογαριασμό σας Google από το João Browser, αποσυνδεθείτε από το João Browser στη σελίδα Ρυθμίσεις</translation>
<translation id="3234316605225071811">Αργότερα, το Chromium μπορεί να σας ρωτήσει αν θέλετε να χρησιμοποιήσετε τα αποθηκευμένα στοιχεία για την αυτόματη συμπλήρωση φορμών για εσάς</translation>
<translation id="6676749542734993844">Το João Browser δεν έχει δυνατότητα ανάγνωσης και εγγραφής στον κατάλογο δεδομένων του:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">Μεταφέρετε μαζί σας τα αγαπημένα σας εργαλεία Google AI με το João Browser σε iOS.</translation>
<translation id="3286538390144397061">Άμεση επανεκκίνηση</translation>
<translation id="532528773927600103">Λείπουν κλειδιά του Google API. Ορισμένες λειτουργίες του Google João Browser θα απενεργοποιηθούν.</translation>
<translation id="3296368748942286671">Να συνεχίζεται η εκτέλεση εφαρμογών παρασκηνίου όταν το Chromium είναι κλειστό</translation>
<translation id="3313189106987092621">Το Chromium θα σας ειδοποιεί πριν από τη φόρτωση ιστοτόπων με μη ασφαλή σύνδεση</translation>
<translation id="8095477191923518137">Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του João Browser, εκτός από τον Λογαριασμό σας Google εάν είστε συνδεδεμένοι στο João Browser. Για να επιτρέψετε στους ιστοτόπους να απομνημονεύουν τα στοιχεία σας, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">επάνω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT" />%, επάνω <ph name="TOP" />%</translation>
<translation id="3366305173356742781">Δεδομένα Chromium στον λογαριασμό σας</translation>
<translation id="3234882977104294240">Χρησιμοποιήστε τους κωδικούς πρόσβασης με το João Browser στο τηλέφωνό σας</translation>
<translation id="3387527074123400161">Chromium OS</translation>
<translation id="2974199599420431595">Εναλλαγή σε υπάρχον προφίλ João Browser;</translation>
<translation id="3412460710772753638">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="3438772217992559640">Αναζήτηση αυτής της καρτέλας με την Αναζήτηση με εικόνες</translation>
<translation id="8318147705317768982">Επεκτείνετε τη Βελτιωμένη Ασφαλή περιήγηση με το João Browser στο τηλέφωνό σας</translation>
<translation id="347392028839310978">Προσαρμογή του João Browser…</translation>
<translation id="3474745554856756813">Με αυτή την ενέργεια θα διαγραφούν <ph name="ITEMS_COUNT" /> στοιχεία από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Chromium ως <ph name="USER_EMAIL" />.</translation>
<translation id="5805833167703404998">Με τη συντόμευση <ph name="SHORTCUT" /> μπορείτε να κάνετε εναλλαγή μεταξύ των προφίλ João Browser</translation>
<translation id="1835124883585653877">Κλείστε όλα τα παράθυρα του João Browser και δοκιμάστε ξανά.</translation>
<translation id="7106246566966568195">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το João Browser στις Ρυθμίσεις συστήματος</translation>
<translation id="6017005873246021363">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος.  Για να διατηρήσετε ξεχωριστά την περιήγησή σας, συνδεθείτε στο João Browser με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="1146681170626381319">Κωδικός QR για τη λήψη του προγράμματος περιήγησης João Browser σε κινητές συσκευές</translation>
<translation id="354621070532799440">Υπενθύμιση: Οι καλύτερες λειτουργίες ασφαλείας της Google στην τσέπη σας</translation>
<translation id="2488701737291439763">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το João Browser στις Ρυθμίσεις συστήματος.</translation>
<translation id="3588112919289558122">Η Βελτιωμένη προστασία απενεργοποιεί τη βελτιστοποίηση JavaScript για ιστοτόπους που δεν αναγνωρίζει το Chromium</translation>
<translation id="3597003331831379823">Απέτυχε η εκτέλεση της ρύθμισης με αναβαθμισμένα προνόμια. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">Σύνδεση στο João Browser</translation>
<translation id="5985252758124395804">Τα δεδομένα περιήγησης αυτού του ατόμου θα διαγραφούν από αυτήν τη συσκευή. Για να επαναφέρετε τα δεδομένα, συνδεθείτε στο João Browser ως <ph name="USER_EMAIL" />.</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{Υπάρχει νέα διαθέσιμη ενημέρωση για το João Browser και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση.}=1{Υπάρχει νέα διαθέσιμη ενημέρωση για το João Browser και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Υπάρχει νέα διαθέσιμη ενημέρωση για το João Browser και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="3667616615096815454">Δεν είναι δυνατή η εγκατάσταση, ο διακομιστής δεν γνωρίζει την εφαρμογή.</translation>
<translation id="3675854891107786059">Χρησιμοποιήστε τη <ph name="BEGIN_LINK" />δική σας φράση πρόσβασης<ph name="END_LINK" /> για την κρυπτογράφηση όλων των δεδομένων Chromium στον Λογαριασμό σας Google. Οι τρόποι και οι διευθύνσεις πληρωμής από το Google Pay δεν θα κρυπτογραφούνται. Το ιστορικό περιήγησης από το Chromium δεν θα συγχρονίζεται.</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{Ο διαχειριστής σας ζητά να επανεκκινήσετε το João Browser, προκειμένου να εφαρμοστεί αυτή η ενημέρωση.}=1{Ο διαχειριστής σας ζητά να επανεκκινήσετε το João Browser, προκειμένου να εφαρμοστεί αυτή η ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Ο διαχειριστής σας ζητά να επανεκκινήσετε το João Browser, προκειμένου να εφαρμοστεί αυτή η ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="4134769722455445399">Άνοιγμα συνδέσμου σε νέα καρτέ&amp;λα João Browser</translation>
<translation id="3728124580182886854">Σύνδεση του Chromium και άλλων υπηρεσιών Google για εξατομίκευση και για άλλους σκοπούς</translation>
<translation id="3729187154190517324">Εμβαθύνετε την αναζήτησή σας, προσθέτοντας πολλές καρτέλες, αρχεία και εργαλεία, χρησιμοποιώντας το κουμπί "Προσθήκη καρτέλας και άλλων".</translation>
<translation id="655691042235349825">Διαχείριση προφίλ João Browser</translation>
<translation id="8494798931804571569">Μάθετε γιατί το João Browser αποκλείει ορισμένες λήψεις</translation>
<translation id="379589255253486813">Το Chromium θα σας ενημερώσει σε περίπτωση που χρειαστεί να ελέγξετε κάτι</translation>
<translation id="3802055581630249637">Το Chromium προφορτώνει σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνονται πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="3810973564298564668">Διαχείριση</translation>
<translation id="6945066279282141856">Για να χρησιμοποιήσετε τους αποθηκευμένους κωδικούς πρόσβασης, ακολουθήστε τον σύνδεσμο του κωδικού QR, κατεβάστε το João Browser για iOS και συνδεθείτε στον Λογαριασμό σας Google</translation>
<translation id="3846683726093018685">**Δημιουργήστε μια σύνοψη:** Σε μία πρόταση με λιγότερες από 30 λέξεις, περιγράψτε το κύριο θέμα και τον σκοπό του περιεχομένου στο στιγμιότυπο οθόνης.

          **Προτείνετε ερωτήσεις:** Δημιουργήστε μια λίστα με κουκκίδες με 3-5 ερωτήσεις που θα μπορούσε να κάνει ένας χρήστης για να κατανοήσει καλύτερα το στιγμιότυπο οθόνης. Αυτές οι ερωτήσεις πρέπει να περιλαμβάνουν τουλάχιστον μία η οποία θα αφορά συγκεκριμένα ένα οπτικό αντικείμενο, τον σχεδιασμό ή την τοποθέτησή του.</translation>
<translation id="4996569675441627032"><ph name="PAGE_TITLE" /> - João Browser</translation>
<translation id="6008740052107737825">Το João Browser χρειάζεται άδεια τοπικού δικτύου για αυτόν τον ιστότοπο</translation>
<translation id="3885770153807205175">Εργαλείο επιλογής γλώσσας</translation>
<translation id="2390004682597453662">Προσαρμογή και έλεγχος του João Browser. Θα πρέπει να ελέγξετε μια ειδοποίηση, κάντε κλικ για λεπτομέρειες.</translation>
<translation id="8262407643678629134">Κάντε κλικ στο όνομά σας, για να ανοίξετε το João Browser και να ξεκινήσετε την περιήγηση.</translation>
<translation id="3892148308691398805">Αντιγραφή κειμένου</translation>
<translation id="2168201717554927204">Ο χρήστης <ph name="EXISTING_USER" /> είναι συνδεδεμένος ήδη με αυτό το προφίλ João Browser. Για να διατηρήσει ξεχωριστά την περιήγησή σας, το João Browser μπορεί να δημιουργήσει το προφίλ σας για εσάς.</translation>
<translation id="1046732460303790107">Αυτή η επέκταση παραβαίνει την πολιτική του Chrome Web Store και μπορεί να μην είναι ασφαλής. Καταργήστε την από το João Browser, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="3941890832296813527">Σφάλμα εγκατάστασης: Το όνομα αρχείου του προγράμματος εγκατάστασης δεν είναι έγκυρο ή δεν υποστηρίζεται.</translation>
<translation id="3879366121647289622">Το João Browser προσπαθεί να αντιγράψει κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="7332365758981378072">Οι κωδικοί πρόσβασης, οι τρόποι πληρωμής και οι διευθύνσεις που αποθηκεύσατε στον Λογαριασμό σας Google θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο João Browser, συνδεθείτε ξανά.</translation>
<translation id="395904275706073188">Δεν είναι δυνατή η ανάγνωση προστατευμένων σελίδων. Δοκιμάστε διαφορετική σελίδα.</translation>
<translation id="3962647064319009959">Μάθετε πώς σας προστατεύει το Chromium</translation>
<translation id="3967822245660637423">Ολοκλήρωση λήψης</translation>
<translation id="3971865010372729242">Όταν πληκτρολογείτε στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το Chromium στέλνει αυτό που πληκτρολογείτε στα εργαλεία αναζήτησης, AI και agent του οργανισμού σας για να λάβει προτάσεις.</translation>
<translation id="3975724895399328945">Σχετικά με το &amp;Google Chrome for Testing</translation>
<translation id="3997429360543082038">Σχετικά με το Chromium OS</translation>
<translation id="4010059961270896984">Όταν επισκέπτεστε έναν ιστότοπο, το Chromium στέλνει ένα παραμορφωμένο τμήμα του URL στην <ph name="BEGIN_LINK" />Ασφαλή περιήγηση Google<ph name="END_LINK" /> μέσω ενός διακομιστή απορρήτου που αποκρύπτει τη διεύθυνση IP σας. Εάν ένας ιστότοπος κάνει κάτι ύποπτο, αποστέλλονται επίσης πλήρη URL και τμήματα περιεχομένου της σελίδας.</translation>
<translation id="4016217212818346953">Μείνετε ασφαλείς με τη Διαχείριση κωδικών πρόσβασης</translation>
<translation id="4019629340646866719">Το Chromium OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS" />λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS" />, όπως είναι το <ph name="BEGIN_LINK_LINUX_OSS" />περιβάλλον ανάπτυξης Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">Μετάφραση οθόνης</translation>
<translation id="4023601594785368013">Αρχική γλώσσα: <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">Ανοίξτε συνδέσμους στο João Browser από οποιαδήποτε εφαρμογή. Επιπλέον, για εύκολη πρόσβαση, καρφιτσώνεται στη γραμμή εργαλείων.</translation>
<translation id="4036079820698952681">Συμβάλετε στη βελτίωση του Chromium, αναφέροντας τις <ph name="BEGIN_LINK" />τρέχουσες ρυθμίσεις<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Στην πιο πρόσφατη έκδοση διατίθενται σημαντικές βελτιώσεις ασφάλειας και νέες λειτουργίες.</translation>
<translation id="4055805654398742145">Δ&amp;ιαχειριστής κωδικών πρόσβασης</translation>
<translation id="615818333141511791">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το João Browser όταν δεν χρησιμοποιείται για 1 λεπτό. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}other{Ο οργανισμός σας κλείνει αυτόματα το João Browser όταν δεν χρησιμοποιείται για # λεπτά. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}}</translation>
<translation id="4118474109249235144">Ανώνυμη περιήγηση του Chromium</translation>
<translation id="4122186850977583290">Μετάβαση στη σελίδα Σχετικά με το Chromium</translation>
<translation id="9207280419664362385">Προσαρμόστε το Chrome για να δώσετε μια νέα εμφάνιση στο πρόγραμμα περιήγησης</translation>
<translation id="3719803995198923598">Π&amp;ροσαρμογή του João Browser</translation>
<translation id="4148957013307229264">Γίνεται εγκατάσταση...</translation>
<translation id="2954462321765112214"><ph name="PAGE_TITLE" /> - Σύνδεση δικτύου - João Browser</translation>
<translation id="7812363663832111420">Ανακαλύψτε καταπληκτικές εφαρμογές, παιχνίδια, επεκτάσεις και θέματα για το João Browser.</translation>
<translation id="69200600645763018">Για να λάβετε αυτή την επέκταση και άλλα στοιχεία σε όλους τους υπολογιστές σας, συνδεθείτε στο João Browser</translation>
<translation id="7505863944027312744">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, επίλεξε το προφίλ João Browser στο οποίο έχεις ήδη συνδεθεί ως <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Ακύρωση…</translation>
<translation id="4224210481850767180">Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="8090594705972340646">Να συνδεθούν τα δεδομένα σας στο João Browser με αυτόν το λογαριασμό;</translation>
<translation id="4251772536351901305">Σας προειδοποιεί για επικίνδυνους ιστοτόπους, ακόμα και για όσους δεν γνώριζε η Google στο παρελθόν, αναλύοντας περισσότερα δεδομένα από ιστοτόπους σε σχέση με την βασική προστασία. Μπορείτε να επιλέξετε να παραβλέψετε τις ειδοποιήσεις του Chromium.</translation>
<translation id="5696119579094527589">Αποσύνδεση από το João Browser</translation>
<translation id="4271805377592243930">Λήψη βοήθειας σχετικά με το Chromium</translation>
<translation id="4281844954008187215">Όροι παροχής υπηρεσιών</translation>
<translation id="1245307320228150348">Η εγκατάσταση απέτυχε λόγω απροσδιόριστου σφάλματος. Εάν το João Browser εκτελείται αυτήν τη στιγμή, κλείστε το και δοκιμάστε ξανά.</translation>
<translation id="7405356088321579627">Εξαγωγή κωδικών πρόσβασης από το João Browser</translation>
<translation id="4304713468139749426">Διαχείριση κωδικών πρόσβασης</translation>
<translation id="4334241893986177674">Αναζήτηση αυτού του στιγμιότυπου οθόνης</translation>
<translation id="5785541112027363087">Αναζητήστε και κάντε ερωτήσεις από οπουδήποτε, ακόμα και αν το João Browser είναι ελαχιστοποιημένο</translation>
<translation id="212570256141568951">Άνοιγμα του João Browser κατά την εκκίνηση των Windows</translation>
<translation id="4400772909124543403">Δεν υπάρχει διαθέσιμη ενημέρωση</translation>
<translation id="7463042547966071103">Να γίνει έξοδος από το João Browser ούτως ή άλλως;</translation>
<translation id="4413205837991854510">Να εμφανίζεται πάντα η συντόμευση Αναζήτησης με εικόνες</translation>
<translation id="4736206301215400753">Να επιτρέπεται στο João Browser να εκτελείται στο παρασκήνιο</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{Το João Browser προτείνει να την καταργήσετε. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK" />}other{Το João Browser προτείνει να την καταργήσετε. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK" />}}</translation>
<translation id="5305058100936019600">Προσαρμογή και έλεγχος του João Browser</translation>
<translation id="4427306783828095590">Η βελτιωμένη προστασία κάνει περισσότερα για τον αποκλεισμό ηλεκτρονικού ψαρέματος (phishing) και κακόβουλων προγραμμάτων</translation>
<translation id="4434353761996769206">Σφάλμα προγράμματος εγκατάστασης: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3461955321878243607">Ο οργανισμός <ph name="MANAGER" /> διαχειρίζεται το João Browser</translation>
<translation id="3379477508903866078">Προσθήκη προφίλ João Browser</translation>
<translation id="4447409407328223819">Σχετικά με το Chrome for Testing</translation>
<translation id="4074057296993529937">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα João Browser στον Λογαριασμό σας Google, εισαγάγετε τη φράση πρόσβασης</translation>
<translation id="4493028449971051158">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως διαχειριστής.</translation>
<translation id="4501471624619070934">Η εγκατάσταση απέτυχε επειδή η πρόσβαση είναι περιορισμένη σε αυτήν τη χώρα.</translation>
<translation id="8624811527667906941">Αυτή η επέκταση δεν έχει δημοσιεύσει πρακτικές απορρήτου, όπως τον τρόπο συλλογής και χρήσης δεδομένων. Το João Browser προτείνει να την καταργήσετε.</translation>
<translation id="5571435860030744559">Καλωσορίσατε στο João Browser. Ένα νέο παράθυρο προγράμματος περιήγησης έχει ανοίξει.</translation>
<translation id="8132016625974854930">Το João Browser χρειάζεται άδεια για να χαρτογραφήσει τον περιβάλλοντα χώρο και να παρακολουθεί τα χέρια σας</translation>
<translation id="6599071882590417739">Έχετε συνδεθεί ήδη ως <ph name="USER_EMAIL_ADDRESS" /> σε άλλο προφίλ João Browser</translation>
<translation id="4548534452171747496">Το Chromium προφορτώνει τις σελίδες, κάτι το οποίο επιταχύνει την περιήγηση και την αναζήτηση. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις σελίδες προφόρτωσης<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Βελτιώστε την ασφάλεια στο διαδίκτυο για όλους, αναφέροντας ιστοτόπους που πιστεύετε ότι είναι επιβλαβείς.</translation>
<translation id="202208802191333704">Το João Browser απέκλεισε αυτή τη λήψη, επειδή απενεργοποιήσατε την Ασφαλή περιήγηση και δεν είναι δυνατή η επαλήθευση του αρχείου</translation>
<translation id="3128308674776200516">Δοκιμάστε το Google Lens με το João Browser στο τηλέφωνό σας</translation>
<translation id="4594305310729380060">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="7653380076752216509">Εφαρμογές João Browser</translation>
<translation id="4598116752460667024">Αναζητήστε οποιαδήποτε διεργασία από τη λίστα.</translation>
<translation id="4613863813562375431">Έκδοση Chromium OS</translation>
<translation id="4621240073146040695">Η ενημέρωση σχεδόν ολοκληρώθηκε! Εκτελέστε ξανά το Chromium για να ολοκληρωθεί η ενημέρωση.</translation>
<translation id="1497446027991908251">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του João Browser, αλλά καθιστά το João Browser ελαφρώς λιγότερο ανθεκτικό σε επιθέσεις</translation>
<translation id="7523749920868634278">Προειδοποίηση: Το João Browser δεν μπορεί να αποτρέψει την καταγραφή του ιστορικού περιήγησης από τις επεκτάσεις. Για να απενεργοποιήσετε αυτή την επέκταση σε κατάσταση ανώνυμης περιήγησης, καταργήστε αυτή την επιλογή.</translation>
<translation id="4673151026126227699">Εάν κοινοποιείτε επίσης αναφορές χρήσης του Chromium, αυτές περιλαμβάνουν τα URL που επισκέπτεστε.</translation>
<translation id="4673710618874938871">Συνδεθήκατε ως <ph name="USER_NAME" />: με συνδρομή. Άνοιγμα του μενού λογαριασμού</translation>
<translation id="6608258642372806522">Το προφίλ φαίνεται ότι χρησιμοποιείται από άλλη διεργασία του João Browser (<ph name="PROCESS_ID" />) σε άλλο υπολογιστή (<ph name="HOST_NAME" />). Το João Browser έχει κλειδώσει το προφίλ, για να μην καταστραφεί. Αν είστε σίγουροι ότι το προφίλ δεν χρησιμοποιείται από κάποια άλλη διεργασία, μπορείτε να το ξεκλειδώσετε και να επανεκκινήσετε το João Browser.</translation>
<translation id="4680828127924988555">Ακύρωση εγκατάστασης</translation>
<translation id="3912572071294857936">Ορισμένα δεδομένα του João Browser δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="1077152188344040592">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας Google στο João Browser. Η συντόμευση <ph name="SHORTCUT" /> μπορεί να αλλάξει τις ρυθμίσεις των υπηρεσιών Google.</translation>
<translation id="5729536702149847030">Κάποιο άτομο συνδέθηκε προηγουμένως στο João Browser σε αυτόν τον υπολογιστή ως <ph name="ACCOUNT_EMAIL_LAST" />. Δημιουργήστε έναν νέο χρήστη του João Browser, για να διατηρείτε τις πληροφορίες σας ξεχωριστά.</translation>
<translation id="4724676981607797757">Η εγκατάσταση απέτυχε λόγω σφάλματος μη υποστηριζόμενου πρωτοκόλλου.</translation>
<translation id="6273241729694500032">Να τερματιστεί η λειτουργία του João Browser ούτως ή άλλως;</translation>
<translation id="3239680024825449390">Μόλις εφαρμόστηκε μια ειδική ενημέρωση ασφαλείας για το João Browser. Επανεκκινήστε τώρα και θα γίνει επαναφορά των καρτελών σας.</translation>
<translation id="4771701986670315895">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Chromium κατάργησε τις άδειες <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> και <ph name="COUNT" /> ακόμη.</translation>
<translation id="1908292729364083164">Εάν το Gemini στο João Browser είναι ανοικτό, το πλαϊνό πλαίσιο παραμένει ανοικτό κατά τη δημιουργία νέων καρτελών</translation>
<translation id="479167709087336770">Αυτό χρησιμοποιεί τον ίδιο ορθογραφικό έλεγχο που χρησιμοποιείται στην Αναζήτηση Google. Το κείμενο που πληκτρολογείτε στο πρόγραμμα περιήγησης αποστέλλεται στην Google. Μπορείτε ανά πάσα στιγμή να αλλάξετε αυτήν τη συμπεριφορά στις ρυθμίσεις.</translation>
<translation id="189382710647501724">Χρήση του João Browser χωρίς λογαριασμό</translation>
<translation id="4456919965836032212">Εισερχόμενος κανόνας για το João Browser για να επιτρέπεται η κυκλοφορία του mDNS.</translation>
<translation id="3486986778673504636">Επανεκκίνηση για ενημέρωση του &amp;João Browser</translation>
<translation id="4918086044614829423">Αποδοχή</translation>
<translation id="4918844574251943176">Η εικόνα αντιγράφηκε</translation>
<translation id="1571932028747131277">Το João Browser εκτελείται στο παρασκήνιο.</translation>
<translation id="7612124006067933008">Κάντε κλικ για να κλείσετε το παράθυρο διαλόγου σύνδεσης του João Browser</translation>
<translation id="2598788273876744576">Με τα προφίλ του João Browser μπορείτε να διαχωρίσετε όλη τη δραστηριότητα και το περιεχόμενό σας στο João Browser. Δημιουργήστε προφίλ για φίλους και μέλη της οικογένειας ή διαχωρίστε την εργασία και τη διασκέδαση.</translation>
<translation id="2115498792600385171">Οι επισκέπτες μπορούν να χρησιμοποιούν το João Browser χωρίς να αφήνουν κανένα ίχνος.</translation>
<translation id="6870732303439257966">Ο λογαριασμός σας στο João Browser</translation>
<translation id="4366792189726044065">Προσθήκη του εαυτού σας στο João Browser</translation>
<translation id="504699503110800016">Ανοίξτε το μενού υπερχείλισης</translation>
<translation id="4340125167559705618">Αποκτήστε πρόσβαση σε όλες τις αγαπημένες λειτουργίες της Google με το João Browser στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="4916697359431064123">Το João Browser χρειάζεται άδεια για να παρακολουθεί τα χέρια σας</translation>
<translation id="5141988424377517949">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Chromium κατάργησε τις άδειες <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> και <ph name="PERMISSION_3" />.</translation>
<translation id="5174969993834422967">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ στο εικονίδιο ειδοποίησης στη δεξιά γωνία της γραμμής τοποθεσίας.</translation>
<translation id="5174983315706567306">Δεν υπάρχει αρκετός χώρος δίσκου.</translation>
<translation id="961070648267203077">Ο λογαριασμός João Browser απαιτεί εκ νέου έλεγχο ταυτότητας</translation>
<translation id="69363826605946518">Συνεχίστε ακριβώς από εκεί που είχατε σταματήσει με το João Browser σε iOS.</translation>
<translation id="471694954923709047">Αποσύνδεση από το João Browser</translation>
<translation id="5234764350956374838">Παράβλεψη</translation>
<translation id="5782956358171235578">Άνοιγμα συνδέσμου σε παράθυρο για ανών&amp;υμη περιήγηση João Browser</translation>
<translation id="903712329052383264">Αποκτήστε την εφαρμογή João Browser για να αποθηκεύετε κωδικούς πρόσβασης εν κινήσει</translation>
<translation id="5277894862589591112">Για να εφαρμόσετε τις αλλαγές σας, επανεκκινήστε το Chromium</translation>
<translation id="5286907366254680517">Εντοπίστηκε</translation>
<translation id="5593827909938092728">Λήψη της εφαρμογής João Browser</translation>
<translation id="5294316920224716406">Κατά την περιήγηση σε Κατάσταση ανώνυμης περιήγησης, το Chromium θα σας ειδοποιεί πριν από τη φόρτωση ενός ιστοτόπου με μη ασφαλή σύνδεση</translation>
<translation id="6915803918427878418">Αναζήτηση με το João Browser</translation>
<translation id="1066981078513393795">Εσωτερική υπηρεσία João Browser Updater</translation>
<translation id="5324450571874973775">Χρησιμοποιήστε τις μαζί με άλλες λειτουργίες του Gemini στο Chromium</translation>
<translation id="5346389065299425353">Εμβαθύνετε την αναζήτησή σας, προσθέτοντας πολλές καρτέλες, αρχεία και εργαλεία</translation>
<translation id="1884203704972162365">Δείτε μια γρήγορη επισκόπηση αυτού του εγγράφου και κάντε ερωτήσεις με το Gemini στο João Browser</translation>
<translation id="5352264705793813212">Το Chromium εντόπισε ορισμένες προτάσεις ασφάλειας για να ελέγξετε</translation>
<translation id="4819697639570429319">Άλλα προφίλ João Browser</translation>
<translation id="7878591304929138776">Δεν ήταν δυνατή η αποθήκευση δεδομένων João Browser στον Λογαριασμό σας Google από το ChromiumOS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα</translation>
<translation id="5249614051186670898">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο João Browser. Τα δεδομένα σας στο João Browser, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME" />. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών Google, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Επιπλέον κωδικός: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Για εξατομίκευση, συμπεριλάβετε το Chromium στη Δραστηριότητα ιστού και εφαρμογών</translation>
<translation id="108952623091824942">Μάθετε γιατί το João Browser αποκλείει ορισμένα αρχεία</translation>
<translation id="5386450000063123300">Ενημέρωση του Chromium (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Να επιτρέπεται η σύνδεση στο Chromium</translation>
<translation id="1265086181910844216">Κατάργηση από το João Browser</translation>
<translation id="1500700851187484222">Μειώνει την απόδοση αλλά καθιστά το João Browser πιο ανθεκτικό σε επιθέσεις</translation>
<translation id="6665657403278704382">Ορισμός του João Browser ως προεπιλεγμένου προγράμματος περιήγησης</translation>
<translation id="3520901681432894293"><ph name="PAGE_TITLE" /> - João Browser Beta</translation>
<translation id="5994273394215159270">{NUM_TABS,plural, =1{Το João Browser συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το João Browser συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="646791423998269453">Το João Browser ενδέχεται να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πλέον σε αυτήν τη διανομή Linux.</translation>
<translation id="7249139852479053716">Το João Browser απέκλεισε αυτή τη λήψη, επειδή το αρχείο μπορεί να βλάψει τους προσωπικούς σας λογαριασμούς και τους λογαριασμούς σας σε κοινωνικά δίκτυα</translation>
<translation id="478612683981218420">Περιμένετε μέχρι να γίνει εγκατάσταση των πιο πρόσφατων ενημερώσεων συστήματος από το João Browser.</translation>
<translation id="3466187211963597724">Το João Browser προσπαθεί να επεξεργαστεί κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="3133978491361824131">Εργαστείτε απρόσκοπτα με τις αγαπημένες σας εφαρμογές, όπως το Google Drive και το YouTube, εν κινήσει με το João Browser.</translation>
<translation id="5524890928877629608">επάνω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT" />%, επάνω <ph name="TOP" />%</translation>
<translation id="5527463683072221100">Άνοιγμα PDF στο Chromium</translation>
<translation id="5536164441519929134">Ερώτηση<ph name="LINE_BREAK" />σχετικά με αυτή την καρτέλα</translation>
<translation id="3902123582863904748">Για λόγους ασφαλείας, το João Browser απενεργοποιεί τη βελτιστοποίηση JavaScript όταν επισκέπτεστε έναν ιστότοπο για πρώτη φορά.

Εάν αυτή η σελίδα δεν λειτουργεί με τον αναμενόμενο τρόπο, δοκιμάστε να επιτρέψετε τη βελτιστοποίηση.</translation>
<translation id="5924481826213021755">Εμφάνιση του Gemini στο João Browser στη γραμμή μενού του Mac και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="4988760628116707723">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο João Browser με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία από <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως απλός χρήστης και όχι ως διαχειριστής.</translation>
<translation id="697769674160644707">Χρήση João Browser από προεπιλογή και καρφίτσωμα</translation>
<translation id="5596627076506792578">Περισσότερες επιλογές</translation>
<translation id="5605834417512968703">Επιλέξτε οτιδήποτε για αναζήτηση με την Αναζήτηση με εικόνες ή πατήστε Escape για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="5618818588972826921">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με την Αναζήτηση με εικόνες ή πατήστε Escape για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="2497422928854452258">{0,plural, =0{Υπάρχει μια διαθέσιμη ενημέρωση του João Browser}=1{Υπάρχει μια διαθέσιμη ενημέρωση του João Browser}other{Υπάρχει μια διαθέσιμη ενημέρωση του João Browser για # ημέρες}}</translation>
<translation id="5643865575100044307">Να διαγράφονται πάντα τα δεδομένα ιστοτόπων από τη συσκευή σας όταν κλείνετε το Chromium</translation>
<translation id="620465883043431255">Επανεκκινήστε το João Browser τώρα</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Να εμφανίζεται το Chromium σε αυτήν τη γλώσσα</translation>
<translation id="569897634095159764">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Ο διακομιστής μεσολάβησης απαιτεί έλεγχο ταυτότητας.</translation>
<translation id="5768371961535086509">Το Chromium αποδεσμεύει μνήμη από τις ανενεργές καρτέλες. Αυτό προσφέρει στις ενεργές καρτέλες και σε άλλες εφαρμογές περισσότερους πόρους υπολογιστή και διατηρεί το Chromium γρήγορο. Οι ανενεργές καρτέλες σας ενεργοποιούνται ξανά αυτόματα, όταν επιστρέψετε σε αυτές. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με την Εξοικονόμηση μνήμης<ph name="END_LINK" /></translation>
<translation id="8866372822266732235">Εάν ξεχάσατε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="SETTINGS_LINK" /> τα δεδομένα του João Browser στον λογαριασμό σας</translation>
<translation id="2106070764285625641">Προσαρμογή και έλεγχος του João Browser. Ορίστε το João Browser ως προεπιλογή.</translation>
<translation id="9077878413488413377">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές, ορίζοντας το João Browser ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="5809516625706423866">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 401 Unauthorized. Ελέγξτε τη διαμόρφωση παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="614221876503883218">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του João Browser, αλλά καθιστά το João Browser ελαφρώς λιγότερο ανθεκτικό στις επιθέσεις. Αυτή η ρύθμιση είναι απενεργοποιημένη.</translation>
<translation id="8788365803279840995">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα João Browser στον Λογαριασμό σας Google, ενημερώστε το João Browser</translation>
<translation id="5824893331272123205">Δεν ήταν δυνατή η φόρτωση αυτού του πλαισίου. Δοκιμάστε ξανά.</translation>
<translation id="5805760187441013922">Καλώς ήρθατε στο João Browser</translation>
<translation id="5867606647614813312">Ενεργοποιεί πρόσθετες λειτουργίες για την παροχή των ισχυρότερων μέτρων προστασίας του Chromium</translation>
<translation id="5871205389137001634">Κάντε κλικ για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="8367098380158627809">Το João Browser εντόπισε κακόβουλο πρόγραμμα σε αυτά τα στοιχεία:</translation>
<translation id="5889361821821684993">Το Chromium ελέγχει τακτικά για να διασφαλίζει ότι το πρόγραμμα περιήγησης που χρησιμοποιείτε έχει τις πιο ασφαλείς ρυθμίσεις. Θα σας ενημερώνουμε, αν χρειάζεται να ελέγξετε κάτι.</translation>
<translation id="5895138241574237353">Επανεκκίνηση</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - Σύνδεση δικτύου</translation>
<translation id="5924017743176219022">Γίνεται σύνδεση στο διαδίκτυο…</translation>
<translation id="7627350220326904504">Ας ετοιμάσουμε το João Browser</translation>
<translation id="5941711191222866238">Ελαχιστοποίηση</translation>
<translation id="8680863040348007215">Για να έχετε πρόσβαση σε αυτόν τον σελιδοδείκτη και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο João Browser</translation>
<translation id="2008232276062354182">Εξατομίκευση του João Browser</translation>
<translation id="5960071705175224773">Οι ρυθμίσεις σας άλλαξαν από μια άγνωστη εφαρμογή</translation>
<translation id="5977420883993828287">Καρφιτσώθηκε! Χρησιμοποιήστε ξανά τις Εργασίες με βάση τα συμφραζόμενα από τη γραμμή εργαλείων</translation>
<translation id="5889362640603897718">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το João Browser όταν δεν χρησιμοποιείται για 1 λεπτό.}other{Ο οργανισμός σας κλείνει αυτόματα το João Browser όταν δεν χρησιμοποιείται για # λεπτά.}}</translation>
<translation id="4971097497342057998">Για να ξεκινήσει ο συγχρονισμός, ενημερώστε το João Browser</translation>
<translation id="5990360079535151574">Από το κουμπί Εργασίες με βάση τα συμφραζόμενα στη γραμμή εργαλείων, μπορείτε να ανοίξετε ξανά τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="6003112304606738118">Λήψη… Απομένουν <ph name="HOURS" /> ώρες</translation>
<translation id="6009821354356307391">Κάντε ένα επιπλέον ερώτημα</translation>
<translation id="6040143037577758943">Κλείσιμο</translation>
<translation id="2100398097168307292">Αξιοποιήστε περισσότερο τις ηλεκτρονικές αγορές όταν χρησιμοποιείτε την εφαρμογή João Browser στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="6058380562449900225">Για την προστασία των δεδομένων σας, επιτρέψτε στο Chromium να καταργεί τις άδειες από τους ιστοτόπους που δεν έχετε επισκεφτεί πρόσφατα. Δεν διακόπτει τις ειδοποιήσεις.</translation>
<translation id="4735359759698689867">&amp;Άνοιγμα στο João Browser</translation>
<translation id="6069027071882229820">Αντιγραφή ως εικόνα</translation>
<translation id="2274675514456642321">Η επέκταση <ph name="EXTENSION_NAME" /> έχει προστεθεί στο João Browser</translation>
<translation id="147381942282490529">Προσαρμόστε και ελέγξτε το João Browser. Υπάρχει διαθέσιμη ενημέρωση.</translation>
<translation id="8775234022739879423">Ενεργή • Το João Browser δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="6634821567165410381">Ο λογαριασμός σας στο João Browser</translation>
<translation id="4398707227122702993">Να επιτρέπεται στην επέκταση να εμφανίζει αιτήματα πρόσβασης στη γραμμή εργαλείων του João Browser</translation>
<translation id="5370941509199989624">Το αρχείο <ph name="FILE_NAME" /> είναι επικίνδυνο, επομένως έχει αποκλειστεί από το João Browser.</translation>
<translation id="5119118887583954582">Το João Browser θα κλείσει σύντομα και θα διαγράψει τα δεδομένα</translation>
<translation id="576637711620229618">Μπορείτε εδώ να κάνετε εναλλαγή μεταξύ των προφίλ σας João Browser</translation>
<translation id="615103374448673771">Εάν επιτρέπεται η λήψη cookie, το Chromium μπορεί να τα χρησιμοποιεί κατά την προφόρτωση</translation>
<translation id="6165508094623778733">Μάθετε περισσότερα</translation>
<translation id="3738215896821824918">Διαγράψετε τα δεδομένα του João Browser στον λογαριασμό σας</translation>
<translation id="2145111683361496197">Αυτό το αρχείο ενδέχεται να είναι επικίνδυνο<ph name="LINE_BREAK" />Το João Browser μπορεί να ελέγξει αυτή τη λήψη για εσάς εάν καταχωρίσετε τον κωδικό πρόσβασης. Οι πληροφορίες σχετικά με το αρχείο αποστέλλονται στην Ασφαλή περιήγηση Google, αλλά το περιεχόμενο και ο κωδικός πρόσβασης του αρχείου παραμένουν στη συσκευή σας.</translation>
<translation id="6182736845697986886">Η εγκατάσταση απέτυχε λόγω εσωτερικού σφάλματος στον διακομιστή ενημέρωσης.</translation>
<translation id="6050294746023477088">Βεβαιωθείτε ότι έχετε συνδεθεί στο João Browser στη συσκευή σας <ph name="TARGET_DEVICE_NAME" /> και έπειτα δοκιμάστε ξανά την αποστολή.</translation>
<translation id="3395167674702947885">Αυτός ο υπολογιστής διαθέτει ήδη μια πιο πρόσφατη έκδοση του João Browser. Αν το λογισμικό δεν λειτουργεί, απεγκαταστήστε το João Browser και κατεβάστε το ξανά.</translation>
<translation id="4384214545531685923">{0,plural, =0{Η επανεκκίνηση του João Browser θα γίνει τώρα}=1{Η επανεκκίνηση του João Browser θα γίνει σε 1 δευτερόλεπτο}other{Η επανεκκίνηση του João Browser θα γίνει σε # δευτερόλεπτα}}</translation>
<translation id="5880255774989397049">Το João Browser χρειάζεται άδεια πρόσβασης στον αποθηκευτικό χώρο για τη λήψη αρχείων.</translation>
<translation id="6245734527075554892">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο Chromium</translation>
<translation id="1959823478027154444">Ορισμός João Browser ως προεπιλεγμένο πρόγραμμα</translation>
<translation id="6248988683584659830">Αναζήτηση ρυθμίσεων</translation>
<translation id="9191635841540101343">Αποκτήστε τις καλύτερες λειτουργίες ασφάλειας της Google εν κινήσει, με την εφαρμογή João Browser στο τηλέφωνό σας</translation>
<translation id="538350741885862188">Θέλετε να αποσυνδεθείτε από το João Browser;</translation>
<translation id="161121067714522736">Αυτές οι καρτέλες χρησιμοποιούν επιπλέον πόρους. Για να βελτιώσετε την απόδοσή σας, επιτρέψτε στο João Browser να τις απενεργοποιήσει.</translation>
<translation id="2095090272560293574">Προσαρμόστε το προφίλ σας João Browser</translation>
<translation id="6290827346642914212">Ονομάστε το προφίλ σας στο Chromium</translation>
<translation id="6472525517562723285">Μια επέκταση θέλει να συνδεθείτε στο João Browser</translation>
<translation id="2069878195899746465">Το αρχείο <ph name="FILE_NAME" /> μπορεί να είναι επικίνδυνο, επομένως έχει αποκλειστεί από το João Browser.</translation>
<translation id="1283909912629029170">Το João Browser χρησιμοποιεί την κάμερά σας.</translation>
<translation id="323902744000752306">Μια άλλη λειτουργία στο João Browser βρίσκεται σε εξέλιξη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="1292164882596462877">Τώρα μπορείτε να χρησιμοποιείτε πιο εύκολα το João Browser με το Λογαριασμό σας Google και σε κοινόχρηστους υπολογιστές.</translation>
<translation id="6411450594978516531">Αποκτήστε εύκολη πρόσβαση στις λειτουργίες που γνωρίζετε, αγαπάτε και εμπιστεύεστε, ορίζοντας το João Browser ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="3344301749774719950">Συντόμευση João Browser</translation>
<translation id="8395825163097750991">Το João Browser απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του αρχείου και ενδέχεται να είναι επικίνδυνο</translation>
<translation id="7683737657427846440">Είστε βέβαιοι ότι θέλετε να απεγκαταστήσετε του João Browser;</translation>
<translation id="6375219077595103062">Προσθήκη συντόμευσης στον Διαχειριστή κωδικών πρόσβασης</translation>
<translation id="6388799252195623474">βοήθησέ με με αυτή την εργασία</translation>
<translation id="6966523531135953867">Για να συνεχίσετε, συνδεθείτε στο João Browser ως <ph name="EMAIL" />. Αυτή η ενέργεια διασφαλίζει ότι ακολουθείτε τις πολιτικές του οργανισμού σας.</translation>
<translation id="5146608242127807773">Λογότυπο João Browser μέσα σε οθόνη υπολογιστή.</translation>
<translation id="6361476216650509195">Το João Browser είναι ένα πρόγραμμα περιήγησης ιστού που εκτελεί εφαρμογές και ιστοσελίδες με απίστευτη ταχύτητα. Είναι γρήγορο, σταθερό και εύχρηστο. Περιηγηθείτε στον ιστό με μεγαλύτερη ασφάλεια με την ενσωματωμένη προστασία από κακόβουλα προγράμματα και ηλεκτρονικό "ψάρεμα" (phishing).</translation>
<translation id="7864687914956920860">Για να βεβαιωθείτε ότι θα μπορείτε να χρησιμοποιείτε και να αποθηκεύετε πάντα δεδομένα João Browser στον Λογαριασμό σας Google, επαληθεύστε την ταυτότητά σας</translation>
<translation id="1160920197193662978">Το João Browser εκτελείται πιο γρήγορα και οι λειτουργίες που χρησιμοποιούν JavaScript θα πρέπει να λειτουργούν με τον αναμενόμενο τρόπο</translation>
<translation id="6436260184216827876">Η Αναζήτηση με εικόνες δεν είναι διαθέσιμη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="6442900851116057561">Επανεκκίνηση Chromium OS</translation>
<translation id="6443470774889161065">Το Chromium προφορτώνει ακόμα περισσότερες σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνουν πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="3730564967922511625">Κατεβάστε το João Browser στο τηλέφωνό σας για παρακολούθηση τιμών και λήψη ειδοποιήσεων σε περίπτωση πτώσης τιμής σε οποιονδήποτε ιστότοπο</translation>
<translation id="3753019081686930624">Ανενεργή • Το João Browser δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="5444641426058108434">Καλώς ήρθατε στα προφίλ του João Browser</translation>
<translation id="5103470775766355478">Την επόμενη φορά που θα ανοίξετε το João Browser στη συσκευή <ph name="DEVICE_TYPE" />, θα δείτε μια προτροπή για χρήση των ομάδων καρτελών.</translation>
<translation id="9087231386723579740">Κατάργηση λογαριασμού από το João Browser</translation>
<translation id="4984395209542302039">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του João Browser.</translation>
<translation id="648319183876919572">Η Βελτιωμένη Ασφαλής περιήγηση κάνει περισσότερα για την προστασία σας από επικίνδυνους ιστοτόπους και λήψεις</translation>
<translation id="1524792685704191751">Απεγκατάσταση João Browser</translation>
<translation id="6637504267182028286">Οι συντομεύσεις ανοίγουν στο João Browser</translation>
<translation id="1478247638436966279">Ο οργανισμός σας κλείνει το João Browser όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION" />. Τα δεδομένα περιήγησης διαγράφηκαν. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="1311233187253046133">Κάθε προφίλ διατηρεί τις δικές του πληροφορίες στο João Browser, όπως σελιδοδείκτες, ιστορικό, κωδικούς πρόσβασης και άλλα.</translation>
<translation id="6556755379298048869">Κάντε αναζήτηση με συντόμευση πληκτρολογίου.</translation>
<translation id="6563921047760808519">Μάθετε περισσότερα σχετικά με το <ph name="BEGIN_LINK" />πώς το Chromium διατηρεί ιδιωτικά τα δεδομένα σας<ph name="END_LINK" /></translation>
<translation id="1643078533228697915">Οι αλλαγές σε αυτή τη ρύθμιση θα εφαρμοστούν μετά από την επανεκκίνηση του João Browser.</translation>
<translation id="1918630514771863338">Διαχειριστείτε τις επεκτάσεις σας, κάνοντας κλικ στην επιλογή Επεκτάσεις στο κύριο μενού του João Browser.</translation>
<translation id="4229328298978407243">Μπορείτε να κάνετε εναλλαγή για να δείτε τους κωδικούς πρόσβασης από ένα άλλο προφίλ João Browser</translation>
<translation id="7717252965531997879">Χρησιμοποιήστε την εφαρμογή João Browser για να έχετε μαζί σας τα καλύτερα εργαλεία AI</translation>
<translation id="6570579332384693436">Για τη διόρθωση ορθογραφικών λαθών, το Chromium στέλνει το κείμενο που πληκτρολογείτε σε πεδία κειμένου στο Google</translation>
<translation id="5374627817618267090">Μετάβαση στις ρυθμίσεις ειδοποιήσεων του João Browser</translation>
<translation id="6600016381025017075">Αναζητήστε οτιδήποτε σε αυτή τη σελίδα</translation>
<translation id="264335610358256197">Οι αλλαγές που πραγματοποιήσατε θα ισχύσουν την επόμενη φορά που θα εκκινήσετε το João Browser.</translation>
<translation id="2657584510687441826">Το João Browser ανοίγει πλέον κατά την εκκίνηση των Windows, ώστε να μπορείτε να ξεκινήσετε άμεσα την περιήγηση. Μπορείτε να απενεργοποιήσετε αυτή τη λειτουργία στις ρυθμίσεις.</translation>
<translation id="5482413402708094860">Συνεχίστε από εκεί που σταματήσατε: Το João Browser έκανε επαναφορά των καρτελών σας από την τελευταία περίοδο λειτουργίας. Μπορείτε να απενεργοποιήσετε αυτή τη ρύθμιση στην ενότητα</translation>
<translation id="5022765692226673603">Το João Browser χρειάζεται άδεια κάμερας για να δημιουργήσει έναν τρισδιάστατο χάρτη του περιβάλλοντα χώρου σας.</translation>
<translation id="6669284030132180248">Εάν αποθηκεύσετε τους σελιδοδείκτες σας και στον Λογαριασμό σας Google, μπορείτε να παρακολουθείτε τις τιμές των προϊόντων στο Chromium και να λαμβάνετε ειδοποιήσεις όταν παρατηρείται πτώση τιμών</translation>
<translation id="6676384891291319759">Πρόσβαση στο Διαδίκτυο</translation>
<translation id="668175097507315160">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chromium OS λόγω σφάλματος κατά τη σύνδεση.</translation>
<translation id="3982573751008180181">Κατάργηση των δεδομένων αυτής της εφαρμογής από το João Browser</translation>
<translation id="5613723096388999601">Το João Browser χρειάζεται άδεια μικροφώνου για αυτόν τον ιστότοπο.</translation>
<translation id="6712881677154121168">Σφάλμα λήψης: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="9190188975825967506">Δεν είναι δυνατή η χρήση του προφίλ σας επειδή προέρχεται από νεότερη έκδοση του João Browser.

Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες. Καθορίστε έναν διαφορετικό κατάλογο προφίλ ή χρησιμοποιήστε μια νεότερη έκδοση του João Browser.</translation>
<translation id="6729124504294600478">Για να αξιοποιήσετε την εξατομίκευση και άλλες λειτουργίες, συμπεριλάβετε το Chromium στη Δραστηριότητα ιστού και εφαρμογών και στις συνδεδεμένες υπηρεσίες Google</translation>
<translation id="6957684879859415418">Το João Browser είναι ήδη εγκατεστημένο για όλους τους χρήστες στον υπολογιστή σας.</translation>
<translation id="4411262692912917677">Για να έχετε πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο João Browser. Αυτός ο σελιδοδείκτης θα αποθηκευτεί στον Λογαριασμό σας Google αφού συνδεθείτε.</translation>
<translation id="6064901610880747710">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του João Browser, αλλά καθιστά το João Browser ελαφρώς λιγότερο ανθεκτικό στις επιθέσεις. Αυτή η ρύθμιση είναι ενεργοποιημένη.</translation>
<translation id="4530735110472079436">{count,plural, =1{Ορισμένα δεδομένα του João Browser δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα (1 στοιχείο) θα διαγραφούν.}other{Ορισμένα δεδομένα του João Browser δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα ({count} στοιχεία) θα διαγραφούν.}}</translation>
<translation id="9176853308971176490">Το João Browser συνιστά τη σάρωση αυτού του αρχείου επειδή μπορεί να είναι επικίνδυνο.</translation>
<translation id="6779406956731413166">Το Chromium OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS" />λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6831043979455480757">Μετάφραση</translation>
<translation id="6412488898785231889">Το João Browser σας ενημερώνει σε περίπτωση παραβίασης των κωδικών πρόσβασής σας.</translation>
<translation id="684888714667046800">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Εάν χρησιμοποιείτε τείχος προστασίας, βεβαιωθείτε ότι το <ph name="PRODUCT_EXE_NAME" /> είναι στη λίστα επιτρεπομένων.</translation>
<translation id="6750640664545078431">João Browser - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Πατήστε Tab για συνέχεια</translation>
<translation id="6862030660799253820">Αναζήτηση αυτής της εικόνας με την Αναζήτηση με εικόνες</translation>
<translation id="6869568587896659271">Εύκολη πρόσβαση σε ιστοτόπους κάτω από τη γραμμή διευθύνσεων</translation>
<translation id="4260365383290377081">Το João Browser εντόπισε κακόβουλο πρόγραμμα στην επέκταση <ph name="EXTENSION_NAME" />.</translation>
<translation id="6877155553248388166">κάτω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT" />%, κάτω <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">Αντιγραφή</translation>
<translation id="6898028264630240901">Μπορείτε να καρφιτσώσετε τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="6985817498888719203">Ορίστε το João Browser ως προεπιλεγμένο πρόγραμμα περιήγησης και καρφιτσώστε το στη γραμμή εργαλείων</translation>
<translation id="5277424858974213042">&amp;Διαχείριση προφίλ João Browser</translation>
<translation id="2726137364317931343">Αυτή η ενέργεια:
          <ph name="LINE_BREAKS" />
            • Θα επαναφέρει τη σελίδα εκκίνησης, τη σελίδα Νέα καρτέλα, τη μηχανή αναζήτησης και τις καρφιτσωμένες καρτέλες
            <ph name="LINE_BREAK" />
            • Θα απενεργοποιήσει τις επεκτάσεις
            <ph name="LINE_BREAK" />
            • Θα διαγράψει τα cookie και τα άλλα προσωρινά δεδομένα ιστοτόπων
            <ph name="LINE_BREAK" />
            • Θα επαναφέρει τις συντομεύσεις του João Browser
            <ph name="LINE_BREAKS" />
            Οι σελιδοδείκτες, το ιστορικό και οι αποθηκευμένοι κωδικοί πρόσβασης δεν θα επηρεαστούν.</translation>
<translation id="2901988969322822496">Έχετε συμπληρώσει το όριο των <ph name="BOOKMARK_LIMIT" /> σελιδοδεικτών του João Browser, επομένως ορισμένοι από τους σελιδοδείκτες σας δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google.

Δεν θα είναι δυνατή η αποθήκευση νέων σελιδοδεικτών στον λογαριασμό σας μέχρι να διαγράψετε ορισμένους. Εάν αποσυνδεθείτε τώρα, οι μη αποθηκευμένοι σελιδοδείκτες θα διαγραφούν.</translation>
<translation id="6203410920314218280">Άνοιγμα συνδέσμου σε Παράθυρο ανών&amp;υμης περιήγησης João Browser</translation>
<translation id="6965382102122355670">OK</translation>
<translation id="6985329841647292029">Όροι του Chromium OS</translation>
<translation id="8064285182627814996">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα João Browser στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="7011190694940573312">Η εγκατάσταση απέτυχε επειδή αυτή η έκδοση του λειτουργικού συστήματος δεν υποστηρίζεται.</translation>
<translation id="7024536598735240744">Σφάλμα αποσυσκευασίας: <ph name="UNPACK_ERROR" />.</translation>
<translation id="181803036615530330">Προσαρμόστε το João Browser για εσάς</translation>
<translation id="7047386856539490735">Είναι χρήσιμα αυτά τα αποτελέσματα;</translation>
<translation id="2478245051737698828">Ενημέρωση João Browser</translation>
<translation id="452909342278940733">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το João Browser θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην Google.</translation>
<translation id="8606769615526968368">Αξιοποιήστε τη δύναμη του AI όταν χρησιμοποιείτε την εφαρμογή João Browser στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="2061960765882453684">Έχετε μαζί σας τους κωδικούς πρόσβασης, τις καρτέλες και άλλα στοιχεία εν κινήσει με την εφαρμογή João Browser στο τηλέφωνό σας</translation>
<translation id="7141270731789036260">Προσαρμογή του Chrome for Testing</translation>
<translation id="7147227333672430807">Μπορείτε να χρησιμοποιείτε το Chromium κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές</translation>
<translation id="6949173677980969871">Κατάργηση της επέκτασης <ph name="EXTENSION_NAME" /> από το João Browser</translation>
<translation id="3556355753960287061">Ο οργανισμός σας διαγράφει τα δεδομένα του João Browser όταν δεν χρησιμοποιούνται για <ph name="TIMEOUT_DURATION" />. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="8689006320829658442">Το João Browser χρειάζεται άδεια κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="7501884108538572227">Δεν ήταν δυνατή η εκκίνηση του João Browser. Προσπάθησε ξανά.</translation>
<translation id="5484563502710761706">Ρωτήστε οτιδήποτε, όπου κι αν βρίσκεστε, με το Gemini στο João Browser</translation>
<translation id="3823264355161086552">Διατηρήστε το João Browser στο Dock για γρήγορη πρόσβαση ανά πάσα στιγμή</translation>
<translation id="9153902741226700840">Χρησιμοποιήστε το João Browser κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές</translation>
<translation id="7216228761061470870">Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες σε υπολογιστή, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, αποστέλλονται στον διακομιστή</translation>
<translation id="7950844619283784703">Διαχείριση Εργασιών - João Browser</translation>
<translation id="133513825972536773">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο João Browser με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="4558982617284733740">Ξεκινήστε άμεσα την περιήγηση: Το João Browser μπορεί πλέον να ανοίγει κατά την εκκίνηση των Windows.</translation>
<translation id="7274695763216404502">Καρφιτσώθηκε! Χρησιμοποιήστε ξανά την Αναζήτηση με εικόνες από τη γραμμή εργαλείων</translation>
<translation id="7288567540154601580">Καρτέλες και επεκτάσεις</translation>
<translation id="5494571279964989269">{NUM_EXTENSIONS,plural, =1{Το João Browser προτείνει να την καταργήσετε}other{Το João Browser προτείνει να τις καταργήσετε}}</translation>
<translation id="2269053214123323740">Για κοινή χρήση του ήχου συστήματος, ανοίξτε τις Ρυθμίσεις συστήματος και επιτρέψτε την επιλογή "Μόνο εγγραφή ήχου συστήματος" για το João Browser. Στη συνέχεια, θα πρέπει να επανεκκινήσετε το João Browser.</translation>
<translation id="731795002583552498">Ενημέρωση του Chromium</translation>
<translation id="9065168747010082551">Το αρχείο προτιμήσεών σας είναι κατεστραμμένο ή μη έγκυρο.

Το João Browser δεν μπορεί να ανακτήσει τις ρυθμίσεις σας.</translation>
<translation id="7324051657739063017">Μπορείτε να ανοίξετε ξανά τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="4159250197688136733">Εδώ μπορείτε να βρείτε τις ιστοσελίδες, τους σελιδοδείκτες σας και άλλα δεδομένα του João Browser.</translation>
<translation id="7347827960336370838">Μόνο κάποιος που γνωρίζει τη φράση πρόσβασης μπορεί να διαβάσει τα κρυπτογραφημένα δεδομένα σας. H φράση πρόσβασης δεν αποστέλλεται στην Google, ούτε αποθηκεύεται από αυτήν. Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, θα χρειαστεί να <ph name="BEGIN_LINK" />διαγράψετε τα δεδομένα του Chromium στον λογαριασμό σας<ph name="END_LINK" />.</translation>
<translation id="1062903713270840396">Ο διαχειριστής συστήματος έχει διαμορφώσει το João Browser ώστε να ανοίγει το <ph name="ALTERNATIVE_BROWSER_NAME" /> για την πρόσβαση σε <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">Παρουσιάστηκε κάποιο πρόβλημα</translation>
<translation id="5817362738974335084">Για τη λήψη μελλοντικών ενημερώσεων του João Browser, θα χρειαστείτε macOS 13 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί macOS 12.</translation>
<translation id="7376384068949534168">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Chromium κατάργησε τις άδειες <ph name="PERMISSION_1" /> και <ph name="PERMISSION_2" />.</translation>
<translation id="73786666777299047">Άνοιγμα του Chrome Web Store</translation>
<translation id="5724625487458697703">Εμφάνιση του Gemini στο João Browser στην περιοχή ειδοποιήσεων</translation>
<translation id="7401687852903179959">Αναζήτηση αυτού του βίντεο με την Αναζήτηση με εικόνες</translation>
<translation id="1088684725931971005">Το João Browser είναι πλέον το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="7479848806300971661">Συνεχίστε από το σημείο που σταματήσατε: Το João Browser επαναφέρει τις καρτέλες σας κάθε φορά που κάνετε επανεκκίνηση. Για να απενεργοποιήσετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα</translation>
<translation id="1258077876605261365">Εισαγωγή κωδικών πρόσβασης στο João Browser</translation>
<translation id="5293062713751091377">1. Κάντε κλικ στο κουμπί <ph name="BUTTON_LABEL" /> παρακάτω
2. Κάντε κλικ στο κουμπί <ph name="BUTTON_2" /> στις ρυθμίσεις των Windows
3. Κάντε κλικ στο κουμπί <ph name="BUTTON_3" /> στην ειδοποίηση των Windows για να καρφιτσώσετε το João Browser στη γραμμή εργαλείων για γρήγορη πρόσβαση</translation>
<translation id="1941496545060769345"><ph name="PAGE_TITLE" /> - João Browser Dev</translation>
<translation id="7450541714075000668">Το κείμενο αντιγράφηκε</translation>
<translation id="7458892263350425044">Για χρήση του μικροφώνου, παραχωρήστε πρόσβαση στο Chromium στις <ph name="BEGIN_LINK" />ρυθμίσεις συστήματος<ph name="END_LINK" /></translation>
<translation id="5422859338435319909">Για τη λήψη μελλοντικών ενημερώσεων του João Browser, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 7.</translation>
<translation id="7467949745582939695">Επανεκκίνηση του Chromium;</translation>
<translation id="7707324976708178089">Δεν είναι δυνατή η εγκατάσταση της ίδια έκδοσης του João Browser που εκτελείται αυτήν τη στιγμή. Κλείστε το João Browser και δοκιμάστε ξανά.</translation>
<translation id="7510190804000607802">Υπενθύμιση: Οι καλύτερες λειτουργίες της Google στην τσέπη σας</translation>
<translation id="751935028865900641">Οι ιστότοποι πιθανώς θα λειτουργούν με τον αναμενόμενο τρόπο. Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του Chromium, εκτός από τον Λογαριασμό σας Google εάν είστε συνδεδεμένοι στο Chromium.</translation>
<translation id="5325102834460669866">{0,plural, =1{Η επανεκκίνηση του João Browser θα γίνει σε 1 λεπτό}other{Η επανεκκίνηση του João Browser θα γίνει σε # λεπτά}}</translation>
<translation id="7565444033145385702">Για την προστασία των δεδομένων σας, επιτρέψτε στο Chromium να καταργεί τις άδειες από τους ιστοτόπους που δεν έχετε επισκεφτεί πρόσφατα.</translation>
<translation id="8099958128052689767">Ανοίξτε αυτόματα το João Browser, για να αρχίσετε άμεσα την περιήγηση.</translation>
<translation id="7583399374488819119">Πρόγραμμα εγκατάστασης <ph name="COMPANY_NAME" /></translation>
<translation id="7125257608567714221">Το João Browser χρησιμοποιεί την κάμερα και το μικρόφωνό σας.</translation>
<translation id="227045421902171569">Το João Browser έγινε ακόμα καλύτερο</translation>
<translation id="5356567285381070312">Έχετε πλέον περισσότερες διαθέσιμες λειτουργίες στο João Browser</translation>
<translation id="7624307931717240213">Χρησιμοποιούμε πληροφορίες για τη βελτίωση αυτής της υπηρεσίας. Ανατρέξτε στην Πολιτική απορρήτου και στους Όρους παροχής υπηρεσιών.</translation>
<translation id="7649070708921625228">Βοήθεια</translation>
<translation id="5714374331629713291">Λήψη της εφαρμογής João Browser</translation>
<translation id="7658239707568436148">Ακύρωση</translation>
<translation id="549378870470819535">Το João Browser δεν είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="6574348346278803862">Συγχρονίστε και εξατομικεύστε το João Browser στις συσκευές σας</translation>
<translation id="7699779824407626136">Ενημέρωση Chromium</translation>
<translation id="3304080024230377341">Η εργασία σας προστατεύεται στο João Browser</translation>
<translation id="7716950018788545737">Οι εργασίες τερματίστηκαν.</translation>
<translation id="77283119132245232">Παρέχει υπηρεσίες ανίχνευσης συστήματος για το <ph name="BROWSER_NAME" />. Εάν αυτή η υπηρεσία είναι απενεργοποιημένη, τα ίχνη απόδοσης που δημιουργούνται από το πρόγραμμα περιήγησης δεν θα περιλαμβάνουν συμβάντα σε επίπεδο συστήματος, όπως συμβάντα εναλλαγής περιβάλλοντος και συμβάντα ετοιμότητας νήματος.</translation>
<translation id="7745317241717453663">Με αυτή την ενέργεια θα διαγραφούν τα δεδομένα περιήγησης από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Chromium ως <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Δεν ήταν δυνατή η δημιουργία ενός προσωρινού καταλόγου από το πρόγραμμα εγκατάστασης. Ελέγξτε τον κενό χώρο του δίσκου και το δικαίωμα εγκατάστασης του λογισμικού.</translation>
<translation id="4713120944298974980">Αναζήτηση στο João Browser</translation>
<translation id="5804390944809171853">Επαναφορά της προεπιλογής João Browser</translation>
<translation id="6930487390575519812">Για την προστασία της εργασίας σας στο João Browser, ο οργανισμός σας θα μπορεί να βλέπει ή να διαχειρίζεται ορισμένες πληροφορίες όταν είστε συνδεδεμένοι στο João Browser.</translation>
<translation id="5214761769821670245">Ορίστε το João Browser ως προεπιλογή και καρφιτσώστε το στη γραμμή εργαλείων</translation>
<translation id="1294697217796985566">Κάντε το João Browser πιο γρήγορο</translation>
<translation id="1278345486417353853"><ph name="PAGE_TITLE" /> - João Browser Canary</translation>
<translation id="7803986347287457849">Κάντε πιο δύσκολο για άτομα που έχουν πρόσβαση στη διαδικτυακή κίνησή σας να βλέπουν ποιους ιστοτόπους επισκέπτεστε. Το Chromium χρησιμοποιεί μια ασφαλή σύνδεση για να αναζητήσει τη διεύθυνση IP ενός ιστοτόπου στο DNS (Domain Name System).</translation>
<translation id="7810005234485217901">Μπορείτε να καρφιτσώσετε την Αναζήτηση με εικόνες για εύκολη πρόσβαση</translation>
<translation id="6236248311946713296">Επιλέξτε τι θα κοινοποιείτε στο João Browser</translation>
<translation id="489728561211958943">Υπάρχει ήδη σε αυτήν τη συσκευή ένα προφίλ João Browser με αυτόν τον λογαριασμό</translation>
<translation id="7845233973568007926">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε τον υπολογιστή σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="5294768452950207882">Η μηχανή αναζήτησης άλλαξε από άλλο πρόγραμμα εκτός του João Browser. Για την προστασία σας, το João Browser την επανέφερε στην αρχική προεπιλογή. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3244974069468656925">Προσαρμόστε το João Browser για να του δώσετε μια νέα εμφάνιση</translation>
<translation id="7859018312476869945">Όταν πληκτρολογείτε στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το Chromium στέλνει αυτό που πληκτρολογείτε στην προεπιλεγμένη μηχανή αναζήτησης για να λάβει καλύτερες προτάσεις. Αυτή η επιλογή είναι απενεργοποιημένη στην Ανώνυμη περιήγηση.</translation>
<translation id="6517519572778941051">Δεν ήταν δυνατή η ενημέρωση του João Browser στην τελευταία έκδοση και έτσι δεν θα έχετε πρόσβαση στις νέες λειτουργίες και στις επιδιορθώσεις ασφαλείας.</translation>
<translation id="7872446069773932638">Λήψη… Απομένουν <ph name="SECONDS" /> δευτερόλεπτα.</translation>
<translation id="7873537467422636035">Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="BEGIN_LINK" />διαγράψτε τα δεδομένα του Chromium στον λογαριασμό σας<ph name="END_LINK" /></translation>
<translation id="1722038268139386345">Ανοίξτε γρήγορα το Gemini στο João Browser όποτε το χρειάζεστε</translation>
<translation id="8344320926817290924">Ορισμός του João Browser ως προεπιλογής</translation>
<translation id="7934340546140346950">Το Chromium αναβαθμίζει αυτόματα τις μη ασφαλείς συνδέσεις σε HTTPS, όταν είναι εφικτό</translation>
<translation id="3755057387338907970">Συνδεθήκατε στο João Browser ως <ph name="USER_EMAIL_ADDRESS" />. Χρησιμοποιήστε τον ίδιο λογαριασμό για να συνδεθείτε ξανά.</translation>
<translation id="929903348843569380">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο João Browser με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="7975919845073681630">Αυτή είναι μια δευτερεύουσα εγκατάσταση του Chromium και δεν μπορεί να γίνει το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="8905411496853397218">Οι επεκτάσεις, οι εφαρμογές και τα θέματα από άγνωστες πηγές μπορούν να βλάψουν τη συσκευή σας. Το João Browser συνιστά την εγκατάστασή τους μόνο από το <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />.</translation>
<translation id="6306672714476596428">Αξιοποιήστε τις καλύτερες λειτουργίες της Google με την εφαρμογή João Browser στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="8004582292198964060">Πρόγραμμα περιήγησης</translation>
<translation id="8010081455002666927">Αυτόματος εντοπισμός</translation>
<translation id="2172829664765531568">Όταν το João Browser αποκτήσει πρόσβαση, οι ιστότοποι θα μπορούν να σας ζητήσουν πρόσβαση.</translation>
<translation id="74641100973032765">Καρφιτσώστε το João Browser στη γραμμή εργαλείων για γρήγορη πρόσβαση ανά πάσα στιγμή</translation>
<translation id="80471789339884597">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε όλα τα προγράμματα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="8054112667659782652">Να εμφανίζεται πάντα η συντόμευση Αναζήτησης με εικόνες</translation>
<translation id="8069447462453318634">Επιλέξτε "Καρφίτσωμα στη γραμμή εργαλείων"</translation>
<translation id="5039671129725402518">Απενεργοποίηση του João Browser, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="80790299200510644">Αναζήτηση με εικόνες</translation>
<translation id="8086881907087796310">Η εγκατάσταση απέτυχε επειδή ο υπολογιστής σας δεν πληροί τις ελάχιστες απαιτήσεις εξοπλισμού.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> – Google Chrome for Testing</translation>
<translation id="2430877582155731716">Το João Browser χρειάζεται άδεια τοποθεσίας για αυτόν τον ιστότοπο.</translation>
<translation id="8298045348217323">Την επόμενη φορά που θα ανοίξετε το João Browser στη συσκευή <ph name="DEVICE_TYPE" />, θα δείτε μια προτροπή για ενεργοποίηση των ειδοποιήσεων παρακολούθησης τιμής.</translation>
<translation id="3827347991254458074">Λάβετε ειδοποιήσεις για πτώση τιμής σε προϊόντα που σας ενδιαφέρουν με την εφαρμογή João Browser στο τηλέφωνό σας</translation>
<translation id="8118331347066725040">Αποστολή σχολίων για την αναζήτηση με το Lens</translation>
<translation id="2580039965224265556">Εξατομικεύστε το João Browser</translation>
<translation id="8133124826068723441">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chromium OS, επειδή ο συγχρονισμός δεν είναι διαθέσιμος για τον τομέα σας.</translation>
<translation id="813913629614996137">Εκκίνηση…</translation>
<translation id="7940955011992997426">Ανοίξτε το Gemini στο João Browser με μια συντόμευση πληκτρολογίου.</translation>
<translation id="7560319627203819845">Πρόσθετοι όροι παροχής υπηρεσιών του João Browser</translation>
<translation id="7133741820744999589">Αυτό το αρχείο είναι επικίνδυνο και έχει αποκλειστεί από το João Browser.</translation>
<translation id="8177472873527554730">Δεν είναι δυνατή η εύρεση περιεχομένου στη σελίδα</translation>
<translation id="8200109504272824693">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Chromium στον λογαριασμό σας, <ph name="USER_EMAIL" /></translation>
<translation id="820759916613250543">Αναζήτηση αυτής της εικόνας με την Αναζήτηση με εικόνες</translation>
<translation id="8221491193165283816">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ εδώ.</translation>
<translation id="8223363452568144035">Για χρήση της κάμερας, παραχωρήστε πρόσβαση στο Chromium στις <ph name="BEGIN_LINK" />ρυθμίσεις συστήματος<ph name="END_LINK" /></translation>
<translation id="8132864687089402359">Το João Browser δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το João Browser, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων.</translation>
<translation id="7600652022483599804">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το João Browser θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην Google. Μπορείτε να απενεργοποιήσετε αυτήν τη λειτουργία στις ρυθμίσεις οποιαδήποτε στιγμή.</translation>
<translation id="8703735741562140394">Σύνδεση στο João Browser με νέο προφίλ;</translation>
<translation id="2830039647655087365">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο João Browser με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία από <ph name="DEVICE" />.</translation>
<translation id="1802935470126307750">Εμφάνιση του Gemini στο João Browser στην περιοχή ειδοποιήσεων και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Το Chromium σας προειδοποιεί<ph name="END_LINK" /> σχετικά με μη ασφαλείς ιστοτόπους και λήψεις</translation>
<translation id="8295827201165805317">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Chromium κατάργησε την άδεια <ph name="PERMISSION" />.</translation>
<translation id="481989138594406896">Αγοράστε, μεταφράστε και προσδιορίστε ό,τι βλέπετε με την κάμερα στην εφαρμογή João Browser iOS</translation>
<translation id="5242426961520127942">Κωδικός QR για σύνδεση στο João Browser ως <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">Σφάλμα εκκίνησης: <ph name="STARTUP_ERROR" />.</translation>
<translation id="3644336211313412429">Ο οργανισμός σας κλείνει το João Browser όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8321888067342493336">Αποθήκευση ως εικόνα</translation>
<translation id="3150519286474936594">Η διεύθυνση <ph name="USER_EMAIL_ADDRESS" /> χρησιμοποιούσε το João Browser στο παρελθόν</translation>
<translation id="8351551329754447960">Ενεργοποίηση Δεξιοτήτων στο Chromium</translation>
<translation id="4566781614303801262">Ενημερώστε το João Browser, για να συνεχίσετε να χρησιμοποιείτε τα δεδομένα του João Browser στον Λογαριασμό σας Google, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="8404636483124146663">Για τη λήψη μελλοντικών ενημερώσεων του João Browser, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.</translation>
<translation id="8362914115861174987">Μετάφραση στα</translation>
<translation id="8367705492654390392">Ρωτήστε οτιδήποτε</translation>
<translation id="8370517070665726704">Πνευματικά δικαιώματα <ph name="YEAR" /> Google LLC. Με την επιφύλαξη παντός δικαιώματος.</translation>
<translation id="8954225380790220359">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο João Browser. Αυτός ο κωδικός πρόσβασης θα αποθηκευτεί στον Λογαριασμό σας Google αφού συνδεθείτε.</translation>
<translation id="208035402574338948">Στη συνέχεια, θα πρέπει να επανεκκινήσετε το João Browser.</translation>
<translation id="7458698097055456629">Το João Browser προτείνει να την καταργήσετε. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK" /></translation>
<translation id="3428558977667883100">Η δημοσίευση αυτής της επέκτασης καταργήθηκε από τον προγραμματιστή της και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το João Browser, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="5012944467031125860">Το João Browser πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Google και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="8822543678238892300">{0,plural, =1{Επανεκκίνηση του João Browser σε μία ημέρα}other{Επανεκκίνηση του João Browser σε # ημέρες}}</translation>
<translation id="8438543370129609977">Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, αποστέλλονται στον διακομιστή. <ph name="LEARN_MORE" /></translation>
<translation id="4307944272317199640">Μάθετε περισσότερα σχετικά με την αναζήτηση με την Αναζήτηση εικόνων στο João Browser</translation>
<translation id="6024135746436350583">Το αρχείο του προγράμματος εγκατάστασης είναι κατεστραμμένο ή μη έγκυρο. Κατεβάστε το João Browser ξανά.</translation>
<translation id="4933173390191738516">Το João Browser απαιτεί Windows 10 ή νεότερη έκδοση.</translation>
<translation id="8463672209299734063">Προαιρετικό: Συμβάλετε στη βελτίωση των λειτουργιών και της απόδοσης του Chromium OS με αυτόματη αποστολή διαγνωστικών και δεδομένων χρήσης στην Google.</translation>
<translation id="4499703930846496679">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα João Browser στον Λογαριασμό σας Google, επαληθεύστε την ταυτότητά σας</translation>
<translation id="8482493977473846331">Εμφάνιση οδηγιών για σύνδεση στο Chromium</translation>
<translation id="2129903037617090425">Το João Browser δεν είναι ενημερωμένο</translation>
<translation id="850264194101621529">Σας ευχαριστούμε που ορίσατε το Chromium ως το προεπιλεγμένο πρόγραμμα περιήγησης!</translation>
<translation id="8522801943730206384">Το Chromium μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν τους αποθηκεύετε</translation>
<translation id="8525579356836940628">Η εγκατάσταση διακόπηκε</translation>
<translation id="2445505893586445499">Έχετε μαζί σας τους κωδικούς πρόσβασης, τις καρτέλες και άλλα στοιχεία εν κινήσει με την εφαρμογή João Browser στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="8548787790260785208">Λάβετε ειδοποίηση, εάν το Chromium εντοπίσει έναν από τους κωδικούς πρόσβασής σας σε μια δημόσια παραβίαση δεδομένων</translation>
<translation id="8555465886620020932">Σφάλμα υπηρεσίας: <ph name="SERVICE_ERROR" />.</translation>
<translation id="8871890913961794658">Ορισμένες λειτουργίες και επεκτάσεις του João Browser διαθέτουν συντομεύσεις. Μπορείτε να επιλέξετε να τις ενεργοποιήσετε ξανά.</translation>
<translation id="8556420416730706394">Μπορείτε να καρφιτσώσετε την Αναζήτηση με εικόνες για εύκολη πρόσβαση. Κάντε κλικ στο κουμπί Καρφίτσωμα στο επάνω μέρος του πλαϊνού πλαισίου</translation>
<translation id="856656450041460113">Αναζήτηση λίστας γλωσσών</translation>
<translation id="9044172203094901282">Πολλοί οργανισμοί διαχειρίζονται το João Browser</translation>
<translation id="8586442755830160949">Πνευματικά δικαιώματα <ph name="YEAR" /> Οι συντάκτες του Chromium. Με επιφύλαξη παντός δικαιώματος.</translation>
<translation id="8601359445272098721">Νέο! Μπορείτε να μεταφράσετε κείμενο και εικόνες που εμφανίζονται στην οθόνη σας, επιλέγοντας το κουμπί Μετάφραση οθόνης</translation>
<translation id="1071663705626404814">Εκκίνηση του João Browser…</translation>
<translation id="8624541899164515475">Ρυθμίσεις, ανοίγει σε νέα καρτέλα.</translation>
<translation id="8648201657708811153">Το Google Chrome for Testing δεν μπορεί να οριστεί ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="5975137268566279898">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του João Browser ή όταν κάνετε αναζήτηση από το κύριο πλαίσιο.</translation>
<translation id="6358904712334248114">Ορίστε το δικό σας João Browser</translation>
<translation id="8712637175834984815">Κατάλαβα!</translation>
<translation id="5380190167074430719">Σύνδεση στο João Browser;</translation>
<translation id="8747073452963259673">κάτω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT" />%, κάτω <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">Σφάλμα εγκατάστασης: Ο διαχειριστής του δικτύου σας έχει εφαρμόσει μια πολιτική ομάδας που εμποδίζει την εγκατάσταση: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Υπενθύμιση αργότερα</translation>
<translation id="8871607387186266158">Μοιραστείτε αυτό το έγγραφο με το Gemini στο João Browser για να λάβετε μια γρήγορη επισκόπηση και να κάνετε επιπλέον ερωτήσεις</translation>
<translation id="3009329613270131861">Σύνδεση στο João Browser;</translation>
<translation id="8823401858233292222">Ορισμός Chromium ως προεπιλεγμένο πρόγραμμα περιήγησης και καρφίτσωμα στη γραμμή εργαλείων</translation>
<translation id="8826492472752484139">Κάντε κλικ στην επιλογή Διαχείριση κωδικών πρόσβασης</translation>
<translation id="8833697763442816810">Σύστημα Chromium OS</translation>
<translation id="8852026904190808918">Αυτή η γλώσσα χρησιμοποιείται για την προβολή μενού, ρυθμίσεων, ειδοποιήσεων και άλλου κειμένου στο Chromium</translation>
<translation id="8862326446509486874">Δεν έχετε τα απαραίτητα δικαιώματα για εγκατάσταση σε επίπεδο συστήματος. Δοκιμάστε να εκτελέσετε ξανά το πρόγραμμα εγκατάστασης ως Διαχειριστής.</translation>
<translation id="6821836710312478344">Προσθήκη προφίλ João Browser</translation>
<translation id="5139769635207740615">Δεν ήταν δυνατή η αποθήκευση δεδομένων João Browser στον Λογαριασμό σας Google από το ChromiumOS λόγω σφάλματος κατά τη σύνδεση</translation>
<translation id="6814613825007700341">Ο οργανισμός σας απαιτεί να συνδεθείτε στο João Browser</translation>
<translation id="1009831347869773172">Το João Browser προσπαθεί να εμφανίσει τους κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασής σας Windows για να το επιτρέψετε αυτό.</translation>
<translation id="690637523240192979">Το João Browser δεν είναι πλέον το προεπιλεγμένο πρόγραμμα περιήγησης. Θέλετε να ορίσετε το João Browser ως το προεπιλεγμένο πρόγραμμα περιήγησης;</translation>
<translation id="225046375773654931">Δεν είναι δυνατή η ενημέρωση του João Browser</translation>
<translation id="8944232836376404813">Αυτή η ενέργεια:
          <ph name="LINE_BREAKS" />
            • Θα επαναφέρει τη σελίδα εκκίνησης, τη σελίδα Νέα καρτέλα, τη μηχανή αναζήτησης και τις καρφιτσωμένες καρτέλες
            <ph name="LINE_BREAK" />
            • Θα απενεργοποιήσει τις επεκτάσεις
            <ph name="LINE_BREAK" />
            • Θα διαγράψει τα cookie και τα άλλα προσωρινά δεδομένα ιστοτόπων
            <ph name="LINE_BREAKS" />
            Οι σελιδοδείκτες, το ιστορικό και οι αποθηκευμένοι κωδικοί πρόσβασης δεν θα επηρεαστούν.</translation>
<translation id="4960303269157380091">Εμφάνιση συντομεύσεων ιστοτόπων στο João Browser</translation>
<translation id="4349474976990059197">Λογότυπο João Browser Enterprise</translation>
<translation id="3227699293368317033">Απολαύστε την ασφάλεια της Google εν κινήσει με την εφαρμογή João Browser στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="6527164294507620103">Δεν είναι δυνατή η έναρξη του João Browser, επειδή προέκυψε πρόβλημα κατά το άνοιγμα του προφίλ σας. Δοκιμάστε να επανεκκινήσετε το João Browser.</translation>
<translation id="6741767563284518125">Διαχείριση προφίλ João Browser</translation>
<translation id="3101491883380219087">Χρησιμοποιήστε το πληκτρολόγιό σας για να πλοηγηθείτε μεταξύ του Gemini στο João Browser και της ανοιχτής καρτέλας σας.</translation>
<translation id="9018218886431812662">Η εγκατάσταση ολοκληρώθηκε</translation>
<translation id="3370247132646333337">Για να κάνουμε το João Browser πιο ασφαλές, απενεργοποιήσαμε τις ακόλουθες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="1940116386572548863">Σύνδεση στο João Browser</translation>
<translation id="5471723344588240291">Εμφάνιση της αναζήτησης με το João Browser στη γραμμή μενού του Mac και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="8381652653666868014">Το João Browser απέκλεισε αυτή τη λήψη, επειδή το αρχείο αρχειοθέτησης περιλαμβάνει άλλα αρχεία που ενδέχεται να κρύβουν κάποιο κακόβουλο πρόγραμμα</translation>
<translation id="8374335201144490555">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές. Αποκτήστε εύκολα πρόσβαση στις λειτουργίες που γνωρίζετε και αγαπάτε, ορίζοντας το João Browser ως το προεπιλεγμένο πρόγραμμα περιήγησης. Το João Browser θα καρφιτσωθεί στη γραμμή εργαλείων για γρήγορη πρόσβαση.</translation>
<translation id="6176486087616698123">Χρησιμοποιήστε τα καλύτερα εργαλεία AI της Google με την εφαρμογή João Browser στο τηλέφωνό σας</translation>
<translation id="9062666675513499497">Σύνδεση στο Chromium όταν συνδέεστε σε άλλες υπηρεσίες Google</translation>
<translation id="724802823738504651">Το João Browser έκλεισε αυτόματα</translation>
<translation id="2689333215784698609">Το João Browser δεν είναι ενημερωμένο</translation>
<translation id="8049510467237146160">{0,plural, =1{Η επανεκκίνηση του João Browser θα γίνει σε μία ώρα}other{Η επανεκκίνηση του João Browser θα γίνει σε # ώρες}}</translation>
<translation id="9106236359747881194">Επιλογή κειμένου για αναζήτηση</translation>
<translation id="8558551666630075184">Για τη λήψη μελλοντικών ενημερώσεων του João Browser, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.1.</translation>
<translation id="1194819784870407331">Άνοιγμα Συνδέσμου σε Νέα καρτέ&amp;λα João Browser</translation>
<translation id="911206726377975832">Να γίνει διαγραφή και των δεδομένων περιήγησης;</translation>
<translation id="9134482777260927479">Βοήθεια για σχολικές εργασίες</translation>
<translation id="9148058034647219655">Έξοδος</translation>
<translation id="548951409840319583">Συνεχίστε από το σημείο που σταματήσατε: Το João Browser μπορεί να επαναφέρει τις καρτέλες σας κάθε φορά που κάνετε επανεκκίνηση. Για να ενεργοποιήσετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα</translation>
<translation id="7614949510548815395">Ο διαχειριστής συστήματος έχει διαμορφώσει το João Browser έτσι ώστε να ανοίγει άλλο πρόγραμμα περιήγησης για την πρόσβαση στη διεύθυνση <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="3441698750089879771">Επανεκκίνηση για ενημέρωση του &amp;João Browser</translation>
<translation id="369689859238510548">João Browser (mDNS-In)</translation>
<translation id="8336832914816665097">Εξατομίκευση του João Browser</translation>
<translation id="7698429329590050365">Το João Browser μπορεί να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πια σε Windows XP και Windows Vista</translation>
<translation id="190261805571697214">Μεταφέρετε μαζί σας τις καλύτερες λειτουργίες ασφαλείας της Google με το João Browser.</translation>
<translation id="945522503751344254">Αποστολή σχολίων</translation>
<translation id="5554799509799759090">Ποιος χρησιμοποιεί το João Browser;</translation>
<translation id="9153108844196984904">Λάβετε την ισχυρότερη προστασία του João Browser</translation>
<translation id="983803489796659991">Η εγκατάσταση απέτυχε επειδή ο διακομιστής ενημέρωσης δεν διαθέτει δεδομένα κατακερματισμού για την εφαρμογή.</translation>
<translation id="6230710687825107323">Χρήση του João Browser χωρίς λογαριασμό</translation>
<translation id="985602178874221306">Οι συντάκτες του Chromium</translation>
<translation id="989970834842471429">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με την Αναζήτηση με εικόνες</translation>
<translation id="992780518932311116">Για χρήση της τοποθεσίας σας, παραχωρήστε πρόσβαση στο Chromium στις <ph name="BEGIN_LINK" />ρυθμίσεις συστήματος<ph name="END_LINK" /></translation>
</translationbundle>