<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="gu">
<translation id="1026101648481255140">ઇન્સ્ટૉલેશનની પ્રક્રિયા ફરી શરૂ કરો</translation>
<translation id="1029669172902658969">&amp;ChromiumOSને અપડેટ કરવા માટે, તેને ફરીથી લૉન્ચ કરો</translation>
<translation id="4711726241445951349">João Browser તમને આ એક્સ્ટેન્શનનો રિવ્યૂ કરવાનો સુઝાવ આપે છે</translation>
<translation id="1042552502243217427">જ્યારે કોઈ સાઇટ તેના પેજ પર લિંક ખાનગી રીતે પહેલેથી લોડ કરવાનું પૂછે, ત્યારે Chromium Google સર્વરનો ઉપયોગ કરે છે. આ તમારી ઓળખ પહેલેથી લોડ કરેલી સાઇટથી છુપાવે છે, પણ Googleને એ જાણવા મળે છે કે કઈ સાઇટ પહેલેથી લોડ કરવામાં આવે છે.</translation>
<translation id="1051793555070215510">આ 1 મિનિટનું સર્વેક્ષણ લઈને અમને છૂપા મોડને બહેતર બનાવવામાં અમારી મદદ કરો.</translation>
<translation id="1065672644894730302">તમારી પસંદગીઓને વાંચી શકાતી નથી.

કેટલીક સુવિધાઓ ઉપલબ્ધ હોઈ શકે છે અને પસંદગીઓ પરના ફેરફારોને સાચવવામાં આવશે નહીં.</translation>
<translation id="3937976866851867994">તમારા માતાપિતાએ João Browser માટે "સાઇટ, ઍપ અને એક્સ્ટેન્શન માટેની પરવાનગીઓ" બંધ કરી છે.\</translation>
<translation id="8626021334348319355">João Browserની કોઈ ચોક્કસ સુવિધા કે એક્સ્ટેન્શન શોધવા માટે, ઍડ્રેસ બારમાં તેનો શૉર્ટકટ અને તે પછી પસંદ કરેલા તમારા કીબોર્ડની કી ટાઇપ કરો</translation>
<translation id="9157778882771986870">João Browser તમારા પાસવર્ડની નિકાસ કરવા માગે છે. આને મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ ટાઇપ કરો.</translation>
<translation id="112640046208448578">વસ્તુઓ અથવા સ્થાનોને ઓળખો અને ટેક્સ્ટને કૉપિ કરો અથવા તેનો અનુવાદ કરો. જ્યારે તમે 'છબી વડે શોધ' સુવિધાનો ઉપયોગ કરો, ત્યારે આ પેજનો કોઈ સ્ક્રીનશૉટ સર્વરને મોકલવામાં આવે છે. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium તમારું ડિફૉલ્ટ બ્રાઉઝર છે</translation>
<translation id="1131805035311359397">ડેટા ઉલ્લંઘન અને અન્ય સુરક્ષાની સમસ્યાથી તમારા પાસવર્ડ સુરક્ષિત છે કે નહીં તે ચેક કરવા માટે, <ph name="BEGIN_LINK" />Chromeiumમાં સાઇન ઇન કરો<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">João Browser મેનૂ પર ક્લિક કરો</translation>
<translation id="1157985233335035034">તાજેતરની ભાષાઓ</translation>
<translation id="1184145431117212167">Windowsનું તમારું વર્ઝન સપોર્ટેડ ન હોવાને કારણે આ ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="1185134272377778587">Chromium વિશે</translation>
<translation id="667420476518265356">તમારા ફોન પર João Browser વડે કિંમત ટ્રૅક કરવા સંબંધિત અલર્ટ મેળવો</translation>
<translation id="1203500561924088507">ઇન્સ્ટૉલ કરવા બદલ આભાર. <ph name="BUNDLE_NAME" />નો ઉપયોગ કરતા પહેલાં તમારે તમારું બ્રાઉઝર ફરી શરૂ કરવું આવશ્યક છે.</translation>
<translation id="1232234696885483911">જ્યારે તમે 'છબી વડે શોધ' સુવિધા ખોલો, ત્યારે PDFs સહિત પેજનું શીર્ષક, URL અને કન્ટેન્ટ સર્વરને ઑટોમૅટિક રીતે મોકલવામાં આવશે. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">જ્યારે તમે સાઇન ઇન કર્યું હોય, ત્યારે તમે João Browserમાં તમારા Google એકાઉન્ટમાંથી તમારા પાસવર્ડ અને બીજી ઘણી બાબતોનો ઉપયોગ કરી શકો છો. આને બદલવા માટે, “João Browserમાં તમારા એકાઉન્ટ” પર જાઓ.</translation>
<translation id="4866003137980530528">Macના મેનૂ બારમાં João Browserમાં Gemini બતાવો</translation>
<translation id="2526294198551578217">João Browserમાં Geminiમાં સ્ક્રીનનો ભાગ પસંદ કરવા માટે, કીબોર્ડ શૉર્ટકટનો ઉપયોગ કરો.</translation>
<translation id="7068536367561625920">જ્યારે આ ટૅબ નિષ્ક્રિય હતું, ત્યારે João Browserને ઝડપી રાખવા માટે મેમરી ખાલી કરવામાં આવી હતી. તમે આ સાઇટને નિષ્ક્રિય રહેવામાંથી બાકાત રાખવાનું હંમેશા પસંદ કરી શકો છો.</translation>
<translation id="3669854427836618143">João Browser દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે ફાઇલ જોખમી છે</translation>
<translation id="126567311906253476">Gmail કે YouTube જેવી Googleની સેવાઓમાં <ph name="USER_EMAIL" /> વડે સાઇન ઇન કરતી વખતે, તમે એ જ એકાઉન્ટ વડે Chromiumમાં ઑટોમૅટિક રીતે સાઇન ઇન કરી શકો છો</translation>
<translation id="8094399825947986050">તમારા ફોન પર João Browser મેળવો</translation>
<translation id="1290883685122687410">સેટઅપ કરવામાં ભૂલ: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">તમારી નવી João Browser પ્રોફાઇલ સેટઅપ કરો</translation>
<translation id="7591029065989504977">Gemini in João Browser વડે અજમાવી જુઓ</translation>
<translation id="8408989583029959522">બ્લૂટૂથ ડિવાઇસ વિશે શોધખોળ કરવા João Browserને બ્લૂટૂથના&#32;
 ઍક્સેસની જરૂર છે. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">તમારા ફોન પર João Browserમાં સાઇન ઇન કરો</translation>
<translation id="1330562121671411446">ભાષા શોધો</translation>
<translation id="6026568602942276348">João Browser (<ph name="URL" />)માંથી પણ ડેટા ડિલીટ કરો</translation>
<translation id="1345251407431278948">પિન કરેલી છે! તમે ટૂલબાર પરના નવા બટનમાંથી 'છબી વડે શોધ' સુવિધાને ફરીથી ઍક્સેસ કરી શકો છો</translation>
<translation id="1356661055722410047">નવું! તમે તમારી સ્ક્રીન પર ટેક્સ્ટ અને છબીઓનો અનુવાદ કરી શકો છો</translation>
<translation id="1383876407941801731">શોધો</translation>
<translation id="5807085300679014096">મુસાફરીમાં બ્રાઉઝ કરવાનું ચાલુ રાખવા માટે João Browser ઍપનો ઉપયોગ કરો</translation>
<translation id="141901961143729572">તમારા વિચારો શેર કરો</translation>
<translation id="3736947618013031173">તમારી વિન્ડો શેર કરવા માટે, સિસ્ટમના સેટિંગમાં João Browser માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો.</translation>
<translation id="1478370723027452770">Chrome for Testing માટે સહાય મેળવો</translation>
<translation id="1497802159252041924">ઇન્સ્ટૉલ કરવામાં ભૂલ: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">આ પેજ સંરક્ષિત છે</translation>
<translation id="4379865404970367448">João Browser ટૅબ શેર કરો</translation>
<translation id="4436275659297289591">João Browserમાં સાઇન ઇન કરો</translation>
<translation id="1547469039832541117">હાઇલાઇટ કરેલું કાર્ય સમાપ્ત કરે છે.</translation>
<translation id="449712764049695153">João Browserને પિન કરો</translation>
<translation id="1574377791422810894">Chromiumના સલામતી માટેના ટૂલ</translation>
<translation id="5480232403718129394">João Browser તમારો Password Manager ડેટા ડિલીટ કરવા માગે છે. આને મંજૂરી આપવા માટે Windowsનો પાસવર્ડ ટાઇપ કરો.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{અપડેટ લાગુ કરવા માટે તમે João Browserને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે}=1{અપડેટ લાગુ કરવા માટે તમે João Browserને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે. તમારી છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{અપડેટ લાગુ કરવા માટે તમે João Browserને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{અપડેટ લાગુ કરવા માટે તમે João Browserને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="980976428162070137">તમારા ફોન પર João Browser ઍપ વડે Googleનો વધુમાં વધુ લાભ મેળવો</translation>
<translation id="1625909126243026060">Chromiumમાં પ્રાઇવસી અને સુરક્ષા સંબંધિત મુખ્ય નિયંત્રણોનો રિવ્યૂ કરો</translation>
<translation id="1640672724030957280">ડાઉનલોડ કરી રહ્યું છે...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" />, મેમ્બરશિપ તરીકે સાઇન ઇન કર્યું. એકાઉન્ટ મેનૂ ખોલો</translation>
<translation id="1708414395296835197">જ્યારે પણ તમે મેસેજ, દસ્તાવેજો અને અન્ય ઍપમાંની લિંક પર ક્લિક કરો, ત્યારે તમે Chromiumનો ઉપયોગ કરી શકો છો. તેને તમારા ટાસ્કબાર પર પણ પિન કરવામાં આવશે.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> માટે વધારેલા વિશેષાધિકારો પ્રદાન કરે છે.</translation>
<translation id="1722488837206509557">આ તમને ઉપલબ્ધ ડિવાઇસમાંથી પસંદ કરવાની અને તેમના પર કન્ટેન્ટ બતાવવાની મંજૂરી આપશે.</translation>
<translation id="6972087163510342335">João Browser ટૂંક સમયમાં જ બ્રાઉઝિંગ ડેટા ડિલીટ કરશે</translation>
<translation id="1736443181683099871">Chromium નૅવિગેશનને HTTPS પર અપગ્રેડ કરવાનો પ્રયાસ કરશે</translation>
<translation id="3879288383593333401">João Browser ડેટા સાફ કર્યો</translation>
<translation id="656496276885630888">João Browser <ph name="REMAINING_TIME" />માં ફરી શરૂ થશે</translation>
<translation id="1749104137266986751">જ્યારે HTTPS ઉપલબ્ધ ન હોય, ત્યારે Chromium તમને ચેતવણી આપ્યા વિના અસુરક્ષિત કનેક્શનનો ઉપયોગ કરશે</translation>
<translation id="1226290419185955779">João Browserને બૅકગ્રાઉન્ડમાં ચાલવા દો</translation>
<translation id="4231366995273072370">João Browser ને સુરક્ષિત બનાવવા માટે, અમે <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> માં સૂચિબદ્ધ નથી અને તમારી જાણ વિના ઉમેરવામાં આવ્યાં હોઈ શકે છે તેવા કેટલાક એક્સ્ટેન્શન્સને અક્ષમ કર્યા છે.</translation>
<translation id="1822049153969905781">ઝડપી ઍક્સેસ માટે João Browserને તમારા ટાસ્કબાર પર પિન કરવા માટે Windows નોટિફિકેશનમાં <ph name="BEGIN_BOLD" />હા<ph name="END_BOLD" /> પર ક્લિક કરો</translation>
<translation id="1321831992638405531">João Browser ફરીથી ઇન્સ્ટોલ કરો</translation>
<translation id="3386967202064865436">João Browser <ph name="AUTHENTICATION_PURPOSE" />નો પ્રયાસ કરી રહ્યું છે</translation>
<translation id="70054449700528483">આગલી વખતે જ્યારે તમે તમારા <ph name="DEVICE_TYPE" /> પર João Browser ખોલો, ત્યારે તમને Google Password Managerનો ઉપયોગ કરવા માટેનો પ્રૉમ્પ્ટ દેખાશે.</translation>
<translation id="1838374766361614909">શોધ સાફ કરો</translation>
<translation id="5807096362853316123">તમારા Google એકાઉન્ટમાં બ્રાઉઝિંગ ડેટા રાખીને તેને માત્ર આ ડિવાઇસમાંથી ડિલીટ કરવા માટે, <ph name="BEGIN_LINK" />João Browserમાંથી સાઇન આઉટ કરો<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">મુસાફરીમાં હો ત્યારે ટૅબના નવા ગ્રૂપ ખોલવા અથવા બનાવવા માટે તમારા ફોન પર João Browser ડાઉનલોડ કરો.</translation>
<translation id="185970820835152459">તમે તમારા સાઇન ઇન કરેલા હોય એવા Google એકાઉન્ટ મેનેજ કરી શકો છો. તમારા Google એકાઉન્ટનો ઉપયોગ Chromium બ્રાઉઝર, Play Store, Gmail અને વધુ માટે થાય છે. જો તમે કોઈ બીજા, જેમકે તમારા કુટુંબના સભ્ય માટે એકાઉન્ટ ઉમેરવા માંગતા હો, તો તેના બદલે નવી વ્યક્તિને તમારા <ph name="DEVICE_TYPE" />માં ઉમેરો. <ph name="LINK_BEGIN" />વધુ જાણો<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">'છબી વડે શોધ' સુવિધા વડે શોધો</translation>
<translation id="65457771685016683"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં João Browserમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને <ph name="DEVICE" />માંથી તમારા બુકમાર્ક અને બીજું ઘણું પણ મળશે.</translation>
<translation id="1880677175115548835">ટેક્સ્ટ પસંદ કરો</translation>
<translation id="2634119629547215883">તમે મેનેજ કરેલા એકાઉન્ટ સાથે સાઇન ઇન કરી રહ્યાં છો અને તમારી João Browser પ્રોફાઇલ પર ઍડમિનને એનું નિયંત્રણ આપી રહ્યાં છો. તમારો João Browser ડેટા, જેમ કે ઍપ, બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજા સેટિંગ, કાયમ માટે <ph name="USER_NAME" />થી જોડાયેલા રહેશે. તમે Google એકાઉન્ટ ડૅશબોર્ડથી આ ડેટાને ડિલીટ કરી શકશો, પરંતુ તમે આ ડેટાને બીજા એકાઉન્ટ સાથે સાંકળી શકશો નહીં. તમે હાલના João Browser ડેટાને અલગ રાખવા માટે વૈકલ્પિક રીતે એક નવી પ્રોફાઇલ બનાવી શકો છો. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium દ્વારા સ્મૂધ સ્ક્રોલિંગ અને વીડિયોના ફ્રેમ રેટ જેવી બૅકગ્રાઉન્ડ ઍક્ટિવિટી અને વિઝ્યુઅલ ઇફેક્ટને મર્યાદિત કરીને બૅટરીના પાવરની બચત કરવામાં આવે છે. <ph name="BEGIN_LINK" />એનર્જી સેવર વિશે વધુ જાણો<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">João Browser અપડેટર સેવા</translation>
<translation id="1911763535808217981">આને બંધ કરવાથી, તમે Chromiumમાં સાઇન ઇન કર્યા સિવાય Gmail જેવી Googleની સાઇટમાં સાઇન ઇન કરી શકશો</translation>
<translation id="4037729269678342163">João Browser પ્રતિસાદ આપતું નથી. હવે ફરીથી લોંચ કરીએ?</translation>
<translation id="7563750688920581112">તમારી સંસ્થાના <ph name="MANAGER" /> માટે જરૂરી છે કે તમે João Browserમાં સાઇન ઇન કરો</translation>
<translation id="193439633299369377">અપડેટ લાગુ કરવા માટે ChromiumOSને ફરી શરૂ કરવાની જરૂર છે.</translation>
<translation id="7099143775283792684">João Browser દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે સામાન્ય રીતે આ પ્રકારની ફાઇલ ડાઉનલોડ કરવામાં આવતી નથી અને તે જોખમી હોઈ શકે છે</translation>
<translation id="1953553007165777902">ડાઉનલોડ કરી રહ્યાં છીએ… <ph name="MINUTE" /> મિનિટ બાકી છે</translation>
<translation id="1966382378801805537">Chromium ડિફૉલ્ટ બ્રાઉઝરને નિર્ધારિત અથવા સેટ કરી શકતું નથી</translation>
<translation id="197326043290947695">'છબી વડે શોધ' સુવિધા વડે વધુ સ્માર્ટ રીતે બ્રાઉઝ કરો</translation>
<translation id="6185556991023272801">João Browser શા માટે અમુક ફાઇલો બ્લૉક કરે છે તે જાણો, નવા ટૅબમાં ખૂલે છે</translation>
<translation id="4053636705816895911">તમારો João Browser સૉફ્ટવેર અપ ટૂ ડેટ રાખે છે. જો આ સેવા બંધ કરવા કે રોકવામાં આવે, તો તમારો João Browser સૉફ્ટવેર અપ ટૂ ડેટ રહેશે નહીં, એટલે કે ઉદ્ભવી શકે તેવા સુરક્ષા સંબંધિત જોખમોનું નિરાકરણ કરી શકાય નહીં એમ બની શકે છે અને સુવિધાઓ કાર્ય કરે નહીં એમ બની શકે છે. જ્યારે આ સેવાનો ઉપયોગ કરતો કોઈ João Browser સૉફ્ટવેર ન હોય, ત્યારે તે આપમેળે જ અનઇન્સ્ટૉલ થઈ જાય છે.</translation>
<translation id="2008474315282236005">આ, 1 આઇટમને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, Chromium માં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="2018879682492276940">ઇન્સ્ટૉલ કરવામાં નિષ્ફળ રહ્યાં. કૃપા કરીને ફરી પ્રયાસ કરો.</translation>
<translation id="2039417478970545937">સેટિંગ.</translation>
<translation id="2049376729098081731">Googleની સેવાઓમાં વધુ મનગમતા બનાવેલા અનુભવો આપવા માટે, Chromium ઇતિહાસ શામેલ કરવો કે નહીં, તે પસંદ કરો</translation>
<translation id="6768767091114123654">તમને સશક્ત પાસવર્ડ બનાવવામાં, સાચવવામાં અને તેને ઑટોમૅટિક રીતે ભરવામાં મદદ કરવા માટે João Browserમાં પહેલેથી જ આ સુવિધા આપવામાં આવી છે. સરળ ઍક્સેસ માટે શૉર્ટકટ ઉમેરો.</translation>
<translation id="3571664229232252557">João Browserને નવો દેખાવ આપવા માટે નવા ટૅબ પેજ પર જઈને João Browserને કસ્ટમાઇઝ કરો બટન પર ક્લિક કરો</translation>
<translation id="4273287215573278663">João Browser દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે આ ફાઇલ છેતરામણી છે અને તે તમારા ડિવાઇસમાં અનપેક્ષિત ફેરફારો કરે તેમ બની શકે છે</translation>
<translation id="9063967192437499581">તમે આગલી વખતે João Browser iOS ખોલો ત્યારે તમને <ph name="FEATURE_NAME" /> અજમાવવા માટેનો પ્રૉમ્પ્ટ દેખાશે.</translation>
<translation id="8511569826706775962">તમારા Google એકાઉન્ટમાં તમે સાચવેલા તમારા પાસવર્ડ અને João Browserનો અન્ય ડેટા આ ડિવાઇસમાંથી કાઢી નાખવામાં આવશે. João Browserમાં તેનો ફરીથી ઉપયોગ કરવા માટે, પાછું સાઇન ઇન કરો.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{જ્યારે 1 મિનિટ સુધી João Browserનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા બ્રાઉઝિંગ ડેટાને ઑટોમૅટિક રીતે ડિલીટ કરે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે. તમારા ટૅબ ખોલેલા રહેશે.}one{જ્યારે # મિનિટ સુધી João Browserનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા બ્રાઉઝિંગ ડેટાને ઑટોમૅટિક રીતે ડિલીટ કરે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે. તમારા ટૅબ ખોલેલા રહેશે.}other{જ્યારે # મિનિટ સુધી João Browserનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા બ્રાઉઝિંગ ડેટાને ઑટોમૅટિક રીતે ડિલીટ કરે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે. તમારા ટૅબ ખોલેલા રહેશે.}}</translation>
<translation id="2125838419757773031">શોધવા માટે સ્ક્રીનનો વિસ્તાર પસંદ કરો</translation>
<translation id="2126108037660393668">ડાઉનલોડ કરેલી ફાઇલની ચકાસણી નિષ્ફળ થઈ.</translation>
<translation id="2135919691573380097">આ સાઇટની જાણ કરો</translation>
<translation id="2137162749895930932">અનુવાદ સ્ક્રીન બંધ કરો</translation>
<translation id="1308845716497059117">João Browser દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે આ સાઇટ કોઈ સુરક્ષિત કનેક્શનનો ઉપયોગ કરી રહી નથી તેમજ ફાઇલ સાથે ચેડાં કરવામાં આવ્યા હોઈ શકે છે</translation>
<translation id="2170098639895543546">પેજ પર કંઈપણ પસંદ કરો</translation>
<translation id="6705844023496387932">João Browser કસ્ટમાઇઝ કરો</translation>
<translation id="2174917724755363426">ઇન્સ્ટૉલેશનની પ્રક્રિયા પૂર્ણ થઈ નથી. શું તમે ખરેખર રદ કરવા માગો છો?</translation>
<translation id="7728290795259244895">João Browser - નેટવર્ક સાઇન ઇન - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">અપડેટ ચેક કરવામાં ભૂલ: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">João Browserમાંથી એકાઉન્ટ કાઢી નાખો</translation>
<translation id="4648870374540039667">મુસાફરીમાં શૉપિંગના શ્રેષ્ઠ ટૂલ સાથે રાખવા માટે João Browser ઍપનો ઉપયોગ કરો</translation>
<translation id="2106116820042118250">iOS માટે João Browser પર Safe Browsingમાં વધારેલી સુરક્ષા વડે મુસાફરીમાં વધુ સલામત રહો</translation>
<translation id="2210682093923538346">જોખમી સાઇટ. Chromium દ્વારા નોટિફિકેશન કાઢી નાખવામાં આવ્યા.</translation>
<translation id="2236949375853147973">મારી ઍક્ટિવિટી</translation>
<translation id="118764235932893741">તમારા બધા ડિવાઇસ પર તમારા ઍડ્રેસ અને બીજું ઘણું મેળવવા માટે, João Browserમાં સાઇન ઇન કરો. તમે સાઇન ઇન કરો તે પછી આ ઍડ્રેસ તમારા Google એકાઉન્ટમાં સાચવવામાં આવશે.</translation>
<translation id="7254578863532089400">જો તમે કમ્પ્યુટરને શેર કરો છો, તો મિત્રો અને કુટુંબીજનો અલગ-અલગ બ્રાઉઝ કરી અને તેમને જોઇએ તેમ João Browser ને સેટ કરી શકે છે.</translation>
<translation id="22571759390241347">Chromiumમાં કૌશલ્યો</translation>
<translation id="2283803047247799269">'છબી વડે શોધ' સુવિધા વડે આ ટૅબ શોધો</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{João Browserનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યું હોય એવા ટૅબને થોભાવી દો}one{João Browserનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યું હોય એવા ટૅબને થોભાવી દો}other{João Browserનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યાં હોય એવા ટૅબને થોભાવી દો}}</translation>
<translation id="2307973900865360088">ડૉકમાં રાખો</translation>
<translation id="2313870531055795960">URLsને Chromiumમાં સંગ્રહિત અસુરક્ષિત સાઇટની સૂચિ સાથે ચેક કરે છે. જો કોઈ સાઇટ તમારો પાસવર્ડ ચોરી કરવાનો પ્રયાસ કરે અથવા તમે કોઈ નુકસાનકારક ફાઇલ ડાઉનલોડ કરો, ત્યારે Chromium પેજ કન્ટેન્ટના બિટની સાથોસાથ URLs પણ Safe Browsingને મોકલી શકે છે.</translation>
<translation id="2356070529366658676">કહો</translation>
<translation id="2359808026110333948">આગળ વધો</translation>
<translation id="3800730051093461113">\"<ph name="EXTENSION_NAME" />\" એક્સ્ટેન્શન ઇચ્છે છે કે તમે João Browserમાં સાઇન ઇન કરો</translation>
<translation id="8758735062658446604">ઍપ માટે બૅકગ્રાઉન્ડમાં João Browser ચલાવવાનું બંધ કરો</translation>
<translation id="2623595027619107207"><ph name="USER_EMAIL_ADDRESS" /> તરીકે આ એક્સ્ટેન્શનનો ઉપયોગ કરવા માટે, João Browserમાં સાઇન ઇન કરો.</translation>
<translation id="2384373936468275798">તમારા એકાઉન્ટની સાઇન ઇન વિગતો જૂની હોવાને કારણે ChromiumOS તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{1 HID ડિવાઇસને એક કે વધુ João Browser એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું હતું}=1{1 HID ડિવાઇસને એક કે વધુ João Browser એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}one{# HID ડિવાઇસને એક કે વધુ João Browser એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}other{# HID ડિવાઇસને એક કે વધુ João Browser એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યાં છે}}</translation>
<translation id="6254788431480237503">આ સાઇટ માટે João Browserને કૅમેરા અને માઇક્રોફોનની પરવાનગીઓની જરૂર છે</translation>
<translation id="2403703063067034158">સ્ટાર્ટઅપ દરમિયાન ભૂલ: અન્ય સેટઅપ હાલમાં ચાલી રહ્યું છે, કૃપા કરીને પછીથી પ્રયાસ કરો.</translation>
<translation id="3028975423343897358">કોઈપણ ઍપમાંથી João Browserમાં લિંક ખોલો અને તમારા ટાસ્કબાર પર બ્રાઉઝરને ઍક્સેસિબલ રાખો</translation>
<translation id="579079006139156831">ઝડપી ઓવરવ્યૂ મેળવવા અને ફૉલોઅપ પ્રશ્નો પૂછવા માટે, આ દસ્તાવેજને Gemini in Chrome સાથે શેર કરવા માટે સારાંશ આપો બટન પર ક્લિક કરો</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Chromiumના ટૂલ<ph name="END_LINK" /> વડે, તમે સલામત રીતે બ્રાઉઝ કરી શકો છો તેમજ નિયંત્રણ જાળવી શકો છો</translation>
<translation id="7114471809991869757"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં João Browserમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ તેમજ બીજું ઘણું મળશે.</translation>
<translation id="2451727308784734061">Password Manager પર ઝડપથી જવા માટે તમારા શૉર્ટકટનો ઉપયોગ કરો. તમે તમારા શૉર્ટકટને તમારા કમ્પ્યુટરની હોમ સ્ક્રીન અથવા ઍપ લૉન્ચર પર ખસેડી શકો છો.</translation>
<translation id="2709136733469807397">João Browser ટૂંક સમયમાં જ બંધ થશે</translation>
<translation id="3652225684487279741">João Browser માં</translation>
<translation id="2485422356828889247">અનઇન્સ્ટૉલ કરો</translation>
<translation id="2513154137948333830">રીબૂટ કરવું આવશ્યક છે: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">'છબી વડે શોધ' સુવિધા વડે ટેક્સ્ટ પસંદ કરો</translation>
<translation id="1527474262707362156">João Browser વર્તમાન પાસવર્ડ બદલવાનો પ્રયાસ કરી રહ્યું છે. આને મંજૂરી આપવા માટે Windowsનો પાસવર્ડ ટાઇપ કરો.</translation>
<translation id="6480371226914552131">ફાઇલો ડાઉનલોડ કરવા માટે João Browserને સ્ટોરેજના ઍક્સેસની જરૂર પડે છે</translation>
<translation id="6318568902186985084">João Browser હેલ્પર</translation>
<translation id="2575822587468774919">'છબી વડે શોધ' સુવિધા વડે શોધવા માટે કંઈપણ પસંદ કરો</translation>
<translation id="4557210258834653476">તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ અને બીજું ઘણું મેળવવા માટે, João Browserમાં સાઇન ઇન કરો</translation>
<translation id="1148164459654218834">João Browser ડાઉનલોડ કરવા અને તમારા Google એકાઉન્ટમાં સાઇન ઇન કરવા માટે તમારા ફોન વડે QR કોડને સ્કૅન કરો.</translation>
<translation id="235892353478111963">João Browserનો ઉપયોગ કરવાનું ચાલુ રાખો</translation>
<translation id="259935314519650377">ડાઉનલોડ કરેલા ઇન્સ્ટૉલરને કૅશ મેમરીમાં સાચવવામાં નિષ્ફળ રહ્યાં. ભૂલ: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">સિસ્ટમ</translation>
<translation id="8471946631262724853">તમારી સંસ્થા બ્રાઉઝિંગ ડેટા જોઈ અને મેનેજ કરી શકે છે, જેમ કે તમારા બુકમાર્ક, ઇતિહાસ અને પાસવર્ડ. તે અન્ય João Browser પ્રોફાઇલમાં બ્રાઉઝિંગ ડેટા જોઈ શકશે નહીં</translation>
<translation id="2870759219964376597">તમારા <ph name="ACCOUNT_EMAIL" /> એકાઉન્ટમાં João Browser ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે, આ તમે જ છો તેની ચકાસણી કરો</translation>
<translation id="2955972712254986678">{COUNT,plural, =0{અપડેટ લાગુ કરવા માટે, અદ્યતન સુરક્ષા માટે જરૂરી છે કે તમે João Browser ફરીથી લૉન્ચ કરો}=1{અપડેટ લાગુ કરવા માટે, અદ્યતન સુરક્ષા માટે જરૂરી છે કે તમે João Browser ફરીથી લૉન્ચ કરો. તમારી છૂપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{અપડેટ લાગુ કરવા માટે, અદ્યતન સુરક્ષા માટે જરૂરી છે કે તમે João Browser ફરીથી લૉન્ચ કરો. તમારી # છૂપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{અપડેટ લાગુ કરવા માટે, અદ્યતન સુરક્ષા માટે જરૂરી છે કે તમે João Browser ફરીથી લૉન્ચ કરો. તમારી # છૂપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="8949462882238006192">João Browser પ્રારંભ કરો</translation>
<translation id="4224214204752803768">ઇન્સ્ટૉલેશન દરમિયાન ઓપરેટિંગ સિસ્ટમ ભૂલ આવી. કૃપા કરીને ફરીથી João Browser ડાઉનલોડ કરો.</translation>
<translation id="3141414135710372892">જો તમે ડિવાઇસ શેર કરતા હો, તો મિત્રો અને કુટુંબીજનો અલગ-અલગ બ્રાઉઝ કરી શકે છે અને તેઓ તેમને જોઈએ તે પ્રમાણે João Browserનું સેટઅપ કરી શકે છે</translation>
<translation id="8838607803339100223">તમારા સમગ્ર ડિવાઇસ પર João Browserમાં Geminiનો ઉપયોગ કરવા માટે સરળ ઍક્સેસ, પછી ભલેને João Browser નાનું કર્યું હોય.</translation>
<translation id="1679364578146271696">João Browser ટૅબ</translation>
<translation id="2718390899429598676">ઉમેરેલી સુરક્ષા માટે, Chromium તમારા ડેટાને એન્ક્રિપ્ટ કરશે.</translation>
<translation id="1874696651662237927">João Browserમાંથી તમારા Google એકાઉન્ટને કાઢી નાખવા માટે, સાઇન આઉટ કરો</translation>
<translation id="6850669719663104304">તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ, બુકમાર્ક અને બીજું ઘણું મેળવવા માટે, João Browserમાં સાઇન ઇન કરો</translation>
<translation id="2738871930057338499">ઇન્ટરનેટ સાથે કનેક્ટ કરી શકતા નથી. HTTP 403 પ્રતિબંધિત. કૃપા કરીને તમારું પ્રૉક્સી કન્ફિગ્યુરેશન ચેક કરો.</translation>
<translation id="2753623023919742414">શોધવા માટે ક્લિક કરો</translation>
<translation id="4193420110872590792">João Browser ને તમારા ડિફૉલ્ટ PDF વ્યૂઅર તરીકે સેટ કરો</translation>
<translation id="6614401181366354261">આ એક્સ્ટેન્શન માલવેર ધરાવે છે અને તે અસુરક્ષિત છે. તેને João Browserમાંથી કાઢી નાખો જેથી તે હવેથી તમારી વ્યક્તિગત માહિતી સહિત તમે મુલાકાત લો તે સાઇટ પરનો તમારો ડેટા જોઈ કે બદલી શકે નહીં.</translation>
<translation id="2799223571221894425">ફરીથી લોંચ કરો</translation>
<translation id="6299858290790311689">તમારું João Browser</translation>
<translation id="2816462166102338036">'છબી વડે શોધ' સુવિધા વડે આ વીડિયો શોધો</translation>
<translation id="5896458971800337862">iOS પર João Browser વડે તમારા કૅમેરા વડે પ્રોડક્ટ શોધો, કિંમતમાં ઘટાડાને ટ્રૅક કરો અને મુસાફરીમાં બીજું ઘણું કરો.</translation>
<translation id="2841525013647267359">આમાંથી અનુવાદ કરો</translation>
<translation id="2846251086934905009">ઇન્સ્ટૉલ કરવામાં ભૂલ: ઇન્સ્ટૉલર પૂર્ણ થયું નહીં. ઇન્સ્ટોલેશન રદ કરવામાં આવ્યું છે.</translation>
<translation id="4357241592510111611">João Browser માંથી દૂર કરો...</translation>
<translation id="2850691299438350830">તમને Chromium પર સલામત રાખે છે અને જ્યારે તમે સાઇન ઇન થયા હો, ત્યારે Googleની અન્ય ઍપમાં તમારી સુરક્ષા બહેતર બનાવવામાં કદાચ ઉપયોગમાં લેવાઈ શકે છે</translation>
<translation id="2885378588091291677">કાર્ય વ્યવસ્થાપક</translation>
<translation id="8887040619780090085">&amp;João Browser વિશે</translation>
<translation id="2915996080311180594">પછીથી ફરી શરૂ કરો</translation>
<translation id="6619708652934279502">તમારો ડેટા તમારા પાસફ્રેઝ વડે એન્ક્રિપ્ટ કરવામાં આવ્યો છે. તમારા Google એકાઉન્ટમાં João Browser ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે, તમારો પાસફ્રેઝ દાખલ કરો.</translation>
<translation id="2945997411976714835">ઇન્સ્ટૉલ કરવામાં ભૂલ: ઇન્સ્ટૉલરની પ્રક્રિયા શરૂ થવામાં નિષ્ફળ રહી.</translation>
<translation id="4566114009566397386">iOS પર João Browser માટે સાચવેલા પાસવર્ડનો ઉપયોગ કરીને સાઇટ પર વધુ ઝડપથી સાઇન ઇન કરો</translation>
<translation id="562175540137901632">તમારી સંસ્થા João Browserને મેનેજ કરે છે</translation>
<translation id="2977470724722393594">Chromium અપ ટૂ ડેટ છે</translation>
<translation id="2977506796191543575">જો કોઈ સાઇટ તમારો પાસવર્ડ ચોરી કરવાનો પ્રયાસ કરે અથવા તમે કોઈ નુકસાનકારક ફાઇલ ડાઉનલોડ કરો, ત્યારે Chromium પેજ કન્ટેન્ટના બિટ સહિત URLs પણ Safe Browsingને મોકલી શકે છે</translation>
<translation id="1776205510657237623">તમારા માતાપિતાની પસંદગીઓ સાથે ઑનલાઇન વધુ સલામત રહેવા માટે, João Browserમાં સાઇન ઇન કરો</translation>
<translation id="3003694935412297923">બધા કામ</translation>
<translation id="3374694374267805392">{count,plural, =1{તમારા Google એકાઉન્ટમાં કેટલોક ડેટા સાચવી શકાય અને તમારા બધા ડિવાઇસ પર તેનો ઉપયોગ કરી શકાય તે પહેલાં, João Browser માટે એ તમે જ છો તેની ચકાસણી કરવી જરૂરી છે. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા (1 આઇટમ) ડિલીટ કરવામાં આવશે.}one{તમારા Google એકાઉન્ટમાં કેટલોક ડેટા સાચવી શકાય અને તમારા બધા ડિવાઇસ પર તેનો ઉપયોગ કરી શકાય તે પહેલાં, João Browser માટે એ તમે જ છો તેની ચકાસણી કરવી જરૂરી છે. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ({count} આઇટમ) ડિલીટ કરવામાં આવશે.}other{તમારા Google એકાઉન્ટમાં કેટલોક ડેટા સાચવી શકાય અને તમારા બધા ડિવાઇસ પર તેનો ઉપયોગ કરી શકાય તે પહેલાં, João Browser માટે એ તમે જ છો તેની ચકાસણી કરવી જરૂરી છે. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ({count} આઇટમ) ડિલીટ કરવામાં આવશે.}}</translation>
<translation id="4915792193596835645">João Browserમાં નવા ટૅબમાં <ph name="URL" /> ખોલો.</translation>
<translation id="302551344979399011">કૌશલ્યો જેવી AI ઇનોવેશન તમારા Google એકાઉન્ટમાં સાચવવામાં આવે છે અને Chromium સિંકથી અલગથી મેનેજ કરવામાં આવે છે</translation>
<translation id="8367114375553489372">João Browser માં ઉમેરી રહ્યું છે...</translation>
<translation id="3038232873781883849">ઇન્સ્ટૉલ થવાની રાહ જોઈ રહ્યાં છીએ...</translation>
<translation id="3045032126857188731">અનુવાદિત ભાષા: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">પ્રતિસાદનો સંવાદ બંધ કરો</translation>
<translation id="6168172692486433600">અન્ય João Browser પ્રોફાઇલ</translation>
<translation id="884929993636327">એક્સ્ટેન્શન એવા ઍડ-ઑન હોય છે જે તમને João Browserને કસ્ટમાઇઝ કરવાની મંજૂરી આપે છે. સુવ્યવસ્થિત રહેવાથી લઈને રોજિંદા કાર્યોને સરળ બનાવવા સુધી, એક્સ્ટેન્શન તમને João Browserને તમારું પોતાનું બનાવવામાં મદદ કરે છે.</translation>
<translation id="1525897524206034002">ક્રૅશ રિપોર્ટ અને <ph name="UMA_LINK" /> Googleને મોકલીને João Browser ને વધુ સારું બનાવવામાં મદદ કરો.</translation>
<translation id="2766971658743453990">મુસાફરીમાં Googleની સલામતી મેળવવા માટે João Browser ઍપનો ઉપયોગ કરો</translation>
<translation id="4387884830246074210">{NUM_DEVICES,plural, =0{1 USB ડિવાઇસને એક કે વધુ João Browser એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું હતું}=1{1 USB ડિવાઇસને એક કે વધુ João Browser એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}one{# USB ડિવાઇસને એક કે વધુ João Browser એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}other{# USB ડિવાઇસને એક કે વધુ João Browser એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યાં છે}}</translation>
<translation id="3413144813287436446">João Browserનો ઇતિહાસ</translation>
<translation id="9192419056064225629">ઇન્સ્ટૉલર આર્કાઇવને અનકોમ્પ્રેસ કરવામાં નિષ્ફળ. કૃપા કરીને João Browser ફરીથી ડાઉનલોડ કરો.</translation>
<translation id="310459126943037700">કામ સમાપ્ત કરવામાં નિષ્ફળ.</translation>
<translation id="3104828284009500087">પેજ પર કંઈપણ શોધો</translation>
<translation id="3508468328135806512">તમારા પાસવર્ડ, બુકમાર્ક અને ઇતિહાસને બધા ડિવાઇસ પર સંપૂર્ણ રીતે સિંક કરેલા રાખો. તમારા ડિફૉલ્ટ બ્રાઉઝરને João Browser પર અપડેટ કરીને તમે જાણતા હો એવી અને તમને ગમતી હોય એવી સુવિધાઓને સરળતાથી ઍક્સેસ કરો.</translation>
<translation id="3216151988142306917">João Browser તમારા માઇક્રોફોનનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="3130333203120345554">નવી શોધ</translation>
<translation id="3137969841538672700">શોધવા માટે ખેંચો</translation>
<translation id="7493177208577109722">આ ટૅબ વધારાના સંસાધનોનો ઉપયોગ કરી રહ્યું છે. તમારા પર્ફોર્મન્સને બહેતર બનાવવા માટે, João Browserને તેને નિષ્ક્રિય કરવા દો.</translation>
<translation id="7239354789967255675">તમારી સ્ક્રીન શેર કરવા માટે, સિસ્ટમના સેટિંગમાં João Browser માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો</translation>
<translation id="4955872590603594814">João Browser ને ફરીથી લોંચ કરો</translation>
<translation id="3161522574479303604">બધી ભાષાઓ</translation>
<translation id="4697739132113629685">João Browser છુ&amp;પી વિંડોમાં લિંક ખોલો</translation>
<translation id="1629247860984475766">તમારી નવી João Browser પ્રોફાઇલ કસ્ટમાઇઝ કરો</translation>
<translation id="1905008150929775692">તમે ટૅબ સ્વિચ કર્યા વિના AI મોડ સાથે ચૅટ કરવાનું ચાલુ રાખી શકો છો. શરૂ કરવા માટે, João Browserમાં સાઇન ઇન કરો. તમને તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ તેમજ બીજું પણ ઘણું મળશે.</translation>
<translation id="4232381420311815141">João Browserમાંથી તમારા Google એકાઉન્ટને કાઢી નાખવા માટે, સેટિંગ પેજમાં જઈને João Browserમાંથી સાઇન આઉટ કરો</translation>
<translation id="3234316605225071811">પછીથી, તમે તમારા માટે ફોર્મ ઑટોમૅટિક રીતે ભરવાની સુવિધા માટે સચવાયેલી માહિતીનો ઉપયોગ કરવા માગો છો કે કેમ તે વિશે Chromium તમને પૂછી શકે છે</translation>
<translation id="6676749542734993844">João Browser એની ડેટા ડિરેક્ટરી વાંચી અથવા લખી શકતુંં નથી:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">iOS પર João Browser વડે તમારા મનપસંદ Google AI ટૂલને મુસાફરીમાં તમારી સાથે રાખો.</translation>
<translation id="3286538390144397061">હવે ફરીથી પ્રારંભ કરો</translation>
<translation id="532528773927600103">Google API કીઝ ખૂટે છે. João Browser ની કેટલીક કાર્યક્ષમતા અક્ષમ થશે.</translation>
<translation id="3296368748942286671">જ્યારે Chromium બંધ થાય ત્યારે બૅકગ્રાઉન્ડ ઍપ ચલાવવાનું ચાલુ રાખો</translation>
<translation id="3313189106987092621">અસુરક્ષિત કનેક્શનનો ઉપયોગ કરીને કોઈપણ સાઇટ લોડ કરતા પહેલાં Chromium તમને ચેતવણી આપશે</translation>
<translation id="8095477191923518137">જ્યારે તમે બધી João Browser વિન્ડો બંધ કરશો, ત્યારે તમને મોટાભાગની સાઇટમાંથી સાઇન આઉટ કરવામાં આવશે, સિવાય કે જો તમે João Browserમાં સાઇન ઇન કરેલું હોય, તો તમારા Google એકાઉન્ટમાંથી સાઇન આઉટ કરવામાં આવશે નહીં. સાઇટને તમને યાદ રાખવાની મંજૂરી આપવા માટે, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">શોધ વિસ્તારના સૌથી ઉપર જમણા ખૂણે: જમણી બાજુ <ph name="RIGHT" />%, સૌથી ઉપર <ph name="TOP" />%</translation>
<translation id="3366305173356742781">તમારા એકાઉન્ટમાંનો Chromium ડેટા</translation>
<translation id="3234882977104294240">તમારા ફોન પર João Browser વડે તમારા પાસવર્ડનો ઉપયોગ કરો</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="2974199599420431595">વર્તમાન João Browser પ્રોફાઇલ પર સ્વિચ કરીએ?</translation>
<translation id="3412460710772753638">આ ડિવાઇસ પર Password Managerમાં</translation>
<translation id="3438772217992559640">'છબી વડે શોધ'ની સુવિધાનો ઉપયોગ કરીને આ ટૅબ શોધો</translation>
<translation id="8318147705317768982">તમારા ફોન પર João Browser વડે Safe Browsingમાં વધારેલી સુરક્ષા વિસ્તૃત કરો</translation>
<translation id="347392028839310978">João Browserને તમારું બનાવી રહ્યા છીએ...</translation>
<translation id="3474745554856756813">આ, <ph name="ITEMS_COUNT" /> આઇટમને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, Chromium માં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="5805833167703404998"><ph name="SHORTCUT" /> વડે એક João Browser પ્રોફાઇલથી બીજી João Browser પ્રોફાઇલ પર સ્વિચ કરી શકાય છે</translation>
<translation id="1835124883585653877">કૃપા કરીને બધી João Browser વિંડોઝ બંધ કરો અને ફરીથી પ્રયાસ કરો.</translation>
<translation id="7106246566966568195">તમારી વિન્ડો શેર કરવા માટે, સિસ્ટમના સેટિંગમાં João Browser માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો</translation>
<translation id="6017005873246021363"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે.  તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં João Browserમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="1146681170626381319">મોબાઇલ ડિવાઇસ પર João Browser બ્રાઉઝર ડાઉનલોડ કરવા માટેનો QR કોડ</translation>
<translation id="354621070532799440">રિમાઇન્ડર: Googleની શ્રેષ્ઠ સલામતી સુવિધાઓ તમારા ખિસ્સામાં</translation>
<translation id="2488701737291439763">તમારી સ્ક્રીન શેર કરવા માટે, સિસ્ટમના સેટિંગમાં João Browser માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો.</translation>
<translation id="3588112919289558122">Chromium દ્વારા ઓળખી ન શકાતી સાઇટ માટે વધારેલું સંરક્ષણ JavaScript ઑપ્ટિમાઇઝેશન બંધ કરે છે</translation>
<translation id="3597003331831379823">વધારેલા વિશેષાધિકારો સાથે સેટઅપ ચલાવવામાં નિષ્ફળ રહ્યાં. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">João Browserમાં સાઇન ઇન કરો</translation>
<translation id="5985252758124395804">આ વ્યક્તિનો બ્રાઉઝિંગ ડેટા આ ડિવાઇસમાંથી ડિલીટ કરવામાં આવશે. આ ડેટા પાછો મેળવવા માટે, João Browserમાં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{João Browser માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે.}=1{João Browser માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે. તમારી છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{João Browser માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{João Browser માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="3667616615096815454">ઇન્સ્ટૉલ કરી શકતા નથી, સર્વર માટે આ ઍપ્લિકેશન અજાણી છે.</translation>
<translation id="3675854891107786059">તમારા Google એકાઉન્ટમાંનો Chromiumનો બધો ડેટા એન્ક્રિપ્ટ કરવા માટે તમારા <ph name="BEGIN_LINK" />પોતાના પાસફ્રેઝ<ph name="END_LINK" />નો ઉપયોગ કરો. Google Payમાંથી ચુકવણી પદ્ધતિઓ અને સરનામા એન્ક્રિપ્ટ કરવામાં આવશે નહીં. Chromiumમાંથી બ્રાઉઝિંગ ઇતિહાસ સિંક થશે નહીં.</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{આ અપડેટ લાગુ કરવા માટે João Browser ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે}=1{આ અપડેટ લાગુ કરવા માટે João Browser ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે. તમારી છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{આ અપડેટ લાગુ કરવા માટે João Browser ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{આ અપડેટ લાગુ કરવા માટે João Browser ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="4134769722455445399">નવા João Browser &amp;ટૅબમાં લિંક ખોલો</translation>
<translation id="3728124580182886854">મનગમતું બનાવવા અને અન્ય હેતુઓ માટે, Chromium અને Googleની અન્ય સેવાઓ લિંક કરો</translation>
<translation id="3729187154190517324">"ટૅબ અને વધુ ઉમેરો" બટનનો ઉપયોગ કરીને એકથી વધુ ટૅબ, ફાઇલો અને ટૂલ ઉમેરીને તમારી શોધને વધુ ઊંડી બનાવો.</translation>
<translation id="655691042235349825">João Browser પ્રોફાઇલ મેનેજ કરો</translation>
<translation id="8494798931804571569">શા માટે João Browser અમુક ડાઉનલોડ કરેલી ફાઇલને બ્લૉક કરે છે તે જાણો</translation>
<translation id="379589255253486813">જો કંઈપણ માટે તમારા રિવ્યૂની જરૂર હોય, તો Chromium તમને જણાવશે</translation>
<translation id="3802055581630249637">તમે જે પેજની મુલાકાત લેવાની શક્યતા વધુ હોય, Chromium તેને પહેલેથી લોડ કરે છે, જેથી જ્યારે તમે તેમની મુલાકાત લો, ત્યારે તે વધુ ઝડપથી લોડ થઈ શકે</translation>
<translation id="3810973564298564668">મેનેજ કરો</translation>
<translation id="6945066279282141856">તમારા સાચવેલા પાસવર્ડનો ઉપયોગ કરવા માટે, QR કોડને ફૉલો કરો, iOS માટે João Browser ડાઉનલોડ કરો અને તમારા Google એકાઉન્ટમાં સાઇન ઇન કરો</translation>
<translation id="3846683726093018685">**સારાંશ આપો:** 30થી ઓછા શબ્દોવાળા એક વાક્યમાં, સ્ક્રીનશૉટમાં આપેલા કન્ટેન્ટના મુખ્ય વિષય અને તેના હેતુનું વર્ણન કરો.

          **પ્રશ્નો સૂચવો:** સ્ક્રીનશૉટને બહેતર રીતે સમજવા માટે વપરાશકર્તા પૂછી શકે તેવા 3-5 વિચારપ્રેરક પ્રશ્નોની બુલેટવાળી સૂચિ જનરેટ કરો. આ પ્રશ્નોમાં ઓછામાં ઓછો એક પ્રશ્ન એવો હોવો જોઈએ કે જે ખાસ કરીને કોઈ વિઝ્યુઅલ ઑબ્જેક્ટ, તેની ડિઝાઇન કે તેના પ્લેસમેન્ટ વિશે હોય.</translation>
<translation id="4996569675441627032"><ph name="PAGE_TITLE" /> - João Browser</translation>
<translation id="6008740052107737825">આ સાઇટ માટે João Browserને સ્થાનિક નેટવર્કની પરવાનગીની જરૂર છે</translation>
<translation id="3885770153807205175">ભાષા પિકર</translation>
<translation id="2390004682597453662">João Browserને કસ્ટમાઇઝ અને તેનું નિયંત્રણ કરો. તમારે ક્યાંક ધ્યાન આપવાની જરૂર છે - વિગતો માટે ક્લિક કરો.</translation>
<translation id="8262407643678629134">João Browser ને ખોલવા માટે તમારા નામને ક્લિક કરો અને બ્રાઉઝ કરવાનું પ્રારંભ કરો.</translation>
<translation id="3892148308691398805">ટેક્સ્ટ કૉપિ કરો</translation>
<translation id="2168201717554927204"><ph name="EXISTING_USER" /> આ João Browser પ્રોફાઇલમાં પહેલેથી સાઇન ઇન છે. તમારું બ્રાઉઝિંગ અલગ રાખવા, João Browser તમારા માટે તમારી અલગ પ્રોફાઇલ બનાવી શકે છે.</translation>
<translation id="1046732460303790107">આ એક્સ્ટેન્શન Chrome વેબ સ્ટોર પૉલિસીનું ઉલ્લંઘન કરે છે અને તે અસુરક્ષિત હોઈ શકે છે. તેને João Browserમાંથી કાઢી નાખો જેથી તે હવેથી તમારી વ્યક્તિગત માહિતી સહિત તમે મુલાકાત લો તે સાઇટ પરનો તમારો ડેટા જોઈ કે બદલી શકે નહીં.</translation>
<translation id="3941890832296813527">ઇન્સ્ટૉલ કરવામાં ભૂલ: ઇન્સ્ટૉલરની ફાઇલનું નામ અમાન્ય અથવા અનસપોર્ટેડ છે.</translation>
<translation id="3879366121647289622">João Browser પાસવર્ડની કૉપિ કરવાનો પ્રયાસ કરી રહ્યું છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="7332365758981378072">તમે તમારા Google એકાઉન્ટમાં સાચવેલા તમારા પાસવર્ડ, ચુકવણી પદ્ધતિઓ અને સરનામા આ ડિવાઇસમાંથી કાઢી નાખવામાં આવશે. João Browserમાં તેનો ફરીથી ઉપયોગ કરવા માટે, પાછું સાઇન ઇન કરો.</translation>
<translation id="395904275706073188">સંરક્ષિત પેજ વાંચી શકાતા નથી. કોઈ અલગ પેજ અજમાવી જુઓ.</translation>
<translation id="3962647064319009959">Chromiumની તમને સલામત રાખવાની રીત વિશે જાણો</translation>
<translation id="3967822245660637423">ડાઉનલોડ પૂર્ણ</translation>
<translation id="3971865010372729242">તમે જ્યારે ઍડ્રેસ બાર અથવા શોધ બૉક્સમાં ટાઇપ કરો છો, ત્યારે સૂચનો મેળવવા માટે Chromium તમે જે ટાઇપ કરો છો તેને તમારી સંસ્થાના શોધ, AI અને એજન્ટ ટૂલ પર મોકલે છે.</translation>
<translation id="3975724895399328945">Google Chrome for Testing વિશે</translation>
<translation id="3997429360543082038">ChromiumOS વિશે</translation>
<translation id="4010059961270896984">જ્યારે તમે કોઈ સાઇટની મુલાકાત લો, ત્યારે પ્રાઇવસી સર્વર મારફતે Chromium <ph name="BEGIN_LINK" />Google Safe Browsing<ph name="END_LINK" />ને તે સાઇટના URLનો વાંચવામાં મુશ્કેલ બનાવેલો ભાગ મોકલે છે, જે તમારા IP ઍડ્રેસને છુપાવે છે. જો સાઇટ પર કોઈ શંકાસ્પદ ઍક્ટિવિટી દેખાય, તો સંપૂર્ણ URLs અને પેજ કન્ટેન્ટના બિટ પણ મોકલવામાં આવે છે.</translation>
<translation id="4016217212818346953">Password Manager સાથે સુરક્ષિત રહો</translation>
<translation id="4019629340646866719"><ph name="BEGIN_LINK_LINUX_OSS" />Linux ડેવલપમેન્ટ એન્વાયરમેન્ટ<ph name="END_LINK_LINUX_OSS" />ની જેમ, ChromiumOSને વધારાના <ph name="BEGIN_LINK_CROS_OSS" />ઓપન સૉર્સ સૉફ્ટવેર<ph name="END_LINK_CROS_OSS" /> દ્વારા શક્ય બનાવવામાં આવ્યું છે.</translation>
<translation id="4022972681110646219">સ્ક્રીનનો અનુવાદ કરો</translation>
<translation id="4023601594785368013">મૂળ ભાષા: <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">કોઈપણ ઍપમાંથી લિંકને João Browserમાં ખોલો. વધુમાં, સરળ ઍક્સેસ માટે તે તમારા ટાસ્કબારમાં પિન કરવામાં આવે છે.</translation>
<translation id="4036079820698952681"><ph name="BEGIN_LINK" />વર્તમાન સેટિંગ<ph name="END_LINK" />ની જાણ કરીને Chromiumને બહેતર બનાવવામાં સહાય કરો</translation>
<translation id="4050175100176540509">નવીનતમ વર્ઝનમાં મહત્ત્વપૂર્ણ સુરક્ષા સુધારણાઓ અને નવી સુવિધાઓ ઉપલબ્ધ છે.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="615818333141511791">{COUNT,plural, =1{જ્યારે 1 મિનિટ સુધી João Browserનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે. બ્રાઉઝિંગ ડેટા ડિલીટ કરવામાં આવે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.}one{જ્યારે # મિનિટ સુધી João Browserનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે. બ્રાઉઝિંગ ડેટા ડિલીટ કરવામાં આવે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.}other{જ્યારે # મિનિટ સુધી João Browserનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે. બ્રાઉઝિંગ ડેટા ડિલીટ કરવામાં આવે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.}}</translation>
<translation id="4118474109249235144">Chromium છૂપો મોડ</translation>
<translation id="4122186850977583290">Chromium વિશે પેજ પર જાઓ</translation>
<translation id="9207280419664362385">તમારા બ્રાઉઝરને કોઈ નવો દેખાવ આપવા માટે João Browserને કસ્ટમાઇઝ કરો</translation>
<translation id="3719803995198923598">તમારા João Browserને કસ્ટમાઇઝ કરો</translation>
<translation id="4148957013307229264">ઇન્સ્ટોલ કરી રહ્યું છે...</translation>
<translation id="2954462321765112214"><ph name="PAGE_TITLE" /> - નેટવર્ક સાઇન ઇન - João Browser</translation>
<translation id="7812363663832111420">João Browser માટે શ્રેષ્ઠ એપ્લીકેશન્સ, રમતો, એક્સટેન્શન્સ અને થીમ્સ શોધો.</translation>
<translation id="69200600645763018">તમારા બધા કમ્પ્યૂટર પર આ એક્સ્ટેન્શન અને અન્ય ઘણું બધું મેળવવા માટે João Browserમાં સાઇન ઇન કરો</translation>
<translation id="7505863944027312744">તમારા માતાપિતાની પસંદગીઓ સાથે ઑનલાઇન વધુ સલામત રહેવા માટે, તમારી João Browser પ્રોફાઇલ પર સ્વિચ કરો, જેમાં તમે પહેલેથી <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન થયા છો</translation>
<translation id="4222932583846282852">રદ કરી રહ્યાં છીએ…</translation>
<translation id="4224210481850767180">ઇન્સ્ટૉલેશન રદ કરવામાં આવ્યું છે.</translation>
<translation id="8090594705972340646">તમારા João Browser ડેટાને આ એકાઉન્ટ સાથે લિંક કરીએ?</translation>
<translation id="4251772536351901305">સાઇટ પરથી માનક સંરક્ષણ કરતા વધુ ડેટા વિશ્લેષિત કરીને, Googleને પણ પહેલાંથી જાણ ન હોય તેવી ખતરનાક સાઇટ વિશે તમને ચેતવણી આપે છે. તમે Chromium ચેતવણીઓને છોડી દેવાનું પસંદ કરી શકો છો.</translation>
<translation id="5696119579094527589">João Browserમાંથી સાઇન આઉટ કરો</translation>
<translation id="4271805377592243930">Chromium સાથે સહાય મેળવો</translation>
<translation id="4281844954008187215">સેવાની શરતો</translation>
<translation id="1245307320228150348">અમઉલ્લેખિત ભૂલને કારણે ઇન્સ્ટોલેશન નિષ્ફળ થયું. જો João Browser હાલમાં ચાલી રહ્યું હોય, તો તેને બંધ કરો અને ફરી પ્રયાસ કરો.</translation>
<translation id="7405356088321579627">João Browserમાંથી પાસવર્ડની નિકાસ કરો</translation>
<translation id="4304713468139749426">પાસવર્ડ મેનેજર</translation>
<translation id="4334241893986177674">આ સ્ક્રીનશૉટ શોધો</translation>
<translation id="212570256141568951">જ્યારે Windows શરૂ થાય, ત્યારે João Browser લૉન્ચ કરો</translation>
<translation id="4400772909124543403">કોઈ અપડેટ ઉપલબ્ધ નથી</translation>
<translation id="7463042547966071103">છતાં પણ João Browserમાંથી બહાર નિકળવું છે?</translation>
<translation id="4413205837991854510">'છબી વડે શોધ' સુવિધા માટેનો શૉર્ટકટ હંમેશાં બતાવો</translation>
<translation id="4736206301215400753">João Browserને બૅકગ્રાઉન્ડમાં ચાલવા દો</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{João Browser તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે. <ph name="BEGIN_LINK" />સપોર્ટેડ એક્સ્ટેન્શન વિશે વધુ જાણો<ph name="END_LINK" />}one{João Browser તમને તેમને કાઢી નાખવાનો સુઝાવ આપે છે. <ph name="BEGIN_LINK" />સપોર્ટેડ એક્સ્ટેન્શન વિશે વધુ જાણો<ph name="END_LINK" />}other{João Browser તમને તેમને કાઢી નાખવાનો સુઝાવ આપે છે. <ph name="BEGIN_LINK" />સપોર્ટેડ એક્સ્ટેન્શન વિશે વધુ જાણો<ph name="END_LINK" />}}</translation>
<translation id="5305058100936019600">João Browser ને કસ્ટમાઇઝ અને નિયંત્રિત કરો</translation>
<translation id="4427306783828095590">વધારેલી સુરક્ષા ફિશિંગ અને માલવેરને બ્લૉક કરવામાં વધુ સહાયરૂપ થાય છે</translation>
<translation id="4434353761996769206">ઇન્સ્ટૉલરની ભૂલ <ph name="INSTALLER_ERROR" /></translation>
<translation id="3461955321878243607"><ph name="MANAGER" /> João Browserને મેનેજ કરે છે</translation>
<translation id="3379477508903866078">João Browser પ્રોફાઇલ ઉમેરો</translation>
<translation id="4447409407328223819">Chrome for Testing વિશે</translation>
<translation id="4074057296993529937">તમારા Google એકાઉન્ટમાં João Browserના ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે, તમારો પાસફ્રેઝ દાખલ કરો</translation>
<translation id="4493028449971051158">સ્ટાર્ટઅપ દરમિયાન ભૂલ: કૃપા કરીને ઇન્સ્ટૉલરને ઍડમિનિસ્ટ્રેટર તરીકે ચલાવો.</translation>
<translation id="4501471624619070934">ઇન્સ્ટૉલેશન નિષ્ફળ ગયું કારણ કે આ દેશમાં ઍક્સેસ પ્રતિબંધિત છે.</translation>
<translation id="8624811527667906941">આ એક્સ્ટેન્શન દ્વારા તેની ડેટા એકત્રિત કરવાની અને તેનો ઉપયોગ કરવાની રીત જેવી પ્રાઇવસી પ્રૅક્ટિસ પબ્લિશ કરવામાં આવી નથી. João Browser તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે.</translation>
<translation id="5571435860030744559">João Browser પર આપનું સ્વાગત છે; નવી બ્રાઉઝર વિન્ડો ખોલી છે</translation>
<translation id="8132016625974854930">તમારી આસપાસના વિસ્તારો અને તમારા હાથને ટ્રૅક કરવા માટે, João Browserને પરવાનગીની જરૂર છે</translation>
<translation id="6599071882590417739">તમે પહેલેથી João Browserની અન્ય પ્રોફાઇલમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન થયા છો</translation>
<translation id="4548534452171747496">Chromium દ્વારા પેજ પહેલેથી લોડ કરવામાં આવે છે, જેને કારણે બ્રાઉઝ કરવાની અને શોધવાની ક્રિયા વધુ ઝડપી બને છે. <ph name="BEGIN_LINK" />પહેલેથી લોડ કરેલા પેજ વિશે વધુ જાણો<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">જ્યારે તમે તમને હાનિકારક લાગતી સાઇટની જાણ કરો, ત્યારે દરેક જણ માટે ઑનલાઇન સલામતી બહેતર બનાવો.</translation>
<translation id="202208802191333704">João Browser દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે તમે Safe Browsingની સુવિધા બંધ કરેલી છે અને ફાઇલની ચકાસણી કરી શકાતી નથી</translation>
<translation id="3128308674776200516">તમારા ફોન પર João Browser વડે Google Lens અજમાવી જુઓ</translation>
<translation id="4594305310729380060">આ ડિવાઇસ પર Password Managerમાં</translation>
<translation id="7653380076752216509">João Browser ઍપ્લિકેશનો</translation>
<translation id="4598116752460667024">સૂચિમાંથી કોઈપણ પ્રક્રિયા શોધો.</translation>
<translation id="4613863813562375431">ChromiumOSનું વર્ઝન</translation>
<translation id="4621240073146040695">અપ ટૂ ડેટ થવામાં છે! અપડેટ સમાપ્ત કરવા માટે Chromium ને ફરીથી લોંચ કરો.</translation>
<translation id="1497446027991908251">João Browserના V8 એન્જિન વડે સાઇટની ગતિ વધારે છે પરંતુ João Browserને અટૅક સામે થોડું ઓછું પ્રતિરોધક બનાવે છે</translation>
<translation id="7523749920868634278">ચેતવણી: એક્સ્ટેન્શનને તમારો બ્રાઉઝિંગ ઇતિહાસ રેકોર્ડ કરવાથી João Browser અટકાવી શકતું નથી. છૂપા મોડમાં આ એક્સ્ટેન્શનને બંધ કરવા માટે, આ વિકલ્પની પસંદગી નાપસંદ કરો.</translation>
<translation id="4673151026126227699">જો તમે Chromiumના વપરાશના રિપોર્ટ પણ શેર કરતા હો, તો તે રિપોર્ટમાં તમે મુલાકાત લો છો તે URLs શામેલ હોય છે</translation>
<translation id="4673710618874938871"><ph name="USER_NAME" />, મેમ્બરશિપ તરીકે સાઇન ઇન કર્યું. એકાઉન્ટ મેનૂ ખોલો</translation>
<translation id="6608258642372806522">બીજા કમ્પ્યુટર (<ph name="HOST_NAME" />) પર પ્રોફાઇલ બીજી João Browser પ્રક્રિયા (<ph name="PROCESS_ID" />) દ્વારા ઉપયોગમાં હોય એવું લાગે છે. João Browser એ પ્રોફાઇલને લૉક કરી છે જેથી તે દૂષિત ન થઈ જાય. જો તમને ખાતરી છે કે કોઈ અન્ય પ્રક્રિયાઓ આ પ્રોફાઇલનો ઉપયોગ કરી રહી નથી, તો તમે પ્રોફાઇલને અનલૉક કરી અને João Browser ને ફરીથી લોંચ કરી શકો છો.</translation>
<translation id="4680828127924988555">ઇન્સ્ટૉલેશનની પ્રક્રિયા રદ કરો</translation>
<translation id="3912572071294857936">João Browserનો તમારો અમુક ડેટા હજી સુધી તમારા Google એકાઉન્ટમાં સાચવવામાં આવ્યો નથી. સાઇન આઉટ કરતા પહેલાં થોડી મિનિટ રાહ જોવાનો પ્રયાસ કરી જુઓ. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ડિલીટ કરવામાં આવશે.</translation>
<translation id="1077152188344040592">જ્યારે તમે સાઇન ઇન કર્યું હોય, ત્યારે તમે João Browserમાં તમારા Google એકાઉન્ટમાંથી તમારા પાસવર્ડ અને વધુનો ઉપયોગ કરી શકો છો. <ph name="SHORTCUT" /> તમારા Googleની સેવાઓના સેટિંગ બદલી શકે છે.</translation>
<translation id="5729536702149847030">કોઈએ આ કોમ્પ્યુટર પર પહેલા <ph name="ACCOUNT_EMAIL_LAST" /> તરીકે João Browserમાં સાઇન ઇન કર્યું છે. તમારી માહિતી અલગ રાખવા માટે કૃપા કરીને નવો João Browser વપરાશકર્તા બનાવો.</translation>
<translation id="4724676981607797757">અનસપોર્ટેડ પ્રોટોકૉલ ભૂલને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="6273241729694500032">છતાં પણ João Browser બંધ કરવું છે?</translation>
<translation id="3239680024825449390">João Browser માટેનું એક વિશિષ્ટ સુરક્ષા અપડેટ હમણાં જ લાગુ કરવામાં આવ્યું. હવે ફરી શરૂ કરો અને અમે તમારાં ટૅબની પુનઃસ્થાપના કરીશું.</translation>
<translation id="4771701986670315895">તમે તાજેતરમાં આ સાઇટની મુલાકાત લીધી નથી. Chromium દ્વારા <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />ની અને વધુ <ph name="COUNT" /> પરવાનગી કાઢી નાખવામાં આવી.</translation>
<translation id="1908292729364083164">જો João Browserમાં Gemini ખુલ્લું હોય, તો નવા ટૅબ બનાવતી વખતે બાજુની પૅનલ ખુલ્લી રહે છે</translation>
<translation id="479167709087336770">આ પણ Google Searchમાં જે જોડણી તપાસનારનો ઉપયોગ થાય છે તેનો જ ઉપયોગ કરે છે. તમે બ્રાઉઝરમાં ટાઇપ કરો છો તે ટેક્સ્ટ Googleને મોકલવામાં આવે છે. તમે સેટિંગમાં આ વર્તણૂકને હંમેશાં બદલી શકો છો.</translation>
<translation id="189382710647501724">એકાઉન્ટ વગર João Browserનો ઉપયોગ કરો</translation>
<translation id="4456919965836032212">mDNS ટ્રાફિકને મંજૂરી આપવા João Browser માટે ઇનબાઉન્ડ નિયમ.</translation>
<translation id="3486986778673504636">&amp;João Browser અપડેટ કરવા માટે, ફરીથી લૉન્ચ કરો</translation>
<translation id="4918086044614829423">સ્વીકારો</translation>
<translation id="4918844574251943176">છબી કૉપિ કરી</translation>
<translation id="1571932028747131277">João Browser બૅકગ્રાઉન્ડ મોડમાં છે.</translation>
<translation id="7612124006067933008">João Browserમાં સાઇન ઇન કરવાનો સંવાદ બંધ કરવા માટે ક્લિક કરો</translation>
<translation id="2598788273876744576">João Browser પ્રોફાઇલ વડે, તમે તમારી બધી વસ્તુઓ João Browser પર અલગ-અલગ રાખી શકો છો. મિત્રો અને કુટુંબ માટે પ્રોફાઇલ બનાવો અથવા તેને ઑફિસ અને મનોરંજન વચ્ચે વિભાજિત કરો.</translation>
<translation id="2115498792600385171">અતિથિઓ કંઈપણ પાછળ છોડ્યાં વિના João Browser નો ઉપયોગ કરી શકે છે.</translation>
<translation id="6870732303439257966">João Browserમાં તમારું એકાઉન્ટ</translation>
<translation id="4366792189726044065">સ્વયંને João Browser માં ઉમેરો</translation>
<translation id="504699503110800016">ઓવરફ્લો મેનૂ ખોલો</translation>
<translation id="4340125167559705618">તમારા <ph name="DEVICE_TYPE" /> પર João Browser વડે Googleની તમારી બધી મનપસંદ સેવાઓને ઍક્સેસ કરો</translation>
<translation id="4916697359431064123">João Browserને તમારા હાથ ટ્રૅક કરવા માટે પરવાનગીની જરૂર છે</translation>
<translation id="5141988424377517949">તમે તાજેતરમાં આ સાઇટની મુલાકાત લીધી નથી. Chromium દ્વારા <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />ની પરવાનગીઓ કાઢી નાખવામાં આવી.</translation>
<translation id="5174969993834422967">તમે સામાન્ય રીતે નોટિફિકેશનને બ્લૉક કરો છો. આ સાઇટ તમને સૂચિત કરી શકે તે માટે, તમારા લોકેશન બારના જમણા ખૂણે દેખાતા નોટિફિકેશનના આઇકન પર ક્લિક કરો.</translation>
<translation id="5174983315706567306">પર્યાપ્ત ડિસ્ક સ્પેસ નથી.</translation>
<translation id="961070648267203077">João Browser એકાઉન્ટને પુન:પ્રમાણીકરણની જરૂર છે</translation>
<translation id="69363826605946518">iOS પર João Browser વડે તમે જ્યાંથી છોડ્યું હતું, ત્યાંથી શરૂ કરો.</translation>
<translation id="471694954923709047">João Browserમાંથી સાઇન આઉટ કરો</translation>
<translation id="5234764350956374838">કાઢી નાખો</translation>
<translation id="5782956358171235578">João Browser Inco&amp;gnito વિન્ડોમાં લિંક ખોલો</translation>
<translation id="903712329052383264">મુસાફરીમાં પાસવર્ડ સાચવવા માટે João Browser ઍપ મેળવો</translation>
<translation id="5277894862589591112">તમારા ફેરફારો લાગુ કરવા માટે, Chromiumને ફરી લૉન્ચ કરો</translation>
<translation id="5286907366254680517">ભાળ મળી</translation>
<translation id="5593827909938092728">João Browser ઍપ મેળવો</translation>
<translation id="5294316920224716406">છૂપા મોડમાં બ્રાઉઝ કરતી વખતે, અસુરક્ષિત કનેક્શનનો ઉપયોગ કરીને સાઇટ લોડ કરતા પહેલાં Chromium તમને ચેતવણી આપશે</translation>
<translation id="1066981078513393795">João Browser અપડેટર આંતરિક સેવા</translation>
<translation id="5324450571874973775">Chromiumમાં Geminiની અન્ય સુવિધાઓની સાથે તેનો ઉપયોગ કરો</translation>
<translation id="5346389065299425353">એકથી વધુ ટૅબ, ફાઇલો અને ટૂલ ઉમેરીને તમારી શોધને વધુ ઊંડી બનાવો</translation>
<translation id="1884203704972162365">આ દસ્તાવેજનો ઝડપી ઓવરવ્યૂ મેળવો અને João Browserમાં Gemini વડે પ્રશ્નો પૂછો</translation>
<translation id="5352264705793813212">Chromiumને તમારા રિવ્યૂ માટે કેટલાક સલામતી સંબંધિત સુઝાવો મળ્યા છે</translation>
<translation id="4819697639570429319">અન્ય João Browser પ્રોફાઇલ</translation>
<translation id="7878591304929138776">તમારા એકાઉન્ટની સાઇન ઇન વિગતો જૂની હોવાને કારણે ChromiumOS તમારા Google એકાઉન્ટમાં João Browser ડેટા સાચવી શક્યું નથી</translation>
<translation id="5249614051186670898">તમે મેનેજ કરેલા એકાઉન્ટ સાથે સાઇન ઇન કરી રહ્યાં છો અને તમારી João Browser પ્રોફાઇલ પર ઍડમિનને એનું નિયંત્રણ આપી રહ્યાં છો. તમારો João Browser ડેટા, જેમ કે ઍપ, બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજા સેટિંગ, કાયમ માટે <ph name="USER_NAME" />થી જોડાયેલા રહેશે. તમે Google એકાઉન્ટ ડૅશબોર્ડથી આ ડેટાને ડિલીટ કરી શકશો, પરંતુ તમે આ ડેટાને બીજા એકાઉન્ટ સાથે સાંકળી શકશો નહીં. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">વધારાનો કોડ: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">મનગમતું બનાવવાની સુવિધા મેળવવા માટે, Chromiumમાં વેબ અને ઍપ ઍક્ટિવિટી ઉમેરો</translation>
<translation id="108952623091824942">João Browser શા માટે અમુક ફાઇલો બ્લૉક કરે છે, તે જાણો</translation>
<translation id="5386450000063123300">Chromium અપડેટ થઈ રહ્યું છે (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Chromiumમાં સાઇન-ઇનની મંજૂરી આપો</translation>
<translation id="1265086181910844216">João Browser માંથી દૂર કરો</translation>
<translation id="1500700851187484222">પર્ફોર્મન્સ ઘટાડે છે પરંતુ João Browserને અટૅક સામે વધુ પ્રતિરોધક બનાવે છે</translation>
<translation id="6665657403278704382">João Browserને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે સેટ કરો</translation>
<translation id="3520901681432894293"><ph name="PAGE_TITLE" /> - João Browser બીટા</translation>
<translation id="5994273394215159270">{NUM_TABS,plural, =1{João Browserનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યું હોય એવા ટૅબને થોભાવી દો}one{João Browserનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યું હોય એવા ટૅબને થોભાવી દો}other{João Browserનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યાં હોય એવા ટૅબને થોભાવી દો}}</translation>
<translation id="646791423998269453">આ Linux વિતરણ સિસ્ટમ પર João Browser હવે સપોર્ટ કરતું ન હોવાથી કદાચ તે યોગ્ય રીતે કાર્ય ન કરે</translation>
<translation id="7249139852479053716">João Browser દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું છે, કારણ કે આ ફાઇલ તમારા વ્યક્તિગત અને સોશિયલ નેટવર્ક એકાઉન્ટને નુકસાન પહોંચાડી શકે છે</translation>
<translation id="478612683981218420">કૃપા કરીને João Browser, નવીનતમ સિસ્ટમ અપડેટ્સ ઇન્સ્ટોલ કરે ત્યાં સુધી રાહ જુઓ.</translation>
<translation id="3466187211963597724">João Browser પાસવર્ડમાં ફેરફાર કરવાનો પ્રયાસ કરે છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="3133978491361824131">João Browser વડે મુસાફરીમાં Google Drive અને YouTube જેવી તમારી મનપસંદ ઍપ સાથે વિક્ષેપરહિત કામ કરો.</translation>
<translation id="5524890928877629608">શોધ વિસ્તારના સૌથી ઉપર ડાબા ખૂણે: ડાબી બાજુ <ph name="LEFT" />%, સૌથી ઉપર <ph name="TOP" />%</translation>
<translation id="5527463683072221100">Chromiumમાં PDFs ખોલો</translation>
<translation id="5536164441519929134">આ ટૅબ વિશે<ph name="LINE_BREAK" />પૂછો</translation>
<translation id="3902123582863904748">સુરક્ષા માટે, જ્યારે તમે પહેલી વાર કોઈ સાઇટની મુલાકાત લો, ત્યારે João Browser JavaScript ઑપ્ટિમાઇઝેશન બંધ કરે છે.

જો આ પેજ અપેક્ષા મુજબ કામ ન કરતું હોય, તો ઑપ્ટિમાઇઝેશનને મંજૂરી આપવાનો પ્રયાસ કરો.</translation>
<translation id="5924481826213021755">Macના મેનૂ બારમાં João Browserમાં Gemini બતાવો અને કીબોર્ડ શૉર્ટકટ ચાલુ કરો</translation>
<translation id="4988760628116707723"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં João Browserમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને <ph name="DEVICE" />માંથી તમારી સાચવેલી માહિતી અને બીજું ઘણું મળશે.</translation>
<translation id="5579324208890605088">સ્ટાર્ટઅપ દરમિયાન ભૂલ: કૃપા કરીને ઇન્સ્ટૉલરને નિયમિત વપરાશકર્તા તરીકે ચલાવો, ઍડમિનિસ્ટ્રેટર તરીકે નહીં.</translation>
<translation id="697769674160644707">ડિફૉલ્ટ તરીકે João Browserનો ઉપયોગ કરો અને તેને પિન કરો</translation>
<translation id="5596627076506792578">વધુ વિકલ્પો</translation>
<translation id="5605834417512968703">'છબી વડે શોધ' સુવિધા વડે શોધવા માટે કંઈપણ પસંદ કરો અથવા 'છબી વડે શોધ' સુવિધામાંથી બહાર નીકળવા માટે Escape કી દબાવો</translation>
<translation id="5618818588972826921">'છબી વડે શોધ' સુવિધા વડે શોધવા માટે કોઈપણ ટેક્સ્ટ અથવા છબી પસંદ કરો અથવા 'છબી વડે શોધ' સુવિધામાંથી બહાર નીકળવા માટે Escape દબાવો</translation>
<translation id="2497422928854452258">{0,plural, =0{João Browser અપડેટ ઉપલબ્ધ છે}=1{João Browser અપડેટ ઉપલબ્ધ છે}one{João Browser અપડેટ # દિવસ માટે ઉપલબ્ધ છે}other{João Browser અપડેટ # દિવસ માટે ઉપલબ્ધ છે}}</translation>
<translation id="5643865575100044307">જ્યારે તમે Chromium બંધ કરો, ત્યારે હંમેશાં તમારા ડિવાઇસમાંથી સાઇટનો ડેટા ડિલીટ કરો</translation>
<translation id="620465883043431255">કૃપા કરીને હવે João Browser ફરી શરૂ કરો</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">આ ભાષામાં Chromium બતાવો</translation>
<translation id="569897634095159764">ઇન્ટરનેટ સાથે કનેક્ટ કરી શકતા નથી. પ્રૉક્સી સર્વરને પ્રમાણીકરણની જરૂર છે.</translation>
<translation id="5768371961535086509">નિષ્ક્રિય ટૅબમાંની મેમરી Chromium દ્વારા ઉપયોગમાં લેવામાં આવે છે. આને કારણે Chromium ટૅબ અને અન્ય ઍપને કમ્પ્યૂટરના વધુ સંસાધનો ફાળવીને પોતાને ઝડપી રાખી શકે છે. જ્યારે તમે તમારા નિષ્ક્રિય ટૅબ પર પાછા ફરો, ત્યારે તે ફરીથી ઑટોમૅટિક રીતે સક્રિય થાય છે. <ph name="BEGIN_LINK" />મેમરી સેવર વિશે વધુ જાણો<ph name="END_LINK" /></translation>
<translation id="8866372822266732235">જો તમે તમારો પાસફ્રેઝ ભૂલી ગયા હો અથવા આ સેટિંગ બદલવા માગતા હો, તો તમારા એકાઉન્ટમાંનો João Browserનો ડેટા <ph name="SETTINGS_LINK" /></translation>
<translation id="2106070764285625641">João Browserને કસ્ટમાઇઝ અને તેનું નિયંત્રણ કરો. João Browserને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે સેટ કરો.</translation>
<translation id="9077878413488413377">João Browserને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે સેટ કરીને તમારા પાસવર્ડ, બુકમાર્ક અને ઇતિહાસને બધા ડિવાઇસ પર સંપૂર્ણ રીતે સિંક કરેલા રાખો.</translation>
<translation id="5809516625706423866">ઇન્ટરનેટ સાથે કનેક્ટ કરી શકતા નથી. HTTP 401 અનધિકૃત. કૃપા કરીને તમારું પ્રૉક્સી કન્ફિગ્યુરેશન ચેક કરો.</translation>
<translation id="614221876503883218">João Browserના V8 એન્જિન વડે સાઇટની ગતિ વધારે છે પરંતુ João Browserને અટૅક સામે થોડું ઓછું પ્રતિરોધક બનાવે છે. આ સેટિંગ બંધ છે.</translation>
<translation id="8788365803279840995">તમારા Google એકાઉન્ટમાં João Browserના ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે, João Browser અપડેટ કરો</translation>
<translation id="5824893331272123205">આ પૅનલ લોડ કરી શકાઇ નથી, ફરી પ્રયાસ કરો</translation>
<translation id="5805760187441013922">João Browser માં સ્વાગત છે</translation>
<translation id="5867606647614813312">Chromiumની સૌથી સશક્ત સુરક્ષા પ્રદાન કરવા માટે વધારાની સુવિધાઓ ચાલુ કરે છે</translation>
<translation id="5871205389137001634">'છબી વડે શોધ' સુવિધામાંથી બહાર નીકળવા માટે ક્લિક કરો</translation>
<translation id="8367098380158627809">João Browserને આ આઇટમમાં માલવેર હોવાનું જાણવા મળ્યું છે:</translation>
<translation id="5889361821821684993">Chromium નિયમિત રીતે ચેક કરીને એ વાતની ખાતરી કરતું રહે છે કે તમારા બ્રાઉઝરના સેટિંગ સૌથી સલામત છે. જો કોઈ બાબતનો રિવ્યૂ કરવો જરૂરી હશે તો અમે તમને તેની જાણ કરીશું.</translation>
<translation id="5895138241574237353">પુનઃપ્રારંભ કરો</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - નેટવર્ક સાઇન ઇન</translation>
<translation id="5924017743176219022">ઇન્ટરનેટ સાથે કનેક્ટ કરી રહ્યાં છીએ...</translation>
<translation id="7627350220326904504">ચાલો, તમારું João Browser તૈયાર કરીએ</translation>
<translation id="5941711191222866238">નાનું કરો</translation>
<translation id="8680863040348007215">તમારા બધા ડિવાઇસ પર આ બુકમાર્ક અને બીજું ઘણું મેળવવા માટે, João Browserમાં સાઇન ઇન કરો</translation>
<translation id="2008232276062354182">João Browserને તમારા માટે અનુકૂળ બનાવો</translation>
<translation id="5960071705175224773">કોઈ અજાણી ઍપ દ્વારા તમારા સેટિંગ બદલવામાં આવ્યા હતા</translation>
<translation id="5977420883993828287">પિન કરેલી છે! ટૂલબારમાંથી સંદર્ભિત ટાસ્કનો ફરીથી ઉપયોગ કરો</translation>
<translation id="5889362640603897718">{COUNT,plural, =1{જ્યારે 1 મિનિટ સુધી João Browserનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે.}one{જ્યારે # મિનિટ સુધી João Browserનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે.}other{જ્યારે # મિનિટ સુધી João Browserનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે.}}</translation>
<translation id="4971097497342057998">સમન્વયનને પ્રારંભ કરવા માટે João Browser ને અપડેટ કરો</translation>
<translation id="5990360079535151574">ટૂલબાર પરના "સંદર્ભિત ટાસ્ક" બટન પરથી, તમે બ્રાઉઝ કરતી વખતે પ્રશ્નો પૂછવા માટે સંદર્ભિત ટાસ્ક ફરીથી ખોલી શકો છો</translation>
<translation id="6003112304606738118">ડાઉનલોડ કરી રહ્યાં છીએ… <ph name="HOURS" /> કલાક બાકી છે</translation>
<translation id="6009821354356307391">ફૉલોઅપ પ્રશ્ન પૂછો</translation>
<translation id="6040143037577758943">બંધ કરો</translation>
<translation id="2100398097168307292">જ્યારે તમે તમારા <ph name="DEVICE_TYPE" /> પર João Browser ઍપનો ઉપયોગ કરો, ત્યારે ઑનલાઇન શૉપિંગનો વધુ લાભ મેળવો</translation>
<translation id="6058380562449900225">તમારા ડેટાને સુરક્ષિત કરવા માટે, Chromiumને તમે તાજેતરમાં મુલાકાત લીધી ન હોય તેવી સાઇટમાંથી પરવાનગીઓ દૂર કરવા દો. નોટિફિકેશન બંધ કરવામાં આવશે નહીં.</translation>
<translation id="4735359759698689867">અને João Browserમાં ખોલો</translation>
<translation id="6069027071882229820">છબી તરીકે કૉપિ કરો</translation>
<translation id="2274675514456642321"><ph name="EXTENSION_NAME" />ને João Browserમાં ઉમેરવામાં આવ્યું છે</translation>
<translation id="147381942282490529">João Browserને કસ્ટમાઇઝ અને નિયંત્રિત કરો. અપડેટ ઉપલબ્ધ છે.</translation>
<translation id="8775234022739879423">ચાલુ • આ એક્સ્ટેન્શન ક્યાંથી આવે છે તેની ચકાસણી João Browser કરી શકતું નથી</translation>
<translation id="6634821567165410381">João Browserમાં તમારું એકાઉન્ટ</translation>
<translation id="4398707227122702993">João Browserના ટૂલબારમાં ઍક્સેસની વિનંતીઓ બતાવવા માટે એક્સ્ટેન્શનને મંજૂરી આપો</translation>
<translation id="5370941509199989624"><ph name="FILE_NAME" /> જોખમી છે, તેથી João Browser એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="5119118887583954582">João Browser ટૂંક સમયમાં જ બંધ થશે અને ડેટા ડિલીટ કરશે</translation>
<translation id="576637711620229618">તમે અહીં એક João Browser પ્રોફાઇલથી બીજી João Browser પ્રોફાઇલ પર સ્વિચ કરી શકો છો</translation>
<translation id="615103374448673771">જો તમે કુકીને મંજૂરી આપો, તો Chromium પહેલેથી લોડ કરતી વખતે તેનો ઉપયોગ કરી શકે છે</translation>
<translation id="6165508094623778733">વધુ જાણો</translation>
<translation id="3738215896821824918">તમારા એકાઉન્ટમાંનો João Browser ડેટા સાફ કરો</translation>
<translation id="2145111683361496197">આ ફાઇલ જોખમી હોઈ શકે છે<ph name="LINE_BREAK" />જો તમે પાસવર્ડ પ્રદાન કરો છો, તો João Browser તમારા માટે આ ડાઉનલોડને તપાસી શકે છે. ફાઇલ વિશેની માહિતી Google Safe Browsingને મોકલવામાં આવે છે, પરંતુ ફાઇલનું કન્ટેન્ટ અને પાસવર્ડ તમારા ડિવાઇસમાં જ રહે છે.</translation>
<translation id="6182736845697986886">કોઈ અપડેટ સર્વરની આંતરિક ભૂલને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="6050294746023477088">ખાતરી કરો કે તમે તમારા <ph name="TARGET_DEVICE_NAME" /> પર João Browserમાં સાઇન ઇન કર્યું છે અને પછી ફરીથી મોકલવાનો પ્રયાસ કરો.</translation>
<translation id="3395167674702947885">આ કમ્પ્યુટર પર પહેલાંથી જ João Browserનું સૌથી તાજેતરનું વર્ઝન છે. જો સૉફ્ટવેર કાર્ય કરી રહ્યું નથી, તો કૃપા કરીને João Browserને અનઇન્સ્ટૉલ કરો અને ફરીથી પ્રયાસ કરો.</translation>
<translation id="4384214545531685923">{0,plural, =0{João Browser હમણાં ફરીથી લૉન્ચ થશે}=1{João Browser 1 સેકન્ડમાં ફરીથી લૉન્ચ થશે}one{João Browser # સેકન્ડમાં ફરીથી લૉન્ચ થશે}other{João Browser # સેકન્ડમાં ફરીથી લૉન્ચ થશે}}</translation>
<translation id="5880255774989397049">ફાઇલો ડાઉનલોડ કરવા માટે, João Browserને સ્ટોરેજના ઍક્સેસની પરવાનગીની જરૂર છે</translation>
<translation id="6245734527075554892">URLsને Chromiumમાં સ્ટોર કરેલી અસુરક્ષિત સાઇટની સૂચિ સાથે સરખાવીને ચેક કરે છે</translation>
<translation id="1959823478027154444">João Browserને ડિફૉલ્ટ બ્રાઉઝર બનાવો</translation>
<translation id="6248988683584659830">શોધ સેટિંગ</translation>
<translation id="9191635841540101343">તમારા ફોન પર João Browser ઍપ વડે મુસાફરીમાં Googleની શ્રેષ્ઠ સલામતી સંબંધિત સુવિધાઓ મેળવો</translation>
<translation id="538350741885862188">João Browserમાંથી સાઇન આઉટ કરીએ?</translation>
<translation id="161121067714522736">આ ટૅબ વધારાના સંસાધનોનો ઉપયોગ કરી રહ્યાં છે. તમારા પર્ફોર્મન્સને બહેતર બનાવવા માટે, João Browserને તેમને નિષ્ક્રિય કરવા દો.</translation>
<translation id="2095090272560293574">તમારી João Browser પ્રોફાઇલને કસ્ટમાઇઝ કરો</translation>
<translation id="6290827346642914212">તમારી Chromium પ્રોફાઇલને નામ આપો</translation>
<translation id="6472525517562723285">કોઈ એક્સ્ટેન્શન ઇચ્છે છે કે તમે João Browserમાં સાઇન ઇન કરો</translation>
<translation id="2069878195899746465"><ph name="FILE_NAME" /> જોખમી હોઈ શકે છે, તેથી João Browser એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="1283909912629029170">João Browser તમારા કૅમેરાનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="323902744000752306">João Browser પર બીજી ક્રિયા ચાલુ છે. કૃપા કરીને પછીથી ફરી પ્રયાસ કરો.</translation>
<translation id="1292164882596462877">હવે તમારા Google એકાઉન્ટ સાથે અને શેર કરેલ કમ્પ્યુટર પર João Browser નો ઉપયોગ કરવો વધુ સરળ છે.</translation>
<translation id="6411450594978516531">João Browserને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે સેટ કરીને તમે જાણતા હો, તમને ગમતી હોય અને તમને વિશ્વાસપાત્ર હોય એવી સુવિધાઓનો સરળતાથી ઍક્સેસ મેળવો.</translation>
<translation id="3344301749774719950">João Browser શૉર્ટકટ</translation>
<translation id="8395825163097750991">João Browser દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે સામાન્ય રીતે આ ફાઇલ ડાઉનલોડ કરવામાં આવતી નથી અને તે જોખમી હોઈ શકે છે</translation>
<translation id="7683737657427846440">શું તમે ખરેખર તમે João Browser ને અનઇન્સ્ટૉલ કરવા માંગો છો?</translation>
<translation id="6375219077595103062">Password Managerમાં શૉર્ટકટ ઉમેરો</translation>
<translation id="6388799252195623474">મને આમાં મદદ કરો</translation>
<translation id="6966523531135953867">ચાલુ રાખવા માટે, João Browserમાં <ph name="EMAIL" /> તરીકે સાઇન ઇન કરો. આનાથી ખાતરી થાય છે કે તમને તમારી સંસ્થાની પૉલિસીઓ મળી ગઈ છે.</translation>
<translation id="5146608242127807773">કમ્પ્યૂટરની સ્ક્રીનમાં João Browserનો લોગો.</translation>
<translation id="6361476216650509195">João Browser એ એક એવું વેબ બ્રાઉઝર છે જે પ્રકાશની ગતિએ વેબપૃષ્ઠો અને એપ્લિકેશંસને ચલાવે છે. તે ઝડપી, સ્થિર અને ઉપયોગમાં સરળ છે. Google João Browser માં નિર્મિત મૉલવેર અને ફિશીંગ સુરક્ષા સાથે વેબને વધુ સુરક્ષિત રૂપે બ્રાઉઝ કરો.</translation>
<translation id="7864687914956920860">તમે હંમેશાં તમારા Google એકાઉન્ટમાં João Browserના ડેટાનો ઉપયોગ કરી શકો અને તેને સાચવી શકો તેની ખાતરી કરવા માટે, આ તમે જ છો તેની ચકાસણી કરો</translation>
<translation id="1160920197193662978">João Browser વધુ ઝડપથી કામ કરે છે અને JavaScriptનો ઉપયોગ કરતી સુવિધાઓ ડિઝાઇન પ્રમાણે કામ કરવી જોઈએ</translation>
<translation id="6436260184216827876">'છબી વડે શોધ' સુવિધા ઉપલબ્ધ નથી. થોડા સમય પછી ફરી પ્રયાસ કરો.</translation>
<translation id="6442900851116057561">ChromiumOS ફરી શરૂ કરો</translation>
<translation id="6443470774889161065">તમે જે પેજની મુલાકાત લેશો તેવી શક્યતા હોય, Chromium તેવા વધુ પેજને પણ પહેલેથી લોડ કરે છે, જેથી જ્યારે તમે તેમની મુલાકાત લો, ત્યારે તે વધુ ઝડપથી લોડ થાય</translation>
<translation id="3730564967922511625">કિંમતો ટ્રૅક કરવા અને કોઈપણ સાઇટ પર કિંમતમાં ઘટાડો થાય ત્યારે અલર્ટ મેળવવા માટે તમારા ફોન પર João Browser ડાઉનલોડ કરો</translation>
<translation id="3753019081686930624">બંધ • આ એક્સ્ટેન્શન ક્યાંથી આવે છે તેની ચકાસણી João Browser કરી શકતું નથી</translation>
<translation id="5444641426058108434">João Browser પ્રોફાઇલમાં આપનું સ્વાગત છે</translation>
<translation id="5103470775766355478">આગલી વખતે જ્યારે તમે તમારા <ph name="DEVICE_TYPE" /> પર João Browser ખોલો, ત્યારે તમને ટૅબના ગ્રૂપનો ઉપયોગ કરવા માટેનો પ્રૉમ્પ્ટ દેખાશે.</translation>
<translation id="9087231386723579740">João Browserમાંથી એકાઉન્ટ કાઢી નાખો</translation>
<translation id="4984395209542302039">જ્યારે તમે João Browser શરૂ કરો ત્યારે કયું પેજ બતાવવામાં આવે તે તેનું પણ નિયંત્રણ કરે છે.</translation>
<translation id="648319183876919572">Safe Browsingમાં વધારેલી સુરક્ષા તમને જોખમી વેબસાઇટ અને ડાઉનલોડ સામે વધુ સુરક્ષા આપે છે</translation>
<translation id="1524792685704191751">João Browser ને અનઇન્સ્ટૉલ કરો</translation>
<translation id="6637504267182028286">શૉર્ટકટ João Browserમાં ખુલે છે</translation>
<translation id="1478247638436966279">જ્યારે તમારી સંસ્થા <ph name="TIMEOUT_DURATION" /> માટે João Browserનો ઉપયોગ ન કરે ત્યારે તેને બંધ કરે છે. બ્રાઉઝિંગ ડેટા ડિલીટ કરવામાં આવ્યો હતો. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.</translation>
<translation id="1311233187253046133">દરેક પ્રોફાઇલ બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજી ઘણી બાબતો જેવી તેની પોતાની João Browser માહિતી ધરાવે છે</translation>
<translation id="6563921047760808519"><ph name="BEGIN_LINK" />Chromium તમારા ડેટાને કેવી રીતે ખાનગી રાખે છે<ph name="END_LINK" /> તે વિશે વધુ જાણો</translation>
<translation id="1643078533228697915">આ સેટિંગના ફેરફારો એકવાર João Browser ફરી શરૂ થાય પછી લાગુ થશે.</translation>
<translation id="1918630514771863338">João Browserના મુખ્ય મેનૂમાં એક્સ્ટેન્શન પર ક્લિક કરીને તમારા એક્સ્ટેન્શન મેનેજ કરો.</translation>
<translation id="4229328298978407243">તમે બીજી João Browser પ્રોફાઇલમાંથી પાસવર્ડ જુઓ પર સ્વિચ કરી શકો છો</translation>
<translation id="7717252965531997879">મુસાફરીમાં શ્રેષ્ઠ AI ટૂલ સાથે રાખવા માટે João Browser ઍપનો ઉપયોગ કરો</translation>
<translation id="6570579332384693436">જોડણીની ભૂલો સુધારવા માટે, Chromium તમે ટેક્સ્ટ ફીલ્ડમાં ટાઇપ કરો તે ટેક્સ્ટ Googleને મોકલે છે</translation>
<translation id="5374627817618267090">João Browserની નોટિફિકેશનની સેટિંગ પર જાઓ</translation>
<translation id="6600016381025017075">આ પેજ પર કંઈપણ શોધો</translation>
<translation id="264335610358256197">તમારા ફેરફારો તમે આગલી વખતે João Browser ફરીથી લોંચ કરશો ત્યારે પ્રભાવમાં આવશે.</translation>
<translation id="2657584510687441826">હવે જ્યારે Windows શરૂ થાય ત્યારે João Browser લૉન્ચ થાય છે, જેથી તમે તરત જ બ્રાઉઝ કરવાનું શરૂ કરી શકો. તમે સેટિંગમાં જઈને આને બંધ કરી શકો છો.</translation>
<translation id="5482413402708094860">તમે જ્યાંથી છોડ્યું હતું ત્યાંથી ચાલુ કરો: João Browserએ તમારા છેલ્લા સત્રના ટૅબ રિસ્ટોર કર્યા છે. તમે આને આમાં બંધ કરી શકો છો</translation>
<translation id="5022765692226673603">તમારા આસપાસનો 3D નકશો બનાવવા માટે, João Browserને કૅમેરાની પરવાનગીની જરૂર છે</translation>
<translation id="6669284030132180248">જો તમે બુકમાર્કને તમારા Google એકાઉન્ટમાં પણ સાચવશો, તો તમે પ્રોડક્ટની કિંમતો Chromiumમાં ટ્રૅક કરી શકશો તેમજ જ્યારે પણ કિંમતમાં ઘટાડો થાય ત્યારે નોટિફિકેશન મેળવશો</translation>
<translation id="6676384891291319759">ઇંટરનેટ ઍક્સેસ કરો</translation>
<translation id="668175097507315160">સાઇન ઇનમાં થયેલી ભૂલને કારણે ChromiumOS તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="3982573751008180181">João Browserમાંથી આ ઍપનો ડેટા કાઢી નાખો</translation>
<translation id="5613723096388999601">આ સાઇટ માટે João Browserને માઇક્રોફોનની પરવાનગીની જરૂર છે</translation>
<translation id="6712881677154121168">ડાઉનલોડ કરવામાં ભૂલ: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="9190188975825967506">તમારી પ્રોફાઇલનો ઉપયોગ કરી શકાતો નથી કારણ કે તે João Browserના નવા વર્ઝન તરફથી છે.

કેટલીક સુવિધાઓ ઉપલબ્ધ થઈ શકે છે. કૃપા કરીને અલગ પ્રોફાઇલ ડિરેક્ટરીનો ઉલ્લેખ કરો અથવા João Browserના નવા વર્ઝનનો ઉપયોગ કરો.</translation>
<translation id="6729124504294600478">મનગમતું બનાવવાની અને અન્ય સુવિધાઓ મેળવવા માટે, Chromiumનો વેબ અને ઍપ ઍક્ટિવિટી અને લિંક કરેલી Google સેવાઓમાં સમાવેશ કરો</translation>
<translation id="6957684879859415418">João Browser, તમારા કમ્પ્યુટર પર તમામ વપરાશકર્તાઓ માટે પહેલાંથી ઇન્સ્ટૉલ કરેલ છે.</translation>
<translation id="4411262692912917677">તમારા બધા ડિવાઇસ પર તમારા બુકમાર્ક અને બીજું ઘણું મેળવવા માટે, João Browserમાં સાઇન ઇન કરો. તમે સાઇન ઇન કરો તે પછી આ બુકમાર્ક તમારા Google એકાઉન્ટમાં સાચવવામાં આવશે.</translation>
<translation id="6064901610880747710">João Browserના V8 એન્જિન વડે સાઇટની ગતિ વધારે છે પરંતુ João Browserને અટૅક સામે થોડું ઓછું પ્રતિરોધક બનાવે છે. આ સેટિંગ ચાલુ છે.</translation>
<translation id="4530735110472079436">{count,plural, =1{João Browserનો તમારો કેટલોક ડેટા હજી સુધી તમારા Google એકાઉન્ટમાં સાચવવામાં આવ્યો નથી. સાઇન આઉટ કરતા પહેલાં થોડી મિનિટ રાહ જોવાનો પ્રયાસ કરી જુઓ. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા (1 આઇટમ) ડિલીટ કરવામાં આવશે.}one{João Browserનો તમારો કેટલોક ડેટા હજી સુધી તમારા Google એકાઉન્ટમાં સાચવવામાં આવ્યો નથી. સાઇન આઉટ કરતા પહેલાં થોડી મિનિટ રાહ જોવાનો પ્રયાસ કરી જુઓ. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ({count} આઇટમ) ડિલીટ કરવામાં આવશે.}other{João Browserનો તમારો કેટલોક ડેટા હજી સુધી તમારા Google એકાઉન્ટમાં સાચવવામાં આવ્યો નથી. સાઇન આઉટ કરતા પહેલાં થોડી મિનિટ રાહ જોવાનો પ્રયાસ કરી જુઓ. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ({count} આઇટમ) ડિલીટ કરવામાં આવશે.}}</translation>
<translation id="9176853308971176490">João Browser આ ફાઇલને સ્કૅન કરવાનો સુઝાવ આપે છે, કારણ કે તે જોખમકારક હોઈ શકે છે.</translation>
<translation id="6779406956731413166">ChromiumOSને વધારાના <ph name="BEGIN_LINK_CROS_OSS" />ઓપન સૉર્સ સૉફ્ટવેર<ph name="END_LINK_CROS_OSS" /> દ્વારા શક્ય બનાવવામાં આવ્યું છે.</translation>
<translation id="6831043979455480757">અનુવાદ કરો</translation>
<translation id="6412488898785231889">João Browser વડે તમે તમારા પાસવર્ડમાં ક્યારેક ચેડાં થાય તો તેના વિશે જાણકારી મેળવી શકો છો</translation>
<translation id="684888714667046800">ઇન્ટરનેટ સાથે કનેક્ટ કરી શકતા નથી. જો તમે કોઈ ફાયરવૉલનો ઉપયોગ કરતા હો, તો કૃપા કરીને ખાતરી કરો કે <ph name="PRODUCT_EXE_NAME" /> વ્હાઇટલિસ્ટમાં છે.</translation>
<translation id="6750640664545078431">João Browser - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">ચાલુ રાખવા માટે Tab કી દબાવો</translation>
<translation id="6862030660799253820">'છબી વડે શોધ' સુવિધા વડે આ છબી શોધો</translation>
<translation id="4260365383290377081">João Browserને "<ph name="EXTENSION_NAME" />"માં માલવેર હોવાનું જાણવા મળ્યું છે</translation>
<translation id="6877155553248388166">શોધ વિસ્તારના સૌથી નીચે જમણા ખૂણે: જમણી બાજુ <ph name="RIGHT" />%, સૌથી નીચે <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">કૉપિ કરો</translation>
<translation id="6898028264630240901">તમે બ્રાઉઝ કરો ત્યારે પ્રશ્નો પૂછવા માટે, સંદર્ભિત ટાસ્કને પિન કરી શકો છો</translation>
<translation id="6985817498888719203">João Browserને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે સેટ કરો અને તેને તમારા ટાસ્કબાર પર પિન કરો</translation>
<translation id="5277424858974213042">João Browser પ્રોફાઇલ મેનેજ કરો</translation>
<translation id="2726137364317931343">આ ઍક્શન કરવાથી:
          <ph name="LINE_BREAKS" />
            • તમારું સ્ટાર્ટઅપ પેજ, નવું ટૅબ પેજ, શોધ એન્જિન અને પિન કરેલા ટૅબ રીસેટ થઈ જશે
            <ph name="LINE_BREAK" />
            • એક્સ્ટેન્શન બંધ થઈ જશે
            <ph name="LINE_BREAK" />
            • કુકી અને સાઇટનો અન્ય હંગામી ડેટા ડિલીટ થઈ જશે
            <ph name="LINE_BREAK" />
            • João Browser શૉર્ટકટ રીસેટ થઈ જશે
            <ph name="LINE_BREAKS" />
            બુકમાર્ક, ઇતિહાસ અને સાચવેલા પાસવર્ડને કોઈ અસર થશે નહીં.</translation>
<translation id="2901988969322822496">તમે João Browserની <ph name="BOOKMARK_LIMIT" /> બુકમાર્કની મર્યાદાએ પહોંચી ગયા છો, તેથી તમારા અમુક બુકમાર્ક હજી સુધી તમારા Google એકાઉન્ટમાં સાચવવામાં આવ્યા નથી.

જ્યાં સુધી તમે અમુક બુકમાર્ક ડિલીટ ન કરો, ત્યાં સુધી નવા બુકમાર્ક તમારા એકાઉન્ટમાં સાચવી શકાશે નહીં. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો ન સચવાયેલા બુકમાર્ક ડિલીટ કરવામાં આવશે.</translation>
<translation id="6203410920314218280">João Browser છુ&amp;પી વિંડોમાં લિંક ખોલો</translation>
<translation id="6965382102122355670">બરાબર, સમજાઇ ગયું</translation>
<translation id="6985329841647292029">ChromiumOSની શરતો</translation>
<translation id="8064285182627814996">તમારા <ph name="ACCOUNT_EMAIL" /> એકાઉન્ટમાં João Browser ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે તમારો પાસફ્રેઝ દાખલ કરો</translation>
<translation id="7011190694940573312">ઑપરેટિંગ સિસ્ટમનું આ વર્ઝન સપોર્ટેડ ન હોવાને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="7024536598735240744">અનપૅક કરવામાં ભૂલ: <ph name="UNPACK_ERROR" />.</translation>
<translation id="181803036615530330">João Browser કસ્ટમાઇઝ કરો</translation>
<translation id="7047386856539490735">શું આ પરિણામો ઉપયોગી છે?</translation>
<translation id="2478245051737698828">João Browser ને અપડેટ કરો</translation>
<translation id="452909342278940733">જો છબીમાં ઉપયોગી વર્ણન ન હોય, તો João Browser તમને વર્ણન પૂરું પાડવાનો પ્રયાસ કરશે. વર્ણન બનાવવા માટે, Googleને છબીઓ મોકલવામાં આવે છે.</translation>
<translation id="8606769615526968368">જ્યારે તમે તમારા <ph name="DEVICE_TYPE" /> પર João Browser ઍપનો ઉપયોગ કરો, ત્યારે AIનું સામર્થ્ય મેળવો</translation>
<translation id="2061960765882453684">તમારા ફોન પર João Browser ઍપ વડે તમારા પાસવર્ડ, ટૅબ અને બીજું ઘણું મુસાફરીમાં સાથે રાખો</translation>
<translation id="7141270731789036260">Chrome for Testing કસ્ટમાઇઝ કરો</translation>
<translation id="7147227333672430807">જ્યારે પણ તમે મેસેજ, દસ્તાવેજો અને અન્ય ઍપમાંની લિંક પર ક્લિક કરો, ત્યારે તમે Chromiumનો ઉપયોગ કરી શકો છો</translation>
<translation id="6949173677980969871">João Browserમાંથી <ph name="EXTENSION_NAME" /> કાઢી નાખો</translation>
<translation id="3556355753960287061">જ્યારે તમારી સંસ્થા <ph name="TIMEOUT_DURATION" /> માટે João Browser ડેટાનો ઉપયોગ ન કરે ત્યારે તેને ડિલીટ કરે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.</translation>
<translation id="8689006320829658442">આ સાઇટ માટે João Browserને કૅમેરાની પરવાનગીની જરૂર છે</translation>
<translation id="7501884108538572227">João Browser લૉન્ચ કરી શકાયું નથી. ફરી પ્રયાસ કરો.</translation>
<translation id="5484563502710761706">Gemini in João Browser વડે તમે જ્યાં પણ હો, ત્યાંથી કંઈપણ પૂછો</translation>
<translation id="3823264355161086552">João Browserને કોઈપણ સમયે ઝડપથી ઍક્સેસ કરવા માટે, તેને તમારા ડૉકમાં રાખો</translation>
<translation id="9153902741226700840">જ્યારે પણ તમે મેસેજ, દસ્તાવેજો અને અન્ય ઍપમાંની લિંક પર ક્લિક કરો, ત્યારે João Browserનો ઉપયોગ કરો</translation>
<translation id="7216228761061470870">જ્યારે તમે ડેસ્કટૉપ પર 'છબી વડે શોધ' સુવિધાનો ઉપયોગ કરો છો, ત્યારે PDFs સહિત પેજનું શીર્ષક, URL અને કન્ટેન્ટ સર્વરને મોકલવામાં આવે છે.</translation>
<translation id="7950844619283784703">કાર્ય વ્યવસ્થાપક - João Browser</translation>
<translation id="133513825972536773"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં João Browserમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને તમારા બધા ડિવાઇસ પર તમારી સાચવેલી માહિતી તેમજ બીજું પણ ઘણું મળશે.</translation>
<translation id="4558982617284733740">ઝટપટ બ્રાઉઝિંગ શરૂ કરો: હવે Windows શરૂ થાય ત્યારે João Browser લૉન્ચ થઈ શકે છે.</translation>
<translation id="7274695763216404502">પિન કરેલી છે! ટૂલબારમાંથી ફરીથી 'છબી વડે શોધ' સુવિધાનો ઉપયોગ કરો</translation>
<translation id="7288567540154601580">ટૅબ અને એક્સ્ટેન્શન</translation>
<translation id="5494571279964989269">{NUM_EXTENSIONS,plural, =1{João Browser તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે}one{João Browser તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે}other{João Browser તેમને કાઢી નાખવાનો સુઝાવ તમને આપે છે}}</translation>
<translation id="2269053214123323740">João Browserમાં સિસ્ટમ ઑડિયો શેર કરવા માટે, સિસ્ટમના સેટિંગ ખોલો અને 'માત્ર સિસ્ટમ ઑડિયો રેકોર્ડિંગ'ને મંજૂરી આપો. ત્યાર પછી તમારે João Browser ફરી શરૂ કરવું જરૂરી રહેશે.</translation>
<translation id="731795002583552498">Chromium ને અપડેટ કરી રહ્યું છે</translation>
<translation id="9065168747010082551">તમારી પસંદગીઓ ફાઇલ દૂષિત અથવા અમાન્ય છે.

João Browser તમારા સેટિંગને રિકવર શકતું નથી.</translation>
<translation id="7324051657739063017">તમે બ્રાઉઝ કરો ત્યારે પ્રશ્નો પૂછવા માટે, તમે સંદર્ભિત ટાસ્કને ફરીથી ખોલી શકો છો</translation>
<translation id="4159250197688136733">તમારું વેબ, બુકમાર્ક અને અન્ય João Browser સામગ્રી અહીં હોય છે.</translation>
<translation id="7347827960336370838">તમારો પાસફ્રેઝ ધરાવતી કોઈ વ્યક્તિ જ તમારો એન્ક્રિપ્ટેડ ડેટા વાંચી શકે છે. Googleને પાસફ્રેઝ મોકલવામાં આવતો નથી કે તેમાં સ્ટોર કરવામાં આવતો નથી. જો તમે તમારો પાસફ્રેઝ ભૂલી ગયા હો અથવા આ સેટિંગ બદલવા માગતા હો, તો તમારે <ph name="BEGIN_LINK" />તમારા એકાઉન્ટમાંનો Chromium ડેટા ડિલીટ કરવો<ph name="END_LINK" /> જરૂરી રહેશે.</translation>
<translation id="1062903713270840396">તમારા સિસ્ટમ વ્યવસ્થાપકે <ph name="TARGET_URL_HOSTNAME" />ને ઍક્સેસ કરવા João Browserને <ph name="ALTERNATIVE_BROWSER_NAME" /> ખોલવા માટે ગોઠવેલું છે.</translation>
<translation id="7352651011704765696">કંઈક ખોટું થયું હતું</translation>
<translation id="5817362738974335084">João Browserની ભાવિ અપડેટ મેળવવા માટે, તમને macOS 13 કે તે પછીનું વર્ઝન જોઈશે. આ કમ્પ્યૂટર macOS 12નો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="7376384068949534168">તમે તાજેતરમાં આ સાઇટની મુલાકાત લીધી નથી. Chromium દ્વારા <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />ની પરવાનગીઓ કાઢી નાખવામાં આવી.</translation>
<translation id="73786666777299047">Chrome વેબ દુકાન ખોલો</translation>
<translation id="5724625487458697703">સિસ્ટમ ટ્રેમાં João Browserમાં Gemini બતાવો</translation>
<translation id="7401687852903179959">'છબી વડે શોધ'ની સુવિધાનો ઉપયોગ કરીને આ વીડિયો શોધો</translation>
<translation id="1088684725931971005">João Browser હવે તમારું ડિફૉલ્ટ બ્રાઉઝર છે</translation>
<translation id="7479848806300971661">તમે જ્યાંથી છોડ્યું હતું ત્યાંથી ચાલુ કરો: João Browser તમે જ્યારે ફરી શરૂ કરો છો ત્યારે દરેક વખતે તમારા ટૅબ રિસ્ટોર કરે છે. આને બંધ કરવા માટે, આના પર જાઓ</translation>
<translation id="1258077876605261365">João Browserમાં પાસવર્ડની આયાત કરો</translation>
<translation id="5293062713751091377">1. નીચે <ph name="BUTTON_LABEL" /> ક્લિક કરો
2. તમારા Windows સેટિંગમાં <ph name="BUTTON_2" /> પર ક્લિક કરો
3. ઝડપી ઍક્સેસ માટે João Browserને તમારા ટાસ્કબાર પર પિન કરવા માટે Windows નોટિફિકેશનમાં <ph name="BUTTON_3" /> પર ક્લિક કરો</translation>
<translation id="1941496545060769345"><ph name="PAGE_TITLE" /> - João Browser Dev</translation>
<translation id="7450541714075000668">ટેક્સ્ટ કૉપિ કરી</translation>
<translation id="7458892263350425044">તમારા માઇક્રોફોનનો ઉપયોગ કરવા માટે, <ph name="BEGIN_LINK" />સિસ્ટમના સેટિંગ<ph name="END_LINK" />માં જઈને Chromiumને ઍક્સેસ આપો</translation>
<translation id="5422859338435319909">João Browserની ભાવિ અપડેટ મેળવવા માટે, તમારે Windows 10 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યુટર Windows 7નો ઉપયોગ કરે છે.</translation>
<translation id="7467949745582939695">Chromium ફરીથી લૉન્ચ કરીએ?</translation>
<translation id="7707324976708178089">હાલમાં ચાલી રહ્યું છે તેના જેવું સમાન João Browser વર્ઝન ઇન્સ્ટૉલ કરી શકાતું નથી. કૃપા કરીને João Browserને બંધ કરો અને ફરી પ્રયાસ કરો.</translation>
<translation id="7510190804000607802">રિમાઇન્ડર: Googleની શ્રેષ્ઠ સુવિધાઓ હવે તમારા ખિસ્સામાં</translation>
<translation id="751935028865900641">સાઇટ અપેક્ષા મુજબ કામ કરે તેમ બની શકે છે. જો તમે Chromiumમાં સાઇન ઇન કર્યું હોય, તો જ્યારે તમે તમારા Google એકાઉન્ટ સિવાયની બધી Chromium વિન્ડો બંધ કરશો, ત્યારે તમે મોટાભાગની સાઇટમાંથી સાઇન આઉટ થઈ જશો.</translation>
<translation id="5325102834460669866">{0,plural, =1{João Browser 1 મિનિટમાં ફરીથી લૉન્ચ થશે}one{João Browser # મિનિટમાં ફરીથી લૉન્ચ થશે}other{João Browser # મિનિટમાં ફરીથી લૉન્ચ થશે}}</translation>
<translation id="7565444033145385702">તમારા ડેટાને સુરક્ષિત કરવા માટે, Chromiumને તમે તાજેતરમાં મુલાકાત લીધી ન હોય તેવી સાઇટમાંથી પરવાનગીઓ દૂર કરવા દો.</translation>
<translation id="8099958128052689767">ઝટપટ બ્રાઉઝિંગ શરૂ કરવા માટે João Browser ઑટોમૅટિક રીતે લૉન્ચ કરો.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ઇન્સ્ટૉલર</translation>
<translation id="7125257608567714221">João Browser તમારા કૅમેરા અને માઇક્રોફોનનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="227045421902171569">João Browser હવે પહેલાંથી બહેતર બન્યું છે</translation>
<translation id="5356567285381070312">João Browserમાં હવે તમારા માટે વધુ સુવિધાઓ ઉપલબ્ધ છે</translation>
<translation id="7624307931717240213">અમે આ સેવામાં સુધારણા કરવા માટે માહિતીનો ઉપયોગ કરીએ છીએ. પ્રાઇવસી પૉલિસી અને સેવાની શરતો જુઓ.</translation>
<translation id="7649070708921625228">સહાય</translation>
<translation id="5714374331629713291">João Browser ઍપ મેળવો</translation>
<translation id="7658239707568436148">રદ કરો</translation>
<translation id="549378870470819535">João Browser તમારું ડિફૉલ્ટ બ્રાઉઝર નથી</translation>
<translation id="6574348346278803862">તમારા બધા ડિવાઇસ પર João Browserને સિંક કરો અને મનગમતું બનાવો</translation>
<translation id="7699779824407626136">Chromium અપડેટ</translation>
<translation id="3304080024230377341">João Browser પર તમારું કાર્ય સુરક્ષિત છે</translation>
<translation id="7716950018788545737">કામ સમાપ્ત થયું/થયા.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME" /> માટે સિસ્ટમ ટ્રેસ કરવાની સેવાઓ પ્રદાન કરે છે. જો આ સેવા બંધ હોય, તો બ્રાઉઝર દ્વારા બનાવવામાં આવેલા પર્ફોર્મન્સ ટ્રેસમાં સમગ્ર સિસ્ટમ પરની ઇવેન્ટ જેમ કે સંદર્ભ સ્વિચ અને તૈયાર થ્રેડની ઇવેન્ટ શામેલ કરવામાં આવશે નહીં.</translation>
<translation id="7745317241717453663">આ તમારા બ્રાઉઝિંગ ડેટાને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, Chromium માં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="7747138024166251722">ઇન્સ્ટૉલર અસ્થાયી ડિરેક્ટરી બનાવી શક્યું નથી. કૃપા કરીને ખાલી ડિસ્ક સ્પેસ માટે અને સૉફ્ટવેર ઇન્સ્ટૉલ કરવાની પરવાનગી માટે તપાસો.</translation>
<translation id="4713120944298974980">João Browserમાં શોધો</translation>
<translation id="5804390944809171853">João Browserના ડિફૉલ્ટ સેટિંગ પર રીસેટ કરો</translation>
<translation id="6930487390575519812">João Browser પર તમારા કાર્યને સુરક્ષિત રાખવા માટે, જ્યારે તમે João Browserમાં સાઇન ઇન કરેલું હોય, ત્યારે તમારી સંસ્થા અમુક માહિતી જોઈ અથવા મેનેજ કરી શકશે.</translation>
<translation id="5214761769821670245">João Browserને ડિફૉલ્ટ તરીકે સેટ કરો અને તેને ટાસ્કબાર પર પિન કરો</translation>
<translation id="1294697217796985566">João Browserને વધુ ઝડપી બનાવો</translation>
<translation id="1278345486417353853"><ph name="PAGE_TITLE" /> - João Browser Canary</translation>
<translation id="7803986347287457849">તમારા ઇન્ટરનેટ ટ્રાફિકનો ઍક્સેસ ધરાવતા લોકો માટે, તમે કઈ સાઇટની મુલાકાત લો છો તે જોવાનું વધુ મુશ્કેલ બનાવો. Chromium દ્વારા DNS (ડોમેન નેમ સિસ્ટમ)માં સાઇટનું IP ઍડ્રેસ જોવા માટે સુરક્ષિત કનેક્શનનો ઉપયોગ કરવામાં આવે છે.</translation>
<translation id="7810005234485217901">તમે સરળ ઍક્સેસ માટે 'છબી વડે શોધ' સુવિધાને પિન કરી શકો છો</translation>
<translation id="489728561211958943">આ એકાઉન્ટ સાથેની João Browser પ્રોફાઇલ પહેલેથી જ આ ડિવાઇસ પર અસ્તિત્વમાં છે</translation>
<translation id="7845233973568007926">ઇન્સ્ટૉલ કરવા બદલ આભાર. <ph name="BUNDLE_NAME" />નો ઉપયોગ કરતા પહેલાં તમારે તમારું કમ્પ્યુટર ફરી શરૂ કરવું આવશ્યક છે.</translation>
<translation id="5294768452950207882">João Browserની બહારથી તમારું શોધ એન્જિન બદલવામાં આવ્યું હતું. તમારી સુરક્ષા માટે, João Browser તેને ફરી તેના ઑરિજિનલ ડિફૉલ્ટ સેટિંગ પર રીસેટ કરે છે. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3244974069468656925">João Browserને નવો દેખાવ આપવા માટે તેને કસ્ટમાઇઝ કરો</translation>
<translation id="7859018312476869945">જ્યારે તમે ઍડ્રેસ બાર અથવા શોધ બૉક્સમાં ટાઇપ કરો છો, ત્યારે બહેતર સૂચનો મેળવવા માટે Chromium તમે જે ટાઇપ કરો છો તેને તમારા ડિફૉલ્ટ શોધ એન્જિનને મોકલે છે. આ સુવિધા છૂપા મોડમાં કામ કરતી નથી.</translation>
<translation id="6517519572778941051">João Browser નવીનતમ વર્ઝન પર અપડેટ ન થઈ શક્યું, તેથી તમે નવી સુવિધાઓ અને સુરક્ષાના સુધારા ચૂકી રહ્યા છો.</translation>
<translation id="7872446069773932638">ડાઉનલોડ કરી રહ્યાં છીએ… <ph name="SECONDS" /> સેકન્ડ બાકી છે</translation>
<translation id="7873537467422636035">જો તમે તમારો પાસફ્રેઝ ભૂલી ગયા હો અથવા આ સેટિંગ બદલવા માગતા હો, તો <ph name="BEGIN_LINK" />તમારા એકાઉન્ટમાંનો Chromium ડેટા ડિલીટ કરો<ph name="END_LINK" /></translation>
<translation id="1722038268139386345">જ્યારે પણ તમને Geminiની જરૂર પડે, ત્યારે તેને João Browserમાં ઝડપથી ખોલો</translation>
<translation id="8344320926817290924">João Browserને તમારા ડિફૉલ્ટ તરીકે સેટ કરો</translation>
<translation id="7934340546140346950">જ્યારે શક્ય હોય ત્યારે Chromium અસુરક્ષિત કનેક્શનને ઑટોમૅટિક રીતે HTTPS પર અપગ્રેડ કરે છે</translation>
<translation id="3755057387338907970">તમે João Browser માં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કર્યું હતું. ફરીથી સાઇન ઇન કરવા માટે કૃપા કરીને એ જ એકાઉન્ટનો ઉપયોગ કરો.</translation>
<translation id="929903348843569380"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં João Browserમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને તમારા બધા ડિવાઇસ પર તમારા બુકમાર્ક તેમજ બીજું ઘણું મળશે.</translation>
<translation id="7975919845073681630">આ Google Chrome નું દ્વિતીય ઇન્સ્ટૉલેશન છે અને આને તમારું ડિફૉલ્ટ બ્રાઉઝર બનાવી શકાતું નથી.</translation>
<translation id="8905411496853397218">અજાણ્યા સ્રોતો પરના એક્સ્ટેન્શન, ઍપ અને થીમ તમારા ડિવાઇસને નુકસાન પહોંચાડી શકે છે. João Browser તેમને <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> પરથી જ ઇન્સ્ટૉલ કરવાનો સુઝાવ આપે છે</translation>
<translation id="6306672714476596428">તમારા <ph name="DEVICE_TYPE" /> પર João Browser ઍપ વડે Googleનો વધુમાં વધુ લાભ મેળવો</translation>
<translation id="8004582292198964060">બ્રાઉઝર</translation>
<translation id="8010081455002666927">ઑટોમેટિક રીતે ભાષા ઓળખો</translation>
<translation id="2172829664765531568">એકવાર João Browserને ઍક્સેસ મળે, તે પછી વેબસાઇટ તમારી પાસે ઍક્સેસ માગી શકશે.</translation>
<translation id="74641100973032765">João Browserને કોઈપણ સમયે ઝડપથી ઍક્સેસ કરવા માટે, તેને તમારા ટાસ્કબારમાં પિન કરો</translation>
<translation id="80471789339884597">ઇન્સ્ટૉલ કરવા બદલ આભાર. તમારે <ph name="BUNDLE_NAME" />નો ઉપયોગ કરતા પહેલાં તમારા બધા બ્રાઉઝર ફરી શરૂ કરવા આવશ્યક છે.</translation>
<translation id="8054112667659782652">'છબી વડે શોધ' સુવિધા માટેનો શૉર્ટકટ હંમેશાં બતાવો</translation>
<translation id="8069447462453318634">"ટૂલબાર પર પિન કરો" પસંદ કરો</translation>
<translation id="5039671129725402518">ઍપ માટે બૅકગ્રાઉન્ડમાં João Browser ચલાવવાનું બંધ કરો</translation>
<translation id="80790299200510644">છબી વડે શોધ</translation>
<translation id="8086881907087796310">તમારું કમ્પ્યૂટર, હાર્ડવેરની ઓછામાં ઓછી આવશ્યકતાઓ પૂર્ણ ન કરી શકવાને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome for Testing</translation>
<translation id="2430877582155731716">આ સાઇટ માટે João Browserને સ્થાનની પરવાનગીની જરૂર છે</translation>
<translation id="8298045348217323">આગલી વખતે જ્યારે તમે તમારા <ph name="DEVICE_TYPE" /> પર João Browser ખોલો, ત્યારે તમને કિંમત ટ્રૅક કરવાના અલર્ટ ચાલુ કરવા માટેનો પ્રૉમ્પ્ટ દેખાશે.</translation>
<translation id="3827347991254458074">તમારા ફોન પર João Browser ઍપ વડે તમને રુચિ હોય તેવી આઇટમ પર કિંમતમાં ઘટાડાના અલર્ટ મેળવો</translation>
<translation id="8118331347066725040">'Lens વડે શોધો' માટે પ્રતિસાદ મોકલો</translation>
<translation id="2580039965224265556">João Browserને કસ્ટમાઇઝ કરો</translation>
<translation id="8133124826068723441">તમારા ડોમેન પર સિંકની સુવિધા ઉપલબ્ધ ન હોવાને કારણે ChromiumOS તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="813913629614996137">પ્રારંભ કરી રહ્યું છે...</translation>
<translation id="7940955011992997426">કીબોર્ડ શૉર્ટકટ વડે João Browserમાં Gemini ખોલો.</translation>
<translation id="7560319627203819845">João Browserની વધારાની સેવાની શરતો</translation>
<translation id="7133741820744999589">આ ફાઇલ જોખમી છે, તેથી João Browser એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="8177472873527554730">પેજમાં કન્ટેન્ટ શોધી શકાતું નથી</translation>
<translation id="8200109504272824693">તમારા <ph name="USER_EMAIL" /> એકાઉન્ટમાં Chromium ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે તમારો પાસફ્રેઝ દાખલ કરો</translation>
<translation id="820759916613250543">'છબી વડે શોધ'ની સુવિધાનો ઉપયોગ કરીને આ છબી શોધો</translation>
<translation id="8221491193165283816">તમે સામાન્ય રીતે નોટિફિકેશનને બ્લૉક કરો છો. આ સાઇટને તમને નોટિફિકેશન આપવાની મંજૂરી આપવા માટે, અહીં ક્લિક કરો.</translation>
<translation id="8223363452568144035">તમારા કૅમેરાનો ઉપયોગ કરવા માટે, <ph name="BEGIN_LINK" />સિસ્ટમના સેટિંગ<ph name="END_LINK" />માં જઈને Chromiumને ઍક્સેસ આપો</translation>
<translation id="8132864687089402359">João Browser એ ચકાસણી કરી શકતું નથી કે આ એક્સ્ટેન્શન ક્યાંથી આવ્યું છે અને તે કદાચ અસલામત હોઈ શકે છે. તેને João Browserમાંથી કાઢી નાખો, જેથી તે હવેથી વ્યક્તિગત માહિતી સહિત તમે મુલાકાત લો છો તે સાઇટ પરનો તમારો ડેટા જોઈ કે બદલી શકે નહીં.</translation>
<translation id="7600652022483599804">જો છબીમાં ઉપયોગી વર્ણન ન હોય, તો João Browser તમને વર્ણન પૂરું પાડવાનો પ્રયાસ કરશે. વર્ણન બનાવવા માટે, Googleને છબીઓ મોકલવામાં આવે છે. તમે આને કોઈપણ સમયે સેટિંગમાં જઈને બંધ કરી શકો છો.</translation>
<translation id="8703735741562140394">નવી પ્રોફાઇલમાં João Browserમાં સાઇન ઇન કરીએ?</translation>
<translation id="2830039647655087365"><ph name="EXISTING_USER" /> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં João Browserમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કરો. તમને <ph name="DEVICE" />માંથી પણ તમારા પાસવર્ડ અને બીજું ઘણું મળશે.</translation>
<translation id="1802935470126307750">સિસ્ટમ ટ્રેમાં João Browserમાં Gemini બતાવો અને કીબોર્ડ શૉર્ટકટ ચાલુ કરો</translation>
<translation id="8286943863733751221">અસુરક્ષિત સાઇટ અને ડાઉનલોડ વિશે <ph name="BEGIN_LINK" />Chromium તમને ચેતવણી આપે છે<ph name="END_LINK" /></translation>
<translation id="8295827201165805317">તમે તાજેતરમાં આ સાઇટની મુલાકાત લીધી નથી. Chromium દ્વારા <ph name="PERMISSION" />ની પરવાનગી કાઢી નાખવામાં આવી.</translation>
<translation id="481989138594406896">João Browser iOS ઍપ પર તમારા કૅમેરા વડે જે જુઓ, તેને ખરીદો, અનુવાદ કરો અને તેની ઓળખ કરો</translation>
<translation id="5242426961520127942"><ph name="USER_NAME" /> તરીકે João Browserમાં સાઇન ઇન કરવા માટેનો QR કોડ</translation>
<translation id="8313851650939857356">સ્ટાર્ટઅપ દરમિયાન ભૂલ: <ph name="STARTUP_ERROR" />.</translation>
<translation id="3644336211313412429">જ્યારે તમારી સંસ્થા <ph name="TIMEOUT_DURATION" /> માટે João Browserનો ઉપયોગ ન કરે ત્યારે તેને બંધ કરે છે.</translation>
<translation id="8321888067342493336">છબી તરીકે સાચવો</translation>
<translation id="3150519286474936594"><ph name="USER_EMAIL_ADDRESS" />, પહેલાં João Browser નો ઉપયોગ કરી રહ્યાં હતાં</translation>
<translation id="8351551329754447960">Chromiumમાં કૌશલ્યો ચાલુ કરો</translation>
<translation id="4566781614303801262">તમારા Google એકાઉન્ટ <ph name="ACCOUNT_EMAIL" />માં João Browser ડેટાનો ઉપયોગ કરવાનું ચાલુ રાખવા માટે João Browser અપડેટ કરો</translation>
<translation id="8404636483124146663">João Browserની ભાવિ અપડેટ મેળવવા માટે, તમારે Windows 10 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યુટર Windows 8નો ઉપયોગ કરે છે.</translation>
<translation id="8362914115861174987">આ ભાષામાં અનુવાદ કરો</translation>
<translation id="8367705492654390392">કંઈપણ પૂછો</translation>
<translation id="8370517070665726704">કૉપિરાઇટ <ph name="YEAR" /> Google LLC. સર્વાધિકાર સુરક્ષિત.</translation>
<translation id="8954225380790220359">તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ અને બીજું ઘણું મેળવવા માટે, João Browserમાં સાઇન ઇન કરો. તમે સાઇન ઇન કરો તે પછી આ પાસવર્ડ તમારા Google એકાઉન્ટમાં સાચવવામાં આવશે.</translation>
<translation id="208035402574338948">ત્યાર પછી તમારે João Browser ફરી શરૂ કરવું જરૂરી છે.</translation>
<translation id="7458698097055456629">João Browser તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે. <ph name="BEGIN_LINK" />સપોર્ટેડ એક્સ્ટેન્શન વિશે વધુ જાણો<ph name="END_LINK" /></translation>
<translation id="3428558977667883100">આ એક્સ્ટેન્શનને તેના ડેવલપર દ્વારા અનપબ્લિશ કરવામાં આવ્યું હતું અને તે અસુરક્ષિત હોઈ શકે છે. તેને João Browserમાંથી કાઢી નાખો જેથી તે હવેથી તમારી વ્યક્તિગત માહિતી સહિત તમે મુલાકાત લો તે સાઇટ પરનો તમારો ડેટા જોઈ કે બદલી શકે નહીં.</translation>
<translation id="5012944467031125860">તમારા Google એકાઉન્ટમાં કેટલોક ડેટા સાચવી શકાય અને તમારા બધા ડિવાઇસ પર તેનો ઉપયોગ કરી શકાય તે પહેલાં, João Browser માટે એ તમે જ છો તેની ચકાસણી કરવી જરૂરી છે. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ડિલીટ કરવામાં આવશે.</translation>
<translation id="8822543678238892300">{0,plural, =1{એક દિવસની અંદર João Browserને ફરીથી લૉન્ચ કરો}one{# દિવસની અંદર João Browserને ફરીથી લૉન્ચ કરો}other{# દિવસની અંદર João Browserને ફરીથી લૉન્ચ કરો}}</translation>
<translation id="8438543370129609977">જ્યારે તમે 'છબી વડે શોધ' સુવિધાનો ઉપયોગ કરો, ત્યારે PDFs સહિત પેજનું શીર્ષક, URL અને કન્ટેન્ટ સર્વરને મોકલવામાં આવે છે. <ph name="LEARN_MORE" /></translation>
<translation id="4307944272317199640">João Browserમાં 'છબી વડે શોધ' સુવિધા વડે શોધવા વિશે વધુ જાણો</translation>
<translation id="6024135746436350583">ઇન્સ્ટૉલર આર્કાઇવ ખરાબ અથવા અમાન્ય છે. કૃપા કરીને João Browser ફરીથી ડાઉનલોડ કરો.</translation>
<translation id="4933173390191738516">João Browser માટે Windows 10 અથવા તે પછીનું વર્ઝન આવશ્યક છે.</translation>
<translation id="8463672209299734063">વૈકલ્પિક: Googleને ડાયગ્નોસ્ટિક અને વપરાશનો ડેટા ઑટોમૅટિક રીતે મોકલીને ChromiumOSની સુવિધાઓ અને કાર્યપ્રદર્શનને બહેતર બનાવવામાં સહાય કરો.</translation>
<translation id="4499703930846496679">તમારા Google એકાઉન્ટમાં João Browserના ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે, આ તમે જ છો તેની ચકાસણી કરો</translation>
<translation id="8482493977473846331">Chromiumમાં સાઇન ઇન કરવા માટેના પ્રૉમ્પ્ટ બતાવો</translation>
<translation id="2129903037617090425">João Browser જૂનું થઈ ગયું છે</translation>
<translation id="850264194101621529">Chromiumને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે પસંદ કરવા બદલ આભાર!</translation>
<translation id="8522801943730206384">જ્યારે તમે તમારા પાસવર્ડ સાચવો ત્યારે Chromium તેને ચેક કરી શકે છે</translation>
<translation id="8525579356836940628">ઇન્સ્ટૉલેશનની પ્રક્રિયા રોકી</translation>
<translation id="2445505893586445499">તમારા <ph name="DEVICE_TYPE" /> પર João Browser ઍપ વડે તમારા પાસવર્ડ, ટૅબ અને બીજું ઘણું મુસાફરીમાં સાથે રાખો</translation>
<translation id="8548787790260785208">જો Chromiumને સાર્વજનિક ડેટા ઉલ્લંઘનમાં તમારો કોઈ પાસવર્ડ મળે, તો ચેતવણી મેળવો</translation>
<translation id="8555465886620020932">સેવામાં ભૂલ: <ph name="SERVICE_ERROR" />.</translation>
<translation id="8871890913961794658">João Browserની કેટલીક સુવિધાઓ અને એક્સ્ટેન્શન શૉર્ટકટ સાથે આવે છે. તમે તેને ફરીથી ચાલુ કરવાનું પસંદ કરી શકો છો.</translation>
<translation id="8556420416730706394">તમે સરળ ઍક્સેસ માટે 'છબી વડે શોધ' સુવિધાને પિન કરી શકો છો; બાજુની પૅનલમાં સૌથી ઉપર પિન કરો બટન પર ક્લિક કરો</translation>
<translation id="856656450041460113">ભાષાની સૂચિ શોધો</translation>
<translation id="9044172203094901282">એકથી વધુ સંસ્થાઓ João Browserને મેનેજ કરે છે</translation>
<translation id="8586442755830160949">કોપિરાઇટ <ph name="YEAR" /> The Chromium Authors. સર્વાધિકાર સુરક્ષિત.</translation>
<translation id="8601359445272098721">નવું! "સ્ક્રીનનો અનુવાદ કરો" બટન પસંદ કરીને તમે તમારી સ્ક્રીન પર ટેક્સ્ટ અને છબીઓનો અનુવાદ કરી શકો છો</translation>
<translation id="1071663705626404814">João Browser લૉન્ચ કરી રહ્યાં છીએ…</translation>
<translation id="8624541899164515475">સેટિંગ, નવા ટૅબમાં ખૂલે છે.</translation>
<translation id="8648201657708811153">Chrome for Testingને તમારું ડિફૉલ્ટ બ્રાઉઝર બનાવી શકાતું નથી.</translation>
<translation id="5975137268566279898">જ્યારે તમે João Browser શરૂ કરો અથવા ઑમ્નિબૉક્સ પરથી શોધ કરો ત્યારે કયું પેજ બતાવવામાં આવે તે તેનું પણ નિયંત્રણ કરે છે.</translation>
<translation id="6358904712334248114">આ તમારું João Browser છે</translation>
<translation id="8712637175834984815">સમજાઈ ગયું</translation>
<translation id="5380190167074430719">João Browserમાં સાઇન ઇન કરીએ?</translation>
<translation id="8747073452963259673">શોધ વિસ્તારના સૌથી નીચે ડાબા ખૂણે: ડાબી બાજુ <ph name="LEFT" />%, સૌથી નીચે <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">ઇન્સ્ટૉલ કરવામાં ભૂલ: તમારા નેટવર્ક ઍડમિન દ્વારા કોઈ ગ્રૂપ પૉલિસી લાગુ કરવામાં આવી છે, જે ઇન્સ્ટૉલેશનની પ્રક્રિયાને અટકાવે છે: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">મને પછીથી યાદ કરાવો</translation>
<translation id="8871607387186266158">ઝડપી ઓવરવ્યૂ મેળવવા અને ફૉલોઅપ પ્રશ્નો પૂછવા માટે, આ દસ્તાવેજને João Browserમાં Gemini સાથે શેર કરો</translation>
<translation id="3009329613270131861">શું João Browserમાં સાઇન ઇન કરીએ?</translation>
<translation id="8823401858233292222">Chromiumને ડિફૉલ્ટ બ્રાઉઝર બનાવો અને ટાસ્કબાર પર પિન કરો</translation>
<translation id="8826492472752484139">“Password Manager” પર ક્લિક કરો</translation>
<translation id="8833697763442816810">ChromiumOS સિસ્ટમ</translation>
<translation id="8852026904190808918">આ ભાષાનો ઉપયોગ Chromiumમાંના મેનૂ, સેટિંગ, અલર્ટ અને અન્ય ટેક્સ્ટ બતાવવા માટે થાય છે</translation>
<translation id="8862326446509486874">તમારી પાસે સિસ્ટમ-સ્તરનાં ઇન્સ્ટોલ માટે ઉચિત અધિકારો નથી. એડમિન તરીકે ઇન્સ્ટૉલરને ફરીથી ચલાવવનો પ્રયાસ કરો.</translation>
<translation id="6821836710312478344">João Browser પ્રોફાઇલ ઉમેરો</translation>
<translation id="5139769635207740615">સાઇન ઇન કરવામાં ભૂલ આવવાને કારણે, ChromiumOS તમારા Google એકાઉન્ટમાં João Browser ડેટા સાચવી શક્યું નથી</translation>
<translation id="6814613825007700341">તમારી સંસ્થા માટે જરૂરી છે કે તમે João Browserમાં સાઇન ઇન કરો</translation>
<translation id="1009831347869773172">João Browser પાસવર્ડ્સ બતાવવાનો પ્રયાસ કરી રહ્યું છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="690637523240192979">João Browser હવેથી તમારું ડિફૉલ્ટ બ્રાઉઝર નથી. João Browserને ડિફૉલ્ટ બ્રાઉઝર બનાવીએ?</translation>
<translation id="225046375773654931">João Browser અપડેટ કરી શકતાં નથી</translation>
<translation id="8944232836376404813">આ ઍક્શન કરવાથી:
          <ph name="LINE_BREAKS" />
            • તમારું સ્ટાર્ટઅપ પેજ, નવું ટૅબ પેજ, શોધ એન્જિન અને પિન કરેલા ટૅબ રીસેટ થઈ જશે
            <ph name="LINE_BREAK" />
            • એક્સ્ટેન્શન બંધ થઈ જશે
            <ph name="LINE_BREAK" />
            • કુકી અને સાઇટનો અન્ય હંગામી ડેટા ડિલીટ થઈ જશે
            <ph name="LINE_BREAKS" />
            બુકમાર્ક, ઇતિહાસ અને સાચવેલા પાસવર્ડને કોઈ અસર થશે નહીં.</translation>
<translation id="4349474976990059197">João Browser Enterpriseનો લોગો</translation>
<translation id="3227699293368317033">તમારા <ph name="DEVICE_TYPE" /> પર João Browser ઍપ વડે મુસાફરીમાં Googleની સલામતી મેળવો</translation>
<translation id="6527164294507620103">તમારી પ્રોફાઇલ ખોલતી વખતે કંઈક ખોટું થયું હોવાને કારણે João Browser શરૂ કરી શકાતું નથી. João Browser ફરી શરૂ કરવાનો પ્રયાસ કરો.</translation>
<translation id="6741767563284518125">João Browser પ્રોફાઇલ મેનેજ કરો</translation>
<translation id="3101491883380219087">Gemini in João Browser અને તમારા ખુલ્લા ટૅબ વચ્ચે નૅવિગેટ કરવા માટે તમારા કીબોર્ડનો ઉપયોગ કરો.</translation>
<translation id="9018218886431812662">ઇન્સ્ટૉલેશન પૂર્ણ</translation>
<translation id="3370247132646333337">João Browser ને સુરક્ષિત બનાવવા માટે, અમે નીચેના એક્સ્ટેન્શનને અક્ષમ કર્યું છે કે જે <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> માં સૂચિબદ્ધ નથી અને તમારી જાણ વિના ઉમેરવામાં આવ્યું હોઈ શકે છે.</translation>
<translation id="1940116386572548863">João Browser માં સાઇન ઇન કરો</translation>
<translation id="8381652653666868014">João Browser દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું છે, કારણ કે આર્કાઇવ ફાઇલમાં શામેલ અન્ય ફાઇલોમાં માલવેર છુપાવેલા હોઈ શકે છે</translation>
<translation id="8374335201144490555">તમારા પાસવર્ડ, બુકમાર્ક અને ઇતિહાસને બધા ડિવાઇસ પર સંપૂર્ણ રીતે સિંક કરેલા રાખો. તમારા ડિફૉલ્ટ બ્રાઉઝરને João Browser પર અપડેટ કરીને તમે જાણતા હો એવી અને તમને ગમતી હોય એવી સુવિધાઓને સરળતાથી ઍક્સેસ કરો. ઝડપી ઍક્સેસ માટે João Browserને તમારા ટાસ્કબાર પર પિન કરવામાં આવશે.</translation>
<translation id="6176486087616698123">તમારા ફોન પર João Browser ઍપ વડે Googleના શ્રેષ્ઠ AI ટૂલનો ઉપયોગ કરો</translation>
<translation id="9062666675513499497">જ્યારે તમે Googleની અન્ય સેવાઓમાં સાઇન ઇન કરશો, ત્યારે Chromiumમાં સાઇન ઇન કરો</translation>
<translation id="724802823738504651">João Browser ઑટોમૅટિક રીતે બંધ થઈ ગયું હતું</translation>
<translation id="2689333215784698609">João Browser જૂનું થઈ ગયું છે</translation>
<translation id="8049510467237146160">{0,plural, =1{João Browser એક કલાકમાં ફરીથી લૉન્ચ થશે}one{João Browser # કલાકમાં ફરીથી લૉન્ચ થશે}other{João Browser # કલાકમાં ફરીથી લૉન્ચ થશે}}</translation>
<translation id="9106236359747881194">શોધવા માટે ટેક્સ્ટ પસંદ કરો</translation>
<translation id="8558551666630075184">João Browserની ભાવિ અપડેટ મેળવવા માટે, તમારે Windows 10 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યુટર Windows 8.1નો ઉપયોગ કરે છે.</translation>
<translation id="1194819784870407331">નવા João Browser &amp;ટૅબમાં લિંક ખોલો</translation>
<translation id="911206726377975832">તમારો બ્રાઉઝિંગ ડેટા પણ ડિલીટ કરી દઈએ?</translation>
<translation id="9134482777260927479">હોમવર્ક માટે મદદ</translation>
<translation id="9148058034647219655">બહાર નીકળો</translation>
<translation id="548951409840319583">તમે જ્યાંથી છોડ્યું હતું ત્યાંથી ચાલુ કરો: João Browser તમે જ્યારે ફરી શરૂ કરો છો ત્યારે દરેક વખતે તમારા ટૅબ રિસ્ટોર કરી શકે છે. આને ચાલુ કરવા માટે, આના પર જાઓ</translation>
<translation id="7614949510548815395">તમારા સિસ્ટમ વ્યવસ્થાપકે <ph name="TARGET_URL_HOSTNAME" />ને ઍક્સેસ કરવા João Browserને વૈકલ્પિક બ્રાઉઝર ખોલવા માટે ગોઠવેલું છે.</translation>
<translation id="3441698750089879771">&amp;João Browser અપડેટ કરવા માટે, ફરીથી લૉન્ચ કરો</translation>
<translation id="369689859238510548">João Browser (mDNS-In)</translation>
<translation id="8336832914816665097">João Browserને તમારું પોતાનું બનાવો</translation>
<translation id="7698429329590050365">João Browser યોગ્ય રીતે કાર્ય ન કરે તેવું બની શકે કારણ કે તે હવેથી Windows XP અથવા Windows Vista પર સમર્થિત નથી</translation>
<translation id="190261805571697214">João Browser વડે મુસાફરીમાં Googleની શ્રેષ્ઠ સલામતી સુવિધાઓ મેળવો.</translation>
<translation id="945522503751344254">પ્રતિસાદ મોકલો</translation>
<translation id="5554799509799759090">કોણ João Browserનો ઉપયોગ કરે છે?</translation>
<translation id="9153108844196984904">João Browserની સૌથી વધુ મજબૂત સુરક્ષા મેળવો</translation>
<translation id="983803489796659991">અપડેટ સર્વર પાસે ઍપ્લિકેશન માટે કોઈ હૅશ સંબંધી ડેટા ન હોવાને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="6230710687825107323">કોઈ એકાઉન્ટ વિના João Browserનો ઉપયોગ કરો</translation>
<translation id="985602178874221306">Chromium લેખકો</translation>
<translation id="989970834842471429">'છબી વડે શોધ' સુવિધા વડે શોધવા માટે કોઈપણ ટેક્સ્ટ અથવા છબી પસંદ કરો</translation>
<translation id="992780518932311116">તમારા લોકેશનનો ઉપયોગ કરવા માટે, <ph name="BEGIN_LINK" />સિસ્ટમના સેટિંગ<ph name="END_LINK" />માં જઈને Chromiumને ઍક્સેસ આપો</translation>
</translationbundle>