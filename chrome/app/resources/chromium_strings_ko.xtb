<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ko">
<translation id="1026101648481255140">설치 다시 시작</translation>
<translation id="1029669172902658969">다시 실행하여 ChromiumOS 업데이트</translation>
<translation id="4711726241445951349">João Browser에서는 이 확장 프로그램을 검토할 것을 권장합니다.</translation>
<translation id="1042552502243217427">사이트에서 페이지에 있는 링크를 비공개로 미리 로드해 달라고 요청하면 Chromium은 Google 서버를 사용합니다. 이렇게 하면 미리 로드된 사이트에서 사용자의 신원을 숨길 수 있지만 Google은 어떤 사이트가 미리 로드되는지 학습하게 됩니다.</translation>
<translation id="1051793555070215510">1분 정도 소요되는 설문조사에 참여하여 시크릿 모드를 개선하는 데 도움을 주세요.</translation>
<translation id="1065672644894730302">환경설정을 읽을 수 없습니다.

일부 기능을 사용할 수 없으며 환경설정의 변경사항이 저장되지 않습니다.</translation>
<translation id="3937976866851867994">부모님이 João Browser의 ‘사이트, 앱, 확장 프로그램에 대한 권한’을 사용 중지했습니다</translation>
<translation id="8626021334348319355">특정 João Browser 기능 또는 확장 프로그램을 검색하려면 주소 표시줄에 바로가기를 입력한 다음 선택한 키보드 키를 입력하세요</translation>
<translation id="9157778882771986870">João Browser에서 비밀번호를 내보내려고 합니다. 허용하려면 Windows 비밀번호를 입력하세요.</translation>
<translation id="112640046208448578">사물 또는 장소를 식별하고 텍스트를 복사하거나 번역합니다. 이미지 검색을 사용하면 페이지의 스크린샷이 서버로 전송됩니다. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium이 기본 브라우저로 설정되어 있습니다.</translation>
<translation id="1131805035311359397">암호가 정보 유출 및 다른 보안 문제로부터 안전한지 확인하려면 <ph name="BEGIN_LINK" />Chromium에 로그인<ph name="END_LINK" />하세요.</translation>
<translation id="2795895511109336240">João Browser 메뉴를 클릭합니다</translation>
<translation id="1157985233335035034">최근에 사용한 언어</translation>
<translation id="1184145431117212167">지원되지 않는 Windows 버전으로 인해 설치할 수 없습니다.</translation>
<translation id="1185134272377778587">Chromium 정보</translation>
<translation id="667420476518265356">휴대전화에서 João Browser으로 가격 추적 알림을 받으세요</translation>
<translation id="1203500561924088507">설치해 주셔서 감사합니다. <ph name="BUNDLE_NAME" />을(를) 사용하려면 브라우저를 다시 시작해야 합니다.</translation>
<translation id="1232234696885483911">이미지 검색을 열면 페이지 제목, URL, PDF를 포함한 콘텐츠가 서버로 자동 전송됩니다. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">로그인한 상태로 João Browser에서 Google 계정의 비밀번호 등을 사용할 수 있습니다. 이 설정을 변경하려면 'João Browser의 내 계정'으로 이동하세요.</translation>
<translation id="4866003137980530528">Mac 메뉴 바에 João Browser의 Gemini 표시</translation>
<translation id="2526294198551578217">João Browser의 Gemini에서 화면의 일부를 선택하려면 키보드 단축키를 사용하세요.</translation>
<translation id="7068536367561625920">이 탭이 비활성 상태인 동안 João Browser의 속도를 빠르게 유지하기 위해 메모리를 확보했습니다. 이 사이트가 비활성 상태가 되지 않도록 항상 제외할 수 있습니다.</translation>
<translation id="3669854427836618143">위험한 파일이므로 João Browser에서 이 다운로드를 차단했습니다.</translation>
<translation id="126567311906253476"><ph name="USER_EMAIL" /> 계정으로 Gmail 또는 YouTube와 같은 Google 서비스에 로그인하면 동일한 계정으로 Chromium에 자동으로 로그인할 수 있습니다.</translation>
<translation id="8094399825947986050">휴대전화에 João Browser을 다운로드하세요</translation>
<translation id="1290883685122687410">설정 오류: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">새 João Browser 프로필 설정</translation>
<translation id="7591029065989504977">João Browser의 Gemini로 사용해 보기</translation>
<translation id="8408989583029959522">블루투스 기기를 탐색하려면 João Browser에 블루투스 액세스 권한이 필요합니다. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">휴대전화에서 João Browser에 로그인</translation>
<translation id="1330562121671411446">언어 감지</translation>
<translation id="6026568602942276348">João Browser(<ph name="URL" />)에서도 데이터 삭제</translation>
<translation id="1345251407431278948">고정되었습니다. 툴바의 새 버튼에서 이미지 검색을 다시 이용할 수 있습니다</translation>
<translation id="1356661055722410047">New! 화면의 텍스트와 이미지를 모두 번역할 수 있습니다.</translation>
<translation id="1383876407941801731">검색</translation>
<translation id="5807085300679014096">João Browser 앱을 사용하여 이동 중에도 탐색하세요.</translation>
<translation id="141901961143729572">의견 공유</translation>
<translation id="3736947618013031173">창을 공유하려면 시스템 설정에서 João Browser의 화면 녹화를 허용하세요.</translation>
<translation id="1478370723027452770">Chrome for Testing 관련 지원받기</translation>
<translation id="1497802159252041924">설치 오류: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">보호된 페이지입니다.</translation>
<translation id="4379865404970367448">João Browser 탭 공유</translation>
<translation id="4436275659297289591">João Browser에 로그인</translation>
<translation id="1547469039832541117">강조 표시된 작업을 종료합니다.</translation>
<translation id="449712764049695153">João Browser 고정</translation>
<translation id="1574377791422810894">Chromium의 안전 도구</translation>
<translation id="5480232403718129394">João Browser에서 비밀번호 관리자 데이터를 삭제하려고 합니다. 허용하려면 Windows 비밀번호를 입력하세요.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{관리자의 요구에 따라 업데이트를 적용하려면 João Browser을 다시 실행해야 합니다.}=1{관리자의 요구에 따라 업데이트를 적용하려면 João Browser을 다시 실행해야 합니다. 시크릿 창이 다시 열리지 않습니다.}other{관리자의 요구에 따라 업데이트를 적용하려면 João Browser을 다시 실행해야 합니다. 시크릿 창 #개가 다시 열리지 않습니다.}}</translation>
<translation id="980976428162070137">휴대전화에서 João Browser 앱을 사용하여 Google 기능을 최대한 활용하세요</translation>
<translation id="1625909126243026060">Chromium의 주요 개인 정보 보호 및 보안 제어 기능을 검토합니다.</translation>
<translation id="1640672724030957280">다운로드 중...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" />, 멤버십으로 로그인되었습니다. 계정 메뉴 열기</translation>
<translation id="1708414395296835197">언제든지 메시지, 문서, 기타 앱에서 링크를 클릭하여 Chromium을 사용할 수 있습니다. 작업 표시줄에도 고정됩니다.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" />에 승격된 권한을 제공합니다.</translation>
<translation id="1722488837206509557">이렇게 하면 사용 가능한 기기 중에서 선택하고 해당 기기에 콘텐츠를 표시할 수 있습니다.</translation>
<translation id="6972087163510342335">João Browser에서 곧 인터넷 사용 기록이 삭제됩니다</translation>
<translation id="1736443181683099871">Chromium에서 탐색을 HTTPS로 업그레이드하려고 시도합니다</translation>
<translation id="3879288383593333401">João Browser 데이터 삭제 완료</translation>
<translation id="656496276885630888"><ph name="REMAINING_TIME" /> 후에 João Browser 다시 시작</translation>
<translation id="1749104137266986751">HTTPS를 사용할 수 없는 경우, Chromium에서 경고 없이 안전하지 않은 연결을 사용합니다.</translation>
<translation id="1226290419185955779">백그라운드에서 João Browser을 실행</translation>
<translation id="4231366995273072370">Google에서는 João Browser의 보안을 강화하기 위해 <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />에 표시되지 않고 사용자 모르게 추가되었을 수 있는 일부 확장 프로그램의 사용을 중지했습니다.</translation>
<translation id="1822049153969905781">빠른 액세스를 위해 Windows 알림에서 <ph name="BEGIN_BOLD" />예<ph name="END_BOLD" /> 버튼을 클릭하여 João Browser을 태스크 바에 고정합니다.</translation>
<translation id="1321831992638405531">João Browser 재설치</translation>
<translation id="3386967202064865436">João Browser에서 <ph name="AUTHENTICATION_PURPOSE" />을(를) 시도하는 중입니다.</translation>
<translation id="70054449700528483">다음번에 <ph name="DEVICE_TYPE" />에서 João Browser을 열면 Google 비밀번호 관리자를 사용하라는 메시지가 표시됩니다.</translation>
<translation id="1838374766361614909">검색어 지우기</translation>
<translation id="5807096362853316123">인터넷 사용 기록을 이 기기에서만 삭제하고 Google 계정에서는 유지하려면 <ph name="BEGIN_LINK" />João Browser에서 로그아웃<ph name="END_LINK" />하세요.</translation>
<translation id="6396384011117650379">이동 중에 새 탭 그룹을 열거나 만들려면 휴대전화에 João Browser을 다운로드하세요.</translation>
<translation id="185970820835152459">로그인된 Google 계정을 관리할 수 있습니다. Google 계정은 Chromium 브라우저, Play 스토어, Gmail 등에서 사용됩니다. 가족 구성원 등 다른 사람을 위해 계정을 추가하고 싶다면 대신 <ph name="DEVICE_TYPE" />에 새 사용자를 추가하세요. <ph name="LINK_BEGIN" />자세히 알아보기<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">이미지 검색으로 검색</translation>
<translation id="65457771685016683"><ph name="EXISTING_USER" /> 계정은 이미 로그인되어 있습니다. 방문 기록을 별도로 보관하려면 내 프로필에서 <ph name="USER_EMAIL_ADDRESS" /> 주소로 João Browser에 로그인하세요. 이렇게 하면 <ph name="DEVICE" />에서 북마크 등을 사용할 수 있습니다.</translation>
<translation id="1880677175115548835">텍스트 선택</translation>
<translation id="2634119629547215883">관리 계정으로 로그인하고 João Browser 프로필에 대한 관리자 제어권을 부여하려고 합니다. 앱, 북마크, 방문 기록, 비밀번호 및 기타 설정 등 João Browser 데이터가 <ph name="USER_NAME" /> 계정에 영구적으로 연결됩니다. 이후 이 데이터를 Google 계정 대시보드에서 삭제할 수는 있지만 다른 계정에 연결할 수는 없습니다. 기존 João Browser 데이터를 유지하려면 새 프로필을 만드는 방법이 있습니다. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium에서 부드러운 스크롤 및 동영상 프레임 속도 같은 시각 효과와 백그라운드 활동을 제한하여 배터리 전원을 절약합니다. <ph name="BEGIN_LINK" />에너지 절약 모드에 관해 자세히 알아보기<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">João Browser 업데이터 서비스</translation>
<translation id="1911763535808217981">이 기능을 사용 중지하면 Chromium에 로그인하지 않고도 Gmail 등의 Google 사이트에 로그인할 수 있습니다.</translation>
<translation id="4037729269678342163">João Browser이 응답하지 않습니다. 다시 시작하시겠습니까?</translation>
<translation id="7563750688920581112">조직(<ph name="MANAGER" />)에서 João Browser에 로그인할 것을 요구합니다</translation>
<translation id="193439633299369377">업데이트를 적용하려면 ChromiumOS를 다시 시작해야 합니다.</translation>
<translation id="7099143775283792684">일반적으로 다운로드하지 않는 파일 형식이며 위험할 가능성이 있기 때문에 João Browser에서 이 다운로드를 차단했습니다.</translation>
<translation id="1953553007165777902">다운로드 중... <ph name="MINUTE" />분 남음</translation>
<translation id="1966382378801805537">Chromium에서 기본 브라우저를 확인하거나 설정할 수 없습니다.</translation>
<translation id="197326043290947695">이미지 검색으로 더 스마트하게 탐색하세요</translation>
<translation id="6185556991023272801">João Browser에서 일부 파일을 차단하는 이유 알아보기, 새 탭에서 열기</translation>
<translation id="4053636705816895911">João Browser 소프트웨어를 최신 상태로 유지합니다. 이 서비스를 사용 중지하거나 중단하면 João Browser 소프트웨어가 최신 상태로 유지되지 않습니다. 즉, 발생할 수 있는 보안 취약점이 수정되지 않고 기능이 작동하지 않을 수 있습니다. 이 서비스를 사용하는 João Browser 소프트웨어가 없으면 이 서비스는 자동으로 제거됩니다.</translation>
<translation id="2008474315282236005">항목 1개가 기기에서 삭제됩니다. 나중에 데이터를 가져오려면 Chromium에 <ph name="USER_EMAIL" />(으)로 로그인하세요.</translation>
<translation id="2018879682492276940">설치할 수 없습니다. 다시 시도해 보세요.</translation>
<translation id="2039417478970545937">설정</translation>
<translation id="2049376729098081731">보다 맞춤설정된 Google 서비스 환경을 사용하기 위해 Chromium 방문 기록을 포함할지 선택하세요.</translation>
<translation id="6768767091114123654">João Browser에 내장되어 있어 안전한 비밀번호를 만들고, 저장하고, 자동 완성하도록 도와줍니다. 바로가기를 추가하여 간편하게 액세스하세요</translation>
<translation id="3571664229232252557">새 탭 페이지에서 'João Browser 맞춤설정' 버튼을 클릭하여 João Browser에 새로운 디자인을 적용하세요</translation>
<translation id="4273287215573278663">사기성 파일이며 기기에 예기치 않은 변경사항이 적용될 수 있기 때문에 João Browser에서 이 다운로드를 차단했습니다.</translation>
<translation id="9063967192437499581">다음번에 João Browser iOS를 열면 <ph name="FEATURE_NAME" /> 기능을 사용해 보라는 메시지가 표시됩니다.</translation>
<translation id="8511569826706775962">Google 계정에 저장된 비밀번호 및 기타 João Browser 데이터가 이 기기에서 삭제됩니다. João Browser에서 다시 사용하려면 다시 로그인하세요</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{João Browser을 1분 동안 사용하지 않으면 조직에서 인터넷 사용 기록을 자동으로 삭제합니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다. 탭이 열린 상태로 유지됩니다.}other{João Browser을 #분 동안 사용하지 않으면 조직에서 인터넷 사용 기록을 자동으로 삭제합니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다. 탭이 열린 상태로 유지됩니다.}}</translation>
<translation id="2125838419757773031">화면의 영역을 선택하여 검색하세요</translation>
<translation id="2126108037660393668">다운로드한 파일을 확인할 수 없습니다.</translation>
<translation id="2135919691573380097">이 사이트 신고</translation>
<translation id="2137162749895930932">번역 화면 닫기</translation>
<translation id="1308845716497059117">사이트에서 보안 연결을 사용하고 있지 않으며 파일이 조작되었을 가능성이 있기 때문에 João Browser에서 이 다운로드를 차단했습니다.</translation>
<translation id="2170098639895543546">페이지에서 항목 선택</translation>
<translation id="6705844023496387932">João Browser 맞춤설정</translation>
<translation id="2174917724755363426">설치가 완료되지 않았습니다. 취소하시겠습니까?</translation>
<translation id="7728290795259244895">João Browser - 네트워크 로그인 - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">업데이트 확인 오류: <ph name="UPDATE_CHECK_ERROR" /></translation>
<translation id="3486802320473595711">João Browser에서 계정 삭제</translation>
<translation id="4648870374540039667">João Browser 앱을 사용하여 이동 중에도 최고의 쇼핑 도구를 활용하세요.</translation>
<translation id="2106116820042118250">iOS용 João Browser의 향상된 세이프 브라우징으로 이동 중에도 더 안전하게 보호하세요.</translation>
<translation id="2210682093923538346">위험한 사이트입니다. Chromium에서 알림을 삭제했습니다.</translation>
<translation id="2236949375853147973">내 활동</translation>
<translation id="118764235932893741">모든 기기에서 내 주소 등을 가져오려면 João Browser에 로그인하세요. 로그인하면 이 주소가 Google 계정에 저장됩니다</translation>
<translation id="7254578863532089400">컴퓨터를 공유하는 경우 친구와 가족이 개별적으로 탐색하고 원하는 대로 João Browser을 설정할 수 있습니다.</translation>
<translation id="22571759390241347">Chromium의 스킬</translation>
<translation id="2283803047247799269">이미지 검색으로 이 탭 검색</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{브라우저 속도를 저하시키는 탭을 일시중지하는 것이 좋습니다}other{브라우저 속도를 저하시키는 탭을 일시중지하는 것이 좋습니다}}</translation>
<translation id="2307973900865360088">도크에 고정</translation>
<translation id="2313870531055795960">Chromium에 저장된 안전하지 않은 사이트 목록을 사용하여 URL을 검사합니다. 사이트에서 사용자의 비밀번호를 도용하려고 하거나 사용자가 유해한 파일을 다운로드하는 경우, Chromium에서 페이지 콘텐츠 일부를 비롯한 URL을 세이프 브라우징 서비스에 보낼 수 있습니다.</translation>
<translation id="2356070529366658676">확인</translation>
<translation id="2359808026110333948">계속</translation>
<translation id="3800730051093461113">"<ph name="EXTENSION_NAME" />" 확장 프로그램에서 João Browser 로그인을 요청합니다</translation>
<translation id="8758735062658446604">앱에서 백그라운드 실행 중인 João Browser 사용 중지</translation>
<translation id="2623595027619107207"><ph name="USER_EMAIL_ADDRESS" /> 계정으로 이 확장 프로그램을 사용하려면 João Browser에 로그인하세요.</translation>
<translation id="2384373936468275798">계정의 로그인 세부정보가 오래되어 ChromiumOS에서 데이터를 동기화할 수 없습니다.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{하나 이상의 João Browser 확장 프로그램에서 HID 기기 1대에 액세스함}=1{하나 이상의 João Browser 확장 프로그램에서 HID 기기 1대에 액세스 중}other{하나 이상의 João Browser 확장 프로그램에서 HID 기기 #대에 액세스 중}}</translation>
<translation id="6254788431480237503">João Browser에서 사이트에 대한 카메라 및 마이크 권한이 필요합니다.</translation>
<translation id="2403703063067034158">시작 오류: 현재 다른 설정 인스턴스가 실행 중입니다. 나중에 다시 시도해 주세요.</translation>
<translation id="3028975423343897358">모든 앱에서 João Browser으로 링크를 열고 작업 표시줄에서 브라우저에 계속 액세스할 수 있습니다</translation>
<translation id="579079006139156831">요약 버튼을 클릭하여 João Browser의 Gemini와 이 문서를 공유하고 간략한 개요를 확인한 후 후속 질문을 하세요.</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Chromium의 도구<ph name="END_LINK" />로 안전하게 탐색하고 관리할 수 있습니다.</translation>
<translation id="7114471809991869757"><ph name="EXISTING_USER" /> 계정은 이미 로그인되어 있습니다. 방문 기록을 별도로 보관하려면 내 프로필에서 <ph name="USER_EMAIL_ADDRESS" /> 주소로 João Browser에 로그인하세요. 이렇게 하면 모든 기기에서 비밀번호 등을 사용할 수 있습니다.</translation>
<translation id="2451727308784734061">바로가기를 사용하여 비밀번호 관리자로 빠르게 이동하세요. 바로가기는 컴퓨터의 홈 화면이나 앱 런처로 이동할 수 있습니다.</translation>
<translation id="2709136733469807397">João Browser이 곧 종료됩니다</translation>
<translation id="3652225684487279741">João Browser에서</translation>
<translation id="2485422356828889247">제거</translation>
<translation id="2513154137948333830">재부팅 필요: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">이미지 검색으로 텍스트 선택</translation>
<translation id="1527474262707362156">João Browser에서 기존 비밀번호를 바꾸려고 합니다. 허용하려면 Windows 비밀번호를 입력하세요.</translation>
<translation id="6480371226914552131">파일을 다운로드하려면 João Browser에 저장소 액세스 권한이 있어야 합니다</translation>
<translation id="6318568902186985084">João Browser 도우미</translation>
<translation id="2575822587468774919">이미지 검색으로 검색할 항목을 선택하세요</translation>
<translation id="4557210258834653476">모든 기기에서 비밀번호 등을 사용하려면 João Browser에 로그인하세요</translation>
<translation id="1148164459654218834">휴대전화로 QR 코드를 스캔하여 João Browser을 다운로드하고 Google 계정에 로그인하세요.</translation>
<translation id="235892353478111963">João Browser 계속 사용</translation>
<translation id="259935314519650377">다운로드한 설치 프로그램을 캐시할 수 없습니다. 오류(<ph name="UNPACK_CACHING_ERROR_CODE" />)가 발생했습니다.</translation>
<translation id="2620436844016719705">시스템</translation>
<translation id="8471946631262724853">조직에서 북마크, 방문 기록, 비밀번호와 같은 인터넷 사용 기록을 보고 관리할 수 있습니다. 다른 João Browser 프로필의 인터넷 사용 기록은 확인할 수 없습니다</translation>
<translation id="2870759219964376597"><ph name="ACCOUNT_EMAIL" /> 계정에서 João Browser 데이터를 사용하고 저장하려면 본인 인증을 완료하세요</translation>
<translation id="2955972712254986678">{COUNT,plural, =0{고급 보호를 사용 설정한 경우 João Browser을 다시 실행하여 업데이트를 적용해야 합니다}=1{고급 보호를 사용 설정한 경우 João Browser을 다시 실행하여 업데이트를 적용해야 합니다. 시크릿 창이 다시 열리지 않습니다.}other{고급 보호를 사용 설정한 경우 João Browser을 다시 실행하여 업데이트를 적용해야 합니다. 시크릿 창 #개가 다시 열리지 않습니다.}}</translation>
<translation id="8949462882238006192">João Browser 시작</translation>
<translation id="4224214204752803768">설치 중 운영체제 오류가 발생했습니다. João Browser을 다시 다운로드하세요.</translation>
<translation id="3141414135710372892">기기를 공유하는 경우 친구와 가족이 개별적으로 탐색하고 원하는 대로 João Browser을 설정할 수 있습니다.</translation>
<translation id="8838607803339100223">João Browser이 최소화된 상태에서도 모든 기기에서 João Browser의 Gemini를 쉽게 사용할 수 있습니다.</translation>
<translation id="1679364578146271696">João Browser 탭</translation>
<translation id="2718390899429598676">보안 강화를 위해 Chromium에서 사용자 데이터를 암호화합니다.</translation>
<translation id="1874696651662237927">João Browser에서 Google 계정을 삭제하려면 로그아웃하세요.</translation>
<translation id="6850669719663104304">모든 기기에서 비밀번호, 북마크 등을 사용하려면 João Browser에 로그인하세요</translation>
<translation id="2738871930057338499">인터넷에 연결할 수 없습니다(HTTP 403 Forbidden). 프록시 설정을 확인하시기 바랍니다.</translation>
<translation id="2753623023919742414">클릭하여 검색</translation>
<translation id="4193420110872590792">João Browser을 기본 PDF 뷰어로 설정</translation>
<translation id="6614401181366354261">이 확장 프로그램에는 멀웨어가 포함되어 있으며, 안전하지 않습니다. 더 이상 개인 정보를 비롯한 방문 사이트의 데이터를 확인하고 변경할 수 없도록 João Browser에서 이 확장 프로그램을 삭제하세요.</translation>
<translation id="2799223571221894425">다시 시작</translation>
<translation id="6299858290790311689">내 João Browser</translation>
<translation id="2816462166102338036">이미지 검색으로 이 동영상 검색하기</translation>
<translation id="5896458971800337862">iOS에서 João Browser을 사용해 카메라로 제품을 발견하고, 가격 인하를 추적하는 등 다양한 작업을 이동 중에 수행하세요.</translation>
<translation id="2841525013647267359">출발어</translation>
<translation id="2846251086934905009">설치 오류: 설치 프로그램이 완료되지 않았습니다. 설치가 중단되었습니다.</translation>
<translation id="4357241592510111611">João Browser에서 제거...</translation>
<translation id="2850691299438350830">로그인 상태일 때 Chromium에서 사용자를 보호하고 기타 Google 앱에서 사용자의 보안을 강화하는 데 사용될 수 있습니다.</translation>
<translation id="2885378588091291677">작업 관리자</translation>
<translation id="8887040619780090085">João Browser 정보</translation>
<translation id="2915996080311180594">나중에 다시 시작</translation>
<translation id="6619708652934279502">데이터가 암호로 암호화되어 있습니다. Google 계정에서 João Browser 데이터를 사용하고 저장하려면 암호를 입력하세요.</translation>
<translation id="2945997411976714835">설치 오류: 설치 프로그램 프로세스를 시작할 수 없습니다.</translation>
<translation id="4566114009566397386">iOS의 João Browser에 저장된 비밀번호를 사용하여 사이트에 더 빠르게 로그인하세요.</translation>
<translation id="562175540137901632">조직에서 João Browser을 관리합니다.</translation>
<translation id="2977470724722393594">Chromium이 최신 버전임</translation>
<translation id="2977506796191543575">사이트에서 사용자의 비밀번호를 도용하려고 하거나 사용자가 유해한 파일을 다운로드하는 경우, Chromium에서 페이지 콘텐츠 일부를 비롯한 URL을 세이프 브라우징 서비스에 보낼 수 있습니다.</translation>
<translation id="1776205510657237623">부모님의 선택을 통해 온라인에서 더 안전하게 보호받으려면 João Browser에 로그인하세요</translation>
<translation id="3003694935412297923">모든 작업</translation>
<translation id="3374694374267805392">{count,plural, =1{일부 데이터를 Google 계정에 저장하고 모든 기기에서 사용하려면 João Browser에서 본인 인증을 거쳐야 합니다. 지금 로그아웃하면 이 데이터(항목 1개)가 삭제됩니다}other{일부 데이터를 Google 계정에 저장하고 모든 기기에서 사용하려면 João Browser에서 본인 인증을 거쳐야 합니다. 지금 로그아웃하면 이 데이터(항목 {count}개)가 삭제됩니다}}</translation>
<translation id="4915792193596835645">João Browser의 새 탭에서 <ph name="URL" /> 주소가 열립니다.</translation>
<translation id="302551344979399011">스킬과 같은 AI 혁신 기술은 Google 계정에 저장되며 Chromium 동기화와 별도로 관리됩니다</translation>
<translation id="8367114375553489372">João Browser에 추가하는 중...</translation>
<translation id="3038232873781883849">설치 대기 중...</translation>
<translation id="3045032126857188731">번역된 언어, <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">의견 닫기 대화상자</translation>
<translation id="6168172692486433600">기타 João Browser 프로필</translation>
<translation id="884929993636327">확장 프로그램은 João Browser을 맞춤설정할 수 있는 부가기능입니다. 정리부터 일상적인 할 일을 간소화하는 것까지, 확장 프로그램을 통해 João Browser을 나만의 브라우저로 만들 수 있습니다.</translation>
<translation id="1525897524206034002">비정상 종료 보고서와 <ph name="UMA_LINK" />을(를) Google로 전송하여 João Browser 개선에 참여합니다.</translation>
<translation id="2766971658743453990">João Browser 앱을 사용하여 이동 중에도 Google의 안전 기능을 활용하세요.</translation>
<translation id="4387884830246074210">{NUM_DEVICES,plural, =0{하나 이상의 João Browser 확장 프로그램에서 USB 기기 1대에 액세스함}=1{하나 이상의 João Browser 확장 프로그램에서 USB 기기 1대에 액세스 중}other{하나 이상의 João Browser 확장 프로그램에서 USB 기기 #대에 액세스 중}}</translation>
<translation id="3413144813287436446">João Browser 방문 기록</translation>
<translation id="9192419056064225629">설치 프로그램이 보관 파일 압축 풀기에 실패했습니다. João Browser을 다시 다운로드하세요.</translation>
<translation id="310459126943037700">작업을 종료할 수 없습니다.</translation>
<translation id="3104828284009500087">페이지의 내용을 검색하세요</translation>
<translation id="3508468328135806512">비밀번호, 북마크, 방문 기록을 기기 전반에서 완벽하게 동기화하세요. 기본 브라우저를 João Browser으로 업데이트하면 즐겨 사용하는 기능을 간편하게 이용할 수 있습니다.</translation>
<translation id="3216151988142306917">João Browser이 마이크를 사용 중입니다.</translation>
<translation id="3130333203120345554">새로 검색하기</translation>
<translation id="3137969841538672700">드래그하여 검색</translation>
<translation id="7493177208577109722">이 탭은 추가 리소스를 사용하고 있습니다. 성능을 개선하려면 João Browser에서 이 탭을 비활성화하도록 허용하세요.</translation>
<translation id="7239354789967255675">화면을 공유하려면 시스템 설정에서 João Browser의 화면 녹화를 허용하세요.</translation>
<translation id="4955872590603594814">João Browser 다시 시작</translation>
<translation id="3161522574479303604">모든 언어</translation>
<translation id="4697739132113629685">João Browser 시크릿 창에서 링크 열기(&amp;G)</translation>
<translation id="1629247860984475766">새로운 João Browser 프로필 맞춤설정</translation>
<translation id="1905008150929775692">탭을 전환하지 않고도 AI 모드로 계속 채팅할 수 있습니다. 시작하려면 João Browser에 로그인하세요. 이렇게 하면 이용 중인 모든 기기에서 비밀번호 등도 사용할 수 있습니다.</translation>
<translation id="4232381420311815141">João Browser에서 Google 계정을 삭제하려면 설정 페이지를 통해 João Browser에서 로그아웃하세요</translation>
<translation id="3234316605225071811">나중에 Chromium에서 저장된 정보를 사용하여 양식을 자동으로 작성할지 묻습니다.</translation>
<translation id="6676749542734993844">João Browser에서 데이터 디렉터리를 읽고 쓸 수 없습니다.

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">iOS에서 João Browser을 사용하여 이동 중에도 즐겨 사용하는 Google AI 도구를 활용하세요.</translation>
<translation id="3286538390144397061">지금 다시 시작</translation>
<translation id="532528773927600103">Google API 키가 누락되었습니다. João Browser의 일부 기능이 사용 중지됩니다.</translation>
<translation id="3296368748942286671">Chromium 종료 후에도 백그라운드 앱을 계속 실행</translation>
<translation id="3313189106987092621">Chromium에서 안전하지 않은 연결을 사용해 사이트를 로드하기 전에 경고를 표시합니다.</translation>
<translation id="8095477191923518137">João Browser에 로그인한 경우 Google 계정을 제외한 모든 João Browser 창을 닫으면 대부분의 사이트에서 로그아웃됩니다. 사이트에서 나를 기억하도록 하려면 <ph name="SETTINGS_LINK" />하세요.</translation>
<translation id="3352986031709923790">검색 영역의 오른쪽 상단: 오른쪽 <ph name="RIGHT" />%, 상단 <ph name="TOP" />%</translation>
<translation id="3366305173356742781">사용자 계정의 Chromium 데이터</translation>
<translation id="3234882977104294240">휴대전화에서 João Browser으로 비밀번호를 사용하세요</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="2974199599420431595">기존 João Browser 프로필로 전환하시겠습니까?</translation>
<translation id="3412460710772753638">기기의 비밀번호 관리자에 업데이트합니다.</translation>
<translation id="3438772217992559640">이미지 검색으로 이 탭 검색</translation>
<translation id="8318147705317768982">휴대전화에서 João Browser으로 향상된 세이프 브라우징을 확장하세요</translation>
<translation id="347392028839310978">나만의 João Browser 만들기...</translation>
<translation id="3474745554856756813">항목 <ph name="ITEMS_COUNT" />개가 기기에서 삭제됩니다. 나중에 데이터를 가져오려면 Chromium에 <ph name="USER_EMAIL" />(으)로 로그인하세요.</translation>
<translation id="5805833167703404998"><ph name="SHORTCUT" /> 바로가기를 사용하여 João Browser 프로필 간에 전환하세요</translation>
<translation id="1835124883585653877">João Browser 창을 모두 닫고 다시 시도해 보세요.</translation>
<translation id="7106246566966568195">창을 공유하려면 시스템 설정에서 João Browser의 화면 녹화를 허용하세요.</translation>
<translation id="6017005873246021363"><ph name="EXISTING_USER" /> 계정은 이미 로그인되어 있습니다.  방문 기록을 별도로 보관하려면 내 프로필에서 <ph name="USER_EMAIL_ADDRESS" /> 주소로 João Browser에 로그인하세요.</translation>
<translation id="1146681170626381319">휴대기기에서 João Browser 브라우저를 다운로드할 수 있는 QR 코드</translation>
<translation id="354621070532799440">알림: 주머니에 쏙 들어가는 Google 최고의 안전 기능</translation>
<translation id="2488701737291439763">화면을 공유하려면 시스템 설정에서 João Browser의 화면 녹화를 허용하세요.</translation>
<translation id="3588112919289558122">향상된 보호 모드는 Chromium에서 인식하지 못하는 사이트에 대해 JavaScript 최적화를 사용 중지합니다</translation>
<translation id="3597003331831379823">승격된 권한으로 설정을 실행할 수 없습니다. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">João Browser에 로그인하세요</translation>
<translation id="5985252758124395804">선택한 사용자의 인터넷 사용 기록이 이 기기에서 삭제됩니다. 데이터를 복구하려면 <ph name="USER_EMAIL" />(으)로 João Browser에 로그인하세요.</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{새 João Browser 업데이트가 있습니다. João Browser을 다시 실행하면 업데이트가 바로 적용됩니다.}=1{새 João Browser 업데이트가 있습니다. João Browser을 다시 실행하면 업데이트가 바로 적용됩니다. 시크릿 창이 다시 열리지 않습니다.}other{새 João Browser 업데이트가 있습니다. João Browser을 다시 실행하면 업데이트가 바로 적용됩니다. 시크릿 창 #개가 다시 열리지 않습니다.}}</translation>
<translation id="3667616615096815454">설치할 수 없습니다. 서버에서 애플리케이션을 알 수 없습니다.</translation>
<translation id="3675854891107786059"><ph name="BEGIN_LINK" />나만의 암호<ph name="END_LINK" />를 사용하여 Google 계정에 있는 모든 Chromium 데이터를 암호화하세요. Google Pay의 결제 수단 및 주소는 암호화되지 않습니다. Chromium 방문 기록은 동기화되지 않습니다.</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{관리자가 이 업데이트를 적용하려면 사용자가 João Browser을 다시 시작하도록 설정했습니다.}=1{관리자가 이 업데이트를 적용하려면 사용자가 João Browser을 다시 시작하도록 설정했습니다. 시크릿 창이 다시 열리지 않습니다.}other{관리자가 이 업데이트를 적용하려면 사용자가 João Browser을 다시 시작하도록 설정했습니다. 시크릿 창 #개가 다시 열리지 않습니다.}}</translation>
<translation id="4134769722455445399">새 João Browser 탭에서 링크 열기(&amp;T)</translation>
<translation id="3728124580182886854">맞춤설정 등의 목적으로 Chromium과 기타 Google 서비스를 연결합니다</translation>
<translation id="3729187154190517324">'탭 등 배경 정보 추가' 버튼으로 여러 탭, 파일, 도구를 추가하여 심층적으로 검색하세요.</translation>
<translation id="655691042235349825">João Browser 프로필 관리</translation>
<translation id="8494798931804571569">João Browser에서 일부 다운로드를 차단하는 이유 알아보기</translation>
<translation id="379589255253486813">검토가 필요한 경우 Chromium에서 알려드립니다</translation>
<translation id="3802055581630249637">Chromium은 사용자가 방문할 가능성이 있는 페이지를 미리 로드하여 사용자가 방문할 때 페이지를 더 빠르게 로드합니다.</translation>
<translation id="3810973564298564668">관리</translation>
<translation id="6945066279282141856">저장된 비밀번호를 사용하려면 QR 코드를 따라가 iOS용 João Browser을 다운로드하고 Google 계정에 로그인하세요.</translation>
<translation id="3846683726093018685">**요약:** 30단어 미만의 한 문장으로 스크린샷 속 콘텐츠의 주요 주제와 목적을 설명해 줘.

          **질문 추천:** 사용자가 스크린샷을 더 잘 파악하기 위해 물어볼 법하면서 생각할 거리를 주는 질문 3~5개를 글머리기호 목록 형식으로 생성해 줘. 질문에는 시각적 객체, 디자인 또는 배치에 관한 질문이 하나 이상 포함되어야 해.</translation>
<translation id="4996569675441627032"><ph name="PAGE_TITLE" /> - João Browser</translation>
<translation id="6008740052107737825">João Browser에 사이트에 대한 로컬 네트워크 권한이 필요합니다.</translation>
<translation id="3885770153807205175">언어 선택 도구</translation>
<translation id="2390004682597453662">João Browser을 맞춤설정 및 제어합니다. 확인이 필요한 항목이 있습니다. 클릭하여 세부정보를 보세요.</translation>
<translation id="8262407643678629134">João Browser을 열고 탐색을 시작하려면 내 이름을 클릭하세요.</translation>
<translation id="3892148308691398805">텍스트 복사</translation>
<translation id="2168201717554927204"><ph name="EXISTING_USER" />님이 이미 João Browser 프로필에 로그인되어 있습니다. 인터넷 사용 기록을 별도로 보관하기 위해 João Browser에서 나만의 프로필을 만들 수 있습니다.</translation>
<translation id="1046732460303790107">이 확장 프로그램은 Chrome 웹 스토어 정책을 위반하며, 안전하지 않을 수 있습니다. 더 이상 개인 정보를 비롯한 방문 사이트의 데이터를 확인하고 변경할 수 없도록 João Browser에서 이 확장 프로그램을 삭제하세요.</translation>
<translation id="3941890832296813527">설치 오류: 설치 프로그램 파일 이름이 잘못되었거나 지원되지 않습니다.</translation>
<translation id="3879366121647289622">João Browser에서 비밀번호를 복사하려고 합니다. 허용하려면 Windows 비밀번호를 입력하세요.</translation>
<translation id="7332365758981378072">Google 계정에 저장된 비밀번호, 결제 수단, 주소가 이 기기에서 삭제됩니다. João Browser에서 다시 사용하려면 다시 로그인하세요</translation>
<translation id="395904275706073188">보호된 페이지는 읽을 수 없습니다. 다른 페이지를 사용해 보세요.</translation>
<translation id="3962647064319009959">Chromium이 사용자를 안전하게 보호하는 방법 알아보기</translation>
<translation id="3967822245660637423">다운로드 완료</translation>
<translation id="3971865010372729242">주소 표시줄이나 검색창에 입력하면 추천을 받을 수 있도록 Chromium에서 입력 내용을 조직의 검색, AI, 에이전트 도구로 전송합니다.</translation>
<translation id="3975724895399328945">&amp;Google Chrome for Testing 정보</translation>
<translation id="3997429360543082038">ChromiumOS 정보</translation>
<translation id="4010059961270896984">사이트 방문 시 Chromium에서 사용자의 IP 주소를 숨기는 개인 정보 보호 서버를 통해 URL의 난독화된 부분을 <ph name="BEGIN_LINK" />Google 세이프 브라우징<ph name="END_LINK" />으로 전송합니다. 사이트에서 의심스러운 작업이 수행되면 전체 URL과 페이지 콘텐츠 일부도 전송됩니다.</translation>
<translation id="4016217212818346953">비밀번호 관리자로 보안을 유지하세요</translation>
<translation id="4019629340646866719"><ph name="BEGIN_LINK_LINUX_OSS" />Linux 개발 환경<ph name="END_LINK_LINUX_OSS" />과 마찬가지로, ChromiumOS는 추가 <ph name="BEGIN_LINK_CROS_OSS" />오픈소스 소프트웨어<ph name="END_LINK_CROS_OSS" />를 사용하여 개발되었습니다.</translation>
<translation id="4022972681110646219">화면 번역</translation>
<translation id="4023601594785368013">원본 언어, <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">모든 앱에서 João Browser으로 링크를 엽니다. 또한 쉽게 액세스할 수 있도록 작업 표시줄에 고정됩니다</translation>
<translation id="4036079820698952681"><ph name="BEGIN_LINK" />현재 설정<ph name="END_LINK" />을 보고하여 Chromium 개선에 참여</translation>
<translation id="4050175100176540509">최신 버전에는 중요한 보안 개선사항 및 새로운 기능이 포함되어 있습니다.</translation>
<translation id="4055805654398742145">비밀번호 관리자(&amp;A)</translation>
<translation id="615818333141511791">{COUNT,plural, =1{João Browser을 1분 동안 사용하지 않으면 조직에서 자동으로 종료합니다. 인터넷 사용 기록이 삭제됩니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다.}other{João Browser을 #분 동안 사용하지 않으면 조직에서 자동으로 종료합니다. 인터넷 사용 기록이 삭제됩니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다.}}</translation>
<translation id="4118474109249235144">Chromium 시크릿 모드</translation>
<translation id="4122186850977583290">Chromium 정보 페이지로 이동</translation>
<translation id="9207280419664362385">João Browser 브라우저를 새로운 디자인으로 맞춤설정합니다.</translation>
<translation id="3719803995198923598">João Browser 맞춤설정(&amp;U)</translation>
<translation id="4148957013307229264">설치 중...</translation>
<translation id="2954462321765112214"><ph name="PAGE_TITLE" /> - 네트워크 로그인 - João Browser</translation>
<translation id="7812363663832111420">João Browser에 유용한 앱, 게임, 확장 프로그램, 테마를 찾아보세요.</translation>
<translation id="69200600645763018">모든 컴퓨터에서 이 확장 프로그램 등을 사용하려면 João Browser에 로그인하세요.</translation>
<translation id="7505863944027312744">부모님의 선택을 통해 온라인에서 더 안전하게 보호하려면 이미 <ph name="USER_EMAIL_ADDRESS" />님으로 로그인되어 있는 João Browser 프로필로 전환하세요.</translation>
<translation id="4222932583846282852">취소 중...</translation>
<translation id="4224210481850767180">설치가 취소되었습니다.</translation>
<translation id="8090594705972340646">João Browser 데이터를 이 계정에 연결하시겠습니까?</translation>
<translation id="4251772536351901305">표준 보호 모드보다 더 많은 사이트에서 데이터를 분석하여 위험한 사이트에 관해 경고합니다. Google이 이전에 몰랐던 사이트도 여기에 포함됩니다. Chromium 경고를 건너뛸 수 있습니다.</translation>
<translation id="5696119579094527589">João Browser에서 로그아웃</translation>
<translation id="4271805377592243930">Chromium 도움말 보기</translation>
<translation id="4281844954008187215">서비스 약관</translation>
<translation id="1245307320228150348">확인되지 않은 오류로 설치에 실패했습니다. João Browser이 실행 중인 경우 종료한 후 다시 실행하세요.</translation>
<translation id="7405356088321579627">João Browser에서 비밀번호 내보내기</translation>
<translation id="4304713468139749426">비밀번호 관리자</translation>
<translation id="4334241893986177674">이 스크린샷을 검색합니다.</translation>
<translation id="212570256141568951">Windows 시작 시 João Browser 실행</translation>
<translation id="4400772909124543403">사용 가능한 업데이트가 없습니다</translation>
<translation id="7463042547966071103">João Browser을 종료하시겠습니까?</translation>
<translation id="4413205837991854510">이미지 검색 바로가기 항상 표시</translation>
<translation id="4736206301215400753">백그라운드에서 João Browser을 실행</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{João Browser에서 삭제할 것을 권장합니다. <ph name="BEGIN_LINK" />지원되는 확장 프로그램에 대해 자세히 알아보기<ph name="END_LINK" />}other{João Browser에서 삭제할 것을 권장합니다. <ph name="BEGIN_LINK" />지원되는 확장 프로그램에 대해 자세히 알아보기<ph name="END_LINK" />}}</translation>
<translation id="5305058100936019600">João Browser 맞춤설정 및 제어</translation>
<translation id="4427306783828095590">향상된 보호 기능이 피싱 및 멀웨어를 더욱 효과적으로 차단합니다.</translation>
<translation id="4434353761996769206">설치 프로그램 오류: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3461955321878243607"><ph name="MANAGER" />에서 João Browser을 관리합니다.</translation>
<translation id="3379477508903866078">João Browser 프로필 추가</translation>
<translation id="4447409407328223819">Chrome for Testing 정보</translation>
<translation id="4074057296993529937">Google 계정에서 João Browser 데이터를 사용하고 저장하려면 비밀번호를 입력하세요</translation>
<translation id="4493028449971051158">시작 오류: 관리자로 설치 프로그램을 실행하세요.</translation>
<translation id="4501471624619070934">이 국가에서는 액세스가 제한되므로 설치할 수 없습니다.</translation>
<translation id="8624811527667906941">이 확장 프로그램은 데이터 수집 및 사용 방식과 같은 개인 정보 보호 관행을 게시하지 않았습니다. João Browser에서 삭제할 것을 권장합니다.</translation>
<translation id="5571435860030744559">João Browser에 오신 것을 환영합니다. 새 브라우저 창이 열렸습니다</translation>
<translation id="8132016625974854930">João Browser에서 주변 환경을 매핑하고 손을 추적하려면 권한이 필요합니다</translation>
<translation id="6599071882590417739">이미 다른 João Browser 프로필에 <ph name="USER_EMAIL_ADDRESS" /> 계정으로 로그인되어 있습니다</translation>
<translation id="4548534452171747496">Chromium에서 페이지를 미리 로드하여 더 빠르게 탐색하고 검색할 수 있습니다. <ph name="BEGIN_LINK" />페이지 미리 로드에 관해 자세히 알아보기<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">유해하다고 생각되는 사이트를 신고하면 모든 사용자를 위해 온라인 안전을 개선할 수 있습니다.</translation>
<translation id="202208802191333704">사용자가 세이프 브라우징을 사용 중지했으며 파일을 확인할 수 없기 때문에 João Browser에서 이 다운로드를 차단했습니다.</translation>
<translation id="3128308674776200516">휴대전화에서 João Browser으로 Google 렌즈를 사용해 보세요</translation>
<translation id="4594305310729380060">기기의 비밀번호 관리자에 저장합니다.</translation>
<translation id="7653380076752216509">João Browser 앱</translation>
<translation id="4598116752460667024">목록에서 프로세스를 검색합니다.</translation>
<translation id="4613863813562375431">ChromiumOS 버전</translation>
<translation id="4621240073146040695">업데이트가 거의 완료되었습니다. 업데이트를 완료하려면 Chromium을 다시 시작하세요.</translation>
<translation id="1497446027991908251">João Browser의 V8 엔진으로 사이트 속도를 높이지만 João Browser이 공격에 약간 더 취약해집니다.</translation>
<translation id="7523749920868634278">경고: João Browser에서는 확장 프로그램에 인터넷 사용 기록이 저장될 수 있습니다. 시크릿 모드에서 이 확장 프로그램을 사용 중지하려면 옵션을 선택 해제하세요.</translation>
<translation id="4673151026126227699">Chromium 사용 보고서도 공유하면 내가 방문한 URL이 해당 보고서에 포함됩니다.</translation>
<translation id="4673710618874938871"><ph name="USER_NAME" />, 멤버십으로 로그인되었습니다. 계정 메뉴 열기</translation>
<translation id="6608258642372806522">다른 컴퓨터(<ph name="HOST_NAME" />)의 다른 João Browser 프로세스(<ph name="PROCESS_ID" />)에서 프로필을 사용 중인 것 같습니다. 프로필이 손상되지 않도록 João Browser에서 잠금 설정했습니다. 다른 프로세스에서 프로필을 사용 중이지 않은 것이 확실한 경우 프로필을 잠금 해제하고 João Browser을 다시 시작하세요.</translation>
<translation id="4680828127924988555">설치 취소</translation>
<translation id="3912572071294857936">João Browser 데이터 중 일부가 아직 Google 계정에 저장되지 않았습니다. 잠시 기다렸다가 로그아웃하세요. 지금 로그아웃하면 이 데이터가 삭제됩니다</translation>
<translation id="1077152188344040592">로그인한 상태로 João Browser에서 Google 계정의 비밀번호 등을 사용할 수 있습니다. <ph name="SHORTCUT" />에서 Google 서비스 설정을 변경할 수 있습니다.</translation>
<translation id="5729536702149847030">다른 사용자가 이전에 이 컴퓨터에서 <ph name="ACCOUNT_EMAIL_LAST" />(으)로 João Browser에 로그인했습니다. 새로운 João Browser 사용자를 만들어 정보를 별도로 관리하세요.</translation>
<translation id="4724676981607797757">지원되지 않는 프로토콜 오류로 인해 설치할 수 없습니다.</translation>
<translation id="6273241729694500032">João Browser을 종료하시겠습니까?</translation>
<translation id="3239680024825449390">João Browser 특별 보안 업데이트를 방금 적용했습니다. 다시 시작하면 탭이 복원됩니다.</translation>
<translation id="4771701986670315895">최근에 사이트를 방문하지 않았습니다. Chromium에서 <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> 외 권한 <ph name="COUNT" />개를 삭제했습니다.</translation>
<translation id="1908292729364083164">João Browser의 Gemini가 열려 있는 경우 새 탭을 만들 때 측면 패널이 열린 상태로 유지됩니다</translation>
<translation id="479167709087336770">Google 검색과 동일한 맞춤법 검사기가 사용됩니다. 브라우저에 입력되는 텍스트는 Google로 전송됩니다. 설정에서 언제든지 이 동작을 변경할 수 있습니다.</translation>
<translation id="189382710647501724">계정 없이 João Browser 사용</translation>
<translation id="4456919965836032212">João Browser이 mDNS 트래픽을 허용하는 인바운드 규칙입니다.</translation>
<translation id="3486986778673504636">다시 실행하여 João Browser 업데이트</translation>
<translation id="4918086044614829423">수락</translation>
<translation id="4918844574251943176">이미지 복사됨</translation>
<translation id="1571932028747131277">João Browser이 백그라운드 모드로 실행 중입니다.</translation>
<translation id="7612124006067933008">클릭하여 João Browser 로그인 대화상자 닫기</translation>
<translation id="2598788273876744576">João Browser 프로필을 사용하면 모든 João Browser 데이터를 분리할 수 있습니다. 친구와 가족을 위한 프로필을 만들거나 업무용과 개인용 프로필을 구분하세요</translation>
<translation id="2115498792600385171">게스트로 사용 기록을 남기지 않고 João Browser을 사용할 수 있습니다.</translation>
<translation id="6870732303439257966">João Browser의 내 계정</translation>
<translation id="4366792189726044065">João Browser에 본인 추가</translation>
<translation id="504699503110800016">더보기 메뉴를 엽니다</translation>
<translation id="4340125167559705618"><ph name="DEVICE_TYPE" />에서 João Browser으로 즐겨 사용하는 모든 Google 서비스에 액세스하세요.</translation>
<translation id="4916697359431064123">João Browser에서 손 추적 기능을 사용하려면 권한이 필요합니다.</translation>
<translation id="5141988424377517949">최근에 사이트를 방문하지 않았습니다. Chromium에서 <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" /> 권한을 삭제했습니다.</translation>
<translation id="5174969993834422967">기본적으로 알림을 차단하는 중입니다. 이 사이트의 알림을 허용하려면 위치 표시줄의 오른쪽 모서리에 있는 알림 아이콘을 클릭하세요.</translation>
<translation id="5174983315706567306">디스크 공간이 충분하지 않습니다.</translation>
<translation id="961070648267203077">João Browser 계정에 재인증이 필요함</translation>
<translation id="69363826605946518">iOS의 João Browser에서 중단한 부분부터 이어서 시작하세요.</translation>
<translation id="471694954923709047">João Browser에서 로그아웃</translation>
<translation id="5234764350956374838">닫기</translation>
<translation id="5782956358171235578">João Browser 시크릿 창에서 링크 열기(&amp;G)</translation>
<translation id="903712329052383264">이동 중에도 비밀번호를 저장하려면 João Browser 앱을 다운로드하세요</translation>
<translation id="5277894862589591112">변경사항을 적용하려면 Chromium을 다시 실행하세요.</translation>
<translation id="5286907366254680517">감지됨</translation>
<translation id="5593827909938092728">João Browser 앱 다운로드</translation>
<translation id="5294316920224716406">시크릿 모드로 탐색할 때 Chromium에서 안전하지 않은 연결을 사용해 사이트를 로드하기 전에 경고를 표시합니다.</translation>
<translation id="1066981078513393795">João Browser 업데이터 내부 서비스</translation>
<translation id="5324450571874973775">Chromium에서 다른 Gemini 기능과 함께 사용하세요</translation>
<translation id="5346389065299425353">여러 탭, 파일, 도구를 추가하여 심층적으로 검색하세요.</translation>
<translation id="1884203704972162365">João Browser의 Gemini를 사용하여 이 문서의 간략한 개요를 확인하고 질문하세요</translation>
<translation id="5352264705793813212">Chromium에서 발견한 보안 권장사항을 검토해 주세요</translation>
<translation id="4819697639570429319">기타 João Browser 프로필</translation>
<translation id="7878591304929138776">Google 계정의 로그인 정보가 오래되어 ChromiumOS에서 Google 계정에 João Browser 데이터를 저장할 수 없습니다</translation>
<translation id="5249614051186670898">관리 계정으로 로그인하고 João Browser 프로필에 대한 관리자 제어권을 부여하려고 합니다. 앱, 북마크, 방문 기록, 비밀번호 및 기타 설정 등 João Browser 데이터가 <ph name="USER_NAME" /> 계정에 영구적으로 연결됩니다. 이후 이 데이터를 Google 계정 대시보드에서 삭제할 수는 있지만 다른 계정에 연결할 수는 없습니다. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">추가 코드: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">맞춤설정을 사용하려면 웹 및 앱 활동에 Chromium을 포함하세요</translation>
<translation id="108952623091824942">João Browser에서 일부 파일을 차단하는 이유 알아보기</translation>
<translation id="5386450000063123300">Chromium 업데이트 중(<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Chromium 로그인 허용</translation>
<translation id="1265086181910844216">João Browser에서 제거</translation>
<translation id="1500700851187484222">성능은 감소하지만 João Browser의 공격에 대한 저항력이 강화됨</translation>
<translation id="6665657403278704382">João Browser을 기본 브라우저로 설정</translation>
<translation id="3520901681432894293"><ph name="PAGE_TITLE" /> - João Browser 베타</translation>
<translation id="5994273394215159270">{NUM_TABS,plural, =1{브라우저 속도를 저하시키는 탭을 일시중지하는 것이 좋습니다}other{브라우저 속도를 저하시키는 탭을 일시중지하는 것이 좋습니다}}</translation>
<translation id="646791423998269453">이 Linux 배포판에서 더 이상 João Browser을 지원하지 않으므로 João Browser이 올바르게 작동하지 않을 수 있습니다.</translation>
<translation id="7249139852479053716">파일이 개인 및 소셜 네트워크 계정에 피해를 줄 수 있기 때문에 João Browser에서 이 다운로드를 차단했습니다</translation>
<translation id="478612683981218420">João Browser에서 최신 시스템 업데이트를 설치하는 동안 잠시 기다려 주세요.</translation>
<translation id="3466187211963597724">João Browser에서 비밀번호를 수정하려고 합니다. 허용하려면 Windows 비밀번호를 입력하세요.</translation>
<translation id="3133978491361824131">João Browser을 사용하면 이동 중에도 Google Drive, YouTube와 같은 즐겨 사용하는 앱을 원활하게 사용할 수 있습니다.</translation>
<translation id="5524890928877629608">검색 영역의 왼쪽 상단: 왼쪽 <ph name="LEFT" />%, 상단 <ph name="TOP" />%</translation>
<translation id="5527463683072221100">Chromium에서 PDF 열기</translation>
<translation id="5536164441519929134">이 탭에 관해<ph name="LINE_BREAK" />물어보기</translation>
<translation id="3902123582863904748">보안을 위해 João Browser은 사이트를 처음 방문할 때 JavaScript 최적화를 사용 중지합니다.

이 페이지가 예상대로 작동하지 않는 경우 최적화를 허용해 보세요.</translation>
<translation id="5924481826213021755">Mac 메뉴 바에 João Browser의 Gemini 표시 및 키보드 단축키 사용 설정</translation>
<translation id="4988760628116707723"><ph name="EXISTING_USER" /> 계정은 이미 로그인되어 있습니다. 방문 기록을 별도로 보관하려면 내 프로필에서 <ph name="USER_EMAIL_ADDRESS" /> 주소로 João Browser에 로그인하세요. 이렇게 하면 <ph name="DEVICE" />에서 저장된 정보 등을 사용할 수 있습니다.</translation>
<translation id="5579324208890605088">시작 오류: 관리자가 아닌 일반 사용자로 설치 프로그램을 실행하세요.</translation>
<translation id="697769674160644707">João Browser을 기본 브라우저로 사용하고 고정하세요</translation>
<translation id="5596627076506792578">옵션 더보기</translation>
<translation id="5605834417512968703">이미지 검색으로 검색할 항목을 선택하거나 Esc 키를 눌러 이미지 검색을 종료하세요.</translation>
<translation id="5618818588972826921">이미지 검색으로 검색할 텍스트 또는 이미지를 선택하거나 Esc 키를 눌러 이미지 검색을 종료하세요</translation>
<translation id="2497422928854452258">{0,plural, =0{João Browser 업데이트 출시}=1{João Browser 업데이트 출시}other{João Browser 업데이트가 출시된 지 #일 지남}}</translation>
<translation id="5643865575100044307">Chromium 종료 시 기기에 있는 사이트 데이터를 항상 삭제</translation>
<translation id="620465883043431255">지금 João Browser을 다시 시작하세요</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">이 언어로 Chromium 표시</translation>
<translation id="569897634095159764">인터넷에 연결할 수 없습니다. 프록시 서버를 인증해야 합니다.</translation>
<translation id="5768371961535086509">Chromium이 비활성 탭에서 메모리를 확보합니다. 이에 따라 활성 탭과 기타 앱에 더 많은 컴퓨터 리소스가 제공되고 Chromium의 빠른 속도가 유지됩니다. 비활성 탭으로 돌아가면 탭이 자동으로 다시 활성화됩니다. <ph name="BEGIN_LINK" />메모리 절약 모드에 관해 자세히 알아보기<ph name="END_LINK" /></translation>
<translation id="8866372822266732235">암호가 기억나지 않거나 이 설정을 변경하려면 계정의 João Browser 데이터를 <ph name="SETTINGS_LINK" />하세요.</translation>
<translation id="2106070764285625641">João Browser을 맞춤설정 및 제어합니다. João Browser을 기본 브라우저로 설정합니다.</translation>
<translation id="9077878413488413377">João Browser을 기본 브라우저로 설정하여 비밀번호, 북마크, 방문 기록을 모든 기기에서 완벽하게 동기화하세요.</translation>
<translation id="5809516625706423866">인터넷에 연결할 수 없습니다(HTTP 401 Unauthorized). 프록시 설정을 확인하시기 바랍니다.</translation>
<translation id="614221876503883218">João Browser의 V8 엔진으로 사이트 속도를 높이지만 João Browser이 공격에 약간 더 취약해집니다. 설정이 사용 중지되어 있습니다.</translation>
<translation id="8788365803279840995">Google 계정에서 João Browser 데이터를 사용하고 저장하려면 João Browser을 업데이트하세요.</translation>
<translation id="5824893331272123205">패널을 로드할 수 없습니다. 다시 시도해 주세요.</translation>
<translation id="5805760187441013922">João Browser에 오신 것을 환영합니다.</translation>
<translation id="5867606647614813312">Chromium의 가장 강력한 보호 기능을 제공하는 추가 기능을 사용 설정합니다.</translation>
<translation id="5871205389137001634">클릭하여 이미지 검색 종료</translation>
<translation id="8367098380158627809">João Browser에서 다음 항목에 멀웨어가 포함된 것을 발견했습니다.</translation>
<translation id="5889361821821684993">Chromium에서는 브라우저가 가장 안전하게 설정되어 있는지 정기적으로 확인합니다. 검토가 필요한 사항이 있으면 알려 드리겠습니다.</translation>
<translation id="5895138241574237353">다시 시작</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - 네트워크 로그인</translation>
<translation id="5924017743176219022">인터넷에 연결 중...</translation>
<translation id="7627350220326904504">João Browser을 사용할 준비가 되셨나요?</translation>
<translation id="5941711191222866238">최소화</translation>
<translation id="8680863040348007215">모든 기기에서 이 북마크 등을 사용하려면 João Browser에 로그인하세요.</translation>
<translation id="2008232276062354182">나만의 João Browser 만들기</translation>
<translation id="5960071705175224773">알 수 없는 앱에서 설정을 변경했습니다</translation>
<translation id="5977420883993828287">고정되었습니다. 툴바에서 맥락에 맞는 작업을 다시 사용해 보세요.</translation>
<translation id="5889362640603897718">{COUNT,plural, =1{João Browser을 1분 동안 사용하지 않으면 조직에서 자동으로 종료합니다.}other{João Browser을 #분 동안 사용하지 않으면 조직에서 자동으로 종료합니다.}}</translation>
<translation id="4971097497342057998">동기화를 시작하려면 João Browser을 업데이트하세요.</translation>
<translation id="5990360079535151574">툴바의 '맥락에 맞는 작업' 버튼에서 맥락에 맞는 작업을 다시 열어 탐색 중에 질문할 수 있습니다.</translation>
<translation id="6003112304606738118">다운로드 중... <ph name="HOURS" />시간 남음</translation>
<translation id="6009821354356307391">이어서 질문하세요.</translation>
<translation id="6040143037577758943">닫기</translation>
<translation id="2100398097168307292"><ph name="DEVICE_TYPE" />에서 João Browser 앱을 사용하여 온라인 쇼핑을 최대한 활용하세요</translation>
<translation id="6058380562449900225">데이터를 보호하려면 최근에 방문하지 않은 사이트의 권한을 Chromium에서 삭제하도록 허용하세요. 알림은 중지되지 않습니다.</translation>
<translation id="4735359759698689867">&amp;João Browser에서 열기</translation>
<translation id="6069027071882229820">이미지로 복사</translation>
<translation id="2274675514456642321"><ph name="EXTENSION_NAME" />이(가) João Browser에 추가됨</translation>
<translation id="147381942282490529">João Browser을 맞춤설정하고 제어하세요. 업데이트가 출시되었습니다.</translation>
<translation id="8775234022739879423">사용 중 • João Browser에서 이 확장 프로그램의 출처를 확인할 수 없습니다.</translation>
<translation id="6634821567165410381">João Browser의 내 계정</translation>
<translation id="4398707227122702993">확장 프로그램이 João Browser 툴바에 액세스 요청을 표시하도록 허용</translation>
<translation id="5370941509199989624"><ph name="FILE_NAME" />은(는) 위험한 파일이므로 João Browser에서 차단했습니다.</translation>
<translation id="5119118887583954582">João Browser이 곧 종료되고 데이터가 삭제됩니다</translation>
<translation id="576637711620229618">여기에서 João Browser 프로필 간에 전환할 수 있습니다.</translation>
<translation id="615103374448673771">사용자가 쿠키를 허용하면 Chromium에서 미리 로드할 때 쿠키를 사용할 수 있습니다.</translation>
<translation id="6165508094623778733">자세히 알아보기</translation>
<translation id="3738215896821824918">계정의 João Browser 데이터 삭제</translation>
<translation id="2145111683361496197">위험한 파일일 수도 있습니다.<ph name="LINE_BREAK" />비밀번호를 제공하면 João Browser에서 이 다운로드 항목을 확인할 수 있습니다. 파일에 관한 정보는 Google 세이프 브라우징으로 전송되지만 파일 콘텐츠와 비밀번호는 기기에 보관됩니다.</translation>
<translation id="6182736845697986886">업데이트 서버 내부 오류로 인해 설치할 수 없습니다.</translation>
<translation id="6050294746023477088"><ph name="TARGET_DEVICE_NAME" />에서 João Browser에 로그인되어 있는지 확인한 다음 다시 전송해 보세요.</translation>
<translation id="3395167674702947885">컴퓨터에 이미 최신 버전의 João Browser이 있습니다. 소프트웨어가 작동하지 않으면 João Browser의 설치를 제거한 뒤 다시 시도하세요.</translation>
<translation id="4384214545531685923">{0,plural, =0{곧 João Browser이 다시 시작됩니다}=1{1초 후 João Browser이 다시 시작됩니다}other{#초 후 João Browser이 다시 시작됩니다}}</translation>
<translation id="5880255774989397049">파일을 다운로드하려면 João Browser에 저장소 액세스 권한이 필요합니다.</translation>
<translation id="6245734527075554892">Chromium에 저장된 안전하지 않은 사이트 목록을 사용하여 URL을 검사합니다.</translation>
<translation id="1959823478027154444">João Browser을 기본 브라우저로 설정</translation>
<translation id="6248988683584659830">설정 검색</translation>
<translation id="9191635841540101343">휴대전화에서 João Browser 앱을 사용하여 이동 중에도 Google 최고의 안전 기능을 이용하세요</translation>
<translation id="538350741885862188">João Browser에서 로그아웃</translation>
<translation id="161121067714522736">이러한 탭은 추가 리소스를 사용하고 있습니다. 성능을 개선하려면 João Browser에서 이러한 탭을 비활성화하도록 허용하세요.</translation>
<translation id="2095090272560293574">João Browser 프로필 맞춤설정</translation>
<translation id="6290827346642914212">Chromium 프로필 이름 지정</translation>
<translation id="6472525517562723285">확장 프로그램에서 João Browser에 로그인하도록 요청합니다</translation>
<translation id="2069878195899746465"><ph name="FILE_NAME" />은(는) 위험할 수 있으므로 João Browser에서 차단했습니다.</translation>
<translation id="1283909912629029170">João Browser이 카메라를 사용 중입니다.</translation>
<translation id="323902744000752306">João Browser에서 다른 작업이 진행 중입니다. 나중에 다시 시도해 주세요.</translation>
<translation id="1292164882596462877">이제 Google 계정으로 공유 컴퓨터에서 João Browser을 손쉽게 사용할 수 있습니다.</translation>
<translation id="6411450594978516531">João Browser을 기본 브라우저로 설정하여 잘 알고 즐겨 사용하며 신뢰하는 기능에 간편하게 액세스하세요.</translation>
<translation id="3344301749774719950">João Browser 바로가기</translation>
<translation id="8395825163097750991">일반적으로 다운로드하지 않는 파일이며 위험할 가능성이 있기 때문에 João Browser에서 이 다운로드를 차단했습니다.</translation>
<translation id="7683737657427846440">João Browser을 제거하시겠습니까?</translation>
<translation id="6375219077595103062">비밀번호 관리자로 연결되는 바로가기를 추가하세요</translation>
<translation id="6388799252195623474">이 문제 해결을 도와줘.</translation>
<translation id="6966523531135953867">계속하려면 <ph name="EMAIL" /> 계정으로 João Browser에 로그인하세요. 이렇게 하면 조직의 정책을 준수할 수 있습니다.</translation>
<translation id="5146608242127807773">컴퓨터 화면에 표시된 João Browser 로고입니다.</translation>
<translation id="6361476216650509195">João Browser은 빠른 속도로 웹페이지와 애플리케이션을 실행하는 웹 브라우저입니다. 빠르고 안정적이며 사용하기에 편리합니다. João Browser에 내장된 멀웨어 및 악성 코드 방지 기능을 사용하여 더욱 안전하게 웹을 검색하세요.</translation>
<translation id="7864687914956920860">언제든지 João Browser 데이터를 사용하고 Google 계정에 저장할 수 있도록 본인 인증을 진행하세요</translation>
<translation id="1160920197193662978">João Browser이 더 빠르게 실행되며 JavaScript를 사용하는 기능이 의도한 대로 작동함</translation>
<translation id="6436260184216827876">이미지 검색을 사용할 수 없습니다. 나중에 다시 시도해 주세요.</translation>
<translation id="6442900851116057561">ChromiumOS 다시 시작</translation>
<translation id="6443470774889161065">Chromium은 사용자가 방문할 때 페이지를 더 빠르게 로드할 수 있도록 사용자가 방문할 가능성이 높은 페이지를 미리 로드합니다.</translation>
<translation id="3730564967922511625">휴대전화에 João Browser을 다운로드하여 가격을 추적하고, 사이트에서 가격이 인하되면 알림을 받으세요.</translation>
<translation id="3753019081686930624">사용 안함 • João Browser에서 이 확장 프로그램의 출처를 확인할 수 없습니다.</translation>
<translation id="5444641426058108434">João Browser 프로필에 오신 것을 환영합니다</translation>
<translation id="5103470775766355478">다음번에 <ph name="DEVICE_TYPE" />에서 João Browser을 열면 탭 그룹을 사용하라는 메시지가 표시됩니다.</translation>
<translation id="9087231386723579740">João Browser에서 계정 삭제</translation>
<translation id="4984395209542302039">또한 João Browser을 시작할 때 표시되는 페이지를 설정합니다.</translation>
<translation id="648319183876919572">향상된 세이프 브라우징은 위험한 웹사이트와 다운로드로부터 사용자를 보호합니다.</translation>
<translation id="1524792685704191751">João Browser 설치 제거</translation>
<translation id="6637504267182028286">João Browser에서 바로가기가 열립니다</translation>
<translation id="1478247638436966279"><ph name="TIMEOUT_DURATION" /> 동안 사용하지 않으면 조직에서 João Browser을 종료합니다. 인터넷 사용 기록이 삭제되었습니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다.</translation>
<translation id="1311233187253046133">각 프로필에는 북마크, 방문 기록, 비밀번호 등과 같은 João Browser 정보가 보관됩니다.</translation>
<translation id="6563921047760808519"><ph name="BEGIN_LINK" />Chromium에서 데이터를 비공개로 유지하는 방법<ph name="END_LINK" /> 자세히 알아보기</translation>
<translation id="1643078533228697915">이 설정의 변경사항은 João Browser을 다시 시작하면 적용됩니다.</translation>
<translation id="1918630514771863338">João Browser 기본 메뉴에서 확장 프로그램을 클릭하여 확장 프로그램을 관리하세요.</translation>
<translation id="4229328298978407243">다른 João Browser 프로필의 비밀번호를 보도록 전환할 수 있습니다.</translation>
<translation id="7717252965531997879">João Browser 앱을 사용하여 이동 중에도 최고의 AI 도구를 활용하세요.</translation>
<translation id="6570579332384693436">맞춤법 오류를 수정하기 위해 Chromium에서 사용자가 입력하는 텍스트를 Google로 전송합니다.</translation>
<translation id="5374627817618267090">João Browser 알림 설정으로 이동</translation>
<translation id="6600016381025017075">이 페이지에 표시된 모든 항목을 검색하세요</translation>
<translation id="264335610358256197">변경사항은 다음에 João Browser을 다시 시작할 때 적용됩니다.</translation>
<translation id="2657584510687441826">이제 Windows 시작 시 João Browser이 실행되므로 즉시 탐색을 시작할 수 있습니다. 설정에서 이 기능을 사용 중지할 수 있습니다</translation>
<translation id="5482413402708094860">중단한 위치에서 계속하기: João Browser에서 마지막 세션의 탭을 복원했습니다. 다음에서 이 기능을 사용 중지할 수 있습니다.</translation>
<translation id="5022765692226673603">João Browser에서 주변의 3D 지도를 만들려면 카메라 권한이 필요합니다.</translation>
<translation id="6669284030132180248">Google 계정에도 북마크를 저장하면 Chromium에서 제품 가격을 추적하고 가격이 인하되면 알림을 받을 수 있습니다.</translation>
<translation id="6676384891291319759">인터넷 연결</translation>
<translation id="668175097507315160">로그인 중 오류가 발생하여 ChromiumOS에서 데이터를 동기화할 수 없습니다.</translation>
<translation id="3982573751008180181">João Browser에서 이 앱 데이터 삭제</translation>
<translation id="5613723096388999601">João Browser에서 사이트에 대한 마이크 권한이 필요합니다.</translation>
<translation id="6712881677154121168">다운로드 오류(<ph name="DOWNLOAD_ERROR" />)가 발생했습니다.</translation>
<translation id="9190188975825967506">João Browser의 최신 버전을 사용하기 때문에 프로필을 사용할 수 없습니다.

일부 기능을 사용할 수 없습니다. 다른 프로필 디렉터리를 지정하거나 João Browser의 새로운 버전을 사용하시기 바랍니다.</translation>
<translation id="6729124504294600478">맞춤설정 및 기타 기능을 사용하려면 웹 및 앱 활동 그리고 연결된 Google 서비스에 Chromium을 포함하세요</translation>
<translation id="6957684879859415418">모든 사용자가 사용할 수 있도록 컴퓨터에 João Browser이 이미 설치되어 있습니다.</translation>
<translation id="4411262692912917677">모든 기기에서 북마크 등을 사용하려면 João Browser에 로그인하세요. 로그인하면 이 북마크가 Google 계정에 저장됩니다.</translation>
<translation id="6064901610880747710">João Browser의 V8 엔진으로 사이트 속도를 높이지만 João Browser이 공격에 약간 더 취약해집니다. 설정이 사용 설정되어 있습니다.</translation>
<translation id="4530735110472079436">{count,plural, =1{João Browser 데이터 중 일부가 아직 Google 계정에 저장되지 않았습니다. 잠시 기다렸다가 로그아웃하세요. 지금 로그아웃하면 이 데이터(항목 1개)가 삭제됩니다}other{João Browser 데이터 중 일부가 아직 Google 계정에 저장되지 않았습니다. 잠시 기다렸다가 로그아웃하세요. 지금 로그아웃하면 이 데이터(항목 {count}개)가 삭제됩니다}}</translation>
<translation id="9176853308971176490">위험할 수 있는 파일이므로 검사하는 것이 좋습니다.</translation>
<translation id="6779406956731413166">ChromiumOS는 추가 <ph name="BEGIN_LINK_CROS_OSS" />오픈소스 소프트웨어<ph name="END_LINK_CROS_OSS" />를 사용하여 개발되었습니다.</translation>
<translation id="6831043979455480757">번역</translation>
<translation id="6412488898785231889">비밀번호가 유출되면 João Browser에서 알려줍니다.</translation>
<translation id="684888714667046800">인터넷에 연결할 수 없습니다. 방화벽을 사용하는 경우 <ph name="PRODUCT_EXE_NAME" />이(가) 허용 목록에 있는지 확인해 주세요.</translation>
<translation id="6750640664545078431">João Browser - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">탭하여 계속하기</translation>
<translation id="6862030660799253820">이미지 검색으로 이 이미지 검색하기</translation>
<translation id="4260365383290377081">João Browser에서 "<ph name="EXTENSION_NAME" />"에 멀웨어가 포함된 것을 발견했습니다.</translation>
<translation id="6877155553248388166">검색 영역의 오른쪽 하단: 오른쪽 <ph name="RIGHT" />%, 하단 <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">복사</translation>
<translation id="6898028264630240901">탐색 중에 질문을 할 수 있도록 맥락에 맞는 작업을 고정할 수 있습니다.</translation>
<translation id="6985817498888719203">João Browser을 기본 브라우저로 설정하고 태스크 바에 고정하세요.</translation>
<translation id="5277424858974213042">João Browser 프로필 관리(&amp;M)</translation>
<translation id="2726137364317931343">이 작업으로 인해 나타날 수 있는 결과는 다음과 같습니다.
          <ph name="LINE_BREAKS" />
            • 시작 페이지, 새 탭 페이지, 검색엔진, 탭 고정 재설정
            <ph name="LINE_BREAK" />
            • 확장 프로그램 사용 중지
            <ph name="LINE_BREAK" />
            • 쿠키 및 기타 임시 사이트 데이터 삭제
            <ph name="LINE_BREAK" />
            • João Browser 바로가기 재설정
            <ph name="LINE_BREAKS" />
            북마크, 방문 기록, 저장된 비밀번호는 영향을 받지 않습니다.</translation>
<translation id="2901988969322822496">João Browser의 북마크 한도인 <ph name="BOOKMARK_LIMIT" />개에 도달하여 북마크 중 일부가 아직 Google 계정에 저장되지 않았습니다.

일부 북마크를 삭제할 때까지 계정에 새 북마크를 저장할 수 없습니다. 지금 로그아웃하면 저장되지 않은 북마크가 삭제됩니다.</translation>
<translation id="6203410920314218280">João Browser 시크릿 창에서 링크 열기(&amp;G)</translation>
<translation id="6965382102122355670">확인</translation>
<translation id="6985329841647292029">ChromiumOS 약관</translation>
<translation id="8064285182627814996"><ph name="ACCOUNT_EMAIL" /> 계정에서 João Browser 데이터를 사용하고 저장하려면 비밀번호를 입력하세요</translation>
<translation id="7011190694940573312">이 운영체제 버전은 지원되지 않으므로 설치에 실패했습니다.</translation>
<translation id="7024536598735240744">압축해제 오류(<ph name="UNPACK_ERROR" />)가 발생했습니다.</translation>
<translation id="181803036615530330">나만의 João Browser 만들기</translation>
<translation id="7047386856539490735">결과가 유용한가요?</translation>
<translation id="2478245051737698828">João Browser 업데이트</translation>
<translation id="452909342278940733">이미지에 유용한 설명이 없으면 João Browser에서 자동으로 설명을 제공하려고 시도합니다. 설명을 생성하기 위해 이미지가 Google로 전송됩니다.</translation>
<translation id="8606769615526968368"><ph name="DEVICE_TYPE" />에서 João Browser 앱을 사용하여 AI의 강력한 기능을 활용하세요</translation>
<translation id="2061960765882453684">휴대전화에서 João Browser 앱을 사용하여 이동 중에도 비밀번호, 탭 등을 이용하세요</translation>
<translation id="7141270731789036260">Chrome for Testing 맞춤설정</translation>
<translation id="7147227333672430807">언제든지 메시지, 문서, 기타 앱에서 링크를 클릭하여 Chromium을 사용할 수 있습니다.</translation>
<translation id="6949173677980969871"><ph name="EXTENSION_NAME" /> 확장 프로그램을 João Browser에서 제거</translation>
<translation id="3556355753960287061"><ph name="TIMEOUT_DURATION" /> 동안 사용하지 않으면 조직에서 João Browser 데이터를 삭제합니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다.</translation>
<translation id="8689006320829658442">João Browser에서 사이트에 대한 카메라 권한이 필요합니다.</translation>
<translation id="7501884108538572227">João Browser을 실행할 수 없습니다. 다시 시도해 보세요.</translation>
<translation id="5484563502710761706">어디서든 무엇이든 João Browser의 Gemini에게 물어보세요</translation>
<translation id="3823264355161086552">João Browser을 도크에 고정하여 언제든지 빠르게 액세스하세요.</translation>
<translation id="9153902741226700840">언제든지 메시지, 문서 및 다른 앱에서 링크를 클릭하여 João Browser을 사용하세요</translation>
<translation id="7216228761061470870">데스크톱에서 이미지 검색을 사용하면 페이지 제목, URL, PDF를 포함한 콘텐츠가 서버로 전송됩니다.</translation>
<translation id="7950844619283784703">작업 관리자 - João Browser</translation>
<translation id="133513825972536773"><ph name="EXISTING_USER" /> 계정은 이미 로그인되어 있습니다. 방문 기록을 별도로 보관하려면 내 프로필에서 <ph name="USER_EMAIL_ADDRESS" /> 주소로 João Browser에 로그인하세요. 이렇게 하면 모든 기기에서 저장된 정보 등을 사용할 수 있습니다.</translation>
<translation id="4558982617284733740">즉시 탐색 시작: 이제 Windows 시작 시 João Browser을 실행할 수 있습니다.</translation>
<translation id="7274695763216404502">고정되었습니다. 툴바에서 이미지 검색을 다시 사용해 보세요.</translation>
<translation id="7288567540154601580">탭 및 확장 프로그램</translation>
<translation id="5494571279964989269">{NUM_EXTENSIONS,plural, =1{João Browser에서 삭제할 것을 권장합니다.}other{João Browser에서 삭제할 것을 권장합니다.}}</translation>
<translation id="2269053214123323740">시스템 오디오를 공유하려면 시스템 설정을 열고 João Browser에 대해 '시스템 오디오 녹음만'을 허용하세요. 그런 다음 João Browser을 다시 시작해야 합니다.</translation>
<translation id="731795002583552498">Chromium 업데이트 중</translation>
<translation id="9065168747010082551">환경설정 파일이 손상되었거나 잘못되었습니다.

João Browser에서 설정을 복구할 수 없습니다.</translation>
<translation id="7324051657739063017">맥락에 맞는 작업을 다시 열어 탐색 중에 질문할 수 있습니다,</translation>
<translation id="4159250197688136733">웹, 북마크 및 기타 João Browser 콘텐츠가 여기에 저장됩니다.</translation>
<translation id="7347827960336370838">암호를 아는 사람만 암호화된 내 데이터를 읽을 수 있습니다. 암호는 Google로 전송되거나 Google에 저장되지 않습니다. 암호가 기억나지 않거나 이 설정을 변경하려면 <ph name="BEGIN_LINK" />계정에서 Chromium 데이터를 삭제<ph name="END_LINK" />해야 합니다.</translation>
<translation id="1062903713270840396">시스템 관리자가 <ph name="TARGET_URL_HOSTNAME" /> 액세스를 위해 <ph name="ALTERNATIVE_BROWSER_NAME" />을(를) 열도록 João Browser을 구성했습니다.</translation>
<translation id="7352651011704765696">문제가 발생했습니다</translation>
<translation id="5817362738974335084">향후 João Browser 업데이트를 받으려면 macOS 13 이상이 필요합니다. 이 컴퓨터에서는 macOS 12를 사용 중입니다.</translation>
<translation id="7376384068949534168">최근에 사이트를 방문하지 않았습니다. Chromium에서 <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> 권한을 삭제했습니다.</translation>
<translation id="73786666777299047">Chrome 웹 스토어 열기</translation>
<translation id="5724625487458697703">작업 표시줄에 João Browser의 Gemini 표시</translation>
<translation id="7401687852903179959">이미지 검색으로 이 동영상 검색</translation>
<translation id="1088684725931971005">João Browser이 기본 브라우저로 설정됨</translation>
<translation id="7479848806300971661">중단한 위치에서 계속하기: João Browser은 다시 시작할 때마다 탭을 복원합니다. 이 기능을 사용 중지하려면 다음으로 이동하세요.</translation>
<translation id="1258077876605261365">João Browser으로 비밀번호 가져오기</translation>
<translation id="5293062713751091377">1. 아래의 <ph name="BUTTON_LABEL" /> 버튼을 클릭합니다.
2. Windows 설정에서 <ph name="BUTTON_2" /> 버튼을 클릭합니다.
3. 빠른 액세스를 위해 Windows 알림에서 <ph name="BUTTON_3" /> 버튼을 클릭하여 João Browser을 작업 표시줄에 고정합니다.</translation>
<translation id="1941496545060769345"><ph name="PAGE_TITLE" /> - 개발자용 João Browser</translation>
<translation id="7450541714075000668">텍스트 복사됨</translation>
<translation id="7458892263350425044">마이크를 사용하려면 <ph name="BEGIN_LINK" />시스템 설정<ph name="END_LINK" />에서 Chromium에 액세스 권한을 부여하세요.</translation>
<translation id="5422859338435319909">향후 João Browser 업데이트를 받으려면 Windows 10 이상이 필요합니다. 이 컴퓨터에서는 Windows 7을 사용 중입니다.</translation>
<translation id="7467949745582939695">Chromium을 다시 시작하시겠습니까?</translation>
<translation id="7707324976708178089">이미 실행 중인 João Browser과 동일한 버전을 설치할 수 없습니다. João Browser을 종료한 뒤 다시 시도하세요.</translation>
<translation id="7510190804000607802">알림: 주머니에 쏙 들어가는 최고의 Google 기능</translation>
<translation id="751935028865900641">사이트가 정상적으로 작동할 것입니다. Chromium에 로그인한 경우 Google 계정을 제외한 모든 Chromium 창을 닫으면 대부분의 사이트에서 로그아웃됩니다.</translation>
<translation id="5325102834460669866">{0,plural, =1{1분 후 João Browser이 다시 시작됩니다}other{#분 후 João Browser이 다시 시작됩니다}}</translation>
<translation id="7565444033145385702">데이터를 보호하려면 최근에 방문하지 않은 사이트의 권한을 Chromium에서 삭제하도록 허용하세요.</translation>
<translation id="8099958128052689767">João Browser을 자동으로 실행하여 즉시 탐색을 시작하세요.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> 설치 프로그램</translation>
<translation id="7125257608567714221">João Browser이 카메라와 마이크를 사용 중입니다.</translation>
<translation id="227045421902171569">더욱 업그레이드된 João Browser</translation>
<translation id="5356567285381070312">이제 João Browser에서 더 많은 기능을 사용할 수 있습니다.</translation>
<translation id="7624307931717240213">이 정보는 서비스 개선에 사용됩니다. 개인정보처리방침 및 서비스 약관을 확인하세요.</translation>
<translation id="7649070708921625228">도움말</translation>
<translation id="5714374331629713291">João Browser 앱 다운로드</translation>
<translation id="7658239707568436148">취소</translation>
<translation id="549378870470819535">João Browser이 기본 브라우저로 설정되어 있지 않습니다</translation>
<translation id="6574348346278803862">모든 기기에서 João Browser을 동기화하고 맞춤설정하세요.</translation>
<translation id="7699779824407626136">Chromium 업데이트</translation>
<translation id="3304080024230377341">João Browser에서 업무 보호</translation>
<translation id="7716950018788545737">작업이 종료되었습니다.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME" />에 시스템 추적 서비스가 제공됩니다. 이 서비스를 사용 중지하면 브라우저에서 생성한 성능 추적에 컨텍스트 전환 및 준비된 스레드 이벤트와 같은 시스템 전체 이벤트가 포함되지 않습니다.</translation>
<translation id="7745317241717453663">인터넷 사용 기록이 기기에서 삭제됩니다. 나중에 데이터를 가져오려면 Chromium에 <ph name="USER_EMAIL" />(으)로 로그인하세요.</translation>
<translation id="7747138024166251722">설치 프로그램이 임시 디렉터리를 만들지 못했습니다. 디스크 공간 및 설치 권한을 확인해 보세요.</translation>
<translation id="4713120944298974980">João Browser에서 검색</translation>
<translation id="5804390944809171853">기본 João Browser으로 재설정</translation>
<translation id="6930487390575519812">João Browser에서 업무를 보호하기 위해 João Browser에 로그인하면 조직에서 특정 정보를 보거나 관리할 수 있습니다</translation>
<translation id="5214761769821670245">João Browser을 기본 브라우저로 설정하고 작업 표시줄에 고정하세요</translation>
<translation id="1294697217796985566">João Browser의 속도를 높여보세요</translation>
<translation id="1278345486417353853"><ph name="PAGE_TITLE" /> - João Browser Canary</translation>
<translation id="7803986347287457849">내 인터넷 트래픽에 액세스할 수 있는 사용자가 내가 방문하는 사이트를 확인하기가 더 어려워집니다. Chromium은 DNS(도메인 이름 시스템)에서 사이트의 IP 주소를 조회하는 데 보안 연결을 사용합니다.</translation>
<translation id="7810005234485217901">이미지 검색을 고정하면 쉽게 액세스할 수 있습니다</translation>
<translation id="489728561211958943">이 계정을 사용하는 João Browser 프로필이 기기에 이미 존재합니다</translation>
<translation id="7845233973568007926">설치해 주셔서 감사합니다. <ph name="BUNDLE_NAME" />을(를) 사용하려면 컴퓨터를 다시 시작해야 합니다.</translation>
<translation id="5294768452950207882">João Browser 외부에서 검색엔진이 변경되었습니다. 사용자를 보호하기 위해 João Browser에서 검색엔진을 기본값으로 재설정했습니다. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3244974069468656925">João Browser을 맞춤설정하여 새로운 디자인으로 변경하세요.</translation>
<translation id="7859018312476869945">주소 표시줄이나 검색창에 검색어를 입력하면 Chromium은 더 나은 추천 검색어를 제공하기 위해 사용자가 입력한 내용을 기본 검색엔진으로 전송합니다. 시크릿 모드에서는 이 기능이 사용 중지되어 있습니다.</translation>
<translation id="6517519572778941051">João Browser을 최신 버전으로 업데이트하지 못했기 때문에 새로운 기능과 보안 수정 사항이 적용되지 않았습니다.</translation>
<translation id="7872446069773932638">다운로드 중... <ph name="SECONDS" />초 남았습니다.</translation>
<translation id="7873537467422636035">암호가 기억나지 않거나 이 설정을 변경하려면 <ph name="BEGIN_LINK" />계정에서 Chromium 데이터를 삭제<ph name="END_LINK" />하세요</translation>
<translation id="1722038268139386345">필요할 때마다 빠르게 João Browser의 Gemini를 여세요</translation>
<translation id="8344320926817290924">João Browser을 기본 브라우저로 설정</translation>
<translation id="7934340546140346950">가능한 경우 Chromium이 비보안 연결을 HTTPS로 자동 업그레이드합니다.</translation>
<translation id="3755057387338907970"><ph name="USER_EMAIL_ADDRESS" />(으)로 João Browser에 로그인되어 있습니다. 같은 계정으로 다시 로그인해 주세요.</translation>
<translation id="929903348843569380"><ph name="EXISTING_USER" /> 계정은 이미 로그인되어 있습니다. 방문 기록을 별도로 보관하려면 내 프로필에서 <ph name="USER_EMAIL_ADDRESS" /> 주소로 João Browser에 로그인하세요. 이렇게 하면 모든 기기에서 북마크 등을 사용할 수 있습니다.</translation>
<translation id="7975919845073681630">Chromium의 보조 설치이며 기본 브라우저로 설정할 수 없습니다.</translation>
<translation id="8905411496853397218">알 수 없는 소스의 확장 프로그램, 앱, 테마는 기기를 손상시킬 수 있습니다. <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />에서 다운로드한 확장 프로그램, 앱, 테마만 설치하는 것이 좋습니다</translation>
<translation id="6306672714476596428"><ph name="DEVICE_TYPE" />에서 João Browser 앱을 사용하여 Google 기능을 최대한 활용하세요</translation>
<translation id="8004582292198964060">브라우저</translation>
<translation id="8010081455002666927">자동 감지</translation>
<translation id="2172829664765531568">João Browser에 액세스 권한을 부여하면 웹사이트에서 액세스 권한을 요청할 수 있게 됩니다.</translation>
<translation id="74641100973032765">언제든지 빠르게 액세스할 수 있도록 João Browser을 작업 표시줄에 고정하세요.</translation>
<translation id="80471789339884597">설치해 주셔서 감사합니다. <ph name="BUNDLE_NAME" />을(를) 사용하려면 모든 브라우저를 다시 시작해야 합니다.</translation>
<translation id="8054112667659782652">이미지 검색 바로가기 항상 표시</translation>
<translation id="8069447462453318634">'툴바에 고정'을 선택합니다.</translation>
<translation id="5039671129725402518">앱에서 백그라운드 실행 중인 João Browser 사용 중지</translation>
<translation id="80790299200510644">이미지 검색</translation>
<translation id="8086881907087796310">컴퓨터가 최소 하드웨어 요구사항을 충족하지 않으므로 설치에 실패했습니다.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Chrome for Testing</translation>
<translation id="2430877582155731716">João Browser에서 사이트에 대한 위치 정보 액세스 권한이 필요합니다.</translation>
<translation id="8298045348217323">다음번에 <ph name="DEVICE_TYPE" />에서 João Browser을 열면 가격 추적 알림을 사용 설정하라는 메시지가 표시됩니다.</translation>
<translation id="3827347991254458074">휴대전화에서 João Browser 앱을 사용하여 관심 있는 상품의 가격 인하 알림을 받으세요</translation>
<translation id="8118331347066725040">렌즈로 검색에 관한 의견 보내기</translation>
<translation id="2580039965224265556">나만의 João Browser 만들기</translation>
<translation id="8133124826068723441">내 도메인에서 동기화를 사용할 수 없으므로 ChromiumOS에서 데이터를 동기화할 수 없습니다.</translation>
<translation id="813913629614996137">초기화 중...</translation>
<translation id="7940955011992997426">키보드 단축키를 사용하여 João Browser의 Gemini를 엽니다.</translation>
<translation id="7560319627203819845">João Browser 추가 서비스 약관</translation>
<translation id="7133741820744999589">이 파일은 위험하므로 João Browser에서 차단했습니다.</translation>
<translation id="8177472873527554730">페이지의 콘텐츠를 찾을 수 없음</translation>
<translation id="8200109504272824693"><ph name="USER_EMAIL" /> 계정에서 Chromium 데이터를 사용하고 저장하려면 비밀번호를 입력하세요</translation>
<translation id="820759916613250543">이미지 검색으로 이 이미지 검색</translation>
<translation id="8221491193165283816">기본적으로 알림을 차단하는 중입니다. 이 사이트의 알림을 허용하려면 여기를 클릭하세요.</translation>
<translation id="8223363452568144035">카메라를 사용하려면 <ph name="BEGIN_LINK" />시스템 설정<ph name="END_LINK" />에서 Chromium에 액세스 권한을 부여하세요.</translation>
<translation id="8132864687089402359">João Browser에서 이 확장 프로그램의 출처를 확인할 수 없습니다. 안전하지 않은 확장 프로그램일 수 있습니다. 더 이상 개인 정보를 비롯한 방문 사이트의 데이터를 확인하고 변경할 수 없도록 João Browser에서 이 확장 프로그램을 삭제하세요.</translation>
<translation id="7600652022483599804">이미지에 유용한 설명이 없으면 João Browser에서 자동으로 설명을 제공하려고 시도합니다. 설명을 생성하기 위해 이미지가 Google로 전송됩니다. 이 기능은 언제든지 설정에서 사용 중지할 수 있습니다.</translation>
<translation id="8703735741562140394">새 프로필로 João Browser에 로그인하시겠습니까?</translation>
<translation id="2830039647655087365"><ph name="EXISTING_USER" /> 계정은 이미 로그인되어 있습니다. 방문 기록을 별도로 보관하려면 내 프로필에서 <ph name="USER_EMAIL_ADDRESS" /> 주소로 João Browser에 로그인하세요. 이렇게 하면 <ph name="DEVICE" />에서 비밀번호 등을 사용할 수 있습니다.</translation>
<translation id="1802935470126307750">작업 표시줄에 João Browser의 Gemini 표시 및 키보드 단축키 사용 설정</translation>
<translation id="8286943863733751221">안전하지 않은 사이트 및 다운로드에 대해 <ph name="BEGIN_LINK" />Chromium에서 경고<ph name="END_LINK" /></translation>
<translation id="8295827201165805317">최근에 사이트를 방문하지 않았습니다. Chromium에서 <ph name="PERMISSION" /> 권한을 삭제했습니다.</translation>
<translation id="481989138594406896">iOS용 João Browser 앱에서 카메라를 사용해 눈앞의 물건을 쇼핑하고, 번역하고, 알아보세요.</translation>
<translation id="5242426961520127942"><ph name="USER_NAME" /> 계정으로 João Browser에 로그인하기 위한 QR 코드</translation>
