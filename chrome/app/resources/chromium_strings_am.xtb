<translation id="8775234022739879423">በርቷል • João Browser ይህ ቅጥያ ከየት እንደመጣ ማረጋገጥ አይችልም</translation>
<translation id="6634821567165410381">João Browser ውስጥ ያለ መለያዎ</translation>
<translation id="4398707227122702993">ቅጥያ በJoão Browser የመሣሪያ አሞሌ ውስጥ የመዳረሻ ጥያቄዎችን እንዲያሳይ ፍቀድ</translation>
<translation id="5370941509199989624"><ph name="FILE_NAME" /> አደገኛ ነው፣ ስለዚህ João Browser አግዶታል።</translation>
<translation id="5119118887583954582">João Browser በቅርቡ ይዘጋል እና ውሂብ ይሰርዛል</translation>
<translation id="576637711620229618">እዚህ በJoão Browser መገለጫዎች መካከል መቀያየር ይችላሉ</translation>
<translation id="615103374448673771">ኩኪዎችን ከፈቀዱ Chromium ቅድሚያ በመጫን ጊዜ ሊጠቀምባቸው ይችላል</translation>
<translation id="6165508094623778733">የበለጠ ለመረዳት</translation>
<translation id="3738215896821824918">በመለያዎ ውስጥ የJoão Browser ውሂብን ያጽዱ</translation>
<translation id="2145111683361496197">ይህ ፋይል አደገኛ ሊሆን ይችላል<ph name="LINE_BREAK" />የይለፍ ቃሉን ካቀረቡ João Browser ይህንን ውርድ ሊፈትሽልዎ ይችላል። የፋይሉ መረጃ ወደ የGoogle ጥንቃቄ አሰሳ ይላካል፣ ነገር ግን የፋይሉ ይዘት እና የይለፍ ቃል በመሣሪያዎ ላይ ይቆያሉ።</translation>
<translation id="6182736845697986886">በዝማኔ አገልጋይ የውስጥ ስህተት ምክንያት መጫኑ አልተሳካም።</translation>
<translation id="6050294746023477088">በእርስዎ <ph name="TARGET_DEVICE_NAME" /> ላይ በመለያ ወደ João Browser መግባትዎን ያረጋግጡ እና እንደገና ለመላክ ይሞክሩ።</translation>
<translation id="3395167674702947885">ይህ ኮምፒውተር አስቀድሞ ይበልጥ አዲስ የሆነ የJoão Browser ስሪት አለው። ሶፍትዌሩ የማይሰራ ከሆነ እባክዎ João Browserን ያራግፉና እንደገና ይሞክሩ።</translation>
<translation id="4384214545531685923">{0,plural, =0{João Browser አሁን ዳግም ይጀመራል}=1{João Browser በ1 ሰከንድ ውስጥ ዳግም ይጀመራል}one{João Browser በ# ሰከንዶች ውስጥ ዳግም ይጀመራል}other{João Browser በ# ሰከንዶች ውስጥ ዳግም ይጀመራል}}</translation>
<translation id="5880255774989397049">João Browser ፋይሎችን ለማውረድ የማከማቻ መዳረሻ ፈቃድ ያስፈልገዋል</translation>
<translation id="6245734527075554892">በChromium ላይ በተከማቹ ደህንነታቸው ያልተጠበቁ ጣቢያዎች ዝርዝር ጋር ዩአርኤሎችን ይፈትሻል</translation>
<translation id="1959823478027154444">João Browser ነባሪውን አሳሽ ያድርጉ።</translation>
<translation id="6248988683584659830">የፍለጋ ቅንብሮች</translation>
<translation id="9191635841540101343">በመሄድ ላይ ሳሉ በስልክዎ ላይ በJoão Browser መተግበሪያ የGoogleን ምርጥ የደህንነት ባህሪያት ያግኙ</translation>
<translation id="538350741885862188">ከJoão Browser ተዘግቶ ይውጣ?</translation>
<translation id="161121067714522736">እነዚህ ትሮች ተጨማሪ ንብረቶችን እየተጠቀሙ ነው። አፈፃፀምዎን ለማሻሻል João Browser እንዲያቦዝናቸው ይፍቀዱ።</translation>
<translation id="2095090272560293574">የJoão Browser መገለጫዎን ያብጁ</translation>
<translation id="6290827346642914212">የChromium መገለጫዎን ይሰይሙ</translation>
<translation id="6472525517562723285">አንድ ቅጥያ ወደ João Browser እንዲገቡ ይፈልጋል</translation>
<translation id="2069878195899746465"><ph name="FILE_NAME" /> አደገኛ ሊሆን ስለሚችል João Browser አግዶታል።</translation>
<translation id="1283909912629029170">João Browser ካሜራዎን እየተጠቀመ ነው።</translation>
<translation id="323902744000752306">ሌላ ሥርዓተ ክወና በJoão Browser ላይ በሂደት ላይ ነው። እባክዎ ቆይተው እንደገና ይሞክሩ።</translation>
<translation id="1292164882596462877">አሁን João Browserን ከGoogle መለያዎ ጋር እና በተጋሩ ኮምፒውተሮች ላይ መጠቀም ይበልጥ ቀላል ነው።</translation>
<translation id="6411450594978516531">João Browserን እንደ ነባሪ አሳሽዎ በማቀናበር የሚያውቋቸውን፣ የሚወዷቸውን እና የሚያምኗቸውን ባህሪያት ቀላል መዳረሻ ያግኙ።</translation>
<translation id="3344301749774719950">የJoão Browser አቋራጭ</translation>
<translation id="8395825163097750991">ፋይሉ በተለምዶ ስላማይወርድ እና አደገኛ ሊሆን ስለሚችል João Browser ይህን ውርድ አግዷል</translation>
<translation id="7683737657427846440">እርግጠኛ ነዎት João Browserን ማራገፍ ይፈልጋሉ?</translation>
<translation id="6375219077595103062">ለየሚስጥር ቁልፍ አስተዳዳሪ አቋራጭ ያክሉ</translation>
<translation id="6388799252195623474">በዚህ አግዘኝ</translation>
<translation id="6966523531135953867">ለመቀጠል እንደ <ph name="EMAIL" /> ወደ João Browser ይግቡ። ይህ የድርጅትዎ መመሪያዎች እንዳሉዎት ያረጋግጣል።</translation>
<translation id="5146608242127807773">በኮምፒውተር ማያ ገፅ ውስጥ የJoão Browser ዓርማ።</translation>
<translation id="6361476216650509195">João Browser ድረ-ገጾችን እና መተግበሪያዎችን እጅግ በጣም ፈጣን በሆነ ፍጥነት የሚያሄድ ድር አሳሽ ነው። ፈጣን፣ የረጋ እና ለመጠቀም ቀላል ነው። João Browser ውስጥ አብሮ በተሰራላቸው የተንኮል-አዘል ሶፍትዌር እና የማስገሪያ መከላከያዎች አማካኝነት ደህንነትዎ ይበልጥ በተጠበቀ ሁኔታ ድሩን ያስሱ።</translation>
<translation id="7864687914956920860">በGoogle መለያዎ ውስጥ የJoão Browser ውሂብን ሁልጊዜ መጠቀም እና ማስቀመጥ መቻልዎን ለማረጋገጥ እርስዎ መሆንዎን ያረጋግጡ</translation>
<translation id="1160920197193662978">João Browser ይበልጥ በፍጥነት ያሄዳል እና ጃቫስክሪፕት የሚጠቀሙ ባህሪያት እንደተነደፉት መስራት አለባቸው</translation>
<translation id="6436260184216827876">የምስል ፍለጋ አይገኝም። ቆይተው እንደገና ይሞክሩ።</translation>
<translation id="6442900851116057561">ChromiumOSን ዳግም አስጀምር</translation>
<translation id="6443470774889161065">እርስዎ የመጎብኘት ዕድልዎ ከፍተኛ የሆኑባቸው ተጨማሪ ገጾች ሲጎበኟቸው ይበልጥ በፍጥነት እንዲጫኑ Chromium በቅድሚያ ይጭናቸዋል</translation>
<translation id="3730564967922511625">ዋጋዎችን ለመከታተል እና ዋጋው በማንኛውም ጣቢያ ላይ ሲቀንስ ማንቂያዎችን ለማግኘት João Browserን በስልክዎ ላይ ያውርዱ</translation>
<translation id="3753019081686930624">ጠፍቷል • João Browser ይህ ቅጥያ ከየት እንደመጣ ማረጋገጥ አይችልም</translation>
<translation id="5444641426058108434">ወደ João Browser መገለጫዎች እንኳን በደህና መጡ</translation>
<translation id="5103470775766355478">በሚቀጥለው ጊዜ João Browserን በእርስዎ <ph name="DEVICE_TYPE" /> ላይ ሲከፍቱ፣ የትር ቡድኖችን ለመጠቀም ጥያቄ ያያሉ።</translation>
<translation id="9087231386723579740">መለያን ከJoão Browser አስወግድ</translation>
<translation id="4984395209542302039">እንዲሁም João Browserን ሲጀምሩት የሚታየውን ገፅ ይቆጣጠራል።</translation>
<translation id="648319183876919572">የተሻሻለ የደህንነት አሰሳ እርስዎን ከአደገኛ ድር ጣቢያዎች እና ውርዶች ለመጠበቅ ይበልጥ ያደርጋል</translation>
<translation id="1524792685704191751">João Browserን ያራግፉ</translation>
<translation id="6637504267182028286">አቋራጮች በJoão Browser ውስጥ ይከፍታሉ</translation>
<translation id="1478247638436966279">ድርጅትዎ João Browser ለ<ph name="TIMEOUT_DURATION" /> ያህል ሥራ ላይ ሳይውል ይዘጋዋል። የአሰሳ ውሂብ ተሰርዟል። ይህ ታሪክን፣ ራስ-ሙላን እና ውርዶችን ሊያካትት ይችላል።</translation>
<translation id="1311233187253046133">እያንዳንዱ መገለጫ እንደ ዕልባቶች፣ ታሪክ፣ የይለፍ ቃላት እና ሌሎችም ያሉ የራሱ የJoão Browser መረጃዎችን ይይዛል</translation>
<translation id="6563921047760808519"><ph name="BEGIN_LINK" />Chromium እንዴት የእርስዎን ውሂብ በግል እንደሚያስቀምጥ<ph name="END_LINK" /> የበለጠ ይወቁ</translation>
<translation id="1643078533228697915">አንዴ João Browser እንደገና ከጀመረ በኋላ በዚህ ቅንብር ላይ ያሉ ለውጦች ይተገበራሉ።</translation>
<translation id="1918630514771863338">በJoão Browser ዋና ምናሌ ውስጥ ቅጥያዎች የሚለውን ጠቅ በማድረግ ቅጥያዎችዎን ያስተዳድሩ።</translation>
<translation id="4229328298978407243">ከሌላ የJoão Browser መገለጫ የይለፍ ቃላትን ለማየት መቀየር ይችላሉ</translation>
<translation id="7717252965531997879">በመሄድ ላይ ሳሉ ምርጥ የሰው ሠራሽ አስተውሎት መሣሪያዎችን ለመውሰድ የJoão Browser መተግበሪያን ይጠቀሙ</translation>
<translation id="6570579332384693436">የሥርዓተ ፊደል አጻጻፍ ስህተቶችን ለማስተካከል፣ Chromium እርስዎ በጽሁፍ መስኮች ውስጥ የሚተይቡትን ጽሁፍ ወደ Google ይልካል</translation>
<translation id="5374627817618267090">ወደ የJoão Browser ማሳወቂያ ቅንብሮች ይሂዱ</translation>
<translation id="6600016381025017075">በዚህ ገጽ ላይ ማንኛውንም ነገር ይፈልጉ</translation>
<translation id="264335610358256197">ለውጦችዎ João Browser በሚያስጀምሩበት ቀጣዩ ጊዜ ላይ ይተገበራሉ።</translation>
<translation id="2657584510687441826">አሁን ላይ Windows ሲጀምር João Browser ይጀመራል ስለዚህ እርስዎ በቅጽበት ማሰስ መጀመር ይችላሉ። ይህን በቅንብሮች ውስጥ ማጥፋት ይችላሉ።</translation>
<translation id="5482413402708094860">ካቆሙበት ይቀጥሉ፦ João Browser የእርስዎን ትሮች ከመጨረሻው ክፍለ ጊዜዎ ወደነበሩበት ይመልሳል። ይህን የሚከተለው ውስጥ ማጥፋት ይችላሉ</translation>
<translation id="5022765692226673603">João Browser የዙሪያዎን የ3ል ካርታ ለመፍጠር የካሜራ ፈቃድ ያስፈልገዋል</translation>
<translation id="6669284030132180248">እንዲሁም ዕልባቶችዎን በእርስዎ Google መለያ ውስጥ ካስቀመጡ Chromium ውስጥ የምርት ዋጋዎችን መከታተል እና ዋጋው ሲቀንስ ማሳወቂያ ማግኘት ይችላሉ</translation>
<translation id="6676384891291319759">በይነመረብን ተዳረስ</translation>
<translation id="668175097507315160">በመለያ ሲገባ በነበረ ስህተት ምክንያት &amp;ChromiumOS ውሂብዎን ማስመር አልቻለም።</translation>
<translation id="3982573751008180181">የዚህን መተግበሪያ ውሂብ ከJoão Browser ላይ ያስወግዱ</translation>
<translation id="5613723096388999601">João Browser ለዚህ ጣቢያ የማይክሮፎን ፈቃድ ያስፈልገዋል</translation>
<translation id="6712881677154121168">የማውረድ ስህተት፦ <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="9190188975825967506">መገለጫዎ ከአዲስ የJoão Browser ስሪት ስለሆነ የመጣው ሥራ ላይ ሊውል አይችልም።

አንዳንድ ባህሪያት ላይገኙ ይችላሉ። እባክዎ የተለየ የመገለጫ አቃፊ ይግለጹ ወይም ይበልጥ አዲስ የሆነ የJoão Browser ስሪት ይጠቀሙ።</translation>
<translation id="6729124504294600478">ግላዊነት ማላበስን እና ሌሎች ባህሪያትን ለማግኘት Chromiumን በድር እና በመተግበሪያ እንቅስቃሴ እና በተገናኙ የGoogle አገልግሎቶች ውስጥ ያካትቱ</translation>
<translation id="6957684879859415418">João Browser ለሁሉም በእርስዎ ኮምፒውተር ላይ ላሉ ተጠቃሚዎች አስቀድሞ ተጭኗል።</translation>
<translation id="4411262692912917677">የእርስዎን ዕልባቶች እና ሌሎችንም በሁሉም መሣሪያዎችዎ ላይ ለማግኘት ወደ João Browser ይግቡ በመለያ ከገቡ በኋላ ይህ ዕልባት Google መለያዎ ውስጥ ይቀመጣል።</translation>
<translation id="6064901610880747710">በJoão Browser V8 ሞተር ጣቢያዎችን ያፋጥናል ነገር ግን የJoão Browserን ጥቃቶችን የመቋቋም አቅም በመጠኑ ያነሰ ያደርገዋል። ይህ ቅንብር በርቷል።</translation>
<translation id="4530735110472079436">{count,plural, =1{የተወሰነ የJoão Browser ውሂብዎ በGoogle መለያዎ ውስጥ ገና አልተቀመጠም። ዘግተው ከመውጣትዎ በፊት ጥቂት ደቂቃዎች ለመጠበቅ ይሞክሩ። አሁን ዘግተው ከወጡ ይህ ውሂብ (1 ንጥል) ይሰረዛል።}one{የተወሰነ የJoão Browser ውሂብዎ በGoogle መለያዎ ውስጥ ገና አልተቀመጠም። ዘግተው ከመውጣትዎ በፊት ጥቂት ደቂቃዎች ለመጠበቅ ይሞክሩ። አሁን ዘግተው ከወጡ ይህ ውሂብ ({count} ንጥል) ይሰረዛል።}other{የተወሰነ የJoão Browser ውሂብዎ በGoogle መለያዎ ውስጥ ገና አልተቀመጠም። ዘግተው ከመውጣትዎ በፊት ጥቂት ደቂቃዎች ለመጠበቅ ይሞክሩ። አሁን ዘግተው ከወጡ ይህ ውሂብ ({count} ንጥሎች) ይሰረዛል።}}</translation>
<translation id="9176853308971176490">João Browser ይህ ፋይል አደገኛ ሊሆን ስለሚችል እንዲቃኙት ይመክራል።</translation>
<translation id="6779406956731413166">ChromiumOS በተጨማሪ <ph name="BEGIN_LINK_CROS_OSS" />ክፍት ምንጭ ሶፍትዌር<ph name="END_LINK_CROS_OSS" /> እውን ሊሆን ችሏል።</translation>
<translation id="6831043979455480757">መተርጎም</translation>
<translation id="6412488898785231889">João Browser የእርስዎ የይለፍ ቃላት ከተነጠቁ እርስዎ እንዲያውቁት ያደርግዎታል</translation>
<translation id="684888714667046800">ከበይነመረቡ ጋር መገናኘት አልተቻለም። ኬላ የሚጠቀሙ ከሆነ እባክዎ <ph name="PRODUCT_EXE_NAME" /> በተፈቀደ ዝርዝር ውስጥ መሆኑን ያረጋግጡ።</translation>
<translation id="6750640664545078431">João Browser - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">ለመቀጠል ትር</translation>
<translation id="6862030660799253820">ይህን ምስል በምስል ፍለጋ ይፈልጉ</translation>
<translation id="4260365383290377081">João Browser «<ph name="EXTENSION_NAME" />» ተንኮል አዘል ዌር እንደያዘ አግኝቷል</translation>
<translation id="6877155553248388166">የፍለጋው አካባቢ ከታች በስተቀኝ ጥግ፦ ቀኝ <ph name="RIGHT" />%፣ ከታች <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">ቅዳ</translation>
<translation id="6898028264630240901">በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ ዓውዳዊ ተግባራትን ፒን ማድረግ ይችላሉ</translation>
<translation id="6985817498888719203">João Browserን እንደ ነባሪ አሳሽዎ ያቀናብሩ እና የተግባር አሞሌዎ ላይ ፒን ያድርጉት</translation>
<translation id="5277424858974213042">እና የJoão Browser መገለጫዎችን ያስተዳድሩ</translation>
<translation id="2726137364317931343">ይህ እርምጃ የሚከተሉትን ያደርጋል፦
          <ph name="LINE_BREAKS" />
            • የእርስዎን የመነሻ ገጽ፣ አዲስ የትር ገጽ፣ የፍለጋ ፕሮግራም እና ፒን የተደረጉ ትሮችን ዳግም ያስጀምራል
            <ph name="LINE_BREAK" />
            • ቅጥያዎችን ያሰናክላል
            <ph name="LINE_BREAK" />
            • ኩኪዎችን እና ሌላ ጊዜያዊ የጣቢያ ውሂብን ይሰርዛል
            <ph name="LINE_BREAK" />
            • የJoão Browser አቋራጮችን ዳግም ያስጀምራል
            <ph name="LINE_BREAKS" />
            ዕልባቶች፣ ታሪክ እና የተቀመጡ የይለፍ ቃላት አይነኩም።</translation>
<translation id="2901988969322822496">የJoão Browserን የ<ph name="BOOKMARK_LIMIT" /> እልባቶች ገደብ ላይ ደርሰዋል፣ ስለዚህ አንዳንድ እልባቶችዎ እስካሁን በGoogle መለያዎ ውስጥ አልተቀመጡም።

አንዳንድ እስኪሰርዙ ድረስ አዲስ እልባቶች በመለያዎ ውስጥ መቀመጥ አይችሉም። አሁን ዘግተው ከወጡ ያልተቀመጡ እልባቶች ይሰረዛሉ።</translation>
<translation id="6203410920314218280">አገናኙን በJoão Browser ማን&amp;ነትን በማያሳውቅ መስኮት ውስጥ ክፈት</translation>
<translation id="6965382102122355670">እሺ</translation>
<translation id="6985329841647292029">የChromiumOS ውል</translation>
<translation id="8064285182627814996">João Browser ውሂብን በእርስዎ መለያ <ph name="ACCOUNT_EMAIL" /> ውስጥ ለመጠቀም እና ለማስቀመጥ የይለፍ ሐረግዎን ያስገቡ</translation>
<translation id="7011190694940573312">ይህ የስርዓተ ክወናው ስሪት ስለማይደገፍ መጫኑ አልተሳካም።</translation>
<translation id="7024536598735240744">ተጠናቆ ያለማቅረብ ስህተት፦ <ph name="UNPACK_ERROR" />።</translation>
<translation id="181803036615530330">João Browserን የራስዎ ያድርጉት</translation>
<translation id="7047386856539490735">እነዚህ ውጤቶች ጠቃሚ ናቸው?</translation>
<translation id="2478245051737698828">João Browserን አዘምን</translation>
<translation id="452909342278940733">አንድ ምስል ጠቃሚ መግለጫ ከሌለው João Browser ለእርስዎ አንድ ለማቅረብ ይሞክራል። ዝርዝር መግለጫዎችን ለመፍጠር፣ ምስሎች ወደ Google ይላካሉ።</translation>
<translation id="8606769615526968368">የJoão Browser መተግበሪያን በእርስዎ <ph name="DEVICE_TYPE" /> ላይ ሲጠቀሙ የሰው ሠራሽ አስተውሎት ኃይልን ያግኙ</translation>
<translation id="2061960765882453684">በስልክዎ ላይ ባለው የJoão Browser መተግበሪያ የይለፍ ቃላትዎን፣ ትሮችን እና ሌሎችንም በመሄድ ላይ ይውሰዱ</translation>
<translation id="7141270731789036260">Chromeን ለሙከራ አብጅ</translation>
<translation id="7147227333672430807">በመልዕክቶች፣ ሰነዶች እና ሌሎች መተግበሪያዎች ውስጥ አገናኞች ላይ ጠቅ በሚያደርጉበት ማንኛውም ጊዜ Chromium መጠቀም ይችላሉ</translation>
<translation id="6949173677980969871"><ph name="EXTENSION_NAME" /> ከJoão Browser አስወግድ</translation>
<translation id="3556355753960287061">ድርጅትዎ የJoão Browser ውሂብን ለ<ph name="TIMEOUT_DURATION" /> ያህል ሥራ ላይ ሳይውል ይሰርዘዋል። ይህ ታሪክን፣ ራስ-ሙላን እና ውርዶችን ሊያካትት ይችላል።</translation>
<translation id="8689006320829658442">João Browser ለዚህ ጣቢያ የካሜራ ፈቃድ ያስፈልገዋል</translation>
<translation id="7501884108538572227">João Browserን ማስጀመር አልተቻለም። እንደገና ይሞክሩ።</translation>
<translation id="5484563502710761706">በGemini በJoão Browser ውስጥ፣ ባሉበት ሆነው ማንኛውንም ነገር ይጠይቁ</translation>
<translation id="3823264355161086552">በማንኛውም ጊዜ João Browserን በቀላሉ ማግኘት እንዲችሉ በእርስዎ መትከያ ውስጥ ያቆዩት</translation>
<translation id="9153902741226700840">በመልዕክቶች፣ ሰነዶች እና ሌሎች መተግበሪያዎች ውስጥ አገናኞች ላይ ጠቅ በሚያደርጉበት ማንኛውም ጊዜ João Browser ይጠቀሙ</translation>
<translation id="7216228761061470870">በዴስክቶፕ ላይ የምስል ፍለጋን ሲጠቀሙ የገጹ ርዕስ፣ ዩአርኤል እና PDFዎችን ጨምሮ ይዘት ወደ አገልጋዩ ይላካሉ</translation>
<translation id="7950844619283784703">ተግባር መሪ - João Browser</translation>
<translation id="133513825972536773"><ph name="EXISTING_USER" /> አስቀድመው ገብተዋል። አሰሳዎን ለያይተው ለማቆየት በራስዎ መገለጫ ውስጥ እንደ <ph name="USER_EMAIL_ADDRESS" /> ሆነው ወደ João Browser ይግቡ። እንዲሁም በሁሉም መሣሪያዎችዎ ላይ የተቀመጠ የእርስዎን መረጃ እና ሌሎችንም ያገኛሉ።</translation>
<translation id="4558982617284733740">በቅጽበት ማሰስ ይጀምሩ፦ አሁን Windows ሲጀምር João Browser መጀመር ይችላል።</translation>
<translation id="7274695763216404502">ፒን ተደርጓል! ከመሣሪያ አሞሌው እንደገና የምስል ፍለጋ ይጠቀሙ</translation>
<translation id="7288567540154601580">ትሮች እና ቅጥያዎች</translation>
<translation id="5494571279964989269">{NUM_EXTENSIONS,plural, =1{João Browser እንዲያስወግዱት ይመክራል}one{João Browser እንዲያስወግዱት ይመክራል}other{João Browser እንዲያስወግዷቸው ይመክራል}}</translation>
<translation id="2269053214123323740">የሥርዓት ኦዲዮን ለማጋራት የሥርዓት ቅንብሮችን ይክፈቱ እና ለJoão Browser «የሥርዓት የኦዲዮ ቀረጻ ብቻ» ይፍቀዱ። ከዚያ João Browserን እንደገና ማስጀመር ይኖርብዎታል።</translation>
<translation id="731795002583552498">Chromiumን በማዘመን ላይ...</translation>
<translation id="9065168747010082551">የምርጫዎች ፋይልዎ የተበላሸ ወይም ልክ ያልሆነ ነው።

João Browser ቅንብሮችዎን ማስመለስ አልቻለም።</translation>
<translation id="7324051657739063017">በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ ዓውዳዊ ተግባራትን እንደገና መክፈት ይችላሉ</translation>
<translation id="4159250197688136733">የእርስዎ ድር፣ ዕልባቶች እና ሌሎች የJoão Browser ነገሮች እዚህ ይኖራሉ።</translation>
<translation id="7347827960336370838">የእርስዎን የተመሰጠረ ውሂብ ማንበብ የሚችለው የይለፍ ሐረግዎ ያለው ሰው ብቻ ነው። የይለፍ ሐረጉ ወደ Google አይላክም ወይም በGoogle አይከማችም። የእርስዎን የይለፍ ሐረግ ከረሱ ወይም ይህን ቅንብር መለወጥ ከፈለጉ <ph name="BEGIN_LINK" />በመለያዎ ውስጥ ያለውን Chromium ውሂብ መሰረዝ<ph name="END_LINK" /> ይኖርብዎታል።</translation>
<translation id="1062903713270840396">የእርስዎ ስርዓት አስተዳዳሪ João Browser <ph name="TARGET_URL_HOSTNAME" />ን ለመድረስ <ph name="ALTERNATIVE_BROWSER_NAME" />ን እንዲከፍት አዋቅሮታል።</translation>
<translation id="7352651011704765696">የሆነ ችግር ተፈጥሯል</translation>
<translation id="5817362738974335084">የወደፊት የJoão Browser ዝማኔዎችን ለማግኘት macOS 13 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር macOS 12 እየተጠቀመ ነው።</translation>
<translation id="7376384068949534168">በቅርብ ጊዜ አልጎበኙም። Chromium <ph name="PERMISSION_1" />፣ <ph name="PERMISSION_2" />ን አስወግዷል።</translation>
<translation id="73786666777299047">Chrome የድር መደብርን ይክፈቱ</translation>
<translation id="5724625487458697703">Geminiን በሥርዓት ትሪ ውስጥ በJoão Browser ውስጥ አሳይ</translation>
<translation id="7401687852903179959">ይህን ቪድዮ በምስል ፍለጋ ፈልግ</translation>
<translation id="1088684725931971005">João Browser አሁን የእርስዎ ነባሪ አሳሽ ነው</translation>
<translation id="7479848806300971661">ካቆሙበት ይቀጥሉ፦ João Browser እንደገና በጀመሩ ቁጥር የእርስዎን ትሮች ወደነበሩበት ይመልሳል። ይህን ለማጥፋት ወደሚከተለው ይሂዱ</translation>
<translation id="1258077876605261365">የይለፍ ቃላትን ወደ João Browser ያምጡ</translation>
<translation id="5293062713751091377">1. ከታች <ph name="BUTTON_LABEL" /> ላይ ጠቅ ያድርጉ
2. በWindows ቅንብሮችዎ ውስጥ <ph name="BUTTON_2" /> ላይ ጠቅ ያድርጉ
3. ለፈጣን መዳረሻ João Browserን በተግባር አሞሌዎ ላይ ለመሰካት በWindows ማሳወቂያ ውስጥ <ph name="BUTTON_3" /> ላይ ጠቅ ያድርጉ</translation>
<translation id="1941496545060769345"><ph name="PAGE_TITLE" /> - João Browser ግንባታ</translation>
<translation id="7450541714075000668">ጽሁፍ ገልብጧል</translation>
<translation id="7458892263350425044">ማይክሮፎንዎን ለመጠቀም <ph name="BEGIN_LINK" />የሥርዓት ቅንብሮች<ph name="END_LINK" /> ውስጥ ለChromium መዳረሻ ይስጡ</translation>
<translation id="5422859338435319909">የወደፊት የJoão Browser ዝማኔዎችን ለማግኘት Windows 10 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር Windows 7ን እየተጠቀመ ነው።</translation>
<translation id="7467949745582939695">Chromium ዳግም ይጀመር?</translation>
<translation id="7707324976708178089">እየሄደ ያለውን ተመሳሳዩን የJoão Browser ስሪት መጫን አይቻልም። እባክዎ João Browserን ይዝጉና እንደገና ይሞክሩ።</translation>
<translation id="7510190804000607802">አስታዋሽ፦ የGoogle ምርጡ በኪስዎ ውስጥ</translation>
<translation id="751935028865900641">ጣቢያዎች እንደተጠበቀው መስራታቸው አይቀርም። ከGoogle መለያዎ በስተቀር በ Chromium ውስጥ ገብተው ከሆነ፣ ሁሉንም የChromium መስኮቶች ሲዘጉ ከአብዛኞቹ ጣቢያዎች ይወጣሉ።</translation>
<translation id="5325102834460669866">{0,plural, =1{João Browser በ1 ደቂቃ ውስጥ ዳግም ይጀመራል}one{João Browser በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}other{João Browser በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}}</translation>
<translation id="7565444033145385702">ውሂብዎን ለመጠበቅ Chromium እርስዎ በቅርቡ ካልጎበኟቸው ጣቢያዎች ላይ ፈቃዶችን እንዲያስወግድ ይፍቀዱ።</translation>
<translation id="8099958128052689767">በቅጽበት ማሰስ ለመጀመር João Browserን በራስ-ሰር አስጀምር።</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ጫኝ</translation>
<translation id="7125257608567714221">João Browser ካሜራዎን እና ማይክሮፎንዎን እየተጠቀመ ነው።</translation>
<translation id="227045421902171569">João Browser አሁን ይበልጥ ተሻሽሏል</translation>
<translation id="5356567285381070312">አሁን João Browser ውስጥ የሚገኙ ተጨማሪ ባህሪያት አሉዎት</translation>
<translation id="7624307931717240213">ይህን አገልግሎት ለማሻሻል መረጃ እንጠቀማለን። የግላዊነት መመሪያን እና የአገልግሎት ውልን ይመልከቱ።</translation>
<translation id="7649070708921625228">እገዛ</translation>
<translation id="5714374331629713291">የJoão Browser መተግበሪያን ያግኙ</translation>
<translation id="7658239707568436148">ይቅር</translation>
<translation id="549378870470819535">João Browser ነባሪ አሳሽዎ አይደለም</translation>
<translation id="6574348346278803862">በመላ መሣሪያዎችዎ ላይ João Browserን ያሳምሩ እና ግላዊነት ያላብሱ</translation>
<translation id="7699779824407626136">Chromium ዝማኔ</translation>
<translation id="3304080024230377341">ሥራዎ João Browser ላይ ደኅንነቱ ተጠብቋል</translation>
<translation id="7716950018788545737">ተግባር(ራት) አልቋል(አልቀዋል)።</translation>
<translation id="77283119132245232">ለ<ph name="BROWSER_NAME" /> የሥርዓት ክትትል አገልግሎቶች ያቀርባል። ይህ አገልግሎት ከተሰናከለ በአሳሹ የተፈጠሩ የአፈጻጸም መከታተያዎች እንደ የዓውድ መቀያየሪያ እና ዝግጁ ተከታታይ ክስተቶች ያሉ ሥርዓት አቀፍ ክስተቶችን አያካትቱም።</translation>
<translation id="7745317241717453663">ይሄ የአሰሳ ውሂብዎን ከዚህ መሣሪያ ይሰርዘዋል። ውሂብዎን በኋላ ላይ ሰርስረው ለማውጣት እንደ <ph name="USER_EMAIL" /> ሆነው ወደ Chromium ይግቡ።</translation>
<translation id="7747138024166251722">ጫኝው ጊዜያዊ ማውጫ መፍጠር አልቻለም። እባክዎ ነፃ የዲስክ ቦታ እና ሶፍትዌር የመጫን ፍቃድ እንዳለ ይፈትሹ።</translation>
<translation id="4713120944298974980">በJoão Browser ውስጥ ይፈልጉ</translation>
<translation id="5804390944809171853">ወደ ነባሪ João Browser ዳግም አስጀምር</translation>
<translation id="6930487390575519812">በJoão Browser ላይ ሥራዎን ደኅንነት ለመጠበቅ፣ ወደ João Browser ሲገቡ ድርጅትዎ የተወሰነ መረጃን ማየት ወይም ማስተዳደር ይችላል።</translation>
<translation id="5214761769821670245">João Browserን እንደ ነባሪ ያቀናብሩ እና የተግባር አሞሌው ላይ ይሰኩት</translation>
<translation id="1294697217796985566">João Browserን የበለጠ ፈጣን ያድርጉት</translation>
<translation id="1278345486417353853"><ph name="PAGE_TITLE" /> - João Browser Canary</translation>
<translation id="7803986347287457849">የበይነመረብ ትራፊክዎ መዳረሻ ላላቸው ሰዎች እርስዎ የትኞቹን ጣቢያዎች እንደሚጎበኙ ማየት ያክብዱባቸው። Chromium የጣቢያውን አይ ፒ አድራሻ በዲኤንኤስ (የጎራ ስም ሥርዓት) ውስጥ ለመፈለግ የተመሰጠረ ግንኙነትን ይጠቀማል።</translation>
<translation id="7810005234485217901">በቀላሉ ለመድረስ የምስል ፍለጋን ፒን ማድረግ ይችላሉ</translation>
<translation id="489728561211958943">ይህን መለያ ያለው አንድ የJoão Browser መገለጫ አስቀድሞ በዚህ መሣሪያ ላይ አለ</translation>
<translation id="7845233973568007926">ሰለተጫኑ እናመሰግናለን። <ph name="BUNDLE_NAME" />ን ከመጠቀምዎ በፊት ኮምፒውተርዎን እንደገና ማስጀመር አለብዎት።</translation>
<translation id="5294768452950207882">የፍለጋ ፕሮግራምዎ ከJoão Browser ውጭ ተለውጧል። እርስዎን ለመጠበቅ João Browser ወደ መጀመሪያው ነባሪ ዳግም አስጀምሮታል። <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3244974069468656925">João Browserን አዲስ መልክ ለመስጠት ያብጁት</translation>
<translation id="7859018312476869945">የአድራሻ አሞሌ ወይም የፍለጋ ሳጥን ውስጥ ሲተይቡ የተሻሉ ጥቆማዎችን ለማግኘት Chromium የሚተይቡትን ለእርስዎ ነባሪ የፍለጋ ፕሮግራም ይልካል። ይህ ማንነት የማያሳውቅ ውስጥ ጠፍቷል።</translation>
<translation id="6517519572778941051">João Browser ወደ የቅርብ ጊዜው ስሪት ሊዘመን አልቻለም፣ ስለዚህ አዲስ ባህሪያት እና የደህንነት ጥገናዎች እያመለጡዎት ናቸው። João Browserን ማዘመን አለብዎት።</translation>
<translation id="7872446069773932638">በማውረድ ላይ... <ph name="SECONDS" /> ሰከንድ(ዶች) ይቀራሉ</translation>
<translation id="7873537467422636035">የይለፍ ሐረግዎን ከረሱ ወይም ይህን ቅንብር መለወጥ ከፈለጉ <ph name="BEGIN_LINK" />በመለያዎ ውስጥ ያለውን የChromium ውሂብ ይሰርዙ<ph name="END_LINK" /></translation>
<translation id="1722038268139386345">Geminiን በሚያስፈልግዎ ማንኛውም ጊዜ በJoão Browser ውስጥ በፍጥነት ይክፈቱት</translation>
<translation id="8344320926817290924">João Browserን እንደ ነባሪ ያቀናብሩት</translation>
<translation id="7934340546140346950">Chromium በሚቻልበት ጊዜ ደህንነታቸው ያልተጠበቀ ግንኙነቶችን በራስ-ሰር ወደ ኤችቲቲፒኤስ ያልቃል</translation>
<translation id="3755057387338907970">እንደ <ph name="USER_EMAIL_ADDRESS" /> ሆነው ወደ João Browser ገብተዋል። እባክዎ እንደገና ለመግባት ተመሳሳዩን መለያ ይጠቀሙ።</translation>
<translation id="929903348843569380"><ph name="EXISTING_USER" /> አስቀድመው ገብተዋል። አሰሳዎን ለያይተው ለማቆየት በራስዎ መገለጫ ውስጥ እንደ <ph name="USER_EMAIL_ADDRESS" /> ሆነው ወደ João Browser ይግቡ። እንዲሁም በሁሉም መሣሪያዎችዎ ላይ የእርስዎን እልባቶች እና ሌሎችንም ያገኛሉ።</translation>
<translation id="7975919845073681630">ይሄ ሁለተኛ የChromium ጭነት ነው፣ እና ነባሪ አሳሽዎ ማድረግ አይቻልም።</translation>
<translation id="8905411496853397218">ካልታወቁ ምንጮች የመጡ ቅጥያዎች፣ መተግበሪያዎች እና ገጽታዎች መሣሪያዎን ሊጎዱ ይችላሉ። João Browser እነሱን ከ<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ብቻ መጫንን ይመክራል</translation>
<translation id="6306672714476596428">በእርስዎ <ph name="DEVICE_TYPE" /> ላይ በJoão Browser መተግበሪያ የGoogle ምርጡን ያግኙ</translation>
<translation id="8004582292198964060">አሳሽ</translation>
<translation id="8010081455002666927">በራስ-አግኝ</translation>
<translation id="2172829664765531568">አንዴ João Browser መዳረሻ ከኖረው በኋላ ድር ጣቢያዎች እርስዎን መዳረሻ መጠየቅ ይችላሉ።</translation>
<translation id="74641100973032765">በማንኛውም ጊዜ በፍጥነት ወደ João Browser ለመሄድ ፒን ያድርጉት</translation>
<translation id="80471789339884597">ሰለተጫኑ እናመሰግናለን። <ph name="BUNDLE_NAME" />ን ከመጠቀምዎ በፊት ሁሉንም አሳሾችዎን እንደገና ማስጀመር አለብዎት።</translation>
<translation id="8054112667659782652">የምስል ፍለጋ አቋራጭን ሁልጊዜ አሳይ</translation>
<translation id="8069447462453318634">«ወደ የመሣሪያ አሞሌ ሰካ» የሚለውን ይምረጡ</translation>
<translation id="5039671129725402518">João Browser ለመተግበሪያዎች በዳራ ውስጥ እንዳያሄድ አሰናክል</translation>
<translation id="80790299200510644">ምስል ፈልግ</translation>
<translation id="8086881907087796310">ኮምፒውተርዎ አነስተኛውን የሃርድዌር መስፈርቶች ስላላሟላ መጫኑ አልተሳካም።</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome ለሙከራ</translation>
<translation id="2430877582155731716">João Browser ለዚህ ጣቢያ የአካባቢ ፈቃድ ያስፈልገዋል</translation>
<translation id="8298045348217323">በሚቀጥለው ጊዜ João Browserን በእርስዎ <ph name="DEVICE_TYPE" /> ላይ ሲከፍቱ፣ የዋጋ ክትትል ማንቂያዎችን ለማንቃት ጥያቄ ያያሉ።</translation>
<translation id="3827347991254458074">በስልክዎ ላይ ባለው የJoão Browser መተግበሪያ ላይ ፍላጎት ባሎት ንጥሎች ላይ የዋጋ ቅናሽ ማንቂያዎችን ያግኙ</translation>
<translation id="8118331347066725040">በሌንስ ለፍለጋ ግብረ መልስ ይላኩ</translation>
<translation id="2580039965224265556">João Browserን የእርስዎ ያድርጉ</translation>
<translation id="8133124826068723441">ማስመር ለጎራዎ ስለማይገኝ ChromiumOS ውሂብዎን ማስመር አይችልም።</translation>
<translation id="813913629614996137">በማስጀመር ላይ…</translation>
<translation id="7940955011992997426">Gemini በJoão Browser ውስጥ በቁልፍ ሰሌዳ አቋራጭ ይክፈቱ።</translation>
<translation id="7560319627203819845">የJoão Browser ተጨማሪ የአገልግሎት ውል</translation>
<translation id="7133741820744999589">ይህ ፋይል አደገኛ ስለሆነ João Browser አግዶታል።</translation>
<translation id="8177472873527554730">በገፅ ውስጥ ያለ ይዘትን ማግኘት አይቻልም</translation>
<translation id="8200109504272824693">Chromium ውሂብን በእርስዎ መለያ <ph name="USER_EMAIL" /> ውስጥ ለመጠቀም እና ለማስቀመጥ የይለፍ ሐረግዎን ያስገቡ</translation>
<translation id="820759916613250543">ይህን ምስል በምስል ፍለጋ ፈልግ</translation>
<translation id="8221491193165283816">ማሳወቂያዎችን ብዙውን ጊዜ ያግዳሉ። ይህን ጣቢያ ለእርስዎ እንዲያሳውቅዎት ለመፍቀድ፣ እዚህ ላይ ጠቅ ያድርጉ።</translation>
<translation id="8223363452568144035">ካሜራዎን ለመጠቀም <ph name="BEGIN_LINK" />የሥርዓት ቅንብሮች<ph name="END_LINK" /> ውስጥ ለChromium መዳረሻ ይስጡ</translation>
<translation id="8132864687089402359">João Browser ይህ ቅጥያ ከየት እንደመጣ ማረጋገጥ አይችልም፣ እና ደህንነቱ ያልተጠበቀ ሊሆን ይችላል። የግል መረጃን ጨምሮ ከእንግዲህ እርስዎ በሚጎበኟቸው ጣቢያዎች ላይ ያለዎትን ውሂብ ማየት እና መለወጥ እንዳይችል ከJoão Browser ያስወግዱት።</translation>
<translation id="7600652022483599804">አንድ ምስል ጠቃሚ መግለጫ ከሌለው João Browser ለእርስዎ አንድ ለማቅረብ ይሞክራል። ዝርዝር መግለጫዎችን ለመፍጠር፣ ምስሎች ወደ Google ይላካሉ። ይህን በማንኛውም ጊዜ በቅንብሮች ውስጥ ሊያጠፉት ይችላሉ።</translation>
<translation id="8703735741562140394">በአዲስ መገለጫ ወደ João Browser ይግቡ?</translation>
<translation id="2830039647655087365"><ph name="EXISTING_USER" /> አስቀድመው ገብተዋል። አሰሳዎን ለያይተው ለማቆየት በራስዎ መገለጫ ውስጥ እንደ <ph name="USER_EMAIL_ADDRESS" /> ሆነው ወደ João Browser ይግቡ። እንዲሁም ከ<ph name="DEVICE" /> የእርስዎን የይለፍ ቃላት እና ሌሎችንም ያገኛሉ።</translation>
<translation id="1802935470126307750">Geminiን በሥርዓት ትሪ ውስጥ በJoão Browser ውስጥ ያሳዩ እና የቁልፍ ሰሌዳ አቋራጭን ያብሩ</translation>
<translation id="8286943863733751221">ደህንነታቸው ስላልተጠበቁ ጣቢያዎች እና ውርዶች <ph name="BEGIN_LINK" />Chromium ያስጠነቅቅዎታል<ph name="END_LINK" /></translation>
<translation id="8295827201165805317">በቅርብ ጊዜ አልጎበኙም። Chromium <ph name="PERMISSION" />ን አስወግዷል።</translation>
<translation id="481989138594406896">በJoão Browser iOS መተግበሪያ ላይ በካሜራዎ የሚያዩትን ይሸምቱ፣ ይተርጉሙ እና ይለዩ</translation>
<translation id="5242426961520127942">ወደ João Browser እንደ <ph name="USER_NAME" /> ለመግባት የሚሆን QR ኮድ</translation>
<translation id="8313851650939857356">የማስነሻ ስህተት፦ <ph name="STARTUP_ERROR" /></translation>
<translation id="3644336211313412429">ድርጅትዎ João Browser ለ<ph name="TIMEOUT_DURATION" /> ያህል ሥራ ላይ ሳይውል ይዘጋዋል።</translation>
<translation id="8321888067342493336">እንደ ምስል አስቀምጥ</translation>
<translation id="3150519286474936594"><ph name="USER_EMAIL_ADDRESS" /> ከዚህ ቀደም João Browserን እየተጠቀመ ነበር</translation>
<translation id="8351551329754447960">Chromium ውስጥ ክህሎቶችን አንቃ</translation>
<translation id="4566781614303801262">በእርስዎ Google መለያ <ph name="ACCOUNT_EMAIL" /> ውስጥ João Browser ውሂብን መጠቀም ለመቀጠል João Browserን ያዘምኑ</translation>
<translation id="8404636483124146663">የወደፊት የJoão Browser ዝማኔዎችን ለማግኘት Windows 10 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር Windows 8 እየተጠቀመ ነው።</translation>
<translation id="8362914115861174987">ወደዚህ መተርጎም</translation>
<translation id="8367705492654390392">ማንኛውም ነገር ይጠይቁ</translation>
<translation id="8370517070665726704">የቅጂ መብት <ph name="YEAR" /> Google LLC. ሁሉም መብቶች በህግ የተጠበቁ ናቸው።</translation>
<translation id="8954225380790220359">የይለፍ ቃላትዎን እና ሌሎችንም በሁሉም መሣሪያዎችዎ ላይ ለማግኘት ወደ João Browser ይግቡ። በመለያ ከገቡ በኋላ ይህ የይለፍ ቃል በGoogle መለያዎ ውስጥ ይቀመጣል።</translation>
<translation id="208035402574338948">ከዚያ João Browserን እንደገና መጀመር ይኖርብዎታል።</translation>
<translation id="7458698097055456629">João Browser እንዲያስወግዱት ይመክራል። <ph name="BEGIN_LINK" />ስለሚደገፉ ቅጥያዎች የበለጠ ይወቁ<ph name="END_LINK" /></translation>
<translation id="3428558977667883100">ይህ ቅጥያ በገንቢው ከህትመት ወጥቷል እና ደህንነቱ የተጠበቀ ላይሆን ይችላል። የግል መረጃዎን ጨምሮ ከእንግዲህ እርስዎ በሚጎበኟቸው ጣቢያዎች ላይ ያለዎን ውሂብ ማየት እና መለወጥ እንዳይችል ከJoão Browser ያስወግዱት።</translation>
<translation id="5012944467031125860">የተወሰነ ውሂብ በGoogle መለያዎ ውስጥ መቀመጥ እና በሁሉም መሣሪያዎችዎ ላይ ጥቅም ላይ መዋል ከመቻሉ በፊት João Browser ማንነትዎን ማረጋገጥ አለበት። አሁን ዘግተው ከወጡ ይህ ውሂብ ይሰረዛል።</translation>
<translation id="8822543678238892300">{0,plural, =1{በአንድ ቀን ውስጥ João Browserን ዳግም አስጀምር}one{በ# ቀኖች ውስጥ João Browserን ዳግም አስጀምር}other{በ# ቀኖች ውስጥ João Browserን ዳግም አስጀምር}}</translation>
<translation id="8438543370129609977">የምስል ፍለጋ ሲያደርጉ PDFዎችን ጨምሮ የገፁ ርዕስ፣ ዩአርኤል እና ይዘት ወደ አገልጋዩ ይላካሉ። <ph name="LEARN_MORE" /></translation>
<translation id="4307944272317199640">João Browser ውስጥ በምስል ፍለጋ ስለመፈለግ የበለጠ ይወቁ</translation>
<translation id="6024135746436350583">የጫኚው መዝገብ ተበላሽቷል ወይም ትክክል አይደለም። እባክዎ João Browserን እንደገና ያውርዱ።</translation>
<translation id="4933173390191738516">João Browser Windows 10 ወይም ከዚያ በላይ ያስፈልገዋል።</translation>
<translation id="8463672209299734063">ከተፈለገ፦ የምርመራ እና የአጠቃቀም ውሂብ ወደ Google በራስ-ሰር በመላክ የChromiumOS ባህሪያትን እና አፈጻጸምን እንዲሻሻል ያግዙ።</translation>
<translation id="4499703930846496679">Google መለያዎ ውስጥ የJoão Browser ውሂብን ለመጠቀም እና ለማስቀመጥ እርስዎ መሆንዎን ያረጋግጡ</translation>
<translation id="8482493977473846331">ወደ Chromium ለመግባት ጥያቄዎችን ያሳያል</translation>
<translation id="2129903037617090425">João Browser ጊዜው አልፎበታል</translation>
<translation id="850264194101621529">Chromiumን እንደ ነባሪ አሳሽዎ ስለመረጡ እናመሰግናለን!</translation>
<translation id="8522801943730206384">እርስዎ የይለፍ ቃላትዎን ሲያስቀምጧቸው Chromium መፈተሽ ይችላል</translation>
<translation id="8525579356836940628">ጭነት ቆሟል</translation>
<translation id="2445505893586445499">በእርስዎ <ph name="DEVICE_TYPE" /> ላይ ባለው የJoão Browser መተግበሪያ የይለፍ ቃላትዎን፣ ትሮችዎን እና ሌሎችንም በመሄድ ላይ ይውሰዱ</translation>
<translation id="8548787790260785208">Chromium ከይለፍ ቃሎችዎ ውስጥ አንዱን በይፋዊ የውሂብ ጥሰት ውስጥ ካገኘ ማስጠንቀቂያ ያግኙ</translation>
<translation id="8555465886620020932">የአገልግሎት ስህተት፡ <ph name="SERVICE_ERROR" />።</translation>
<translation id="8871890913961794658">አንዳንድ የJoão Browser ባህሪያት እና ቅጥያዎች ከአቋራጮች ጋር ይመጣሉ። መልሰው ለማብራት መምረጥ ይችላሉ።</translation>
<translation id="8556420416730706394">በቀላሉ ለመድረስ የምስል ፍለጋ ፒን ማድረግ ይችላሉ፤ በጎን ፓነሉ አናት ላይ የሚገኘውን ፒን አድርግ አዝራርን ጠቅ ያድርጉ</translation>
<translation id="856656450041460113">የቋንቋ ዝርዝር ፈልግ</translation>
<translation id="9044172203094901282">ብዙ ድርጅቶች João Browserን ያስተዳድራሉ</translation>
<translation id="8586442755830160949">የቅጂ መብት <ph name="YEAR" /> የChromium ደራሲያን። ሁሉም መብቶች የተጠበቁ ናቸው።</translation>
<translation id="8601359445272098721">አዲስ! «ማያ ገፅ ተርጉም» የሚለውን ቁልፍ በመምረጥ ሁለቱንም ጽሁፍ እና ምስሎች በማያ ገፁ ላይ መተርጎም ይችላሉ</translation>
<translation id="1071663705626404814">João Browserን በማስጀመር ላይ...</translation>
<translation id="8624541899164515475">ቅንብሮች፣ በአዲስ ትር ውስጥ ይከፈታል።</translation>
<translation id="8648201657708811153">Google Chrome ለሙከራ የእርስዎ ነባሪ አሳሽ እንዲሆን ማድረግ አይቻልም።</translation>
<translation id="5975137268566279898">እንዲሁም João Browserን ሲጀምሩት ወይም ከኦምኒቦክሱ ሆነው ሲፈልጉ የሚታየውን ገፅ ይቆጣጠራል።</translation>
<translation id="6358904712334248114">ይሄ የእርስዎ João Browser ነው</translation>
<translation id="8712637175834984815">ገባኝ</translation>
<translation id="5380190167074430719">ወደ João Browser ይግቡ?</translation>
<translation id="8747073452963259673">የፍለጋው አካባቢ ከታች በስተግራ ጥግ፦ ግራ <ph name="LEFT" />%፣ ከታች <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">የጭነት ስህተት፦ የእርስዎ የአውታረ መረብ አስተዳዳሪ ጭነትን የሚከላከል የቡድን መመሪያ ተግባራዊ አድርጓል፦ <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">ቆይተህ አስታውሰኝ</translation>
<translation id="8871607387186266158">ፈጣን አጠቃላይ ዕይታ ለማግኘት እና ተከታይ ጥያቄዎችን ለመጠየቅ ይህን ሰነድ በJoão Browser ውስጥ ካለው Gemini ጋር ያጋሩ</translation>
<translation id="3009329613270131861">ወደ João Browser ይግቡ?</translation>
<translation id="8823401858233292222">Chromium ነባሪ አሳሽ እንዲሆን ያድርጉ እና ወደ የተግባር አሞሌው ፒን ያድርጉት</translation>
<translation id="8826492472752484139">«የሚስጥር ቁልፍ አስተዳዳሪ» ላይ ጠቅ ያድርጉ</translation>
<translation id="8833697763442816810">የChromiumOS ስርዓት</translation>
<translation id="8852026904190808918">ይህ ቋንቋ Chromium ውስጥ ምናሌዎች፣ ቅንብሮች፣ ማንቂያዎች እና ሌላ ጽሁፍ ለማሳየት ጥቅም ላይ ይውላል</translation>
<translation id="8862326446509486874">ለስርዓተ-ደረጃ ጭነት ተገቢ መብቶች የሉዎትም። ጫኚውን እንደ አስተዳዳሪ በማሄድ እንደገና ይሞክሩ።</translation>
<translation id="6821836710312478344">የJoão Browser መገለጫ ያክሉ</translation>
<translation id="5139769635207740615">በመለያ በመግባት ላይ ባለ ስሕተት ምክንያት ChromiumOS የJoão Browser ውሂብን በGoogle መለያዎ ውስጥ ማስቀመጥ አልቻለም</translation>
<translation id="6814613825007700341">ድርጅትዎ ወደ João Browser እንዲገቡ ይጠይቃል</translation>
<translation id="1009831347869773172">João Browser የይለፍ ቃሎችን ለማሳየት እየሞከረ ነው። ይህንን ለመፍቀድ የWindows የይለፍ ቃልዎን ይተይቡ።</translation>
<translation id="690637523240192979">João Browser ከእንግዲህ የእርስዎ ነባሪ አሳሽ አይደለም። João Browser ነባሪውን አሳሽ ያድርጉት?</translation>
<translation id="225046375773654931">João Browserን ማዘመን አልተቻለም</translation>
<translation id="8944232836376404813">ይህ እርምጃ የሚከተሉትን ያደርጋል፦
          <ph name="LINE_BREAKS" />
            • የእርስዎን የመነሻ ገጽ፣ አዲስ የትር ገጽ፣ የፍለጋ ፕሮግራም እና ፒን የተደረጉ ትሮችን ዳግም ያስጀምራል
            <ph name="LINE_BREAK" />
            • ቅጥያዎችን ያሰናክላል
            <ph name="LINE_BREAK" />
            • ኩኪዎችን እና ሌሎች ጊዜያዊ የጣቢያ ውሂብን ይሰርዛል
            <ph name="LINE_BREAKS" />
            ዕልባቶች፣ ታሪክ እና የተቀመጡ የይለፍ ቃላት አይነኩም።</translation>
<translation id="4349474976990059197">የJoão Browser Enterprise ዓርማ</translation>
<translation id="3227699293368317033">በእርስዎ <ph name="DEVICE_TYPE" /> ላይ ባለው የJoão Browser መተግበሪያ የGoogleን ደኅንነት በመሄድ ላይ ይውሰዱ</translation>
<translation id="6527164294507620103">መገለጫዎን ሲከፍቱ የሆነ ስሕተት ስለተከሰተ João Browserን መጀመር አይቻልም። João Browserን እንደገና ለማስጀመር ይሞክሩ።</translation>
<translation id="6741767563284518125">የJoão Browser መገለጫዎችን ያስተዳድሩ</translation>
<translation id="3101491883380219087">በGemini በJoão Browser ውስጥ እና በክፍት ትርዎ መካከል ለመዳሰስ የቁልፍ ሰሌዳዎን ይጠቀሙ።</translation>
<translation id="9018218886431812662">ጭነት ተጠናቅቋል</translation>
<translation id="3370247132646333337">João Browserን ይበልጥ ደህንነቱ የተጠበቀ እንዲሆን ለማድረግ፣ በ<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ውስጥ ያልተዘረዘረውን የሚከተለውን ቅጥያ አሰናክለነዋል እና እርስዎ ሳያውቁት የታከለ ሊሆን ይችላል።</translation>
<translation id="1940116386572548863">João Browser ውስጥ ይግቡ</translation>
<translation id="8381652653666868014">የማህደር ፋይሉ ተንኮል አዘል ዌርን ሊደብቁ የሚችሉ ሌሎች ፋይሎችን ስላካተተ João Browser ይህን ውርድ አግዶታል</translation>
<translation id="8374335201144490555">የይለፍ ቃላትዎን፣ እልባቶችዎን እና ታሪክዎን በመላው መሣሪያዎችዎ ላይ በትክክል ሠምረው እንዲቆዩ ያድርጉ። ነባሪ አሳሽዎን ወደ João Browser በማዘመን በቀላሉ የሚያውቋቸውን እና የሚወዷቸውን ባህሪያት ይድረሱ። ለፈጣን መዳረሻ João Browser በተግባር አሞሌዎ ላይ ይሰካል።</translation>
<translation id="6176486087616698123">በስልክዎ ላይ የJoão Browser መተግበሪያን በመጠቀም የGoogleን ምርጥ የሰው ሠራሽ አስተውሎት መሣሪያዎች ይጠቀሙ</translation>
<translation id="9062666675513499497">ወደ ሌሎች የGoogle አገልግሎቶች ሲገቡ ወደ Chromium ይግቡ</translation>
<translation id="724802823738504651">João Browser በራስ-ሰር ተዘግቷል</translation>
<translation id="2689333215784698609">João Browser ጊዜው አልፎበታል</translation>
<translation id="8049510467237146160">{0,plural, =1{João Browser በአንድ ሰዓት ውስጥ ዳግም ይጀምራል}one{João Browser በ# ሰዓቶች ውስጥ ዳግም ይጀምራል}other{João Browser በ# ሰዓቶች ውስጥ ዳግም ይጀምራል}}</translation>
<translation id="9106236359747881194">ለመፈለግ ጽሑፍ ይምረጡ</translation>
<translation id="8558551666630075184">የወደፊት የJoão Browser ዝማኔዎችን ለማግኘት Windows 10 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር Windows 8.1ን እየተጠቀመ ነው።</translation>
<translation id="1194819784870407331">አገናኙን በJoão Browser አዲስ &amp;ትር ውስጥ ክፈት</translation>
<translation id="911206726377975832">የአሰሳ ውሂብዎም ይሰረዝ?</translation>
<translation id="9134482777260927479">የቤት ሥራ እገዛ</translation>
<translation id="9148058034647219655">ውጣ</translation>
<translation id="548951409840319583">ካቆሙበት ይቀጥሉ፦ João Browser እንደገና በጀመሩ ቁጥር የእርስዎን ትሮች ወደነበሩበት መመለስ ይችላል። ይህን ለማብራት ወደሚከተለው ይሂዱ</translation>
<translation id="7614949510548815395">የእርስዎ የስርዓት አስተዳዳሪ <ph name="TARGET_URL_HOSTNAME" />ን ለመድረስ João Browser ተለዋጭ አሳሽን እንዲከፍት አዋቅረውታል።</translation>
<translation id="3441698750089879771">&amp;João Browserን ለማዘመን ዳግም ያስነሱት</translation>
<translation id="369689859238510548">João Browser (mDNS-In)</translation>
<translation id="8336832914816665097">João Browserን የራስዎ ያድርጉት</translation>
<translation id="7698429329590050365">João Browser በWindows XP ወይም Windows Vista ላይ ከእንግዲህ ስለማይደገፍ በአግባቡ ላይሰራ ይችላል</translation>
<translation id="190261805571697214">በመሄድ ላይ ከJoão Browser ጋር የGoogleን ምርጥ የደኅንነት ባህሪያት ያግኙ።</translation>
<translation id="945522503751344254">ግብረመልስ ላክ</translation>
<translation id="5554799509799759090">ማነው João Browserን የሚጠቀመው?</translation>
<translation id="9153108844196984904">የJoão Browserን ጠንካራ ደህንነት ያግኙ</translation>
<translation id="983803489796659991">የዝማኔ አገልጋዩ ለመተግበሪያው ምንም ሃሽ ውሂብ ስለሌለው መጫኑ አልተሳካም።</translation>
<translation id="6230710687825107323">João Browserን ያለመለያ ተጠቀም</translation>
<translation id="985602178874221306">የChromium ደራሲዎች</translation>
<translation id="989970834842471429">በምስል ፍለጋ ለመፈለግ ማንኛውንም ጽሑፍ ወይም ምስል ይምረጡ</translation>
<translation id="992780518932311116">አካባቢዎን ለመጠቀም <ph name="BEGIN_LINK" />የሥርዓት ቅንብሮች<ph name="END_LINK" /> ውስጥ ለChromium መዳረሻ ይስጡ</translation>
