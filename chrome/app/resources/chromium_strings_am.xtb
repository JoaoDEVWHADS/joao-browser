<translation id="3719803995198923598">የእርስዎን João Browser ያብጁ</translation>
<translation id="4148957013307229264">በመጫን ላይ...</translation>
<translation id="2954462321765112214"><ph name="PAGE_TITLE" /> - በአውታረ መረብ ወደ መለያ መግባት - João Browser</translation>
<translation id="7812363663832111420">ለJoão Browser ምርጥ መተግበሪያዎችን፣ ጨዋታዎችን፣ ቅጥያዎችን እና ገጽታዎችን ያግኙ።</translation>
<translation id="69200600645763018">በሁሉም ኮምፒውተርዎችዎ ላይ ይህን ቅጥያ እና ተጨማሪ ለማግኘት ወደ João Browser ይግቡ</translation>
<translation id="7505863944027312744">በወላጅዎ ምርጫ መስመር ላይ የበለጠ ደህንነቱ የተጠበቀ ሆኖ ለመቆየት፣ አስቀድመው እንደ <ph name="USER_EMAIL_ADDRESS" /> ወደ ገቡበት የJoão Browser መገለጫ ይቀይሩ</translation>
<translation id="4222932583846282852">በመሰረዝ ላይ...</translation>
<translation id="4224210481850767180">ጭነቱ ተሰርዟል።</translation>
<translation id="8090594705972340646">የJoão Browser ውሂዎ ከዚህ መለያ ጋር ይገናኝ?</translation>
<translation id="4251772536351901305">ከመደበኛ ጥበቃ በላይ ተጨማሪ ውሂብ ከጣቢያዎች ትንታኔ በመስጠት Google እንኳን በፊት ስላላወቃቸው አደገኛ ጣቢያዎች ያስጠነቅቅዎታል። የChromium ማስጠንቀቂያዎችን ለመዝለል መምረጥ ይችላሉ።</translation>
<translation id="5696119579094527589">ከJoão Browser ዘግተህ ውጣ</translation>
<translation id="4271805377592243930">Chromium ላይ እገዛ ያግኙ</translation>
<translation id="4281844954008187215">የአግልግሎት ውል</translation>
<translation id="1245307320228150348">ተለይቶ ባልታወቀ ስህተት ምክንያት ጭነት ከሽፏል። João Browser አሁን እያሄደ ከሆነ እባክዎ ይዝጉትና እንደገና ይሞክሩ።</translation>
<translation id="7405356088321579627">የይለፍ ቃላትን ከJoão Browser ወደ ውጪ ይላኩ</translation>
<translation id="4304713468139749426">የይለፍ ቃል አስተዳዳሪ</translation>
<translation id="4334241893986177674">ይህን ቅጽበታዊ ገጽ እይታ ይፈልጉ</translation>
<translation id="212570256141568951">Windows ሲጀምር João Browserን አስጀምር</translation>
<translation id="4400772909124543403">ምንም ዝማኔ አይገኝም</translation>
<translation id="7463042547966071103">የሆነው ሆኖ ከJoão Browser ይወጣ?</translation>
<translation id="4413205837991854510">የምስል ፍለጋ አቋራጭን ሁልጊዜ አሳይ</translation>
<translation id="4736206301215400753">João Browser በበስተጀርባ ላይ ያሂድ</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{João Browser እንዲያስወግዱት ይመክራል። <ph name="BEGIN_LINK" />ስለሚደገፍ ቅጥያ የበለጠ ይወቁ<ph name="END_LINK" />}one{João Browser እንዲያስወግዱት ይመክራል። <ph name="BEGIN_LINK" />ስለሚደገፍ ቅጥያ የበለጠ ይወቁ<ph name="END_LINK" />}other{João Browser እንዲያስወግዷቸው ይመክራል። <ph name="BEGIN_LINK" />ስለሚደገፉ ቅጥያዎች የበለጠ ይወቁ<ph name="END_LINK" />}}</translation>
<translation id="5305058100936019600">João Browserን ያብጁ እና ይቆጣጠሩ</translation>
<translation id="4427306783828095590">የተሻሻለ ጥበቃ ማስገር እና ተንኮል-አዘል ዌር ለማገድ የበለጠ ይሠራል</translation>
