<translation id="3461955321878243607"><ph name="MANAGER" /> João Browserን ያስተዳድራል</translation>
<translation id="3379477508903866078">የJoão Browser መገለጫ ያክሉ</translation>
<translation id="4447409407328223819">ስለ Chrome ለሙከራ</translation>
<translation id="4074057296993529937">በGoogle መለያዎ ውስጥ የJoão Browser ውሂብን ለመጠቀም እና ለማስቀመጥ የእርስዎን የይለፍ ሐረግ ያስገቡ</translation>
<translation id="4493028449971051158">የማስነሻ ስህተት፦ እባክዎ መጫኛውን እንደ አስተዳዳሪ ያሂዱ።</translation>
<translation id="4501471624619070934">በዚህ አገር መዳረሻ የተገደበ ስለሆነ ጭነት አልተሳካም።</translation>
<translation id="8624811527667906941">ይህ ቅጥያ እንደ ውሂብን እንዴት እንደሚሰበስብ እና እንደሚጠቀም ያሉ የግላዊነት ተግባሮችን አላተመም። João Browser እንዲያስወግዱት ይመክራል።</translation>
<translation id="5571435860030744559">እንኳን ወደ João Browser በደህና መጡ፤ አዲስ የአሳሽ መስኮት ተከፍቷል</translation>
<translation id="8132016625974854930">João Browser አካባቢዎን በካርታ ለመንደፍ እና የእጆችዎን እንቅስቃሴዎች ለመከታተል ፈቃድ ይፈልጋል</translation>
<translation id="6599071882590417739">አስቀድመው በሌላ የJoão Browser መገለጫ እንደ <ph name="USER_EMAIL_ADDRESS" /> ገብተዋል</translation>
<translation id="4548534452171747496">Chromium ገፆችን ቅድሚያ ይጭናል፣ ይህም ማሰስ እና መፈለግን የበለጠ ፈጣን ያደርጋል። <ph name="BEGIN_LINK" />በቅድሚያ ስለሚጫኑ ገፆች የበለጠ ለመረዳት<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">እርስዎ ጎጂ ነው ብለው የሚያስቡትን ጣቢያ ሪፖርት ሲያደርጉ ለሁሉም ሰው የመስመር ላይ ደኅንነትን ያሻሽሉ።</translation>
<translation id="202208802191333704">እርስዎ ደህንነቱ የተጠበቀ አሰሳን ስላጠፉ እና ፋይሉ ሊረጋገጥ ስለማይችል João Browser ይህን ውርድ አግዷል</translation>
<translation id="3128308674776200516">በስልክዎ ላይ Google ሌንስን ከJoão Browser ጋር ይሞክሩ</translation>
<translation id="4594305310729380060">በዚህ መሣሪያ ላይ ወደ የይለፍ ቃል አስተዳዳሪ</translation>
<translation id="7653380076752216509">የJoão Browser መተግበሪያዎች</translation>
<translation id="4598116752460667024">ከዝርዝሩ ማንኛውንም ሂደት ይፈልጉ።</translation>
<translation id="4613863813562375431">የChromiumOS ስሪት</translation>
<translation id="4621240073146040695">የተዘመነ ለመሆን ጥቂት ብቻ ቀርቷል! ማዘመን ለማጠናቀቅ Chromiumን ዳግም ያስጀምሩት።</translation>
<translation id="1497446027991908251">በJoão Browser V8 ሞተር ጣቢያዎችን ያፋጥናል ነገር ግን የJoão Browserን ጥቃቶችን የመቋቋም አቅም በመጠኑ ያነሰ ያደርገዋል</translation>
<translation id="7523749920868634278">ማስጠንቀቂያ፦ João Browser ቅጥያዎች የአሰሳ ታሪክዎን እንዳይመዘግቡ መከልከል አይችልም። ይህን ቅጥያ ማንነት በማያሳውቅ ሁነት ላይ ለማሰናከል ይህን አማራጭ አይምረጡ።</translation>
<translation id="4673151026126227699">እንዲሁም የChromium አጠቃቀም ሪፖርቶችን ካጋሩ፣ እነዚያ ሪፖርቶች እርስዎ የሚጎበኟቸውን ዩአርኤሎች ያካትታሉ</translation>
<translation id="4673710618874938871">እንደ <ph name="USER_NAME" />፣ አባልነት ገብተዋል። የመለያ ምናሌውን ይክፈቱ</translation>
<translation id="6608258642372806522">መገለጫው በሌላ ኮምፒውተር (<ph name="HOST_NAME" />) ላይ በሌላ የJoão Browser ሂደት (<ph name="PROCESS_ID" />) የተያዘ ይመስላል። João Browser መገለጫው እንዳይበላሽ ቆልፎታል። ሌሎች ሂደቶች ይህን መገለጫ እየተጠቀሙበት እንዳልሆኑ እርግጠኛ ከሆኑ መገለጫውን አስከፍተው João Browserን ዳግም ማስጀመር ይችላሉ።</translation>
<translation id="4680828127924988555">መጫኑን ሰርዝ</translation>
<translation id="3912572071294857936">አንዳንድ የJoão Browser ውሂብዎ በGoogle መለያዎ ውስጥ ገና አልተቀመጠም። ዘግተው ከመውጣትዎ በፊት ጥቂት ደቂቃዎች ለመጠበቅ ይሞክሩ። አሁን ዘግተው ከወጡ ይህ ውሂብ ይሰረዛል።</translation>
<translation id="1077152188344040592">በመለያ ገብተው ሳለ በJoão Browser ውስጥ ከGoogle መለያዎ የይለፍ ቃላትዎን እና ሌሎችንም መጠቀም ይችላሉ። <ph name="SHORTCUT" /> የGoogle አገልግሎቶች ቅንብሮችዎን መለወጥ ይችላል።</translation>
<translation id="5729536702149847030">የሆነ ሰው ከዚህ ቀደም በዚህ ኮምፒውተር ላይ እንደ <ph name="ACCOUNT_EMAIL_LAST" /> ሆነው ገብተዋል። የእርስዎን መረጃ ለይተው ለማስቀመጥ እባክዎ አዲስ የJoão Browser ተጠቃሚ ይፍጠሩ።</translation>
<translation id="4724676981607797757">በማይደገፍ የፕሮቶኮል ስህተት ምክንያት መጫኑ አልተሳካም።</translation>
<translation id="6273241729694500032">የሆነው ሆኖ João Browser ይቁም?</translation>
<translation id="3239680024825449390">ለJoão Browser ልዩ የደህንነት ዝማኔ ተፈጻሚ ተደርጓል። አሁን ዳግም ያስጀምሩ እና የእርስዎን ትሮች ወደ ነበሩበት እንመልሳለን።</translation>
<translation id="4771701986670315895">በቅርብ ጊዜ አልጎበኙም። Chromium <ph name="PERMISSION_1" />፣ <ph name="PERMISSION_2" /> እና <ph name="COUNT" /> ሌሎችንም አስወግዷል።</translation>
<translation id="1908292729364083164">Gemini በJoão Browser ውስጥ ክፍት ከሆነ አዲስ ትሮች ሲፈጠሩ የጎን ፓነሉ ክፍት ሆኖ ይቆያል</translation>
<translation id="479167709087336770">ይህ በ Google ፍለጋ ውስጥ ጥቅም ላይ ጋር ተመሳሳይ የፊደል አራሚ ይጠቀማል። በአሳሽ ውስጥ የሚተይቡት ጽሁፍ ወደ Google ይላካል። ይህን ባህሪ ሁልጊዜ በቅንብሮች ውስጥ መለወጥ ይችላሉ።</translation>
<translation id="189382710647501724">João Browserን ያለመለያ ይጠቀሙ</translation>
<translation id="4456919965836032212">João Browser ለmDNS ትራፊክ ለመፍቀድ የውስጥ ደንብ።</translation>
<translation id="3486986778673504636">&amp;João Browserን ለማዘመን ዳግም ያስነሱት</translation>
<translation id="4918086044614829423">ይቀበሉ</translation>
<translation id="4918844574251943176">ምስል ተቀድቷል</translation>
<translation id="1571932028747131277">João Browser በጀርባ ሁነታ ላይ ነው።</translation>
<translation id="7612124006067933008">የJoão Browser የመለያ መግቢያ መገናኛን ለመዝጋት ጠቅ ያድርጉ</translation>
<translation id="2598788273876744576">በJoão Browser መገለጫዎች ሁሉንም የJoão Browser ነገሮችዎን መለየት ይችላሉ። ለጓደኞች እና ለቤተሰብ መገለጫዎችን ይፍጠሩ፣ ወይም በሥራ እና በመዝናኛ መካከል ይከፋፈሉ።</translation>
<translation id="2115498792600385171">እንግዳዎች ማንኛውንም ነገር ወደኋላ ሳይተዉ João Browser መጠቀም ይችላሉ።</translation>
<translation id="6870732303439257966">João Browser ውስጥ ያለ መለያዎ</translation>
<translation id="4366792189726044065">እራስዎን በJoão Browser ላይ ያክሉ</translation>
<translation id="504699503110800016">የትርፍ ምናሌውን ይክፈቱ</translation>
<translation id="4340125167559705618">በእርስዎ <ph name="DEVICE_TYPE" /> ላይ ሁሉንም የGoogle ተወዳጆችዎን በJoão Browser ይድረሱ</translation>
<translation id="4916697359431064123">João Browser እጆችዎን ለመከታተል ፈቃድ ያስፈልገዋል</translation>
<translation id="5141988424377517949">በቅርብ ጊዜ አልጎበኙም። Chromium <ph name="PERMISSION_1" />፣ <ph name="PERMISSION_2" />፣ <ph name="PERMISSION_3" />ን አስወግዷል።</translation>
<translation id="5174969993834422967">አብዛኛውን ጊዜ ማሳወቂያዎችን ያግዳሉ። ይህ ጣቢያ እንዲያሳውቅዎ ለመፍቀድ በአካባቢ አሞሌዎ ቀኝ ጥግ ላይ ያለውን የማሳወቂያ አዶ ጠቅ ያድርጉ።</translation>
<translation id="5174983315706567306">በቂ የዲስክ ቦታ የለም።</translation>
<translation id="961070648267203077">የJoão Browser መለያ ዳግም ማረጋገጥ ያስፈልገዋል</translation>
<translation id="69363826605946518">iOS ላይ በJoão Browser ካቆሙበት ይቀጥሉ።</translation>
<translation id="471694954923709047">ከJoão Browser ዘግተው ይውጡ</translation>
<translation id="5234764350956374838">አሰናብት</translation>
<translation id="5782956358171235578">አገናኙን በJoão Browser ማን&amp;ነትን በማያሳውቅ መስኮት ውስጥ ክፈት</translation>
<translation id="903712329052383264">በመሄድ ላይ ሳሉ የይለፍ ቃላትን ለማስቀመጥ የJoão Browser መተግበሪያን ያግኙ</translation>
<translation id="5277894862589591112">የእርስዎን ለውጦች ተፈጻሚ ለማድረግ፣ Chromiumን ዳግም ያስጀምሩ</translation>
<translation id="5286907366254680517">ተገኝቷል</translation>
<translation id="5593827909938092728">የJoão Browser መተግበሪያን አግኝ</translation>
<translation id="5294316920224716406">ማንነትን በማያሳውቅ ሁነታ ሲያስሱ፣ Chromium ደህንነቱ ያልተጠበቀ ግንኙነት በመጠቀም ጣቢያ ከመጫንዎ በፊት ያስጠነቅቀዎታል</translation>
<translation id="1066981078513393795">የJoão Browser ማዘመኛ ውስጣዊ አገልግሎት</translation>
<translation id="5324450571874973775">በChromium ውስጥ ከሌሎች የGemini ባህሪያት ጋር አብረው ይጠቀሙባቸው</translation>
<translation id="5346389065299425353">ብዙ ትሮች፣ ፋይሎች እና መሣሪያዎችን በማከል ፍለጋዎን ያሳድጉ</translation>
<translation id="1884203704972162365">የዚህን ሰነድ ፈጣን አጠቃላይ ዕይታ ያግኙ እና በJoão Browser ውስጥ በGemini ጥያቄዎችን ይጠይቁ</translation>
<translation id="5352264705793813212">Chromium ለግምገማዎ አንዳንድ የደህንነት ምክሮችን አግኝቷል</translation>
<translation id="4819697639570429319">ሌሎች የJoão Browser መገለጫዎች</translation>
<translation id="7878591304929138776">የመለያ መግቢያ ዝርዝሮችዎ ጊዜ ያለፈባቸው ስለሆኑ ChromiumOS የJoão Browser ውሂብን በGoogle መለያዎ ውስጥ ማስቀመጥ አልቻለም</translation>
<translation id="5249614051186670898">በሚተዳደር መለያ እየገቡ ነው፣ እና አስተዳዳሪው በእርስዎ João Browser መገለጫ ላይ ቁጥጥር እየሰጡት ነው። እንደ እርስዎ  መተግበሪያዎች፣ ዕልባቶች፣ ታሪክ፣ የይለፍ ቃላት እና ሌሎች ቅንብሮች ያሉ የእርስዎ João Browser ውሂብ እስከ መጨረሻው ከ<ph name="USER_NAME" /> ጋር የተያያዙ ይሆናሉ። ይህን ውሂብ በGoogle የመለያዎች Dashboard አማካኝነት ሊሰርዙት ይችላሉ፣ ነገር ግን ይህን ውሂብ ከሌላ መለያ ጋር ሊያጎዳኙት አይችሉም። <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">ተጨማሪ ኮድ፦ <ph name="EXTRA_CODE" />።</translation>
<translation id="5377622451696208284">ግላዊነት ለማላበስ Chromiumን በድር እና በመተግበሪያ እንቅስቃሴ ውስጥ ያካትቱ</translation>
<translation id="108952623091824942">João Browser ለምን አንዳንድ ፋይሎችን እንደሚያግድ ይወቁ</translation>
<translation id="5386450000063123300">Chromiumን በማዘመን ላይ (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">የChromium በመለያ መግባትን ይፍቀዱ</translation>
<translation id="1265086181910844216">ከJoão Browser አስወግድ</translation>
<translation id="1500700851187484222">አፈጻጸምን ይቀንሳል ነገር ግን João Browser ጥቃቶችን ይበልጥ እንዲቋቋም ያደርገዋል</translation>
<translation id="6665657403278704382">João Browser እንደ ነባሪ አሳሽዎ አድርገው ያዋቅሩት</translation>
<translation id="3520901681432894293"><ph name="PAGE_TITLE" /> - João Browser ቅድመ-ይሁንታ</translation>
