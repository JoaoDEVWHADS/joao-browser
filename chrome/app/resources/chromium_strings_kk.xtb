<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kk">
<translation id="1026101648481255140">Орнатуды жалғастыру</translation>
<translation id="1029669172902658969">&amp;ChromiumOS жүйесін жаңарту үшін қайта іске қосу</translation>
<translation id="4711726241445951349">João Browser осы кеңейтімді қарап шығуды ұсынады</translation>
<translation id="1042552502243217427">Сайт беттегі сілтемелерді құпия түрде алдын ала жүктеуді сұрағанда, Chromium браузері Google серверлерін пайдаланады. Осылайша жеке деректеріңіз алдын ала жүктелетін сайттан жасырылады, бірақ Google алдын ала жүктелетін сайттарды біледі.</translation>
<translation id="1051793555070215510">Осы 1 минуттық сауалнамаға жауап беру арқылы инкогнито режимін жақсартуымызға көмектесіңіз.</translation>
<translation id="1065672644894730302">Реттеулерді оқу мүмкін емес.

Кейбір мүмкіндіктер қолжетімсіз болуы мүмкін және параметрлерге жасалған өзгертулер сақталмайды.</translation>
<translation id="3937976866851867994">Ата-анаңыз João Browser браузері үшін "Сайттарға, қолданбаларға және кеңейтімдерге арналған рұқсаттар" параметрін өшірді</translation>
<translation id="8626021334348319355">Белгілі бір João Browser функциясын немесе кеңейтімін іздеу үшін мекенжай жолағына оның жылдам пәрменін енгізіп, содан кейін таңдалған пернені басыңыз.</translation>
<translation id="9157778882771986870">João Browser құпия сөздерді экспорттағысы келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="112640046208448578">Заттарды не орындарды анықтауға және мәтінді көшіруге не аударуға болады. "Сурет іздеу" функциясын пайдаланғанда, беттің скриншоты серверге жіберіледі. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium әдепкі браузеріңіз болып табылады</translation>
<translation id="1131805035311359397">Құпия сөздеріңіздің ұрланудан және басқа да қауіпсіздік мәселелерінен қаншалықты қорғалғанын тексеру үшін <ph name="BEGIN_LINK" />Chromium браузеріне кіріңіз<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">João Browser мәзірін басыңыз.</translation>
<translation id="1157985233335035034">Жақында таңдалған тілдер</translation>
<translation id="1184145431117212167">Орнатылмады, себебі сіздегі Windows нұсқасына қолдау көрсетілмейді.</translation>
<translation id="1185134272377778587">Chromium туралы ақпарат</translation>
<translation id="667420476518265356">Телефондағы João Browser арқылы бағаны бақылау туралы хабарландырулар алыңыз</translation>
<translation id="1203500561924088507">Орнатқаныңыз үшін рақмет. <ph name="BUNDLE_NAME" /> пайдаланбас бұрын браузерді жауып, қайта ашуыңыз керек.</translation>
<translation id="1232234696885483911">"Сурет іздеу" функциясын ашқан кезде, бет атауы, URL мекенжайы және контенті, соның ішінде PDF файлдары серверге автоматты түрде жіберіледі. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">Аккаунтқа кірсеңіз, João Browser-нен Google аккаунтыңыздағы құпия сөздер мен т.б. ақпаратты пайдалана аласыз. Мұны өзгерту үшін "João Browser-дегі аккаунтыңыз" бөліміне өтіңіз.</translation>
<translation id="4866003137980530528">João Browser-дегі Gemini-ды Mac мәзір жолағында көрсету</translation>
<translation id="2526294198551578217">João Browser-дегі Gemini-да экранның бір бөлігін таңдау үшін пернелер тіркесімін пайдаланыңыз.</translation>
<translation id="7068536367561625920">Бұл қойынды әрекетсіз тұрған кезде, João Browser жылдам жұмыс істеуі үшін, жад босатылды. Сіз бұл сайтты әрекетсіз тұру тізімінен әрдайым шығарып отыру опциясын таңдай аласыз.</translation>
<translation id="3669854427836618143">João Browser жүктеп алуды блоктады, себебі бұл файл қауіпті.</translation>
<translation id="126567311906253476">Gmail не YouTube сияқты Google қызметтеріне <ph name="USER_EMAIL" /> көмегімен кірген кезде, Chromium-ге сол аккаунтпен автоматты түрде кіруге болады.</translation>
<translation id="8094399825947986050">João Browser-ді телефоныңызға орнатыңыз</translation>
<translation id="1290883685122687410">Реттеу қатесі: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">Жаңа João Browser профилінің параметрлерін реттеу</translation>
<translation id="7591029065989504977">João Browser-дегі Gemini-мен байқап көру</translation>
<translation id="8408989583029959522">Bluetooth құрылғыларын табу үшін João Browser-ге Bluetooth пайдалану рұқсаты қажет. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">Телефоныңыздағы João Browser-ге кіріңіз</translation>
<translation id="1330562121671411446">Тілді анықтау</translation>
<translation id="6026568602942276348">Деректерді João Browser-нен (<ph name="URL" />) де жою</translation>
<translation id="1345251407431278948">Бекітілді! "Сурет іздеу" функциясына құралдар тақтасындағы жаңа түймені басу арқылы қайта кіруге болады.</translation>
<translation id="1356661055722410047">Жаңалық! Енді экрандағы мәтін мен суреттерді де аудара аласыз.</translation>
<translation id="1383876407941801731">Іздеу</translation>
<translation id="5807085300679014096">Жол-жөнекей шолу үшін João Browser пайдаланыңыз.</translation>
<translation id="141901961143729572">Ойыңызды бөлісіңіз.</translation>
<translation id="3736947618013031173">Терезені бөлісу үшін жүйе параметрлерінде João Browser-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="1478370723027452770">Chrome for Testing бойынша анықтама алу</translation>
<translation id="1497802159252041924">Орнату қатесі: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Бұл бет қорғалған</translation>
<translation id="4379865404970367448">João Browser қойындысын бөлісу</translation>
<translation id="4436275659297289591">João Browser аккаунтына кіру</translation>
<translation id="1547469039832541117">Ерекшеленген тапсырманы аяқтайды.</translation>
<translation id="449712764049695153">João Browser-ді бекіту</translation>
<translation id="1574377791422810894">Chromium-нің қауіпсіздік құралдары</translation>
<translation id="5480232403718129394">João Browser браузері Password Manager-дегі деректеріңізді жоюға рұқсат сұрайды. Рұқсат беру үшін Windows құпия сөзін енгізіңіз.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{Жаңартылған нұсқаны қолдану үшін әкімшіңіз João Browser браузерін қайта іске қосуыңызды талап етеді.}=1{Жаңартылған нұсқаны қолдану үшін әкімшіңіз João Browser браузерін қайта іске қосуыңызды талап етеді. Инкогнито терезесі қайта ашылмайды.}other{Жаңартылған нұсқаны қолдану үшін әкімшіңіз João Browser браузерін қайта іске қосуыңызды талап етеді. # инкогнито терезесі қайта ашылмайды.}}</translation>
<translation id="980976428162070137">Телефондағы João Browser-мен Google-дың барлық мүмкіндігін пайдаланыңыз</translation>
<translation id="1625909126243026060">Chromium-дегі құпиялық пен қауіпсіздікті басқарудың маңызды құралдарын қарап шығыңыз.</translation>
<translation id="1640672724030957280">Жүктеп алынып жатыр…</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" /> (мүше) ретінде кірдіңіз. Аккаунт мәзірін ашу</translation>
<translation id="1708414395296835197">Хабарлардағы, құжаттардағы және басқа қолданбалардағы сілтемелерді басып, Chromium браузерін кез келген уақытта пайдалана аласыз. Сондай-ақ ол тапсырмалар жолағына бекітіледі.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> браузеріне кеңейтілген құқықтар береді.</translation>
<translation id="1722488837206509557">Бұл жағдайда қолжетімді құрылғылардың арасынан таңдап, оларда контент көрсетуге болады.</translation>
<translation id="6972087163510342335">João Browser жақын арада браузерді пайдалану деректерін жояды</translation>
<translation id="1736443181683099871">Chromium браузері навигацияларды HTTPS кеңейтіміне жаңартып көреді.</translation>
<translation id="3879288383593333401">João Browser деректері жойылды</translation>
<translation id="656496276885630888">João Browser <ph name="REMAINING_TIME" /> кейін қайта қосылады</translation>
<translation id="1749104137266986751">HTTPS қолжетімді болмаған кезде, Chromium сізге ескертпестен, қауіпті байланысты пайдаланады.</translation>
<translation id="1226290419185955779">João Browser жүйесін фонда іске қосуға рұқсат беру</translation>
<translation id="4231366995273072370">João Browser қауіпсіз ету үшін <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ішінде көрсетілмеген және сізге білдірмей қосылған болуы мүмкін кейбір кеңейтімдерді өшірдік.</translation>
<translation id="1822049153969905781">João Browser-ге жылдам кіру үшін оны тапсырмалар жолағына бекітіңіз. Ол үшін Windows хабарландыруындағы <ph name="BEGIN_BOLD" />Иә<ph name="END_BOLD" /> түймесін басыңыз.</translation>
<translation id="1321831992638405531">João Browser қайта орнату</translation>
<translation id="3386967202064865436">João Browser <ph name="AUTHENTICATION_PURPOSE" /> қолданып көрейін деп жатыр</translation>
<translation id="70054449700528483">Келесі жолы João Browser-ді <ph name="DEVICE_TYPE" /> құрылғысынан ашқан кезде, Google Password Manager-ді пайдалану туралы нұсқауды көресіз.</translation>
<translation id="1838374766361614909">Іздеуді тазарту</translation>
<translation id="5807096362853316123">Браузерді пайдалану деректерін Google аккаунтында сақтай отырып, тек осы құрылғыдан жою үшін <ph name="BEGIN_LINK" />João Browser-де аккаунттан шығыңыз<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">Жолда жаңа қойындылар тобын ашу немесе жасау үшін телефоныңызға João Browser-ді жүктеп алыңыз.</translation>
<translation id="185970820835152459">Кірген Google аккаунттарыңызды басқара аласыз. Google аккаунттарыңыз Chromium браузері, Play Store, Gmail және тағы басқа қызметтерде пайдаланылады. Егер отбасы мүшесі сияқты әлдебіреудің аккаунтын қосқыңыз келсе, жаңа пайдаланушыны <ph name="DEVICE_TYPE" /> құрылғыңызға қосыңыз. <ph name="LINK_BEGIN" />Толығырақ<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">"Сурет іздеу" функциясымен іздеу</translation>
<translation id="65457771685016683"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін João Browser-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Бетбелгілер мен басқа деректерді <ph name="DEVICE" /> ала аласыз.</translation>
<translation id="1880677175115548835">Мәтінді таңдаңыз</translation>
<translation id="2634119629547215883">Бақыланатын аккаунт арқылы кіріп, оның әкімшісіне João Browser профиліңізді басқару мүмкіндігін бердіңіз. Қолданбалар, бетбелгілер, журнал, құпия сөздер сияқты João Browser деректеріңіз және басқа параметрлер біржола <ph name="USER_NAME" /> пайдаланушысына байланыстырылады. Бұл деректерді Google аккаунт бақылау тақтасы арқылы жоя аласыз, бірақ бұл деректерді басқа аккаунтмен байланыстыра алмайсыз. Бар João Browser деректерін бөлек ұстау үшін қосымша жаңа профиль жасай аласыз. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium браузері біркелкі айналдыру және бейнекадр жиілігі сияқты фондық әрекеттерді және визуалдық әсерлерді шектеу арқылы батарея қуатын үнемдейді. <ph name="BEGIN_LINK" />Қуат үнемдеу туралы толық ақпарат<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">"João Browser-ді жаңарту құралы" қызметі</translation>
<translation id="1911763535808217981">Бұл функцияны өшіріп, Chromium браузеріне кірместен Gmail сияқты Google сайттарын пайдалана беруіңізге болады</translation>
<translation id="4037729269678342163">João Browser жауап бермейді. Қазір қайта іске қосасыз ба?</translation>
<translation id="7563750688920581112">Ұйымыңыз (<ph name="MANAGER" />) João Browser-ге кіруді талап етеді</translation>
<translation id="193439633299369377">Жаңарту күшіне енуі үшін ChromiumOS жүйесін өшіріп қосу керек.</translation>
<translation id="7099143775283792684">João Browser жүктеп алуды блоктады, себебі бұл файл түрі әдетте жүктеп алынбайды және ол қауіпті болуы мүмкін.</translation>
<translation id="1953553007165777902">Жүктеп алынып жатыр… <ph name="MINUTE" /> минут қалды.</translation>
<translation id="1966382378801805537">Chromium әдепкі браузерді анықтай не орната алмайды</translation>
<translation id="197326043290947695">Сурет іздеу функциясымен тиімдірек шолыңыз</translation>
<translation id="6185556991023272801">Неліктен João Browser кейбір файлдарды блоктайтыны туралы ақпарат жаңа қойындыдан ашылады.</translation>
<translation id="4053636705816895911">João Browser бағдарламалық құралын жаңартып отырады. Егер бұл қызмет өшірілген немесе тоқтатылған болса, João Browser бағдарламалық құралыңыз жаңартылмайды. Нәтижесінде қауіпсіздік ақауларын жою мүмкін болмай, функциялар жұмыс істемеуі мүмкін. Бұл қызмет пайдаланылатын João Browser бағдарламалық құралы болмаса, өздігінен жойылады.</translation>
<translation id="2008474315282236005">Құрылғыдан 1 элемент жойылады. Деректерді кейінірек алу үшін Chromium браузеріне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="2018879682492276940">Орнатылмады. Қайталап көріңіз.</translation>
<translation id="2039417478970545937">Параметрлер.</translation>
<translation id="2049376729098081731">Google қызметтерінде жекелендірілген мүмкіндіктерді пайдалану үшін Chromium тарихын қосу-қоспау нұсқасын таңдаңыз.</translation>
<translation id="6768767091114123654">Күрделі құпия сөздерді жасауға, сақтауға және автоматты түрде толтыруға көмектесу үшін João Browser-ге ендірілген. Оңай кіру үшін пернелер тіркесімін қосыңыз.</translation>
<translation id="3571664229232252557">João Browser-ге жаңа көрініс беру үшін жаңа қойынды бетіндегі "João Browser-ді бейімдеу" түймесін басыңыз.</translation>
<translation id="4273287215573278663">João Browser жүктеп алуды блоктады, себебі бұл – алдамшы файл және ол құрылғыңызға күтпеген өзгерістер енгізуі мүмкін.</translation>
<translation id="9063967192437499581">João Browser iOS браузерін келесіде ашқанда, <ph name="FEATURE_NAME" /> функциясын пайдаланып көру туралы нұсқауды көресіз.</translation>
<translation id="8511569826706775962">Google аккаунтыңызда сақталған құпия сөздеріңіз бен João Browser-дегі басқа деректеріңіз осы құрылғыдан өшіріледі. Оларды João Browser-де қайта пайдалану үшін аккаунтқа қайтадан кіріңіз.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{João Browser 1 минут бойы пайдаланылмаса, ұйымыңыз браузерді пайдалану деректерін автоматты түрде жояды. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін. Қойындыларыңыз ашық болады.}other{João Browser # минут бойы пайдаланылмаса, ұйымыңыз браузерді пайдалану деректерін автоматты түрде жояды. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін. Қойындыларыңыз ашық болады.}}</translation>
<translation id="2125838419757773031">Іздеу үшін экран аймағын таңдаңыз.</translation>
<translation id="2126108037660393668">Жүктеп алынған файл растаудан өтпеді.</translation>
<translation id="2135919691573380097">Осы сайт туралы шағымдану</translation>
<translation id="2137162749895930932">Аударма экранын жабу</translation>
<translation id="1308845716497059117">João Browser жүктеп алуды блоктады, себебі сайтта қауіпсіз байланыс пайдаланылып жатқан жоқ және файл өзгертілген болуы мүмкін.</translation>
<translation id="2170098639895543546">Беттен кез келген нәрсені таңдау</translation>
<translation id="6705844023496387932">João Browser-ді реттеу</translation>
<translation id="2174917724755363426">Орнату аяқталмады. Шынымен бас тартқыңыз келе ме?</translation>
<translation id="7728290795259244895">João Browser – Желіге кіру - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Жаңа нұсқаны тексеру қатесі: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">Аккаунтты João Browser-нен өшіру</translation>
<translation id="4648870374540039667">Үздік сатып алу құралдарын жол-жөнекей алып жүру үшін João Browser пайдаланыңыз.</translation>
<translation id="2106116820042118250">iOS жүйесіне арналған João Browser-дегі Күшейтілген Safe Browsing деректеріңізді фондық режимде қорғауға көмектеседі.</translation>
<translation id="2210682093923538346">Сайт қауіпті. Chromium хабарландыруларды өшірді.</translation>
<translation id="2236949375853147973">Әрекеттерім</translation>
<translation id="118764235932893741">Мекенжайлар мен басқа ақпаратты барлық құрылғыдан алу үшін João Browser аккаунтына кіріңіз. Аккаунтқа кіргеннен кейін, бұл мекенжай Google аккаунтыңызға сақталады.</translation>
<translation id="7254578863532089400">Компьютерді бөлісетін болсаңыз, достарыңыз интернетке бөлек кіріп, João Browser жүйесін қалауынша орната алады.</translation>
<translation id="22571759390241347">Chromium-дегі дағдылар</translation>
<translation id="2283803047247799269">Бұл қойындыны сурет іздеу функциясымен іздеу</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{João Browser браузер жұмысын баяулататын қойындыны кідіртуді ұсынады}other{João Browser браузер жұмысын баяулататын қойындыларды кідіртуді ұсынады}}</translation>
<translation id="2307973900865360088">Бекітілген күйде қалдыру</translation>
<translation id="2313870531055795960">URL мекенжайларын Chromium браузерінде сақталған қауіпсіз емес сайттар тізімімен салыстырып тексереді. Егер сайт құпия сөзіңізді ұрлағысы келсе немесе зиянды файлды жүктеп алсаңыз, Chromium браузері URL мекенжайларын, сондай-ақ бет контенті бөліктерін Safe Browsing қызметіне жіберуі мүмкін.</translation>
<translation id="2356070529366658676">Сұрау</translation>
<translation id="2359808026110333948">Жалғастыру</translation>
<translation id="3800730051093461113">"<ph name="EXTENSION_NAME" />" кеңейтімін қолдану үшін João Browser-ге кіруіңіз керек</translation>
<translation id="8758735062658446604">João Browser-нің қолданбаларда фондық режимде жұмыс істеу мүмкіндігін өшіру</translation>
<translation id="2623595027619107207">Бұл кеңейтімді <ph name="USER_EMAIL_ADDRESS" /> ретінде пайдалану үшін João Browser-ге кіріңіз.</translation>
<translation id="2384373936468275798">ChromiumOS деректеріңізді синхрондай алмады, себебі аккаунтыңызға кіру мәліметтері ескірген.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{1 HID құрылғысын бір немесе бірнеше João Browser кеңейтімі пайдаланды}=1{1 HID құрылғысын бір немесе бірнеше João Browser кеңейтімі пайдаланып жатыр}other{# HID құрылғысын бір немесе бірнеше João Browser кеңейтімі пайдаланып жатыр}}</translation>
<translation id="6254788431480237503">João Browser бұл сайт үшін камера мен микрофонды пайдалануға рұқсат сұрайды.</translation>
<translation id="2403703063067034158">Іске қосу қатесі: қазір басқа орнату процесі жүріп жатыр, әрекетті кейінірек қайталаңыз.</translation>
<translation id="3028975423343897358">Кез келген қолданбадағы сілтемелерді João Browser-нен ашып, браузерді тапсырмалар жолағында қолжетімді етіп қойыңыз.</translation>
<translation id="579079006139156831">Қысқаша мазмұнын біліп, қосымша сұрақтар қою мақсатында бұл құжатты João Browser-дегі Gemini-мен бөлісу үшін "Қысқаша мазмұндау" түймесін басыңыз.</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Chromium-дегі құралдар<ph name="END_LINK" /> көмегімен браузерді қауіпсіз қолданып, барлығын басқаруға болады.</translation>
<translation id="7114471809991869757"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін João Browser-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Құпия сөздер мен басқа деректер барлық құрылғыңызда қолжетімді болады.</translation>
<translation id="2451727308784734061">Password Manager қызметіне жылдам өту үшін таңбашаны пайдаланыңыз. Таңбашаны компьютердің негізгі экранына немесе қолданбаларды іске қосу тақтасына жылжытуға болады.</translation>
<translation id="2709136733469807397">João Browser жақын арада жабылады</translation>
<translation id="3652225684487279741">João Browser аясында</translation>
<translation id="2485422356828889247">Жою</translation>
<translation id="2513154137948333830">Өшіріп қосу қажет: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">"Сурет іздеу" функциясымен мәтінді таңдаңыз.</translation>
<translation id="1527474262707362156">João Browser бұрыннан бар құпия сөздерді ауыстырғысы келеді. Бұған рұқсат беру үшін Windows құпия сөзін енгізіңіз.</translation>
<translation id="6480371226914552131">Файлдарды жүктеп алу үшін João Browser браузеріне сақтау орнын пайдалану құқығы қажет</translation>
<translation id="6318568902186985084">João Browser Helper</translation>
<translation id="2575822587468774919">"Сурет іздеу" функциясымен іздеу керек кез келген нәрсені таңдаңыз.</translation>
<translation id="4557210258834653476">Құпия сөздер мен басқа ақпаратты барлық құрылғыдан алу үшін João Browser аккаунтына кіріңіз.</translation>
<translation id="1148164459654218834">João Browser браузерін жүктеп алу және Google аккаунтына кіру үшін телефонмен QR кодын сканерлеңіз.</translation>
<translation id="235892353478111963">João Browser-ді пайдалана беру</translation>
<translation id="259935314519650377">Жүктеп алынған орнату құралы кэштелмеді. Қате: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Жүйе</translation>
<translation id="8471946631262724853">Ұйымыңыз сіздегі бетбелгілер, тарих және құпия сөздер сияқты браузерді пайдалану деректерін көріп, басқара алады. Ол басқа João Browser профильдеріндегі браузерді пайдалану деректерін көре алмайды.</translation>
<translation id="2870759219964376597">João Browser деректерін <ph name="ACCOUNT_EMAIL" /> аккаунтында қолдану және сақтау үшін жеке басыңызды растаңыз.</translation>
<translation id="2955972712254986678">{COUNT,plural, =0{Күшейтілген қорғаныс функциясы жаңартуды қолдану үшін João Browser-ді қайта іске қосуыңызды талап етеді.}=1{Күшейтілген қорғаныс функциясы жаңартуды қолдану үшін João Browser-ді қайта іске қосуыңызды талап етеді. Инкогнито терезесі қайта ашылмайды.}other{Күшейтілген қорғаныс функциясы жаңартуды қолдану үшін João Browser-ді қайта іске қосуыңызды талап етеді. # инкогнито терезесі қайта ашылмайды.}}</translation>
<translation id="8949462882238006192">João Browser-ді іске қосу</translation>
<translation id="4224214204752803768">Орнату барысында операциялық жүйе қатесі орын алды. João Browser қайта жүктеңіз.</translation>
<translation id="3141414135710372892">Құрылғыңызды басқа адамдар да пайдаланатын болса, достарыңыз және отбасыңыздың мүшелері интернетке бөлек кіріп, João Browser параметрлерін өздері қалағандай орната алады.</translation>
<translation id="8838607803339100223">João Browser кішірейтілсе де, João Browser-дегі Gemini-ға құрылғыңызда оңай кіріп, пайдаланыңыз.</translation>
<translation id="1679364578146271696">João Browser қойындысы</translation>
<translation id="2718390899429598676">Қосымша қауіпсіздік үшін Chromium деректеріңізді шифрлайды.</translation>
<translation id="1874696651662237927">João Browser-нен Google аккаунтын өшіру үшін аккаунттан шығыңыз.</translation>
<translation id="6850669719663104304">Құпия сөздерді, бетбелгілер мен басқа ақпаратты барлық құрылғыдан алу үшін João Browser аккаунтына кіріңіз.</translation>
<translation id="2738871930057338499">Интернетке қосылу мүмкін емес. HTTP 403 бойынша тыйым салынған. Прокси конфигурациясын тексеріңіз.</translation>
<translation id="2753623023919742414">Іздеу үшін басыңыз.</translation>
<translation id="4193420110872590792">João Browser-ді әдепкі PDF көру құралы ретінде орнату</translation>
<translation id="6614401181366354261">Бұл кеңейтімде зиянды бағдарлама бар болғандықтан, ол қауіпті. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны João Browser-нан жойыңыз.</translation>
<translation id="2799223571221894425">Қайта іске қосу</translation>
<translation id="6299858290790311689">Сіздің João Browser браузеріңіз</translation>
<translation id="2816462166102338036">Бұл бейнені сурет іздеу функциясымен іздеу</translation>
<translation id="5896458971800337862">Жол-жөнекей iOS-тегі João Browser арқылы камерамен тауарларды тауып, бағаның төмендеуін бақылап, басқа да әрекеттерді орындаңыз.</translation>
<translation id="2841525013647267359">Бастапқы тіл</translation>
<translation id="2846251086934905009">Орнату қатесі: орнату аяқталмады, оның орнына доғарылды.</translation>
<translation id="4357241592510111611">João Browser жүйесінен алып тастау…</translation>
<translation id="2850691299438350830">Аккаунтқа кірген кезде, Chromium браузерінде қауіпсіздігіңізді қамтамасыз етеді және басқа Google қолданбаларында қауіпсіздік деңгейін арттыру үшін пайдаланылуы мүмкін.</translation>
<translation id="2885378588091291677">Тапсырмалар реттегіші</translation>
<translation id="8887040619780090085">&amp;João Browser туралы</translation>
<translation id="2915996080311180594">Кейін қайта қосу</translation>
<translation id="6619708652934279502">Деректер құпия фразаңызбен шифрланды. Google аккаунтыңызда João Browser деректерін пайдалану және сақтау үшін оны енгізіңіз.</translation>
<translation id="2945997411976714835">Орнату қатесі: орнату процесі басталмады.</translation>
<translation id="4566114009566397386">iOS жүйесіне арналған João Browser-де сақталған құпия сөздер арқылы сайттарға жылдам кіріңіз.</translation>
<translation id="562175540137901632">João Browser-ді ұйымыңыз басқарады</translation>
<translation id="2977470724722393594">Chromium жаңартылған</translation>
<translation id="2977506796191543575">Егер сайт құпия сөзіңізді ұрлағысы келсе немесе зиянды файлды жүктеп алсаңыз, Chromium браузері URL мекенжайларын, сондай-ақ бет контенті бөліктерін Safe Browsing қызметіне жіберуі мүмкін.</translation>
<translation id="1776205510657237623">Ата-анаңыздың таңдауымен интернетті қауіпсіз пайдалану үшін João Browser-ге кіріңіз.</translation>
<translation id="3003694935412297923">Барлық тапсырма</translation>
<translation id="3374694374267805392">{count,plural, =1{João Browser браузері деректерді Google аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер (1 элемент) жойылады.}other{João Browser браузері деректерді Google аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер ({count} элемент) жойылады.}}</translation>
<translation id="4915792193596835645"><ph name="URL" /> сілтемесі João Browser-дегі жаңа қойындыдан ашылады.</translation>
<translation id="302551344979399011">Дағдылар сияқты ЖИ инновациялары Google аккаунтыңызға сақталады және Chromium Sync-тен бөлек басқарылады.</translation>
<translation id="8367114375553489372">João Browser жүйесіне қосылуда…</translation>
<translation id="3038232873781883849">Сәлден соң орнатыла бастайды…</translation>
<translation id="3045032126857188731">Аударма тілі: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">"Пікір" диалогтік терезесін жабу</translation>
<translation id="6168172692486433600">Басқа João Browser профильдері</translation>
<translation id="884929993636327">Кеңейтімдер – João Browser браузерін бейімдеуге мүмкіндік беретін қосымшалар. Олар João Browser-ді өзіңізге ыңғайлы етіп реттеуге, күнделікті тапсырмаларды жеңілдетуге көмектеседі.</translation>
<translation id="1525897524206034002">Google компаниясына жаңылыс туралы есептер және <ph name="UMA_LINK" /> жіберу арқылы João Browser жақсартуға көмектесіңіз</translation>
<translation id="2766971658743453990">Жол-жөнекей Google қауіпсіздігін қамтамасыз ету үшін João Browser пайдаланыңыз.</translation>
<translation id="4387884830246074210">{NUM_DEVICES,plural, =0{1 USB құрылғысын бір немесе бірнеше João Browser кеңейтімі пайдаланды}=1{1 USB құрылғысын бір немесе бірнеше João Browser кеңейтімі пайдаланып жатыр}other{# USB құрылғысын бір немесе бірнеше João Browser кеңейтімі пайдаланып жатыр}}</translation>
<translation id="3413144813287436446">João Browser тарихы</translation>
<translation id="9192419056064225629">Орнату құралы мұрағаттан шығара алмады. João Browser қолданбасын қайта жүктеңіз.</translation>
<translation id="310459126943037700">Тапсырмалар аяқталмады.</translation>
<translation id="3104828284009500087">Беттегі кез келген нәрсені іздеңіз.</translation>
<translation id="3508468328135806512">Құпия сөздеріңіз, бетбелгілеріңіз және тарихыңыз құрылғыларда синхрондалады. Әдепкі браузеріңізді João Browser-ге жаңартып, өзіңізге таныс және ұнайтын функцияларды оңай пайдаланыңыз.</translation>
<translation id="3216151988142306917">João Browser микрофоныңызды пайдалануда.</translation>
<translation id="3130333203120345554">Жаңадан іздеу</translation>
<translation id="3137969841538672700">Іздеу үшін курсорды жүргізіңіз.</translation>
<translation id="7493177208577109722">Бұл қойынды ресурстарды көп қолданып жатыр. Өнімділікті жақсарту үшін João Browser-ге оны әрекетсіз қылуға рұқсат беріңіз.</translation>
<translation id="7239354789967255675">Экранды бөлісу үшін жүйе параметрлерінде João Browser-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="4955872590603594814">João Browser қолданбасын қайта іске қосу</translation>
<translation id="3161522574479303604">Барлық тіл</translation>
<translation id="4697739132113629685">Сілтемені João Browser инкогнито терезесінде ашу</translation>
<translation id="1629247860984475766">Жаңа João Browser профилін реттеңіз.</translation>
<translation id="1905008150929775692">Қойындыларды ауыстырмай-ақ ЖИ режимінде сөйлесе беруге болады. Бастау үшін João Browser-ге кіріңіз. Құпия сөздер мен басқа деректеріңіз барлық құрылғыңызда қолжетімді болады.</translation>
<translation id="4232381420311815141">João Browser-нен Google аккаунтын өшіру үшін João Browser-нен "Параметрлер" бетінде шығыңыз.</translation>
<translation id="3234316605225071811">Кейінірек Chromium сізден үлгілерді автоматты түрде толтыру үшін сақталған ақпаратты пайдалану-пайдаланбау қажеттігін сұрауы мүмкін.</translation>
<translation id="6676749542734993844">João Browser өзінің деректер каталогін оқи және оған жаза алмайды:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">Таңдаулы Google AI құралдарын iOS-тегі João Browser-де жол-жөнекей алып жүріңіз.</translation>
<translation id="3286538390144397061">Қазір қайта іске қосу</translation>
<translation id="532528773927600103">Google API пернелері жоқ. Кейбір João Browser функциялары өшіріледі.</translation>
<translation id="3296368748942286671">Chromium жабылғанда, фондық қолданбаларды пайдалануды жалғастыру</translation>
<translation id="3313189106987092621">Chromium кез келген сайтты қауіпті байланыс арқылы жүктеу алдында сізге ескертеді.</translation>
<translation id="8095477191923518137">João Browser-де аккаунтқа кірген болсаңыз, барлық João Browser терезесін жапқан кезде, Google аккаунтын қоспағанда, сайттардың көпшілігінен шығарыласыз. Сайттар сізді есте сақтасын десеңіз, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">іздеу аймағының жоғарғы оң жақ бұрышы: оң жақ <ph name="RIGHT" />%, жоғарғы жақ <ph name="TOP" />%</translation>
<translation id="3366305173356742781">Аккаунтыңыздағы Chromium деректері</translation>
<translation id="3234882977104294240">Құпия сөздерді телефондағы João Browser-мен пайдаланыңыз</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="2974199599420431595">Бұрыннан бар João Browser профиліне ауыстырылсын ба?</translation>
<translation id="3412460710772753638">Осы құрылғыдағы Құпия сөз менеджерінде</translation>
<translation id="3438772217992559640">Бұл қойындыны сурет іздеу функциясымен іздеу</translation>
<translation id="8318147705317768982">Телефоныңыздағы João Browser браузерімен күшейтілген Safe Browsing мүмкіндіктерін кеңейтіңіз</translation>
<translation id="347392028839310978">João Browser-ді сізге бейімдеп жатырмыз...</translation>
<translation id="3474745554856756813">Құрылғыдан <ph name="ITEMS_COUNT" /> элемент жойылады. Деректерді кейінірек алу үшін Chromium браузеріне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="5805833167703404998"><ph name="SHORTCUT" /> арқылы João Browser профильдерін ауыстыруға болады.</translation>
<translation id="1835124883585653877">Барлық João Browser терезелерін жауып, әрекетті қайталап көріңіз.</translation>
<translation id="7106246566966568195">Терезені бөлісу үшін жүйе параметрлерінде João Browser-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="6017005873246021363"><ph name="EXISTING_USER" /> әлдеқашан кірді.  Браузерді пайдалану тарихын бөлек сақтау үшін João Browser-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз.</translation>
<translation id="1146681170626381319">João Browser браузерін мобильдік құрылғыларға жүктеп алуға арналған QR коды</translation>
<translation id="354621070532799440">Еске салғыш: Google-дың ең үздік қауіпсіздік функциялары қалтаңызда болады</translation>
<translation id="2488701737291439763">Экранды бөлісу үшін жүйе параметрлерінде João Browser-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="3588112919289558122">Күшейтілген қорғаныс Chromium танымайтын сайттар үшін JavaScript оңтайландыру мүмкіндігін өшіреді.</translation>
<translation id="3597003331831379823">Реттеуді кеңейтілген құқықтармен бастау мүмкін болмады. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">João Browser аккаунтына кіріңіз</translation>
<translation id="5985252758124395804">Бұл пайдаланушының браузерді пайдалану деректері құрылғыдан жойылады. Деректерді қалпына келтіру үшін João Browser браузеріне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{João Browser браузерінің жаңа нұсқасы шықты. Ол браузерді өшіріп, қайта іске қосқанда орнатылады.}=1{João Browser браузерінің жаңа нұсқасы шықты. Ол браузерді өшіріп, қайта іске қосқанда орнатылады. Инкогнито терезесі қайта ашылмайды.}other{João Browser браузерінің жаңа нұсқасы шықты. Ол браузерді өшіріп, қайта іске қосқанда орнатылады. # инкогнито терезесі қайта ашылмайды.}}</translation>
<translation id="3667616615096815454">Орнату мүмкін болмады, себебі сервер қолданбаны анықтай алмады.</translation>
<translation id="3675854891107786059">Google аккаунтындағы барлық Chromium дерегін шифрлау үшін <ph name="BEGIN_LINK" />жеке құпия фразаны<ph name="END_LINK" /> пайдаланыңыз. Google Pay қызметіндегі төлеу әдістері мен мекенжайлары шифрланбайды. Chromium-нің браузерді қолдану тарихы синхрондалмайды.</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{Жаңартылған нұсқасын қолдану үшін әкімші João Browser-ді қайта іске қосуыңызды сұрайды.}=1{Жаңартылған нұсқасын қолдану үшін әкімші João Browser-ді қайта іске қосуыңызды сұрайды. Инкогнито терезесі қайта ашылмайды.}other{Жаңартылған нұсқасын қолдану үшін әкімші João Browser-ді қайта іске қосуыңызды сұрайды. # инкогнито терезесі қайта ашылмайды.}}</translation>
<translation id="4134769722455445399">Сілтемені жаңа João Browser қойындысында ашу</translation>
<translation id="3728124580182886854">Жекелендіру және басқа мақсаттарды орындау үшін Chromium мен басқа Google қызметтерін байланыстырыңыз.</translation>
<translation id="3729187154190517324">"Қойынды және т.б. қосу" түймесін басып, бірнеше қойынды, файл және құрал қосып, жан-жақты іздеңіз.</translation>
<translation id="655691042235349825">João Browser профильдерін басқару</translation>
<translation id="8494798931804571569">Неліктен João Browser кейбір жүктеп алынғандарды блоктайтыны туралы ақпарат алыңыз</translation>
<translation id="379589255253486813">Тексеруге қажетті нәрсе болса, Chromium сізге хабар береді</translation>
<translation id="3802055581630249637">Chromium сіз кіруіңіз мүмкін беттерді алдын ала жүктейді, сонда оларға кірген кезіңізде, тезірек жүктеледі.</translation>
<translation id="3810973564298564668">Басқару</translation>
<translation id="6945066279282141856">Сақталған құпия сөздерді пайдалану үшін QR кодын қолданып, iOS-ке арналған João Browser браузерін жүктеп алып, Google аккаунтына кіріңіз.</translation>
<translation id="3846683726093018685">**Қысқаша мазмұндау:** скриншоттағы контенттің негізгі тақырыбы мен мақсатын 30 сөзден аспайтын бір сөйлеммен сипатта.

          **Сұрақтар ұсыну:** пайдаланушының скриншотты жете түсінуіне көмектесетін, ой тудыратын 3–5 сұрақтан тұратын таңбаланған тізім жаса. Бұл сұрақтардың кемінде біреуі нақты визуалдық нысан, оның дизайны немесе орналасуы туралы болуы керек.</translation>
<translation id="4996569675441627032"><ph name="PAGE_TITLE" /> – João Browser</translation>
<translation id="6008740052107737825">João Browser бұл сайт үшін жергілікті желіні пайдалануға рұқсат сұрайды</translation>
<translation id="3885770153807205175">Тіл таңдағыш</translation>
<translation id="2390004682597453662">João Browser-ді реттеу және басқару. Назар аударуыңыз қажет. Толығырақ ақпарат алу үшін басыңыз.</translation>
<translation id="8262407643678629134">João Browser ашу үшін атыңызды басып, шарлауды бастаңыз.</translation>
<translation id="3892148308691398805">Мәтінді көшіру</translation>
<translation id="2168201717554927204"><ph name="EXISTING_USER" /> бұл João Browser профиліне кіріп қойған. Браузерді пайдалану деректерін бөлек сақтау үшін João Browser сізге жеке профиль жасай алады.</translation>
<translation id="1046732460303790107">Бұл кеңейтім Chrome Web Store саясатына қайшы, сондықтан қауіпті болуы мүмкін. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны João Browser-нан жойыңыз.</translation>
<translation id="3941890832296813527">Орнату қатесі: орнату файлының атауы жарамсыз немесе оған қолдау көрсетілмейді.</translation>
<translation id="3879366121647289622">João Browser құпия сөздерді көшіргісі келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="7332365758981378072">Google аккаунтыңызға сақтаған құпия сөздер, төлеу әдістері және мекенжайлар осы құрылғыдан өшіріледі. Оларды João Browser-де қайта пайдалану үшін аккаунтқа қайтадан кіріңіз.</translation>
<translation id="395904275706073188">Қорғалған беттерді оқу мүмкін емес. Басқа бетті байқап көріңіз.</translation>
<translation id="3962647064319009959">Chromium сізді қалай қорғайтыны туралы ақпарат алыңыз</translation>
<translation id="3967822245660637423">Жүктеп алынды</translation>
<translation id="3971865010372729242">Мекенжай жолағына немесе іздеу өрісіне терген кезіңізде, Chromium ұсыныстар алу үшін терген нәрсеңізді ұйымның іздеу жүйесіне, жасанды интеллектіге және агент құралдарына жібереді.</translation>
<translation id="3975724895399328945">&amp;Google Chrome for Testing туралы</translation>
<translation id="3997429360543082038">ChromiumOS туралы</translation>
<translation id="4010059961270896984">Сайтқа кірген кезіңізде, Chromium браузері URL мекенжайының обфускация жасалған бөлігін IP мекенжайыңызды жасыратын құпиялық сервері арқылы <ph name="BEGIN_LINK" />Google Safe Browsing-ге<ph name="END_LINK" /> жібереді. Сайтта күдікті әрекеттер орындалса, толық URL мекенжайлары және беттегі контент бөліктері де жіберіледі.</translation>
<translation id="4016217212818346953">Password Manager-мен қауіпсіздікті сақтаңыз</translation>
<translation id="4019629340646866719">ChromiumOS жүйесі де <ph name="BEGIN_LINK_LINUX_OSS" />Linux әзірлеу ортасы<ph name="END_LINK_LINUX_OSS" /> сияқты <ph name="BEGIN_LINK_CROS_OSS" />ашық кодты бағдарламалық құрал<ph name="END_LINK_CROS_OSS" /> арқылы қолжетімді болады.</translation>
<translation id="4022972681110646219">Экран мазмұнын аудару</translation>
<translation id="4023601594785368013">Түпнұсқа тілі: <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">Кез келген қолданба сілтемесін João Browser-нен ашыңыз. Оңай қол жеткізу үшін ол тапсырмалар жолағына бекітіледі.</translation>
<translation id="4036079820698952681"><ph name="BEGIN_LINK" />Ағымдағы параметрлерді<ph name="END_LINK" /> хабарлау арқылы Chromium браузерін жақсартуға көмектесіңіз</translation>
<translation id="4050175100176540509">Соңғы нұсқасында қауіпсіздік жақсартылып, жаңа мүмкіндіктер берілген.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="615818333141511791">{COUNT,plural, =1{João Browser 1 минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады. Браузерді пайдалану деректері жойылады. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін.}other{João Browser # минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады. Браузерді пайдалану деректері жойылады. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін.}}</translation>
<translation id="4118474109249235144">Chromium-нің инкогнито режимі</translation>
<translation id="4122186850977583290">"Chromium туралы ақпарат" бетіне өту</translation>
<translation id="9207280419664362385">Браузеріңізге жаңа көрініс беру үшін João Browser-ді бейімдеңіз</translation>
<translation id="3719803995198923598">João Browser браузеріңізді бейімдеңіз</translation>
<translation id="4148957013307229264">Орнатылуда…</translation>
<translation id="2954462321765112214"><ph name="PAGE_TITLE" /> –Желіге кіру – João Browser</translation>
<translation id="7812363663832111420">João Browser үшін тамаша қолданбалар, ойындар мен тақырыптарды таба аласыз.</translation>
<translation id="69200600645763018">Осы кеңейтімді және тағы басқасын компьютерлеріңізге орнату үшін João Browser аккаунтына кіріңіз.</translation>
<translation id="7505863944027312744">Ата-анаңыздың таңдауымен интернетті қауіпсіз пайдалану үшін <ph name="USER_EMAIL_ADDRESS" /> ретінде кірген João Browser профиліңізге ауысыңыз.</translation>
<translation id="4222932583846282852">Бас тартылуда…</translation>
<translation id="4224210481850767180">Орнату тоқтатылды.</translation>
<translation id="8090594705972340646">João Browser дерегіңізді осы аккаунтпен байланыстырасыз ба?</translation>
<translation id="4251772536351901305">Стандартты қорғанысқа қарағанда сайттардағы көбірек деректерді талдау арқылы қауіпті сайттар, тіпті Google-ға бұрын белгісіз болған сайттар туралы ескертеді. Chromium ескертулерін өткізіп жіберуді таңдауға болады.</translation>
<translation id="5696119579094527589">João Browser-нен шығу</translation>
<translation id="4271805377592243930">Chromium жөнінде анықтама алу</translation>
<translation id="4281844954008187215">Қызмет көрсету шарттары</translation>
<translation id="1245307320228150348">Орнату анықталмаған қате себебінен сәтсіз аяқталды. Ағымда João Browser жұмыс істеп тұрса, оны жауып, әрекетті қайталаңыз.</translation>
<translation id="7405356088321579627">Құпия сөздерді João Browser-нен экспорттау</translation>
<translation id="4304713468139749426">Құпия сөздер реттегіші</translation>
<translation id="4334241893986177674">Осы скриншотты іздеу</translation>
<translation id="212570256141568951">Windows жұмысын бастағанда, João Browser-ді іске қосады</translation>
<translation id="4400772909124543403">Ешқандай жаңарту жоқ.</translation>
<translation id="7463042547966071103">João Browser браузерінен бәрібір шығасыз ба?</translation>
<translation id="4413205837991854510">"Сурет іздеу" жылдам пәрменін үнемі көрсету</translation>
<translation id="4736206301215400753">João Browser браузеріне фондық режимде жұмыс істеуге рұқсат беру</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{João Browser оны өшіруге кеңес береді. <ph name="BEGIN_LINK" />Қолдау көрсетілетін кеңейтімдер туралы толық ақпарат алыңыз.<ph name="END_LINK" />}other{João Browser оларды өшіруге кеңес береді. <ph name="BEGIN_LINK" />Қолдау көрсетілетін кеңейтімдер туралы толық ақпарат алыңыз.<ph name="END_LINK" />}}</translation>
<translation id="5305058100936019600">João Browser реттеу және басқару</translation>
<translation id="4427306783828095590">Жақсартылған қорғаныс фишинг пен зиянды бағдарламаларды бөгеуде көбірек істейді.</translation>
<translation id="4434353761996769206">Орнату құралының қатесі: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3461955321878243607">João Browser-ді <ph name="MANAGER" /> басқарады</translation>
<translation id="3379477508903866078">João Browser профилін қосу</translation>
<translation id="4447409407328223819">Chrome for Testing туралы</translation>
<translation id="4074057296993529937">Google аккаунтыңызда João Browser деректерін пайдалану және сақтау үшін құпия фразаңызды енгізіңіз.</translation>
<translation id="4493028449971051158">Іске қосу қатесі: орнату құралын әкімші ретінде іске қосыңыз.</translation>
<translation id="4501471624619070934">Орнату мүмкін болмады, себебі бұл елде кіруге шектеу қойылған.</translation>
<translation id="8624811527667906941">Бұл кеңейтім пайдаланушы деректерін қалай жинап, қолданатыны сияқты құпиялық шараларын жарияламаған. João Browser оны өшіруге кеңес береді.</translation>
<translation id="5571435860030744559">João Browser браузеріне қош келдіңіз! Жаңа браузер терезесі ашылды.</translation>
<translation id="8132016625974854930">João Browser-ге айналаңызды картаға түсіруге және қолыңызды бақылауға рұқсат қажет.</translation>
<translation id="6599071882590417739">Басқа João Browser профилінде әлдеқашан <ph name="USER_EMAIL_ADDRESS" /> ретінде кіргенсіз.</translation>
<translation id="4548534452171747496">Chromium беттерді алдын ала жүктейді, осылайша браузерді пайдалану және іздеу әрекеті тез жүреді. <ph name="BEGIN_LINK" />Беттерді алдын ала жүктеу туралы толық ақпарат<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Зиянды деп ойлаған сайт туралы шағымданғанда, онлайн қауіпсіздікті барлық пайдаланушы үшін жақсартыңыз.</translation>
<translation id="202208802191333704">João Browser жүктеп алуды блоктады, себебі Safe Browsing функциясы өшірілді және файлды растау мүмкін емес.</translation>
<translation id="3128308674776200516">Телефоныңыздағы João Browser-мен Google Lens-ді пайдаланып көріңіз</translation>
<translation id="4594305310729380060">Осы құрылғыдағы Құпия сөз менеджеріне</translation>
<translation id="7653380076752216509">João Browser қолданбалары</translation>
<translation id="4598116752460667024">Тізімнен кез келген процесті іздейді.</translation>
<translation id="4613863813562375431">ChromiumOS нұсқасы</translation>
<translation id="4621240073146040695">Сәл қалды! Жаңартуды аяқтау үшін Chromium жүйесін қайта іске қосыңыз.</translation>
<translation id="1497446027991908251">João Browser-нің V8 жүйесімен сайттар жылдам жұмыс істейді, бірақ João Browser-нің шабуылдарға төзімділігі сәл азаяды.</translation>
<translation id="7523749920868634278">Ескерту: João Browser кеңейтімдердің браузерді қолдану тарихын жазуына кедергі бола алмайды. Бұл кеңейтімді Инкогнито режимінде өшіру үшін бұл опцияның белгісін алып тастаңыз.</translation>
<translation id="4673151026126227699">Chromium пайдалану есептерін де бөліссеңіз, бұл есептерде сіз кірген URL мекенжайлары қамтылады.</translation>
<translation id="4673710618874938871"><ph name="USER_NAME" /> (мүше) ретінде кірдіңіз. Аккаунт мәзірін ашу</translation>
<translation id="6608258642372806522">Профиль басқа João Browser процесімен (<ph name="PROCESS_ID" />) басқа компьютерде (<ph name="HOST_NAME" />) пайдаланылып жатыр. Бүлінбеуі үшін João Browser профильді құлыптап қойды. Басқа процестер бұл профильді пайдаланып жатпаса, профильді құлыптан ашып, João Browser қайта іске қосуыңызға болады.</translation>
<translation id="4680828127924988555">Орнатудан бас тарту</translation>
<translation id="3912572071294857936">João Browser деректерінің кейбірі Google аккаунтыңызға әлі сақталмаған. Шығу алдында бірнеше минут күтіп көріңіз. Қазір шықсаңыз, бұл деректер жойылады.</translation>
<translation id="1077152188344040592">Аккаунтқа кірсеңіз, João Browser-нен Google аккаунтыңыздағы құпия сөздер мен т.б. ақпаратты пайдалана аласыз. <ph name="SHORTCUT" /> тіркесімі арқылы Google қызметтерінің параметрлерін өзгертуге болады.</translation>
<translation id="5729536702149847030">Бұрын әлдекім осы компьютерден João Browser браузеріне <ph name="ACCOUNT_EMAIL_LAST" /> болып кірген. Ақпаратты бөлек ұстау үшін жаңа João Browser пайдаланушысын жасаңыз.</translation>
<translation id="4724676981607797757">Орнатылмады, себебі қолдау көрсетілмейтін протокол қатесі пайда болды.</translation>
<translation id="6273241729694500032">João Browser браузерінен бәрібір шығасыз ба?</translation>
<translation id="3239680024825449390">João Browser браузеріне қазір ғана қауіпсіздік бойынша арнайы жаңартылған нұсқа қолданылды. Оны қазір қайта ашсаңыз, қойындылар қалпына келтіріледі.</translation>
<translation id="4771701986670315895">Жақында кірмедіңіз. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> рұқсаттарын және тағы <ph name="COUNT" /> рұқсатты өшірді.</translation>
<translation id="1908292729364083164">João Browser-дегі Gemini ашық болса, жаңа қойындылар жасаған кезде, бүйірлік панель ашық қалады.</translation>
<translation id="479167709087336770">Google Search қызметіндегі емле тексеру құралы пайдаланылады. Браузерде терілген мәтін Google-ға жіберіледі. Мұны параметрлерде өзгертуіңізге болады.</translation>
<translation id="189382710647501724">João Browser-ді аккаунтсыз қолдану</translation>
<translation id="4456919965836032212">mDNS трафигіне рұқсат беретін João Browser кіріс ережесі.</translation>
<translation id="3486986778673504636">&amp;João Browser-ді жаңарту үшін қайта іске қосу</translation>
<translation id="4918086044614829423">Қабылдау</translation>
<translation id="4918844574251943176">Сурет көшірілді.</translation>
<translation id="1571932028747131277">João Browser фондық режимде.</translation>
<translation id="7612124006067933008">João Browser-ге кірудің диалогтік терезесін жабу үшін басыңыз.</translation>
<translation id="2598788273876744576">João Browser профильдері арқылы João Browser-дегі барлық материалыңызды бөле аласыз. Достар мен отбасыңызға арналған немесе жұмысқа не көңіл көтеруге бөлек профильдер жасаңыз.</translation>
<translation id="2115498792600385171">Қонақтар João Browser қолданбасын ешқандай дерек қалдырмай пайдалана алады.</translation>
<translation id="6870732303439257966">João Browser-дегі аккаунтыңыз</translation>
<translation id="4366792189726044065">João Browser жүйесіне өзіңізді қосу</translation>
<translation id="504699503110800016">Қосымша мәзірді ашу</translation>
<translation id="4340125167559705618"><ph name="DEVICE_TYPE" /> құрылғысындағы João Browser-мен Google-дың барлық таңдаулы қызметін пайдаланыңыз.</translation>
<translation id="4916697359431064123">João Browser қолыңызды бақылауға рұқсат сұрайды.</translation>
<translation id="5141988424377517949">Жақында кірмедіңіз. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" /> рұқсаттарын өшірді.</translation>
<translation id="5174969993834422967">Әдетте хабарландыруларға тыйым саласыз. Бұл сайт сізге хабарландыру жіберсін десеңіз, локация жолағының оң жақ бұрышындағы хабарландыру белгішесін басыңыз.</translation>
<translation id="5174983315706567306">Диск жады жеткіліксіз.</translation>
<translation id="961070648267203077">João Browser аккаунтын қайта аутентификациялау қажет.</translation>
<translation id="69363826605946518">iOS-тегі João Browser-де тоқтаған жеріңізден жалғастырыңыз.</translation>
<translation id="471694954923709047">João Browser жүйесінен шығу</translation>
<translation id="5234764350956374838">Жабу</translation>
<translation id="5782956358171235578">Сілтемені João Browser инкогнито терезесінде ашу</translation>
<translation id="903712329052383264">Құпия сөздерді кез келген жерде сақтау үшін João Browser қолданбасын жүктеп алыңыз</translation>
<translation id="5277894862589591112">Өзгерістер енуі үшін, Chromium браузерін қайта қосыңыз</translation>
<translation id="5286907366254680517">Анықталды</translation>
<translation id="5593827909938092728">João Browser қолданбасын жүктеп алу</translation>
<translation id="5294316920224716406">Инкогнито режимін пайдаланған кезде, Chromium сайтты қауіпті байланыс арқылы жүктеу алдында сізге ескертеді.</translation>
<translation id="1066981078513393795">"João Browser-ді жаңарту құралы" ішкі қызметі</translation>
<translation id="5324450571874973775">Оларды Chromium-дегі басқа Gemini функцияларымен бірге пайдаланыңыз.</translation>
<translation id="5346389065299425353">Бірнеше қойынды, файл және құрал қосып, жан-жақты іздеңіз.</translation>
<translation id="1884203704972162365">João Browser-дегі Gemini көмегімен осы құжаттың қысқаша мазмұнын біліп, сұрақтар қойыңыз.</translation>
<translation id="5352264705793813212">Chromium тексеруге қажетті қауіпсіздікке қатысты кейбір ұсыныстарды тапты</translation>
<translation id="4819697639570429319">Басқа João Browser профильдері</translation>
<translation id="7878591304929138776">ChromiumOS жүйесі João Browser деректерін Google аккаунтыңызға сақтай алмады, себебі аккаунтыңызға кіру мәліметтері ескірген.</translation>
<translation id="5249614051186670898">Бақыланатын аккаунт арқылы кірдіңіз және оның әкімшілік бөлігін João Browser профилі арқылы басқару мүмкіндігін бердіңіз. Қолданбалар, бетбелгілер, журнал, құпия сөздер сияқты João Browser деректеріңіз және басқа параметрлер біржола <ph name="USER_NAME" /> пайдаланушысына байланыстырылады. Бұл деректерді Google аккаунт бақылау тақтасы арқылы жоя аласыз, бірақ бұл деректерді басқа аккаунтмен байланыстыра алмайсыз. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Қосымша код: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Жекелендіру үшін Chromium-ді интернет пен қолданбаларды пайдалану тарихына қосыңыз.</translation>
<translation id="108952623091824942">Неліктен João Browser кейбір файлдарды блоктайтыны туралы ақпарат алыңыз</translation>
<translation id="5386450000063123300">Chromium жаңартылуда (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Chromium браузеріне кіруге рұқсат ету</translation>
<translation id="1265086181910844216">João Browser-нен жою</translation>
<translation id="1500700851187484222">Өнімділік азаяды, бірақ João Browser шабуылдарға төзімді болады.</translation>
<translation id="6665657403278704382">Әдепкі браузер ретінде João Browser қолданбасын орнату</translation>
<translation id="3520901681432894293"><ph name="PAGE_TITLE" /> - João Browser бета нұсқасы</translation>
<translation id="5994273394215159270">{NUM_TABS,plural, =1{João Browser браузер жұмысын баяулататын қойындыны кідіртуді ұсынады}other{João Browser браузер жұмысын баяулататын қойындыларды кідіртуді ұсынады}}</translation>
<translation id="646791423998269453">João Browser дұрыс жұмыс істемеуі мүмкін, себебі оған Linux жүйесінде қолдау көрсетілмейді.</translation>
<translation id="7249139852479053716">João Browser бұл файлды жүктеп алуға тыйым салды, себебі ол жеке және әлеуметтік желі аккаунттарыңызға қауіп төндіруі мүмкін</translation>
<translation id="478612683981218420">João Browser ең соңғы жүйе жаңартуларын орнатуда, күте тұрыңыз.</translation>
<translation id="3466187211963597724">João Browser құпия сөздерді өзгерткісі келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="3133978491361824131">João Browser-мен жол-жөнекей Google Drive және YouTube сияқты сүйікті қолданбаларыңызды кедергісіз пайдаланыңыз.</translation>
<translation id="5524890928877629608">іздеу аймағының жоғарғы сол жақ бұрышы: сол жақ <ph name="LEFT" />%, жоғарғы жақ <ph name="TOP" />%</translation>
<translation id="5527463683072221100">PDF-терді Chromium-де ашу</translation>
<translation id="5536164441519929134">Осы қойынды туралы<ph name="LINE_BREAK" />сұраңыз</translation>
<translation id="3902123582863904748">Сайтқа бірінші рет кірген кезіңізде, João Browser браузері қауіпсіздік үшін JavaScript оңтайландыру әдісін өшіреді.

Бұл бет ойдағыдай істемесе, оңтайландыруға рұқсат беріп көріңіз.</translation>
<translation id="5924481826213021755">João Browser-дегі Gemini-ды Mac мәзір жолағында көрсету және пернелер тіркесімін қосу</translation>
<translation id="4988760628116707723"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін João Browser-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Сақталған ақпарат пен басқа деректерді <ph name="DEVICE" /> ала аласыз.</translation>
<translation id="5579324208890605088">Іске қосу қатесі: орнату құралын әкімші емес, кәдімгі пайдаланушы ретінде іске қосыңыз.</translation>
<translation id="697769674160644707">João Browser-ді әдепкісінше пайдалану және бекіту</translation>
<translation id="5596627076506792578">Қосымша опциялар</translation>
<translation id="5605834417512968703">"Сурет іздеу" функциясы арқылы іздеу керек кез келген нәрсені таңдаңыз немесе бұл функциядан шығу үшін Escape пернесін басыңыз.</translation>
<translation id="5618818588972826921">"Сурет іздеу" функциясымен іздеу керек кез келген мәтінді не суретті таңдаңыз немесе "Сурет іздеу" функциясынан шығу үшін Escape пернесін басыңыз.</translation>
<translation id="2497422928854452258">{0,plural, =0{João Browser браузерінің жаңартылған нұсқасы қолжетімді}=1{João Browser браузерінің жаңартылған нұсқасы қолжетімді}other{João Browser браузерінің жаңартылған нұсқасы # күннен бері қолжетімді}}</translation>
<translation id="5643865575100044307">Chromium браузерін жапқан кезде құрылғыңыздан сайт деректерін үнемі жою</translation>
<translation id="620465883043431255">João Browser браузерін қайта іске қосыңыз</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Chromium жүйесін осы тілде көрсету</translation>
<translation id="569897634095159764">Интернетке қосылу мүмкін емес. Прокси-сервер үшін аутентификация қажет.</translation>
<translation id="5768371961535086509">Chromium әрекетсіз қойындылардағы жадты босатады. Мұның нәтижесінде белсенді қойындылар мен басқа қолданбаларға қосымша компьютер ресурстары үлестіріліп, Chromium жылдам жұмыс істейді. Әрекетсіз қойындыларды ашқанда, олар автоматты түрде қайтадан белсенді болады. <ph name="BEGIN_LINK" />Жад үнемдегіш туралы толық ақпарат<ph name="END_LINK" /></translation>
<translation id="8866372822266732235">Құпия фразаны ұмытып қалған болсаңыз немесе осы параметрді өзгерту керек болса, аккаунтыңыздағы João Browser деректерін <ph name="SETTINGS_LINK" />.</translation>
<translation id="2106070764285625641">João Browser-ді бейімдеңіз және басқарыңыз. João Browser-ді әдепкі браузер етіп орнатыңыз.</translation>
<translation id="9077878413488413377">João Browser-ді әдепкі браузер етіп орнату арқылы құпия сөздеріңізді, бетбелгілеріңізді және тарихыңызды құрылғыларда синхрондаңыз.</translation>
<translation id="5809516625706423866">Интернетке қосылу мүмкін емес. HTTP 401 бойынша рұқсат берілмейді. Прокси конфигурациясын тексеріңіз.</translation>
<translation id="614221876503883218">João Browser-нің V8 жүйесімен сайттар жылдам жұмыс істейді, бірақ João Browser-нің шабуылдарға төзімділігі сәл азаяды. Бұл параметр өшірулі.</translation>
<translation id="8788365803279840995">Google аккаунтындағы João Browser деректерін пайдалану және сақтау үшін João Browser-ді жаңартыңыз.</translation>
<translation id="5824893331272123205">Бұл панельді жүктеу мүмкін болмады. Әрекетті қайталаңыз</translation>
<translation id="5805760187441013922">João Browser жүйесіне қош келдіңіз</translation>
<translation id="5867606647614813312">Chromium-де ең күшті қорғау мүмкіндігін қамтамасыз ету үшін қосымша функцияларды қосады.</translation>
<translation id="5871205389137001634">"Сурет іздеу" функциясынан шығу үшін басыңыз.</translation>
<translation id="8367098380158627809">João Browser бұл элементтерде зиянды бағдарлама бар екенін анықтады:</translation>
<translation id="5889361821821684993">Браузеріңізде ең қауіпсіз параметрлер бар екеніне көз жеткізу үшін Chromium жүйелі түрде тексереді. Пікіріңіз керек болса, сізге хабар жібереміз.</translation>
<translation id="5895138241574237353">Қайта іске қосу</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – Желіге кіру</translation>
<translation id="5924017743176219022">Интернетке қосылып жатыр…</translation>
<translation id="7627350220326904504">João Browser браузерін дайындайық</translation>
<translation id="5941711191222866238">Жию</translation>
<translation id="8680863040348007215">Осы бетбелгі және басқа да көптеген нәрселер барлық құрылғыңызда болуы үшін, João Browser-ға кіріңіз.</translation>
<translation id="2008232276062354182">João Browser-ді өзіңізге сай бейімдеңіз</translation>
<translation id="5960071705175224773">Параметрлеріңізді белгісіз қолданба өзгертті</translation>
<translation id="5977420883993828287">Бекітілді! Контекстік тапсырмаларды құралдар тақтасынан қайта пайдаланыңыз.</translation>
<translation id="5889362640603897718">{COUNT,plural, =1{João Browser 1 минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады.}other{João Browser # минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады.}}</translation>
<translation id="4971097497342057998">João Browser браузерін жаңартып, синхрондауды бастаңыз</translation>
<translation id="5990360079535151574">Шолу кезінде сұрақ қою үшін құралдар тақтасындағы "Контекстік тапсырмалар" түймесін басып, контекстік тапсырмаларды қайта ашуға болады.</translation>
<translation id="6003112304606738118">Жүктеп алынып жатыр… <ph name="HOURS" /> сағат қалды.</translation>
<translation id="6009821354356307391">Қосымша сұрақ қойыңыз</translation>
<translation id="6040143037577758943">Жабу</translation>
<translation id="2100398097168307292"><ph name="DEVICE_TYPE" /> құрылғысында João Browser пайдаланып, онлайн сатып алудан барынша пайда көріңіз</translation>
<translation id="6058380562449900225">Деректеріңізді қорғау үшін Chromium-ге сіз соңғы уақытта кірмеген сайттар рұқсаттарын өшіруге рұқсат беріңіз. Хабарландырулар көрсетіле береді.</translation>
<translation id="4735359759698689867">&amp;João Browser жүйесінде ашу</translation>
<translation id="6069027071882229820">Сурет түрінде көшіру</translation>
<translation id="2274675514456642321"><ph name="EXTENSION_NAME" /> кеңейтімі João Browser браузеріне енгізілді</translation>
<translation id="147381942282490529">João Browser браузерін реттеңіз және басқарыңыз. Жаңартылған нұсқа қолжетімді.</translation>
<translation id="8775234022739879423">Қосулы • João Browser бұл кеңейтімнің қайдан келгенін анықтай алмайды.</translation>
<translation id="6634821567165410381">João Browser-дегі аккаунтыңыз</translation>
<translation id="4398707227122702993">Кеңейтімге João Browser құралдар тақтасында сайтқа кіру сұрауларын көрсетуге рұқсат беру</translation>
<translation id="5370941509199989624"><ph name="FILE_NAME" /> қауіпті болғандықтан, João Browser оны бөгеді.</translation>
<translation id="5119118887583954582">João Browser жақын арада жабылып, деректерді жояды</translation>
<translation id="576637711620229618">Осы жерде João Browser профильдерін ауыстыра аласыз.</translation>
<translation id="615103374448673771">Егер cookie файлдарына рұқсат берсеңіз, Chromium оларды алдын ала жүктеу кезінде пайдалануы мүмкін.</translation>
<translation id="6165508094623778733">Толық ақпарат</translation>
<translation id="3738215896821824918">Аккаунттағы João Browser деректерін тазалау</translation>
<translation id="2145111683361496197">Бұл файл қауіпті болуы мүмкін.<ph name="LINE_BREAK" />Құпия сөзді көрсетсеңіз, João Browser бұл жүктеп алу әрекетін тексере алады. Файл туралы ақпарат Google Safe Browsing қызметіне жіберіледі, бірақ файл контенті мен құпия сөз құрылғыңызда қалады.</translation>
<translation id="6182736845697986886">Орнатылмады, себебі жаңарту серверінде ішкі қате пайда болды.</translation>
<translation id="6050294746023477088"><ph name="TARGET_DEVICE_NAME" /> құрылғысындағы João Browser браузеріне кіргеніңізді тексеріп, қайта жіберіп көріңіз.</translation>
<translation id="3395167674702947885">Бұл компьютерде жаңа João Browser нұсқасы бұрыннан бар. Бағдарламалық жасақтама жұмыс істемесе, João Browser жойып, әрекетті қайталап көріңіз.</translation>
<translation id="4384214545531685923">{0,plural, =0{João Browser браузері қазір қайта іске қосылады}=1{João Browser браузері 1 секундтан кейін қайта іске қосылады}other{João Browser браузері # секундтан кейін қайта іске қосылады}}</translation>
<translation id="5880255774989397049">João Browser файлдарды жүктеп алу үшін жадты пайдалануға рұқсат сұрайды.</translation>
<translation id="6245734527075554892">URL мекенжайларын Chromium браузерінде сақталған қауіпсіз емес сайттар тізімімен салыстырып тексереді.</translation>
<translation id="1959823478027154444">Әдепкі браузер ретінде João Browser орнату</translation>
<translation id="6248988683584659830">Іздеу параметрлері</translation>
<translation id="9191635841540101343">Телефондағы João Browser-мен Google-дың үздік қауіпсіздік функцияларын жол-жөнекей пайдаланыңыз</translation>
<translation id="538350741885862188">João Browser жүйесінен шығасыз ба?</translation>
<translation id="161121067714522736">Бұл қойындылар тым көп ресурстар қолданып жатыр. Өнімділікті жақсарту үшін João Browser-ге оларды әрекетсіз қылуға рұқсат беріңіз.</translation>
<translation id="2095090272560293574">João Browser профилін реттеу</translation>
<translation id="6290827346642914212">Chromium профиліне ат қойыңыз</translation>
<translation id="6472525517562723285">Кеңейтімді қолдану үшін João Browser-ге кіруіңіз керек</translation>
<translation id="2069878195899746465"><ph name="FILE_NAME" /> қауіпті болуы мүмкін болғандықтан, João Browser оны бөгеді.</translation>
<translation id="1283909912629029170">João Browser камераңызды пайдалануда.</translation>
<translation id="323902744000752306">João Browser браузерінде басқа операция орындалуда. Әрекетті кейінірек қайталаңыз.</translation>
<translation id="1292164882596462877">Енді João Browser қолданбасын Google аккаунтымен және ортақ компьютерлерде пайдалану жеңілірек.</translation>
<translation id="6411450594978516531">João Browser-ді әдепкі браузер етіп орнату арқылы өзіңіз білетін, ұнататын және сенетін функцияларды оңай пайдаланыңыз.</translation>
<translation id="3344301749774719950">João Browser пернелер тіркесімі</translation>
<translation id="8395825163097750991">João Browser жүктеп алуды блоктады, себебі бұл файл әдетте жүктеп алынбайды және ол қауіпті болуы мүмкін.</translation>
<translation id="7683737657427846440">João Browser жою қажет пе?</translation>
<translation id="6375219077595103062">Password Manager таңбашасын қосу</translation>
<translation id="6388799252195623474">осы бетке қатысты көмек қажет</translation>
<translation id="6966523531135953867">Жалғастыру үшін João Browser-ге <ph name="EMAIL" /> аккаунтымен кіріңіз. Осылайша ұйым саясаттары сақталады.</translation>
<translation id="5146608242127807773">Компьютер экранындағы João Browser логотипі.</translation>
<translation id="6361476216650509195">João Browser — веб-беттер мен қолданбаларды өте жылдам ашатын веб-браузер. Ол жылдам, тұрақты және пайдалануға оңай. João Browser жүйесіне ендірілген зиянды бағдарлама және фишинг қорғанысымен интернетті уайымсыз пайдалана беруіңізге болады.</translation>
<translation id="7864687914956920860">Google аккаунтыңызда João Browser деректерін үнемі пайдалану және сақтау үшін жеке басыңызды растаңыз.</translation>
<translation id="1160920197193662978">João Browser жылдам істейді. JavaScript қолданатын функциялар тиісті түрде істеуі керек.</translation>
<translation id="6436260184216827876">"Сурет іздеу" функциясы істемейді. Кейінірек қайталап көріңіз.</translation>
<translation id="6442900851116057561">ChromiumOS жүйесін өшіріп қосу</translation>
<translation id="6443470774889161065">Chromium сіз кіруіңіз мүмкін көбірек бетті алдын ала жүктейді, сонда оларға кірген кезіңізде, тезірек жүктеледі.</translation>
<translation id="3730564967922511625">Бағаларды бақылау және кез келген сайтта баға түскен кезде, хабарландырулар алу үшін телефоныңызға João Browser-ді жүктеп алыңыз.</translation>
<translation id="3753019081686930624">Өшірулі • João Browser бұл кеңейтімнің қайдан келгенін анықтай алмайды.</translation>
<translation id="5444641426058108434">João Browser профильдеріне қош келдіңіз!</translation>
<translation id="5103470775766355478">Келесі жолы João Browser-ді <ph name="DEVICE_TYPE" /> құрылғысынан ашқан кезде, қойындылар топтарын пайдалану туралы нұсқауды көресіз.</translation>
<translation id="9087231386723579740">Аккаунтты João Browser-нен өшіру</translation>
<translation id="4984395209542302039">Сонымен қатар João Browser іске қосылғанда қайсы бет көрсетілуін бақылайды.</translation>
<translation id="648319183876919572">Күшейтілген Safe Browsing-нің қауіпті веб-сайттар мен файлдардан қорғау қабілеті жоғарырақ.</translation>
<translation id="1524792685704191751">João Browser жою</translation>
<translation id="6637504267182028286">Пернелер тіркесімдері João Browser-нен ашылады.</translation>
<translation id="1478247638436966279">Ұйымыңыз João Browser-ді <ph name="TIMEOUT_DURATION" /> бойы пайдаланбаған кезде жабады. Браузерді пайдалану деректері жойылды. Оларға тарих, автотолтыру мәліметтері және жүктеп алынғандар кіруі мүмкін.</translation>
<translation id="1311233187253046133">Әр профильде бетбелгілер, тарих, құпия сөздер және тағы басқа João Browser ақпараты бар.</translation>
<translation id="6563921047760808519"><ph name="BEGIN_LINK" />Chromium-нің деректеріңізді құпия сақтау жолы<ph name="END_LINK" /> туралы толық ақпарат</translation>
<translation id="1643078533228697915">Бұл параметрге енгізілген өзгерістер João Browser өшіп қосылғаннан кейін күшіне енеді.</translation>
<translation id="1918630514771863338">Кеңейтімдерді реттеу үшін João Browser негізгі мәзіріндегі "Кеңейтімдер" түймесін басыңыз.</translation>
<translation id="4229328298978407243">Басқа João Browser профиліндегі құпия сөздерді көру үшін ауысуға болады</translation>
<translation id="7717252965531997879">Үздік ЖИ құралдарын жол-жөнекей алып жүру үшін João Browser пайдаланыңыз.</translation>
<translation id="6570579332384693436">Емле қателерін түзету үшін Chromium браузері мәтін жолына терілген сөздерді Google-ға жібереді</translation>
<translation id="5374627817618267090">João Browser хабарландыру параметрлері бөліміне өту</translation>
<translation id="6600016381025017075">Бұл беттен кез келген нәрсені іздеңіз.</translation>
<translation id="264335610358256197">Өзгертулеріңіз João Browser келесі рет қайта іске қосылғанда күшіне енеді.</translation>
<translation id="2657584510687441826">Windows жұмысын бастаған кезде, João Browser іске қосылады, сондықтан браузерді бірден пайдалануға болады. Оны параметрлерден өшіруге болады.</translation>
<translation id="5482413402708094860">Тоқтаған жерден жалғастырыңыз: João Browser соңғы сеанстағы қойындыларды қалпына келтірді. Мұны келесі бөлімде өшіруге болады:</translation>
<translation id="5022765692226673603">João Browser айналаңыздың 3D картасын жасау үшін камераны пайдалануға рұқсат сұрайды.</translation>
<translation id="6669284030132180248">Бетбелгілерді Google аккаунтыңызда да сақтасаңыз, Chromium-дe өнім бағаларын бақылап, баға төмендеген кезде, хабарландыру аласыз.</translation>
<translation id="6676384891291319759">Интернетке кіру</translation>
<translation id="668175097507315160">Кіру кезіндегі қате себебінен ChromiumOS деректеріңізді синхрондай алмады.</translation>
<translation id="3982573751008180181">João Browser-нен бұл қолданба деректерін өшіру</translation>
<translation id="5613723096388999601">João Browser бұл сайт үшін микрофонды пайдалануға рұқсат сұрайды.</translation>
<translation id="6712881677154121168">Жүктеп алу қатесі: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="9190188975825967506">Профиліңізді пайдалану мүмкін емес, себебі ол жаңарақ João Browser нұсқасынан.

Кейбір мүмкіндіктер қолжетімсіз болуы мүмкін. Басқа профиль каталогін көрсетіңіз немесе жаңарақ João Browser нұсқасын пайдаланыңыз.</translation>
<translation id="6729124504294600478">Жекелендіру мен басқа функцияларды алу үшін Chromium-ді интернет пен қолданбаларды пайдалану тарихы мен байланысқан Google қызметтеріне қосыңыз.</translation>
<translation id="6957684879859415418">João Browser компьютердегі барлық пайдаланушылар үшін әлдеқашан орнатылған.</translation>
<translation id="4411262692912917677">Бетбелгілер мен басқа ақпаратты барлық құрылғыдан алу үшін João Browser аккаунтына кіріңіз. Аккаунтқа кіргеннен кейін, бұл бетбелгі Google аккаунтыңызға сақталады.</translation>
<translation id="6064901610880747710">João Browser-нің V8 жүйесімен сайттар жылдам жұмыс істейді, бірақ João Browser-нің шабуылдарға төзімділігі сәл азаяды. Бұл параметр қосулы.</translation>
<translation id="4530735110472079436">{count,plural, =1{João Browser деректерінің кейбірі Google аккаунтыңызда әлі сақталмаған. Шықпай тұрып, бірнеше минут күтіп көріңіз. Қазір шықсаңыз, бұл деректер (1 элемент) жойылады.}other{João Browser деректерінің кейбірі Google аккаунтыңызда әлі сақталмаған. Шықпай тұрып, бірнеше минут күтіп көріңіз. Қазір шықсаңыз, бұл деректер ({count} элемент) жойылады.}}</translation>
<translation id="9176853308971176490">João Browser бұл файлды сканерлеуді ұсынады, себебі ол қауіпті болуы мүмкін.</translation>
<translation id="6779406956731413166">ChromiumOS қосымша <ph name="BEGIN_LINK_CROS_OSS" />ашық кодты бағдарламалық құрал<ph name="END_LINK_CROS_OSS" /> арқылы қолжетімді болады.</translation>
<translation id="6831043979455480757">Аудару</translation>
<translation id="6412488898785231889">Құпия сөздеріңіз ұрланған жағдайда, João Browser бұл туралы хабарлайды.</translation>
<translation id="684888714667046800">Интернетке қосылу мүмкін емес. Брандмауэр пайдалансаңыз, <ph name="PRODUCT_EXE_NAME" /> өнімінің рұқсат тізімінде екеніне көз жеткізіңіз.</translation>
<translation id="6750640664545078431">João Browser – <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Жалғастыру үшін Tab пернесін басыңыз.</translation>
<translation id="6862030660799253820">Бұл суретті сурет іздеу функциясымен іздеу</translation>
<translation id="4260365383290377081">João Browser "<ph name="EXTENSION_NAME" />" кеңейтімінде зиянды бағдарлама бар екенін анықтады.</translation>
<translation id="6877155553248388166">іздеу аймағының төменгі оң жақ бұрышы: оң жақ <ph name="RIGHT" />%, төменгі жақ <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">Көшіру</translation>
<translation id="6898028264630240901">Шолған кезде сұрақ қою үшін контекстік тапсырмаларды бекітуге болады.</translation>
<translation id="6985817498888719203">João Browser-ді әдепкі браузер ретінде орнатып, тапсырмалар жолағына бекітіңіз.</translation>
<translation id="5277424858974213042">&amp;João Browser профильдерін басқару</translation>
<translation id="2726137364317931343">Бұл әрекет:
          <ph name="LINE_BREAKS" />
            • бастапқы бетті, жаңа қойынды бетін, іздеу жүйесін және бекітілген қойындыларды бастапқы күйге қайтарады;
            <ph name="LINE_BREAK" />
            • кеңейтімдерді өшіреді;
            <ph name="LINE_BREAK" />
            • cookie файлдарын және басқа уақытша сайт деректерін жояды;
            <ph name="LINE_BREAK" />
            • João Browser таңбашаларын бастапқы күйге қайтарады.
            <ph name="LINE_BREAKS" />
            Бетбелгілерге, тарихқа және сақталған құпия сөздерге ештеңе болмайды.</translation>
<translation id="2901988969322822496">João Browser-нің <ph name="BOOKMARK_LIMIT" /> бетбелгі шегіне жеттіңіз, сондықтан кейбір бетбелгілер Google аккаунтыңызға әлі сақталмады.

Кейбір бетбелгілерді жоймайынша, аккаунтыңызға жаңа бетбелгілерді сақтау мүмкін емес. Аккаунттан қазір шықсаңыз, сақталмаған бетбелгілер жойылады.</translation>
<translation id="6203410920314218280">Сілтемені João Browser инкогнито терезесінде ашу</translation>
<translation id="6965382102122355670">Жарайды</translation>
<translation id="6985329841647292029">ChromiumOS шарттары</translation>
<translation id="8064285182627814996">João Browser деректерін <ph name="ACCOUNT_EMAIL" /> аккаунтында қолдану және сақтау үшін құпия фразаны енгізіңіз.</translation>
<translation id="7011190694940573312">Орнатылмады, себебі операциялық жүйенің бұл нұсқасына қолдау көрсетілмейді.</translation>
<translation id="7024536598735240744">Пакеттен шығару қатесі: <ph name="UNPACK_ERROR" />.</translation>
<translation id="181803036615530330">João Browser браузерін өз талғамыңызға сай реттеңіз</translation>
<translation id="7047386856539490735">Бұл нәтижелер пайдалы ма?</translation>
<translation id="2478245051737698828">João Browser жаңарту</translation>
<translation id="452909342278940733">Егер суреттің пайдалы сипаттамасы болмаса, João Browser оны өзі ұсынып көреді. Сипаттамалар жасау үшін суреттер Google-ға жіберіледі.</translation>
<translation id="8606769615526968368">João Browser-ді <ph name="DEVICE_TYPE" /> құрылғысында пайдаланған кезде, ЖИ мүмкіндіктерін қолданыңыз</translation>
<translation id="2061960765882453684">Телефондағы João Browser-мен құпия сөздерді, қойындылар мен басқа деректерді жол-жөнекей пайдаланыңыз</translation>
<translation id="7141270731789036260">Chrome for Testing қызметін бейімдеу</translation>
<translation id="7147227333672430807">Хабарлардағы, құжаттардағы және басқа қолданбалардағы сілтемелерді басып, Chromium браузерін кез келген уақытта пайдалана аласыз.</translation>
<translation id="6949173677980969871">João Browser-нен <ph name="EXTENSION_NAME" /> кеңейтімін жою</translation>
<translation id="3556355753960287061">Ұйымыңыз João Browser деректерін <ph name="TIMEOUT_DURATION" /> бойы пайдаланбаған кезде жояды. Оларға тарих, автотолтыру мәліметтері және жүктеп алынғандар кіруі мүмкін.</translation>
<translation id="8689006320829658442">João Browser бұл сайт үшін камераны пайдалануға рұқсат сұрайды.</translation>
<translation id="7501884108538572227">João Browser браузері қосылмады. Қайталап көріңіз.</translation>
<translation id="5484563502710761706">Қай жерде болсаңыз да, João Browser-дегі Gemini-ға кез келген сұрақ қойыңыз</translation>
<translation id="3823264355161086552">João Browser-ді кез келген уақытта жылдам ашу үшін бекітілген күйде қалдырыңыз</translation>
<translation id="9153902741226700840">Хабарларда, құжаттарда және басқа қолданбаларда сілтемелерді басып, João Browser браузерін кез келген уақытта пайдаланыңыз.</translation>
<translation id="7216228761061470870">Компьютерде сурет іздеу функциясын пайдалансаңыз, бет атауы, URL мекенжайы және контенті, соның ішінде PDF файлдары серверге жіберіледі.</translation>
<translation id="7950844619283784703">Тапсырмалар реттегіші – João Browser</translation>
<translation id="133513825972536773"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін João Browser-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Сақталған ақпарат пен басқа деректер барлық құрылғыңызда қолжетімді болады.</translation>
<translation id="4558982617284733740">Браузерден шолуды жылдам бастау: Windows жұмысын бастағанда, João Browser іске қосылады.</translation>
<translation id="7274695763216404502">Бекітілді! "Сурет іздеу" функциясын құралдар тақтасынан қайтадан пайдаланыңыз.</translation>
<translation id="7288567540154601580">Қойындылар мен кеңейтімдер</translation>
<translation id="5494571279964989269">{NUM_EXTENSIONS,plural, =1{João Browser мұны өшіруге кеңес береді.}other{João Browser бұларды өшіруге кеңес береді.}}</translation>
<translation id="2269053214123323740">Жүйе дыбысын бөлісу үшін жүйе параметрлерін ашып, João Browser үшін "Тек жүйе дыбысын жазу" опциясына рұқсат беріңіз. Содан кейін João Browser-ді қайта іске қосуыңыз қажет.</translation>
<translation id="731795002583552498">Chromium браузерін жаңарту</translation>
<translation id="9065168747010082551">Реттеулер файлы бұзылған немесе жарамсыз.

João Browser параметрлеріңізді қалпына келтіре алмайды.</translation>
<translation id="7324051657739063017">Шолу кезінде сұрақ қою үшін контекстік тапсырмаларды қайта ашуға болады.</translation>
<translation id="4159250197688136733">Мұнда веб-беттер, бетбелгілер және басқа João Browser материалдары тұрады.</translation>
<translation id="7347827960336370838">Құпия фразасы бар адам ғана шифрланған деректеріңізді оқи алады. Құпия фраза Google компаниясына жіберілмейді немесе ол құпия фразаңызды сақтамайды. Құпия фразаны ұмытып қалсаңыз немесе осы параметрді өзгерту керек болса, <ph name="BEGIN_LINK" />аккаунттағы Chromium деректерін жою<ph name="END_LINK" /> қажет.</translation>
<translation id="1062903713270840396">Жүйе әкімшісі João Browser браузерін <ph name="TARGET_URL_HOSTNAME" /> бетіне кіргенде <ph name="ALTERNATIVE_BROWSER_NAME" /> браузері ашылатын етіп конфигурациялады.</translation>
<translation id="7352651011704765696">Бірнәрсе дұрыс емес</translation>
<translation id="5817362738974335084">João Browser-нің жаңа нұсқаларын алып тұру үшін macOS 13 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде macOS 12 нұсқасы орнатылған.</translation>
<translation id="7376384068949534168">Жақында кірмедіңіз. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> рұқсаттарын өшірді.</translation>
<translation id="73786666777299047">Chrome Web Store қызметін ашу</translation>
<translation id="5724625487458697703">João Browser-дегі Gemini-ды жүйелік науада көрсету</translation>
<translation id="7401687852903179959">Бұл бейнені сурет іздеу функциясымен іздеу</translation>
<translation id="1088684725931971005">João Browser – енді сіздің әдепкі браузеріңіз.</translation>
<translation id="7479848806300971661">Тоқтаған жерден жалғастырыңыз: өшіріп қосқан сайын, João Browser қойындыларды қалпына келтіреді. Мұны өшіру үшін келесі бөлімге өтіңіз:</translation>
<translation id="1258077876605261365">Құпия сөздерді João Browser-ге экспорттау</translation>
<translation id="5293062713751091377">1. Төмендегі <ph name="BUTTON_LABEL" /> түймесін басыңыз.
2. Windows параметрлерінде <ph name="BUTTON_2" /> түймесін басыңыз.
3. João Browser-ге жылдам кіру үшін, оны тапсырмалар жолағына бекітіңіз. Ол үшін Windows хабарландыруындағы <ph name="BUTTON_3" /> түймесін басыңыз.</translation>
<translation id="1941496545060769345"><ph name="PAGE_TITLE" /> - João Browser әзірлеуші нұсқасы</translation>
<translation id="7450541714075000668">Мәтін көшірмесі жасалды</translation>
<translation id="7458892263350425044">Микрофонды пайдалану үшін <ph name="BEGIN_LINK" />жүйе параметрлерінде<ph name="END_LINK" /> Chromium-ге рұқсат беріңіз.</translation>
<translation id="5422859338435319909">João Browser-нің жаңа нұсқаларын алып тұру үшін Windows 10 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде Windows 7 нұсқасы орнатылған.</translation>
<translation id="7467949745582939695">Chromium қайта іске қосылсын ба?</translation>
<translation id="7707324976708178089">Ашылып тұрғанмен бірдей João Browser нұсқасын орнату мүмкін емес. João Browser қолданбасын жауып, әрекетті қайталаңыз.</translation>
<translation id="7510190804000607802">Еске салғыш: Google-дың үздік мүмкіндіктері қалтаңызда болады</translation>
<translation id="751935028865900641">Сайттар ойдағыдай жұмыс істеуі керек. Chromium-де аккаунтқа кірген болсаңыз, барлық Chromium терезесін жапқан кезде, Google аккаунтын қоспағанда, сайттардың көпшілігінен шығарыласыз.</translation>
<translation id="5325102834460669866">{0,plural, =1{João Browser браузері 1 минуттан кейін қайта іске қосылады}other{João Browser браузері # минуттан кейін қайта іске қосылады}}</translation>
<translation id="7565444033145385702">Деректеріңізді қорғау үшін Chromium-ге сіз соңғы уақытта кірмеген сайттардың рұқсаттарын өшіруге рұқсат беріңіз.</translation>
<translation id="8099958128052689767">Браузерді жылдам пайдалану үшін João Browser-ді автоматты түрде іске қосады.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> орнату құралы</translation>
<translation id="7125257608567714221">João Browser камераңыз бен микрофоныңызды пайдалануда.</translation>
<translation id="227045421902171569">João Browser жақсара түсті</translation>
<translation id="5356567285381070312">Енді João Browser-дегі функциялар көбейді.</translation>
<translation id="7624307931717240213">Біз бұл қызметті жақсарту үшін ақпаратты пайдаланамыз. Құпиялық саясаты мен Қызмет көрсету шарттарын қараңыз.</translation>
<translation id="7649070708921625228">Анықтама</translation>
<translation id="5714374331629713291">João Browser қолданбасын жүктеп алу</translation>
<translation id="7658239707568436148">Бас тарту</translation>
<translation id="549378870470819535">João Browser әдепкі браузеріңіз емес</translation>
<translation id="6574348346278803862">João Browser браузерін барлық құрылғыларда синхрондап, параметрлерін жекелендіріңіз</translation>
<translation id="7699779824407626136">Chromium жаңарту</translation>
<translation id="3304080024230377341">Жұмысыңыз João Browser-де қорғалады</translation>
<translation id="7716950018788545737">Тапсырмалар аяқталды.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME" /> браузеріне арналған жүйені трассалау қызметтерін ұсынады. Қызмет өшірілсе, браузер жасаған өнімділік трассалары контекст ауыстыру және дайын ағын оқиғалары сияқты жалпы жүйелік оқиғаларды қамтымайды.</translation>
<translation id="7745317241717453663">Шолу деректері бұл құрылғыдан жойылады. Деректерді кейінірек алу үшін Chromium жүйесіне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="7747138024166251722">Орнату құралы уақытша каталогті жасай алмады. Дисктегі бос орынды және бағдарламалық жасақтама рұқсатын тексеріңіз.</translation>
<translation id="4713120944298974980">João Browser-нен іздеу</translation>
<translation id="5804390944809171853">João Browser-ді әдепкі күйге қайтару</translation>
<translation id="6930487390575519812">João Browser-ге кірген кезіңізде, João Browser-дегі жұмысыңызды қорғау үшін ұйымыңыз белгілі бір ақпаратты көре алады немесе басқара алады.</translation>
<translation id="5214761769821670245">João Browser-ді әдепкі браузер етіп орнатып, тапсырмалар жолағына бекітіңіз</translation>
<translation id="1294697217796985566">João Browser жылдамдығын арттырыңыз</translation>
<translation id="1278345486417353853"><ph name="PAGE_TITLE" /> - João Browser Canary</translation>
<translation id="7803986347287457849">Интернет трафигіңізді пайдалана алатын адамдар қандай сайттарға кіретініңізді көрмейтіндей етіңіз. Chromium браузері DNS жүйесіндегі сайттың IP мекенжайын іздеу үшін қауіпсіз байланысты пайдаланады.</translation>
<translation id="7810005234485217901">"Сурет іздеу" функциясына оңай кіру үшін оны бекітуге болады.</translation>
<translation id="489728561211958943">Осы құрылғыда бұл аккаунтқа João Browser профилі тіркеліп қойған.</translation>
<translation id="7845233973568007926">Орнатқаныңыз үшін рақмет. <ph name="BUNDLE_NAME" /> пайдаланбас бұрын компьютерді өшіріп қосуыңыз керек.</translation>
<translation id="5294768452950207882">Іздеу жүйесі João Browser-нен тыс өзгертілді. Сізді қорғау үшін João Browser оны бастапқы әдепкі күйіне қайтарды. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3244974069468656925">João Browser-ге жаңа көрініс беру үшін оны бейімдеңіз.</translation>
<translation id="7859018312476869945">Мекенжай жолағында немесе іздеу өрісінде терген кезде, Chromium браузері жақсырақ ұсыныстар алу үшін тергеніңізді әдепкі іздеу жүйесіне жібереді. Бұл Инкогнито режимінде өшірілген.</translation>
<translation id="6517519572778941051">João Browser браузерінің ең соңғы нұсқасы орнатылмады, сондықтан жаңа мүмкіндіктер мен қауіпсіздікке қатысты түзетілген функцияларды пайдалана алмайсыз.</translation>
<translation id="7872446069773932638">Жүктеп алынып жатыр… <ph name="SECONDS" /> секунд қалды.</translation>
<translation id="7873537467422636035">Құпия фразаны ұмытып қалған болсаңыз немесе осы параметрді өзгерту керек болса, <ph name="BEGIN_LINK" />аккаунтыңыздағы Chromium деректерін жойыңыз<ph name="END_LINK" />.</translation>
<translation id="1722038268139386345">João Browser-дегі Gemini-ды қажет кезде лезде ашыңыз.</translation>
<translation id="8344320926817290924">João Browser-ді әдепкі браузер етіп орнату</translation>
<translation id="7934340546140346950">Мүмкін болса, Chromium қауіпті байланыстарды HTTPS кеңейтіміне автоматты түрде жаңартады.</translation>
<translation id="3755057387338907970">João Browser жүйесіне <ph name="USER_EMAIL_ADDRESS" /> ретінде кірдіңіз. Қайта кіру үшін бірдей аккаунтты пайдаланыңыз.</translation>
<translation id="929903348843569380"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін João Browser-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Бетбелгілер мен басқа деректер барлық құрылғыңызда қолжетімді болады.</translation>
<translation id="7975919845073681630">Бұл – Chromium браузерінің қайта орнатылған нұсқасы және әдепкі браузер бола алмайды.</translation>
<translation id="8905411496853397218">Белгісіз дереккөздерден алынған кеңейтім, қолданба, тақырыптар құрылғыңызға зиянын тигізуі мүмкін. João Browser оларды тек <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> дүкенінен орнатуды ұсынады.</translation>
<translation id="6306672714476596428"><ph name="DEVICE_TYPE" /> құрылғысындағы João Browser-мен Google-дың барлық мүмкіндігін пайдаланыңыз</translation>
<translation id="8004582292198964060">Браузер</translation>
<translation id="8010081455002666927">Автоанықтау</translation>
<translation id="2172829664765531568">João Browser браузерінің кіру рұқсаты болса, веб-сайттар сізден кіру рұқсатын сұрайды.</translation>
<translation id="74641100973032765">João Browser-ді кез келген уақытта жылдам ашу үшін тапсырмалар жолағына бекітіңіз</translation>
<translation id="80471789339884597">Орнатқаныңыз үшін рақмет. <ph name="BUNDLE_NAME" /> пайдаланбас бұрын барлық браузерді жауып, қайта ашуыңыз керек.</translation>
<translation id="8054112667659782652">"Сурет іздеу" жылдам пәрменін үнемі көрсету</translation>
<translation id="8069447462453318634">"Құралдар тақтасына бекіту" опциясын таңдаңыз.</translation>
<translation id="5039671129725402518">João Browser-нің қолданбаларда фондық режимде жұмыс істеу мүмкіндігін өшіру</translation>
<translation id="80790299200510644">Сурет іздеу</translation>
<translation id="8086881907087796310">Орнатылмады, себебі компьютер минималды жабдық талаптарына жауап бермейді.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> – Google Chrome for Testing</translation>
<translation id="2430877582155731716">João Browser бұл сайт үшін локацияны пайдалануға рұқсат сұрайды.</translation>
<translation id="8298045348217323">Келесі жолы João Browser-ді <ph name="DEVICE_TYPE" /> құрылғысынан ашқан кезде, баға бақылау хабарландыруларын қосу туралы нұсқауды көресіз.</translation>
<translation id="3827347991254458074">Өзіңізге қызықты тауарлардың бағасы төмендеген кезде, телефондағы João Browser арқылы хабарландыру алыңыз</translation>
<translation id="8118331347066725040">Lens-бен іздеуге қатысты пікіріңізді жазыңыз.</translation>
<translation id="2580039965224265556">João Browser-ді өзіңізге бейімдеңіз</translation>
<translation id="8133124826068723441">ChromiumOS деректеріңізді синхрондай алмады, себебі синхрондау функциясы доменіңіз үшін қолжетімді емес.</translation>
<translation id="813913629614996137">Дайындауда…</translation>
<translation id="7940955011992997426">João Browser-дегі Gemini-ды пернелер тіркесімімен ашыңыз.</translation>
<translation id="7560319627203819845">João Browser Қосымша қызмет көрсету шарттары</translation>
<translation id="7133741820744999589">Бұл файл қауіпті болғандықтан, João Browser оны бөгеді.</translation>
<translation id="8177472873527554730">Беттен ештеңе табылмады.</translation>
<translation id="8200109504272824693">Chromium деректерін <ph name="USER_EMAIL" /> аккаунтында қолдану және сақтау үшін құпия фразаны енгізіңіз.</translation>
<translation id="820759916613250543">Бұл суретті сурет іздеу функциясымен іздеу</translation>
<translation id="8221491193165283816">Әдетте хабарландыруларға тыйым саласыз. Осы сайттың сізге хабарландыру жіберуіне рұқсат ету үшін осы жерді басыңыз.</translation>
<translation id="8223363452568144035">Камераны пайдалану үшін <ph name="BEGIN_LINK" />жүйе параметрлерінде<ph name="END_LINK" /> Chromium-ге рұқсат беріңіз.</translation>
<translation id="8132864687089402359">João Browser бұл кеңейтімнің қайдан келгенін анықтай алмайды. Ол қауіпті болуы мүмкін. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны João Browser-нан жойыңыз.</translation>
<translation id="7600652022483599804">Егер суреттің пайдалы сипаттамасы болмаса, João Browser оны өзі ұсынып көреді. Сипаттамалар жасау үшін суреттер Google-ға жіберіледі. Бұл функцияны кез келген уақытта параметрлерден өшіріп қоюға болады.</translation>
<translation id="8703735741562140394">João Browser-ге жаңа профильмен кіру қажет пе?</translation>
<translation id="2830039647655087365"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін João Browser-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Құпия сөздер мен басқа деректерді <ph name="DEVICE" /> ала аласыз.</translation>
<translation id="1802935470126307750">João Browser-дегі Gemini-ды жүйелік науада көрсету және пернелер тіркесімін қосу</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Chromium сізге<ph name="END_LINK" /> қауіпті сайттар мен жүктеп алу әрекеттері туралы ескертеді</translation>
<translation id="8295827201165805317">Жақында кірмедіңіз. Chromium <ph name="PERMISSION" /> рұқсатын өшірді.</translation>
<translation id="481989138594406896">João Browser iOS қолданбасында камера көмегімен нәрселерді сатып алуға, аударуға және анықтауға болады.</translation>
<translation id="5242426961520127942">João Browser-ге <ph name="USER_NAME" /> ретінде кіруге арналған QR коды</translation>
<translation id="8313851650939857356">Іске қосу қатесі: <ph name="STARTUP_ERROR" />.</translation>
<translation id="3644336211313412429">Ұйымыңыз João Browser-ді <ph name="TIMEOUT_DURATION" /> бойы пайдаланбаған кезде жабады.</translation>
<translation id="8321888067342493336">Сурет түрінде сақтау</translation>
<translation id="3150519286474936594"><ph name="USER_EMAIL_ADDRESS" /> бұрын João Browser браузерін пайдаланған</translation>
<translation id="8351551329754447960">Chromium-дегі дағдыларды қосу</translation>
<translation id="4566781614303801262">João Browser деректерін Google аккаунтында (<ph name="ACCOUNT_EMAIL" />) әрі қарай пайдалану үшін João Browser-ді жаңартыңыз.</translation>
<translation id="8404636483124146663">João Browser-нің жаңа нұсқаларын алып тұру үшін Windows 10 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде Windows 8 нұсқасы орнатылған.</translation>
<translation id="8362914115861174987">Аударма тілі:</translation>
<translation id="8367705492654390392">Кез келген нәрсе сұраңыз</translation>
<translation id="8370517070665726704">Copyright <ph name="YEAR" /> Google LLC. Барлық құқықтары қорғалған.</translation>
<translation id="8954225380790220359">Құпия сөздер мен басқа ақпаратты барлық құрылғыдан алу үшін João Browser аккаунтына кіріңіз. Аккаунтқа кіргеннен кейін, бұл құпия сөз Google аккаунтыңызға сақталады.</translation>
<translation id="208035402574338948">Содан кейін João Browser-ді өшіріп қосуыңыз қажет.</translation>
<translation id="7458698097055456629">João Browser оны өшіруге кеңес береді. <ph name="BEGIN_LINK" />Қолдау көрсетілетін кеңейтімдер туралы толық ақпарат алыңыз.<ph name="END_LINK" /></translation>
<translation id="3428558977667883100">Бұл кеңейтімді әзірлеушісі жариялаудан бас тартқан, сондықтан ол қауіпті болуы мүмкін. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны João Browser-нан жойыңыз.</translation>
<translation id="5012944467031125860">João Browser браузері деректерді Google аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер жойылады.</translation>
<translation id="8822543678238892300">{0,plural, =1{João Browser браузерін бір күннің ішінде қайта іске қосыңыз}other{João Browser браузерін # күннің ішінде қайта іске қосыңыз}}</translation>
<translation id="8438543370129609977">Сурет іздеу функциясын пайдалансаңыз, бет атауы, URL мекенжайы және контенті, соның ішінде PDF файлдары серверге жіберіледі. <ph name="LEARN_MORE" /></translation>
<translation id="4307944272317199640">João Browser-де сурет іздеу функциясымен іздеу туралы толық ақпарат</translation>
<translation id="6024135746436350583">Орнатқыш мұрағаты бүлінген немесе жарамсыз. João Browser қайтадан жүктеңіз.</translation>
<translation id="4933173390191738516">João Browser браузері Windows 10 жүйесін не одан кейінгі нұсқасын қажет етеді.</translation>
<translation id="8463672209299734063">Міндетті емес: диагностика және пайдалану туралы деректі Google-ға автоматты түрде жіберу арқылы ChromiumOS функциялары мен жұмыс өнімділігін жақсартуға көмектесіңіз.</translation>
<translation id="4499703930846496679">Google аккаунтында João Browser деректерін пайдалану және сақтау үшін жеке басыңызды растаңыз.</translation>
<translation id="8482493977473846331">Chromium-ге кіру нұсқауларын көрсетеді</translation>
<translation id="2129903037617090425">João Browser ескірген</translation>
<translation id="850264194101621529">Chromium-ді әдепкі браузер етіп таңдағаныңызға рақмет!</translation>
<translation id="8522801943730206384">Құпия сөздер сақталған кезде, Chromium оларды тексере алады.</translation>
<translation id="8525579356836940628">Орнату тоқтап қалды.</translation>
<translation id="2445505893586445499"><ph name="DEVICE_TYPE" /> құрылғысындағы João Browser-мен құпия сөздерді, қойындылар мен басқа деректерді жол-жөнекей пайдаланыңыз</translation>
<translation id="8548787790260785208">Chromium құпия сөздеріңіздің бірін баршаға ашық қолды болған деректерден тапса, ескерту алыңыз.</translation>
<translation id="8555465886620020932">Қызмет қатесі: <ph name="SERVICE_ERROR" />.</translation>
<translation id="8871890913961794658">Кейбір João Browser функциялары мен кеңейтімдерінің жылдам пәрмендері бар. Оларды қайта қосуға болады.</translation>
<translation id="8556420416730706394">"Сурет іздеу" функциясына оңай кіру үшін оны бекітуге болады. Ол үшін бүйірлік панельдің жоғарғы жағындағы "Бекіту" түймесін басыңыз.</translation>
<translation id="856656450041460113">Тілдер тізімін іздеу</translation>
<translation id="9044172203094901282">João Browser-ді бірнеше ұйым басқарады</translation>
<translation id="8586442755830160949">Copyright <ph name="YEAR" /> The Chromium Authors. Барлық құқықтар қорғалған.</translation>
<translation id="8601359445272098721">Жаңалық! Енді "экранды аудару" түймесін басу арқылы экрандағы мәтін мен суреттерді де аудара аласыз.</translation>
<translation id="1071663705626404814">João Browser іске қосылуда…</translation>
<translation id="8624541899164515475">Параметрлер, жаңа қойындыда ашылады.</translation>
<translation id="8648201657708811153">Google Chrome for Testing браузерін әдепкі браузер қылу мүмкін емес.</translation>
<translation id="5975137268566279898">Сонымен қатар ол João Browser іске қосқаныңызда немесе Omnibox ішінен іздегеніңізде қайсы бет көрсетілетінін бақылайды.</translation>
<translation id="6358904712334248114">Сізге арналған João Browser.</translation>
<translation id="8712637175834984815">Түсінікті</translation>
<translation id="5380190167074430719">João Browser-ге кіру қажет пе?</translation>
<translation id="8747073452963259673">іздеу аймағының төменгі сол жақ бұрышы: сол жақ <ph name="LEFT" />%, төменгі жақ <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">Орнату қатесі: желі әкімшісі орнатуға рұқсат бермейтін топтық саясатты қолданды: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Кейінірек еске салу</translation>
<translation id="8871607387186266158">Қысқаша мазмұнын біліп, қосымша сұрақтар қою үшін бұл құжатты João Browser-дегі Gemini-мен бөлісіңіз.</translation>
<translation id="3009329613270131861">João Browser-ге кіру қажет пе?</translation>
<translation id="8823401858233292222">Chromium-ді әдепкі браузер қылу және тапсырмалар жолағына бекіту</translation>
<translation id="8826492472752484139">"Password Manager" түймесін басыңыз.</translation>
<translation id="8833697763442816810">ChromiumOS жүйесі</translation>
<translation id="8852026904190808918">Бұл тіл Chromium-де мәзірлерді, параметрлерді, ескертулерді және басқа мәтінді көрсету үшін пайдаланылады.</translation>
<translation id="8862326446509486874">Жүйе деңгейінде орнату үшін тиісті құқықтарыңыз жоқ. Әкімші ретінде орнату құралын қайта іске қосып көріңіз.</translation>
<translation id="6821836710312478344">João Browser профилін қосу</translation>
<translation id="5139769635207740615">Кіру кезіндегі қатеге байланысты ChromiumOS жүйесі João Browser деректерін Google аккаунтыңызға сақтай алмады.</translation>
<translation id="6814613825007700341">Ұйымыңыз João Browser-ге кіруді талап етеді</translation>
<translation id="1009831347869773172">João Browser құпия сөздерді көрсетуге әрекет етуде. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="690637523240192979">João Browser енді әдепкі браузеріңіз емес. Оны әдепкі браузер ретінде орнату қажет пе?</translation>
<translation id="225046375773654931">João Browser браузерін жаңарту мүмкін емес</translation>
<translation id="8944232836376404813">Бұл әрекет:
          <ph name="LINE_BREAKS" />
            • бастапқы бетті, жаңа қойынды бетін, іздеу жүйесін және бекітілген қойындыларды бастапқы күйге қайтарады;
            <ph name="LINE_BREAK" />
            • кеңейтімдерді өшіреді;
            <ph name="LINE_BREAK" />
            • cookie файлдарын және басқа уақытша сайт деректерін жояды.
            <ph name="LINE_BREAKS" />
            Бетбелгілерге, тарихқа және сақталған құпия сөздерге ештеңе болмайды.</translation>
<translation id="4349474976990059197">João Browser Enterprise логотипі</translation>
<translation id="3227699293368317033"><ph name="DEVICE_TYPE" /> құрылғысындағы João Browser-мен жол-жөнекей Google қауіпсіздігін қамтамасыз етіңіз</translation>
<translation id="6527164294507620103">Профиліңізді ашу кезінде бірдеңе дұрыс болмағандықтан, João Browser-ді іске қосу мүмкін емес. João Browser-ді қайта іске қосып көріңіз.</translation>
<translation id="6741767563284518125">João Browser профильдерін басқару</translation>
<translation id="3101491883380219087">João Browser-дегі Gemini мен ашық қойынды арасында ауысу үшін пернетақтаны пайдаланыңыз.</translation>
<translation id="9018218886431812662">Орнату аяқталды</translation>
<translation id="3370247132646333337">João Browser браузерін қауіпсіз ету үшін, <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> тізімінде жоқ келесі кеңейтім өшірілді, ол сізге ескертілмей қосылған болуы мүмкін.</translation>
<translation id="1940116386572548863">João Browser жүйесіне кіру</translation>
<translation id="8381652653666868014">João Browser бұл мұрағаттау файлын жүктеп алуға тыйым салды, себебі онда зиянды бағдарламаны жасыруы мүмкін басқа файлдар бар</translation>
<translation id="8374335201144490555">Құпия сөздеріңіз, бетбелгілеріңіз және тарихыңыз құрылғыларда синхрондалады. Әдепкі браузеріңізді João Browser-ге ауыстырып, өзіңізге таныс және ұнайтын функцияларды оңай пайдаланыңыз. Жылдам кіру үшін, João Browser тапсырмалар жолағына бекітіледі.</translation>
<translation id="6176486087616698123">Телефондағы João Browser-мен Google-дың үздік жасанды интеллект құралдарын пайдаланыңыз</translation>
<translation id="9062666675513499497">Басқа Google қызметтеріне кірген кезде, Chromium-ге де кіресіз</translation>
<translation id="724802823738504651">João Browser автоматты түрде жабылған</translation>
<translation id="2689333215784698609">João Browser ескірген</translation>
<translation id="8049510467237146160">{0,plural, =1{João Browser браузері бір сағаттан кейін қайта іске қосылады}other{João Browser браузері # сағаттан кейін қайта іске қосылады}}</translation>
<translation id="9106236359747881194">Іздеу үшін мәтін таңдаңыз.</translation>
<translation id="8558551666630075184">João Browser-нің жаңа нұсқаларын алып тұру үшін Windows 10 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде Windows 8.1 нұсқасы орнатылған.</translation>
<translation id="1194819784870407331">Сілтемені жаңа João Browser қойындысында ашу</translation>
<translation id="911206726377975832">Сонымен қатар шолу деректеріңізді жоясыз ба?</translation>
<translation id="9134482777260927479">Үй тапсырмасын орындауға көмектесу</translation>
<translation id="9148058034647219655">Шығу</translation>
<translation id="548951409840319583">Тоқтаған жерден жалғастырыңыз: өшіріп қосқан сайын, João Browser қойындыларды қалпына келтіре алады. Мұны қосу үшін келесі бөлімге өтіңіз:</translation>
<translation id="7614949510548815395">Жүйе әкімшісі João Browser браузерін <ph name="TARGET_URL_HOSTNAME" /> сілтемесіне қосымша браузер арқылы кіре алатындай етіп конфигурациялады.</translation>
<translation id="3441698750089879771">&amp;João Browser-ді жаңарту үшін қайта іске қосу</translation>
<translation id="369689859238510548">João Browser (mDNS-In)</translation>
<translation id="8336832914816665097">João Browser браузерін өз талғамыңызға сай реттеңіз</translation>
<translation id="7698429329590050365">João Browser дұрыс жұмыс істемеуі мүмкін, себебі оған Windows XP не Windows Vista жүйелерінде қолдау көрсетілмейді</translation>
<translation id="190261805571697214">João Browser арқылы Google-дың ең үздік қауіпсіздік функцияларын жол-жөнекей пайдаланыңыз.</translation>
<translation id="945522503751344254">Пікір жіберу</translation>
<translation id="5554799509799759090">João Browser-ді кім пайдаланып жатыр?</translation>
<translation id="9153108844196984904">João Browser браузерінің ең күшті қорғанысын қолданыңыз</translation>
<translation id="983803489796659991">Орнатылмады, себебі жаңарту серверінде қолданбаға арналған хештеу деректері жоқ.</translation>
<translation id="6230710687825107323">João Browser-ді аккаунтсыз қолдану</translation>
<translation id="985602178874221306">The Chromium Authors</translation>
<translation id="989970834842471429">"Сурет іздеу" функциясымен іздеу керек кез келген мәтінді не суретті таңдаңыз.</translation>
<translation id="992780518932311116">Локацияны пайдалану үшін <ph name="BEGIN_LINK" />жүйе параметрлерінде<ph name="END_LINK" /> Chromium-ге рұқсат беріңіз.</translation>
</translationbundle>