<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lv">
<translation id="1026101648481255140">Atsākt instalēšanu</translation>
<translation id="1029669172902658969">Atkārtoti palaist, lai atjauninātu &amp;Chromium OS</translation>
<translation id="4711726241445951349">João Browser komanda iesaka pārskatīt šo paplašinājumu.</translation>
<translation id="1042552502243217427">Kad vietnē tiek piedāvāts privāti iepriekš ielādēt saites lapā, pārlūks Chromium izmanto Google serverus. Tādējādi jūsu identitāte tiek slēpta no iepriekš ielādētās lapas īpašniekiem, taču Google uzzina, kādas lapas tiek iepriekš ielādētas.</translation>
<translation id="1051793555070215510">Palīdziet mums uzlabot pārlūkošanu inkognito režīmā, aizpildot šo vienas minūtes aptauju.</translation>
<translation id="1065672644894730302">Jūsu preferences nevar nolasīt. Dažas funkcijas var nebūt pieejamas, un preferenču izmaiņas netiks saglabātas</translation>
<translation id="3937976866851867994">Viens no jūsu vecākiem ir izslēdzis iestatījumu “Atļaujas vietnēm, lietotnēm un paplašinājumiem” pārlūkam João Browser.</translation>
<translation id="8626021334348319355">Lai meklētu konkrētu João Browser funkciju vai paplašinājumu, adreses joslā ievadiet tā saīsni un pēc tam nospiediet izvēlēto īsinājumtaustiņu</translation>
<translation id="9157778882771986870">Pārlūkā João Browser tiek mēģināts eksportēt jūsu paroles. Lai to atļautu, ievadiet savu Windows paroli.</translation>
<translation id="112640046208448578">Varat identificēt priekšmetus vai vietas un kopēt vai tulkot tekstu. Kad izmantojat funkciju Attēlu meklēšana, uz serveri tiek nosūtīts lapas ekrānuzņēmums. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Jūsu noklusējuma pārlūks ir Chromium.</translation>
<translation id="1131805035311359397">Lai pārbaudītu, vai jūsu paroles ir aizsargātas pret datu pārkāpumiem un citām drošības problēmām, <ph name="BEGIN_LINK" />pierakstieties pārlūkā Chromium<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">Noklikšķiniet uz João Browser izvēlnes</translation>
<translation id="1157985233335035034">Nesen izmantotās valodas</translation>
<translation id="1184145431117212167">Instalēšana neizdevās, jo jūsu izmantotā Windows versija netiek atbalstīta.</translation>
<translation id="1185134272377778587">Par Chromium</translation>
<translation id="667420476518265356">Brīdinājumu saņemšana par cenu izsekošanu, izmantojot pārlūku João Browser savā tālrunī</translation>
<translation id="1203500561924088507">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME" /> izmantošanas ir jārestartē pārlūkprogramma.</translation>
<translation id="1232234696885483911">Kad atvērsiet attēlu meklēšanu, serverim tiks automātiski nosūtīts lapas nosaukums, vietrādis URL un saturs, tostarp PDF faili. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">Kamēr esat pierakstījies, pārlūkā João Browser varat izmantot savas paroles un citu saturu no Google konta. Lai to mainītu, pārejiet uz sadaļu “Jūsu konts pārlūkā João Browser”.</translation>
<translation id="4866003137980530528">Rādīt Gemini pārlūkā João Browser Mac izvēļņu joslā</translation>
<translation id="2526294198551578217">Lai pakalpojumā Gemini pārlūkā João Browser atlasītu ekrāna daļu, izmantojiet īsinājumtaustiņu.</translation>
<translation id="7068536367561625920">Kamēr šī cilne bija neaktīva, tika atbrīvota atmiņa pārlūka João Browser ātrākai darbībai. Varat izvēlēties vienmēr saglabāt šo vietni aktīvu.</translation>
<translation id="3669854427836618143">Pārlūkā João Browser šī lejupielāde tika bloķēta, jo fails ir bīstams.</translation>
<translation id="126567311906253476">Ja pierakstāties Google pakalpojumos, piemēram, Gmail vai YouTube, ar kontu <ph name="USER_EMAIL" />, varat automātiski pierakstīties pārlūkā Chromium ar to pašu kontu.</translation>
<translation id="8094399825947986050">Iegūstiet pārlūku João Browser savā tālrunī</translation>
<translation id="1290883685122687410">Iestatīšanas kļūda: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">Jaunā João Browser profila iestatīšana</translation>
<translation id="7591029065989504977">Izmēģināt, izmantojot Gemini pārlūkā João Browser</translation>
<translation id="8408989583029959522">Pārlūkam João Browser ir nepieciešama Bluetooth piekļuve, lai atrastu Bluetooth ierīces. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">Pierakstieties pārlūkā João Browser savā tālrunī</translation>
<translation id="1330562121671411446">Valodas noteikšana</translation>
<translation id="6026568602942276348">Dzēst arī datus no pārlūka João Browser (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Piesprausts! Varat atkal piekļūt funkcijai Attēlu meklēšana, izmantojot jauno pogu rīkjoslā.</translation>
<translation id="1356661055722410047">Jaunums! Varat tulkot gan ekrānā redzamo tekstu, gan attēlus.</translation>
<translation id="1383876407941801731">Meklēt</translation>
<translation id="5807085300679014096">Izmantojiet lietotni João Browser, lai turpinātu pārlūkošanu, atrodoties ceļā</translation>
<translation id="141901961143729572">Dalieties domās!</translation>
<translation id="3736947618013031173">Lai kopīgotu logu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā João Browser.</translation>
<translation id="1478370723027452770">Saņemt palīdzību saistībā ar Chrome for Testing</translation>
<translation id="1497802159252041924">Instalēšanas kļūda: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Šī lapa ir aizsargāta</translation>
<translation id="4379865404970367448">João Browser cilnes kopīgošana</translation>
<translation id="4436275659297289591">Pierakstīties pārlūkā João Browser</translation>
<translation id="1547469039832541117">Tiek pabeigts atzīmētais uzdevums.</translation>
<translation id="449712764049695153">Piespraust pārlūku João Browser</translation>
<translation id="1574377791422810894">Chromium drošības rīki</translation>
<translation id="5480232403718129394">João Browser pieprasa dzēst jūsu paroļu pārvaldnieka datus. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku João Browser.}=1{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku João Browser. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku João Browser. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku João Browser. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku João Browser. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="980976428162070137">Izmantojiet pārlūku João Browser savā tālrunī, lai pilnvērtīgi izmantotu Google piedāvātās iespējas</translation>
<translation id="1625909126243026060">Pārskatiet svarīgākās konfidencialitātes un drošības vadīklas pārlūkā Chromium.</translation>
<translation id="1640672724030957280">Notiek lejupielāde...</translation>
<translation id="1665602916345474427">Veikta pierakstīšanās kā lietotājam <ph name="USER_NAME" /> (<ph name="USER_EMAIL" />), un jums ir abonements. Atvērt konta izvēlni</translation>
<translation id="1708414395296835197">Varat izmantot pārlūku Chromium ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs. Tas arī tiks piesprausts uzdevumu joslai.</translation>
<translation id="1709772298389099340">Nodrošina augstas privilēģijas pārlūkam <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Tādējādi varēsiet atlasīt kādu no pieejamām ierīcēm un parādīt tajā saturu.</translation>
<translation id="6972087163510342335">Pārlūkā João Browser drīz tiks dzēsti pārlūkošanas dati</translation>
<translation id="1736443181683099871">Pārlūkā Chromium tiks mēģināts navigācijai izmantot HTTPS.</translation>
<translation id="3879288383593333401">João Browser dati dzēsti</translation>
<translation id="656496276885630888">Pārlūks João Browser tiks restartēts pēc: <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Ja HTTPS nav pieejams, pārlūkā Chromium bez brīdinājuma tiks izmantots nedrošs savienojums.</translation>
<translation id="1226290419185955779">Ļaut João Browser darboties fonā</translation>
<translation id="4231366995273072370">Lai uzlabotu João Browser drošību, mēs atspējojām dažus paplašinājumus, kas nav norādīti vietnē <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> un, iespējams, tika pievienoti, jums nezinot.</translation>
<translation id="1822049153969905781">Windows paziņojumā noklikšķiniet uz <ph name="BEGIN_BOLD" />Jā<ph name="END_BOLD" />, lai piespraustu pārlūku João Browser uzdevumu joslai, tādējādi nodrošinot ātru piekļuvi.</translation>
<translation id="1321831992638405531">Pārinstalēt João Browser</translation>
<translation id="3386967202064865436">João Browser mēģina <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="70054449700528483">Kad nākamreiz savā ierīcē (<ph name="DEVICE_TYPE" />) atvērsiet pārlūku João Browser, tiks parādīts aicinājums izmantot Google paroļu pārvaldnieku.</translation>
<translation id="1838374766361614909">Notīrīt meklēšanas vaicājumu</translation>
<translation id="5807096362853316123">Lai dzēstu pārlūkošanas datus tikai no šīs ierīces un paturētu tos Google kontā, <ph name="BEGIN_LINK" />izrakstieties no João Browser<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">Lejupielādējiet pārlūku João Browser savā tālrunī, lai atvērtu vai izveidotu jaunas ciļņu grupas, atrodoties ceļā.</translation>
<translation id="185970820835152459">Varat pārvaldīt Google kontus, kuros esat pierakstījies. Jūsu Google konti tiek izmantoti pārlūkā Chromium, Play veikalā, pakalpojumā Gmail un citur. Ja vēlaties pievienot kontu kādam citam, piemēram, ģimenes loceklim, pievienojiet jaunu personu savai <ph name="DEVICE_TYPE" /> ierīcei. <ph name="LINK_BEGIN" />Uzziniet vairāk<ph name="LINK_END" />.</translation>
<translation id="1862852878885210965">Meklēšana, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="65457771685016683">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā João Browser savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt grāmatzīmēm un citiem datiem no <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Atlasīt tekstu</translation>
<translation id="2634119629547215883">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu João Browser dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME" />. Varēsiet dzēst šos datus, izmantojot Google kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. Ja vēlaties, varat izveidot jaunu profilu, lai atsevišķi glabātu João Browser datus. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Pārlūkā Chromium tiek taupīta akumulatora enerģija, ierobežojot darbības fonā un vizuālos efektus, piemēram, vienmērīgu ritināšanu un video kadru nomaiņas ātrumu. Varat <ph name="BEGIN_LINK" />uzzināt vairāk par enerģijas taupīšanas režīmu<ph name="END_LINK" />.</translation>
<translation id="6115114251350798456">João Browser atjauninātāja pakalpojums</translation>
<translation id="1911763535808217981">Ja izslēgsiet šo iestatījumu, varēsiet pierakstīties Google vietnēs, piemēram, pakalpojumā Gmail, nepierakstoties pārlūkā Chromium.</translation>
<translation id="4037729269678342163">João Browser nereaģē. Vai restartēt to tūlīt?</translation>
<translation id="7563750688920581112">Saskaņā ar jūsu organizācijas (<ph name="MANAGER" />) politiku jums ir jāpierakstās pārlūkā João Browser.</translation>
<translation id="193439633299369377">Chromium OS ir jārestartē, lai lietotu atjauninājumu.</translation>
<translation id="7099143775283792684">Pārlūkā João Browser šī lejupielāde tika bloķēta, jo šī tipa faili parasti netiek lejupielādēti un var būt bīstami.</translation>
<translation id="1953553007165777902">Notiek lejupielāde... Atlikušais laiks: <ph name="MINUTE" /> minūte(-es).</translation>
<translation id="1966382378801805537">Chromium nevar noteikt vai iestatīt noklusējuma pārlūku.</translation>
<translation id="197326043290947695">Viedāka pārlūkošana, izmantojot attēlu meklēšanu</translation>
<translation id="6185556991023272801">Uzzināt, kāpēc pārlūkā João Browser daži faili tiek bloķēti (saite tiks atvērta jaunā cilnē)</translation>
<translation id="4053636705816895911">Nodrošina João Browser programmatūras pastāvīgu atjaunināšanu. Ja šis pakalpojums tiks atspējots vai pārtraukts, jūsu João Browser programmatūra netiks pastāvīgi atjaunināta, kas nozīmē, ka nebūs iespējams labot drošības ievainojamības, ja tādas radīsies, turklāt var nedarboties funkcijas. Šis pakalpojums pats tiek atinstalēts, ja neviena João Browser programmatūra to neizmanto.</translation>
<translation id="2008474315282236005">Veicot šo darbību, no šīs ierīces tiks dzēsts 1 vienums. Lai vēlāk izgūtu datus, pierakstieties pārlūkā Chromium kā <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Instalēšana neizdevās. Lūdzu, mēģiniet vēlreiz.</translation>
<translation id="2039417478970545937">Iestatījumi.</translation>
<translation id="2049376729098081731">Izvēlieties, vai iekļaut Chromium vēsturi, lai iegūtu personalizētākas iespējas Google pakalpojumos.</translation>
<translation id="6768767091114123654">Iebūvēts pārlūkā João Browser, lai palīdzētu jums izveidot, saglabāt un automātiski aizpildīt drošas paroles. Pievienojiet saīsni ērtai piekļuvei.</translation>
<translation id="3571664229232252557">Jaunas cilnes lapā noklikšķiniet uz pogas Pielāgot João Browser, lai piešķirtu pārlūkam João Browser jaunu izskatu.</translation>
<translation id="4273287215573278663">Pārlūkā João Browser šī lejupielāde tika bloķēta, jo fails ir maldinošs un var veikt neparedzētas izmaiņas jūsu ierīcē.</translation>
<translation id="9063967192437499581">Kad nākamreiz iOS ierīcē atvērsiet pārlūku João Browser, tiks parādīts aicinājums izmēģināt funkciju <ph name="FEATURE_NAME" />.</translation>
<translation id="8511569826706775962">Jūsu paroles un citi João Browser dati, ko saglabājāt savā Google kontā, tiks noņemti no šīs ierīces. Lai atkal izmantotu šos datus pārlūkā João Browser, atkārtoti pierakstieties.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks João Browser nav izmantots vienu minūti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}zero{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks João Browser nav izmantots # minūtes. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}one{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks João Browser nav izmantots # minūti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}other{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks João Browser nav izmantots # minūtes. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}}</translation>
<translation id="2125838419757773031">Lai meklētu, atlasiet ekrāna apgabalu</translation>
<translation id="2126108037660393668">Neizdevās verificēt lejupielādēto failu.</translation>
<translation id="2135919691573380097">Ziņošana par šo vietni</translation>
<translation id="2137162749895930932">Aizvērt tulkošanas ekrānu</translation>
<translation id="1308845716497059117">Pārlūkā João Browser šī lejupielāde tika bloķēta, jo vietnē netiek izmantots drošs savienojums un, iespējams, failā ir veiktas izmaiņas.</translation>
<translation id="2170098639895543546">Atlasīt jebkādu saturu lapā</translation>
<translation id="6705844023496387932">Pielāgot pārlūkprogrammu João Browser</translation>
<translation id="2174917724755363426">Instalēšana nav pabeigta. Vai tiešām vēlaties atcelt?</translation>
<translation id="7728290795259244895">João Browser — pierakstīšanās tīklā — <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Atjauninājumu pārbaudes kļūda: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">Noņemt kontu no pārlūka João Browser</translation>
<translation id="4648870374540039667">Izmantojiet lietotni João Browser, lai piekļūtu vislabākajiem iepirkšanās rīkiem, atrodoties ceļā</translation>
<translation id="2106116820042118250">Saņemiet labāku aizsardzību, atrodoties ceļā, ar funkciju “Droša pārlūkošana ar papildu aizsardzību” pārlūkā João Browser operētājsistēmai iOS.</translation>
<translation id="2210682093923538346">Bīstama vietne. Pārlūkā Chromium tika noņemti paziņojumi.</translation>
<translation id="2236949375853147973">Manas darbības</translation>
<translation id="118764235932893741">Pierakstieties pārlūkā João Browser, lai varētu piekļūt adresēm un citiem datiem visās savās ierīcēs. Šī adrese tiks saglabāta jūsu Google kontā pēc pierakstīšanās.</translation>
<translation id="7254578863532089400">Ja jūsu datoru izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku João Browser atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos kontos.</translation>
<translation id="22571759390241347">Prasmes pārlūkā Chromium</translation>
<translation id="2283803047247799269">Meklēt šajā cilnē, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{João Browser iesaka pārtraukt tās cilnes darbību, kas palēnina pārlūka darbību}zero{João Browser iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}one{João Browser iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}other{João Browser iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}}</translation>
<translation id="2307973900865360088">Paturēt dokā</translation>
<translation id="2313870531055795960">Vietrāži URL tiek pārbaudīti, salīdzinot ar nedrošo vietņu sarakstu, kas ir saglabāts pārlūkprogrammā Chromium. Ja kādā vietnē tiek mēģināts nozagt jūsu paroli vai ja jūs lejupielādējat kaitīgu failu, Chromium var arī nosūtīt attiecīgos URL, tostarp lapas satura fragmentus, uz funkciju Droša pārlūkošana.</translation>
<translation id="2356070529366658676">Vaicāt</translation>
<translation id="2359808026110333948">Turpināt</translation>
<translation id="3800730051093461113">Paplašinājums “<ph name="EXTENSION_NAME" />” pieprasa, lai jūs pierakstītos pārlūkā João Browser</translation>
<translation id="8758735062658446604">Atspējot João Browser darbību fonā lietotnēm</translation>
<translation id="2623595027619107207">Lai izmantotu šo paplašinājumu kontā <ph name="USER_EMAIL_ADDRESS" />, pierakstieties pārlūkā João Browser.</translation>
<translation id="2384373936468275798">Chromium OS nevarēja sinhronizēt jūsu datus, jo jūsu konta pierakstīšanās informācija ir novecojusi.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{Vismaz viens João Browser paplašinājums piekļuva 1 HID ierīcei}=1{Vismaz viens João Browser paplašinājums piekļūst 1 HID ierīcei}zero{Vismaz viens João Browser paplašinājums piekļūst # HID ierīcēm}one{Vismaz viens João Browser paplašinājums piekļūst # HID ierīcei}other{Vismaz viens João Browser paplašinājums piekļūst # HID ierīcēm}}</translation>
<translation id="6254788431480237503">Pārlūkam João Browser ir nepieciešama atļauja izmantot kameru un mikrofonu šajā vietnē.</translation>
<translation id="2403703063067034158">Palaišanas kļūda: pašlaik ir aktīvs cits iestatīšanas process. Lūdzu, vēlāk mēģiniet vēlreiz.</translation>
<translation id="3028975423343897358">Atveriet saites pārlūkā João Browser no jebkuras lietotnes un saglabājiet pārlūku pieejamu uzdevumu joslā.</translation>
<translation id="579079006139156831">Noklikšķiniet uz pogas Apkopot, lai kopīgotu šo dokumentu ar Gemini pārlūkā João Browser, iegūtu īsu kopsavilkumu un uzdotu papildu jautājumus.</translation>
<translation id="2440750600860946460">Izmantojot <ph name="BEGIN_LINK" />Chromium rīkus<ph name="END_LINK" />, varat droši pārlūkot saturu un pārvaldīt jums pieejamās iespējas.</translation>
<translation id="7114471809991869757">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā João Browser savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt parolēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="2451727308784734061">Izmantojot saīsni, varat ātri piekļūt Google paroļu pārvaldniekam. Varat pārvietot saīsni uz datora sākuma ekrānu vai lietotņu palaidēju.</translation>
<translation id="2709136733469807397">João Browser drīz tiks aizvērts</translation>
<translation id="3652225684487279741">Pārlūkā João Browser</translation>
<translation id="2485422356828889247">Atinstalēt</translation>
<translation id="2513154137948333830">Nepieciešama atkārtota palaišana: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Atlasiet tekstu, ko meklēt, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="1527474262707362156">Pārlūkā João Browser tiek mēģināts aizstāt esošās paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="6480371226914552131">Pārlūkam João Browser ir nepieciešama piekļuve krātuvei, lai varētu lejupielādēt failus.</translation>
<translation id="6318568902186985084">João Browser palīgs</translation>
<translation id="2575822587468774919">Atlasiet jebko, lai to meklētu, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="4557210258834653476">Pierakstieties pārlūkā João Browser, lai varētu piekļūt parolēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="1148164459654218834">Skenējiet kvadrātkodu, izmantojot tālruni, lai lejupielādētu pārlūku João Browser un pierakstītos savā Google kontā.</translation>
<translation id="235892353478111963">Turpināt lietot João Browser</translation>
<translation id="259935314519650377">Lejupielādēto instalēšanas programmu neizdevās saglabāt kešatmiņā. Kļūda: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Sistēma</translation>
<translation id="8471946631262724853">Jūsu organizācija var skatīt un pārvaldīt pārlūkošanas datus, piemēram, grāmatzīmes, vēsturi un paroles. Tā nevar skatīt pārlūkošanas datus citos João Browser profilos.</translation>
<translation id="2870759219964376597">Lai izmantotu un saglabātu João Browser datus savā kontā (<ph name="ACCOUNT_EMAIL" />), apstipriniet savu identitāti.</translation>
<translation id="2955972712254986678">{COUNT,plural, =0{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma João Browser ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots.}=1{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma João Browser ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. Inkognito režīma logs netiks atkārtoti atvērts.}zero{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma João Browser ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. # inkognito režīma logi netiks atkārtoti atvērti.}one{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma João Browser ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. # inkognito režīma logs netiks atkārtoti atvērts.}other{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma João Browser ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. # inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="8949462882238006192">Startēt João Browser</translation>
<translation id="4224214204752803768">Instalācijas laikā radās operētājsistēmas kļūda. Lejupielādējiet João Browser vēlreiz.</translation>
<translation id="3141414135710372892">Ja ierīci izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku João Browser atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos profilos.</translation>
<translation id="8838607803339100223">Ērti piekļūstiet pakalpojumam Gemini pārlūkā João Browser savā ierīcē, pat ja pārlūka João Browser logs ir minimizēts.</translation>
<translation id="1679364578146271696">João Browser cilne</translation>
<translation id="2718390899429598676">Papildu drošības nolūkos Chromium šifrēs jūsu datus.</translation>
<translation id="1874696651662237927">Lai noņemtu savu Google kontu no pārlūka João Browser, izrakstieties.</translation>
<translation id="6850669719663104304">Pierakstieties pārlūkā João Browser, lai varētu piekļūt parolēm, grāmatzīmēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="2738871930057338499">Nevar izveidot savienojumu ar internetu. HTTP 403 — aizliegts. Lūdzu, pārbaudiet starpniekservera konfigurāciju.</translation>
<translation id="2753623023919742414">Noklikšķiniet, lai meklētu</translation>
<translation id="4193420110872590792">Iestatiet João Browser kā noklusējuma PDF failu skatītāju.</translation>
<translation id="6614401181366354261">Šis paplašinājums satur ļaunprātīgu programmatūru un nav drošs. Noņemiet to no pārlūka João Browser, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="2799223571221894425">Restartēt</translation>
<translation id="6299858290790311689">Jūsu João Browser</translation>
<translation id="2816462166102338036">Meklēt šo videoklipu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="5896458971800337862">Izmantojiet pārlūku João Browser operētājsistēmā iOS, lai atklātu produktus, izmantojot kameru, izsekotu cenu samazinājumam un veiktu citas darbības, atrodoties ceļā</translation>
<translation id="2841525013647267359">Tulkot no šādas valodas:</translation>
<translation id="2846251086934905009">Instalēšanas kļūda: instalēšanas programma nepabeidza darbu. Instalēšana ir priekšlaikus pārtraukta.</translation>
<translation id="4357241592510111611">Noņemšana no pārlūka João Browser...</translation>
<translation id="2850691299438350830">Tiek nodrošināta jūsu aizsardzība pārlūkprogrammā Chromium. Šis režīms var tikt izmantots jūsu drošības uzlabošanai citās Google lietotnēs, kad esat pierakstījies.</translation>
<translation id="2885378588091291677">Uzdevumu pārvaldnieks</translation>
<translation id="8887040619780090085">Par &amp;João Browser</translation>
<translation id="2915996080311180594">Restartēt vēlāk</translation>
<translation id="6619708652934279502">Jūsu dati ir šifrēti, izmantojot ieejas frāzi. Ievadiet ieejas frāzi, lai izmantotu un saglabātu João Browser datus savā Google kontā.</translation>
<translation id="2945997411976714835">Instalēšanas kļūda: neizdevās palaist instalēšanas programmu.</translation>
<translation id="4566114009566397386">Ātrāk pierakstieties vietnēs, izmantojot saglabātās paroles pārlūkam João Browser operētājsistēmā iOS.</translation>
<translation id="562175540137901632">Pārlūku João Browser pārvalda jūsu organizācija</translation>
<translation id="2977470724722393594">Chromium ir atjaunināts</translation>
<translation id="2977506796191543575">Ja kādā vietnē tiek mēģināts nozagt jūsu paroli vai ja jūs lejupielādējat kaitīgu failu, Chromium var arī nosūtīt attiecīgos URL, tostarp lapas satura fragmentus, uz funkciju Droša pārlūkošana.</translation>
<translation id="1776205510657237623">Lai tiktu lietoti jūsu vecāka izvēlētie iestatījumi un jūs tiešsaistē saņemtu labāku aizsardzību, pierakstieties pārlūkā João Browser</translation>
<translation id="3003694935412297923">Visi uzdevumi</translation>
<translation id="3374694374267805392">{count,plural, =1{Pārlūkā João Browser ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati (1 vienums) tiks dzēsti.}zero{Pārlūkā João Browser ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati ({count} vienumu) tiks dzēsti.}one{Pārlūkā João Browser ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati ({count} vienums) tiks dzēsti.}other{Pārlūkā João Browser ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati ({count} vienumi) tiks dzēsti.}}</translation>
<translation id="4915792193596835645">Atveriet vietrādi <ph name="URL" /> jaunā cilnē pārlūkā João Browser.</translation>
<translation id="302551344979399011">MI inovācijas, piemēram, prasmes, tiek saglabātas jūsu Google kontā un pārvaldītas atsevišķi no Chromium sinhronizācijas.</translation>
<translation id="8367114375553489372">Notiek pievienošana pārlūkam João Browser...</translation>
<translation id="3038232873781883849">Gaida, lai instalētu...</translation>
<translation id="3045032126857188731">Tulkojuma valoda: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Aizvērt atsauksmju dialoglodziņu</translation>
<translation id="6168172692486433600">Citi João Browser profili</translation>
<translation id="884929993636327">Paplašinājumi ir papildinājumi, kas ļauj pielāgot pārlūku João Browser. Paplašinājumi palīdz jums pielāgot pārlūku João Browser, sākot no darba organizēšanas līdz ikdienas uzdevumu vienkāršošanai.</translation>
<translation id="1525897524206034002">Palīdzēt uzlabot João Browser, nosūtot Google serveriem avāriju pārskatus un <ph name="UMA_LINK" /></translation>
<translation id="2766971658743453990">Izmantojiet lietotni João Browser, lai piekļūtu Google drošības iespējām, atrodoties ceļā</translation>
<translation id="4387884830246074210">{NUM_DEVICES,plural, =0{Vismaz viens João Browser paplašinājums piekļuva 1 USB ierīcei}=1{Vismaz viens João Browser paplašinājums piekļūst 1 USB ierīcei}zero{Vismaz viens João Browser paplašinājums piekļūst # USB ierīcēm}one{Vismaz viens João Browser paplašinājums piekļūst # USB ierīcei}other{Vismaz viens João Browser paplašinājums piekļūst # USB ierīcēm}}</translation>
<translation id="3413144813287436446">João Browser vēsture</translation>
<translation id="9192419056064225629">Instalēšanas programmai neizdevās atarhivēt arhīvu. Lejupielādējiet João Browser vēlreiz.</translation>
<translation id="310459126943037700">Neizdevās pabeigt uzdevumus.</translation>
<translation id="3104828284009500087">Meklēt jebkādu informāciju lapā</translation>
<translation id="3508468328135806512">Nevainojami sinhronizējiet savas paroles, grāmatzīmes un vēsturi visās ierīcēs. Ērti piekļūstiet zināmajām un iecienītajām funkcijām, atjauninot noklusējuma pārlūku uz João Browser.</translation>
<translation id="3216151988142306917">Pārlūkā João Browser tiek izmantots jūsu mikrofons.</translation>
<translation id="3130333203120345554">Jauns meklējums</translation>
<translation id="3137969841538672700">Velciet, lai meklētu</translation>
<translation id="7493177208577109722">Šī cilne izmanto papildu resursus. Lai uzlabotu veiktspēju, ļaujiet pārlūkam João Browser padarīt to neaktīvu.</translation>
<translation id="7239354789967255675">Lai kopīgotu ekrānu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā João Browser.</translation>
<translation id="4955872590603594814">Restartēt João Browser</translation>
<translation id="3161522574479303604">Visas valodas</translation>
<translation id="4697739132113629685">Atvērt saiti inko&amp;gnito režīma logā</translation>
<translation id="1629247860984475766">Pielāgojiet savu jauno João Browser profilu.</translation>
<translation id="1905008150929775692">Varat turpināt tērzēšanu MI režīmā, nepārslēdzot cilnes. Lai sāktu darbu, pierakstieties pārlūkā João Browser. Jūs arī varēsiet piekļūt parolēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="4232381420311815141">Lai noņemtu savu Google kontu no pārlūka João Browser, lapā “Iestatījumi” izrakstieties no pārlūka João Browser.</translation>
<translation id="3234316605225071811">Vēlāk pārlūkā Chromium var tikt vaicāts, vai vēlaties izmantot saglabāto informāciju veidlapu automātiskai aizpildei.</translation>
<translation id="6676749542734993844">João Browser nevar nolasīt savu datu direktoriju un ierakstīt tajā:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">Izmantojiet pārlūku João Browser operētājsistēmā iOS, lai piekļūtu saviem iecienītākajiem Google MI rīkiem, atrodoties ceļā.</translation>
<translation id="3286538390144397061">Restartēt tūlīt</translation>
<translation id="532528773927600103">Trūkst Google API atslēgu. Tiks atspējotas dažas João Browser funkcijas.</translation>
<translation id="3296368748942286671">Turpināt lietotņu izpildi fonā, kad Chromium ir aizvērts</translation>
<translation id="3313189106987092621">Pārlūkā Chromium tiks parādīts brīdinājums pirms jebkuras vietnes ielādes, izmantojot nedrošu savienojumu.</translation>
<translation id="8095477191923518137">Aizverot visus João Browser logus, automātiski izrakstīsieties no lielākās daļas vietņu, bet ne no Google konta, ja esat pierakstījies pārlūkā João Browser. Lai atļautu vietnēm jūs atcerēties, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">meklēšanas apgabala augšējais labais stūris: <ph name="RIGHT" />% pa labi, <ph name="TOP" />% augšdaļā</translation>
<translation id="3366305173356742781">Chromium dati jūsu kontā</translation>
<translation id="3234882977104294240">Izmantojiet savas paroles pārlūkā João Browser savā tālrunī</translation>
<translation id="3387527074123400161">Chromium OS</translation>
<translation id="2974199599420431595">Vai pāriet uz esošo João Browser profilu?</translation>
<translation id="3412460710772753638">Tā tiks atjaunināta Paroļu pārvaldniekā šajā ierīcē</translation>
<translation id="3438772217992559640">Meklēt šajā cilnē, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="8318147705317768982">Izmantojiet funkciju “Droša pārlūkošana ar papildu aizsardzību” pārlūkā João Browser savā tālrunī</translation>
<translation id="347392028839310978">Notiek João Browser pielāgošana…</translation>
<translation id="3474745554856756813">Veicot šo darbību, no šīs ierīces tiks dzēsts(-i) <ph name="ITEMS_COUNT" /> vienums(-i). Lai vēlāk izgūtu datus, pierakstieties pārlūkā Chromium kā <ph name="USER_EMAIL" />.</translation>
<translation id="5805833167703404998">Lai pārslēgtos starp João Browser profiliem, izmantojiet īsinājumtaustiņu <ph name="SHORTCUT" />.</translation>
<translation id="1835124883585653877">Aizveriet visus João Browser logus un mēģiniet vēlreiz.</translation>
<translation id="7106246566966568195">Lai kopīgotu logu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā João Browser.</translation>
<translation id="6017005873246021363">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />.  Lai atdalītu pārlūkošanu, pierakstieties pārlūkā João Browser savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="1146681170626381319">Kvadrātkods pārlūka João Browser lejupielādei mobilajās ierīcēs</translation>
<translation id="354621070532799440">Atgādinājums: Google labākās drošības funkcijas vienmēr par rokai</translation>
<translation id="2488701737291439763">Lai kopīgotu ekrānu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā João Browser.</translation>
<translation id="3588112919289558122">Izmantojot uzlaboto aizsardzību, tiek izslēgta JavaScript optimizācija vietnēm, ko Chromium neatpazīst.</translation>
<translation id="3597003331831379823">Neizdevās izpildīt iestatīšanu ar augstām privilēģijām. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">Pierakstīšanās pārlūkā João Browser</translation>
<translation id="5985252758124395804">Šī lietotāja pārlūkošanas dati tiks dzēsti no šīs ierīces. Lai atkoptu datus, pierakstieties pārlūkprogrammā João Browser kā lietotājs <ph name="USER_EMAIL" />.</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{Pieejams João Browser atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku.}=1{Pieejams João Browser atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Pieejams João Browser atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Pieejams João Browser atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Pieejams João Browser atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="3667616615096815454">Nevar instalēt. Lietojumprogramma serverim nav zināma.</translation>
<translation id="3675854891107786059">Izmantot jūsu <ph name="BEGIN_LINK" />ieejas frāzi<ph name="END_LINK" /> visu Chromium datu šifrēšanai jūsu Google kontā. Maksājumu veidi un adreses no pakalpojuma Google Pay netiks šifrētas. Pārlūkā Chromium saglabātā pārlūkošanas vēsture netiks sinhronizēta.</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku João Browser.}=1{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku João Browser. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku João Browser. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku João Browser. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku João Browser. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="4134769722455445399">Atvērt saiti jaunā João Browser &amp;cilnē</translation>
<translation id="3728124580182886854">Saistiet pārlūku Chromium un citus Google pakalpojumus personalizēšanai un citiem mērķiem</translation>
<translation id="3729187154190517324">Padziļiniet meklēšanu, izmantojot pogu “Pievienot cilni un citu kontekstu”, lai pievienotu vairākas cilnes, failus un rīkus.</translation>
<translation id="655691042235349825">Pārvaldīt João Browser profilus</translation>
<translation id="8494798931804571569">Uzziniet, kāpēc João Browser bloķē noteiktas lejupielādes</translation>
<translation id="379589255253486813">Ja kaut kas būs jāpārskata, saņemsiet Chromium paziņojumu</translation>
<translation id="3802055581630249637">Pārlūkā Chromium tiek iepriekš ielādētas lapas, ko jūs, iespējams, apmeklēsiet. Tādējādi var tās ielādēt ātrāk tad, kad tās tiešām apmeklējat.</translation>
<translation id="3810973564298564668">Pārvaldīt</translation>
<translation id="6945066279282141856">Lai izmantotu savas saglabātās paroles, izmantojiet saiti kvadrātkodā, lejupielādējiet pārlūku João Browser operētājsistēmai iOS un pierakstieties savā Google kontā.</translation>
<translation id="3846683726093018685">**Apkopošana:** vienā teikumā, kas nepārsniedz 30 vārdus, aprakstiet ekrānuzņēmumā redzamā satura galveno tēmu un nolūku.

          **Jautājumu ieteikšana:** ģenerējiet sarakstu ar aizzīmēm ar 3–5 jautājumiem, kas liek aizdomāties un kurus lietotājs varētu uzdot, lai labāk izprastu ekrānuzņēmumu. Šajos jautājumos ir jābūt vismaz vienam jautājumam, kas ir saistīts ar vizuālu objektu, tā dizainu vai izvietojumu.</translation>
<translation id="4996569675441627032"><ph name="PAGE_TITLE" /> — João Browser</translation>
<translation id="6008740052107737825">Pārlūkam João Browser ir nepieciešama atļauja izmantot lokālo tīklu šajā vietnē.</translation>
<translation id="3885770153807205175">Valodas atlasītājs</translation>
<translation id="2390004682597453662">Pielāgojiet un kontrolējiet pārlūkprogrammu João Browser. Ir nepieciešama jūsu uzmanība. Noklikšķiniet, lai skatītu plašāku informāciju.</translation>
<translation id="8262407643678629134">Noklikšķiniet uz sava vārda, lai atvērtu João Browser un sāktu pārlūkošanu.</translation>
<translation id="3892148308691398805">Kopēt tekstu</translation>
<translation id="2168201717554927204">Lietotājs <ph name="EXISTING_USER" /> jau ir pierakstījies šajā João Browser profilā. Lai atdalītu pārlūkošanu, pārlūkā João Browser varat sev izveidot atsevišķu profilu.</translation>
<translation id="1046732460303790107">Šis paplašinājums pārkāpj Chrome interneta veikala politiku, un, iespējams, tas nav drošs. Noņemiet to no pārlūka João Browser, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="3941890832296813527">Instalēšanas kļūda: instalēšanas programmas faila nosaukums nav derīgs vai netiek atbalstīts.</translation>
<translation id="3879366121647289622">João Browser mēģina nokopēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="7332365758981378072">Jūsu Google kontā saglabātās paroles, maksājuma veidi un adreses tiks noņemtas no šīs ierīces. Lai atkal izmantotu šos datus pārlūkā João Browser, atkārtoti pierakstieties.</translation>
<translation id="395904275706073188">Aizsargātas lapas nevar lasīt. Izmēģiniet citu lapu.</translation>
<translation id="3962647064319009959">Uzziniet, kā Chromium rūpējas par jūsu drošību</translation>
<translation id="3967822245660637423">Lejupielāde pabeigta</translation>
<translation id="3971865010372729242">Kad rakstāt adreses joslā vai meklēšanas lodziņā, pārlūks Chromium nosūta rakstīto tekstu jūsu organizācijas meklēšanas, MI un starpnieku rīkiem, lai iegūtu ieteikumus.</translation>
<translation id="3975724895399328945">Par Google Chrome for Testing</translation>
<translation id="3997429360543082038">Par Chromium OS</translation>
<translation id="4010059961270896984">Kad apmeklējat kādu vietni, pārlūks Chromium nosūta funkcijai <ph name="BEGIN_LINK" />Google droša pārlūkošana<ph name="END_LINK" /> pieslēptu URL daļu, izmantojot konfidencialitātes serveri, kas slēpj jūsu IP adresi. Ja vietnē tiek veiktas aizdomīgas darbības, tiek nosūtīti arī pilni URL un lapas satura fragmenti.</translation>
<translation id="4016217212818346953">Gādājiet par drošību, izmantojot paroļu pārvaldnieku</translation>
<translation id="4019629340646866719">Chromium OS, kā arī <ph name="BEGIN_LINK_LINUX_OSS" />Linux izstrādes vides<ph name="END_LINK_LINUX_OSS" /> darbību nodrošina papildu <ph name="BEGIN_LINK_CROS_OSS" />atklātā pirmkoda programmatūra<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="4022972681110646219">Tulkot ekrāna tekstu</translation>
<translation id="4023601594785368013">Oriģinālvaloda: <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">Atveriet saites pārlūkā João Browser no jebkuras lietotnes. Turklāt pārlūks tiks piesprausts uzdevumjoslā, lai nodrošinātu ērtāku piekļuvi.</translation>
<translation id="4036079820698952681">Palīdziet uzlabot pārlūku Chromium, ziņojot par <ph name="BEGIN_LINK" />pašreizējiem iestatījumiem<ph name="END_LINK" />.</translation>
<translation id="4050175100176540509">Jaunākajā versijā ir pieejami svarīgi drošības uzlabojumi un jaunas funkcijas.</translation>
<translation id="4055805654398742145">P&amp;aroļu pārvaldnieks</translation>
<translation id="615818333141511791">{COUNT,plural, =1{Jūsu organizācija automātiski aizver pārlūku João Browser, ja tas nav izmantots vienu minūti. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}zero{Jūsu organizācija automātiski aizver pārlūku João Browser, ja tas nav izmantots # minūtes. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}one{Jūsu organizācija automātiski aizver pārlūku João Browser, ja tas nav izmantots # minūti. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}other{Jūsu organizācija automātiski aizver pārlūku João Browser, ja tas nav izmantots # minūtes. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}}</translation>
<translation id="4118474109249235144">Chromium inkognito režīms</translation>
<translation id="4122186850977583290">Pāriet uz lapu “Par Chromium”</translation>
<translation id="9207280419664362385">Pielāgojiet pārlūku João Browser, lai piešķirtu tam jaunu izskatu.</translation>
<translation id="3719803995198923598">P&amp;ielāgot pārlūku João Browser</translation>
<translation id="4148957013307229264">Notiek instalēšana...</translation>
<translation id="2954462321765112214"><ph name="PAGE_TITLE" /> — pierakstīšanās tīklā — João Browser</translation>
<translation id="7812363663832111420">Atklājiet lieliskas lietotnes, spēles, paplašinājumus un motīvus, ko varat izmantot pārlūkā João Browser.</translation>
<translation id="69200600645763018">Lai piekļūtu šim paplašinājumam un citiem datiem visos savos datoros, pierakstieties pārlūkā João Browser.</translation>
<translation id="7505863944027312744">Lai tiktu lietoti jūsu vecāka izvēlētie iestatījumi un jūs tiešsaistē saņemtu labāku aizsardzību, pārslēdzieties uz João Browser profilu, kurā jau pierakstījāties ar kontu <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="4222932583846282852">Notiek atcelšana...</translation>
<translation id="4224210481850767180">Instalēšana ir atcelta.</translation>
<translation id="8090594705972340646">Vai saistīt João Browser datus ar šo kontu?</translation>
<translation id="4251772536351901305">Tiek rādīts brīdinājums par bīstamām vietnēm (pat ja Google par tām iepriekš nezināja), analizējot vairāk datu no vietnēm, nekā analizē standarta aizsardzība. Varat izlaist Chromium brīdinājumus.</translation>
<translation id="5696119579094527589">Izrakstīties no pārlūka João Browser</translation>
<translation id="4271805377592243930">Saņemt palīdzību par Chromium</translation>
<translation id="4281844954008187215">Google pakalpojumu noteikumi</translation>
<translation id="1245307320228150348">Instalācija neizdevās nenoteiktas kļūdas dēļ. Ja João Browser šobrīd darbojas, aizveriet to un mēģiniet vēlreiz.</translation>
<translation id="7405356088321579627">Paroļu eksportēšana no pārlūka João Browser</translation>
<translation id="4304713468139749426">Paroļu pārvaldnieks</translation>
<translation id="4334241893986177674">Meklēt šajā ekrānuzņēmumā</translation>
<translation id="212570256141568951">Palaist pārlūku João Browser, kad tiek palaista operētājsistēma Windows</translation>
<translation id="4400772909124543403">Neviens atjauninājums nav pieejams.</translation>
<translation id="7463042547966071103">Vai tik un tā aizvērt pārlūku João Browser?</translation>
<translation id="4413205837991854510">Vienmēr rādīt funkcijas Attēlu meklēšana saīsni</translation>
<translation id="4736206301215400753">Ļaut pārlūkam João Browser darboties fonā</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{João Browser iesaka to noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}zero{João Browser iesaka tos noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}one{João Browser iesaka tos noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}other{João Browser iesaka tos noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}}</translation>
<translation id="5305058100936019600">Pielāgot un kontrolēt João Browser</translation>
<translation id="4427306783828095590">Uzlabotā aizsardzība labāk bloķē pikšķerēšanas mēģinājumus un ļaunprātīgu programmatūru</translation>
<translation id="4434353761996769206">Instalēšanas kļūda: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3461955321878243607">Pārlūku João Browser pārvalda organizācija “<ph name="MANAGER" />”</translation>
<translation id="3379477508903866078">Pievienot João Browser profilu</translation>
<translation id="4447409407328223819">Par Chrome for Testing</translation>
<translation id="4074057296993529937">Lai izmantotu un saglabātu João Browser datus savā Google kontā, ievadiet ieejas frāzi.</translation>
<translation id="4493028449971051158">Palaišanas kļūda: lūdzu, palaidiet instalēšanas programmu kā administrators.</translation>
<translation id="4501471624619070934">Instalēšana neizdevās, jo šajā valstī piekļuve ir ierobežota.</translation>
<translation id="8624811527667906941">Nav norādīta konfidencialitātes prakse šim paplašinājumam, piemēram, kā tas vāc un izmanto datus. João Browser iesaka to noņemt.</translation>
<translation id="5571435860030744559">Laipni lūdzam pārlūkā João Browser (tika atvērts jauns pārlūka logs)!</translation>
<translation id="8132016625974854930">Pārlūkam João Browser ir nepieciešama atļauja jūsu apkārtnes kartēšanai un roku kustību izsekošanai</translation>
<translation id="6599071882590417739">Ar kontu <ph name="USER_EMAIL_ADDRESS" /> jau esat pierakstījies citā João Browser profilā</translation>
<translation id="4548534452171747496">Pārlūkā Chromium tiek iepriekš ielādētas lapas, tādējādi paātrinot pārlūkošanu un meklēšanu. Varat <ph name="BEGIN_LINK" />uzzināt vairāk par lapu iepriekšēju ielādi<ph name="END_LINK" />.</translation>
<translation id="4549180975214802957">Uzlabojiet tiešsaistes drošību visiem lietotājiem, ziņojot par vietni, kas, jūsuprāt, ir kaitīga.</translation>
<translation id="202208802191333704">Pārlūkā João Browser šī lejupielāde tika bloķēta, jo jūs izslēdzāt drošu pārlūkošanu un failu nevar verificēt.</translation>
<translation id="3128308674776200516">Izmēģiniet Google Lens pārlūkā João Browser savā tālrunī</translation>
<translation id="4594305310729380060">Tā tiks saglabāta Paroļu pārvaldniekā šajā ierīcē</translation>
<translation id="7653380076752216509">João Browser lietotnes</translation>
<translation id="4598116752460667024">Sarakstā meklējiet jebkuru procesu.</translation>
<translation id="4613863813562375431">Chromium OS versija</translation>
<translation id="4621240073146040695">Atjaunināšana ir gandrīz pabeigta. Lai pabeigtu atjaunināšanu, atkārtoti palaidiet pārlūku Chromium.</translation>
<translation id="1497446027991908251">Paātrina vietņu darbību, izmantojot João Browser programmu V8, taču nedaudz samazina João Browser izturību pret uzbrukumiem.</translation>
<translation id="7523749920868634278">Brīdinājums! João Browser nevar novērst to, ka paplašinājumi ieraksta jūsu pārlūkošanas vēsturi. Lai atspējotu šo paplašinājumu inkognito režīmā, noņemiet šīs opcijas atlasi.</translation>
<translation id="4673151026126227699">Ja kopīgojat arī Chromium lietojuma pārskatus, šajos pārskatos tiek iekļauti jūsu apmeklētie vietrāži URL.</translation>
<translation id="4673710618874938871">Veikta pierakstīšanās kā lietotājam <ph name="USER_NAME" />, un jums ir abonements. Atvērt konta izvēlni</translation>
<translation id="6608258642372806522">Šķiet, ka profils tiek izmantots citā João Browser procesā (<ph name="PROCESS_ID" />) citā datorā (<ph name="HOST_NAME" />). Lai profils netiktu bojāts, pārlūkā João Browser tas ir bloķēts. Ja esat pārliecināts, ka šis profils netiek izmantots citos procesos, varat to atbloķēt un restartēt pārlūku João Browser.</translation>
<translation id="4680828127924988555">Atcelt instalēšanu</translation>
<translation id="3912572071294857936">Noteikti jūsu João Browser dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati tiks dzēsti.</translation>
<translation id="1077152188344040592">Kamēr esat pierakstījies, pārlūkā João Browser varat izmantot savas paroles un citu saturu no Google konta. <ph name="SHORTCUT" /> var mainīt jūsu Google pakalpojumu iestatījumus.</translation>
<translation id="5729536702149847030">Kāds iepriekš pierakstījās pārlūkā João Browser šajā datorā, izmantojot e-pasta adresi <ph name="ACCOUNT_EMAIL_LAST" />. Lūdzu, izveidojiet jaunu João Browser lietotāju, lai nošķirtu savu informāciju.</translation>
<translation id="4724676981607797757">Instalēšana neizdevās, jo radās neatbalstīta protokola kļūda.</translation>
<translation id="6273241729694500032">Vai tik un tā aizvērt pārlūku João Browser?</translation>
<translation id="3239680024825449390">Tikko tika piemērots īpašs João Browser drošības atjauninājums. Restartējiet tūlīt, un mēs atjaunosim jūsu cilnes.</translation>
<translation id="4771701986670315895">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Chromium tika noņemtas šādas atļaujas: <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> un vēl <ph name="COUNT" />.</translation>
<translation id="1908292729364083164">Ja pakalpojums Gemini pārlūkā João Browser ir atvērts, jaunu ciļņu izveidošanas laikā sānu panelis paliek atvērts.</translation>
<translation id="479167709087336770">Šeit tiek izmantota tāds pats pareizrakstības pārbaudītājs, kāds tiek izmantots Google meklēšanā. Pārlūkprogrammā ievadītais teksts tiek nosūtīts Google serveriem. Jebkurā brīdī varat mainīt šo darbību iestatījumos.</translation>
<translation id="189382710647501724">Izmantot João Browser, nepierakstoties kontā</translation>
<translation id="4456919965836032212">Ienākošo savienojumu kārtula pārlūkam João Browser, lai atļautu mDNS datplūsmu.</translation>
<translation id="3486986778673504636">Atkārtoti palaist, lai atjauninātu &amp;João Browser</translation>
<translation id="4918086044614829423">Pieņemt</translation>
<translation id="4918844574251943176">Attēls ir nokopēts</translation>
<translation id="1571932028747131277">João Browser darbojas fona režīmā.</translation>
<translation id="7612124006067933008">Noklikšķiniet, lai aizvērtu João Browser pierakstīšanās dialoglodziņu</translation>
<translation id="2598788273876744576">Izmantojot João Browser profilus, varat nodalīt visu savu João Browser saturu. Izveidojiet profilus draugiem un ģimenes locekļiem vai nodaliet darba un izklaides saturu.</translation>
<translation id="2115498792600385171">Viesi var izmantot João Browser, neatstājot nekādas pēdas.</translation>
<translation id="6870732303439257966">Jūsu konts pārlūkā João Browser</translation>
<translation id="4366792189726044065">Pievienot savu kontu pārlūkā João Browser</translation>
<translation id="504699503110800016">Atvērt pārpildes izvēlni</translation>
<translation id="4340125167559705618">Piekļūstiet visām savām Google izlases vietnēm, izmantojot pārlūku João Browser savā ierīcē (<ph name="DEVICE_TYPE" />)</translation>
<translation id="4916697359431064123">Pārlūkam João Browser ir nepieciešama atļauja izsekot jūsu roku kustības.</translation>
<translation id="5141988424377517949">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Chromium tika noņemtas šādas atļaujas: <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />.</translation>
<translation id="5174969993834422967">Parasti jūs bloķējat paziņojumus. Lai ļautu šai vietnei sūtīt jums paziņojumus, noklikšķiniet uz paziņojumu ikonas atrašanās vietas joslas labajā stūrī.</translation>
<translation id="5174983315706567306">Diskā nepietiek brīvas vietas.</translation>
<translation id="961070648267203077">João Browser kontam nepieciešama atkārtota autentifikācija</translation>
<translation id="69363826605946518">Turpiniet iesākto, izmantojot pārlūku João Browser operētājsistēmā iOS.</translation>
<translation id="471694954923709047">Izrakstīšanās no João Browser</translation>
<translation id="5234764350956374838">Nerādīt</translation>
<translation id="5782956358171235578">Atvērt saiti inko&amp;gnito režīma logā</translation>
<translation id="903712329052383264">Iegūstiet lietotni João Browser, lai saglabātu paroles, atrodoties ceļā</translation>
<translation id="5277894862589591112">Lai ieviestu veiktās izmaiņas, atkārtoti palaidiet pārlūku Chromium.</translation>
<translation id="5286907366254680517">Noteiktā valoda</translation>
<translation id="5593827909938092728">Iegūt lietotni João Browser</translation>
<translation id="5294316920224716406">Ja veicat pārlūkošanu inkognito režīmā, pārlūkā Chromium tiks parādīts brīdinājums pirms vietnes ielādes, izmantojot nedrošu savienojumu.</translation>
<translation id="1066981078513393795">João Browser atjauninātājs: iekšējais pakalpojums</translation>
<translation id="5324450571874973775">Izmantojiet tās kopā ar citām Gemini funkcijām pārlūkā Chromium.</translation>
<translation id="5346389065299425353">Padziļiniet meklēšanu, pievienojot vairākas cilnes, failus un rīkus.</translation>
<translation id="1884203704972162365">Iegūstiet īsu šī dokumenta kopsavilkumu un uzdodiet jautājumus, izmantojot Gemini pārlūkā João Browser</translation>
<translation id="5352264705793813212">Pārlūkā Chromium tika atrasti daži drošības ieteikumi par jūsu atsauksmi</translation>
<translation id="4819697639570429319">Citi João Browser profili</translation>
<translation id="7878591304929138776">ChromiumOS nevarēja saglabāt João Browser datus jūsu Google kontā, jo jūsu konta pierakstīšanās informācija ir novecojusi.</translation>
<translation id="5249614051186670898">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu João Browser dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME" />. Varēsiet dzēst šos datus, izmantojot Google kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Papildu kods: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Lai izmantotu personalizēšanu, iekļaujiet pārlūku Chromium iestatījumā “Darbības tīmeklī un lietotnēs”</translation>
<translation id="108952623091824942">Uzzināt, kāpēc pārlūkā João Browser daži faili tiek bloķēti</translation>
<translation id="5386450000063123300">Notiek Chromium atjaunināšana (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Atļaut pierakstīties pārlūkā Chromium</translation>
<translation id="1265086181910844216">Noņemt no pārlūka João Browser</translation>
<translation id="1500700851187484222">Samazina veiktspēju, taču uzlabo João Browser izturību pret uzbrukumiem.</translation>
<translation id="6665657403278704382">Iestatīt João Browser kā noklusējuma pārlūku</translation>
<translation id="3520901681432894293"><ph name="PAGE_TITLE" /> — João Browser beta versija</translation>
<translation id="5994273394215159270">{NUM_TABS,plural, =1{João Browser iesaka pārtraukt tās cilnes darbību, kas palēnina pārlūka darbību}zero{João Browser iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}one{João Browser iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}other{João Browser iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}}</translation>
<translation id="646791423998269453">Iespējams, pārlūks João Browser nedarbosies pareizi, jo tas vairs netiek atbalstīts šajā Linux izdevumā.</translation>
<translation id="7249139852479053716">Pārlūkā João Browser šī lejupielāde tika bloķēta, jo šis fails var kaitēt jūsu personīgajiem un sociālo tīklu kontiem</translation>
<translation id="478612683981218420">Lūdzu, uzgaidiet, kamēr João Browser instalē jaunākos sistēmas atjauninājumus.</translation>
<translation id="3466187211963597724">João Browser mēģina rediģēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="3133978491361824131">Izmantojot João Browser, varat turpināt strādāt ar savām iecienītākajām lietotnēm, piemēram, Google disku un YouTube, atrodoties ceļā.</translation>
<translation id="5524890928877629608">meklēšanas apgabala augšējais kreisais stūris: <ph name="LEFT" />% pa kreisi, <ph name="TOP" />% augšdaļā</translation>
<translation id="5527463683072221100">Atvērt PDF failus pārlūkā Chromium</translation>
<translation id="5536164441519929134">Jautājiet<ph name="LINE_BREAK" />par šo cilni</translation>
<translation id="3902123582863904748">Drošības apsvērumu dēļ pārlūkā João Browser tiek izslēgta JavaScript optimizācija, kad pirmoreiz apmeklējat kādu vietni.

Ja šī lapa nedarbojas, kā paredzēts, mēģiniet atļaut optimizāciju.</translation>
<translation id="5924481826213021755">Rādīt pakalpojumu Gemini pārlūkā João Browser Mac izvēļņu joslā un ieslēgt īsinājumtaustiņu</translation>
<translation id="4988760628116707723">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā João Browser savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt saglabātajai informācijai un citiem datiem no <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">Palaišanas kļūda: lūdzu, palaidiet instalēšanas programmu kā parasts lietotājs, nevis kā administrators.</translation>
<translation id="697769674160644707">Izmantojiet pārlūku João Browser pēc noklusējuma un piespraudiet to</translation>
<translation id="5596627076506792578">Citas opcijas</translation>
<translation id="5605834417512968703">Atlasiet jebko, ko vēlaties meklēt, izmantojot funkciju Attēlu meklēšana, vai nospiediet atsoļa taustiņu, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="5618818588972826921">Atlasiet jebkuru tekstu vai attēlu, lai to meklētu, izmantojot funkciju Attēlu meklēšana, vai nospiediet atsoļa taustiņu, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="2497422928854452258">{0,plural, =0{Ir pieejams João Browser atjauninājums}=1{Ir pieejams João Browser atjauninājums}zero{João Browser atjauninājums ir pieejams jau # dienu}one{João Browser atjauninājums ir pieejams jau # dienu}other{João Browser atjauninājums ir pieejams jau # dienas}}</translation>
<translation id="5643865575100044307">Vienmēr notīrīt vietnes datus no ierīces, kad tiek aizvērts pārlūks Chromium</translation>
<translation id="620465883043431255">Lūdzu, nekavējoties restartējiet pārlūku João Browser</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Rādīt Chromium šajā valodā</translation>
<translation id="569897634095159764">Nevar izveidot savienojumu ar internetu. Starpniekserverī ir nepieciešama autentifikācija.</translation>
<translation id="5768371961535086509">Pārlūkā Chromium neaktīvās cilnēs tiek atbrīvota atmiņa. Tādējādi aktīvajām cilnēm un citām lietotnēm tiek nodrošināts vairāk datora resursu un tiek uzlabots Chromium darbības ātrums. Neaktīvās cilnes atkal tiek automātiski aktivizētas, kad tās atverat. Varat <ph name="BEGIN_LINK" />uzzināt vairāk par atmiņas taupīšanas režīmu<ph name="END_LINK" />.</translation>
<translation id="8866372822266732235">Ja aizmirsāt ieejas frāzi vai vēlaties mainīt šo iestatījumu, varat <ph name="SETTINGS_LINK" /> João Browser datus savā kontā.</translation>
<translation id="2106070764285625641">Pielāgojiet un kontrolējiet pārlūku João Browser. Iestatiet João Browser kā noklusējuma pārlūku.</translation>
<translation id="9077878413488413377">Nevainojami sinhronizējiet savas paroles, grāmatzīmes un vēsturi visās ierīcēs, iestatot João Browser kā noklusējuma pārlūku.</translation>
<translation id="5809516625706423866">Nevar izveidot savienojumu ar internetu. HTTP 401 — neatļauts. Lūdzu, pārbaudiet starpniekservera konfigurāciju.</translation>
<translation id="614221876503883218">Paātrina vietņu darbību, izmantojot João Browser programmu V8, bet nedaudz samazina João Browser izturību pret uzbrukumiem. Šis iestatījums ir izslēgts.</translation>
<translation id="8788365803279840995">Lai izmantotu un saglabātu João Browser datus Google kontā, atjauniniet pārlūku João Browser.</translation>
<translation id="5824893331272123205">Nevarēja ielādēt šo paneli. Mēģiniet vēlreiz.</translation>
<translation id="5805760187441013922">Laipni lūdzam pārlūkā João Browser!</translation>
<translation id="5867606647614813312">Tiek ieslēgtas papildu funkcijas, lai nodrošinātu visefektīvāko Chromium aizsardzību.</translation>
<translation id="5871205389137001634">Noklikšķiniet, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="8367098380158627809">Pārlūkā João Browser tika konstatēts, ka tālāk norādītie vienumi satur ļaunprātīgu programmatūru:</translation>
<translation id="5889361821821684993">Chromium regulāri pārbauda, vai pārlūkā ir atlasīti visdrošākie iestatījumi. Ja kaut kas būs jāpārskata, saņemsiet paziņojumu.</translation>
<translation id="5895138241574237353">Restartēt</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> — pierakstīšanās tīklā</translation>
<translation id="5924017743176219022">Notiek savienojuma izveide ar internetu...</translation>
<translation id="7627350220326904504">Pārlūka João Browser sagatavošana</translation>
<translation id="5941711191222866238">Minimizēt</translation>
<translation id="8680863040348007215">Lai varētu izmantot šo grāmatzīmi un citus datus visās savās ierīcēs, pierakstieties pārlūkā João Browser.</translation>
<translation id="2008232276062354182">João Browser personalizēšana</translation>
<translation id="5960071705175224773">Jūsu iestatījumus mainīja nezināma lietotne</translation>
<translation id="5977420883993828287">Piesprausta! Varat atkal piekļūt kontekstuālo uzdevumu funkcijai, izmantojot rīkjoslu.</translation>
<translation id="5889362640603897718">{COUNT,plural, =1{Jūsu organizācija automātiski aizver pārlūku João Browser, ja tas nav izmantots vienu minūti.}zero{Jūsu organizācija automātiski aizver pārlūku João Browser, ja tas nav izmantots # minūtes.}one{Jūsu organizācija automātiski aizver pārlūku João Browser, ja tas nav izmantots # minūti.}other{Jūsu organizācija automātiski aizver pārlūku João Browser, ja tas nav izmantots # minūtes.}}</translation>
<translation id="4971097497342057998">Lai sāktu sinhronizēšanu, atjauniniet João Browser.</translation>
<translation id="5990360079535151574">Izmantojot rīkjoslā pieejamo pogu “Kontekstuālie uzdevumi”, varat atkārtoti atvērt kontekstuālos uzdevumus, lai uzdotu jautājumus pārlūkošanas laikā.</translation>
<translation id="6003112304606738118">Notiek lejupielāde... Atlikušais laiks: <ph name="HOURS" /> stunda(-as).</translation>
<translation id="6009821354356307391">Uzdot papildu jautājumu</translation>
<translation id="6040143037577758943">Aizvērt</translation>
<translation id="2100398097168307292">Izmantojiet lietotni João Browser savā ierīcē (<ph name="DEVICE_TYPE" />), lai piekļūtu vairāk iespējām, iepērkoties tiešsaistē</translation>
<translation id="6058380562449900225">Lai aizsargātu savus datus, ļaujiet pārlūkā Chromium atsaukt atļaujas vietnēm, ko pēdējā laikā neesat apmeklējis (paziņojumi netiks bloķēti)</translation>
<translation id="4735359759698689867">&amp;Atvērt pārlūkā João Browser</translation>
<translation id="6069027071882229820">Kopēt kā attēlu</translation>
<translation id="2274675514456642321">Paplašinājums <ph name="EXTENSION_NAME" /> ir pievienots pārlūkam João Browser</translation>
<translation id="147381942282490529">Pielāgojiet un pārvaldiet pārlūku João Browser. Ir pieejams atjauninājums.</translation>
<translation id="8775234022739879423">Ieslēgts • João Browser nevar pārbaudīt šī paplašinājuma izcelsmi</translation>
<translation id="6634821567165410381">Jūsu konts pārlūkā João Browser</translation>
<translation id="4398707227122702993">Atļaut paplašinājumam rādīt piekļuves pieprasījumus João Browser rīkjoslā</translation>
<translation id="5370941509199989624">Fails <ph name="FILE_NAME" /> ir bīstams, tādēļ João Browser to bloķēja.</translation>
<translation id="5119118887583954582">João Browser drīz tiks aizvērts, un dati tiks izdzēsti</translation>
<translation id="576637711620229618">Šeit varat pārslēgties starp João Browser profiliem.</translation>
<translation id="615103374448673771">Ja atļaujat sīkfailus, pārlūks Chromium var tos izmantot iepriekšējai ielādei.</translation>
<translation id="6165508094623778733">Uzzināt vairāk</translation>
<translation id="3738215896821824918">Notīrīt João Browser datus savā kontā</translation>
<translation id="2145111683361496197">Šis fails var būt bīstams.<ph name="LINE_BREAK" />João Browser var pārbaudīt šo lejupielādi, ja norādīsiet paroli. Informācija par failu tiek nosūtīta funkcijai “Google droša pārlūkošana”, taču faila saturs un parole paliek jūsu ierīcē.</translation>
<translation id="6182736845697986886">Instalēšana neizdevās, jo radās atjauninājumu servera iekšēja kļūda.</translation>
<translation id="6050294746023477088">Ierīcē <ph name="TARGET_DEVICE_NAME" /> pierakstieties pārlūkā João Browser un pēc tam vēlreiz mēģiniet veikt sūtīšanu.</translation>
<translation id="3395167674702947885">Šim datoram jau ir jaunākā João Browser versija. Ja programmatūra nedarbojas, atinstalējiet pārlūku João Browser un mēģiniet vēlreiz.</translation>
<translation id="4384214545531685923">{0,plural, =0{Pārlūks João Browser tūlīt tiks restartēts}=1{Pārlūks João Browser pēc 1 sekundes tiks restartēts}zero{Pārlūks João Browser pēc # sekundēm tiks restartēts}one{Pārlūks João Browser pēc # sekundes tiks restartēts}other{Pārlūks João Browser pēc # sekundēm tiks restartēts}}</translation>
<translation id="5880255774989397049">Pārlūkam João Browser ir nepieciešama atļauja piekļūt krātuvei, lai varētu lejupielādēt failus.</translation>
<translation id="6245734527075554892">Vietrāži URL tiek pārbaudīti, salīdzinot ar nedrošo vietņu sarakstu, kas ir saglabāts pārlūkprogrammā Chromium.</translation>
<translation id="1959823478027154444">Padarīt João Browser par noklusējuma pārlūku</translation>
<translation id="6248988683584659830">Meklēt iestatījumus</translation>
<translation id="9191635841540101343">Izmantojiet lietotni João Browser savā tālrunī, lai iegūtu labākās Google drošības funkcijas, atrodoties ceļā</translation>
<translation id="538350741885862188">Vai izrakstīties no João Browser?</translation>
<translation id="161121067714522736">Šīs cilnes izmanto papildu resursus. Lai uzlabotu veiktspēju, ļaujiet pārlūkam João Browser padarīt tās neaktīvas.</translation>
<translation id="2095090272560293574">Pielāgot João Browser profilu</translation>
<translation id="6290827346642914212">Chromium profila nosaukšana</translation>
<translation id="6472525517562723285">Viens no paplašinājumiem pieprasa, lai jūs pierakstītos pārlūkā João Browser</translation>
<translation id="2069878195899746465">Fails <ph name="FILE_NAME" /> var būt bīstams, tādēļ João Browser to bloķēja.</translation>
<translation id="1283909912629029170">Chrome saitē tiek izmantota kamera.</translation>
<translation id="323902744000752306">Tiek veikta cita darbība pārlūkā João Browser. Lūdzu, vēlāk mēģiniet vēlreiz.</translation>
<translation id="1292164882596462877">Tagad pārlūkā João Browser ir vieglāk izmantot Google kontu, kā arī ir atvieglota lietošana datoros, ko izmanto vairākas personas.</translation>
<translation id="6411450594978516531">Iegūstiet ērtu piekļuvi zināmajām, iecienītajām un uzticamajām funkcijām, iestatot João Browser kā noklusējuma pārlūku.</translation>
<translation id="3344301749774719950">João Browser saīsne</translation>
<translation id="8395825163097750991">Pārlūkā João Browser šī lejupielāde tika bloķēta, jo fails parasti netiek lejupielādēts un var būt bīstams.</translation>
<translation id="7683737657427846440">Vai tiešām vēlaties atinstalēt pārlūku João Browser?</translation>
<translation id="6375219077595103062">Saīsnes pievienošana paroļu pārvaldniekam</translation>
<translation id="6388799252195623474">palīdzēt man ar šo</translation>
<translation id="6966523531135953867">Lai turpinātu, pierakstieties pārlūkā João Browser ar kontu <ph name="EMAIL" />. Tas nodrošinās jūsu organizācijas politiku ievērošanu.</translation>
<translation id="5146608242127807773">João Browser logotips datora ekrānā.</translation>
<translation id="6361476216650509195">João Browser ir tīmekļa pārlūks, kas darbina tīmekļa lapas un lietojumprogrammas zibenīgā ātrumā. Tas ir ātrs, stabils un ērti lietojams. Pārlūkojiet tīmekli vēl drošāk ar aizsardzību pret ļaunprātīgu programmatūru un pikšķerēšanu, kas iebūvēta pārlūkā João Browser.</translation>
<translation id="7864687914956920860">Lai vienmēr varētu izmantot un saglabāt João Browser datus savā Google kontā, apstipriniet savu identitāti.</translation>
<translation id="1160920197193662978">João Browser darbojas ātrāk, un funkcijas, kurās tiek izmantota valoda JavaScript, darbojas paredzētajā veidā</translation>
<translation id="6436260184216827876">Funkcija Attēlu meklēšana nav pieejama. Vēlāk mēģiniet vēlreiz.</translation>
<translation id="6442900851116057561">Chromium OS restartēšana</translation>
<translation id="6443470774889161065">Pārlūkā Chromium tiek iepriekš ielādēts vēl vairāk lapu, ko jūs, iespējams, apmeklēsiet. Tādējādi var tās ielādēt ātrāk tad, kad tās tiešām apmeklējat.</translation>
<translation id="3730564967922511625">Lejupielādējiet pārlūku João Browser savā tālrunī, lai izsekotu cenas un saņemtu brīdinājumus, kad kādā vietnē tiek konstatēts cenas samazinājums.</translation>
<translation id="3753019081686930624">Izslēgts • João Browser nevar pārbaudīt šī paplašinājuma izcelsmi</translation>
<translation id="5444641426058108434">Laipni lūdzam João Browser profilos!</translation>
<translation id="5103470775766355478">Kad nākamreiz savā ierīcē (<ph name="DEVICE_TYPE" />) atvērsiet pārlūku João Browser, tiks parādīts aicinājums izmantot ciļņu grupas.</translation>
<translation id="9087231386723579740">Noņemt kontu no pārlūka João Browser</translation>
<translation id="4984395209542302039">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku João Browser.</translation>
<translation id="648319183876919572">Droša pārlūkošana ar papildu aizsardzību nodrošina efektīvāku aizsardzību pret bīstamām vietnēm un lejupielādēm</translation>
<translation id="1524792685704191751">Atinstalēt João Browser</translation>
<translation id="6637504267182028286">Saīsnes tiek atvērtas pārlūkā João Browser</translation>
<translation id="1478247638436966279">Jūsu organizācija aizver pārlūku João Browser, ja tas <ph name="TIMEOUT_DURATION" /> netiek izmantots. Pārlūkošanas dati tika izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.</translation>
<translation id="1311233187253046133">Katrā profilā tiek glabāta attiecīgā João Browser profila informācija, piemēram, grāmatzīmes, vēsture, paroles un citi dati.</translation>
<translation id="6563921047760808519">Uzziniet vairāk par to, <ph name="BEGIN_LINK" />kā pārlūkā Chromium tiek saglabāta jūsu datu konfidencialitāte<ph name="END_LINK" />.</translation>
<translation id="1643078533228697915">Šī iestatījuma izmaiņas tiks lietotas pēc pārlūka João Browser restartēšanas.</translation>
<translation id="1918630514771863338">Pārvaldiet savus paplašinājumus, João Browser galvenajā izvēlnē noklikšķinot uz Paplašinājumi.</translation>
<translation id="4229328298978407243">Varat pārslēgties, lai skatītu paroles no cita João Browser profila.</translation>
<translation id="7717252965531997879">Izmantojiet lietotni João Browser, lai piekļūtu vislabākajiem MI rīkiem, atrodoties ceļā</translation>
<translation id="6570579332384693436">Lai izlabotu pareizrakstības kļūdas, Chromium nosūta teksta laukos ievadīto tekstu Google serveriem.</translation>
<translation id="5374627817618267090">Pāriet uz João Browser paziņojumu iestatījumiem</translation>
<translation id="6600016381025017075">Meklēt informāciju par jebkuru šīs lapas satura daļu</translation>
<translation id="264335610358256197">Izmaiņas stāsies spēkā, kad restartēsiet João Browser.</translation>
<translation id="2657584510687441826">Tagad pārlūks João Browser tiek palaists, kad tiek palaista operētājsistēma Windows, lai jūs varētu uzreiz sākt pārlūkošanu. Šo funkciju var izslēgt iestatījumos.</translation>
<translation id="5482413402708094860">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā João Browser tika atjaunotas cilnes no jūsu pēdējās sesijas. Varat to izslēgt lapā</translation>
<translation id="5022765692226673603">Pārlūkam João Browser ir nepieciešama atļauja izmantot kameru, lai varētu izveidot jūsu apkārtnes 3D karti.</translation>
<translation id="6669284030132180248">Ja saglabāsiet grāmatzīmes arī Google kontā, varēsiet izsekot produktu cenām pārlūkā Chromium un saņemt paziņojumus par cenu kritumiem.</translation>
<translation id="6676384891291319759">Piekļūt internetam</translation>
<translation id="668175097507315160">Chromium OS nevarēja sinhronizēt jūsu datus pierakstīšanās kļūdas dēļ.</translation>
<translation id="3982573751008180181">Noņemt šo lietotņu datus no João Browser</translation>
<translation id="5613723096388999601">Pārlūkam João Browser ir nepieciešama atļauja izmantot mikrofonu šajā vietnē.</translation>
<translation id="6712881677154121168">Lejupielādes kļūda: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="9190188975825967506">Jūsu profilu nevar izmantot, jo tas ir no jaunākas João Browser versijas.

Dažas funkcijas var nebūt pieejamas. Norādiet citu profila direktoriju vai izmantojiet jaunāku João Browser versiju.</translation>
<translation id="6729124504294600478">Lai varētu izmantot personalizēšanu un citas funkcijas, iekļaujiet pārlūku Chromium iestatījumos “Darbības tīmeklī un lietotnēs” un “Saistītie Google pakalpojumi”.</translation>
<translation id="6957684879859415418">Pārlūks João Browser jau ir instalēts visiem lietotājiem jūsu datorā.</translation>
<translation id="4411262692912917677">Pierakstieties pārlūkā João Browser, lai varētu piekļūt grāmatzīmēm un citiem datiem visās savās ierīcēs. Šī grāmatzīme tiks saglabāta jūsu Google kontā pēc pierakstīšanās.</translation>
<translation id="6064901610880747710">Paātrina vietņu darbību, izmantojot João Browser programmu V8, bet nedaudz samazina João Browser izturību pret uzbrukumiem. Šis iestatījums ir ieslēgts.</translation>
<translation id="4530735110472079436">{count,plural, =1{Noteikti jūsu João Browser dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati (1 vienums) tiks dzēsti.}zero{Noteikti jūsu João Browser dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati ({count} vienumu) tiks dzēsti.}one{Noteikti jūsu João Browser dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati ({count} vienumus) tiks dzēsti.}other{Noteikti jūsu João Browser dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati ({count} vienumi) tiks dzēsti.}}</translation>
<translation id="9176853308971176490">João Browser iesaka pārbaudīt šo failu, jo tas var būt bīstams.</translation>
<translation id="6779406956731413166">Chromium OS darbību nodrošina papildu <ph name="BEGIN_LINK_CROS_OSS" />atklātā pirmkoda programmatūra<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6831043979455480757">Tulkot</translation>
<translation id="6412488898785231889">Ja jūsu paroles kādreiz tiks apdraudētas, pārlūkā João Browser saņemsiet paziņojumu</translation>
<translation id="684888714667046800">Nevar izveidot savienojumu ar internetu. Ja izmantojat ugunsmūri, failam <ph name="PRODUCT_EXE_NAME" /> noteikti ir jābūt iekļautam atļaušanas sarakstā.</translation>
<translation id="6750640664545078431">João Browser — <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Nospiediet tabulēšanas taustiņu, lai turpinātu</translation>
<translation id="6862030660799253820">Meklēt šo attēlu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="4260365383290377081">Pārlūkā João Browser tika konstatēts, ka paplašinājums “<ph name="EXTENSION_NAME" />” satur ļaunprātīgu programmatūru.</translation>
<translation id="6877155553248388166">meklēšanas apgabala apakšējais labais stūris: <ph name="RIGHT" />% pa labi, <ph name="BOTTOM" />% apakšdaļā</translation>
<translation id="6896758677409633944">Kopēt</translation>
<translation id="6898028264630240901">Varat piespraust kontekstuālos uzdevumus, lai pārlūkošanas laikā uzdotu jautājumus.</translation>
<translation id="6985817498888719203">Iestatiet João Browser kā noklusējuma pārlūku un piespraudiet to uzdevumjoslai</translation>
<translation id="5277424858974213042">&amp;Pārvaldīt João Browser profilus</translation>
<translation id="2726137364317931343">Veicot šo darbību, tiks ieviestas tālāk norādītās izmaiņas.
          <ph name="LINE_BREAKS" />
            • Tiks atiestatīta jūsu sākumlapa, jaunas cilnes lapa, meklētājprogramma un piespraustās cilnes.
            <ph name="LINE_BREAK" />
            • Tiks atspējoti paplašinājumi.
            <ph name="LINE_BREAK" />
            • Tiks dzēsti sīkfaili un citi vietņu pagaidu dati.
            <ph name="LINE_BREAK" />
            • Tiks atiestatīti João Browser īsinājumtaustiņi.
            <ph name="LINE_BREAKS" />
            Grāmatzīmes, vēsture un saglabātās paroles netiks ietekmētas.</translation>
<translation id="2901988969322822496">Ir sasniegts João Browser grāmatzīmju skaita ierobežojums (<ph name="BOOKMARK_LIMIT" />), tāpēc noteiktas jūsu grāmatzīmes vēl nav saglabātas jūsu Google kontā.

Jaunas grāmatzīmes nevar saglabāt jūsu kontā, kamēr neizdzēsīsiet dažas no tām. Ja izrakstīsieties tūlīt, nesaglabātās grāmatzīmes tiks dzēstas.</translation>
<translation id="6203410920314218280">Atvērt saiti inko&amp;gnito režīma logā</translation>
<translation id="6965382102122355670">Labi</translation>
<translation id="6985329841647292029">Chromium OS noteikumi</translation>
<translation id="8064285182627814996">Lai savā kontā (<ph name="ACCOUNT_EMAIL" />) izmantotu un saglabātu João Browser datus, ievadiet ieejas frāzi.</translation>
<translation id="7011190694940573312">Instalēšana neizdevās, jo šī operētājsistēmas versija netiek atbalstīta.</translation>
<translation id="7024536598735240744">Atpakošanas kļūda: <ph name="UNPACK_ERROR" />.</translation>
<translation id="181803036615530330">Pielāgojiet pārlūku João Browser savām vajadzībām</translation>
<translation id="7047386856539490735">Vai šie rezultāti ir noderīgi?</translation>
<translation id="2478245051737698828">Atjaunināt João Browser</translation>
<translation id="452909342278940733">Ja attēlam nav vērtīga apraksta, pārlūks João Browser mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam Google.</translation>
<translation id="8606769615526968368">Piekļūstiet MI iespējām, izmantojot lietotni João Browser savā ierīcē (<ph name="DEVICE_TYPE" />)</translation>
<translation id="2061960765882453684">Izmantojiet lietotni João Browser savā tālrunī, lai piekļūtu savām parolēm, cilnēm un citiem datiem, atrodoties ceļā</translation>
<translation id="7141270731789036260">Pielāgot versiju Chrome for Testing</translation>
<translation id="7147227333672430807">Varat izmantot pārlūku Chromium ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs.</translation>
<translation id="6949173677980969871">Noņemt paplašinājumu <ph name="EXTENSION_NAME" /> no pārlūka João Browser</translation>
<translation id="3556355753960287061">Jūsu organizācija dzēš João Browser datus, ja šis pārlūks <ph name="TIMEOUT_DURATION" /> netiek izmantots. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.</translation>
<translation id="8689006320829658442">Pārlūkam João Browser ir nepieciešama atļauja izmantot kameru šajā vietnē.</translation>
<translation id="7501884108538572227">Neizdevās palaist João Browser. Mēģiniet vēlreiz.</translation>
<translation id="5484563502710761706">Atvērtajā ekrānā varat jautāt jebko Gemini pārlūkā João Browser</translation>
<translation id="3823264355161086552">Paturiet pārlūku João Browser dokā, lai jebkurā laikā varētu tam ātri piekļūt.</translation>
<translation id="9153902741226700840">Izmantojiet João Browser ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs</translation>
<translation id="7216228761061470870">Kad izmantojat attēlu meklēšanu, serverim tiek nosūtīts lapas nosaukums, URL un saturs, tostarp PDF faili.</translation>
<translation id="7950844619283784703">Uzdevumu pārvaldnieks — João Browser</translation>
<translation id="133513825972536773">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā João Browser savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt saglabātajai informācijai un citiem datiem visās savās ierīcēs.</translation>
<translation id="4558982617284733740">Sāciet pārlūkošanu uzreiz: tagad pārlūks João Browser var tikt palaists, kad tiek palaista operētājsistēma Windows.</translation>
<translation id="7274695763216404502">Piesprausts! Varat atkal piekļūt funkcijai Attēlu meklēšana no rīkjoslas.</translation>
<translation id="7288567540154601580">Cilnes un paplašinājumi</translation>
<translation id="5494571279964989269">{NUM_EXTENSIONS,plural, =1{João Browser iesaka to noņemt.}zero{João Browser iesaka tos noņemt.}one{João Browser iesaka tos noņemt.}other{João Browser iesaka tos noņemt.}}</translation>
<translation id="2269053214123323740">Lai kopīgotu sistēmas audio, pārejiet uz sistēmas iestatījumiem un iespējojiet iestatījumu “Tikai sistēmas audio ierakstīšana” pārlūkam João Browser. Pēc tam jums būs jārestartē pārlūks João Browser.</translation>
<translation id="731795002583552498">Notiek Chromium atjaunināšana</translation>
<translation id="9065168747010082551">Jūsu preferenču fails ir bojāts vai nederīgs. João Browser nespēj atkopt jūsu iestatījumus.</translation>
<translation id="7324051657739063017">Varat atkārtoti atvērt kontekstuālos uzdevumus, lai uzdotu jautājumus pārlūkošanas laikā.</translation>
<translation id="4159250197688136733">Šeit atrodas jūsu tīmekļa saturs, grāmatzīmes un cits João Browser saturs.</translation>
<translation id="7347827960336370838">Jūsu šifrētos datus var lasīt tikai personas, kurām ir jūsu ieejas frāze. Ieejas frāze netiek sūtīta uzņēmumam Google, un uzņēmums Google to neuzglabā. Ja aizmirsīsiet ieejas frāzi vai vēlēsieties mainīt šo iestatījumu, jums būs <ph name="BEGIN_LINK" />jāizdzēš Chromium dati savā kontā<ph name="END_LINK" />.</translation>
<translation id="1062903713270840396">Jūsu sistēmas administrators ir konfigurējis João Browser atvērt <ph name="ALTERNATIVE_BROWSER_NAME" />, lai piekļūtu <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">Radās problēma</translation>
<translation id="5817362738974335084">Lai saņemtu turpmākus João Browser atjauninājumus, nepieciešama operētājsistēma macOS 13 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma macOS 12.</translation>
<translation id="7376384068949534168">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Chromium tika noņemtas šādas atļaujas: <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />.</translation>
<translation id="73786666777299047">Atveriet Chrome interneta veikalu</translation>
<translation id="5724625487458697703">Rādīt Gemini pārlūkā João Browser sistēmas teknē</translation>
<translation id="7401687852903179959">Meklēt šo videoklipu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="1088684725931971005">Tagad João Browser ir jūsu noklusējuma pārlūks.</translation>
<translation id="7479848806300971661">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā João Browser tiek atjaunotas jūsu cilnes ikreiz, kad to restartējat. Lai to izslēgtu, pārejiet uz lapu</translation>
<translation id="1258077876605261365">Paroļu importēšana pārlūkā João Browser</translation>
<translation id="5293062713751091377">1. Noklikšķiniet uz tālāk redzamās pogas <ph name="BUTTON_LABEL" />.
2. Windows iestatījumos noklikšķiniet uz <ph name="BUTTON_2" />.
3. Windows paziņojumā noklikšķiniet uz <ph name="BUTTON_3" />, lai piespraustu pārlūku João Browser uzdevumu joslai, tādējādi nodrošinot ātru piekļuvi.</translation>
<translation id="1941496545060769345"><ph name="PAGE_TITLE" /> — João Browser izstrādātāju versija</translation>
<translation id="7450541714075000668">Teksts ir nokopēts</translation>
<translation id="7458892263350425044">Lai izmantotu mikrofonu, piešķiriet pārlūkam Chromium piekļuvi <ph name="BEGIN_LINK" />sistēmas iestatījumos<ph name="END_LINK" />.</translation>
<translation id="5422859338435319909">Lai saņemtu turpmākus João Browser atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 7.</translation>
<translation id="7467949745582939695">Vai atkārtoti palaist Chromium?</translation>
<translation id="7707324976708178089">Nevar instalēt to pašu João Browser versiju, kas jau šobrīd darbojas. Aizveriet João Browser un mēģiniet vēlreiz.</translation>
<translation id="7510190804000607802">Atgādinājums: vislabākais Google saturs vienmēr par rokai</translation>
<translation id="751935028865900641">Vietnes, visticamāk, darbosies, kā paredzēts. Aizverot visus Chromium logus, automātiski izrakstīsieties no lielākās daļas vietņu, bet ne no Google konta, ja esat pierakstījies pārlūkā Chromium.</translation>
<translation id="5325102834460669866">{0,plural, =1{Pārlūks João Browser pēc 1 minūtes tiks restartēts}zero{Pārlūks João Browser pēc # minūtēm tiks restartēts}one{Pārlūks João Browser pēc # minūtes tiks restartēts}other{Pārlūks João Browser pēc # minūtēm tiks restartēts}}</translation>
<translation id="7565444033145385702">Lai aizsargātu savus datus, ļaujiet pārlūkā Chromium noņemt atļaujas vietnēm, ko pēdējā laikā neesat apmeklējis.</translation>
<translation id="8099958128052689767">Automātiski palaidiet pārlūku João Browser, lai uzreiz sāktu pārlūkošanu.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> instalēšanas programma</translation>
<translation id="7125257608567714221">Pārlūkā João Browser tiek izmantota jūsu kamera un mikrofons.</translation>
<translation id="227045421902171569">Pārlūkā João Browser ir veikti uzlabojumi</translation>
<translation id="5356567285381070312">Tagad pārlūkā João Browser ir pieejams vairāk funkciju.</translation>
<translation id="7624307931717240213">Mēs izmantojam informāciju, lai uzlabotu šo pakalpojumu. Skatiet konfidencialitātes politiku un pakalpojumu sniegšanas noteikumus.</translation>
<translation id="7649070708921625228">Palīdzība</translation>
<translation id="5714374331629713291">Iegūt lietotni João Browser</translation>
<translation id="7658239707568436148">Atcelt</translation>
<translation id="549378870470819535">João Browser nav jūsu noklusējuma pārlūks.</translation>
<translation id="6574348346278803862">João Browser sinhronizēšana un personalizēšana visās savās ierīcēs</translation>
<translation id="7699779824407626136">Chromium atjauninājums</translation>
<translation id="3304080024230377341">Jūsu darbs ir aizsargāts pārlūkā João Browser</translation>
<translation id="7716950018788545737">Uzdevumi ir pabeigti.</translation>
<translation id="77283119132245232">Nodrošina sistēmas izsekošanas pakalpojumus pārlūkā <ph name="BROWSER_NAME" />. Ja šis pakalpojums ir atspējots, pārlūka izveidotajos veiktspējas izsekošanas datos netiek ietverti sistēmas līmeņa notikumi, piemēram, konteksta maiņas un pavedienu gatavības notikumi.</translation>
<translation id="7745317241717453663">Veicot šo darbību, no šīs ierīces tiks dzēsti pārlūkošanas dati. Lai vēlāk izgūtu datus, pierakstieties pārlūkā Chromium kā <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Instalētājam neizdevās izveidot pagaidu katalogu. Lūdzu, pārbaudiet, vai diskā pietiek vietas un vai ir atļauja instalēt programmatūru.</translation>
<translation id="4713120944298974980">Meklēt pārlūkā João Browser</translation>
<translation id="5804390944809171853">Atiestatīt João Browser noklusējuma motīvu</translation>
<translation id="6930487390575519812">Lai aizsargātu jūsu darbu pārlūkā João Browser, jūsu organizācija varēs skatīt vai pārvaldīt noteiktu informāciju, kad būsiet pierakstījies pārlūkā João Browser.</translation>
<translation id="5214761769821670245">Iestatiet João Browser kā noklusējuma pārlūku un piespraudiet to uzdevumu joslai</translation>
<translation id="1294697217796985566">Pārlūka João Browser darbības paātrināšana</translation>
<translation id="1278345486417353853"><ph name="PAGE_TITLE" /> — João Browser Canary</translation>
<translation id="7803986347287457849">Neļaujiet personām, kurām ir piekļuve jūsu interneta datplūsmai, viegli skatīt jūsu apmeklētās vietnes. Chromium izmanto drošu savienojumu, lai meklētu vietnes IP adresi sistēmā DNS (domēnu nosaukumu sistēmā).</translation>
<translation id="7810005234485217901">Varat piespraust funkciju Attēlu meklēšana, lai ērti tai varētu piekļūt.</translation>
<translation id="489728561211958943">Šajā ierīcē jau pastāv João Browser profils ar šādu kontu.</translation>
<translation id="7845233973568007926">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME" /> izmantošanas ir jārestartē dators.</translation>
<translation id="5294768452950207882">Jūsu meklētājprogramma tika mainīta ārpus pārlūka João Browser. Lai jūs aizsargātu, pārlūkā João Browser tā tika atiestatīta uz sākotnējo noklusējuma meklētājprogrammu. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3244974069468656925">Pielāgojiet pārlūku João Browser, lai piešķirtu tam jaunu izskatu.</translation>
<translation id="7859018312476869945">Kad rakstāt adreses joslā vai meklēšanas lodziņā, pārlūks Chromium nosūta ierakstīto tekstu jūsu noklusējuma meklētājprogrammai, lai iegūtu labākus ieteikumus. Inkognito režīmā šis iestatījums ir izslēgts.</translation>
<translation id="6517519572778941051">Nevarēja atjaunināt uz jaunāko João Browser versiju, tādēļ jūs nevarēsiet piekļūt jaunākajām funkcijām un drošības labojumiem.</translation>
<translation id="7872446069773932638">Notiek lejupielāde... Atlikušais laiks: <ph name="SECONDS" /> sekunde(-es).</translation>
<translation id="7873537467422636035">Ja aizmirstat ieejas frāzi vai vēlaties mainīt šo iestatījumu, <ph name="BEGIN_LINK" />izdzēsiet Chromium datus savā kontā<ph name="END_LINK" />.</translation>
<translation id="1722038268139386345">Ātri atveriet pakalpojumu Gemini pārlūkā João Browser, kad tas ir nepieciešams.</translation>
<translation id="8344320926817290924">Iestatīt João Browser kā noklusējuma pārlūku</translation>
<translation id="7934340546140346950">Pārlūkā Chromium nedrošie savienojumi tiek automātiski jaunināti uz HTTPS, ja iespējams.</translation>
<translation id="3755057387338907970">Operētājsistēmā João Browser iepriekš pierakstījāties kā lietotājs <ph name="USER_EMAIL_ADDRESS" />. Lai pierakstītos vēlreiz, lūdzu, izmantojiet to pašu kontu.</translation>
<translation id="929903348843569380">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā João Browser savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt grāmatzīmēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="7975919845073681630">Šī ir Chromium papildu instalācija, un to nevar izmantot kā noklusējuma pārlūku.</translation>
<translation id="8905411496853397218">No nezināmiem avotiem iegūti paplašinājumi, lietotnes un motīvi var kaitēt ierīcei. João Browser komanda iesaka instalēt tos tikai no veikala <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />.</translation>
<translation id="6306672714476596428">Izmantojiet pārlūku João Browser savā ierīcē (<ph name="DEVICE_TYPE" />), lai pilnvērtīgi izmantotu Google piedāvātās iespējas</translation>
<translation id="8004582292198964060">Pārlūkprogramma</translation>
<translation id="8010081455002666927">Noteikt automātiski</translation>
<translation id="2172829664765531568">Tiklīdz pārlūkam João Browser tiks sniegta piekļuve, vietnes varēs lūgt jums piekļuvi.</translation>
<translation id="74641100973032765">Piespraudiet pārlūku João Browser uzdevumu joslai, lai jebkurā laikā varētu tam ātri piekļūt.</translation>
<translation id="80471789339884597">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME" /> izmantošanas ir jārestartē visas pārlūkprogrammas.</translation>
<translation id="8054112667659782652">Vienmēr rādīt funkcijas Attēlu meklēšana saīsni</translation>
<translation id="8069447462453318634">Atlasiet vienumu “Piespraust rīkjoslai”.</translation>
<translation id="5039671129725402518">Atspējot João Browser darbību fonā lietotnēm</translation>
<translation id="80790299200510644">Attēlu meklēšana</translation>
<translation id="8086881907087796310">Instalēšana neizdevās, jo jūsu dators neatbilst minimālajām aparatūras prasībām.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> — Google Chrome for Testing</translation>
<translation id="2430877582155731716">Pārlūkam João Browser ir nepieciešama atrašanās vietas atļauja šai vietnei.</translation>
<translation id="8298045348217323">Kad nākamreiz savā ierīcē (<ph name="DEVICE_TYPE" />) atvērsiet pārlūku João Browser, tiks parādīts aicinājums iespējot brīdinājumus par cenu izsekošanu.</translation>
<translation id="3827347991254458074">Izmantojiet lietotni João Browser savā tālrunī, lai saņemtu brīdinājumus par cenu kritumu precēm, kas jūs interesē</translation>
<translation id="8118331347066725040">Sūtiet atsauksmes par meklēšanu, izmantojot Lens</translation>
<translation id="2580039965224265556">João Browser personalizēšana</translation>
<translation id="8133124826068723441">Chromium OS nevarēja sinhronizēt jūsu datus, jo jūsu domēnā nav pieejama sinhronizācija.</translation>
<translation id="813913629614996137">Notiek inicializēšana...</translation>
<translation id="7940955011992997426">Atveriet pakalpojumu Gemini pārlūkā João Browser, izmantojot īsinājumtaustiņu.</translation>
<translation id="7560319627203819845">João Browser pakalpojumu sniegšanas papildu noteikumi</translation>
<translation id="7133741820744999589">Šis fails ir bīstams, tāpēc João Browser to bloķēja.</translation>
<translation id="8177472873527554730">Nevar atrast saturu lapā</translation>
<translation id="8200109504272824693">Lai savā kontā (<ph name="USER_EMAIL" />) izmantotu un saglabātu Chromium datus, ievadiet ieejas frāzi.</translation>
<translation id="820759916613250543">Meklēt šo attēlu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="8221491193165283816">Parasti jūs bloķējat paziņojumus. Lai ļautu šai vietnei sūtīt jums paziņojumus, noklikšķiniet šeit.</translation>
<translation id="8223363452568144035">Lai izmantotu kameru, piešķiriet pārlūkam Chromium piekļuvi <ph name="BEGIN_LINK" />sistēmas iestatījumos<ph name="END_LINK" />.</translation>
<translation id="8132864687089402359">João Browser nevar pārbaudīt šī paplašinājuma izcelsmi, un, iespējams, tas nav drošs. Noņemiet to no pārlūka João Browser, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp personas informāciju.</translation>
<translation id="7600652022483599804">Ja attēlam nav vērtīga apraksta, pārlūks João Browser mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam Google. Jebkurā brīdī iestatījumos varat izslēgt šo iespēju.</translation>
<translation id="8703735741562140394">Vai pierakstīties pārlūkā João Browser, izmantojot jaunu profilu?</translation>
<translation id="2830039647655087365">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā João Browser savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt parolēm un citiem datiem no <ph name="DEVICE" />.</translation>
<translation id="1802935470126307750">Rādīt pakalpojumu Gemini pārlūkā João Browser sistēmas teknē un ieslēgt īsinājumtaustiņu</translation>
<translation id="8286943863733751221">Pārlūkā <ph name="BEGIN_LINK" />Chromium tiek rādīti brīdinājumi<ph name="END_LINK" /> par nedrošām vietnēm un lejupielādēm</translation>
<translation id="8295827201165805317">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Chromium tika noņemta šāda atļauja: <ph name="PERMISSION" />.</translation>
<translation id="481989138594406896">Iepērcieties, tulkojiet un identificējiet redzamo saturu, izmantojot kameru iOS lietotnē João Browser.</translation>
<translation id="5242426961520127942">Kvadrātkods, lai pierakstītos pārlūkā João Browser ar kontu <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">Palaišanas kļūda: <ph name="STARTUP_ERROR" />.</translation>
<translation id="3644336211313412429">Jūsu organizācija aizver pārlūku João Browser, ja tas <ph name="TIMEOUT_DURATION" /> netiek izmantots.</translation>
<translation id="8321888067342493336">Saglabāt kā attēlu</translation>
<translation id="3150519286474936594"><ph name="USER_EMAIL_ADDRESS" /> iepriekš izmantoja João Browser</translation>
<translation id="8351551329754447960">Iespējot prasmes pārlūkā Chromium</translation>
<translation id="4566781614303801262">Lai turpinātu izmantot João Browser datus savā Google kontā (<ph name="ACCOUNT_EMAIL" />), atjauniniet pārlūku João Browser.</translation>
<translation id="8404636483124146663">Lai saņemtu turpmākus João Browser atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 8.</translation>
<translation id="8362914115861174987">Tulkot šādā valodā:</translation>
<translation id="8367705492654390392">Uzdodiet jebkādu jautājumu</translation>
<translation id="8370517070665726704">Autortiesības: <ph name="YEAR" /> Google LLC. Visas tiesības paturētas.</translation>
<translation id="8954225380790220359">Pierakstieties pārlūkā João Browser, lai varētu piekļūt parolēm un citiem datiem visās savās ierīcēs. Šī parole tiks saglabāta jūsu Google kontā pēc pierakstīšanās.</translation>
<translation id="208035402574338948">Pēc tam jums būs jārestartē pārlūks João Browser.</translation>
<translation id="7458698097055456629">João Browser iesaka to noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.</translation>
<translation id="3428558977667883100">Šī paplašinājuma publicēšanu atcēla izstrādātājs, un paplašinājums, iespējams, nav drošs. Noņemiet to no pārlūka João Browser, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="5012944467031125860">Pārlūkā João Browser ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati tiks dzēsti.</translation>
<translation id="8822543678238892300">{0,plural, =1{Restartējiet pārlūku João Browser vienas dienas laikā}zero{Restartējiet pārlūku João Browser # dienu laikā}one{Restartējiet pārlūku João Browser # dienas laikā}other{Restartējiet pārlūku João Browser # dienu laikā}}</translation>
<translation id="8438543370129609977">Kad izmantojat funkciju Attēlu meklēšana, serverim tiek nosūtīts lapas nosaukums, URL un saturs, tostarp PDF faili. <ph name="LEARN_MORE" /></translation>
<translation id="4307944272317199640">Uzzināt vairāk par meklēšanu, izmantojot attēlu meklēšanu pārlūkā João Browser</translation>
<translation id="6024135746436350583">Instalēšanas programmas arhīvs ir bojāts vai nav derīgs. Lejupielādējiet João Browser vēlreiz.</translation>
<translation id="4933173390191738516">Pārlūka João Browser izmantošanai nepieciešama operētājsistēma Windows 10 vai jaunāka versija.</translation>
<translation id="8463672209299734063">Neobligāti: palīdziet uzlabot Chromium OS funkcijas un veiktspēju, automātiski nosūtot Google serveriem diagnostikas un lietojuma datus.</translation>
<translation id="4499703930846496679">Lai izmantotu un saglabātu João Browser datus savā Google kontā, apstipriniet savu identitāti.</translation>
<translation id="8482493977473846331">Tiek rādīti aicinājumi pierakstīties pārlūkā Chromium.</translation>
<translation id="2129903037617090425">João Browser versija ir novecojusi</translation>
<translation id="850264194101621529">Paldies, ka izvēlējāties Chromium kā noklusējuma pārlūku!</translation>
<translation id="8522801943730206384">Pārlūkprogrammā Chromium var pārbaudīt jūsu paroles, ja jūs tās saglabājat.</translation>
<translation id="8525579356836940628">Instalēšana apturēta</translation>
<translation id="2445505893586445499">Izmantojiet lietotni João Browser savā ierīcē (<ph name="DEVICE_TYPE" />), lai piekļūtu savām parolēm, cilnēm un citiem datiem, atrodoties ceļā</translation>
<translation id="8548787790260785208">Saņemiet brīdinājumu, ja pārlūkā Chromium tiek konstatēts, ka kāda no jūsu parolēm ir iekļauta publiskā datu aizsardzības pārkāpumā.</translation>
<translation id="8555465886620020932">Pakalpojuma kļūda: <ph name="SERVICE_ERROR" />.</translation>
<translation id="8871890913961794658">Dažām João Browser funkcijām un paplašinājumiem ir pieejamas saīsnes. Varat izvēlēties tos atkal ieslēgt.</translation>
<translation id="8556420416730706394">Varat piespraust funkciju Attēlu meklēšana, lai ērti tai piekļūtu. Sānu paneļa augšdaļā noklikšķiniet uz pogas “Piespraust”.</translation>
<translation id="856656450041460113">Meklēt valodu sarakstā</translation>
<translation id="9044172203094901282">Pārlūku João Browser pārvalda vairākas organizācijas</translation>
<translation id="8586442755830160949">Autortiesības <ph name="YEAR" /> Chromium autori. Visas tiesības paturētas.</translation>
<translation id="8601359445272098721">Jaunums! Atlasot pogu “Tulkot ekrānu”, varat tulkot gan ekrānā redzamo tekstu, gan attēlus.</translation>
<translation id="1071663705626404814">Notiek João Browser palaišana...</translation>
<translation id="8624541899164515475">Iestatījumi; tiks atvērta jauna cilne.</translation>
<translation id="8648201657708811153">Google Chrome for Testing nevar iestatīt kā noklusējuma pārlūku.</translation>
<translation id="5975137268566279898">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku João Browser vai meklēsiet, izmantojot universālo lodziņu.</translation>
<translation id="6358904712334248114">Šis ir jūsu João Browser</translation>
<translation id="8712637175834984815">Sapratu!</translation>
<translation id="5380190167074430719">Vai pierakstīties pārlūkā João Browser?</translation>
<translation id="8747073452963259673">meklēšanas apgabala apakšējais kreisais stūris: <ph name="LEFT" />% pa kreisi, <ph name="BOTTOM" />% apakšdaļā</translation>
<translation id="878572486461146056">Instalēšanas kļūda: administrators ir piemērojis grupas politiku, kas neļauj veikt instalēšanu: <ph name="INSTALL_ERROR" />.</translation>
<translation id="8813277370772331957">Atgādināt vēlāk</translation>
<translation id="8871607387186266158">Kopīgojiet šo dokumentu ar Gemini pārlūkā João Browser, lai iegūtu īsu kopsavilkumu un uzdotu papildu jautājumus.</translation>
<translation id="3009329613270131861">Vai pierakstīties pārlūkā João Browser?</translation>
<translation id="8823401858233292222">Iestatīt Chromium kā noklusējuma pārlūku un piespraust to uzdevumu joslai</translation>
<translation id="8826492472752484139">Noklikšķiniet uz vienuma Paroļu pārvaldnieks.</translation>
<translation id="8833697763442816810">Chromium OS sistēma</translation>
<translation id="8852026904190808918">Šī valoda tiek izmantota, lai rādītu izvēlnes, iestatījumus, brīdinājumus un citu tekstu pārlūkā Chromium.</translation>
<translation id="8862326446509486874">Jums nav vajadzīgo tiesību, lai instalētu sistēmas līmenī. Mēģiniet vēlreiz palaist instalēšanas programmu kā administrators.</translation>
<translation id="6821836710312478344">Pievienot João Browser profilu</translation>
<translation id="5139769635207740615">ChromiumOS nevarēja saglabāt João Browser datus jūsu Google kontā pierakstīšanās kļūdas dēļ.</translation>
<translation id="6814613825007700341">Saskaņā ar jūsu organizācijas politiku jums ir jāpierakstās pārlūkā João Browser.</translation>
<translation id="1009831347869773172">João Browser mēģina rādīt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="690637523240192979">João Browser vairs nav jūsu noklusējuma pārlūks. Vai iestatīt João Browser par noklusējuma pārlūku?</translation>
<translation id="225046375773654931">Nevar atjaunināt João Browser</translation>
<translation id="8944232836376404813">Veicot šo darbību, tiks ieviestas tālāk norādītās izmaiņas.
          <ph name="LINE_BREAKS" />
            • Tiks atiestatīta jūsu sākumlapa, jaunas cilnes lapa, meklētājprogramma un piespraustās cilnes.
            <ph name="LINE_BREAK" />
            • Tiks atspējoti paplašinājumi.
            <ph name="LINE_BREAK" />
            • Tiks dzēsti sīkfaili un citi vietņu pagaidu dati.
            <ph name="LINE_BREAKS" />
            Grāmatzīmes, vēsture un saglabātās paroles netiks ietekmētas.</translation>
<translation id="4349474976990059197">João Browser Enterprise logotips</translation>
<translation id="3227699293368317033">Izmantojiet lietotni João Browser savā ierīcē (<ph name="DEVICE_TYPE" />), lai piekļūstu Google drošības iespējām, atrodoties ceļā</translation>
<translation id="6527164294507620103">Nevar palaist pārlūku João Browser, jo radās problēma, atverot jūsu profilu. Mēģiniet restartēt pārlūku João Browser.</translation>
<translation id="6741767563284518125">Pārvaldīt João Browser profilus</translation>
<translation id="3101491883380219087">Izmantojiet tastatūru, lai pārvietotos starp Gemini pārlūkā João Browser un atvērto cilni.</translation>
<translation id="9018218886431812662">Instalēšana pabeigta</translation>
<translation id="3370247132646333337">Lai uzlabotu João Browser drošību, mēs atspējojām tālāk norādīto paplašinājumu, kas nav norādīts vietnē <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> un, iespējams, tika pievienots, jums nezinot.</translation>
<translation id="1940116386572548863">Pierakstieties pārlūkā João Browser</translation>
<translation id="8381652653666868014">Pārlūkā João Browser šī lejupielāde tika bloķēta, jo šajā arhīva failā ir ietverti citi faili, kas, iespējams, slēpj ļaunprātīgu programmatūru</translation>
<translation id="8374335201144490555">Nevainojami sinhronizējiet savas paroles, grāmatzīmes un vēsturi visās ierīcēs. Ērti piekļūstiet zināmajām un iecienītajām funkcijām, atjauninot noklusējuma pārlūku uz João Browser. Lai nodrošinātu ātru piekļuvi, pārlūks João Browser tiks piesprausts uzdevumu joslai.</translation>
<translation id="6176486087616698123">Izmantojiet lietotni João Browser savā tālrunī, lai piekļūtu Google labākajiem MI rīkiem</translation>
<translation id="9062666675513499497">Automātiska pierakstīšanās pārlūkā Chromium, kad pierakstāties citos Google pakalpojumos</translation>
<translation id="724802823738504651">Pārlūks João Browser tika automātiski aizvērts</translation>
<translation id="2689333215784698609">João Browser versija ir novecojusi.</translation>
<translation id="8049510467237146160">{0,plural, =1{Pārlūks João Browser pēc stundas tiks restartēts}zero{Pārlūks João Browser pēc # stundām tiks restartēts}one{Pārlūks João Browser pēc # stundas tiks restartēts}other{Pārlūks João Browser pēc # stundām tiks restartēts}}</translation>
<translation id="9106236359747881194">Atlasiet tekstu, ko meklēt</translation>
<translation id="8558551666630075184">Lai saņemtu turpmākus João Browser atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 8.1.</translation>
<translation id="1194819784870407331">Atvērt saiti jaunā João Browser &amp;cilnē</translation>
<translation id="911206726377975832">Vai dzēst arī pārlūkošanas datus?</translation>
<translation id="9134482777260927479">Palīdzība mājasdarbos</translation>
<translation id="9148058034647219655">Iziet</translation>
<translation id="548951409840319583">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā João Browser var tikt atjaunotas jūsu cilnes ikreiz, kad to restartējat. Lai to ieslēgtu, pārejiet uz lapu</translation>
<translation id="7614949510548815395">Sistēmas administrators ir konfigurējis João Browser, lai vietne <ph name="TARGET_URL_HOSTNAME" /> tiktu atvērta papildu pārlūkā.</translation>
<translation id="3441698750089879771">Atkārtoti palaist, lai atjauninātu &amp;João Browser</translation>
<translation id="369689859238510548">João Browser (mDNS ienākošie savienojumi)</translation>
<translation id="8336832914816665097">Pielāgojiet pārlūku João Browser savām vajadzībām</translation>
<translation id="7698429329590050365">Iespējams, João Browser nedarbosies pareizi, jo tas vairs netiek atbalstīts operētājsistēmās Windows XP un Windows Vista.</translation>
<translation id="190261805571697214">Izmantojiet pārlūku João Browser, lai piekļūtu Google labākajām drošības funkcijām, atrodoties ceļā</translation>
<translation id="945522503751344254">Sūtīt atsauksmes</translation>
<translation id="5554799509799759090">Kas izmanto pārlūku João Browser?</translation>
<translation id="9153108844196984904">Visaugstākais João Browser drošības līmenis</translation>
<translation id="983803489796659991">Instalēšana neizdevās, jo atjauninājumu serverim nav nekādu jaukšanas datu lietojumprogrammai.</translation>
<translation id="6230710687825107323">Izmantot João Browser, nepierakstoties kontā</translation>
<translation id="985602178874221306">Chromium autori</translation>
<translation id="989970834842471429">Atlasiet jebkuru tekstu vai attēlu, lai to meklētu, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="992780518932311116">Lai izmantotu atrašanās vietas datus, piešķiriet pārlūkam Chromium piekļuvi <ph name="BEGIN_LINK" />sistēmas iestatījumos<ph name="END_LINK" />.</translation>
</translationbundle>