<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sk">
<translation id="1026101648481255140">Pokračovať v inštalácii</translation>
<translation id="1029669172902658969">Znova spustiť a aktualizovať &amp;Chromium OS</translation>
<translation id="4711726241445951349">João Browser odporúča, aby ste toto rozšírenie skontrolovali</translation>
<translation id="1042552502243217427">Keď nejaký web požiada o súkromné prednačítanie odkazov na svojej stránke, Chromium použije servery Googlu. Týmto sa pred predinštalovaným webom skryje vaša identita, ale Google sa naučí, ktoré weby sa prednačítavajú.</translation>
<translation id="1051793555070215510">Vyplňte tento minútový prieskum a pomôžte nám tak zlepšiť režim inkognito.</translation>
<translation id="1065672644894730302">Vaše predvoľby sa nedajú načítať.

Niektoré funkcie nemusia byť k dispozícii a zmeny vykonané v predvoľbách sa neuložia.</translation>
<translation id="3937976866851867994">Váš nadradený účet vypol Povolenia pre weby, aplikácie a rozšírenia v prehliadači João Browser</translation>
<translation id="8626021334348319355">Ak chcete vyhľadať konkrétnu funkciu alebo rozšírenie prehliadača João Browser, zadajte jeho skratku do panela s adresou a potom stlačte vybraný kláves klávesnice</translation>
<translation id="9157778882771986870">Prehliadač João Browser sa pokúša exportovať vaše heslá. Ak to chcete povoliť, zadajte heslo systému Windows.</translation>
<translation id="112640046208448578">Identifikujte veci alebo miesta a skopírujte či preložte text. Pri používaní vyhľadávania podľa obrázkov sa snímka obrazovky stránky sa odošle na server. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium je vaším predvoleným prehliadačom</translation>
<translation id="1131805035311359397">Ak chcete skontrolovať, či sú vaše heslá chránené pred porušením ochrany údajov a inými bezpečnostnými hrozbami, <ph name="BEGIN_LINK" />prihláste sa do prehliadača Chromium<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">Kliknite na ponuku prehliadača João Browser</translation>
<translation id="1157985233335035034">Nedávne jazyky</translation>
<translation id="1184145431117212167">Nepodarilo sa nainštalovať, pretože vaša verzia systému Windows nie je podporovaná.</translation>
<translation id="1185134272377778587">Informácie o prehliadači Chromium</translation>
<translation id="667420476518265356">Dostávajte upozornenia sledovania cien v prehliadači João Browser v telefóne</translation>
<translation id="1203500561924088507">Ďakujeme za inštaláciu. Než začnete aplikáciu <ph name="BUNDLE_NAME" /> používať, musíte reštartovať prehliadač.</translation>
<translation id="1232234696885483911">Keď otvoríte vyhľadávanie podľa obrázkov, názov stránky, webová adresa a obsah vrátane súborov PDF sa automaticky odošlú na server. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">Kým máte aktívne prihlásenie, môžete v prehliadači João Browser používať svoje heslá a ďalší obsah zo svojho účtu Google. Ak to chcete zmeniť, prejdite do sekcie Váš účet v prehliadači João Browser.</translation>
<translation id="4866003137980530528">Zobrazovať Gemini v prehliadači João Browser na paneli s ponukami Macu</translation>
<translation id="2526294198551578217">Na výber časti obrazovky na paneli Gemini v prehliadači João Browser môžete používať klávesovú skratku.</translation>
<translation id="7068536367561625920">Keď bola táto karta neaktívna, bola uvoľnená pamäť, aby João Browser zostal rýchly. Môžete nastaviť, aby bol tento web vždy vylúčený z nečinnosti.</translation>
<translation id="3669854427836618143">Prehliadač João Browser toto sťahovanie zablokoval, pretože daný súbor je nebezpečný</translation>
<translation id="126567311906253476">Keď sa budete účtom <ph name="USER_EMAIL" /> prihlasovať do služieb Googlu, ako je Gmail alebo YouTube, môžete sa ním automaticky prihlásiť aj do prehliadača Chromium</translation>
<translation id="8094399825947986050">Stiahnite si João Browser do telefónu</translation>
<translation id="1290883685122687410">Chyba nastavenia: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">Nastavte si nový profil prehliadača João Browser</translation>
<translation id="7591029065989504977">Vyskúšať s Gemini v prehliadači João Browser</translation>
<translation id="8408989583029959522">João Browser potrebuje na preskúmanie zariadení s rozhraním Bluetooth prístup k rozhraniu Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">Prihláste sa do prehliadača João Browser v telefóne</translation>
<translation id="1330562121671411446">Rozpoznať jazyk</translation>
<translation id="6026568602942276348">Odstrániť aj údaje z prehliadača João Browser (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Pripnuté! K vyhľadávaniu podľa obrázkov máte opäť prístup pomocou nového tlačidla na paneli s nástrojmi.</translation>
<translation id="1356661055722410047">Novinka! Môžete prekladať text aj obrázky na obrazovke.</translation>
<translation id="1383876407941801731">Vyhľadávanie</translation>
<translation id="5807085300679014096">Používajte aplikáciu João Browser a prehliadajte si internet kdekoľvek</translation>
<translation id="141901961143729572">Zdieľajte svoje názory</translation>
<translation id="3736947618013031173">Ak chcete zdieľať okno, povoľte prehliadaču João Browser nahrávať obrazovku v nastaveniach systému.</translation>
<translation id="1478370723027452770">Získať pomoc s verziou Chrome for Testing</translation>
<translation id="1497802159252041924">Chyba inštalácie: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Táto stránka je chránená</translation>
<translation id="4379865404970367448">Zdieľajte kartu prehliadača João Browser</translation>
<translation id="4436275659297289591">Prihlásiť sa do prehliadača João Browser</translation>
<translation id="1547469039832541117">Ukončí zvýraznenú úlohu.</translation>
<translation id="449712764049695153">Pripnúť João Browser</translation>
<translation id="1574377791422810894">Bezpečnostné nástroje prehliadača Chromium</translation>
<translation id="5480232403718129394">João Browser chce odstrániť vaše údaje Správcu hesiel. Ak to chcete povoliť, zadajte heslo systému Windows.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{Správca požaduje nové spustenie prehliadača João Browser, aby sa použila aktualizácia}=1{Správca požaduje nové spustenie prehliadača João Browser, aby sa použila aktualizácia. Vaše okno inkognito sa neotvorí.}few{Správca požaduje nové spustenie prehliadača João Browser, aby sa použila aktualizácia. Vaše # okná inkognito sa neotvoria.}many{Správca požaduje nové spustenie prehliadača João Browser, aby sa použila aktualizácia. Your # Incognito windows won't reopen.}other{Správca požaduje nové spustenie prehliadača João Browser, aby sa použila aktualizácia. Vašich # okien inkognito sa neotvorí.}}</translation>
<translation id="980976428162070137">Využívajte to najlepšie od Googlu s aplikáciou João Browser v telefóne</translation>
<translation id="1625909126243026060">Pozrite si hlavné ovládacie prvky ochrany súkromia a zabezpečenia v prehliadači Chromium</translation>
<translation id="1640672724030957280">Sťahuje sa…</translation>
<translation id="1665602916345474427">Prihlásili ste sa ako <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, členstvo. Otvoriť ponuku účtu</translation>
<translation id="1708414395296835197">Chromium môžete kedykoľvek použiť kliknutím na odkazy v správach, dokumentoch a ďalších aplikáciách. Bude pripnutý aj na paneli aplikácií.</translation>
<translation id="1709772298389099340">Poskytuje vyššie oprávnenia pre <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Budete si môcť vybrať z dostupných zariadení a zobraziť v nich obsah.</translation>
<translation id="6972087163510342335">João Browser čoskoro odstráni dáta prehliadania</translation>
<translation id="1736443181683099871">Chromium sa pokúsi inovovať navigácie na HTTPS</translation>
<translation id="3879288383593333401">Vymazanie údajov prehliadača João Browser</translation>
<translation id="656496276885630888">João Browser sa reštartuje o <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Keď HTTPS nie je k dispozícii, Chromium bude bez upozornenia používať nezabezpečené pripojenie</translation>
<translation id="1226290419185955779">Povoliť prehliadaču João Browser spustenie na pozadí</translation>
<translation id="4231366995273072370">Z dôvodu vyššej bezpečnosti prehliadača João Browser sme zakázali niektoré rozšírenia, ktoré nedodáva <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> a mohli byť pridané bez vášho vedomia.</translation>
<translation id="1822049153969905781">Kliknutím na <ph name="BEGIN_BOLD" />Áno<ph name="END_BOLD" /> v upozornení systému Windows pripnite João Browser na panel aplikácií, aby ste k nemu mali rýchly prístup.</translation>
<translation id="1321831992638405531">Preinštalovať prehliadač João Browser</translation>
<translation id="3386967202064865436">João Browser sa pokúša <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="70054449700528483">Pri ďalšom otvorení prehliadača João Browser v zariadení <ph name="DEVICE_TYPE" /> sa zobrazí výzva na používanie Správcu hesiel Google.</translation>
<translation id="1838374766361614909">Vymazať vyhľadávanie</translation>
<translation id="5807096362853316123">Ak chcete odstrániť dáta prehliadania iba z tohto zariadenia a vo svojom účte Google ich ponechať, <ph name="BEGIN_LINK" />odhláste sa z prehliadača João Browser<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">Stiahnite si João Browser do telefónu a otvárajte alebo vytvárajte nové skupiny kariet, nech ste kdekoľvek.</translation>
<translation id="185970820835152459">Svoje prihlásené účty Google môžete spravovať. Účty Google sa používajú pre prehliadač Chromium, Obchod Play, Gmail a ďalšie služby. Ak chcete pridať účet inej osoby, napríklad člena rodiny, pridajte radšej novú osobu do svojho zariadenia <ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />Ďalšie informácie<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Vyhľadávanie podľa obrázkov</translation>
<translation id="65457771685016683">Používateľ <ph name="EXISTING_USER" /> je už prihlásený. Ak chcete, aby bolo vaše prehliadanie naďalej samostatné, prihláste sa vo svojom profile do prehliadača João Browser účtom <ph name="USER_EMAIL_ADDRESS" />. Získate aj záložky a ďalšie položky zo zariadenia <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Vybrať text</translation>
<translation id="2634119629547215883">Prihlasujete sa pomocou spravovaného účtu a jeho správcovi dávate kontrolu nad vaším profilom João Browser. Vaše údaje prehliadača João Browser, ako sú aplikácie, záložky, história, heslá a iné nastavenia, sa natrvalo priradia k účtu <ph name="USER_NAME" />. Tieto údaje budete môcť odstrániť len pomocou panela Dashboard v Účtoch Google, ale nebudete ich môcť priradiť k inému účtu. Ak chcete, aby boli existujúce údaje prehliadača João Browser oddelené, môžete vytvoriť nový profil. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium šetrí batériu tým, že obmedzí aktivitu na pozadí a vizuálne efekty, napríklad plynulé posúvanie a snímkové frekvencie videa. <ph name="BEGIN_LINK" />Ďalšie informácie o šetriči energie<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">Služba João Browser Updater</translation>
<translation id="1911763535808217981">Po vypnutí tejto možnosti sa budete môcť prihlásiť do webov Googlu (napríklad do Gmailu) bez prihlásenia do prehliadača Chromium</translation>
<translation id="4037729269678342163">João Browser nereaguje. Chcete ho spustiť znova?</translation>
<translation id="7563750688920581112">Vaša organizácia (<ph name="MANAGER" />) vyžaduje, aby ste sa prihlásili do prehliadača João Browser</translation>
<translation id="193439633299369377">Aktualizácia sa použije po reštartovaní systému Chromium OS.</translation>
<translation id="7099143775283792684">Prehliadač João Browser toto sťahovanie zablokoval, pretože používatelia tento typ súboru bežne nesťahujú a môže byť nebezpečný</translation>
<translation id="1953553007165777902">Sťahuje sa… Zostávajúci čas: <ph name="MINUTE" /> min</translation>
<translation id="1966382378801805537">Chromium nedokáže určiť alebo nastaviť predvolený prehliadač</translation>
<translation id="197326043290947695">Prehliadajte s vyhľad. podľa obrázkov</translation>
<translation id="6185556991023272801">Prečo João Browser blokuje niektoré súbory, otvorí sa na novej karte</translation>
<translation id="4053636705816895911">Udržiava softvér prehliadača João Browser aktuálny. Ak je táto služba deaktivovaná alebo zastavená, softvér prehliadača João Browser sa nebude aktualizovať, čo znamená, že nedostatky zabezpečenia, ktoré sa vyskytnú, sa nebudú dať opraviť a funkcie nemusia fungovať. Táto služba sa sama odinštaluje, keď ju nebude používať žiadny softvér prehliadača João Browser.</translation>
<translation id="2008474315282236005">Táto akcia odstráni zo zariadenia jednu položku. Ak budete chcieť svoje údaje neskôr opäť načítať, prihláste sa do prehliadača Chromium ako <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Inštalácia bola neúspešná. Skúste to znova.</translation>
<translation id="2039417478970545937">Nastavenia</translation>
<translation id="2049376729098081731">Vyberte, či sa má zahrnúť história prehliadača Chromium na zaistenie prispôsobenejšieho prostredia v službách Googlu</translation>
<translation id="6768767091114123654">Je integrovaný v prehliadači João Browser, aby vám pomáhal vytvárať, ukladať a automaticky dopĺňať silné heslá. Pridajte si odkaz na jednoduchý prístup.</translation>
<translation id="3571664229232252557">Kliknite na tlačidlo Prispôsobiť João Browser na stránke na novej karte a dajte prehliadaču João Browser nový vzhľad</translation>
<translation id="4273287215573278663">Prehliadač João Browser toto sťahovanie zablokoval, pretože daný súbor je klamlivý a môže vo vašom zariadení vykonať neočakávané zmeny</translation>
<translation id="9063967192437499581">Pri ďalšom otvorení prehliadača João Browser pre iOS sa zobrazí výzva na vyskúšanie funkcie <ph name="FEATURE_NAME" />.</translation>
<translation id="8511569826706775962">Heslá a ďalšie údaje prehliadača João Browser, ktoré ste si uložili do účtu Google, budú z tohto zariadenia odstránené. Ak ich chcete opäť používať v prehliadači João Browser, znova sa prihláste.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{Vaša organizácia automaticky odstráni dáta prehliadania, keď sa João Browser nebude používať jednu minútu. Môže v nich byť zahrnutá história, automatické dopĺňanie a stiahnuté súbory. Vaše karty zostanú otvorené.}few{Vaša organizácia automaticky odstráni dáta prehliadania, keď sa João Browser nebude používať # minúty. Môže v nich byť zahrnutá história, automatické dopĺňanie a stiahnuté súbory. Vaše karty zostanú otvorené.}many{Vaša organizácia automaticky odstráni dáta prehliadania, keď sa João Browser nebude používať # minúty. Môže v nich byť zahrnutá história, automatické dopĺňanie a stiahnuté súbory. Vaše karty zostanú otvorené.}other{Vaša organizácia automaticky odstráni dáta prehliadania, keď sa João Browser nebude používať # minút. Môže v nich byť zahrnutá história, automatické dopĺňanie a stiahnuté súbory. Vaše karty zostanú otvorené.}}</translation>
<translation id="2125838419757773031">Vyberte oblasť obrazovky na vyhľadávanie</translation>
<translation id="2126108037660393668">Stiahnutý súbor sa nepodarilo overiť.</translation>
<translation id="2135919691573380097">Nahlásenie tohto webu</translation>
<translation id="2137162749895930932">Zavrieť obrazovku prekladu</translation>
<translation id="1308845716497059117">Prehliadač João Browser toto sťahovanie zablokoval, pretože daný web nepoužíva zabezpečené pripojenie a v súbore mohol niekto vykonať zmeny</translation>
<translation id="2170098639895543546">Vyberte čokoľvek na stránke</translation>
<translation id="6705844023496387932">Prispôsobiť João Browser</translation>
<translation id="2174917724755363426">Inštalácia nie je dokončená. Naozaj ju chcete zrušiť?</translation>
<translation id="7728290795259244895">João Browser – prihlásenie do siete – <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Chyba kontroly aktualizácií: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">Odstrániť účet z prehliadača João Browser</translation>
<translation id="4648870374540039667">Získajte aplikáciu João Browser a majte najlepšie nákupné nástroje vždy so sebou</translation>
<translation id="2106116820042118250">Zlepšené bezpečné prehliadanie v prehliadači João Browser pre systém iOS vám zaistí väčšiu bezpečnosť na cestách</translation>
<translation id="2210682093923538346">Nebezpečný web. Prehliadač Chromium odstránil upozornenia.</translation>
<translation id="2236949375853147973">Moja aktivita</translation>
<translation id="118764235932893741">Ak chcete mať adresy a ďalší obsah k dispozícii vo všetkých svojich zariadeniach, prihláste sa do prehliadača João Browser. Táto adresa bude uložená do vášho účtu Google, keď sa prihlásite.</translation>
<translation id="7254578863532089400">Ak počítač zdieľate s rodinou a priateľmi, môžu v prehliadači João Browser prehliadať oddelene a tiež si ho nastaviť podľa vlastných požiadaviek.</translation>
<translation id="22571759390241347">Zručnosti v prehliadači Chromium</translation>
<translation id="2283803047247799269">Prehľadať túto kartu pomocou vyhľadávania podľa obrázkov</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{João Browser odporúča pozastaviť kartu, ktorá spomaľuje váš prehliadač}few{João Browser odporúča pozastaviť karty, ktoré spomaľujú váš prehliadač}many{João Browser recommends pausing the tabs slowing your browser}other{João Browser odporúča pozastaviť karty, ktoré spomaľujú váš prehliadač}}</translation>
<translation id="2307973900865360088">Ponechať v doku</translation>
<translation id="2313870531055795960">Kontroluje webové adresy podľa zoznamu nebezpečných webov uloženého v prehliadači Chromium. Ak sa vám určitý web pokúsi ukradnúť heslo alebo stiahnete škodlivý súbor, Chromium môže tiež odoslať webové adresy vrátane častí obsahu stránky Bezpečnému prehliadaniu.</translation>
<translation id="2356070529366658676">Opýtať sa</translation>
<translation id="2359808026110333948">Pokračovať</translation>
<translation id="3800730051093461113">Rozšírenie <ph name="EXTENSION_NAME" /> žiada, aby ste sa prihlásili do prehliadača João Browser</translation>
<translation id="8758735062658446604">Deaktivovať spustenie prehliadača João Browser na pozadí pre aplikácie</translation>
<translation id="2623595027619107207">Ak chcete používať toto rozšírenie ako <ph name="USER_EMAIL_ADDRESS" />, prihláste sa do prehliadača João Browser.</translation>
<translation id="2384373936468275798">Systému Chromium OS sa nepodarilo synchronizovať vaše údaje, pretože vaše prihlasovacie údaje účtu sú zastarané.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{K 1 zariadeniu s ľudským rozhraním malo prístup jedno alebo viac rozšírení pre prehliadač João Browser}=1{K 1 zariadeniu s ľudským rozhraním má prístup jedno alebo viac rozšírení pre prehliadač João Browser}few{K # zariadeniam s ľudským rozhraním má prístup jedno alebo viac rozšírení pre prehliadač João Browser}many{# HID devices are being accessed by one or more João Browser extensions}other{K # zariadeniam s ľudským rozhraním má prístup jedno alebo viac rozšírení pre prehliadač João Browser}}</translation>
<translation id="6254788431480237503">João Browser vyžaduje pre tento web povolený prístup ku kamere aj mikrofónu</translation>
<translation id="2403703063067034158">Chyba pri spustení: momentálne je spustená iná inštancia nastavenia. Skúste to neskôr.</translation>
