<!DOCTYPE translationbundle>
<translationbundle lang="lt">
<translation id="1026101648481255140">Tęsti diegimą</translation>
<translation id="1029669172902658969">Paleisti iš naujo ir atnaujinti „&amp;Chromium“ OS</translation>
<translation id="4711726241445951349">„João Browser“ rekomenduoja peržiūrėti šį plėtinį</translation>
<translation id="1042552502243217427">Kai svetainė paprašo privačiai iš anksto įkelti nuorodas savo puslapyje, „Chromium“ naudoja „Google“ serverius. Taip slepiama jūsų tapatybė nuo iš anksto įkeltos svetainės, bet „Google“ sužino, kokios svetainės įkeliamos iš anksto.</translation>
<translation id="1051793555070215510">Padėkite mums tobulinti inkognito režimą dalyvaudami šioje vienos minutės trukmės apklausoje.</translation>
<translation id="1065672644894730302">Jūsų nuostatų negalima nuskaityti.

Kai kurios funkcijos gali būti nepasiekiamos ir nuostatų pakeitimai nebus išsaugoti.</translation>
<translation id="3937976866851867994">Vienas iš tėvų išjungė svetainių, programų ir plėtinių leidimus sistemoje „João Browser“</translation>
<translation id="8626021334348319355">Jei norite ieškoti konkrečios „João Browser“ funkcijos ar plėtinio, įveskite šaukinį adreso juostoje ir paspauskite pasirinktą klaviatūros klavišą</translation>
<translation id="571817873405657554">Rodyti paiešką naudojant „João Browser“ sistemos juostelėje ir įjungti spartųjį klavišą</translation>
<translation id="9157778882771986870">„João Browser“ nori eksportuoti jūsų slaptažodžius. Įveskite „Windows“ slaptažodį, kad tai leistumėte.</translation>
<translation id="112640046208448578">Nustatykite daiktus ar vietas ir kopijuokite arba verskite tekstą. Kai naudojate vaizdų paiešką, puslapio ekrano kopija siunčiama į serverį. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">„Chromium“ yra numatytoji naršyklė</translation>
<translation id="1131805035311359397">Jei norite patikrinti, ar slaptažodžiai apsaugoti nuo duomenų saugos pažeidimų bei kitų saugos problemų, <ph name="BEGIN_LINK" />prisijunkite prie „Chromium“<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">Spustelėkite „João Browser“ meniu</translation>
<translation id="1157985233335035034">Naujausios kalbos</translation>
<translation id="1184145431117212167">Įdiegti nepavyko, nes jūsų „Windows“ versija nepalaikoma.</translation>
<translation id="1185134272377778587">Apie „Chromium“</translation>
<translation id="667420476518265356">Gaukite kainų stebėjimo įspėjimus naudodami „João Browser“ telefone</translation>
<translation id="1203500561924088507">Dėkojame už diegimą. Turite iš naujo paleisti naršyklę, prieš naudodami „<ph name="BUNDLE_NAME" />“.</translation>
<translation id="1232234696885483911">Kai atidarysite vaizdų paiešką, puslapio pavadinimas, URL ir turinys, įskaitant PDF failus, bus automatiškai siunčiami į serverį. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">Prisijungus galima naudoti slaptažodžius ir daugiau iš „Google“ paskyros „João Browser“ įrenginyje. Jei norite tai pakeisti, eikite į skiltį „Jūsų paskyra sistemoje „João Browser“.</translation>
<translation id="4866003137980530528">Rodyti „Gemini“ naršyklėje „João Browser“ kompiuterio „Mac“ meniu juostoje</translation>
<translation id="2526294198551578217">Jei norite pasirinkti ekrano dalį sistemoje „Gemini“ naršyklėje „João Browser“, naudokite sparčiuosius klavišus.</translation>
<translation id="7068536367561625920">Kol šis skirtukas buvo neaktyvus, atmintis buvo atlaisvinta, kad „João Browser“ veiktų sparčiai. Galite pasirinkti visada išskirti šią svetainę, kad būtų aktyvi.</translation>
<translation id="3669854427836618143">„João Browser“ užblokavo šį atsisiuntimą, nes failas pavojingas</translation>
<translation id="126567311906253476">Prisijungdami prie „Google“ paslaugų, pvz., „Gmail“ ar „YouTube“, naudodami <ph name="USER_EMAIL" />, galite automatiškai prisijungti prie „Chromium“ naudodami tą pačią paskyrą</translation>
<translation id="8094399825947986050">Gaukite „João Browser“ telefone</translation>
<translation id="1290883685122687410">Sąrankos klaida: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">Nustatykite naują „João Browser“ profilį</translation>
<translation id="7591029065989504977">Išbandyti naudojant „Gemini“ naršyklėje „João Browser“</translation>
<translation id="8408989583029959522">„João Browser“ reikalinga „Bluetooth“ prieiga, kad galėtų naršyti&#32;
 „Bluetooth“ įrenginius. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">Prisijunkite prie „João Browser“ telefone</translation>
<translation id="1330562121671411446">Aptikti kalbą</translation>
<translation id="6026568602942276348">Taip pat ištrinti duomenis iš „João Browser“ (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Prisegta! Galite vėl pasiekti vaizdų paiešką naudodami naują įrankių juostos mygtuką</translation>
<translation id="1356661055722410047">Naujiena! Galite versti ir tekstą, ir vaizdus ekrane</translation>
<translation id="1383876407941801731">Ieškoti</translation>
<translation id="5807085300679014096">Naudokite „João Browser“ programą, kad galėtumėte naršyti keliaudami</translation>
<translation id="141901961143729572">Pasidalykite mintimis</translation>
<translation id="3736947618013031173">Jei norite bendrinti langą, sistemos nustatymuose leiskite įrašyti „João Browser“ ekrano vaizdą.</translation>
<translation id="1478370723027452770">Gauti pagalbos dėl „Chrome for Testing“</translation>
<translation id="1497802159252041924">Diegimo klaida: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Šis puslapis apsaugotas</translation>
<translation id="4379865404970367448">„João Browser“ skirtuko bendrinimas</translation>
<translation id="4436275659297289591">Prisijungti prie „João Browser“</translation>
<translation id="1547469039832541117">Baigiama paryškinta užduotis.</translation>
<translation id="449712764049695153">Prisegti „João Browser“</translation>
<translation id="1574377791422810894">„Chromium“ saugos įrankiai</translation>
<translation id="5480232403718129394">„João Browser“ nori ištrinti jūsų Slaptažodžių tvarkyklės duomenis. Įveskite „Windows“ slaptažodį, kad tai leistumėte.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{Administratorius reikalauja paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti naujinį}=1{Administratorius reikalauja paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti naujinį. Inkognito langas nebus atidarytas iš naujo.}one{Administratorius reikalauja paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito langas nebus atidarytas iš naujo.}few{Administratorius reikalauja paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito langai nebus atidaryti iš naujo.}many{Administratorius reikalauja paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito lango nebus atidaryta iš naujo.}other{Administratorius reikalauja paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito langų nebus atidaryta iš naujo.}}</translation>
<translation id="980976428162070137">Išnaudokite visas „Google“ galimybes, naudodami „João Browser“ programą telefone</translation>
<translation id="1625909126243026060">Peržiūrėkite pagrindinius privatumo ir saugos valdiklius naršyklėje „Chromium“</translation>
<translation id="1640672724030957280">Atsisiunčiama...</translation>
<translation id="1665602916345474427">Prisijungta kaip <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, narystė. Atidaryti paskyros meniu</translation>
<translation id="1708414395296835197">Galite naudoti „Chromium“ bet kada spustelėję nuorodas pranešimuose, dokumentuose ir kitose programose. Ji taip pat bus prisegta prie užduočių juostos.</translation>
<translation id="1709772298389099340">Suteikia „<ph name="BROWSER_NAME" />“ aukštesnio lygio privilegijas.</translation>
<translation id="1722488837206509557">Galėsite pasirinkti iš pasiekiamų įrenginių ir pateikti turinį juose.</translation>
<translation id="6972087163510342335">„João Browser“ netrukus ištrins naršymo duomenis</translation>
<translation id="1736443181683099871">„Chromium“ bandys naujovinti naršymą į HTTPS</translation>
<translation id="3879288383593333401">Išvalyti „João Browser“ duomenys</translation>
<translation id="656496276885630888">„João Browser“ bus paleista iš naujo po <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Kai HTTPS nepasiekiamas, „Chromium“ naudos nesaugų ryšį be perspėjimo</translation>
<translation id="1226290419185955779">Paleisti „João Browser“ fone</translation>
<translation id="4231366995273072370">Kad „João Browser“ padarytume saugesnę, išjungėme kai kuriuos plėtinius, kurių nėra „<ph name="IDS_EXTENSION_WEB_STORE_TITLE" />“ sąraše ir kurie galėjo būti pridėti be jūsų žinios.</translation>
<translation id="1822049153969905781">Spustelėkite mygtuką <ph name="BEGIN_BOLD" />Taip<ph name="END_BOLD" /> „Windows“ pranešime, kad prisegtumėte „João Browser“ prie užduočių juostos ir galėtumėte sparčiai ją pasiekti.</translation>
<translation id="1321831992638405531">Iš naujo įdiegti „João Browser“</translation>
<translation id="3386967202064865436">„João Browser“ bando <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="70054449700528483">Kitą kartą atidarius „João Browser“ įrenginyje „<ph name="DEVICE_TYPE" />“, bus pateiktas raginimas naudoti „Google“ slaptažodžių tvarkyklę.</translation>
<translation id="1838374766361614909">Išvalyti paiešką</translation>
<translation id="5807096362853316123">Norėdami ištrinti naršymo duomenis tik iš šio įrenginio ir palikti juos „Google“ paskyroje, <ph name="BEGIN_LINK" />atsijunkite nuo „João Browser“<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">Atsisiųskite „João Browser“ į telefoną, kad galėtumėte atidaryti arba kurti naujas skirtukų grupes keliaudami.</translation>
<translation id="185970820835152459">Galite tvarkyti „Google“ paskyras, prie kurių prisijungiate. Jūsų „Google“ paskyros naudojamos naršyklei „Chromium“, „Play“ parduotuvei, „Gmail“ ir kt. Jei norite kam nors pridėti paskyrą, pvz., šeimos grupės nariui, pridėkite naują asmenį prie „<ph name="DEVICE_TYPE" />“ įrenginio. <ph name="LINK_BEGIN" />Sužinokite daugiau<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Paieška naudojant vaizdų paiešką</translation>
<translation id="65457771685016683"><ph name="EXISTING_USER" /> jau prisijungė. Jei norite atskirti naršymą, prisijunkite prie „João Browser“ savo profilyje kaip <ph name="USER_EMAIL_ADDRESS" />. Be to, žymes ir kitus duomenis pasieksite <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Pasirinkti tekstą</translation>
<translation id="2634119629547215883">Prisijungiate su valdoma paskyra ir leidžiate jos administratoriui valdyti jūsų „João Browser“ profilį. „João Browser“ duomenys, pvz., programos, žymės, istorija, slaptažodžiai ir kiti nustatymai, bus visam laikui susieti su <ph name="USER_NAME" />. Galėsite ištrinti šiuos duomenis naudodami „Google“ paskyrų informacijos suvestinę, bet negalėsite susieti šių duomenų su kita paskyra. Galite pasirinktinai sukurti naują profilį, kad esami „João Browser“ duomenys būtų saugomi atskirai. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">„Chromium“ taupo akumuliatoriaus energiją, apribodama veiklą fone ir vaizdo efektus, pvz., tolygų slinkimą ir vaizdo įrašų kadrų dažnį. <ph name="BEGIN_LINK" />Sužinokite daugiau apie Energijos taupymo priemonę<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">„João Browser“ naujinimo priemonės paslauga</translation>
<translation id="1911763535808217981">Jei išjungsite šį nustatymą, prie „Google“ svetainių galėsite prisijungti kaip prie „Gmail“ neprisijungę prie „Chromium“</translation>
<translation id="4037729269678342163">„João Browser“ neatsako. Paleisti iš naujo dabar?</translation>
<translation id="7563750688920581112">Jūsų organizacija (<ph name="MANAGER" />) reikalauja prisijungti prie „João Browser“</translation>
<translation id="193439633299369377">Kad būtų galima pritaikyti naujinį, „Chromium“ OS reikia paleisti iš naujo.</translation>
<translation id="7099143775283792684">„João Browser“ užblokavo šį atsisiuntimą, nes šio tipo failas nėra dažnai atsisiunčiamas ir jis gali būti pavojingas</translation>
<translation id="1953553007165777902">Atsisiunčiama... Liko <ph name="MINUTE" /> min.</translation>
<translation id="1966382378801805537">„Chromium“ nepavyko aptikti arba nustatyti numatytosios naršyklės</translation>
<translation id="197326043290947695">Naršykite išmaniau su vaizdų paieška</translation>
<translation id="6185556991023272801">Sužinokite, kodėl „João Browser“ blokuoja kai kuriuos failus (atidaroma naujame skirtuke)</translation>
<translation id="4053636705816895911">Nuolat naujina „João Browser“ programinę įrangą. Išjungus arba sustabdžius šią programą „João Browser“ programinė įranga nebus naujinama. Tai reiškia, kad gali nepavykti pašalinti galimų saugos pažeidimų ir funkcijos gali neveikti. Ši programa pasišalina pati, kai „João Browser“ programinė įranga jos nenaudoja.</translation>
<translation id="2008474315282236005">Atlikus šį veiksmą iš šio įrenginio bus ištrintas 1 elementas. Jei vėliau norėsite gauti duomenis, prisijunkite prie „Chromium“ kaip <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Nepavyko įdiegti. Bandykite dar kartą.</translation>
<translation id="2039417478970545937">Nustatymai.</translation>
<translation id="2049376729098081731">Pasirinkite, ar įtraukti „Chromium“ istoriją, kad būtų teikiamos labiau suasmenintos funkcijos „Google“ paslaugose</translation>
<translation id="6768767091114123654">Integruota į „João Browser“, kad galėtumėte kurti, išsaugoti ir automatiškai užpildyti sudėtingus slaptažodžius. Pridėkite šaukinį, kad galėtumėte lengvai pasiekti.</translation>
<translation id="3571664229232252557">Spustelėkite mygtuką „Tinkinti „João Browser“ naujo skirtuko puslapyje, kad suteiktumėte „João Browser“ naują išvaizdą</translation>
<translation id="4273287215573278663">„João Browser“ užblokavo šį atsisiuntimą, nes failas yra klaidinantis ir gali atlikti nenumatytų pakeitimų įrenginyje</translation>
<translation id="9063967192437499581">Kitą kartą atidarius „João Browser iOS“ bus pateiktas raginimas išbandyti „<ph name="FEATURE_NAME" />“.</translation>
<translation id="8511569826706775962">Slaptažodžiai ir kiti „João Browser“ duomenys, kuriuos išsaugojote „Google“ paskyroje, bus pašalinti iš šio įrenginio. Jei norite juos vėl naudoti „João Browser“, vėl prisijunkite.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{Jūsų organizacija automatiškai ištrina naršymo duomenis, kai „João Browser“ nenaudojama vieną minutę. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai. Skirtukai liks atidaryti.}one{Jūsų organizacija automatiškai ištrina naršymo duomenis, kai „João Browser“ nenaudojama # minutę. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai. Skirtukai liks atidaryti.}few{Jūsų organizacija automatiškai ištrina naršymo duomenis, kai „João Browser“ nenaudojama # minutes. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai. Skirtukai liks atidaryti.}many{Jūsų organizacija automatiškai ištrina naršymo duomenis, kai „João Browser“ nenaudojama # minutės. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai. Skirtukai liks atidaryti.}other{Jūsų organizacija automatiškai ištrina naršymo duomenis, kai „João Browser“ nenaudojama # minučių. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai. Skirtukai liks atidaryti.}}</translation>
<translation id="2125838419757773031">Pasirinkite ekrano sritį, kurioje norite ieškoti</translation>
<translation id="2126108037660393668">Nepavyko patvirtinti atsisiųsto failo.</translation>
<translation id="2135919691573380097">Pranešimas apie šią svetainę</translation>
<translation id="2137162749895930932">Uždaryti vertimo ekraną</translation>
<translation id="1308845716497059117">„João Browser“ užblokavo šį atsisiuntimą, nes svetainėje nenaudojamas saugus ryšys ir failas gali būti sugadintas</translation>
<translation id="2170098639895543546">Pasirinkite bet ką puslapyje</translation>
<translation id="6705844023496387932">Tinkinti „João Browser“</translation>
<translation id="2174917724755363426">Diegimas nebaigtas. Ar tikrai norite atšaukti?</translation>
<translation id="7728290795259244895">„João Browser“ – prisijungimas prie tinklo – „<ph name="PAGE_TITLE" />“</translation>
<translation id="2190166659037789668">Naujinio patikros klaida: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">Pašalinti paskyrą iš „João Browser“</translation>
<translation id="4648870374540039667">Naudokitės geriausiais apsipirkimo įrankiais keliaudami su „João Browser“ programa</translation>
<translation id="2106116820042118250">Būkite saugesni keliaudami įjungę Sustiprintą saugų naršymą „iOS“ skirtoje „João Browser“</translation>
<translation id="2210682093923538346">Pavojinga svetainė. „Chromium“ pašalino pranešimus.</translation>
<translation id="2236949375853147973">Mano veikla</translation>
<translation id="118764235932893741">Jei norite pasiekti adresus ir kitas funkcijas visuose įrenginiuose, prisijunkite prie „João Browser“. Šis adresas bus išsaugotas jūsų „Google“ paskyroje, kai prisijungsite.</translation>
<translation id="7254578863532089400">Jei bendrinate kompiuterį, šeimos nariai ir draugai gali naršyti atskirai ir nustatyti „João Browser“ pagal savo poreikius.</translation>
<translation id="22571759390241347">Įgūdžiai naršyklėje „Chromium“</translation>
<translation id="2283803047247799269">Ieškoti šiame skirtuke naudojant vaizdų paiešką</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{„João Browser“ rekomenduoja pristabdyti skirtuką, kuris lėtina naršyklę}one{„João Browser“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}few{„João Browser“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}many{„João Browser“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}other{„João Browser“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}}</translation>
<translation id="2307973900865360088">Palikti doke</translation>
<translation id="2313870531055795960">Tikrinami URL pagal nesaugių svetainių sąrašą, saugomą naršyklėje „Chromium“. Jei svetainė bando pavogti slaptažodį ar atsisiuntėte žalingą failą, „Chromium“ taip pat gali siųsti URL, įskaitant puslapio turinio dalis, Saugaus naršymo funkcijai.</translation>
<translation id="2356070529366658676">Paklausti</translation>
<translation id="2359808026110333948">Tęskite</translation>
<translation id="3800730051093461113">Norint naudoti plėtinį „<ph name="EXTENSION_NAME" />“, reikia prisijungti prie „João Browser“</translation>
<translation id="8758735062658446604">„João Browser“ vykdymo fone programose išjungimas</translation>
<translation id="2623595027619107207">Jei norite naudoti šį plėtinį kaip <ph name="USER_EMAIL_ADDRESS" />, prisijunkite prie „João Browser“.</translation>
<translation id="2384373936468275798">„Chromium“ OS nepavyko sinchronizuoti duomenų, nes išsami paskyros prisijungimo informacija pasenusi.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{Vienas ŽSĮ įrenginys buvo pasiekiamas naudojant vieną ar daugiau „João Browser“ plėtinių}=1{Vienas ŽSĮ įrenginys pasiekiamas naudojant vieną ar daugiau „João Browser“ plėtinių}one{# ŽSĮ įrenginys pasiekiamas naudojant vieną ar daugiau „João Browser“ plėtinių}few{# ŽSĮ įrenginiai pasiekiami naudojant vieną ar daugiau „João Browser“ plėtinių}many{# ŽSĮ įrenginio pasiekiama naudojant vieną ar daugiau „João Browser“ plėtinių}other{# ŽSĮ įrenginių pasiekiama naudojant vieną ar daugiau „João Browser“ plėtinių}}</translation>
<translation id="6254788431480237503">„João Browser“ reikalingi fotoaparato ir mikrofono leidimai šioje svetainėje</translation>
<translation id="2403703063067034158">Paleisties klaida: šiuo metu vykdoma kita sąrankos kopija. Vėliau bandykite dar kartą.</translation>
<translation id="3028975423343897358">Atidarykite nuorodas naršyklėje „João Browser“ iš bet kurios programos ir palikite ją pasiekiamą užduočių juostoje</translation>
<translation id="579079006139156831">Spustelėkite mygtuką „Apibendrinti“, kad bendrintumėte šį dokumentą su „Gemini“ naršyklėje „João Browser“ ir gautumėte trumpą apžvalgą bei užduotumėte papildomų klausimų</translation>
<translation id="2440750600860946460">Naudodami <ph name="BEGIN_LINK" />„Chromium“ įrankius<ph name="END_LINK" /> galite saugiai naršyti ir valdyti situaciją</translation>
<translation id="7114471809991869757"><ph name="EXISTING_USER" /> jau prisijungė. Jei norite atskirti naršymą, prisijunkite prie „João Browser“ savo profilyje kaip <ph name="USER_EMAIL_ADDRESS" />. Be to, slaptažodžius ir kitas funkcijas pasieksite visuose įrenginiuose.</translation>
<translation id="2451727308784734061">Naudodami šaukinį galite greitai pasiekti Slaptažodžių tvarkyklę. Šaukinį galite perkelti į kompiuterio pagrindinį ekraną ar programų paleidimo priemonę.</translation>
<translation id="2709136733469807397">„João Browser“ netrukus bus uždaryta</translation>
<translation id="3652225684487279741">Naudojant „João Browser“</translation>
<translation id="2485422356828889247">Pašalinti</translation>
<translation id="2513154137948333830">Būtina paleisti iš naujo: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Pasirinkite tekstą naudodami vaizdų paiešką</translation>
<translation id="1527474262707362156">„João Browser“ bando pakeisti esamus slaptažodžius. Įveskite „Windows“ slaptažodį, kad tai leistumėte.</translation>
<translation id="6480371226914552131">„João Browser“ reikia prieigos prie saugyklos, kad būtų galima atsisiųsti failus</translation>
<translation id="6318568902186985084">„João Browser“ pagalbos priemonė</translation>
<translation id="2575822587468774919">Pasirinkite bet ką, ko norite ieškoti naudodami vaizdų paiešką</translation>
<translation id="4557210258834653476">Jei norite pasiekti slaptažodžius ir kitas funkcijas visuose įrenginiuose, prisijunkite prie „João Browser“</translation>
<translation id="1148164459654218834">Nuskaitykite QR kodą telefonu, kad atsisiųstumėte „João Browser“ ir prisijungtumėte prie „Google“ paskyros.</translation>
<translation id="235892353478111963">Toliau naudoti „João Browser“</translation>
<translation id="259935314519650377">Nepavyko talpykloje išsaugoti atsisiųstos diegimo programos. Klaida: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Sistema</translation>
<translation id="8471946631262724853">Organizacija gali peržiūrėti ir tvarkyti naršymo duomenis, pvz., žymes, istoriją ir slaptažodžius. Ji negali peržiūrėti naršymo duomenų kituose „João Browser“ profiliuose</translation>
<translation id="2870759219964376597">Patvirtinkite savo tapatybę, kad galėtumėte naudoti ir išsaugoti „João Browser“ duomenis paskyroje <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="2955972712254986678">{COUNT,plural, =0{Naudojant Papildomą apsaugą reikia paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti naujinį}=1{Naudojant Papildomą apsaugą reikia paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti naujinį. Inkognito langas nebus atidarytas iš naujo.}one{Naudojant Papildomą apsaugą reikia paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito langas nebus atidarytas iš naujo.}few{Naudojant Papildomą apsaugą reikia paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito langai nebus atidaryti iš naujo.}many{Naudojant Papildomą apsaugą reikia paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito lango nebus atidaryta iš naujo.}other{Naudojant Papildomą apsaugą reikia paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito langų nebus atidaryta iš naujo.}}</translation>
<translation id="8949462882238006192">Paleisti „João Browser“</translation>
<translation id="4224214204752803768">Diegiant įvyko operacinės sistemos klaida. Atsisiųskite „João Browser“ dar kartą.</translation>
<translation id="3141414135710372892">Jei bendrinate įrenginį, šeimos nariai ir draugai gali naršyti atskirai ir nustatyti „João Browser“ pagal savo poreikius</translation>
<translation id="8838607803339100223">Lengvai pasiekite ir naudokite „Gemini“ naršyklėje „João Browser“ įrenginyje, net jei „João Browser“ yra sumažinta.</translation>
<translation id="1679364578146271696">„João Browser“ skirtukas</translation>
<translation id="2718390899429598676">Kad būtų papildomai užtikrintas saugumas, „Chromium“ užšifruos jūsų duomenis.</translation>
<translation id="1874696651662237927">Jei norite pašalinti „Google“ paskyrą iš „João Browser“, atsijunkite</translation>
<translation id="6850669719663104304">Jei norite pasiekti slaptažodžius, žymes ir kitas funkcijas visuose įrenginiuose, prisijunkite prie „João Browser“</translation>
<translation id="2738871930057338499">Nepavyko prisijungti prie interneto. HTTP 403 uždrausta. Patikrinkite tarpinio serverio konfigūraciją.</translation>
<translation id="2753623023919742414">Spustelėkite, jei norite ieškoti</translation>
<translation id="4193420110872590792">Nustatyti „João Browser“ kaip numatytąją PDF failų žiūryklę</translation>
<translation id="6614401181366354261">Šiame plėtinyje yra kenkėjiškų programų ir jis nesaugus. Pašalinkite jį iš „João Browser“, kad jis nebematytų ir negalėtų pakeisti jūsų duomenų svetainėse, kuriose lankotės, įskaitant jūsų asmens informaciją.</translation>
<translation id="2799223571221894425">Paleisti iš naujo</translation>
<translation id="6299858290790311689">Jūsų „João Browser“</translation>
<translation id="2816462166102338036">Ieškoti šiame vaizdo įraše naudojant vaizdų paiešką</translation>
<translation id="5896458971800337862">Atraskite produktus naudodami fotoaparatą, stebėkite kainų sumažėjimus ir kt. keliaudami su „João Browser“ sistemoje „iOS“.</translation>
<translation id="2841525013647267359">Versti iš</translation>
<translation id="2846251086934905009">Diegimo klaida: diegimo programa neužbaigta. Diegimas nutrauktas.</translation>
<translation id="4357241592510111611">Pašalinti iš „João Browser“...</translation>
<translation id="2850691299438350830">Apsaugo jus naršyklėje „Chromium“ ir gali būti naudojama apsaugai kitose „Google“ programose pagerinti, kai esate prisijungę.</translation>
<translation id="2885378588091291677">Užduočių tvarkytuvė</translation>
<translation id="8887040619780090085">Apie &amp;„João Browser“</translation>
<translation id="2915996080311180594">Paleisti iš naujo vėliau</translation>
<translation id="6619708652934279502">Duomenys užšifruoti naudojant slaptafrazę. Įveskite ją, kad galėtumėte naudoti ir išsaugoti „João Browser“ duomenis „Google“ paskyroje.</translation>
<translation id="2945997411976714835">Diegimo klaida: nepavyko pradėti diegimo programos proceso.</translation>
<translation id="4566114009566397386">Greičiau prisijunkite prie svetainių naudodami „João Browser“ išsaugotus slaptažodžius sistemoje „iOS“</translation>
<translation id="562175540137901632">Jūsų organizacija tvarko „João Browser“</translation>
<translation id="2977470724722393594">„Chromium“ naujausios versijos</translation>
<translation id="2977506796191543575">Jei svetainė bando pavogti slaptažodį ar atsisiuntėte žalingą failą, „Chromium“ taip pat gali siųsti URL, įskaitant puslapio turinio dalis, Saugaus naršymo funkcijai</translation>
<translation id="1776205510657237623">Jei norite būti saugesni internete naudodami vieno iš tėvų pasirinkimus, prisijunkite prie „João Browser“</translation>
<translation id="3003694935412297923">Visos užduotys</translation>
<translation id="3374694374267805392">{count,plural, =1{„João Browser“ turi patvirtinti jūsų tapatybę, kad tam tikrus duomenis būtų galima išsaugoti „Google“ paskyroje ir naudoti visuose jūsų įrenginiuose. Jei atsijungsite dabar, šie duomenys (1 elementas) bus ištrinti.}one{„João Browser“ turi patvirtinti jūsų tapatybę, kad tam tikrus duomenis būtų galima išsaugoti „Google“ paskyroje ir naudoti visuose jūsų įrenginiuose. Jei atsijungsite dabar, šie duomenys ({count} elementas) bus ištrinti.}few{„João Browser“ turi patvirtinti jūsų tapatybę, kad tam tikrus duomenis būtų galima išsaugoti „Google“ paskyroje ir naudoti visuose jūsų įrenginiuose. Jei atsijungsite dabar, šie duomenys ({count} elementai) bus ištrinti.}many{„João Browser“ turi patvirtinti jūsų tapatybę, kad tam tikrus duomenis būtų galima išsaugoti „Google“ paskyroje ir naudoti visuose jūsų įrenginiuose. Jei atsijungsite dabar, šie duomenys ({count} elemento) bus ištrinti.}other{„João Browser“ turi patvirtinti jūsų tapatybę, kad tam tikrus duomenis būtų galima išsaugoti „Google“ paskyroje ir naudoti visuose jūsų įrenginiuose. Jei atsijungsite dabar, šie duomenys ({count} elementų) bus ištrinti.}}</translation>
<translation id="4915792193596835645">Atidarykite <ph name="URL" /> naujame „João Browser“ skirtuke.</translation>
<translation id="302551344979399011">DI naujovės, pvz., įgūdžiai, išsaugomos „Google“ paskyroje ir tvarkomos atskirai nuo „Chromium“ sinchronizavimo</translation>
<translation id="8367114375553489372">Pridedama prie „João Browser“...</translation>
<translation id="3038232873781883849">Laukiama, kol bus įdiegta...</translation>
<translation id="3045032126857188731">Vertimo kalba: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Uždaryti atsiliepimo dialogo langą</translation>
<translation id="6168172692486433600">Kiti „João Browser“ profiliai</translation>
<translation id="884929993636327">Plėtiniai yra priedai, kuriuos naudojant galima tinkinti „João Browser“. Plėtiniai padeda pritaikyti „João Browser“ pagal savo poreikius, pvz., planuoti darbus ir supaprastinti kasdienes užduotis.</translation>
<translation id="1525897524206034002">Padėkite tobulinti „João Browser“ siųsdami „Google“ strigčių ataskaitas ir <ph name="UMA_LINK" /></translation>
<translation id="2766971658743453990">Naudokitės „Google“ saugos funkcijomis keliaudami su „João Browser“ programa</translation>
<translation id="4387884830246074210">{NUM_DEVICES,plural, =0{Vienas USB įrenginys buvo pasiekiamas naudojant vieną ar daugiau „João Browser“ plėtinių}=1{Vienas USB įrenginys pasiekiamas naudojant vieną ar daugiau „João Browser“ plėtinių}one{# USB įrenginys pasiekiamas naudojant vieną ar daugiau „João Browser“ plėtinių}few{# USB įrenginiai pasiekiami naudojant vieną ar daugiau „João Browser“ plėtinių}many{# USB įrenginio pasiekiama naudojant vieną ar daugiau „João Browser“ plėtinių}other{# USB įrenginių pasiekiama naudojant vieną ar daugiau „João Browser“ plėtinių}}</translation>
<translation id="3413144813287436446">„João Browser“ istorija</translation>
<translation id="9192419056064225629">Diegimo programai nepavyko išpakuoti archyvo. Atsisiųskite „João Browser“ dar kartą.</translation>
<translation id="310459126943037700">Nepavyko užbaigti užduoties (-čių).</translation>
<translation id="3104828284009500087">Ieškokite bet ko puslapyje</translation>
<translation id="3508468328135806512">Užtikrinkite, kad slaptažodžiai, žymės ir istorija būtų tobulai sinchronizuojami įrenginiuose. Lengvai pasiekite žinomas ir mėgstamas funkcijas atnaujinę numatytąją naršyklę į „João Browser“.</translation>
<translation id="3216151988142306917">„João Browser“ naudoja jūsų mikrofoną.</translation>
<translation id="3130333203120345554">Nauja paieška</translation>
<translation id="3137969841538672700">Nuvilkite, jei norite ieškoti</translation>
<translation id="7493177208577109722">Šiam skirtukui naudojami papildomi šaltiniai. Kad padidintumėte našumą, leiskite „João Browser“ jį padaryti neaktyvų.</translation>
<translation id="7239354789967255675">Jei norite bendrinti ekraną, sistemos nustatymuose leiskite įrašyti „João Browser“ ekrano vaizdą</translation>
<translation id="4955872590603594814">Iš naujo paleisti „João Browser“</translation>
<translation id="3161522574479303604">Visos kalbos</translation>
<translation id="4697739132113629685">Atidaryti nuorodą „João Browser“ inko&amp;gnito lange</translation>
<translation id="1629247860984475766">Tinkinkite naująjį „João Browser“ profilį</translation>
<translation id="1905008150929775692">Galite toliau kalbėti naudodami DI režimą neperjungdami skirtukų. Jei norite pradėti, prisijunkite prie „João Browser“. Be to, slaptažodžius ir kitas funkcijas pasieksite visuose įrenginiuose.</translation>
<translation id="4232381420311815141">Jei norite pašalinti „Google“ paskyrą iš „João Browser“, atsijunkite nuo „João Browser“ puslapyje „Nustatymai“</translation>
<translation id="3234316605225071811">Vėliau „Chromium“ gali paklausti, ar norite naudoti išsaugotą informaciją automatiškai užpildydami formas</translation>
<translation id="6676749542734993844">„João Browser“ negali skaityti ir rašyti į duomenų katalogą:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">Keliaudami pasiimkite mėgstamiausius „Google“ DI įrankius su savimi, naudodami „João Browser“ sistemoje „iOS“.</translation>
<translation id="3286538390144397061">Paleisti iš naujo dabar</translation>
<translation id="532528773927600103">Trūksta „Google“ API raktų. Bus išjungtos kai kurios „João Browser“ funkcijos.</translation>
<translation id="3296368748942286671">Toliau vykdyti fonines programas, kai „Chromium“ uždaroma</translation>
<translation id="3313189106987092621">„Chromium“ perspės jus prieš įkeliant bet kokią svetainę, kurioje naudojamas nesaugus ryšys</translation>
<translation id="8095477191923518137">Būsite atjungti nuo daugelio svetainių, kai uždarysite visus „João Browser“ langus, išskyrus „Google“ paskyrą, jei esate prisijungę prie „João Browser“. Jei norite, kad svetainės jus prisimintų, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">viršutinis dešinysis paieškos srities kampas: dešinė – <ph name="RIGHT" /> %, viršus – <ph name="TOP" /> %</translation>
<translation id="3366305173356742781">„Chromium“ duomenys jūsų paskyroje</translation>
<translation id="3234882977104294240">Slaptažodžių naudojimas naršyklėje „João Browser“ telefone</translation>
<translation id="3387527074123400161">„Chromium“ OS</translation>
<translation id="2974199599420431595">Perjungti į esamą „João Browser“ profilį?</translation>
<translation id="3412460710772753638">Slaptažodžių tvarkyklėje šiame įrenginyje</translation>
<translation id="3438772217992559640">Ieškoti šiame skirtuke naudojant vaizdų paiešką</translation>
<translation id="8318147705317768982">Sustiprinto saugaus naršymo išplėtimas naudojant „João Browser“ telefone</translation>
<translation id="347392028839310978">„João Browser“ suasmeninimas...</translation>
<translation id="3474745554856756813">Atlikus šį veiksmą iš šio įrenginio bus ištrinti elementai (<ph name="ITEMS_COUNT" />). Jei vėliau norėsite gauti duomenis, prisijunkite prie „Chromium“ kaip <ph name="USER_EMAIL" />.</translation>
<translation id="5805833167703404998">Naudojant spartųjį klavišą <ph name="SHORTCUT" /> galima perjungti „João Browser“ profilius</translation>
<translation id="1835124883585653877">Uždarykite visus „João Browser“ langus ir bandykite dar kartą.</translation>
<translation id="7106246566966568195">Jei norite bendrinti langą, sistemos nustatymuose leiskite įrašyti „João Browser“ ekrano vaizdą</translation>
<translation id="6017005873246021363"><ph name="EXISTING_USER" /> jau prisijungė.  Jei norite atskirti naršymą, prisijunkite prie „João Browser“ savo profilyje kaip <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="1146681170626381319">QR kodas, kuriuo galite atsisiųsti „João Browser“ naršyklę mobiliuosiuose įrenginiuose</translation>
<translation id="354621070532799440">Priminimas: geriausios „Google“ saugos funkcijos jūsų kišenėje</translation>
<translation id="2488701737291439763">Jei norite bendrinti ekraną, sistemos nustatymuose leiskite įrašyti „João Browser“ ekrano vaizdą.</translation>
<translation id="3588112919289558122">Sustiprinta apsauga išjungia „JavaScript“ optimizavimą svetainėse, kurių „Chromium“ neatpažįsta</translation>
<translation id="3597003331831379823">Nepavyko vykdyti sąrankos su aukštesnio lygio privilegijomis. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">Prisijungimas prie „João Browser“</translation>
<translation id="5985252758124395804">Šio asmens naršymo duomenys bus ištrinti iš šio įrenginio. Jei norite atkurti duomenis, prisijunkite prie „João Browser“ kaip <ph name="USER_EMAIL" />.</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{Pasiekiamas naujas „João Browser“ naujinys. Jis bus pritaikytas, kai paleisite „João Browser“ iš naujo.}=1{Pasiekiamas naujas „João Browser“ naujinys. Jis bus pritaikytas, kai paleisite „João Browser“ iš naujo. Inkognito langas nebus atidarytas iš naujo.}one{Pasiekiamas naujas „João Browser“ naujinys. Jis bus pritaikytas, kai paleisite „João Browser“ iš naujo. # inkognito langas nebus atidarytas iš naujo.}few{Pasiekiamas naujas „João Browser“ naujinys. Jis bus pritaikytas, kai paleisite „João Browser“ iš naujo. # inkognito langai nebus atidaryti iš naujo.}many{Pasiekiamas naujas „João Browser“ naujinys. Jis bus pritaikytas, kai paleisite „João Browser“ iš naujo. # inkognito lango nebus atidaryta iš naujo.}other{Pasiekiamas naujas „João Browser“ naujinys. Jis bus pritaikytas, kai paleisite „João Browser“ iš naujo. # inkognito langų nebus atidaryta iš naujo.}}</translation>
<translation id="3667616615096815454">Nepavyko įdiegti, nes programa nežinoma serveriui.</translation>
<translation id="3675854891107786059">Naudokite <ph name="BEGIN_LINK" />savo slaptafrazę<ph name="END_LINK" />, kad užšifruotumėte visus „Chrome“ duomenis „Google“ paskyroje. „Google Pay“ mokėjimo metodai ir adresai nebus šifruojami. Naršymo istorija iš „Chromium“ nebus sinchronizuojama.</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{Administratorius prašo paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti šį naujinį}=1{Administratorius prašo paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti šį naujinį. Inkognito langas nebus atidarytas iš naujo.}one{Administratorius prašo paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti šį naujinį. # inkognito langas nebus atidarytas iš naujo.}few{Administratorius prašo paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti šį naujinį. # inkognito langai nebus atidaryti iš naujo.}many{Administratorius prašo paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti šį naujinį. # inkognito lango nebus atidaryta iš naujo.}other{Administratorius prašo paleisti „João Browser“ iš naujo, kad būtų galima pritaikyti šį naujinį. # inkognito langų nebus atidaryta iš naujo.}}</translation>
<translation id="4134769722455445399">Atidaryti nuorodą naujame „João Browser“ &amp;skirtuke</translation>
<translation id="3728124580182886854">Susiekite „Chromium“ ir kitas „Google“ paslaugas, kad būtų galima suasmeninti ir kitais tikslais</translation>
<translation id="3729187154190517324">Išplėskite paiešką pridėdami kelis skirtukus, failus ir įrankius mygtuku „Pridėti skirtuką ir kt.“</translation>
<translation id="655691042235349825">Tvarkyti „João Browser“ profilius</translation>
<translation id="8494798931804571569">Sužinokite, kodėl „João Browser“ blokuoja kai kuriuos atsisiuntimus</translation>
<translation id="379589255253486813">„Chromium“ praneš, jei reikės ką nors peržiūrėti</translation>
<translation id="3802055581630249637">„Chromium“ iš anksto įkelia puslapius, kuriuose galite apsilankyti, kad jie būtų sparčiau įkeliami juose lankantis</translation>
<translation id="3810973564298564668">Tvarkyti</translation>
<translation id="6945066279282141856">Jei norite naudoti išsaugotus slaptažodžius, vadovaukitės QR kodu, atsisiųskite „iOS“ skirtą „João Browser“ ir prisijunkite prie „Google“ paskyros</translation>
<translation id="3846683726093018685">**Apibendrinkite:** vienu sakiniu, ne ilgesniu nei trisdešimt žodžių, apibūdinkite pagrindinę ekrano kopijos turinio temą ir paskirtį.

          **Pasiūlykite klausimų:** sugeneruokite tris–penkis mąstyti skatinančius klausimus, kuriuos naudotojas galėtų užduoti, kad geriau suprastų ekrano kopiją, sąrašą. Šie klausimai turi apimti bent vieną, kuris konkrečiai susijęs su vaizdiniu objektu, jo dizainu ar išdėstymu.</translation>
<translation id="4996569675441627032">„<ph name="PAGE_TITLE" />“ – „João Browser“</translation>
<translation id="6008740052107737825">„João Browser“ reikalingas vietinio tinklo leidimas šioje svetainėje</translation>
<translation id="3885770153807205175">Kalbos rinkiklis</translation>
<translation id="2390004682597453662">Tinkinkite ir valdykite „João Browser“. Reikia atkreipti dėmesį – spustelėkite ir peržiūrėkite išsamią informaciją.</translation>
<translation id="8262407643678629134">Spustelėkite savo vardą, kad atidarytumėte „João Browser“ ir pradėtumėte naršyti.</translation>
<translation id="3892148308691398805">Kopijuoti tekstą</translation>
<translation id="2168201717554927204">Naudotojas (<ph name="EXISTING_USER" />) jau yra prisijungęs prie šio „João Browser“ profilio. Kad naršytumėte atskirai, „João Browser“ gali sukurti jums atskirą profilį.</translation>
<translation id="1046732460303790107">Šis plėtinys pažeidžia „Chrome“ internetinės parduotuvės politiką ir gali būti nesaugus. Pašalinkite jį iš „João Browser“, kad jis nebematytų ir negalėtų pakeisti jūsų duomenų svetainėse, kuriose lankotės, įskaitant jūsų asmens informaciją.</translation>
<translation id="3941890832296813527">Diegimo klaida: diegimo programos failo pavadinimas netinkamas arba nepalaikomas.</translation>
<translation id="3879366121647289622">„João Browser“ bando kopijuoti slaptažodžius. Įveskite „Windows“ slaptažodį, kad tai leistumėte.</translation>
<translation id="7332365758981378072">Slaptažodžiai, mokėjimo metodai ir adresai, kuriuos išsaugojote „Google“ paskyroje, bus pašalinti iš šio įrenginio. Jei norite juos vėl naudoti „João Browser“, vėl prisijunkite.</translation>
<translation id="395904275706073188">Apsaugotų puslapių negalima skaityti. Pabandykite kitą puslapį.</translation>
<translation id="3962647064319009959">Sužinokite, kaip „Chromium“ jus apsaugo</translation>
<translation id="3967822245660637423">Atsisiuntimas baigtas</translation>
<translation id="3971865010372729242">Kai vedate tekstą adreso juostoje ar paieškos laukelyje, „Chromium“ siunčia tai, ką įvedate, organizacijos paieškai, DI ir tarpininko įrankiams, kad gautų pasiūlymų.</translation>
<translation id="3975724895399328945">Apie &amp;„Google Chrome for Testing“</translation>
<translation id="3997429360543082038">Apie „Chromium“ OS</translation>
<translation id="4010059961270896984">Kai apsilankote svetainėje, „Chromium“ siunčia klaidinančią URL dalį <ph name="BEGIN_LINK" />„Google“ saugaus naršymo funkcijai<ph name="END_LINK" /> per privatumo serverį, slepiantį jūsų IP adresą. Jei svetainė atlieka ką nors įtartino, siunčiami ir visi URL bei puslapio turinio dalys.</translation>
<translation id="4016217212818346953">Būkite saugūs naudodami Slaptažodžių tvarkyklę</translation>
<translation id="4019629340646866719">„Chromium“ OS, kaip ir <ph name="BEGIN_LINK_LINUX_OSS" />„Linux“ kūrimo aplinka<ph name="END_LINK_LINUX_OSS" />, pasiekiama naudojant papildomą <ph name="BEGIN_LINK_CROS_OSS" />atvirojo šaltinio programinę įrangą<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="4022972681110646219">Išversti ekrano turinį</translation>
<translation id="4023601594785368013">Originali kalba: <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">Atidarykite nuorodas naršyklėje „João Browser“ iš bet kurios programos. Be to, kad būtų lengviau pasiekti, ji prisegama prie užduočių juostos.</translation>
<translation id="4036079820698952681">Padėkite tobulinti „Chromium“ pateikę ataskaitą apie <ph name="BEGIN_LINK" />dabartinius nustatymus<ph name="END_LINK" />.</translation>
<translation id="4050175100176540509">Naujausios versijos programoje įdiegti svarbūs saugos patobulinimai ir pasiekiamos naujos funkcijos.</translation>
<translation id="4055805654398742145">Slaptažodžių tvarkyklė</translation>
<translation id="615818333141511791">{COUNT,plural, =1{Organizacija automatiškai uždaro „João Browser“, kai nenaudojama vieną minutę. Naršymo duomenys ištrinami. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai.}one{Organizacija automatiškai uždaro „João Browser“, kai nenaudojama # minutę. Naršymo duomenys ištrinami. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai.}few{Organizacija automatiškai uždaro „João Browser“, kai nenaudojama # minutes. Naršymo duomenys ištrinami. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai.}many{Organizacija automatiškai uždaro „João Browser“, kai nenaudojama # minutės. Naršymo duomenys ištrinami. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai.}other{Organizacija automatiškai uždaro „João Browser“, kai nenaudojama # minučių. Naršymo duomenys ištrinami. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai.}}</translation>
<translation id="4118474109249235144">„Chromium“ inkognito režimas</translation>
<translation id="4122186850977583290">Eiti į puslapį „Apie „Chromium“</translation>
<translation id="9207280419664362385">Tinkinkite „João Browser“ ir suteikite naršyklei naują išvaizdą</translation>
<translation id="3719803995198923598">„C&amp;hromium“ tinkinimas</translation>
<translation id="4148957013307229264">Diegiama...</translation>
<translation id="2954462321765112214">„<ph name="PAGE_TITLE" />“ – prisijungimas prie tinklo – „João Browser“</translation>
<translation id="7812363663832111420">Atraskite puikių „João Browser“ programų, žaidimų, plėtinių ir temų.</translation>
<translation id="69200600645763018">Jei norite gauti šį plėtinį ir kt. visuose kompiuteriuose, prisijunkite prie „João Browser“</translation>
<translation id="7505863944027312744">Jei norite būti saugesni internete naudodami vieno iš tėvų pasirinkimus, perjunkite į savo „João Browser“ profilį, kuriame jau esate prisijungę kaip <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Atšaukiama...</translation>
<translation id="4224210481850767180">Diegimas atšauktas.</translation>
<translation id="8090594705972340646">Susisieti „João Browser“ duomenis su šia paskyra?</translation>
<translation id="4251772536351901305">Įspėjama apie pavojingas svetaines, net ir apie tas, apie kurias anksčiau „Google“ nežinojo, analizuojant daugiau duomenų iš svetainių, nei taikant įprastą apsaugą. Galite pasirinkti praleisti „Chromium“ įspėjimus.</translation>
<translation id="5696119579094527589">Atsijungti nuo „João Browser“</translation>
<translation id="4271805377592243930">Gaukite pagalbos dėl „Chromium“</translation>
<translation id="4281844954008187215">Paslaugų teikimo sąlygos</translation>
<translation id="1245307320228150348">Diegimas nepavyko dėl nežinomos klaidos. Jei šiuo metu veikia „João Browser“, uždarykite ir pabandykite iš naujo.</translation>
<translation id="7405356088321579627">Slaptažodžių eksportavimas iš „João Browser“</translation>
<translation id="4304713468139749426">Slaptažodžių tvarkytuvė</translation>
<translation id="4334241893986177674">Ieškoti šioje ekrano kopijoje</translation>
<translation id="5785541112027363087">Ieškokite ir užduokite klausimų iš bet kur, net kai „João Browser“ sumažinta</translation>
<translation id="212570256141568951">Paleisti „João Browser“ paleidus „Windows“</translation>
<translation id="4400772909124543403">Naujinių nėra</translation>
<translation id="7463042547966071103">Vis tiek išeiti iš „João Browser“?</translation>
<translation id="4413205837991854510">Visada rodyti vaizdų paieškos šaukinį</translation>
<translation id="4736206301215400753">„João Browser“ leidimas fone</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{„João Browser“ rekomenduoja jį pašalinti. <ph name="BEGIN_LINK" />Sužinokite daugiau apie palaikomus plėtinius<ph name="END_LINK" />}one{„João Browser“ rekomenduoja juos pašalinti <ph name="BEGIN_LINK" />Sužinokite daugiau apie palaikomus plėtinius.<ph name="END_LINK" />}few{„João Browser“ rekomenduoja juos pašalinti <ph name="BEGIN_LINK" />Sužinokite daugiau apie palaikomus plėtinius.<ph name="END_LINK" />}many{„João Browser“ rekomenduoja juos pašalinti <ph name="BEGIN_LINK" />Sužinokite daugiau apie palaikomus plėtinius.<ph name="END_LINK" />}other{„João Browser“ rekomenduoja juos pašalinti <ph name="BEGIN_LINK" />Sužinokite daugiau apie palaikomus plėtinius.<ph name="END_LINK" />}}</translation>
<translation id="5305058100936019600">Tinkinkite ir valdykite „João Browser“</translation>
<translation id="4427306783828095590">Naudojant sustiprintą apsaugą pasitelkiama papildomų priemonių sukčiavimui ir kenkėjiškoms programoms užblokuoti</translation>
<translation id="4434353761996769206">Diegimo programos klaida: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3461955321878243607">„<ph name="MANAGER" />“ tvarko „João Browser“</translation>
<translation id="3379477508903866078">Pridėti „João Browser“ profilį</translation>
<translation id="4447409407328223819">Apie „Chrome for Testing“</translation>
<translation id="4074057296993529937">Jei norite naudoti ir išsaugoti „João Browser“ duomenis „Google“ paskyroje, įveskite slaptafrazę</translation>
<translation id="4493028449971051158">Paleisties klaida: diegimo programą paleiskite kaip administratorius.</translation>
<translation id="4501471624619070934">Diegimas nepavyko, nes šioje šalyje prieiga ribojama.</translation>
<translation id="8624811527667906941">Šis plėtinys nepaskelbė privatumo praktikos, pvz., kaip renka ir naudoja duomenis. „João Browser“ rekomenduoja jį pašalinti.</translation>
<translation id="5571435860030744559">Sveiki, tai – „João Browser“; atidarytas naujas naršyklės langas</translation>
<translation id="8132016625974854930">„João Browser“ reikia leidimo susieti jūsų aplinką ir stebėti jūsų rankas</translation>
<translation id="6599071882590417739">Jau esate prisijungę kaip <ph name="USER_EMAIL_ADDRESS" /> kitame „João Browser“ profilyje</translation>
<translation id="4548534452171747496">„Chromium“ iš anksto įkelia puslapius, kad būtų galima sparčiau naršyti ir ieškoti. <ph name="BEGIN_LINK" />Sužinokite daugiau apie išankstinį puslapių įkėlimą<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Praneškite apie svetainę, kuri, jūsų manymu, yra žalinga, ir padėkite pagerinti visų naudotojų saugą internete.</translation>
<translation id="202208802191333704">„João Browser“ užblokavo šį atsisiuntimą, nes išjungėte Saugaus naršymo funkciją ir failo nepavyko patvirtinti</translation>
<translation id="3128308674776200516">Galimybė išbandyti „Google Lens“ naudojant „João Browser“ telefone</translation>
<translation id="4594305310729380060">Slaptažodžių tvarkyklei šiame įrenginyje</translation>
<translation id="7653380076752216509">„João Browser“ programos</translation>
<translation id="4598116752460667024">Ieškokite bet kurio proceso iš sąrašo.</translation>
<translation id="4613863813562375431">„Chromium“ OS versija</translation>
<translation id="4621240073146040695">Beveik atnaujinta! Paleiskite „Chromium“ iš naujo, kad būtų užbaigtas naujinimas.</translation>
<translation id="1497446027991908251">Paspartina svetaines naudojant „João Browser“ V8 variklį, bet daro „João Browser“ šiek tiek mažiau atsparią atakoms</translation>
<translation id="7523749920868634278">Įspėjimas: „João Browser“ negali neleisti plėtiniams įrašyti naršymo istorijos. Jei norite neleisti šio plėtinio inkognito režimu, atšaukite šios parinkties pasirinkimą.</translation>
<translation id="4673151026126227699">Jei taip pat bendrinate „Chromium“ naudojimo ataskaitas, į tas ataskaitas įtraukiami URL, kuriais lankėtės</translation>
<translation id="4673710618874938871">Prisijungta kaip <ph name="USER_NAME" />, narystė. Atidaryti paskyros meniu</translation>
<translation id="6608258642372806522">Atrodo, kad profilį naudoja kitas „João Browser“ procesas (<ph name="PROCESS_ID" />) kitame kompiuteryje (<ph name="HOST_NAME" />). „João Browser“ užrakino profilį, kad jis nebūtų sugadintas. Jei esate tikri, kad jokie kiti procesai nenaudoja šio profilio, galite atrakinti profilį ir iš naujo paleisti „João Browser“.</translation>
<translation id="4680828127924988555">Atšaukti diegimą</translation>
<translation id="3912572071294857936">Kai kurie „João Browser“ duomenys dar neišsaugoti „Google“ paskyroje. Pabandykite palaukti kelias minutes prieš atsijungdami. Jei atsijungsite dabar, šie duomenys bus ištrinti.</translation>
<translation id="1077152188344040592">Kai esate prisijungę, galite naudoti slaptažodžius ir daugiau iš „Google“ paskyros „João Browser“ įrenginyje. Paspaudę <ph name="SHORTCUT" /> galite pakeisti „Google“ paslaugų nustatymus.</translation>
<translation id="5729536702149847030">Kažkas anksčiau prisijungė prie „João Browser“ šiame kompiuteryje kaip <ph name="ACCOUNT_EMAIL_LAST" />. Sukurkite naują „João Browser“ naudotoją, kad apsaugotumėte savo informaciją.</translation>
<translation id="4724676981607797757">Įdiegti nepavyko dėl nepalaikomo protokolo klaidos.</translation>
<translation id="6273241729694500032">Vis tiek išeiti iš „João Browser“?</translation>
<translation id="3239680024825449390">Ką tik pritaikytas specialus „João Browser“ skirtas saugos naujinys. Paleiskite naršyklę iš naujo ir atkursime visus skirtukus.</translation>
<translation id="4771701986670315895">Pastaruoju metu nesilankėte. „Chromium“ pašalino <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> ir dar <ph name="COUNT" />.</translation>
<translation id="1908292729364083164">Jei „Gemini“ naršyklėje „João Browser“ atidarytas, kuriant naujus skirtukus šoninis skydelis lieka atidarytas</translation>
<translation id="479167709087336770">Naudojamas tas pats rašybos tikrinimas kaip ir „Google“ paieškoje. Tekstas, kurį įvedate naršyklėje, nusiunčiamas „Google“. Šį veikimą visada galite pakeisti nustatymuose.</translation>
<translation id="189382710647501724">Naudoti „João Browser“ be paskyros</translation>
<translation id="4456919965836032212">„João Browser“ skirta taisyklė, pagal kurią leidžiamas mDNS srautas.</translation>
<translation id="3486986778673504636">Paleisti iš naujo atnaujinant „&amp;João Browser“</translation>
<translation id="4918086044614829423">Priimti</translation>
<translation id="4918844574251943176">Vaizdas nukopijuotas</translation>
<translation id="1571932028747131277">„João Browser“ veikia fono režimu.</translation>
<translation id="7612124006067933008">Spustelėkite, kad uždarytumėte „João Browser“ prisijungimo dialogo langą</translation>
<translation id="2598788273876744576">Naudodami „João Browser“ profilius galite atskirti visus savo „João Browser“ duomenis. Sukurkite profilius draugams ir šeimos nariams arba atskirkite darbą ir pramogas.</translation>
<translation id="2115498792600385171">Svečiai gali naudoti „João Browser“ nepalikdami jokių duomenų.</translation>
<translation id="6870732303439257966">Jūsų paskyra naršyklėje „João Browser“</translation>
<translation id="4366792189726044065">Pridėkite save prie „João Browser“</translation>
<translation id="504699503110800016">Atidarykite perpildymo meniu</translation>
<translation id="4340125167559705618">Pasiekite visus mėgstamiausius „Google“ produktus naudodami „João Browser“ įrenginyje „<ph name="DEVICE_TYPE" />“</translation>
<translation id="4916697359431064123">„João Browser“ reikalingas leidimas stebėti jūsų rankas</translation>
<translation id="5141988424377517949">Pastaruoju metu nesilankėte. „Chromium“ pašalino <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />.</translation>
<translation id="5174969993834422967">Įprastai blokuojate pranešimus. Jei norite leisti šiai svetainei siųsti pranešimus, spustelėkite pranešimo piktogramą vietos juostos dešiniajame kampe.</translation>
<translation id="5174983315706567306">Nepakanka vietos diske.</translation>
<translation id="961070648267203077">Reikia iš naujo autentifikuoti „João Browser“ paskyrą</translation>
<translation id="69363826605946518">Tęskite ten, kur baigėte, naudodami „João Browser“ sistemoje „iOS“.</translation>
<translation id="471694954923709047">Atsijungimas nuo „João Browser“</translation>
<translation id="5234764350956374838">Atsisakyti</translation>
<translation id="5782956358171235578">Atidaryti nuorodą „João Browser“ inko&amp;gnito lange</translation>
<translation id="903712329052383264">Gaukite „João Browser“ programą, kad galėtumėte išsaugoti slaptažodžius keliaudami</translation>
<translation id="5277894862589591112">Norėdami pritaikyti pakeitimus, paleiskite „Chromium“ iš naujo</translation>
<translation id="5286907366254680517">Aptikta</translation>
<translation id="5593827909938092728">Gauti „João Browser“ programą</translation>
<translation id="5294316920224716406">Kai naršysite inkognito režimu, „Chromium“ perspės jus prieš įkeliant svetainę, kurioje naudojamas nesaugus ryšys</translation>
<translation id="6915803918427878418">Paieška naudojant „João Browser“</translation>
<translation id="1066981078513393795">„João Browser“ naujinimo priemonės vidinė paslauga</translation>
<translation id="5324450571874973775">Naudokite juos kartu su kitomis „Gemini“ funkcijomis naršyklėje „Chromium“</translation>
<translation id="5346389065299425353">Išplėskite paiešką pridėdami kelis skirtukus, failus ir įrankius</translation>
<translation id="1884203704972162365">Gaukite trumpą šio dokumento apžvalgą ir užduokite klausimų naudodami „Gemini“ naršyklėje „João Browser“</translation>
<translation id="5352264705793813212">„Chromium“ rado kelias saugos rekomendacijas, kurias reikia peržiūrėti</translation>
<translation id="4819697639570429319">Kiti „João Browser“ profiliai</translation>
<translation id="7878591304929138776">„ChromiumOS“ nepavyko išsaugoti „João Browser“ duomenų „Google“ paskyroje, nes išsami paskyros prisijungimo informacija pasenusi</translation>
<translation id="5249614051186670898">Prisijungiate su valdoma paskyra ir leidžiate jos administratoriui valdyti jūsų „João Browser“ profilį. „João Browser“ duomenys, pvz., programos, žymės, istorija, slaptažodžiai ir kiti nustatymai, bus visam laikui susieti su <ph name="USER_NAME" />. Galėsite ištrinti šiuos duomenis naudodami „Google“ paskyrų informacijos suvestinę, bet negalėsite susieti šių duomenų su kita paskyra. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Papildomas kodas: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Jei norite naudoti suasmeninimo funkciją, įtraukite „Chromium“ į Žiniatinklio ir programų veiklą</translation>
<translation id="108952623091824942">Sužinokite, kodėl „João Browser“ blokuoja kai kuriuos failus</translation>
<translation id="5386450000063123300">Atnaujinama „Chromium“ (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Leisti „Chromium“ prisijungti</translation>
<translation id="1265086181910844216">Pašalinti iš „João Browser“</translation>
<translation id="1500700851187484222">Sumažinamas našumas, bet „João Browser“ tampa atsparesnė atakoms</translation>
<translation id="6665657403278704382">Nustatyti „João Browser“ kaip numatytąją naršyklę</translation>
<translation id="3520901681432894293">„<ph name="PAGE_TITLE" />“ – „João Browser Beta“</translation>
<translation id="5994273394215159270">{NUM_TABS,plural, =1{„João Browser“ rekomenduoja pristabdyti skirtuką, kuris lėtina naršyklę}one{„João Browser“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}few{„João Browser“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}many{„João Browser“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}other{„João Browser“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}}</translation>
<translation id="646791423998269453">„João Browser“ gali tinkamai neveikti, nes ji nebepalaikoma naudojant šią „Linux“ versiją</translation>
<translation id="7249139852479053716">„João Browser“ užblokavo šį atsisiuntimą, nes failas gali pakenkti asmeninėms ir socialinių tinklų paskyroms</translation>
<translation id="478612683981218420">Palaukite, kol „João Browser“ įdiegs naujausius sistemos naujinius.</translation>
<translation id="3466187211963597724">„João Browser“ bando redaguoti slaptažodžius. Įveskite „Windows“ slaptažodį, kad tai leistumėte.</translation>
<translation id="3133978491361824131">Sklandžiai dirbkite mėgstamiausiomis programomis, pvz., „Google“ disku ir „YouTube“, keliaudami su „João Browser“.</translation>
<translation id="5524890928877629608">viršutinis kairysis paieškos srities kampas: kairė – <ph name="LEFT" /> %, viršus – <ph name="TOP" /> %</translation>
<translation id="5527463683072221100">Atidaryti PDF failus naudojant „Chromium“</translation>
<translation id="5536164441519929134">Klauskite<ph name="LINE_BREAK" />apie šį skirtuką</translation>
<translation id="3902123582863904748">Siekiant užtikrinti saugą, „João Browser“ išjungia „JavaScript“ optimizavimą, kai pirmą kartą apsilankote svetainėje.

Jei šis puslapis neveikia taip, kaip tikimasi, pabandykite leisti naudoti optimizavimą.</translation>
<translation id="5924481826213021755">Rodyti „Gemini“ naršyklėje „João Browser“ kompiuterio „Mac“ meniu juostoje ir įjungti sparčiuosius klavišus</translation>
<translation id="4988760628116707723"><ph name="EXISTING_USER" /> jau prisijungė. Jei norite atskirti naršymą, prisijunkite prie „João Browser“ savo profilyje kaip <ph name="USER_EMAIL_ADDRESS" />. Be to, išsaugotą informaciją ir kitas funkcijas pasieksite iš <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">Paleisties klaida: diegimo programą paleiskite kaip įprastas naudotojas, o ne administratorius.</translation>
<translation id="697769674160644707">„João Browser“ naudojimas pagal numatytuosius nustatymus ir jos prisegimas</translation>
<translation id="5596627076506792578">Daugiau parinkčių</translation>
<translation id="5605834417512968703">Pasirinkite bet ką, ko norite ieškoti naudodami vaizdų paiešką, arba paspauskite „Escape“, kad išeitumėte iš vaizdų paieškos</translation>
<translation id="5618818588972826921">Pasirinkite bet kokį tekstą arba vaizdą, kad galėtumėte ieškoti naudodami vaizdų paiešką, arba paspauskite „Escape“, kad išeitumėte iš vaizdų paieškos</translation>
<translation id="2497422928854452258">{0,plural, =0{Pasiekiamas „João Browser“ naujinys}=1{Pasiekiamas „João Browser“ naujinys}one{„João Browser“ naujinys pasiekiamas # dieną}few{„João Browser“ naujinys pasiekiamas # dienas}many{„João Browser“ naujinys pasiekiamas # dienos}other{„João Browser“ naujinys pasiekiamas # dienų}}</translation>
<translation id="5643865575100044307">Visada ištrinti svetainių duomenis iš įrenginio uždarius „Chromium“</translation>
<translation id="620465883043431255">Dabar iš naujo paleiskite „João Browser“</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Pateikti „Chromium“ šia kalba</translation>
<translation id="569897634095159764">Nepavyko prisijungti prie interneto. Reikalingas tarpinio serverio autentifikavimas.</translation>
<translation id="5768371961535086509">„Chromium“ atlaisvina atminties iš neaktyvių skirtukų. Taip aktyviems skirtukams ir kitoms programoms suteikiama daugiau kompiuterio išteklių ir „Chromium“ veikia sparčiai. Neaktyvūs skirtukai automatiškai vėl tampa aktyvūs, kai grįžtate į juos. <ph name="BEGIN_LINK" />Sužinokite daugiau apie Atminties taupymo priemonę<ph name="END_LINK" /></translation>
<translation id="8866372822266732235">Jei pamiršote slaptafrazę ar norite pakeisti šį nustatymą, <ph name="SETTINGS_LINK" /> „João Browser“ duomenis paskyroje.</translation>
<translation id="2106070764285625641">Tinkinkite ir valdykite „João Browser“. Nustatykite „João Browser“ kaip numatytąją naršyklę.</translation>
<translation id="9077878413488413377">Užtikrinkite, kad slaptažodžiai, žymės ir istorija būtų tobulai sinchronizuojami įrenginiuose, nustatę „João Browser“ kaip numatytąją naršyklę.</translation>
<translation id="5809516625706423866">Nepavyko prisijungti prie interneto. HTTP 401 nesuteikta prieigos teisė. Patikrinkite tarpinio serverio konfigūraciją.</translation>
<translation id="614221876503883218">Paspartina svetaines naudojant „João Browser“ V8 variklį, bet daro „João Browser“ šiek tiek mažiau atsparią atakoms. Šis nustatymas išjungtas.</translation>
<translation id="8788365803279840995">Jei norite naudoti ir išsaugoti „João Browser“ duomenis „Google“ paskyroje, atnaujinkite „João Browser“</translation>
<translation id="5824893331272123205">Nepavyko įkelti šio skydelio, bandykite dar kartą</translation>
<translation id="5805760187441013922">Sveiki, tai „João Browser“</translation>
<translation id="5867606647614813312">Įjungiamos papildomos funkcijos, kad būtų užtikrinta patikimiausia „Chromium“ apsauga</translation>
<translation id="5871205389137001634">Spustelėkite, kad išeitumėte iš vaizdų paieškos</translation>
<translation id="8367098380158627809">„João Browser“ aptiko kenkėjišką programą šiuose elementuose:</translation>
<translation id="5889361821821684993">„Chromium“ reguliariai tikrina, ar naršyklės nustatymai yra saugiausi. Pranešime, jei reikės ką nors peržiūrėti.</translation>
<translation id="5895138241574237353">Paleisti iš naujo</translation>
<translation id="5903106910045431592">„<ph name="PAGE_TITLE" />“ – prisijungimas prie tinklo</translation>
<translation id="5924017743176219022">Prisijungiama prie interneto...</translation>
<translation id="7627350220326904504">Paruoškime „João Browser“</translation>
<translation id="5941711191222866238">Sumažinti</translation>
<translation id="8680863040348007215">Jei norite pasiekti šią žymę ir kt. visuose įrenginiuose, prisijunkite prie „João Browser“</translation>
<translation id="2008232276062354182">„João Browser“ suasmeninimas</translation>
<translation id="5960071705175224773">Nustatymus pakeitė nežinoma programa</translation>
<translation id="5977420883993828287">Prisegta! Vėl naudokite kontekstines užduotis iš įrankių juostos</translation>
<translation id="5889362640603897718">{COUNT,plural, =1{Organizacija automatiškai uždaro „João Browser“, kai nenaudojama vieną minutę.}one{Organizacija automatiškai uždaro „João Browser“, kai nenaudojama # minutę.}few{Organizacija automatiškai uždaro „João Browser“, kai nenaudojama # minutes.}many{Organizacija automatiškai uždaro „João Browser“, kai nenaudojama # minutės.}other{Organizacija automatiškai uždaro „João Browser“, kai nenaudojama # minučių.}}</translation>
<translation id="4971097497342057998">Atnaujinkite „João Browser“, kad galėtumėte pradėti sinchronizuoti</translation>
<translation id="5990360079535151574">Naudodami įrankių juostos mygtuką „Kontekstinės užduotys“ galite iš naujo atidaryti kontekstines užduotis, kad galėtumėte užduoti klausimų, kol naršote</translation>
<translation id="6003112304606738118">Atsisiunčiama… Liko <ph name="HOURS" /> val.</translation>
<translation id="6009821354356307391">Pateikti papildomą paieškos užklausą</translation>
<translation id="6040143037577758943">Uždaryti</translation>
<translation id="2100398097168307292">Išnaudokite daugiau apsipirkimo internetu galimybių su „João Browser“ programa įrenginyje „<ph name="DEVICE_TYPE" />“</translation>
<translation id="6058380562449900225">Kad apsaugotumėte duomenis, leiskite „Chromium“ pašalinti svetainių, kuriose pastaruoju metu nesilankėte, leidimus. Pranešimai nesustabdomi.</translation>
<translation id="4735359759698689867">&amp;Atidaryti naudojant „João Browser“</translation>
<translation id="6069027071882229820">Kopijuoti kaip vaizdą</translation>
<translation id="2274675514456642321">„<ph name="EXTENSION_NAME" />“ pridėtas prie „João Browser“</translation>
<translation id="147381942282490529">Tinkinkite ir valdykite „João Browser“. Pasiekiamas naujinys.</translation>
<translation id="8775234022739879423">Įjungta • „João Browser“ nepavyko patvirtinti, iš kur gaunamas šis plėtinys</translation>
<translation id="6634821567165410381">Jūsų paskyra naršyklėje „João Browser“</translation>
<translation id="4398707227122702993">Leisti plėtiniui rodyti prieigos užklausas „João Browser“ įrankių juostoje</translation>
<translation id="5370941509199989624">Failas „<ph name="FILE_NAME" />“ pavojingas, todėl „João Browser“ jį užblokavo.</translation>
<translation id="5119118887583954582">„João Browser“ netrukus bus uždaryta ir ištrins duomenis</translation>
<translation id="576637711620229618">Čia galite perjungti „João Browser“ profilius</translation>
<translation id="615103374448673771">Jei leisite slapukus, „Chromium“ gali naudoti juos iš anksto įkeldama puslapius</translation>
<translation id="6165508094623778733">Sužinokite daugiau</translation>
<translation id="3738215896821824918">Išvalyti „João Browser“ duomenis paskyroje</translation>
<translation id="2145111683361496197">Šis failas gali būti pavojingas<ph name="LINE_BREAK" />„João Browser“ gali patikrinti šį atsisiuntimą už jus, jei pateiksite slaptažodį. Informacija apie failą siunčiama „Google“ saugaus naršymo paslaugai, bet failo turinys ir slaptažodis lieka įrenginyje.</translation>
<translation id="6182736845697986886">Įdiegti nepavyko dėl vidinės atnaujinimo serverio klaidos.</translation>
<translation id="6050294746023477088">Įsitikinkite, kad esate prisijungę prie „João Browser“ naudodami „<ph name="TARGET_DEVICE_NAME" />“, ir bandykite siųsti iš naujo.</translation>
<translation id="3395167674702947885">Šiame kompiuteryje jau yra naujesnės versijos „João Browser“. Jei programinė įranga neveikia, pašalinkite „João Browser“ ir bandykite dar kartą.</translation>
<translation id="4384214545531685923">{0,plural, =0{„João Browser“ bus paleista iš naujo dabar}=1{„João Browser“ bus paleista iš naujo po 1 sekundės}one{„João Browser“ bus paleista iš naujo po # sekundės}few{„João Browser“ bus paleista iš naujo po # sekundžių}many{„João Browser“ bus paleista iš naujo po # sekundės}other{„João Browser“ bus paleista iš naujo po # sekundžių}}</translation>
<translation id="5880255774989397049">„João Browser“ reikia prieigos prie saugyklos, kad būtų galima atsisiųsti failus</translation>
<translation id="6245734527075554892">Tikrinami URL pagal nesaugių svetainių sąrašą, saugomą naršyklėje „Chromium“</translation>
<translation id="1959823478027154444">Padaryti „João Browser“ numatytąja naršykle</translation>
<translation id="6248988683584659830">Ieškoti nustatymų</translation>
<translation id="9191635841540101343">Gaukite geriausias „Google“ saugos funkcijas keliaudami, naudodami „João Browser“ programą telefone</translation>
<translation id="538350741885862188">Atsijungti nuo „João Browser“?</translation>
<translation id="161121067714522736">Šie skirtukai naudoja papildomus šaltinius. Kad padidintumėte našumą, leiskite „João Browser“ juos padaryti neaktyvius.</translation>
<translation id="2095090272560293574">Tinkinti „João Browser“ profilį</translation>
<translation id="6290827346642914212">Pavadinkite „Chromium“ profilį</translation>
<translation id="6472525517562723285">Norint naudoti plėtinį, reikia prisijungti prie „João Browser“</translation>
<translation id="2069878195899746465">Failas „<ph name="FILE_NAME" />“ gali būti pavojingas, todėl „João Browser“ jį užblokavo.</translation>
<translation id="1283909912629029170">„João Browser“ naudoja jūsų fotoaparatą.</translation>
<translation id="323902744000752306">Vykdoma kita „João Browser“ operacija. Vėliau bandykite dar kartą.</translation>
<translation id="1292164882596462877">Dabar galite lengviau naudoti „João Browser“ naudodami „Google“ paskyrą ir bendrinamus kompiuterius.</translation>
<translation id="6411450594978516531">Lengvai pasiekite žinomas, mėgstamas ir patikimas funkcijas nustatę „João Browser“ kaip numatytąją naršyklę.</translation>
<translation id="3344301749774719950">„João Browser“ spartusis klavišas</translation>
<translation id="8395825163097750991">„João Browser“ užblokavo šį atsisiuntimą, nes failas nėra dažnai atsisiunčiamas ir jis gali būti pavojingas</translation>
<translation id="7683737657427846440">Ar tikrai norite pašalinti „João Browser"?</translation>
<translation id="6375219077595103062">Šaukinio pridėjimas prie Slaptažodžių tvarkyklės</translation>
<translation id="6388799252195623474">padėkite man tai padaryti</translation>
<translation id="6966523531135953867">Jei norite tęsti, prisijunkite prie „João Browser“ kaip <ph name="EMAIL" />. Taip užtikrinama, kad būtų laikomasi organizacijos politikos.</translation>
<translation id="5146608242127807773">„João Browser“ logotipas kompiuterio ekrane.</translation>
<translation id="6361476216650509195">„João Browser“ – tai žiniatinklio naršyklė, kurią naudojant akimirksniu paleidžiami tinklalapiai ir programos. Ji greita, stabili ir lengvai naudojama. Saugiau naršykite žiniatinklį naudodami į „João Browser“ integruotą apsaugą nuo kenkėjiškų programų ir sukčiavimo.</translation>
<translation id="7864687914956920860">Kad užtikrintumėte, jog visada galėsite naudoti ir išsaugoti „João Browser“ duomenis „Google“ paskyroje, patvirtinkite savo tapatybę</translation>
<translation id="1160920197193662978">„Chrome“ veikia sparčiau, o „JavaScript“ naudojančios funkcijos turėtų veikti, kaip numatyta (rekomenduojama)</translation>
<translation id="6436260184216827876">Vaizdų paieška nepasiekiama. Bandykite dar kartą vėliau.</translation>
<translation id="6442900851116057561">„Chromium“ OS paleidimas iš naujo</translation>
<translation id="6443470774889161065">„Chromium“ iš anksto įkelia dar daugiau puslapių, kuriuose galite apsilankyti, kad jie būtų sparčiau įkeliami juose lankantis</translation>
<translation id="3730564967922511625">Atsisiųskite „João Browser“ į telefoną, kad galėtumėte stebėti kainas ir gauti įspėjimus, kai kaina sumažės bet kurioje svetainėje</translation>
<translation id="3753019081686930624">Išjungta • „João Browser“ nepavyko patvirtinti, iš kur gaunamas šis plėtinys</translation>
<translation id="5444641426058108434">Sveiki, tai – „João Browser“ profiliai</translation>
<translation id="5103470775766355478">Kitą kartą atidarius „João Browser“ įrenginyje „<ph name="DEVICE_TYPE" />“, bus pateiktas raginimas naudoti skirtukų grupes.</translation>
<translation id="9087231386723579740">Pašalinti paskyrą iš „João Browser“</translation>
<translation id="4984395209542302039">Ji taip pat kontroliuoja, koks puslapis rodomas, kai paleidžiate „João Browser“.</translation>
<translation id="648319183876919572">Sustiprinto saugaus naršymo funkcija padeda apsaugoti jus nuo pavojingų svetainių ir atsisiuntimų</translation>
<translation id="1524792685704191751">Pašalinti „João Browser“</translation>
<translation id="6637504267182028286">Spartieji klavišai atidaromi naršyklėje „João Browser“</translation>
<translation id="1478247638436966279">Organizacija uždaro „João Browser“, kai ji nenaudojama <ph name="TIMEOUT_DURATION" />. Naršymo duomenys ištrinti. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai.</translation>
<translation id="1311233187253046133">Kiekviename profilyje saugoma atskira „João Browser“ informacija, pvz., žymės, istorija, slaptažodžiai ir kt.</translation>
<translation id="6556755379298048869">Ieškokite naudodami spartųjį klavišą.</translation>
<translation id="6563921047760808519">Sužinokite daugiau, <ph name="BEGIN_LINK" />kaip „Chromium“ užtikrina jūsų duomenų privatumą<ph name="END_LINK" /></translation>
<translation id="1643078533228697915">Šio nustatymo pakeitimai bus pritaikyti iš naujo paleidus „João Browser“.</translation>
<translation id="1918630514771863338">Tvarkykite plėtinius „João Browser“ pagrindiniame meniu spustelėję „Plėtiniai“.</translation>
<translation id="4229328298978407243">Galite perjungti, kad matytumėte slaptažodžius iš kito „João Browser“ profilio</translation>
<translation id="7717252965531997879">Naudokitės geriausiais DI įrankiais keliaudami su „João Browser“ programa</translation>
<translation id="6570579332384693436">Kad ištaisytų rašybos klaidas, „Chromium“ siunčia „Google“ tekstą, kurį įvedate teksto laukuose</translation>
<translation id="5374627817618267090">Eiti į „João Browser“ pranešimų nustatymus</translation>
<translation id="6600016381025017075">Ieškokite bet ko šiame puslapyje</translation>
<translation id="264335610358256197">Pakeitimai įsigalios kitą kartą iš naujo paleidus „João Browser“.</translation>
<translation id="2657584510687441826">„João Browser“ dabar paleidžiama paleidus „Windows“, kad galėtumėte iš karto pradėti naršyti. Šią parinktį bet kada galite išjungti skiltyje „Nustatymai“.</translation>
<translation id="5482413402708094860">Tęskite ten, kur baigėte: „João Browser“ atkūrė skirtukus iš paskutinio seanso. Tai galite išjungti skiltyje</translation>
<translation id="5022765692226673603">„João Browser“ reikalingas fotoaparato leidimas, kad būtų galima sukurti trimatį aplinkos žemėlapį</translation>
<translation id="6669284030132180248">Jei taip pat išsaugosite žymes „Google“ paskyroje, galėsite stebėti produktų kainas naršyklėje „Chromium“ ir gauti pranešimą, kai kaina sumažės</translation>
<translation id="6676384891291319759">Interneto prieiga</translation>
<translation id="668175097507315160">„Chromium“ OS nepavyko sinchronizuoti duomenų, nes prisijungiant įvyko klaida.</translation>
<translation id="3982573751008180181">Pašalinti šios programos duomenis iš „João Browser“</translation>
<translation id="5613723096388999601">„João Browser“ reikalingas mikrofono leidimas šioje svetainėje</translation>
<translation id="6712881677154121168">Atsisiuntimo klaida: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="9190188975825967506">Jūsų profilis nenaudojamas, nes jis iš naujesnės versijos „João Browser“.

Kai kurios funkcijos gali būti nepasiekiamos. Nurodykite kitą profilio katalogą arba naudokite naujesnės versijos „João Browser“.</translation>
<translation id="6729124504294600478">Jei norite naudoti suasmeninimo ir kitas funkcijas, įtraukite „Chromium“ į Žiniatinklio ir programų veiklą bei susietas „Google“ paslaugas</translation>
<translation id="6957684879859415418">„João Browser“ jau įdiegta visiems kompiuterio naudotojams.</translation>
<translation id="4411262692912917677">Jei norite pasiekti žymes ir kitas funkcijas visuose įrenginiuose, prisijunkite prie „João Browser“. Ši žymė bus išsaugota jūsų „Google“ paskyroje, kai prisijungsite.</translation>
<translation id="6064901610880747710">Paspartina svetaines naudojant „João Browser“ V8 variklį, bet daro „João Browser“ šiek tiek mažiau atsparią atakoms. Šis nustatymas įjungtas.</translation>
<translation id="4530735110472079436">{count,plural, =1{Kai kurie „João Browser“ duomenys dar neišsaugoti „Google“ paskyroje. Pabandykite palaukti kelias minutes prieš atsijungdami. Jei atsijungsite dabar, šie duomenys (1 elementas) bus ištrinti.}one{Kai kurie „João Browser“ duomenys dar neišsaugoti „Google“ paskyroje. Pabandykite palaukti kelias minutes prieš atsijungdami. Jei atsijungsite dabar, šie duomenys ({count} elementas) bus ištrinti.}few{Kai kurie „João Browser“ duomenys dar neišsaugoti „Google“ paskyroje. Pabandykite palaukti kelias minutes prieš atsijungdami. Jei atsijungsite dabar, šie duomenys ({count} elementai) bus ištrinti.}many{Kai kurie „João Browser“ duomenys dar neišsaugoti „Google“ paskyroje. Pabandykite palaukti kelias minutes prieš atsijungdami. Jei atsijungsite dabar, šie duomenys ({count} elemento) bus ištrinti.}other{Kai kurie „João Browser“ duomenys dar neišsaugoti „Google“ paskyroje. Pabandykite palaukti kelias minutes prieš atsijungdami. Jei atsijungsite dabar, šie duomenys ({count} elementų) bus ištrinti.}}</translation>
<translation id="9176853308971176490">„João Browser“ rekomenduoja nuskaityti šį failą, nes jis gali būti pavojingas.</translation>
<translation id="6779406956731413166">„Chromium“ OS pasiekiama naudojant papildomą <ph name="BEGIN_LINK_CROS_OSS" />atvirojo šaltinio programinę įrangą<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6831043979455480757">Vertėjas</translation>
<translation id="6412488898785231889">„João Browser“ praneš, jei slaptažodžiai bus pažeisti</translation>
<translation id="684888714667046800">Nepavyksta prisijungti prie interneto. Jei naudojate užkardą, įsitikinkite, kad „<ph name="PRODUCT_EXE_NAME" />“ yra leidžiamųjų sąraše.</translation>
<translation id="6750640664545078431">„João Browser“ – „<ph name="PAGE_TITLE" />“</translation>
<translation id="6859580922007887573">Jei norite tęsti, paspauskite tabuliavimo klavišą</translation>
<translation id="6862030660799253820">Ieškoti šio vaizdo naudojant vaizdų paiešką</translation>
<translation id="6869568587896659271">Lengvai pasiekite svetaines po adreso juosta</translation>
<translation id="4260365383290377081">„João Browser“ aptiko kenkėjišką programą plėtinyje „<ph name="EXTENSION_NAME" />“</translation>
<translation id="6877155553248388166">apatinis dešinysis paieškos srities kampas: dešinė – <ph name="RIGHT" /> %, apačia – <ph name="BOTTOM" /> %</translation>
<translation id="6896758677409633944">Kopijuoti</translation>
<translation id="6898028264630240901">Galite prisegti kontekstines užduotis, kad naršydami galėtumėte užduoti klausimų</translation>
<translation id="6985817498888719203">Nustatykite „João Browser“ kaip numatytąją naršyklę ir prisekite ją prie užduočių juostos</translation>
<translation id="5277424858974213042">&amp;Tvarkyti „João Browser“ profilius</translation>
<translation id="2726137364317931343">Atlikus šį veiksmą bus:
          <ph name="LINE_BREAKS" />
            • iš naujo nustatyti paleidimo puslapis, naujo skirtuko puslapis, paieškos variklis ir prisegti skirtukai;
            <ph name="LINE_BREAK" />
            • išjungti plėtiniai;
            <ph name="LINE_BREAK" />
            • ištrinti slapukai ir kiti laikini svetainės duomenys;
            <ph name="LINE_BREAK" />
            • iš naujo nustatyti „João Browser“ spartieji klavišai.
            <ph name="LINE_BREAKS" />
            Tai neturės įtakos žymėms, istorijai ir išsaugotiems slaptažodžiams.</translation>
<translation id="2901988969322822496">Pasiekėte „João Browser“ žymių apribojimą (<ph name="BOOKMARK_LIMIT" />), todėl kai kurios žymės dar neišsaugotos „Google“ paskyroje.

Naujų žymių negalima išsaugoti paskyroje, kol ištrinsite kai kurias žymes. Jei atsijungsite dabar, neišsaugotos žymės bus ištrintos.</translation>
<translation id="6203410920314218280">Atidaryti nuorodą „João Browser“ inko&amp;gnito lange</translation>
<translation id="6965382102122355670">Gerai</translation>
<translation id="6985329841647292029">„Chromium“ OS sąlygos</translation>
<translation id="8064285182627814996">Įveskite slaptafrazę, kad galėtumėte naudoti ir išsaugoti „João Browser“ duomenis paskyroje <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="7011190694940573312">Įdiegti nepavyko, nes ši operacinės sistemos versija nepalaikoma.</translation>
<translation id="7024536598735240744">Išpakavimo klaida: <ph name="UNPACK_ERROR" />.</translation>
<translation id="181803036615530330">Suasmeninkite „João Browser“</translation>
<translation id="7047386856539490735">Ar šie rezultatai naudingi?</translation>
<translation id="2478245051737698828">Atnaujinti „João Browser“</translation>
<translation id="452909342278940733">Jei nebus naudingo vaizdo aprašo, „João Browser“ bandys jums jį pateikti. Kad būtų galima kurti aprašus, vaizdai siunčiami į sistemą „Google“.</translation>
<translation id="8606769615526968368">Pasinaudokite DI galia naudodami „João Browser“ programą įrenginyje „<ph name="DEVICE_TYPE" />“</translation>
<translation id="2061960765882453684">Turėkite slaptažodžius, skirtukus ir kt. su savimi keliaudami, naudodami „João Browser“ programą telefone</translation>
<translation id="7141270731789036260">Tinkinti „Chrome for Testing“</translation>
<translation id="7147227333672430807">Galite naudoti „Chromium“ bet kada spustelėję nuorodas pranešimuose, dokumentuose ir kitose programose</translation>
<translation id="6949173677980969871">Pašalinti „<ph name="EXTENSION_NAME" />“ iš „João Browser“</translation>
<translation id="3556355753960287061">Organizacija ištrina „João Browser“ duomenis, kai jie nenaudojami <ph name="TIMEOUT_DURATION" />. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai.</translation>
<translation id="8689006320829658442">„João Browser“ reikalingas fotoaparato leidimas šioje svetainėje</translation>
<translation id="7501884108538572227">Nepavyko paleisti „João Browser“. Bandykite dar kartą.</translation>
<translation id="5484563502710761706">Klauskite bet ko, kad ir kur būtumėte, naudodami „Gemini“ naršyklėje „João Browser“</translation>
<translation id="3823264355161086552">Palikite „João Browser“ doke, kad bet kada galėtumėte greitai ją pasiekti</translation>
<translation id="9153902741226700840">Naudokite „João Browser“ bet kada spustelėję nuorodas pranešimuose, dokumentuose ir kitose programose</translation>
<translation id="7216228761061470870">Kai naudojate vaizdų paiešką staliniame kompiuteryje, puslapio pavadinimas, URL ir turinys, įskaitant PDF failus, siunčiami į serverį</translation>
<translation id="7950844619283784703">Užduočių tvarkytuvė – „João Browser“</translation>
<translation id="133513825972536773"><ph name="EXISTING_USER" /> jau prisijungė. Jei norite atskirti naršymą, prisijunkite prie „João Browser“ savo profilyje kaip <ph name="USER_EMAIL_ADDRESS" />. Be to, išsaugotą informaciją ir kitas funkcijas pasieksite visuose įrenginiuose.</translation>
<translation id="4558982617284733740">Pradėkite naršyti akimirksniu: „João Browser“ dabar galima paleisti paleidus „Windows“.</translation>
<translation id="7274695763216404502">Prisegta! Vėl naudokite vaizdų paiešką iš įrankių juostos</translation>
<translation id="7288567540154601580">Skirtukai ir plėtiniai</translation>
<translation id="5494571279964989269">{NUM_EXTENSIONS,plural, =1{„João Browser“ rekomenduoja tai pašalinti}one{„João Browser“ rekomenduoja tai pašalinti}few{„João Browser“ rekomenduoja tai pašalinti}many{„João Browser“ rekomenduoja tai pašalinti}other{„João Browser“ rekomenduoja tai pašalinti}}</translation>
<translation id="2269053214123323740">Jei norite bendrinti sistemos garsą, atidarykite sistemos nustatymus ir leiskite „João Browser“ įrašyti tik sistemos garsą. Tada turėsite iš naujo paleisti „João Browser“.</translation>
<translation id="731795002583552498">Atnaujinama „Chromium“</translation>
<translation id="9065168747010082551">Nuostatų failas sugadintas ar netinkamas.

„João Browser“ negali atkurti nustatymų.</translation>
<translation id="7324051657739063017">Galite iš naujo atidaryti kontekstines užduotis, kad galėtumėte užduoti klausimų, kol naršote</translation>
<translation id="4159250197688136733">Čia saugoma žiniatinklio informacija, žymės ir kiti „João Browser“ duomenys.</translation>
<translation id="7347827960336370838">Tik jūsų slaptafrazę turintis asmuo galės perskaityti šifruotus duomenis. Slaptafrazė nesiunčiama ir nesaugoma „Google“. Jei pamiršite slaptafrazę ar norėsite pakeisti šį nustatymą, turėsite <ph name="BEGIN_LINK" />ištrinti „Chromium“ duomenis paskyroje<ph name="END_LINK" />.</translation>
<translation id="1062903713270840396">Sistemos administratorius sukonfigūravo „João Browser“ atidaryti naršyklę „<ph name="ALTERNATIVE_BROWSER_NAME" />“, norint pasiekti <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">Kažkas negerai</translation>
<translation id="5817362738974335084">Jei norite gauti būsimus „João Browser“ naujinius, jums reikės 13 ar naujesnės „macOS“ versijos. Šiame kompiuteryje naudojama 12 versijos „macOS“.</translation>
<translation id="7376384068949534168">Pastaruoju metu nesilankėte. „Chromium“ pašalino <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />.</translation>
<translation id="73786666777299047">Atidarykite „Chrome“ internetinę parduotuvę</translation>
<translation id="5724625487458697703">Rodyti „Gemini“ naršyklėje „João Browser“ sistemos juostelėje</translation>
<translation id="7401687852903179959">Ieškoti šiame vaizdo įraše naudojant vaizdų paiešką</translation>
<translation id="1088684725931971005">„João Browser“ dabar yra numatytoji naršyklė</translation>
<translation id="7479848806300971661">Tęskite nuo ten, kur baigėte: „João Browser“ atkuria skirtukus kiekvieną kartą, kai paleidžiate iš naujo. Jei norite tai išjungti, eikite į</translation>
<translation id="1258077876605261365">Slaptažodžių importavimas į „João Browser“</translation>
<translation id="5293062713751091377">1. Spustelėkite toliau pateiktą mygtuką „<ph name="BUTTON_LABEL" />“.
2. Spustelėkite „<ph name="BUTTON_2" />“ „Windows“ nustatymuose.
3. Spustelėkite mygtuką „<ph name="BUTTON_3" />“ „Windows“ pranešime, kad prisegtumėte „João Browser“ prie užduočių juostos ir galėtumėte sparčiai ją pasiekti.</translation>
<translation id="1941496545060769345">„<ph name="PAGE_TITLE" />“ – „João Browser Dev“</translation>
<translation id="7450541714075000668">Tekstas nukopijuotas</translation>
<translation id="7458892263350425044">Jei norite naudoti mikrofoną, suteikite „Chromium“ prieigą <ph name="BEGIN_LINK" />sistemos nustatymuose<ph name="END_LINK" /></translation>
<translation id="5422859338435319909">Jei norite gauti būsimus „João Browser“ naujinius, jums reikės 10 ar naujesnės versijos „Windows“. Šiame kompiuteryje naudojama 7 versijos „Windows“.</translation>
<translation id="7467949745582939695">Iš naujo paleisti „Chromium“?</translation>
<translation id="7707324976708178089">Negalima įdiegti tos pačios „João Browser“ versijos, kuri šiuo metu paleista. Uždarykite „João Browser“ ir bandykite dar kartą.</translation>
<translation id="7510190804000607802">Priminimas: geriausios „Google“ funkcijos jūsų kišenėje</translation>
<translation id="751935028865900641">Svetainės tikriausiai veiks kaip numatyta. Būsite atjungti nuo daugelio svetainių, kai uždarysite visus „Chromium“ langus, išskyrus „Google“ paskyrą, jei esate prisijungę prie „Chromium“.</translation>
<translation id="5325102834460669866">{0,plural, =1{„João Browser“ bus paleista iš naujo po 1 minutės}one{„João Browser“ bus paleista iš naujo po # minutės}few{„João Browser“ bus paleista iš naujo po # minučių}many{„João Browser“ bus paleista iš naujo po # minutės}other{„João Browser“ bus paleista iš naujo po # minučių}}</translation>
<translation id="7565444033145385702">Kad apsaugotumėte duomenis, leiskite „Chromium“ pašalinti svetainių, kuriose pastaruoju metu nesilankėte, leidimus.</translation>
<translation id="8099958128052689767">Paleiskite „João Browser“ automatiškai, kad galėtumėte iš karto pradėti naršyti.</translation>
<translation id="7583399374488819119">„<ph name="COMPANY_NAME" />“ diegimo programa</translation>
<translation id="7125257608567714221">„João Browser“ naudoja jūsų fotoaparatą ir mikrofoną.</translation>
<translation id="227045421902171569">„João Browser“ dabar dar tobulesnė</translation>
<translation id="5356567285381070312">Dabar „João Browser“ pasiekiama daugiau funkcijų</translation>
<translation id="7624307931717240213">Informaciją naudojame siekdami patobulinti šią paslaugą. Žr. privatumo politiką ir paslaugų teikimo sąlygas.</translation>
<translation id="7649070708921625228">Pagalba</translation>
<translation id="5714374331629713291">Gauti „João Browser“ programą</translation>
<translation id="7658239707568436148">Atšaukti</translation>
<translation id="549378870470819535">„João Browser“ nėra numatytoji naršyklė</translation>
<translation id="6574348346278803862">Sinchronizuokite ir suasmeninkite „João Browser“ skirtinguose įrenginiuose</translation>
<translation id="7699779824407626136">„Chromium“ naujinys</translation>
<translation id="3304080024230377341">Jūsų darbas apsaugotas sistemoje „João Browser“</translation>
<translation id="7716950018788545737">Užduotis (-ys) baigėsi.</translation>
<translation id="77283119132245232">Naršyklei „<ph name="BROWSER_NAME" />“ teikiamos sistemos stebėjimo paslaugos. Jei ši paslauga išjungta, sistemos lygio įvykiai, pvz., konteksto perjungimai ir grupių parengties įvykiai, neįtraukiami naršyklės sugeneruotus našumo stebėjimo duomenis.</translation>
<translation id="7745317241717453663">Atlikus šį veiksmą iš šio įrenginio bus ištrinti naršymo duomenys. Jei vėliau norėsite gauti duomenis, prisijunkite prie „Chromium“ kaip <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Diegimo programai nepavyko sukurti laikino katalogo. Patikrinkite, ar yra laisvos vietos diske ir, ar leidžiama įdiegti programinę įrangą.</translation>
<translation id="4713120944298974980">Paieška naršyklėje „João Browser“</translation>
<translation id="5804390944809171853">Iš naujo nustatyti numatytąją „João Browser“ temą</translation>
<translation id="6930487390575519812">Kad apsaugotų jūsų darbą sistemoje „João Browser“, jūsų organizacija galės peržiūrėti arba tvarkyti tam tikrą informaciją, kai būsite prisijungę prie „João Browser“.</translation>
<translation id="5214761769821670245">Nustatykite „João Browser“ kaip numatytąją naršyklę ir prisekite ją prie užduočių juostos</translation>
<translation id="1294697217796985566">Paspartinkite „João Browser“</translation>
<translation id="1278345486417353853">„<ph name="PAGE_TITLE" />“ – „João Browser Canary“</translation>
<translation id="7803986347287457849">Neleiskite srautą internete galintiems pasiekti žmonėms matyti svetainių, kuriose lankotės. „Chromium“ naudoja saugų ryšį ieškodama svetainės IP adreso DNS (domenų pavadinimų sistemoje).</translation>
<translation id="7810005234485217901">Galite prisegti vaizdų paiešką, kad lengvai ją pasiektumėte</translation>
<translation id="489728561211958943">Šios paskyros „João Browser“ profilis jau yra šiame įrenginyje</translation>
<translation id="7845233973568007926">Dėkojame už diegimą. Turite iš naujo paleisti kompiuterį, prieš naudodami „<ph name="BUNDLE_NAME" />“.</translation>
<translation id="5294768452950207882">Paieškos variklis buvo pakeistas ne naršyklėje „João Browser“. Kad apsaugotų jus, „João Browser“ jį nustatė iš naujo į pradinį numatytąjį nustatymą. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3244974069468656925">Tinkinkite „João Browser“ ir suteikite jai naują išvaizdą</translation>
<translation id="7859018312476869945">Kai įvedate tekstą adreso juostoje ar paieškos laukelyje, „Chromium“ siunčia tai, ką įvedate, į numatytąjį paieškos variklį, kad gautų geresnių pasiūlymų. Ši funkcija inkognito režimu išjungta.</translation>
<translation id="6517519572778941051">Nepavyko atnaujinti „João Browser“ į naujausią versiją, todėl nebus pasiekiamos naujos funkcijos ir saugos pataisos.</translation>
<translation id="7872446069773932638">Atsisiunčiama... Liko <ph name="SECONDS" /> sek.</translation>
<translation id="7873537467422636035">Jei pamiršote slaptafrazę ar norite pakeisti šį nustatymą, <ph name="BEGIN_LINK" />ištrinkite „Chromium“ duomenis paskyroje<ph name="END_LINK" /></translation>
<translation id="1722038268139386345">Greitai atidaryti „Gemini“ naršyklėje „João Browser“, kai tik jo prireikia</translation>
<translation id="8344320926817290924">„João Browser“ nustatymas kaip numatytosios naršyklės</translation>
<translation id="7934340546140346950">„Chromium“ automatiškai naujovina nesaugius ryšius į HTTPS, kai tai įmanoma</translation>
<translation id="3755057387338907970">Buvote prisijungę prie „João Browser“ kaip <ph name="USER_EMAIL_ADDRESS" />. Prisijungdami vėl naudokite tą pačią paskyrą.</translation>
<translation id="929903348843569380"><ph name="EXISTING_USER" /> jau prisijungė. Jei norite atskirti naršymą, prisijunkite prie „João Browser“ savo profilyje kaip <ph name="USER_EMAIL_ADDRESS" />. Be to, žymes ir kitas funkcijas pasieksite visuose įrenginiuose.</translation>
<translation id="7975919845073681630">Tai yra antrinis „Chromium“ diegimas, todėl ji negali būti nustatyta kaip numatytoji naršyklė.</translation>
<translation id="8905411496853397218">Plėtiniai, programos ir temos iš nežinomų šaltinių gali pakenkti jūsų įrenginiui. „João Browser“ rekomenduoja įdiegti tik iš čia: <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /></translation>
<translation id="6306672714476596428">Išnaudokite visas „Google“ galimybes, naudodami „João Browser“ programą įrenginyje „<ph name="DEVICE_TYPE" />“</translation>
<translation id="8004582292198964060">Naršyklė</translation>
<translation id="8010081455002666927">Automatinis aptikimas</translation>
<translation id="2172829664765531568">Kai „João Browser“ galės pasiekti duomenis, svetainės taip pat galės prašyti suteikti leidimą juos pasiekti.</translation>
<translation id="74641100973032765">Prisekite „João Browser“ prie užduočių juostos, kad bet kada galėtumėte greitai ją pasiekti</translation>
<translation id="80471789339884597">Dėkojame už diegimą. Turite iš naujo paleisti visas naršykles, prieš naudodami „<ph name="BUNDLE_NAME" />“.</translation>
<translation id="8054112667659782652">Visada rodyti vaizdų paieškos šaukinį</translation>
<translation id="8069447462453318634">Pasirinkite „Prisegti prie įrankių juostos“</translation>
<translation id="5039671129725402518">Išjungti „João Browser“ vykdymą fone programose</translation>
<translation id="80790299200510644">Vaizdų paieška</translation>
<translation id="8086881907087796310">Įdiegti nepavyko, nes kompiuteris neatitinka minimalių aparatinės įrangos reikalavimų.</translation>
<translation id="8096472344908884505">„<ph name="PAGE_TITLE" />“ – „Google Chrome for Testing“</translation>
<translation id="2430877582155731716">„João Browser“ reikalingas leidimas pasiekti vietovės duomenis šioje svetainėje</translation>
<translation id="8298045348217323">Kitą kartą atidarius „João Browser“ įrenginyje „<ph name="DEVICE_TYPE" />“, bus pateiktas raginimas įgalinti kainų stebėjimo įspėjimus.</translation>
<translation id="3827347991254458074">Gaukite įspėjimus apie sumažintas prekių, kuriomis domitės, kainas, naudodami „João Browser“ programą telefone</translation>
<translation id="8118331347066725040">Atsiliepimų apie paiešką siuntimas naudojant „Lens“</translation>
<translation id="2580039965224265556">„João Browser“ suasmeninimas</translation>
<translation id="8133124826068723441">„Chromium“ OS nepavyko sinchronizuoti duomenų, nes jūsų domene sinchronizavimas nepasiekiamas.</translation>
<translation id="813913629614996137">Inicijuojama...</translation>
<translation id="7940955011992997426">Atidarykite „Gemini“ naršyklėje „João Browser“ naudodami sparčiuosius klavišus.</translation>
<translation id="7560319627203819845">„João Browser“ papildomos paslaugų teikimo sąlygos</translation>
<translation id="7133741820744999589">Šis failas pavojingas, todėl „João Browser“ jį užblokavo.</translation>
<translation id="8177472873527554730">Nepavyko rasti puslapio turinio</translation>
<translation id="8200109504272824693">Įveskite slaptafrazę, kad galėtumėte naudoti ir išsaugoti „Chromium“ duomenis paskyroje <ph name="USER_EMAIL" /></translation>
