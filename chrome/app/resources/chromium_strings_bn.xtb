<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="bn">
<translation id="1026101648481255140">ইনস্টলেশন আবার চালু করুন</translation>
<translation id="1029669172902658969">&amp;ChromiumOS আপডেট করতে আবার লঞ্চ করুন</translation>
<translation id="4711726241445951349">এই এক্সটেনশন পর্যালোচনা করার জন্য João Browser সাজেশন দেয়</translation>
<translation id="1042552502243217427">কোনও সাইট তার পৃষ্ঠায় লিঙ্ক ব্যক্তিগতভাবে প্রিলোড করতে বললে, Chromium, Google সার্ভার ব্যবহার করে। এর ফলে প্রিলোড করা সাইটের থেকে আপনার পরিচয় লুকানো থাকে, কিন্তু Google জানতে পারে কোন সাইটগুলি প্রিলোড করা হয়েছে।</translation>
<translation id="1051793555070215510">এই ১-মিনিটের সমীক্ষায় অংশ নিয়ে ছদ্মবেশী মোড উন্নত করতে আমাদের সাহায্য করুন।</translation>
<translation id="1065672644894730302">আপনার অভিরুচিগুলি পড়া যাবে না৷ কিছু বৈশিষ্ট্য অনুপলব্ধ থাকতে পারে ও অভিরুচিগুলিতে করা পরিবর্তনগুলি সংরক্ষিত হবে না৷</translation>
<translation id="3937976866851867994">তোমার অভিভাবক João Browser-এর জন্য "সাইট, অ্যাপ ও এক্সটেনশনের অনুমতি" বন্ধ করে দিয়েছেন</translation>
<translation id="8626021334348319355">কোনও নির্দিষ্ট João Browser ফিচার বা এক্সটেনশন সার্চ করতে, অ্যাড্রেস বারে এটির শর্টকাট টাইপ করুন, তারপর আপনার বেছে নেওয়া কীবোর্ড 'কী' প্রেস করুন</translation>
<translation id="9157778882771986870">João Browser আপনার পাসওয়ার্ড এক্সপোর্ট করতে চাইছে। অনুমতি দিতে Windows এর পাসওয়ার্ড টাইপ করুন।</translation>
<translation id="112640046208448578">বস্তু বা জায়গা শনাক্ত করুন ও টেক্সট কপি বা অনুবাদ করুন। 'ছবি সার্চ করা' ফিচার ব্যবহার করতে সার্ভারে পৃষ্ঠার স্ক্রিনশট পাঠানো হয়। <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium আপনার ডিফল্ট ব্রাউজার</translation>
<translation id="1131805035311359397">আপনার পাসওয়ার্ড ডেটার নিরাপত্তা লঙ্ঘন এবং অন্যান্য নিরাপত্তা সংক্রান্ত সমস্যা থেকে সুরক্ষিত কিনা তা চেক করতে <ph name="BEGIN_LINK" />Chromium-এ সাইন-ইন করুন<ph name="END_LINK" />।</translation>
<translation id="2795895511109336240">João Browser মেনুতে ক্লিক করুন</translation>
<translation id="1157985233335035034">সাম্প্রতিক ভাষা</translation>
<translation id="1184145431117212167">আপনার Windows-এর ভার্সনে কাজ করছে না তাই ইনস্টল করা যায়নি।</translation>
<translation id="1185134272377778587">Chromium সম্পর্কে</translation>
<translation id="667420476518265356">আপনার ফোনে João Browser-এর মাধ্যমে দাম ট্র্যাক করা সংক্রান্ত সতর্কতা পান</translation>
<translation id="1203500561924088507">ইনস্টল করার জন্য ধন্যবাদ। <ph name="BUNDLE_NAME" /> ব্যবহার করার আগে আপনাকে অবশ্যই ব্রাউজার রিস্টার্ট করতে হবে।</translation>
<translation id="1232234696885483911">আপনি 'ছবি সার্চ করা' ফিচার খুললে, পৃষ্ঠার টাইটেল, URL এবং পিডিএফ সহ কন্টেন্ট অটোমেটিক সার্ভারে পাঠানো হবে। <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">আপনি সাইন-ইন করার সময়, João Browser-এ আপনার Google অ্যাকাউন্ট থেকে পাসওয়ার্ড এবং আরও অনেক কিছু ব্যবহার করতে পারবেন। এটি পরিবর্তন করতে, “João Browser-এ আপনার অ্যাকাউন্ট” বিকল্পে যান।</translation>
<translation id="4866003137980530528">Mac মেনু বারে João Browser-এ Gemini দেখুন</translation>
<translation id="2526294198551578217">João Browser-এ Gemini-তে স্ক্রিনের অংশ বেছে নিতে, কীবোর্ড শর্টকাট ব্যবহার করুন।</translation>
<translation id="7068536367561625920">João Browser যাতে দ্রুত কাজ করে সেই জন্য এই ট্যাব বন্ধ থাকাকালীন মেমরি খালি করা হয়েছে। এই সাইটটি অ্যাক্টিভ রাখার বিকল্প সব সময় বেছে নিতে পারবেন।</translation>
<translation id="3669854427836618143">এই ফাইলটি বিপজ্জনক, তাই João Browser এই ডাউনলোডটি ব্লক করে দিয়েছে</translation>
<translation id="126567311906253476">Gmail বা YouTube-এর মতো Google পরিষেবায় <ph name="USER_EMAIL" /> দিয়ে সাইন-ইন করার সময় আপনি একই অ্যাকাউন্ট দিয়ে Chromium-এ অটোমেটিক সাইন-ইন করতে পারবেন</translation>
<translation id="8094399825947986050">আপনার ফোনে João Browser ডাউনলোড করুন</translation>
<translation id="1290883685122687410">সেট-আপ সংক্রান্ত সমস্যা: <ph name="METAINSTALLER_EXIT_CODE" />। <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">আপনার নতুন João Browser প্রোফাইল সেট আপ করুন</translation>
<translation id="7591029065989504977">João Browser-এ Gemini ব্যবহার করে দেখুন</translation>
<translation id="8408989583029959522">ব্লুটুথ ডিভাইসগুলি এক্সপ্লোর করতে&#32;
 João Browser-কে ব্লুটুথের অ্যাক্সেস দিতে হবে। <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">আপনার ফোনে João Browser-এ সাইন-ইন করুন</translation>
<translation id="1330562121671411446">ভাষা শনাক্ত করুন</translation>
<translation id="6026568602942276348">এছাড়া, João Browser থেকেও ডেটা মুছে দিন (<ph name="URL" />)</translation>
<translation id="1345251407431278948">পিন করা আছে! টুলবারে থাকা নতুন বোতাম থেকে আবার আপনি 'ছবি সার্চ করা' ফিচার অ্যাক্সেস করতে পারবেন</translation>
<translation id="1356661055722410047">নতুন! আপনি স্ক্রিনে টেক্সট ও ছবি দুটিই অনুবাদ করতে পারবেন</translation>
<translation id="1383876407941801731">খুঁজুন</translation>
<translation id="5807085300679014096">যেকোনও সময় ও জায়গায়, ব্রাউজ করা চালিয়ে যেতে João Browser অ্যাপ ব্যবহার করুন</translation>
<translation id="141901961143729572">আপনার মতামত শেয়ার করুন</translation>
<translation id="3736947618013031173">আপনার উইন্ডো শেয়ার করতে, সিস্টেম সেটিংস থেকে João Browser-এর জন্য স্ক্রিন রেকর্ডিংয়ের অনুমতি দিন।</translation>
<translation id="1478370723027452770">Chrome for Testing ব্যবহার করে সহায়তা পান</translation>
<translation id="1497802159252041924">ইনস্টলেশন সংক্রান্ত সমস্যা: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">এই পৃষ্ঠাটি সুরক্ষিত</translation>
<translation id="4379865404970367448">একটি João Browser ট্যাব শেয়ার করুন</translation>
<translation id="4436275659297289591">João Browser-এ সাইন-ইন করুন</translation>
<translation id="1547469039832541117">হাইলাইট করা টাস্ক শেষ করে।</translation>
<translation id="449712764049695153">João Browser পিন করুন</translation>
<translation id="1574377791422810894">Chromium-এর নিরাপত্তা টুল</translation>
<translation id="5480232403718129394">João Browser আপনার Password Manager সম্পর্কিত ডেটা মুছতে চায়। এটি করার অনুমতি দিতে, আপনার Windows-এর পাসওয়ার্ড টাইপ করুন।</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{একটি আপডেট প্রয়োগ করতে আপনার অ্যাডমিনিস্ট্রেটর আপনাকে João Browser আবার চালু করতে বলছেন}=1{একটি আপডেট প্রয়োগ করতে আপনার অ্যাডমিনিস্ট্রেটর আপনাকে João Browser আবার চালু করতে বলছেন। আপনার ছদ্মবেশী উইন্ডো আবার খুলবে না।}one{একটি আপডেট প্রয়োগ করতে আপনার অ্যাডমিনিস্ট্রেটর আপনাকে João Browser আবার চালু করতে বলছেন। আপনার #টি ছদ্মবেশী উইন্ডো আবার খুলবে না।}other{একটি আপডেট প্রয়োগ করতে আপনার অ্যাডমিনিস্ট্রেটর আপনাকে João Browser আবার চালু করতে বলছেন। আপনার #টি ছদ্মবেশী উইন্ডো আবার খুলবে না।}}</translation>
<translation id="980976428162070137">ফোনে João Browser অ্যাপের মাধ্যমে Google-এর সেরা সব সুবিধা পান</translation>
<translation id="1625909126243026060">Chromium-এ মূল গোপনীয়তা এবং নিরাপত্তা নিয়ন্ত্রণ পর্যালোচনা করুন</translation>
<translation id="1640672724030957280">ডাউনলোড হচ্ছে...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" />, মেম্বারশিপ হিসেবে সাইন-ইন করেছেন। অ্যাকাউন্ট মেনু খুলুন</translation>
<translation id="1708414395296835197">মেসেজ, ডকুমেন্ট এবং অন্যান্য অ্যাপে থাকা লিঙ্কে ক্লিক করে যেকোনও সময় Chromium ব্যবহার করতে পারবেন। এছাড়াও এটি আপনার টাস্কবারেও পিন করা হবে।</translation>
<translation id="1709772298389099340">এটি <ph name="BROWSER_NAME" />-এর জন্য বিশেষ সুবিধার অ্যাক্সেস দেয়।</translation>
<translation id="1722488837206509557">এর ফলে আপনি উপলভ্য ডিভাইসগুলি থেকে বেছে নিতে পারবেন এবং সেগুলিতে কন্টেন্ট দেখাতে পারবেন।</translation>
<translation id="6972087163510342335">João Browser শীঘ্রই ব্রাউজ করা ডেটা মুছে ফেলবে</translation>
<translation id="1736443181683099871">Chromium নেভিগেশনকে HTTPS-তে আপগ্রেড করার চেষ্টা করবে</translation>
<translation id="3879288383593333401">João Browser ডেটা সাফ করা হয়েছে</translation>
<translation id="656496276885630888">João Browser <ph name="REMAINING_TIME" />-এর মধ্যে রিস্টার্ট হবে</translation>
<translation id="1749104137266986751">HTTPS উপলভ্য না থাকলে, Chromium আপনাকে সতর্ক না করেই অসুরক্ষিত কানেকশন ব্যবহার করবে</translation>
<translation id="1226290419185955779">João Browser-কে ব্যাকগ্রাউন্ডে চলতে দিন</translation>
<translation id="4231366995273072370">João Browser কে আরও নিরাপদ করতে, আমরা কিছু এক্সটেনশান অক্ষম করেছি যা <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> এ তালিকাবদ্ধ করা হয়নি এবং হয়ত আপনাকে না জানিয়ে যোগ করা হয়েছে৷</translation>
<translation id="1822049153969905781">দ্রুত অ্যাক্সেসের জন্য আপনার টাস্কবারে João Browser পিন করতে, Windows বিজ্ঞপ্তিতে <ph name="BEGIN_BOLD" />হ্যাঁ<ph name="END_BOLD" /> বিকল্পে ক্লিক করুন</translation>
<translation id="1321831992638405531">João Browser আবার ইন্সটল করুন</translation>
<translation id="3386967202064865436">João Browser <ph name="AUTHENTICATION_PURPOSE" />-এর চেষ্টা করছে</translation>
<translation id="70054449700528483">পরেরবার আপনার <ph name="DEVICE_TYPE" />-এ João Browser খোলার সময়, Google Password Manager ব্যবহার করার জন্য আপনাকে প্রম্পট দেখানো হবে।</translation>
<translation id="1838374766361614909">সার্চ সাফ করুন</translation>
<translation id="5807096362853316123">শুধুমাত্র এই ডিভাইস থেকে ব্রাউজ করা ডেটা মুছে দিতে, তা নিজের Google অ্যাকাউন্টে রেখে দেওয়ার সময়, <ph name="BEGIN_LINK" />João Browser থেকে সাইন-আউট করুন<ph name="END_LINK" />।</translation>
<translation id="6396384011117650379">যেকোনও জায়গা থেকে নতুন ট্যাব গ্রুপ খুলতে বা তৈরি করতে আপনার ফোনে João Browser ডাউনলোড করুন।</translation>
<translation id="185970820835152459">আপনার সাইন-ইন করা Google অ্যাকাউন্ট ম্যানেজ করতে পারবেন। Chromium ব্রাউজার, Play Store, Gmail সহ আরও অনেক কিছুর জন্য আপনার Google অ্যাকাউন্ট ব্যবহার করা হয়। পরিবারের সদস্যের মতো অন্য কারও অ্যাকাউন্ট যোগ করতে চাইলে, তার পরিবর্তে আপনার <ph name="DEVICE_TYPE" />-এ নতুন ব্যক্তিকে যোগ করুন। <ph name="LINK_BEGIN" />আরও জানুন<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">'ছবি সার্চ করা' ফিচারের মাধ্যমে সার্চ করুন</translation>
<translation id="65457771685016683"><ph name="EXISTING_USER" /> আগেই সাইন-ইন করেছেন। আপনি আলাদাভাবে ব্রাউজ করতে চাইলে, নিজের João Browser প্রোফাইলে <ph name="USER_EMAIL_ADDRESS" /> হিসেবে সাইন-ইন করুন। এছাড়াও আপনি <ph name="DEVICE" /> থেকে নিজের বুকমার্ক ও আরও অনেক কিছু পাবেন।</translation>
<translation id="1880677175115548835">টেক্সট বেছে নিন</translation>
<translation id="2634119629547215883">আপনি একটি পরিচালিত অ্যাকাউন্টের মাধ্যমে সাইন-ইন করুন করছেন এবং এর অ্যাডমিনিস্ট্রেটরকে আপনার João Browser প্রোফাইলের উপরে নিয়ন্ত্রণ দিচ্ছেন৷ আপনার João Browser ডেটা, যেমন অ্যাপ, বুকমার্ক, ইতিহাস, পাসওয়ার্ড এবং অন্যান্য সেটিংস <ph name="USER_NAME" /> এতে স্থায়ীভাবে সম্পৃক্ত হবে৷ আপনি Google অ্যাকাউন্টগুলির ড্যাশবোর্ডের মাধ্যমে এই ডেটাগুলি মুছতে চালু হবেন, কিন্তু অন্য অ্যাকাউন্টের সাথে এই ডেটা সংশ্লিষ্ট করতে পারবেন না৷ বিকল্প হিসেবে আপনি আপনার বিদ্যমান João Browser তথ্য আলাদা রাখার জন্য একটি নতুন প্রোফাইল তৈরি করতে পারেন৷ <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">স্মুথ স্ক্রলিং ও ভিডিও ফ্রেম রেটের মতো ব্যাকগ্রাউন্ড অ্যাক্টিভিটি ও ভিজ্যুয়াল এফেক্টকে সীমিত করার মাধ্যমে Chromium ব্যাটারির চার্জ সাশ্রয় করে। <ph name="BEGIN_LINK" />পাওয়ার সেভার সম্পর্কে আরও জানুন<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">João Browser আপডেটার পরিষেবা</translation>
<translation id="1911763535808217981">এটি বন্ধ করার মানে হল, আপনি Chromium-এ সাইন-ইন না করে Gmail এর মতো Google সাইটগুলিতে সাইন-ইন করতে পারেন</translation>
<translation id="4037729269678342163">João Browser সাড়া দিচ্ছে না৷ আবার শুরু করবেন?</translation>
<translation id="7563750688920581112">আপনার সংস্থা, <ph name="MANAGER" />-এর প্রয়োজন অনুযায়ী, আপনাকে João Browser-এ সাইন-ইন করতে হবে</translation>
<translation id="193439633299369377">আপডেটটি প্রয়োগ করতে ChromiumOS আবার চালু করা প্রয়োজন।</translation>
<translation id="7099143775283792684">এই ধরনের ফাইল সাধারণত ডাউনলোড করা হয় না এবং এটি বিপজ্জনক হতে পারে, তাই João Browser এই ডাউনলোডটি ব্লক করে দিয়েছে</translation>
<translation id="1953553007165777902">ডাউনলোড হচ্ছে... <ph name="MINUTE" /> মিনিট বাকি আছে</translation>
<translation id="1966382378801805537">Chromium ডিফল্ট ব্রাউজার নির্ধারণ বা সেট করতে পারছে না</translation>
<translation id="197326043290947695">'ছবি সার্চ করা' ফিচার ব্যবহার করে আরও স্মার্ট ব্রাউজিং করুন</translation>
<translation id="6185556991023272801">João Browser কিছু ফাইল কেন ব্লক করে, নতুন ট্যাবে খোলে সেই সম্পর্কে জানুন</translation>
<translation id="4053636705816895911">আপনার João Browser সফ্টওয়্যার আপ-টু-ডেট রাখুন। এই পরিষেবা অ্যাক্টিভ না থাকলে বা বন্ধ হয়ে গেলে, João Browser সফ্টওয়্যার আপ-টু-ডেট থাকবে না, তার মানে হল নিরাপত্তা সম্পর্কিত ঝুঁকি থাকতে পারে যা সমাধান করা যাবে না এবং ফিচার কাজ নাও করতে পারে। কোনও João Browser সফ্টওয়্যার এটির ব্যবহার না করলে এই পরিষেবা নিজে থেকে আনইনস্টল হয়।</translation>
<translation id="2008474315282236005">এটি এই ডিভাইস থেকে ১টি আইটেম মুছে দেবে। আপনার ডেটা পরে পুনরুদ্ধার করার জন্য, Chromium-এ <ph name="USER_EMAIL" /> হিসেবে সাইন-ইন করুন।</translation>
<translation id="2018879682492276940">ইনস্টল করা যায়নি। আবার চেষ্টা করুন।</translation>
<translation id="2039417478970545937">সেটিংস।</translation>
<translation id="2049376729098081731">Google পরিষেবাতে আরও পছন্দমতো অভিজ্ঞতার জন্য Chromium ইতিহাস অন্তর্ভুক্ত করবেন কিনা তা বেছে নিন</translation>
<translation id="6768767091114123654">আপনাকে শক্তিশালী পাসওয়ার্ড তৈরি, সেভ ও অটোফিল করতে সাহায্য করার জন্য João Browser-এ ইন-বিল্ট রয়েছে। সহজে অ্যাক্সেস করার জন্য শর্টকাট যোগ করুন</translation>
<translation id="3571664229232252557">João Browser-কে নতুন লুক দিতে নতুন ট্যাব পৃষ্ঠায় 'João Browser কাস্টমাইজ করুন' বোতামে ক্লিক করুন</translation>
<translation id="4273287215573278663">এই ফাইলটি প্রতারণামূলক এবং এটি ডিভাইসে অপ্রত্যাশিত পরিবর্তন করে দিতে পারে, তাই João Browser এই ডাউনলোডটি ব্লক করে দিয়েছে</translation>
<translation id="9063967192437499581">পরেরবার João Browser iOS খোলার সময় আপনি <ph name="FEATURE_NAME" /> ব্যবহার করে দেখার প্রম্পট দেখতে পাবেন।</translation>
<translation id="8511569826706775962">আপনার Google অ্যাকাউন্টে সেভ করেছেন এমন পাসওয়ার্ড ও João Browser-এর অন্যান্য ডেটা এই ডিভাইস থেকে সরানো হবে। João Browser-এ সেগুলি পুনরায় ব্যবহার করতে, আবার সাইন-ইন করুন।</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{João Browser ১ মিনিট ধরে ব্যবহার না করলে, আপনার সংস্থা অটোমেটিক এটির ব্রাউজ করা ডেটা মুছে দেয়। এর মধ্যে ইতিহাস, অটোফিল এবং ডাউনলোড সংক্রান্ত ডেটা থাকতে পারে। আপনার ট্যাব খোলা থাকবে।}one{João Browser # মিনিট ধরে ব্যবহার না করলে, আপনার সংস্থা অটোমেটিক এটির ব্রাউজ করা ডেটা মুছে দেয়। এর মধ্যে ইতিহাস, অটোফিল এবং ডাউনলোড সংক্রান্ত ডেটা থাকতে পারে। আপনার ট্যাব খোলা থাকবে।}other{João Browser # মিনিট ধরে ব্যবহার না করলে, আপনার সংস্থা অটোমেটিক এটির ব্রাউজ করা ডেটা মুছে দেয়। এর মধ্যে ইতিহাস, অটোফিল এবং ডাউনলোড সংক্রান্ত ডেটা থাকতে পারে। আপনার ট্যাব খোলা থাকবে।}}</translation>
