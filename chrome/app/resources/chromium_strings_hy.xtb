<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="1026101648481255140">Վերսկսել տեղադրումը</translation>
<translation id="1029669172902658969">Վերագործարկել՝ &amp;ChromiumOS-ը թարմացնելու համար</translation>
<translation id="4711726241445951349">João Browser-ը խորհուրդ է տալիս ստուգել այս ընդլայնումը</translation>
<translation id="1042552502243217427">Երբ որևէ կայք հայցում է էջերի անանուն նախաբեռնում իր էջում առկա հղումների միջոցով, Chromium-ը օգտագործում է Google-ի սերվերները։ Այդպիսով ձեր անձնական տվյալները չեն փոխանցվում, սակայն Google-ը իմանում է, թե որ կայքերն են նախապես բեռնվում։</translation>
<translation id="1051793555070215510">Օգնեք մեզ բարելավել ինկոգնիտո ռեժիմը՝ անցնելով այս 1 րոպեանոց հարցումը։</translation>
<translation id="1065672644894730302">Ձեր նախասիրությունները չի հաջողվում ստանալ:

Որոշ գործառույթներ կարող են մատչելի չլինել: Նախընտրանքների փոփոխությունները չեն պահպանվի:</translation>
<translation id="3937976866851867994">Ձեր ծնողն անջատել է «Թույլտվություններ կայքերի, հավելվածների և ընդլայնումների համար» պարամետրը João Browser-ում</translation>
<translation id="8626021334348319355">João Browser-ի որոշակի գործառույթ կամ ընդլայնում որոնելու համար հասցեագոտում մուտքագրեք դրա դյուրանցումը, ապա՝ ձեր ընտրած ստեղնը</translation>
<translation id="9157778882771986870">João Browser-ն ուզում է արտահանել ձեր գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="112640046208448578">Նույնականացրեք իրեր կամ վայրեր և պատճենեք կամ թարգմանեք տեքստեր։ Երբ օգտագործում եք «Որոնում պատկերով» գործառույթը, էջի սքրինշոթն ուղարկվում է սերվերին։ <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium-ը ձեր կանխադրված դիտարկիչն է</translation>
<translation id="1131805035311359397">Որպեսզի պաշտպանեք ձեր գաղտնաբառերը տվյալների արտահոսքից և խուսափեք անվտանգության հետ կապված այլ խնդիրներից, <ph name="BEGIN_LINK" />մտեք հաշիվ Chromium դիտարկիչում<ph name="END_LINK" />։</translation>
<translation id="2795895511109336240">Սեղմեք João Browser-ի ընտրացանկը</translation>
<translation id="1157985233335035034">Վերջերս ընտրված լեզուներ</translation>
<translation id="1184145431117212167">Տեղադրումը ձախողվեց, քանի որ Windows-ի ձեր տարբերակը չի աջակցվում։</translation>
<translation id="1185134272377778587">Chromium-ի մասին</translation>
<translation id="667420476518265356">Ստացեք գների հետագծման ծանուցումներ ձեր հեռախոսի João Browser դիտարկիչում</translation>
<translation id="1203500561924088507">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME" />-ն օգտագործելը դուք պետք է վերագործարկեք ձեր դիտարկիչը։</translation>
<translation id="1232234696885483911">Երբ բացեք «Որոնում պատկերով» գործառույթը, էջի վերնագիրը, URL-ը և բովանդակությունը՝ ներառյալ PDF-ները, ավտոմատ կուղարկվեն սերվերին։ <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">Հաշիվ մուտք գործած ժամանակ João Browser-ում դուք կարող եք օգտագործել ձեր գաղտնաբառերն ու մյուս կարգավորումները ձեր Google հաշվից։ Այս կարգավորումը փոխելու համար անցեք «Ձեր հաշիվը João Browser-ում» բաժին։</translation>
<translation id="4866003137980530528">Ցույց տալ «Gemini-ը João Browser-ում» հավելվածը Mac-ի ընտրացանկի գոտում</translation>
<translation id="2526294198551578217">«Gemini-ը João Browser-ում» հավելվածում էկրանի մի մասն ընտրելու համար օգտագործել ստեղնային դյուրանցում։</translation>
<translation id="7068536367561625920">Մինչ այս ներդիրն ակտիվ չէր, João Browser-ի աշխատանքի արագությունը պահպանելու համար տարածք է ազատվել։ Դուք կարող եք ընտրել, որ այս կայքը միշտ ակտիվ մնա։</translation>
<translation id="3669854427836618143">João Browser-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը վտանգավոր է</translation>
<translation id="126567311906253476">Երբ <ph name="USER_EMAIL" /> հաշվի միջոցով մուտք եք գործում Google-ի ծառայություններ, օր․՝ Gmail կամ YouTube, նույն հաշվի միջոցով կարող եք ավտոմատ մուտք գործել Chrome</translation>
<translation id="8094399825947986050">Ներբեռնեք João Browser-ը ձեր հեռախոսում</translation>
<translation id="1290883685122687410">Կարգավորման սխալ՝ <ph name="METAINSTALLER_EXIT_CODE" />։ <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">Կարգավորեք João Browser-ի ձեր նոր պրոֆիլը</translation>
<translation id="7591029065989504977">Փորձել Gemini-ը João Browser-ում</translation>
<translation id="8408989583029959522">João Browser-ին անհրաժեշտ է Bluetooth-ի հասանելիություն՝
 Bluetooth սարքեր որոնելու համար։ <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">Մուտք գործեք João Browser ձեր հեռախոսում</translation>
<translation id="1330562121671411446">Ճանաչել լեզուն</translation>
<translation id="6026568602942276348">Նաև հեռացնել տվյալները João Browser-ից (<ph name="URL" />)</translation>
<translation id="1345251407431278948">«Որոնում պատկերով» գործառույթն ամրացված է․ այն բացելու համար օգտագործեք գործիքագոտու նոր կոճակը</translation>
<translation id="1356661055722410047">Նորույթ․ դուք կարող եք ձեր էկրանին թարգմանել ինչպես տեքստ, այնպես էլ պատկերներ</translation>
<translation id="1383876407941801731">Որոնում</translation>
<translation id="5807085300679014096">Շարունակեք դիտարկումը João Browser հավելվածի միջոցով՝ շարժման մեջ</translation>
<translation id="141901961143729572">Կիսվեք ձեր մտքերով</translation>
<translation id="3736947618013031173">Ձեր պատուհանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը João Browser-ի համար։</translation>
<translation id="1478370723027452770">Ստանալ օգնություն Chrome for Testing-ի միջոցով</translation>
<translation id="1497802159252041924">Տեղադրման սխալ՝ <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Այս էջը պաշտպանված է</translation>
<translation id="4379865404970367448">Կիսվեք João Browser-ի ներդիրով</translation>
<translation id="4436275659297289591">Մուտք գործել João Browser</translation>
<translation id="1547469039832541117">Ավարտում է ընդգծված առաջադրանքը։</translation>
<translation id="449712764049695153">Ամրացնել João Browser-ը</translation>
<translation id="1574377791422810894">Chromium-ի անվտանգության գործիքներ</translation>
<translation id="5480232403718129394">João Browser-ը ուզում է ջնջել Գաղտնաբառերի կառավարչի ձեր տվյալները։ Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը։</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել João Browser-ը}=1{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել João Browser-ը։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել João Browser-ը։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել João Browser-ը։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="980976428162070137">Օգտվեք Google-ի բոլոր առավելություններից ձեր հեռախոսի João Browser հավելվածի միջոցով</translation>
<translation id="1625909126243026060">Դիտեք գաղտնիության և անվտանգության հիմնական կառավարման տարրերը Chromium-ում։</translation>
<translation id="1640672724030957280">Ներբեռնում…</translation>
<translation id="1665602916345474427">Մուտք եք գործել որպես <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, բաժանորդագրություն։ Բացել հաշվի ընտրացանկը</translation>
<translation id="1708414395296835197">Օգտագործեք Chromium-ը ցանկացած ժամանակ, երբ սեղմում եք հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում առկա հղումների վրա։ Այն նաև կամրացվի հավելվածների վահանակում։</translation>
<translation id="1709772298389099340">Ընդլայնված արտոնություններ է տալիս <ph name="BROWSER_NAME" />-ին։</translation>
<translation id="1722488837206509557">Սա ձեզ թույլ կտա ընտություն կատարել հասանելի սարքերից և բովանդակություն ցուցադրել այդ սարքերում։</translation>
<translation id="6972087163510342335">João Browser-ը շուտով կջնջի դիտարկման տվյալները</translation>
<translation id="1736443181683099871">Chromium-ը կփորձի անցնել HTTPS հաղորդակարգի</translation>
<translation id="3879288383593333401">João Browser-ի տվյալները մաքրվեցին</translation>
<translation id="656496276885630888">João Browser-ը կվերագործարկվի <ph name="REMAINING_TIME" />ից</translation>
<translation id="1749104137266986751">Երբ HTTPS հաղորդակարգը հասանելի չէ, Chromium-ը առանց ձեզ զգուշացնելու կօգտագործի ոչ ապահով միացում</translation>
<translation id="1226290419185955779">Թույլ տալ João Browser-ին աշխատել հետնաշերտում</translation>
<translation id="4231366995273072370">João Browser-ն ավելի ապահով դարձնելու համար որոշ ընդլայնումներ, որոնք նշված չեն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ում և կարող են ավելացվել առանց ձեր իմացության, անջատվել են։</translation>
<translation id="1822049153969905781">Սեղմեք <ph name="BEGIN_BOLD" />Այո<ph name="END_BOLD" /> Windows-ի ծանուցման մեջ՝ João Browser-ը հավելվածների վահանակում ամրացնելու համար։</translation>
<translation id="1321831992638405531">Նորից տեղադրել João Browser-ը</translation>
<translation id="3386967202064865436">João Browser-ը փորձում է <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="70054449700528483">Հաջորդ անգամ, երբ ձեր <ph name="DEVICE_TYPE" /> սարքում բացեք João Browser-ը, կտեսնեք Google գաղտնաբառերի կառավարիչն օգտագործելու հրավեր։</translation>
<translation id="1838374766361614909">Մաքրել որոնումը</translation>
<translation id="5807096362853316123">Այցելությունների պատմությունը միայն այս սարքից ջնջելու, սակայն Google հաշվում պահպանելու համար <ph name="BEGIN_LINK" />դուրս եկեք João Browser-ից<ph name="END_LINK" />։</translation>
<translation id="6396384011117650379">Ներբեռնեք João Browser-ը հեռախոսում՝ ցանկացած վայրից ներդիրների նոր խմբեր բացելու կամ ստեղծելու համար։</translation>
<translation id="185970820835152459">Դուք կարող եք կառավարել ձեր Google հաշիվները, որոնցում մուտք եք գործել։ Դրանք օգտագործվում են Chromium դիտարկիչում, Play Խանութում, Gmail-ում և այլ ծառայություններում։ Եթե ուզում եք ընտանեկան խմբի անդամի կամ մեկ ուրիշի համար հաշիվ ավելացնել, <ph name="DEVICE_TYPE" /> սարքում ավելացրեք նոր օգտատեր։ <ph name="LINK_BEGIN" />Իմանալ ավելին<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Որոնել «Որոնում պատկերով» գործառույթի միջոցով</translation>
<translation id="65457771685016683"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք João Browser <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Ձեզ նաև հասանելի կլինեն էջանիշները և այլ տվյալներ <ph name="DEVICE" />։</translation>
<translation id="1880677175115548835">Ընտրեք տեքստը</translation>
<translation id="2634119629547215883">Դուք մուտք եք գործում վերահսկվող հաշիվ` թույլ տալով ադմինիստրատորին վերահսկել ձեր João Browser պրոֆիլը: Ձեր João Browser տվյալները, ինչպես օրինակ՝ հավելվածները, էջանիշները, պատմությունը, գաղտնաբառերը և այլ կարգավորումները մշտապես կկցվեն <ph name="USER_NAME" />-ին: Դուք կարող եք ջնջել այս տվյալները Google Dashboard-ի միջոցով, սակայն չեք կարող համակցել այս տվյալները այլ հաշվի հետ: Կարող եք ստեղծել նոր պրոֆիլ՝ ձեր առկա João Browser տվյալներն առանձին պահելու համար: <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium-ը տնտեսում է մարտկոցի լիցքը՝ սահմանափակելով աշխատանքը ֆոնային ռեժիմում և վիզուալ էֆեկտները, օրինակ՝ սահուն ոլորումը և տեսանյութերի կադրերի հաճախականությունը։ <ph name="BEGIN_LINK" />Իմանալ ավելին Էներգիայի խնայման մասին<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">João Browser Updater ծառայություն</translation>
<translation id="1911763535808217981">Անջատելով այս գործառույթը՝ դուք կարող եք մտնել հաշիվ Google-ի կայքերում, օրինակ՝ Gmail, առանց մուտք գործելու Chromium:</translation>
<translation id="4037729269678342163">João Browser-ը չի պատասխանում: Վերագործարկե՞լ:</translation>
<translation id="7563750688920581112">Ձեր կազմակերպության (<ph name="MANAGER" />) կանոնների համաձայն՝ դուք պետք է մուտք գործեք João Browser</translation>
<translation id="193439633299369377">Թարմացումը կիրառելու համար հարկավոր է վերագործարկել ChromiumOS-ը։</translation>
<translation id="7099143775283792684">João Browser-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլի այս տեսակը հազվադեպ է ներբեռնվում, և այն կարող է վտանգավոր լինել</translation>
<translation id="1953553007165777902">Ներբեռնում… Մնաց <ph name="MINUTE" /> րոպե</translation>
<translation id="1966382378801805537">Chromium-ը չի կարողանում որոշել կամ սահմանել կանխադրված դիտարկիչը</translation>
<translation id="197326043290947695">Որոնեք ավելի խելացի կերպով «Որոնում պատկերով» գործառույթի միջոցով</translation>
<translation id="6185556991023272801">Իմացեք, թե ինչու է João Browser-ն արգելափակում որոշ ֆայլեր կամ բացում նոր ներդիրում</translation>
<translation id="4053636705816895911">Թարմացնում է João Browser-ի ծրագրակազմը։ Եթե անջատեք կամ դադարեցնեք ծառայությունը, դա կարող է հանգեցնել նրան, որ ի հայտ եկած խոցելիությունները չշտկվեն, և որոշ գործառույթներ չաշխատեն։ Այս ծառայությունն ավտոմատ կհեռացվի, եթե չկա João Browser-ի ծրագրակազմ, որն օգտագործում է այն։</translation>
<translation id="2008474315282236005">1 տարր կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք Chromium <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="2018879682492276940">Չհաջողվեց տեղադրել։ Նորից փորձեք։</translation>
<translation id="2039417478970545937">Կարգավորումներ։</translation>
<translation id="2049376729098081731">Ընտրեք, թե արդյոք ներառել Chromium-ի պատմությունը՝ Google-ի ծառայությունների ավելի անհատականացված օգտագործման համար։</translation>
<translation id="6768767091114123654">Ներկառուցված է João Browser-ում՝ օգնելու ձեզ ստեղծել, պահել և ավտոմատ լրացնել հուսալի գաղտնաբառեր։ Ավելացրեք դյուրանցումը՝ արագ մուտքի համար։</translation>
<translation id="3571664229232252557">Սեղմեք «Անհատականացնել João Browser-ը» կոճակը նոր ներդիրի էջում՝ João Browser-ին նոր տեսք հաղորդելու համար</translation>
<translation id="4273287215573278663">João Browser-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը կասկածելի է և կարող է անսպասելի փոփոխություններ կատարել ձեր սարքում</translation>
<translation id="9063967192437499581">Հաջորդ անգամ João Browser iOS-ը բացելիս կտեսնեք <ph name="FEATURE_NAME" /> գործառույթը փորձելու հրավեր։</translation>
<translation id="8511569826706775962">Ձեր գաղտնաբառերն ու João Browser-ի մյուս տվյալները, որոնք պահել եք ձեր Google հաշվում, կհեռացվեն այս սարքից։ João Browser-ում դրանք նորից օգտագործելու համար պետք է կրկին մուտք գործեք։</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ João Browser-ը 1 րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Ձեր ներդիրները բացված կմնան։}one{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ João Browser-ը # րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Ձեր ներդիրները բացված կմնան։}other{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ João Browser-ը # րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Ձեր ներդիրները բացված կմնան։}}</translation>
<translation id="2125838419757773031">Որոնելու համար ընտրեք էկրանի տարածքը</translation>
<translation id="2126108037660393668">Ներբեռնված ֆայլը չանցավ հաստատումը։</translation>
<translation id="2135919691573380097">Հաղորդել այս կայքի մասին</translation>
<translation id="2137162749895930932">Փակել թարգմանել պատուհանը</translation>
<translation id="1308845716497059117">João Browser-ն արգելափակել է այս ներբեռնումը, քանի որ կայքը չի օգտագործում անվտանգ կապ, և ֆայլում, հնարավոր է, չարտոնված գործողություններ են կատարվել</translation>
<translation id="2170098639895543546">Ընտրեք ցանկացած բան էջում</translation>
<translation id="6705844023496387932">Անհատականացնել João Browser-ը</translation>
<translation id="2174917724755363426">Տեղադրումը չի ավարտվել։ Իսկապե՞ս ուզում եք չեղարկել։</translation>
<translation id="7728290795259244895">João Browser – Ցանցի մուտք – <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Թարմացումների ստուգման սխալ՝ <ph name="UPDATE_CHECK_ERROR" />։</translation>
<translation id="3486802320473595711">Հեռացնել հաշիվը João Browser-ից</translation>
<translation id="4648870374540039667">Օգտագործեք João Browser հավելվածը՝ գնումների համար լավագույն գործիքներից շարժման մեջ օգտվելու համար</translation>
<translation id="2106116820042118250">iOS-ի համար João Browser-ում բարելավված Ապահով դիտարկումը կօգնի պաշտպանել բջջային սարքերի տվյալները</translation>
<translation id="2210682093923538346">Վտանգավոր կայք։ Chromium-ը հեռացրել է ծանուցումների թույլտվությունը։</translation>
<translation id="2236949375853147973">Իմ գործողությունները</translation>
<translation id="118764235932893741">Հասցեները և այլ տվյալներ ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք João Browser։ Այս հասցեն կպահվի ձեր Google հաշվում, երբ մուտք գործեք։</translation>
<translation id="7254578863532089400">Եթե ձեզնից բացի որևէ այլ մեկն օգտվում է այս համակարգչից, օրինակ ձեր ընկերները կամ հարազատները, ապա նրանք կարող են առանձին աշխատել և կարգավորել João Browser-ն իրենց ուզած ձևով:</translation>
<translation id="22571759390241347">Հմտություններ Chromium-ում</translation>
<translation id="2283803047247799269">Որոնել այս ներդիրը պատկերով որոնման միջոցով</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{João Browser-ը խորհուրդ է տալիս դադարեցնել ներդիրը, որը դադաղեցնում է ձեր դիտարկիչը}one{João Browser-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}other{João Browser-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}}</translation>
<translation id="2307973900865360088">Ամրացնել Dock վահանակի վրա</translation>
<translation id="2313870531055795960">Ստուգում է URL-ները Chromium-ում պահված վտանգավոր կայքերի ցանկի միջոցով։ Եթե կայքը փորձում է գողանալ ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, Chromium-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ անվտանգ դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="2356070529366658676">Հարցնել</translation>
<translation id="2359808026110333948">Շարունակել</translation>
<translation id="3800730051093461113">«<ph name="EXTENSION_NAME" />» ընդլայնումն ուզում է, որ դուք մուտք գործեք João Browser</translation>
<translation id="8758735062658446604">Անջատել João Browser-ի ֆոնային ռեժիմը հավելվածների համար</translation>
<translation id="2623595027619107207">Այս ընդլայնումը որպես <ph name="USER_EMAIL_ADDRESS" /> օգտագործելու համար մուտք գործեք João Browser։</translation>
<translation id="2384373936468275798">ChromiumOS-ին չհաջողվեց համաժամացնել տվյալները, քանի որ ձեր հաշվի մուտքի տվյալները հնացած են։</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{João Browser-ի մեկ կամ մի քանի ընդլայնում ստացել է 1 HID սարքի հասանելիություն}=1{João Browser-ի մեկ կամ մի քանի ընդլայնման հասանելի է 1 HID սարք}one{João Browser-ի մեկ կամ մի քանի ընդլայնման հասանելի է # HID սարք}other{João Browser-ի մեկ կամ մի քանի ընդլայնման հասանելի է # HID սարք}}</translation>
<translation id="6254788431480237503">Այս կայքի համար João Browser-ին անհրաժեշտ է խոսափողն ու տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="2403703063067034158">Մեկնարկի սխալ․ ներկայումս կարգավորման մեկ այլ օրինակ է աշխատում։ Փորձեք ավելի ուշ։</translation>
<translation id="3028975423343897358">Բացեք հղումները João Browser-ում ցանկացած հավելվածից և պահեք դիտարկիչը հավելվածների վահանակում՝ հեշտ մուտքի համար</translation>
<translation id="579079006139156831">Սեղմեք «Ամփոփել» կոճակը՝ այս փաստաթղթով Gemini-ի հետ João Browser-ում կիսվելու համար, որպեսզի ստանաք համառոտ նկարագրություն և լրացուցիչ հարցեր տաք</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Chromium-ի գործիքների<ph name="END_LINK" /> միջոցով դուք կարող եք ապահով դիտարկել և կառավարել կարգավորումները</translation>
<translation id="7114471809991869757"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք João Browser <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Գաղտնաբառերը և մյուս տվյալները նույնպես կհայտնվեն ձեր բոլոր սարքերում։</translation>
<translation id="2451727308784734061">Արագ բացեք Գաղտնաբառերի կառավարիչը դյուրանցման միջոցով։ Դյուրանցումը կարող եք տեղափոխել համակարգչի հիմնական էկրան կամ հավելվածների գործարկիչ։</translation>
<translation id="2709136733469807397">João Browser-ը շուտով կփակվի</translation>
<translation id="3652225684487279741">João Browser-ի մեջ</translation>
<translation id="2485422356828889247">Ապատեղադրել</translation>
<translation id="2513154137948333830">Հարկավոր է վերաբեռնել. <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Ընտրեք տեքստ «Որոնում պատկերով» գործառույթի միջոցով</translation>
<translation id="1527474262707362156">João Browser-ը փորձում է փոխարինել գոյություն ունեցող գաղտնաբառերը։ Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը։</translation>
<translation id="6480371226914552131">Ֆայլեր ներբեռնելու համար João Browser-ին անհրաժեշտ է պահեստի օգտագործման թույլտվություն</translation>
<translation id="6318568902186985084">João Browser օգնական</translation>
<translation id="2575822587468774919">Ընտրեք ցանկացած բան՝ «Որոնում պատկերով» գործառույթի միջոցով որոնելու համար</translation>
<translation id="4557210258834653476">Գաղտնաբառերը և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք João Browser</translation>
<translation id="1148164459654218834">Հեռախոսով սկանավորեք QR կոդը՝ João Browser-ը ներբեռնելու և ձեր Google հաշիվ մուտք գործելու համար։</translation>
<translation id="235892353478111963">Շարունակել João Browser-ի օգտագործումը</translation>
<translation id="259935314519650377">Չհաջողվեց քեշավորել ներբեռնված տեղադրիչը։ Սխալ՝ <ph name="UNPACK_CACHING_ERROR_CODE" />։</translation>
<translation id="2620436844016719705">Համակարգ</translation>
<translation id="8471946631262724853">Ձեր կազմակերպությունը կարող է տեսնել և կառավարել այցելությունների պատմությունը, օրինակ՝ էջանիշները, պատմությունը և գաղտնաբառերը։ João Browser-ի անձնական պրոֆիլներում այցելությունների պատմությունը հասանելի չի լինի ձեր կազմակերպությանը։</translation>
<translation id="2870759219964376597">Հաստատեք ձեր ինքնությունը, որպեսզի օգտագործեք և պահեք João Browser-ի տվյալները ձեր <ph name="ACCOUNT_EMAIL" /> հաշվում</translation>
<translation id="2955972712254986678">{COUNT,plural, =0{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել João Browser-ը}=1{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել João Browser-ը։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել João Browser-ը։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել João Browser-ը։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="8949462882238006192">Գործարկել João Browser-ը</translation>
<translation id="4224214204752803768">Տեղադրման ժամանակ օպերացիոն համակարգի սխալ տեղի ունեցավ: Նորից տեղադրեք João Browser-ը:</translation>
<translation id="3141414135710372892">Եթե ձեզնից բացի որևէ այլ օգտատեր օգտվում է այս սարքից (օրինակ՝ ձեր ընկերները կամ հարազատները), ապա նրանք կարող են առանձին աշխատել և անհատականացնել João Browser-ը</translation>
<translation id="8838607803339100223">Թույլ է տալիս արագ բացել «Gemini-ը João Browser-ում» հավելվածը ձեր սարքում, նույնիսկ եթե João Browser-ը ծալված է։</translation>
<translation id="1679364578146271696">João Browser-ի ներդիր</translation>
<translation id="2718390899429598676">Լրացուցիչ անվտանգության համար Chromium-ը կգաղտնագրի ձեր տվյալները:</translation>
<translation id="1874696651662237927">Ձեր Google հաշիվը João Browser-ից հեռացնելու համար դուրս եկեք հաշվից</translation>
<translation id="6850669719663104304">Գաղտնաբառերը, էջանիշները և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք João Browser</translation>
<translation id="2738871930057338499">Հնարավոր չէ միանալ ինտերնետին։ HTTP 403 Forbidden։ Ստուգեք ձեր պրոքսի սերվերի կազմաձևը։</translation>
<translation id="2753623023919742414">Սեղմեք որոնելու համար</translation>
<translation id="4193420110872590792">Սահմանեք João Browser-ը որպես ձեր կանխադրված PDF դիտակ</translation>
<translation id="6614401181366354261">Այս ընդլայնումը պարունակում է վնասագիր և վտանգավոր է։ Հեռացրեք ընդլայնումը João Browser-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="2799223571221894425">Վերագործարկել</translation>
<translation id="6299858290790311689">Ձեր João Browser-ը</translation>
<translation id="2816462166102338036">Որոնել այս տեսանյութը պատկերով որոնման միջոցով</translation>
<translation id="5896458971800337862">Գտեք ապրանքներ ձեր տեսախցիկի օգնությամբ, հետևեք գնիջեցումներին և ավելին արեք շարժման մեջ՝ iOS-ի համար João Browser հավելվածի միջոցով։</translation>
<translation id="2841525013647267359">Թարգմանվող լեզու</translation>
<translation id="2846251086934905009">Տեղադրման սխալ. չհաջողվեց ավարտել տեղադրումը։ Գործընթացն ընդհատվել է։</translation>
<translation id="4357241592510111611">Հեռացնել João Browser-ից...</translation>
<translation id="2850691299438350830">Ապահովում է ձեր անվտանգությունը Chromium-ում և Google հավելվածներում, երբ մտել եք ձեր հաշիվ։</translation>
<translation id="2885378588091291677">Task Manager</translation>
<translation id="8887040619780090085">&amp;João Browser-ի մասին</translation>
<translation id="2915996080311180594">Վերագործարկել ավելի ուշ</translation>
<translation id="6619708652934279502">Ձեր տվյալները գաղտնագրված են անցաբառով։ João Browser-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը։</translation>
<translation id="2945997411976714835">Տեղադրման սխալ. չհաջողվեց սկսել տեղադրումը։</translation>
<translation id="4566114009566397386">Ավելի արագ մուտք գործեք կայքեր՝ օգտագործելով iOS-ի համար João Browser-ում պահված գաղտնաբառերը</translation>
<translation id="562175540137901632">João Browser-ը կառավարվում է ձեր կազմակերպության կողմից</translation>
<translation id="2977470724722393594">Chromium-ը թարմացված է</translation>
<translation id="2977506796191543575">Եթե կայքը փորձում է գողանալ ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, Chromium-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ Ապահով դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="1776205510657237623">Ձեր ծնողների ընտրած ավելի անվտանգ կարգավորումներն օգտագործելու համար մուտք գործեք João Browser</translation>
<translation id="3003694935412297923">Բոլոր առաջադրանքները</translation>
<translation id="3374694374267805392">{count,plural, =1{Որպեսզի որոշ տվյալներ հնարավոր լինի պահել Google հաշվում, և դուք կարողանաք օգտագործել դրանք ձեր բոլոր սարքերում, João Browser-ը նախ պետք է հաստատի ձեր ինքնությունը։ Եթե դուրս գաք հիմա, այս տվյալները (1 տարր) կջնջվեն։}one{Որպեսզի որոշ տվյալներ հնարավոր լինի պահել Google հաշվում, և դուք կարողանաք օգտագործել դրանք ձեր բոլոր սարքերում, João Browser-ը նախ պետք է հաստատի ձեր ինքնությունը։ Եթե դուրս գաք հիմա, այս տվյալները ({count} տարր) կջնջվեն։}other{Որպեսզի որոշ տվյալներ հնարավոր լինի պահել Google հաշվում, և դուք կարողանաք օգտագործել դրանք ձեր բոլոր սարքերում, João Browser-ը նախ պետք է հաստատի ձեր ինքնությունը։ Եթե դուրս գաք հիմա, այս տվյալները ({count} տարր) կջնջվեն։}}</translation>
<translation id="4915792193596835645">Բացել <ph name="URL" /> հղումը João Browser-ի նոր ներդիրում։</translation>
<translation id="302551344979399011">ԱԲ նորարարությունները, օրինակ՝ հմտությունները, պահվում են ձեր Google հաշվում և կառավարվում են Chromium-ի համաժամացումից առանձին</translation>
<translation id="8367114375553489372">Ավելացվում է João Browser-ին…</translation>
<translation id="3038232873781883849">Սպասում ենք տեղադրմանը…</translation>
<translation id="3045032126857188731">Թարգմանության լեզուն՝ <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Փակել կարծիքով երկխոսության պատուհանը</translation>
<translation id="6168172692486433600">João Browser-ի այլ պրոֆիլներ</translation>
<translation id="884929993636327">Ընդլայնումները հավելումներ են, որոնք թույլ են տալիս անհատականացնել João Browser-ը։ Դրանք օգնում են կազմակերպել աշխատանքը, պարզեցնել առօրյա առաջադրանքները և անհատականացնել João Browser-ը։</translation>
<translation id="1525897524206034002">Օգնեք բարելավել João Browser-ը՝ Google-ին ուղարկելով խափանման մասին հաշվետվությունները և <ph name="UMA_LINK" />ը</translation>
<translation id="2766971658743453990">Օգտագործեք Google-ի անվտանգության գործառույթները João Browser հավելվածի միջոցով՝ շարժման մեջ</translation>
<translation id="4387884830246074210">{NUM_DEVICES,plural, =0{João Browser-ի մեկ կամ մի քանի ընդլայնում ստացել է 1 USB սարքի հասանելիություն}=1{João Browser-ի մեկ կամ մի քանի ընդլայնման հասանելի է 1 USB սարք}one{João Browser-ի մեկ կամ մի քանի ընդլայնման հասանելի է # USB սարք}other{João Browser-ի մեկ կամ մի քանի ընդլայնման հասանելի է # USB սարք}}</translation>
<translation id="3413144813287436446">João Browser-ի պատմություն</translation>
<translation id="9192419056064225629">Տեղադրիչը չկարողացավ բացել արխիվը: Նորից ներբեռնեք João Browser-ը:</translation>
<translation id="310459126943037700">Չհաջողվեց ավարտել առաջադրանք(ներ)ը։</translation>
<translation id="3104828284009500087">Որոնեք ցանկացած բան էջում</translation>
<translation id="3508468328135806512">Ձեր գաղտնաբառերը, էջանիշները և պատմությունը կհամաժամացվեն ձեր բոլոր սարքերում։ Հեշտությամբ օգտագործեք ձեզ ծանոթ և սիրելի գործառույթները՝ որպես կանխադրված դիտարկիչ ընտրելով João Browser-ը։</translation>
<translation id="3216151988142306917">João Browser-ն օգտագործում է ձեր խոսափողը:</translation>
<translation id="3130333203120345554">Նոր որոնում</translation>
<translation id="3137969841538672700">Քաշեք որոնելու համար</translation>
<translation id="7493177208577109722">Այս ներդիրն օգտագործում է լրացուցիչ ռեսուրսներ։ Թույլատրեք João Browser-ին ապակտիվացնել այն, և աշխատանքի արդյունավետությունը կբարձրանա։</translation>
<translation id="7239354789967255675">Ձեր էկրանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը João Browser-ի համար</translation>
<translation id="4955872590603594814">João Browser-ի վերագործարկում</translation>
<translation id="3161522574479303604">Բոլոր լեզուները</translation>
<translation id="4697739132113629685">Բացել հղումը João Browser-ի ինկ&amp;ոգնիտո պատուհանում</translation>
<translation id="1629247860984475766">Կարգավորեք João Browser-ի նոր պրոֆիլը</translation>
<translation id="1905008150929775692">Դուք կարող եք շարունակել զրույցը ԱԲ ռեժիմում՝ առանց մեկ ներդիրից մյուսն անցնելու։ Սկսելու համար մուտք գործեք João Browser։ Ձեր գաղտնաբառերը և այլ տվյալներ նույնպես հասանելի կլինեն բոլոր սարքերում։</translation>
<translation id="4232381420311815141">Ձեր Google հաշիվը João Browser-ից հեռացնելու համար դուրս եկեք João Browser-ից «Կարգավորումներ» էջում</translation>
<translation id="3234316605225071811">Հետագայում Chromium-ը կարող է հարցնել, թե արդյոք ուզում եք օգտագործել պահված տեղեկությունները ձևերի ավտոմատ լրացման համար</translation>
<translation id="6676749542734993844">João Browser-ը չի կարող կարդալ և գրել իր տվյալների գրացուցակում՝

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">Օգտագործեք Google-ի ԱԲ գործիքները շարժման մեջ՝ iOS-ի համար João Browser-ի միջոցով։</translation>
<translation id="3286538390144397061">Վերագործարկել հիմա</translation>
<translation id="532528773927600103">Google API-ի բանալիները չկան: João Browser-ի որոշ գործառույթներ կանջատվեն:</translation>
<translation id="3296368748942286671">Շարունակել հետնաշերտի հավելվածների աշխատանքը, երբ Chromium-ը փակված է</translation>
<translation id="3313189106987092621">Նախքան ոչ ապահով միացման միջոցով որևէ կայք բեռնելը Chromium-ը ձեզ կնախազգուշացնի</translation>
<translation id="8095477191923518137">Դուք դուրս կգրվեք կայքերի մեծամասնությունից, երբ փակեք João Browser-ի բոլոր պատուհանները, սակայն կմնաք ձեր Google հաշվում, եթե մուտք եք գործել João Browser։ Որպեսզի թույլ տաք կայքերին հիշել ձեզ, <ph name="SETTINGS_LINK" />։</translation>
<translation id="3352986031709923790">որոնման տարածքի վերևի աջ անկյուն՝ <ph name="RIGHT" />% աջից, <ph name="TOP" />% վերևից</translation>
<translation id="3366305173356742781">Chromium-ի տվյալները ձեր հաշվում</translation>
<translation id="3234882977104294240">Օգտագործեք ձեր գաղտնաբառերը ձեր հեռախոսի João Browser դիտարկիչում</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="2974199599420431595">Անցնե՞լ João Browser-ի ընթացիկ պրոֆիլ</translation>
<translation id="3412460710772753638">Այս սարքի Գաղտնաբառերի կառավարիչում</translation>
<translation id="3438772217992559640">Որոնել այս ներդիրը պատկերով որոնման միջոցով</translation>
<translation id="8318147705317768982">Ընդլայնեք բարելավված Ապահով դիտարկման հնարավորությունները João Browser-ի հետ ձեր հեռախոսում</translation>
<translation id="347392028839310978">João Browser-ի անհատականացում…</translation>
<translation id="3474745554856756813"><ph name="ITEMS_COUNT" /> տարր կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք Chromium <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="5805833167703404998">João Browser-ի այլ պրոֆիլի կարող եք անցնել <ph name="SHORTCUT" /> ստեղների համադրության միջոցով</translation>
<translation id="1835124883585653877">Փակեք João Browser-ի բոլոր պատուհանները և կրկին փորձեք:</translation>
<translation id="7106246566966568195">Ձեր պատուհանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը João Browser-ի համար</translation>
<translation id="6017005873246021363"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։  Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք João Browser <ph name="USER_EMAIL_ADDRESS" /> հաշվով։</translation>
<translation id="1146681170626381319">QR կոդ՝ João Browser դիտարկիչը շարժական սարքերում ներբեռնելու համար</translation>
<translation id="354621070532799440">Հիշեցում․ Google-ի անվտանգության լավագույն գործառույթները ձեր գրպանում</translation>
<translation id="2488701737291439763">Ձեր էկրանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը João Browser-ի համար։</translation>
<translation id="3588112919289558122">Բարելավված պաշտպանությունն անջատում է JavaScript-ի օպտիմալացումը այն կայքերի համար, որոնք Chromium-ը չի ճանաչում</translation>
<translation id="3597003331831379823">Չհաջողվեց գործարկել ընդլայնված արտոնություններով կարգավորումը։ <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">Մուտք գործեք João Browser</translation>
<translation id="5985252758124395804">Այս օգտատիրոջ այցելությունների պատմությունը կհեռացվի այս սարքից։ Տվյալները վերականգնելու համար <ph name="USER_EMAIL" /> հաշվով մուտք գործեք João Browser-ում։</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{João Browser-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։}=1{João Browser-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{João Browser-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{João Browser-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="3667616615096815454">Չհաջողվեց տեղադրել․ հավելվածն անծանոթ է սերվերի համար։</translation>
<translation id="3675854891107786059">Օգտագործեք <ph name="BEGIN_LINK" />ձեր անցաբառը<ph name="END_LINK" />՝ Chromium-ի բոլոր տվյալները Google հաշվում գաղտնագրելու համար։ Վճարման եղանակները և Google Pay-ի հասցեները չեն գաղտնագրվի։ Chromium-ի այցելությունների պատմությունը չի համաժամացվի։</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել João Browser-ը}=1{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել João Browser-ը։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել João Browser-ը։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել João Browser-ը։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="4134769722455445399">Բացել հղումը João Browser-ի նոր &amp;ներդիրում</translation>
<translation id="3728124580182886854">Կապեք Chromium-ը Google-ի մյուս ծառայությունների հետ՝ անհատականացման և այլ գործընթացների համար</translation>
<translation id="3729187154190517324">Որոնումն ընդլայնելու համար ավելացրեք մի քանի ներդիր, ֆայլեր և գործիքներ՝ օգտագործելով «Ավելացնել ներդիր կամ մեկ այլ բան» կոճակը։</translation>
<translation id="655691042235349825">Կառավարել João Browser-ի պրոֆիլները</translation>
<translation id="8494798931804571569">Իմացեք, թե ինչու է João Browser-ն արգելափակում որոշ ներբեռնումներ</translation>
<translation id="379589255253486813">Chromium-ը ձեզ կտեղեկացնի, եթե որևէ բան փոխելու անհրաժեշտություն լինի</translation>
<translation id="3802055581630249637">Chromium-ը նախապես բեռնում է էջերը, որոնք դուք հավանաբար կայցելեք, որպեսզի դրանք ավելի արագ բեռնվեն</translation>
<translation id="3810973564298564668">Կառավարել</translation>
<translation id="6945066279282141856">Պահված գաղտնաբառերն օգտագործելու համար սկանավորեք QR կոդը, ներբեռնեք iOS-ի համար նախատեսված João Browser դիտարկիչը և մուտք գործեք ձեր Google հաշիվ</translation>
<translation id="3846683726093018685">**Ամփոփում։** Մեկ նախադասությամբ մինչև 30 բառի սահմաններում սքրինշոթից նկարագրիր հիմնական թեման և բովանդակության նշանակությունը։

          **Առաջարկվող հարցեր։** Ստեղծիր մտածելու տեղիք տվող 3-5 հարցից բաղկացած կետանշված ցուցակ, որոնք օգտատերը կարող է տալ՝ սքրինշոթն ավելի լավ հասկանալու համար։ Դրանցից առնվազն մեկը պետք է կապված լինի վիզուալ օբյեկտի, դրա դիզայնի կամ տեղակայման հետ։</translation>
<translation id="4996569675441627032"><ph name="PAGE_TITLE" /> - João Browser</translation>
<translation id="6008740052107737825">Այս կայքի համար João Browser-ին անհրաժեշտ է լոկալ ցանցն օգտագործելու թույլտվություն</translation>
<translation id="3885770153807205175">Լեզվի ընտրիչ</translation>
<translation id="2390004682597453662">João Browser-ի կարգավորման և կառավարման համար անհրաժեշտ է ձեր ուշադրությունը։ Սեղմեք՝ մանրամասներին ծանոթանալու համար։</translation>
<translation id="8262407643678629134">Սեղմեք ձեր անվան վրա՝ João Browser-ը բացելու համար:</translation>
<translation id="3892148308691398805">Պատճենել տեքստը</translation>
<translation id="2168201717554927204"><ph name="EXISTING_USER" />-ն արդեն մուտք է գործել João Browser-ի այս պրոֆիլը։ Ձեր դիտարկումների պատմությունն առանձին պահելու համար կարող եք João Browser-ի առանձին պրոֆիլ ստեղծել։</translation>
<translation id="1046732460303790107">Այս ընդլայնումը խախտում է Chrome Web Store-ի քաղաքականությունը և կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը João Browser-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="3941890832296813527">Տեղադրման սխալ. տեղադրման ծրագրի ֆայլի անվանումն անվավեր է կամ չի աջակցվում։</translation>
<translation id="3879366121647289622">João Browser-ը փորձում է պատճենել գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="7332365758981378072">Ձեր գաղտնաբառերը, վճարման եղանակները և հասցեները, որոնք պահել եք ձեր Google հաշվում, կհեռացվեն այս սարքից։ João Browser-ում դրանք նորից օգտագործելու համար պետք է նորից մուտք գործեք։</translation>
<translation id="395904275706073188">Պաշտպանված էջերը հնարավոր չէ ընթերցել։ Փորձեք այլ էջ։</translation>
<translation id="3962647064319009959">Ինչպես է Chromium-ն ապահով պահում ձեր տվյալները</translation>
<translation id="3967822245660637423">Ներբեռնումն ավարտվեց</translation>
<translation id="3971865010372729242">Երբ դուք տեքստ եք մուտքագրում հասցեագոտում կամ որոնման դաշտում, Chromium-ը ձեր հարցումն ուղարկում է ձեր կազմակերպության որոնողական համակարգին, ԱԲ-ին և ագենտային գործիքներին՝ առաջարկներ ստանալու համար։</translation>
<translation id="3975724895399328945">&amp;Google Chrome for Testing-ի մասին</translation>
<translation id="3997429360543082038">ChromiumOS-ի մասին</translation>
<translation id="4010059961270896984">Երբ այցելում եք որևէ կայք, Chromium-ն ուղարկում է URL-ի քողարկված մասը <ph name="BEGIN_LINK" />Google Ապահով դիտարկմանը<ph name="END_LINK" /> գաղտնիության պաշտպանության սերվերի միջոցով, որը թաքցնում է ձեր IP հասցեն։ Եթե կայքը կասկածելի է թվում, Chrome-ը նաև ուղարկում է էջի բովանդակության ամբողջական URL-ները և հատվածները։</translation>
<translation id="4016217212818346953">Եղեք պաշտպանված Գաղտնաբառերի կառավարչի օգնությամբ</translation>
<translation id="4019629340646866719">ChromiumOS-ը ստեղծվել է <ph name="BEGIN_LINK_CROS_OSS" />բաց կոդով ծրագրակազմի<ph name="END_LINK_CROS_OSS" /> հիման վրա, ինչպիսին է <ph name="BEGIN_LINK_LINUX_OSS" />Լինուքսի մշակման միջավայրը<ph name="END_LINK_LINUX_OSS" />։</translation>
<translation id="4022972681110646219">Թարգմանել էկրանը</translation>
<translation id="4023601594785368013">Բնօրինակի լեզուն՝ <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">Հղումները բացեք João Browser-ում ցանկացած հավելվածից։ Հեշտ մուտքի համար դիտարկիչն ամրացվում է խնդրագոտում։</translation>
<translation id="4036079820698952681">Օգնեք կատարելագործել Chromium-ը՝ հաղորդելով <ph name="BEGIN_LINK" />ընթացիկ կարգավորումների<ph name="END_LINK" /> մասին</translation>
<translation id="4050175100176540509">Վերջին տարբերակում առկա են անվտանգության կարևոր բարելավումներ և նոր գործառույթներ:</translation>
<translation id="4055805654398742145">Գ&amp;աղտնաբառերի կառավարիչ</translation>
<translation id="615818333141511791">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ փակում է João Browser-ը, երբ այն 1 րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}one{Ձեր կազմակերպությունն ավտոմատ անջատում է João Browser-ը, երբ այն # րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}other{Ձեր կազմակերպությունն ավտոմատ անջատում է João Browser-ը, երբ այն # րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}}</translation>
<translation id="4118474109249235144">Chromium ինկոգնիտո</translation>
<translation id="4122186850977583290">Անցնել «Chromium-ի մասին» էջ</translation>
<translation id="9207280419664362385">Անհատականացրեք João Browser-ը՝ ձեր դիտարկիչին նոր տեսք հաղորդելու համար</translation>
<translation id="3719803995198923598">Անհատականացրեք ձեր João Browser-ը</translation>
<translation id="4148957013307229264">Տեղադրում…</translation>
<translation id="2954462321765112214"><ph name="PAGE_TITLE" /> – Ցանցի մուտքի էջ – João Browser</translation>
<translation id="7812363663832111420">Հավելվածների, խաղերի, ընդլայնումների և թեմաների լայն ընտրանի João Browser-ի համար:</translation>
<translation id="69200600645763018">Ձեր բոլոր համակարգիչներում այս ընդլայնումը և ավելին ստանալու համար մուտք գործեք João Browser</translation>
<translation id="7505863944027312744">Ձեր ծնողների ընտրած ավելի անվտանգ կարգավորումներն օգտագործելու համար անցեք João Browser պրոֆիլ, որտեղ արդեն մուտք եք գործել որպես <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Չեղարկվում է…</translation>
<translation id="4224210481850767180">Տեղադրումը չեղարկվել է։</translation>
<translation id="8090594705972340646">Կապել João Browser-ի տվյալներն այս հաշվի հետ:</translation>
<translation id="4251772536351901305">Զգուշացնում է ձեզ վտանգավոր, այդ թվում՝ Google-ին նախկինում անհայտ կայքերի մասին, քանի որ ավելի շատ տվյալներ է վերլուծում կայքերում՝ համեմատած ստանդարտ պաշտպանության հետ։ Դուք կարող եք բաց թողնել Chromium-ի նախազգուշացումները։</translation>
<translation id="5696119579094527589">Դուրս գալ João Browser-ից</translation>
<translation id="4271805377592243930">Chromium-ի օգնության էջ</translation>
<translation id="4281844954008187215">Օգտագործման պայմաններ</translation>
<translation id="1245307320228150348">Անհայտ սխալի պատճառով տեղադրումը չհաջողվեց: Եթե João Browser-ը բաց է, փակեք այն և կրկին փորձեք:</translation>
<translation id="7405356088321579627">Արտահանեք գաղտնաբառերը João Browser-ից</translation>
<translation id="4304713468139749426">Գաղտնաբառերի կառավարիչ</translation>
<translation id="4334241893986177674">Որոնում այս սքրինշոթում</translation>
<translation id="212570256141568951">Գործարկել João Browser-ը, երբ Windows-ը միանա</translation>
<translation id="4400772909124543403">Հասանելի թարմացումներ չկան</translation>
<translation id="7463042547966071103">Փակե՞լ João Browser-ը։</translation>
<translation id="4413205837991854510">Միշտ ցույց տալ պատկերով որոնման դյուրանցումը</translation>
<translation id="4736206301215400753">Թույլատրել João Browser-ին աշխատել ֆոնային ռեժիմում</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{João Browser-ը խորհուրդ է տալիս հեռացնել այն։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" />}one{João Browser-ը խորհուրդ է տալիս հեռացնել այն։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" />}other{João Browser-ը խորհուրդ է տալիս հեռացնել դրանք։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" />}}</translation>
<translation id="5305058100936019600">Հարմարեցնել և վերահսկել João Browser-ը</translation>
<translation id="4427306783828095590">Լրացուցիչ պաշտպանությունն օգնում է խուսափել ֆիշինգից և արգելափակել վնասաբեր ծրագրերը</translation>
<translation id="4434353761996769206">Տեղադրիչի սխալ՝ <ph name="INSTALLER_ERROR" /></translation>
<translation id="3461955321878243607">João Browser-ը կառավարվում է <ph name="MANAGER" />-ի կողմից</translation>
<translation id="3379477508903866078">Ավելացնել João Browser պրոֆիլ</translation>
<translation id="4447409407328223819">Chrome for Testing-ի մասին</translation>
<translation id="4074057296993529937">João Browser-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը</translation>
<translation id="4493028449971051158">Մեկնարկի սխալ․ գործարկեք տեղադրիչը որպես ադմինիստրատոր։</translation>
<translation id="4501471624619070934">Չհաջողվեց տեղադրել, քանի որ այս երկրում հասանելիության սահմանափակումներ կան։</translation>
<translation id="8624811527667906941">Այս ընդլայնումը չի հրապարակել գաղտնիության քաղաքականություն, օրինակ՝ թե ինչպես է այն հավաքում և օգտագործում տվյալները։ João Browser-ը խորհուրդ է տալիս հեռացնել այն։</translation>
<translation id="5571435860030744559">Բարի գալուստ João Browser․ բացված է դիտարկիչի նոր պատուհան</translation>
<translation id="8132016625974854930">João Browser-ին անհրաժեշտ է թույլտվություն՝ ձեր շրջակայքի քարտեզը ստեղծելու և ձեր ձեռքերի շարժումները հետագծելու համար</translation>
<translation id="6599071882590417739">Դուք արդեն մուտք եք գործել <ph name="USER_EMAIL_ADDRESS" /> հաշիվ մյուս João Browser պրոֆիլում</translation>
<translation id="4548534452171747496">Chromium-ը նախապես բեռնում է էջերը՝ արագացնելով դիտարկումն ու որոնումը։ <ph name="BEGIN_LINK" />Իմանալ ավելին էջերի նախաբեռնման մասին<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Հաղորդեք կայքի մասին, որը ձեր կարծիքով վնասակար է, և օգնեք բարելավել համացանցի անվտանգությունը բոլորի համար։</translation>
<translation id="202208802191333704">João Browser-ն արգելափակել է այս ներբեռնումը, քանի որ դուք անջատել եք Անվտանգ դիտարկումը, և ֆայլը հնարավոր չէ ստուգել</translation>
<translation id="3128308674776200516">Փորձեք Google Տեսապակին João Browser-ի հետ ձեր հեռախոսում</translation>
<translation id="4594305310729380060">Այս սարքի Գաղտնաբառերի կառավարիչում</translation>
<translation id="7653380076752216509">João Browser հավելվածներ</translation>
<translation id="4598116752460667024">Ցանկում գտեք անհրաժեշտ գործընթացը։</translation>
<translation id="4613863813562375431">ChromiumOS-ի տարբերակը</translation>
<translation id="4621240073146040695">Գրեթե պատրաստ է: Վերագործարկեք Chromium-ը՝ թարմացումն ավարտելու համար:</translation>
<translation id="1497446027991908251">Արագացնում է կայքերի աշխատանքը João Browser-ի V8 շարժիչի օգնությամբ, սակայն փոքր-ինչ խոցելի է դարձնում João Browser-ը հարձակումների նկատմամբ</translation>
<translation id="7523749920868634278">Ուշադրություն․ João Browser-ը չի կարող արգելել ընդլայնումներին գրանցել ձեր այցելությունների պատմությունը։ Ընդլայնումն ինկոգնիտո ռեժիմում անջատելու համար ապանշեք այս պարամետրը։</translation>
<translation id="4673151026126227699">Եթե դուք նաև ուղարկում եք Chromium-ի օգտագործման մասին հաշվետվություններ, դրանցում կներառվեն ձեր այցելած URL-ները։</translation>
<translation id="4673710618874938871">Մուտք եք գործել որպես <ph name="USER_NAME" />, բաժանորդագրություն։ Բացել հաշվի ընտրացանկը</translation>
<translation id="6608258642372806522">Կարծես թե պրոֆիլն օգտագործվում է João Browser-ի այլ գործընթացի կողմից (<ph name="PROCESS_ID" />) այլ համակարգչում (<ph name="HOST_NAME" />): João Browser-ը կողպել է պրոֆիլը, որպեսզի այն չվնասվի: Եթե համոզված եք, որ պրոֆիլը չի օգտագործվում այլ գործընթացների կողմից, կարող եք ապակողպել պրոֆիլը և նորից գործարկել João Browser-ը:</translation>
<translation id="4680828127924988555">Չեղարկել տեղադրումը</translation>
<translation id="3912572071294857936">João Browser-ի որոշ տվյալներ դեռ չեն պահվել ձեր Google հաշվում։ Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները կջնջվեն։</translation>
<translation id="1077152188344040592">Հաշիվ մուտք գործած ժամանակ João Browser-ում դուք կարող եք օգտագործել ձեր գաղտնաբառերն ու մյուս կարգավորումները ձեր Google հաշվից։ <ph name="SHORTCUT" /> դյուրանցումով կարող եք փոխել Google-ի ձեր ծառայությունների կարգավորումները։</translation>
<translation id="5729536702149847030">Ինչ-որ մեկն այս համակարգչում <ph name="ACCOUNT_EMAIL_LAST" /> հասցեով մուտք է գործել João Browser: Ստեղծեք João Browser-ի նոր պրոֆիլ` ձեր տվյալներն առանձին պահելու համար:</translation>
<translation id="4724676981607797757">Չհաջողվեց տեղադրել հավելվածը, քանի որ չաջակցվող հաղորդակարգի կիրառման արդյունքում սխալ է առաջացել։</translation>
<translation id="6273241729694500032">Փակե՞լ João Browser-ը։</translation>
<translation id="3239680024825449390">João Browser-ի անվտանգության կարգավորումները հենց նոր թարմացվել են: Վերագործարկեք Chrome-ը, և ձեր ներդիրները կվերականգնվեն:</translation>
<translation id="4771701986670315895">Դուք վաղուց չեք այցելել կայք։ Chromium-ը հեռացրել է «<ph name="PERMISSION_1" />», «<ph name="PERMISSION_2" />» ու ևս <ph name="COUNT" /> թույլտվություն։</translation>
<translation id="1908292729364083164">Եթե «Gemini-ը João Browser-ում» հավելվածը բացված է, նոր ներդիրներ ստեղծելիս կողային վահանակը բացված կմնա</translation>
<translation id="479167709087336770">Օգտագործվում է միևնույն ուղղագրիչը, ինչ Google Որոնման մեջ: Դիտարկիչում մուտքագրված տեքստերն ուղարկվում են Google-ին: Սա կարող եք փոխել կարգավորումներում։</translation>
<translation id="189382710647501724">Օգտագործել João Browser-ն առանց հաշվի</translation>
<translation id="4456919965836032212">Թույլատրել João Browser-ում տվյալների մուտքային հոսքի փոխանցումը mDNS հաղորդակարգով:</translation>
<translation id="3486986778673504636">Վերագործարկել՝ &amp;João Browser-ը թարմացնելու համար</translation>
<translation id="4918086044614829423">Ընդունել</translation>
<translation id="4918844574251943176">Պատկերը պատճենվեց</translation>
<translation id="1571932028747131277">João Browser-ն աշխատում է ֆոնային ռեժիմում:</translation>
<translation id="7612124006067933008">Սեղմեք՝ João Browser մտնելու երկխոսության պատուհանը փակելու համար</translation>
<translation id="2598788273876744576">João Browser պրոֆիլների միջոցով դուք կարող եք օգտագործել դիտարկիչն առանձին այլ օգտատերերից։ Ստեղծեք պրոֆիլներ ձեր ընկերների և ընտանիքի անդամների կամ գործնական և անձնական նպատակների համար։</translation>
<translation id="2115498792600385171">Օգտագործելով João Browser-ը հյուրի ռեժիմում՝ դուք ոչ մի հետք չեք թողնում:</translation>
<translation id="6870732303439257966">Ձեր հաշիվը João Browser-ում</translation>
<translation id="4366792189726044065">Ավելացրեք ձեր հաշիվը João Browser-ին</translation>
<translation id="504699503110800016">Բացեք լրացուցիչ ընտրացանկը</translation>
<translation id="4340125167559705618">Օգտագործեք Google-ի ձեր սիրելի ծառայությունները João Browser-ի միջոցով ձեր <ph name="DEVICE_TYPE" /> սարքում</translation>
<translation id="4916697359431064123">João Browser-ին անհրաժեշտ է թույլտվություն՝ ձեր ձեռքերի շարժումները հետագծելու համար</translation>
<translation id="5141988424377517949">Դուք վաղուց չեք այցելել կայք։ Chromium-ը հեռացրել է «<ph name="PERMISSION_1" />», «<ph name="PERMISSION_2" />» և «<ph name="PERMISSION_3" />» թույլտվությունները։</translation>
<translation id="5174969993834422967">Դուք սովորաբար արգելափակում եք ծանուցումները։ Հասցեագոտու աջ անկյունում սեղմեք ծանուցման պատկերակը, որպեսզի թույլ տաք կայքին ծանուցել ձեզ։</translation>
<translation id="5174983315706567306">Սկավառակում բավարար տարածք չկա։</translation>
<translation id="961070648267203077">João Browser հաշիվը պահանջում է վերաիսկորոշում</translation>
<translation id="69363826605946518">Շարունակեք այնտեղից, որտեղ կանգ էիք առել iOS-ի համար João Browser-ում։</translation>
<translation id="471694954923709047">Դուրս գալ João Browser-ից</translation>
<translation id="5234764350956374838">Փակել</translation>
<translation id="5782956358171235578">Բացել հղումը João Browser-ի ինկո&amp;գնիտո պատուհանում</translation>
<translation id="903712329052383264">Ներբեռնեք João Browser հավելվածը՝ գաղտնաբառերը ցանկացած պահի պահելու համար</translation>
<translation id="5277894862589591112">Փոփոխությունները կիրառելու համար վերագործարկեք Chromium-ը</translation>
<translation id="5286907366254680517">Ճանաչվել է</translation>
<translation id="5593827909938092728">Ներբեռնել João Browser հավելվածը</translation>
<translation id="5294316920224716406">Երբ ինկոգնիտո ռեժիմում դիտարկելիս լինեք, նախքան ոչ ապահով միացման միջոցով կայք բեռնելը Chromium-ը ձեզ կնախազգուշացնի</translation>
<translation id="1066981078513393795">João Browser Updater ներքին ծառայություն</translation>
<translation id="5324450571874973775">Օգտագործեք դրանք Chromium-ում Gemini-ի այլ գործառույթների հետ միասին</translation>
<translation id="5346389065299425353">Որոնումն ընդլայնելու համար ավելացրեք մի քանի ներդիր, ֆայլեր և գործիքներ</translation>
<translation id="1884203704972162365">Ստացեք այս փաստաթղթի համառոտ նկարագրությունը և հարցեր տվեք Gemini-ին João Browser-ում</translation>
<translation id="5352264705793813212">Chromium-ը անվտանգության հետ կապված որոշ առաջարկներ է գտել ձեզ համար</translation>
<translation id="4819697639570429319">João Browser-ի այլ պրոֆիլներ</translation>
<translation id="7878591304929138776">ChromiumOS-ին չհաջողվեց պահել João Browser-ի տվյալները ձեր Google հաշվում, քանի որ ձեր հաշվի մուտքի տվյալները հնացած են</translation>
<translation id="5249614051186670898">Դուք մուտք եք գործում վերահսկվող հաշիվ՝ թույլ տալով ադմինիստրատորին կառավարել ձեր João Browser պրոֆիլը: Ձեր João Browser-ի տվյալները, ինչպես օրինակ՝ հավելվածները, էջանիշները, պատմությունը, գաղտնաբառերը և այլ կարգավորումները, մշտապես կկապվեն <ph name="USER_NAME" />-ի հետ: Դուք կկարողանաք ջնջել այս տվյալները Google Dashboard-ի միջոցով, սակայն չեք կարողանա համակցել դրանք այլ հաշվի հետ: <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Լրացուցիչ կոդ՝ <ph name="EXTRA_CODE" />։</translation>
<translation id="5377622451696208284">Անհատականացումը կարգավորելու համար ավելացրեք Chromium-ը Վեբ որոնման և հավելվածների պատմության մեջ</translation>
<translation id="108952623091824942">Իմացեք, թե ինչու է João Browser-ն արգելափակում որոշ ֆայլեր</translation>
<translation id="5386450000063123300">Chromium-ի թարմացում (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Թույլատրել մուտքը Chromium-ում</translation>
<translation id="1265086181910844216">Հեռացնել João Browser-ից</translation>
<translation id="1500700851187484222">Արդյունավետությունը կնվազի, սակայն João Browser-ն ավելի դիմակայուն կդառնա հարձակումների նկատմամբ</translation>
<translation id="6665657403278704382">Դարձնել João Browser-ը կանխադրված դիտարկիչը</translation>
<translation id="3520901681432894293"><ph name="PAGE_TITLE" /> – João Browser բետա</translation>
<translation id="5994273394215159270">{NUM_TABS,plural, =1{João Browser-ը խորհուրդ է տալիս դադարեցնել ներդիրը, որը դադաղեցնում է ձեր դիտարկիչը}one{João Browser-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}other{João Browser-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}}</translation>
<translation id="646791423998269453">João Browser-ը հնարավոր է չաշխատի ինչպես հարկն է, քանի որ այն այլևս չի աջակցվում Լինուքսի այս բաշխման մեջ։</translation>
<translation id="7249139852479053716">João Browser-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը կարող է վնասել ձեր անձնական և սոցիալական ցանցերի հաշիվները</translation>
<translation id="478612683981218420">Սպասեք` մինչ João Browser-ը տեղադրում է համակարգի նորագույն թարմացումները:</translation>
<translation id="3466187211963597724">João Browser-ը փորձում է փոխել գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="3133978491361824131">Սահուն աշխատեք ձեր սիրած հավելվածների հետ, ինչպիսիք են Google Drive-ը և YouTube-ը, João Browser-ի միջոցով։</translation>
<translation id="5524890928877629608">որոնման տարածքի վերևի ձախ անկյուն՝ <ph name="LEFT" />% ձախից, <ph name="TOP" />% վերևից</translation>
<translation id="5527463683072221100">Բացել PDF ֆայլեր Chromium-ում</translation>
<translation id="5536164441519929134">Հարցրեք<ph name="LINE_BREAK" />այս ներդիրի մասին</translation>
<translation id="3902123582863904748">Անվտանգության նկատառումներից ելնելով՝ João Browser-ն անջատում է JavaScript-ի օպտիմալացումը, երբ առաջին անգամ եք այցելում կայք։

Եթե այս էջը չի աշխատում սպասվածի պես, փորձեք թույլատրել օպտիմալացումը։</translation>
<translation id="5924481826213021755">Ցույց տալ «Gemini-ը João Browser-ում» հավելվածը Mac-ի ընտրացանկի գոտում և միացնել ստեղնային դյուրանցումը</translation>
<translation id="4988760628116707723"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք João Browser <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Ձեզ նաև հասանելի կլինեն պահված տեղեկությունները և այլ տվյալներ <ph name="DEVICE" />։</translation>
<translation id="5579324208890605088">Մեկնարկի սխալ․ գործարկեք տեղադրիչը որպես սովորական օգտատեր, այլ ոչ որպես ադմինիստրատոր։</translation>
<translation id="697769674160644707">Դարձրեք João Browser-ը ձեր կանխադրված դիտարկիչը և ամրացրեք այն</translation>
<translation id="5596627076506792578">Լրացուցիչ ընտրանքներ</translation>
<translation id="5605834417512968703">Ընտրեք որևէ բան՝ «Որոնում պատկերով» գործառույթի միջոցով որոնելու համար, կամ սեղմեք Escape՝ այդ գործառույթից դուրս գալու համար</translation>
<translation id="5618818588972826921">Ընտրեք ցանկացած տեքստ կամ պատկեր պատկերների որոնման միջոցով որոնելու համար կամ սեղմեք Escape՝ պատկերների միջոցով որոնումից դուրս գալու համար</translation>
<translation id="2497422928854452258">{0,plural, =0{Հասանելի է João Browser-ի նոր տարբերակը}=1{Հասանելի է João Browser-ի նոր տարբերակը}one{João Browser-ի նոր տարբերակը # օր է հասանելի է}other{João Browser-ի նոր տարբերակը # օր է հասանելի է}}</translation>
<translation id="5643865575100044307">Միշտ ջնջել կայքերի տվյալները սարքից՝ Chromium-ը փակելու դեպքում</translation>
<translation id="620465883043431255">Վերագործարկեք João Browser-ը</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Chromium-ը ցուցադրել այս լեզվով</translation>
<translation id="569897634095159764">Հնարավոր չէ միանալ ինտերնետին։ Պրոքսի սերվերն իսկորոշում է պահանջում։</translation>
<translation id="5768371961535086509">Chromium-ը ազատում է ոչ ակտիվ ներդիրներին հատկացված հիշողությունը։ Դրա շնորհիվ ակտիվ ներդիրներն ու մյուս հավելվածները համակարգչի ավելի շատ ռեսուրսներից են կարողանում օգտվել, իսկ Chromium-ը կարողանում է արագ աշխատել։ Ոչ ակտիվ ներդիրներն ավտոմատ կակտիվանան, երբ նորից սկսեք օգտագործել դրանք։ <ph name="BEGIN_LINK" />Իմանալ ավելին Հիշողության տնտեսման մասին<ph name="END_LINK" /></translation>
<translation id="8866372822266732235">Եթե մոռացել եք ձեր անցաբառը կամ ուզում եք փոխել այս կարգավորումը, խորհուրդ ենք տալիս <ph name="SETTINGS_LINK" /> João Browser-ի տվյալները ձեր հաշվից</translation>
<translation id="2106070764285625641">Անհատականացրեք և վերահսկեք João Browser-ը։ Դարձրեք João Browser-ը ձեր կանխադրված դիտարկիչը։</translation>
<translation id="9077878413488413377">Դարձրեք João Browser-ը ձեր կանխադրված դիտարկիչը, որպեսզի ձեր գաղտնաբառերը, էջանիշները և պատմությունը համաժամացվեն ձեր բոլոր սարքերում։</translation>
<translation id="5809516625706423866">Հնարավոր չէ միանալ ինտերնետին։ HTTP 401 Unauthorized։ Ստուգեք ձեր պրոքսի սերվերի կազմաձևը։</translation>
<translation id="614221876503883218">Արագացնում է կայքերի աշխատանքը João Browser-ի V8 շարժիչի օգնությամբ, սակայն փոքր-ինչ խոցելի է դարձնում João Browser-ը հարձակումների նկատմամբ։ Այս կարգավորումն անջատված է։</translation>
<translation id="8788365803279840995">João Browser-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար թարմացրեք João Browser-ը</translation>
<translation id="5824893331272123205">Չհաջողվեց բեռնել այս վահանակը։ Նորից փորձեք։</translation>
<translation id="5805760187441013922">Բարի գալուստ João Browser</translation>
<translation id="5867606647614813312">Միացնում է լրացուցիչ գործառույթներ՝ Chromium-ի ամենաուժեղ պաշտպանությունն ապահովելու համար</translation>
<translation id="5871205389137001634">Սեղմեք՝ «Որոնում պատկերով» գործառույթից դուրս գալու համար</translation>
<translation id="8367098380158627809">João Browser-ը այս տարրերում վնասագիր է հայտնաբերել՝</translation>
<translation id="5889361821821684993">Chromium-ը պարբերաբար ստուգում է իրականացնում՝ համոզվելու, որ ձեր դիտարկիչն ամենաանվտանգ կարգավորումներն ունի։ Մենք ձեզ կտեղեկացնենք, եթե որևէ բան փոխելու անհրաժեշտություն լինի։</translation>
<translation id="5895138241574237353">Վերագործարկել</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – Ցանցի մուտք</translation>
<translation id="5924017743176219022">Միացում համացանցին…</translation>
<translation id="7627350220326904504">Եկեք կարգավորենք ձեր João Browser-ը</translation>
<translation id="5941711191222866238">Նվազեցնել</translation>
<translation id="8680863040348007215">Որպեսզի այս էջանիշը և այլ տվյալներ հասանելի լինեն ձեր բոլոր սարքերում, մուտք գործեք João Browser</translation>
<translation id="2008232276062354182">Հարմարեցրեք João Browser-ը</translation>
<translation id="5960071705175224773">Կարգավորումները փոխվել են անհայտ հավելվածի կողմից</translation>
<translation id="5977420883993828287">Ամրացված է։ Համատեքստային առաջադրանքների վահանակն այժմ հասանելի է գործիքագոտում</translation>
<translation id="5889362640603897718">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ փակում է João Browser-ը, երբ այն 1 րոպե չի օգտագործվում։}one{Ձեր կազմակերպությունն ավտոմատ անջատում է João Browser-ը, երբ այն # րոպե չի օգտագործվում։}other{Ձեր կազմակերպությունն ավտոմատ անջատում է João Browser-ը, երբ այն # րոպե չի օգտագործվում։}}</translation>
<translation id="4971097497342057998">Թարմացրեք João Browser-ը՝ համաժամացումը սկսելու համար</translation>
<translation id="5990360079535151574">Գործիքագոտում սեղմելով «Համատեքստային առաջադրանքներ» կոճակը՝ կարող եք նորից բացել համատեքստային առաջադրանքները և հարցեր տալ դիտարկման ընթացքում։</translation>
<translation id="6003112304606738118">Ներբեռնում… Մնաց <ph name="HOURS" /> ժամ</translation>
<translation id="6009821354356307391">Լրացուցիչ հարցեր տվեք</translation>
<translation id="6040143037577758943">Փակել</translation>
<translation id="2100398097168307292">Օգտվեք առցանց գնումների բոլոր առավելություններից՝ ձեր <ph name="DEVICE_TYPE" />-ում օգտագործելով João Browser հավելվածը</translation>
<translation id="6058380562449900225">Ձեր տվյալները պաշտպանելու համար թույլ տվեք Chromium-ին հեռացնել թույլտվություններն այն կայքերից, որոնք վերջերս չեք այցելել։ Ընդ որում՝ ծանուցումները չեն անջատվի։</translation>
<translation id="4735359759698689867">&amp;Բացել João Browser-ում</translation>
<translation id="6069027071882229820">Պատճենել որպես պատկեր</translation>
<translation id="2274675514456642321">«<ph name="EXTENSION_NAME" />» ընդլայնումն ավելացվել է João Browser-ին</translation>
<translation id="147381942282490529">Հասանելի է João Browser-ի նոր տարբերակը։</translation>
<translation id="8775234022739879423">Միացված է • João Browser-ը չի կարող հաստատել այս ընդլայնման ծագումը</translation>
<translation id="6634821567165410381">Ձեր հաշիվը João Browser-ում</translation>
<translation id="4398707227122702993">Թույլատրել ընդլայնմանը մուտքի հարցումներ ցուցադրել João Browser-ի գործիքագոտում</translation>
<translation id="5370941509199989624"><ph name="FILE_NAME" /> ֆայլը վտանգավոր է, և João Browser-ն արգելափակել է այն։</translation>
<translation id="5119118887583954582">João Browser-ը շուտով կփակվի և կջնջի տվյալները</translation>
<translation id="576637711620229618">Այստեղ կարող եք անցնել João Browser-ի այլ պրոֆիլի</translation>
<translation id="615103374448673771">Եթե դուք թույլատրում եք քուքիների օգտագործումը, Chromium-ը կարող է դրանք օգտագործել նախաբեռնման ժամանակ</translation>
<translation id="6165508094623778733">Իմանալ ավելին</translation>
<translation id="3738215896821824918">Մաքրել João Browser-ի տվյալները ձեր հաշվից</translation>
<translation id="2145111683361496197">Այս ֆայլը կարող է վտանգավոր լինել<ph name="LINE_BREAK" />João Browser-ը կարող է ստուգել այն, եթե մուտքագրեք ձեր գաղտնաբառը։ Ֆայլի մասին տեղեկությունները կուղարկվեն «Google Ապահով դիտարկում» ծառայությանը, սակայն ֆայլի բովանդակությունը և գաղտնաբառը կմնան ձեր սարքում։</translation>
<translation id="6182736845697986886">Չհաջողվեց տեղադրել հավելվածը թարմացումն իրականացնող սերվերի ներքին սխալի պատճառով։</translation>
<translation id="6050294746023477088">Համոզվեք, որ մուտք եք գործել հաշիվ <ph name="TARGET_DEVICE_NAME" /> սարքի João Browser դիտարկիչում և փորձեք նորից ուղարկել։</translation>
<translation id="3395167674702947885">Այս համակարգչում արդեն տեղադրված է João Browser-ի ավելի նոր տարբերակը: Եթե ծրագրակազմը չի աշխատում, ապատեղադրեք João Browser-ը և նորից փորձեք:</translation>
<translation id="4384214545531685923">{0,plural, =0{João Browser-ը հիմա կվերագործարկվի}=1{João Browser-ը կվերագործարկվի 1 վայրկյանից}one{João Browser-ը կվերագործարկվի # վայրկյանից}other{João Browser-ը կվերագործարկվի # վայրկյանից}}</translation>
<translation id="5880255774989397049">Ֆայլեր ներբեռնելու համար João Browser-ին անհրաժեշտ է հիշողությունն օգտագործելու թույլտվություն</translation>
<translation id="6245734527075554892">Ստուգում է URL-ները Chromium-ում պահված վտանգավոր կայքերի ցանկի միջոցով։</translation>
<translation id="1959823478027154444">Դարձնել João Browser-ը կանխադրված դիտարկիչ</translation>
<translation id="6248988683584659830">Որոնման կարգավորումներ</translation>
<translation id="9191635841540101343">Օգտվեք Google-ի անվտանգության լավագույն գործառույթներից ցանկացած պահի ձեր հեռախոսի João Browser հավելվածի օգնությամբ</translation>
<translation id="538350741885862188">Դուրս գա՞լ João Browser-ից:</translation>
<translation id="161121067714522736">Այս ներդիրները լրացուցիչ ռեսուրսներ են օգտագործում։ Թույլատրեք João Browser-ին ապակտիվացնել դրանք, և աշխատանքի արդյունավետությունը կբարձրանա։</translation>
<translation id="2095090272560293574">Անհատականացնել João Browser-ի պրոֆիլը</translation>
<translation id="6290827346642914212">Անվանեք ձեր Chromium պրոֆիլը</translation>
<translation id="6472525517562723285">Ընդլայնումն ուզում է, որ դուք մուտք գործեք João Browser</translation>
<translation id="2069878195899746465"><ph name="FILE_NAME" /> ֆայլը կարող է վտանգավոր լինել, և João Browser-ն արգելափակել է այն։</translation>
<translation id="1283909912629029170">João Browser-ն օգտագործում է ձեր տեսախցիկը:</translation>
<translation id="323902744000752306">João Browser-ում տեղադրման մեկ այլ գործողություն ընթացքի մեջ է: Փորձեք ավելի ուշ:</translation>
<translation id="1292164882596462877">Այժմ ավելի հեշտ է օգտագործել João Browser-ը ձեր Google հաշվի հետ, այդ թվում նաև համօգտագործվող համակարգիչներով:</translation>
<translation id="6411450594978516531">Դարձրեք João Browser-ը ձեր կանխադրված դիտարկիչը՝ հեշտությամբ օգտվելու ձեզ ծանոթ, սիրելի և վստահելի գործառույթներից։</translation>
<translation id="3344301749774719950">João Browser-ի դյուրանցում</translation>
<translation id="8395825163097750991">João Browser-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը հազվադեպ է ներբեռնվում, և այն կարող է վտանգավոր լինել</translation>
<translation id="7683737657427846440">Հեռացնե՞լ João Browser-ը:</translation>
<translation id="6375219077595103062">Ավելացրեք Գաղտնաբառերի կառավարչի դյուրանցումը</translation>
<translation id="6388799252195623474">ինձ օգնություն է անհրաժեշտ</translation>
<translation id="6966523531135953867">Շարունակելու համար մուտք գործեք João Browser <ph name="EMAIL" /> էլփոստով։ Սա ապահովում է, որ դուք ունեք ձեր կազմակերպության կանոնները։</translation>
<translation id="5146608242127807773">João Browser-ի լոգոն՝ համակարգչի էկրանին։</translation>
<translation id="6361476216650509195">João Browser-ը վեբ դիտարկիչ է, որը կայծակի արագությամբ է բացում վեբէջերն ու հավելվածները: Այն արագ է, կայուն և պարզ՝ օգտագործման մեջ: Ավելի ապահով աշխատեք համացանցում՝ վնասագրերի և խաբկայքերի դեմ ներկառուցված պաշտպանության շնորհիվ:</translation>
<translation id="7864687914956920860">Հաստատեք ձեր ինքնությունը, որպեսզի միշտ կարողանաք օգտագործել և պահել João Browser-ի տվյալները ձեր Google հաշվում</translation>
<translation id="1160920197193662978">João Browser-ն ավելի արագ է աշխատում, իսկ JavaScript օգտագործող գործառույթները պետք է աշխատեն նախատեսվածի պես</translation>
<translation id="6436260184216827876">«Որոնում պատկերով» գործառույթը հասանելի չէ։ Փորձեք ավելի ուշ։</translation>
<translation id="6442900851116057561">Վերագործարկեք ChromiumOS-ը</translation>
<translation id="6443470774889161065">Chromium-ը նախապես բեռնում է էլ ավելի շատ էջեր, որոնք դուք հավանաբար կայցելեք, որպեսզի դրանք ավելի արագ բեռնվեն</translation>
<translation id="3730564967922511625">Ներբեռնեք João Browser-ը հեռախոսում՝ գներին հետևելու և ծանուցումներ ստանալու համար, երբ որևէ կայքում գնիջեցում լինի</translation>
<translation id="3753019081686930624">Անջատված է • João Browser-ը չի կարող հաստատել այս ընդլայնման ծագումը</translation>
<translation id="5444641426058108434">Բարի գալուստ João Browser պրոֆիլներ</translation>
<translation id="5103470775766355478">Հաջորդ անգամ, երբ ձեր <ph name="DEVICE_TYPE" /> սարքում բացեք João Browser-ը, կտեսնեք ներդիրների խմբերն օգտագործելու հրավեր։</translation>
<translation id="9087231386723579740">Հեռացնել հաշիվը João Browser-ից</translation>
<translation id="4984395209542302039">Այն նաև վերահսկում է, թե որ էջը ցուցադրվի João Browser-ը մեկնարկելիս:</translation>
<translation id="648319183876919572">Բարելավված Ապահով դիտարկումն օգնում է պաշտպանվել վտանգավոր կայքերից և ներբեռնումներից</translation>
<translation id="1524792685704191751">Ապատեղադրել João Browser-ը</translation>
<translation id="6637504267182028286">Դյուրանցումները բացվում են João Browser-ում</translation>
<translation id="1478247638436966279">Ձեր կազմակերպությունը փակում է João Browser-ը, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION" />։ Այցելությունների պատմությունը ջնջվել է։ Այս տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։</translation>
<translation id="1311233187253046133">Յուրաքանչյուր պրոֆիլում առանձին պահվում են João Browser-ի օգտատերերի տվյալները, օրինակ՝ էջանիշները, պատմությունը, գաղտնաբառերը և այլն</translation>
<translation id="6563921047760808519">Իմացեք ավելին, թե <ph name="BEGIN_LINK" />ինչպես է Chromium-ը պահպանում ձեր տվյալների գաղտնիությունը<ph name="END_LINK" /></translation>
<translation id="1643078533228697915">Այս կարգավորումների փոփոխությունները կկիրառվեն João Browser-ի վերագործարկումից հետո։</translation>
<translation id="1918630514771863338">Կառավարեք ընդլայնումները՝ João Browser-ի հիմնական ընտրացանկում սեղմելով Ընդլայնումներ։</translation>
<translation id="4229328298978407243">Դուք կարող եք դիտել գաղտնաբառերը՝ անցնելով մյուս João Browser պրոֆիլ</translation>
<translation id="7717252965531997879">Օգտագործեք João Browser հավելվածը՝ ԱԲ լավագույն գործիքները շարժման մեջ օգտագործելու համար</translation>
<translation id="6570579332384693436">Ուղղագրական սխալները շտկելու համար Chromium-ը Google-ին է ուղարկում տեքստային դաշտերում ձեր մուտքագրած տեքստը</translation>
<translation id="5374627817618267090">Անցնել João Browser-ի ծանուցումների կարգավորումներ</translation>
<translation id="6600016381025017075">Որոնեք ցանկացած բան այս էջում</translation>
<translation id="264335610358256197">Փոփոխություններն ուժի մեջ կմտնեն João Browser-ը հաջորդ անգամ գործարկելիս:</translation>
<translation id="2657584510687441826">João Browser-ն այժմ գործարկվում է Windows-ի միանալուն պես, այնպես որ կարող եք ակնթարթորեն սկսել դիտարկումը։ Դուք կարող եք անջատել այս գործառույթը կարգավորումներում։</translation>
<translation id="5482413402708094860">Շարունակեք այնտեղից, որտեղ կանգ էիք առել։ João Browser-ը վերականգնել է ձեր նախորդ աշխատաշրջանի ներդիրները։ Այս գործառույթն անջատելու համար անցեք</translation>
<translation id="5022765692226673603">Ձեր շրջակայքի եռաչափ քարտեզը ստեղծելու համար João Browser-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="6669284030132180248">Պահելով էջանիշները Google հաշվում՝ դուք կարող եք հետագծել ապրանքների գները Chromium-ում և ստանալ զեղչերի մասին ծանուցումներ</translation>
<translation id="6676384891291319759">Մտնել համացանց</translation>
<translation id="668175097507315160">Մուտքի սխալի պատճառով ChromiumOS-ը չկարողացավ համաժամացնել ձեր տվյալները։</translation>
<translation id="3982573751008180181">Հեռացնել այս հավելվածի տվյալները João Browser-ից</translation>
<translation id="5613723096388999601">Այս կայքի համար João Browser-ին անհրաժեշտ է խոսափողն օգտագործելու թույլտվություն</translation>
<translation id="6712881677154121168">Ներբեռնման սխալ՝ <ph name="DOWNLOAD_ERROR" />։</translation>
<translation id="9190188975825967506">Դուք չեք կարող օգտագործել ձեր պրոֆիլը, քանի որ այն João Browser-ի նոր տարբերակից է:

Որոշ գործառույթներ մատչելի չեն լինի: Հատկորոշեք այլ պրոֆիլի գրացուցակ կամ օգտվեք João Browser-ի ավելի նոր տարբերակից:</translation>
<translation id="6729124504294600478">Անհատականացումը և այլ գործառույթներ կարգավորելու համար ավելացրեք Chromium-ը Վեբ որոնման և հավելվածների պատմության մեջ և Google-ի կապված ծառայություններում</translation>
<translation id="6957684879859415418">João Browser-ն արդեն տեղադրված է ձեր համակարգչում բոլոր օգտատերերի համար:</translation>
<translation id="4411262692912917677">Էջանիշները և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք João Browser։ Այս էջանիշը կպահվի ձեր Google հաշվում, երբ մուտք գործեք։</translation>
<translation id="6064901610880747710">Արագացնում է կայքերի աշխատանքը João Browser-ի V8 շարժիչի օգնությամբ, սակայն փոքր-ինչ խոցելի է դարձնում João Browser-ը հարձակումների նկատմամբ։ Այս կարգավորումը միացված է։</translation>
<translation id="4530735110472079436">{count,plural, =1{João Browser-ի որոշ տվյալներ դեռ չեն պահվել Google հաշվում։ Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները (1 տարր) կջնջվեն։}one{João Browser-ի որոշ տվյալներ դեռ չեն պահվել Google հաշվում։ Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները ({count} տարր) կջնջվեն։}other{João Browser-ի որոշ տվյալներ դեռ չեն պահվել Google հաշվում։ Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները ({count} տարր) կջնջվեն։}}</translation>
<translation id="9176853308971176490">João Browser-ը խորհուրդ է տալիս ստուգել այս ֆայլը, քանի որ այն կարող է վտանգավոր լինել։</translation>
<translation id="6779406956731413166">ChromiumOS-ը ստեղծվել է <ph name="BEGIN_LINK_CROS_OSS" />բաց կոդով ծրագրակազմի<ph name="END_LINK_CROS_OSS" /> հիման վրա։</translation>
<translation id="6831043979455480757">Թարգմանել</translation>
<translation id="6412488898785231889">João Browser-ը ձեզ տեղյակ կպահի, եթե ձեր գաղտնաբառերի անվտագությանը սպառնալիք լինի</translation>
<translation id="684888714667046800">Հնարավոր չէ միանալ ինտերնետին։ Հրապատ օգտագործելու դեպքում համոզվեք, որ <ph name="PRODUCT_EXE_NAME" /> ֆայլը թույլատրվածների ցուցակում է։</translation>
<translation id="6750640664545078431">João Browser – <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Շարունակելու համար սեղմեք Tab</translation>
<translation id="6862030660799253820">Որոնել այս պատկերը պատկերով որոնման միջոցով</translation>
<translation id="4260365383290377081">João Browser-ը «<ph name="EXTENSION_NAME" />» ընդլայնման մեջ վնասագիր է հայտնաբերել</translation>
<translation id="6877155553248388166">որոնման տարածքի ներքևի աջ անկյուն՝ <ph name="RIGHT" />% աջից, <ph name="BOTTOM" />% վերևից</translation>
<translation id="6896758677409633944">Պատճենել</translation>
<translation id="6898028264630240901">Դուք կարող եք ամրացնել համատեքստային առաջադրանքները, որպեսզի հարցեր տաք դիտարկման ընթացքում</translation>
<translation id="6985817498888719203">Նշեք João Browser-ը որպես կանխադրված դիտարկիչ և այն ամրացրեք ձեր հավելվածների վահանակում</translation>
<translation id="5277424858974213042">&amp;Կառավարել João Browser-ի պրոֆիլները</translation>
<translation id="2726137364317931343">Այս գործողության արդյունքում տեղի կունենա հետևյալը․
          <ph name="LINE_BREAKS" />
            • Մեկնարկային էջի, նոր ներդիրի էջի, որոնողական համակարգի և ամրացված ներդիրների կարգավորումները կզրոյացվեն
            <ph name="LINE_BREAK" />
            • Ընդլայնումները կանջատվեն
            <ph name="LINE_BREAK" />
            • Քուքիները և կայքերի մյուս ժամանակավոր տվյալները կջնջվեն
            <ph name="LINE_BREAK" />
            • João Browser-ի դյուրանցումների կարգավորումները կզրոյացվեն
            <ph name="LINE_BREAKS" />
            Էջանիշները, պատմությունը և պահված գաղտնաբառերը կպահպանվեն։</translation>
<translation id="2901988969322822496">Դուք João Browser-ում արդեն առավելագույն թույլատրելի թվով (<ph name="BOOKMARK_LIMIT" />) էջանիշներ եք պահել, ուստի ձեր էջանիշներից մի քանիսը դեռ չեն պահվել ձեր Google հաշվում։

Դուք չեք կարող նոր էջանիշներ պահել ձեր հաշվում, մինչև չջնջեք մի քանիսը։ Եթե դուրս գաք հիմա, չպահված էջանիշները կջնջվեն։</translation>
<translation id="6203410920314218280">Բացել հղումը João Browser-ի ինկ&amp;ոգնիտո պատուհանում</translation>
<translation id="6965382102122355670">Եղավ</translation>
<translation id="6985329841647292029">ChromiumOS-ի պայմաններ</translation>
<translation id="8064285182627814996">João Browser-ի տվյալները <ph name="ACCOUNT_EMAIL" /> հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը</translation>
<translation id="7011190694940573312">Տեղադրումը ձախողվեց, քանի որ օպերացիոն համակարգի այս տարբերակը չի աջակցվում։</translation>
<translation id="7024536598735240744">Ապափաթեթավորման սխալ՝ <ph name="UNPACK_ERROR" />։</translation>
<translation id="181803036615530330">Անհատականացրեք João Browser դիտարկիչը</translation>
<translation id="7047386856539490735">Այս արդյունքներն օգտակա՞ր են։</translation>
<translation id="2478245051737698828">Թարմացնել João Browser-ը</translation>
<translation id="452909342278940733">Եթե պատկերն օգտակար նկարագրություն չունի, João Browser-ը կփորձի նոր նկարագրություն տրամադրել: Պատկերներն ուղարկվում են Google-ին՝ նկարագրություններ ստեղծելու համար։</translation>
<translation id="8606769615526968368">Օգտվեք ԱԲ-ի հնարավորություններից, երբ օգտագործում եք João Browser հավելվածը ձեր <ph name="DEVICE_TYPE" /> սարքում</translation>
<translation id="2061960765882453684">Ձեր գաղտնաբառերը, ներդիրները և այլ տվյալներ միշտ հասանելի կլինեն ձեր հեռախոսի João Browser հավելվածի շնորհիվ</translation>
<translation id="7141270731789036260">Անհատականացրեք Chrome for Testing-ը</translation>
<translation id="7147227333672430807">Օգտագործեք Chromium-ը ցանկացած ժամանակ, երբ սեղմում եք հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում առկա հղումների վրա</translation>
<translation id="6949173677980969871">Հեռացնել <ph name="EXTENSION_NAME" /> ընդլայնումը João Browser-ից</translation>
<translation id="3556355753960287061">Ձեր կազմակերպությունը ջնջում է João Browser-ի տվյալները, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION" />։ Այս տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։</translation>
<translation id="8689006320829658442">Այս կայքի համար João Browser-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="7501884108538572227">Չհաջողվեց գործարկել João Browser-ը։ Նորից փորձեք։</translation>
<translation id="5484563502710761706">Հարցրեք ցանկացած բան ցանկացած տեղում «Gemini-ը João Browser-ում» մոդելի միջոցով</translation>
<translation id="3823264355161086552">Ամրացրեք João Browser-ը Dock վահանակի վրա՝ այն ցանկացած պահի արագ բացելու համար</translation>
<translation id="9153902741226700840">Օգտագործեք João Browser-ը ցանկացած ժամանակ, երբ սեղմում եք հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում առկա հղումների վրա</translation>
<translation id="7216228761061470870">Երբ օգտագործում եք «Որոնում պատկերով» գործառույթը, էջի վերնագիրը, URL-ը և բովանդակությունը՝ ներառյալ PDF-ները, ուղարկվում են սերվերին</translation>
<translation id="7950844619283784703">Խնդիրների կառավարիչ - João Browser</translation>
<translation id="133513825972536773"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք João Browser <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Պահպանված տեղեկությունները և մյուս տվյալները նույնպես կհայտնվեն ձեր բոլոր սարքերում։</translation>
<translation id="4558982617284733740">Ակնթարթորեն սկսեք դիտարկումը․ João Browser-ն այժմ կարող է գործարկվել Windows-ի միանալուն պես։</translation>
<translation id="7274695763216404502">«Որոնում պատկերով» գործառույթն ամրացված է․ այն այժմ հասանելի է գործիքագոտում</translation>
<translation id="7288567540154601580">Ներդիրներ և ընդլայնումներ</translation>
<translation id="5494571279964989269">{NUM_EXTENSIONS,plural, =1{João Browser-ը խորհուրդ է տալիս ձեզ հեռացնել այն}one{João Browser-ը խորհուրդ է տալիս ձեզ հեռացնել այն}other{João Browser-ը խորհուրդ է տալիս ձեզ հեռացնել դրանք}}</translation>
<translation id="2269053214123323740">Համակարգի աուդիոյով կիսվելու համար բացեք Համակարգի կարգավորումները և թույլատրեք «Միայն համակարգի աուդիոյի ձայնագրումը» João Browser-ի համար։ Այնուհետև անհրաժեշտ կլինի վերագործարկել João Browser-ը։</translation>
<translation id="731795002583552498">Chromium-ը թարմացվում է</translation>
<translation id="9065168747010082551">Ձեր նախընտրանքների ֆայլը վնասված է կամ անվավեր:

João Browser-ին չհաջողվեց վերականգնել ձեր կարգավորումները:</translation>
<translation id="7324051657739063017">Դուք կարող եք նորից բացել համատեքստային առաջադրանքները, որպեսզի հարցեր տաք դիտարկման ընթացքում</translation>
<translation id="4159250197688136733">Բոլոր վեբէջերը, էջանիշները և João Browser-ի այլ տվյալները պահվում են այստեղ:</translation>
<translation id="7347827960336370838">Միայն ձեր անցաբառն ունեցող մարդիկ կարող են կարդալ ձեր գաղտնագրված տվյալները։ Անցաբառը չի ուղարկվում Google-ին կամ պահվում նրա կողմից։ Եթե մոռացել եք ձեր անցաբառը կամ ուզում եք փոխել այս կարգավորումը, ապա ձեզ անհրաժեշտ կլինի <ph name="BEGIN_LINK" />ջնջել Chromium-ի տվյալները ձեր հաշվում<ph name="END_LINK" />։</translation>
<translation id="1062903713270840396">Ձեր համակարգի ադմինիստրատորն այնպես է կարգավորել João Browser-ը, որ <ph name="TARGET_URL_HOSTNAME" /> կայքը բացվի <ph name="ALTERNATIVE_BROWSER_NAME" /> դիտարկիչով։</translation>
<translation id="7352651011704765696">Ինչ-որ սխալ տեղի ունեցավ</translation>
<translation id="5817362738974335084">João Browser-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է macOS 13 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է macOS 12 տարբերակը։</translation>
<translation id="7376384068949534168">Դուք վաղուց չեք այցելել կայք։ Chromium-ը հեռացրել է «<ph name="PERMISSION_1" />» և «<ph name="PERMISSION_2" />» թույլտվությունները։</translation>
<translation id="73786666777299047">Բացել Chrome Web Store-ը</translation>
<translation id="5724625487458697703">Ցույց տալ «Gemini-ը João Browser-ում» հավելվածը ծանուցման տարածքում</translation>
<translation id="7401687852903179959">Որոնել այս տեսանյութը պատկերով որոնման միջոցով</translation>
<translation id="1088684725931971005">João Browser-ն այժմ ձեր կանխադրված դիտարկիչն է</translation>
<translation id="7479848806300971661">Շարունակեք այնտեղից, որտեղ կանգ էիք առել։ João Browser-ը վերականգնում է ներդիրները յուրաքանչյուր վերագործարկումից հետո։ Այս գործառույթն անջատելու համար անցեք</translation>
<translation id="1258077876605261365">Արտահանեք գաղտնաբառեր João Browser</translation>
<translation id="5293062713751091377">1. Սեղմեք <ph name="BUTTON_LABEL" /> ներքևում
2. Windows-ի կարգավորումներում սեղմեք <ph name="BUTTON_2" />
3. Սեղմեք <ph name="BUTTON_3" /> Windows-ի ծանուցման մեջ՝ João Browser-ը հավելվածների վահանակում ամրացնելու համար</translation>
<translation id="1941496545060769345"><ph name="PAGE_TITLE" /> – João Browser Dev</translation>
<translation id="7450541714075000668">Տեքստը պատճենվեց</translation>
<translation id="7458892263350425044">Ձեր խոսափողն օգտագործելու համար Chromium-ին թույլտվություն տրամադրեք <ph name="BEGIN_LINK" />համակարգի կարգավորումներում<ph name="END_LINK" /></translation>
<translation id="5422859338435319909">João Browser-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 7 տարբերակը։</translation>
<translation id="7467949745582939695">Վերագործարկե՞լ Chromium-ը</translation>
<translation id="7707324976708178089">Հնարավոր չէ տեղադրել João Browser-ի նույն տարբերակը, որն այժմ գործարկվում է: Փակեք João Browser-ը և նորից փորձեք:</translation>
<translation id="7510190804000607802">Հիշեցում․ Google-ի լավագույն հավելվածները ձեր գրպանում</translation>
<translation id="751935028865900641">Կայքերի մեծ մասը ամենայն հավանականությամբ պատշաճ կերպով կաշխատի։ Դուք դուրս կգրվեք կայքերի մեծամասնությունից, երբ փակեք Chromium-ի բոլոր պատուհանները, սակայն կմնաք ձեր Google հաշվում, եթե մուտք եք գործել Chromium։</translation>
<translation id="5325102834460669866">{0,plural, =1{João Browser-ը կվերագործարկվի 1 րոպեից}one{João Browser-ը կվերագործարկվի # րոպեից}other{João Browser-ը կվերագործարկվի # րոպեից}}</translation>
<translation id="7565444033145385702">Ձեր տվյալները պաշտպանելու համար թույլ տվեք Chromium-ին հեռացնել թույլտվություններն այն կայքերից, որոնք վերջերս չեք այցելել։</translation>
<translation id="8099958128052689767">Ավտոմատ գործարկեք João Browser-ը՝ անմիջապես դիտարկում սկսելու համար։</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" />-ի տեղադրիչ</translation>
<translation id="7125257608567714221">João Browser-ն օգտագործում է ձեր տեսախցիկն ու խոսափողը:</translation>
<translation id="227045421902171569">João Browser-ը կատարելագործվել է</translation>
<translation id="5356567285381070312">Այժմ João Browser-ում ձեզ ավելի շատ գործառույթներ են հասանելի</translation>
<translation id="7624307931717240213">Մենք օգտագործում ենք տեղեկությունները՝ այս ծառայությունը բարելավելու համար։ Ծանոթացեք գաղտնիության քաղաքականությանը և Օգտագործման պայմաններին։</translation>
<translation id="7649070708921625228">Օգնություն</translation>
<translation id="5714374331629713291">Ներբեռնել João Browser հավելվածը</translation>
<translation id="7658239707568436148">Չեղարկել</translation>
<translation id="549378870470819535">João Browser-ը ձեր կանխադրված դիտարկիչը չէ</translation>
<translation id="6574348346278803862">Համաժամացրեք և անհատականացրեք João Browser-ը ձեր բոլոր սարքերում</translation>
<translation id="7699779824407626136">Chromium-ի թարմացում</translation>
<translation id="3304080024230377341">Ձեր աշխատանքը պաշտպանված է João Browser-ում</translation>
<translation id="7716950018788545737">Առաջադրանք(ներ)ը ավարտված են։</translation>
<translation id="77283119132245232">Տրամադրում է <ph name="BROWSER_NAME" /> դիտարկիչին համակարգի հետագծման ծառայություններ։ Եթե այս ծառայությունն անջատված է, դիտարկիչի կողմից ստեղծված արդյունավետության հետագծումները չեն ներառի համակարգային իրադարձություններ, ինչպիսիք են համատեքստի փոխանջատումը և հոսքի պատրաստությունը։</translation>
<translation id="7745317241717453663">Ձեր այցելությունների պատմությունը կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք Chromium <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="7747138024166251722">Տեղադրիչը չկարողացավ ստեղծել ժամանակավոր գրացուցակ: Ստուգեք սկավառակում ազատ տարածքի առկայությունը և ծրագրակազմը տեղադրելու թույլտվությունը:</translation>
<translation id="4713120944298974980">Որոնում João Browser-ում</translation>
<translation id="5804390944809171853">Վերականգնել João Browser-ի կանխադրված կարգավորումները</translation>
<translation id="6930487390575519812">João Browser-ում աշխատանքի անվտանգությունն ապահովելու համար ձեր կազմակերպությունը կկարողանա դիտել կամ կառավարել որոշակի տեղեկություններ, երբ մուտք գործեք João Browser։</translation>
<translation id="5214761769821670245">Դարձրեք João Browser-ը կանխադրված դիտարկիչ և ամրացրեք այն հավելվածների վահանակում</translation>
<translation id="1294697217796985566">Արագացրեք João Browser-ի աշխատանքը</translation>
<translation id="1278345486417353853"><ph name="PAGE_TITLE" /> – João Browser Canary</translation>
<translation id="7803986347287457849">Արեք այնպես, որ ձեր ինտերնետ թրաֆիկի հասանելիություն ունեցող մարդիկ չկարողանան տեսնել, թե ինչ կայքեր եք այցելել։ Chromium-ն օգտագործում է ապահով միացում՝ DNS-ում (տիրույթի անունների համակարգ) կայքերի IP հասցեները որոնելու համար։</translation>
<translation id="7810005234485217901">Ամրացրեք «Որոնում պատկերով» գործառույթը՝ արագ մուտքի համար</translation>
<translation id="489728561211958943">Այս հաշվի հետ կապված João Browser-ի պրոֆիլ արդեն գոյություն ունի այս սարքում</translation>
<translation id="7845233973568007926">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME" />-ն օգտագործելը դուք պետք է վերագործարկեք ձեր համակարգիչը։</translation>
<translation id="5294768452950207882">Ձեր որոնողական համակարգը João Browser-ից դուրս է փոխվել։ Անվտանգության նկատառումներով՝ João Browser-ը վերականգնել է կանխադրված կարգավորումները։ <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3244974069468656925">Անհատականացրեք João Browser-ը՝ դրան նոր տեսք հաղորդելու համար</translation>
<translation id="7859018312476869945">Երբ դուք տեքստ եք մուտքագրում հասցեագոտում կամ որոնման դաշտում, Chromium-ը ձեր հարցումն ուղարկում է կանխադրված որոնողական համակարգին՝ ավելի լավ առաջարկներ ստանալու համար։ Այս գործառույթն անջատված է ինկոգնիտո ռեժիմում։</translation>
<translation id="6517519572778941051">Չհաջողվեց տեղադրել João Browser-ի վերջին տարբերակը, որը թարմացվել է նոր գործառույթներով և անվտանգության բարելավումներով:</translation>
<translation id="7872446069773932638">Ներբեռնում… Մնաց <ph name="SECONDS" /> վայրկյան</translation>
<translation id="7873537467422636035">Եթե մոռացել եք ձեր անցաբառը կամ ուզում եք փոխել այս կարգավորումը, <ph name="BEGIN_LINK" />ջնջեք Chromium-ի տվյալները ձեր հաշվում<ph name="END_LINK" />։</translation>
<translation id="1722038268139386345">Թույլ է տալիս արագ բացել «Gemini-ը João Browser-ում» հավելվածը, երբ դրա անհրաժեշտությունը կա</translation>
<translation id="8344320926817290924">Դարձնել João Browser-ը ձեր կանխադրված դիտարկիչը</translation>
<translation id="7934340546140346950">Chromium-ը հնարավորության դեպքում ավտոմատ կերպով վերածում է ոչ ապահով միացումները HTTPS-ի</translation>
<translation id="3755057387338907970">Դուք մուտք եք գործել João Browser որպես <ph name="USER_EMAIL_ADDRESS" />: Նորից մուտք գործելու համար օգտագործեք նույն հաշիվը:</translation>
<translation id="929903348843569380"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք João Browser <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Էջանիշները և մյուս տվյալները նույնպես կհայտնվեն ձեր բոլոր սարքերում։</translation>
<translation id="7975919845073681630">Սա Chromium-ի երկրորդային տեղադրումն է: Այն չի կարող դառնալ ձեր կանխադրված դիտարկիչը:</translation>
<translation id="8905411496853397218">Անհայտ աղբյուրներից ընդլայնումները, հավելվածներն ու թեմաները կարող են վնասել ձեր սարքը։ João Browser-ը խորհուրդ է տալիս դրանք տեղադրել միայն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ից։</translation>
<translation id="6306672714476596428">Օգտագործեք Google-ի բոլոր առավելությունները João Browser հավելվածի միջոցով ձեր <ph name="DEVICE_TYPE" /> սարքում</translation>
<translation id="8004582292198964060">Դիտարկիչ</translation>
<translation id="8010081455002666927">Ինքնահայտնաբերում</translation>
<translation id="2172829664765531568">Երբ João Browser-ը հասանելիություն ստանա, կայքերը կկարողանան ձեզնից հասանելիություն խնդրել։</translation>
<translation id="74641100973032765">Ամրացրեք João Browser-ը խնդրագոտու վրա՝ այն ցանկացած պահի արագ բացելու համար</translation>
<translation id="80471789339884597">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME" />-ն օգտագործելը դուք պետք է վերագործարկեք ձեր բոլոր դիտարկիչները։</translation>
<translation id="8054112667659782652">Միշտ ցույց տալ պատկերով որոնման դյուրանցումը</translation>
<translation id="8069447462453318634">Ընտրեք «Ամրացնել գործիքագոտում»</translation>
<translation id="5039671129725402518">Անջատել João Browser-ի ֆոնային ռեժիմը հավելվածների համար</translation>
<translation id="80790299200510644">Որոնում պատկերով</translation>
<translation id="8086881907087796310">Տեղադրումը ձախողվեց, քանի որ ձեր համակարգիչը չի համապատասխանում սարքակազմի նվազագույն պահանջներին։</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> — Google Chrome for Testing</translation>
<translation id="2430877582155731716">Այս կայքի համար João Browser-ին անհրաժեշտ է տեղորոշումն օգտագործելու թույլտվություն</translation>
<translation id="8298045348217323">Հաջորդ անգամ, երբ ձեր <ph name="DEVICE_TYPE" /> սարքում բացեք João Browser-ը, կտեսնեք գների հետագծման ծանուցումները միացնելու հրավեր։</translation>
<translation id="3827347991254458074">Ստացեք ձեզ հետաքրքրող ապրանքների գնիջեցման մասին ծանուցումներ ձեր հեռախոսի João Browser հավելվածում</translation>
<translation id="8118331347066725040">Կարծիք հայտնեք «Որոնել Տեսապակու միջոցով» գործառույթի մասին</translation>
<translation id="2580039965224265556">Անհատականացրեք João Browser-ը</translation>
<translation id="8133124826068723441">ChromiumOS-ին չհաջողվեց համաժամացնել տվյալները, քանի որ այդ գործառույթը հասանելի չէ ձեր տիրույթի համար։</translation>
<translation id="813913629614996137">Նախապատրաստվում է...</translation>
<translation id="7940955011992997426">Բացել «Gemini-ը João Browser-ում» հավելվածը ստեղնային դյուրանցման միջոցով։</translation>
<translation id="7560319627203819845">João Browser-ի օգտագործման լրացուցիչ պայմաններ</translation>
<translation id="7133741820744999589">Այս ֆայլը վտանգավոր է, և João Browser-ն արգելափակել է այն։</translation>
<translation id="8177472873527554730">Էջում բովանդակություն գտնել հնարավոր չէ</translation>
<translation id="8200109504272824693">Chromium-ի տվյալները <ph name="USER_EMAIL" /> հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը</translation>
<translation id="820759916613250543">Որոնել այս պատկերը պատկերով որոնման միջոցով</translation>
<translation id="8221491193165283816">Դուք սովորաբար արգելափակում եք ծանուցումները։ Այս կայքում ծանուցումներ ստանալու համար սեղմեք այստեղ։</translation>
<translation id="8223363452568144035">Ձեր տեսախցիկն օգտագործելու համար Chromium-ին թույլտվություն տրամադրեք <ph name="BEGIN_LINK" />համակարգի կարգավորումներում<ph name="END_LINK" /></translation>
<translation id="8132864687089402359">João Browser-ը չի կարող ստուգել այս ընդլայնման ծագումը, ուստի այն կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը João Browser-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="7600652022483599804">Եթե պատկերն օգտակար նկարագրություն չունի, João Browser-ը կփորձի նոր նկարագրություն տրամադրել: Պատկերներն ուղարկվում են Google-ին՝ նկարագրություններ ստեղծելու համար։ Ցանկացած պահի կարգավորումներում կարող եք անջատել սա:</translation>
<translation id="8703735741562140394">Մուտք գործե՞լ João Browser նոր պրոֆիլում</translation>
<translation id="2830039647655087365"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք João Browser <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Ձեզ նաև հասանելի կլինեն գաղտնաբառերը և այլ տվյալներ <ph name="DEVICE" />։</translation>
<translation id="1802935470126307750">«Gemini-ը João Browser-ում» հավելվածը ավելացնել ծանուցման տարածքում և միացնել ստեղնային դյուրանցումը</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Chromium-ը զգուշացնում է ձեզ<ph name="END_LINK" /> վտանգավոր կայքերի և ներբեռնումների մասին</translation>
<translation id="8295827201165805317">Դուք վաղուց չեք այցելել կայք։ Chromium-ը հեռացրել է «<ph name="PERMISSION" />» թույլտվությունը։</translation>
<translation id="481989138594406896">Օգտագործեք ձեր շարժական սարքի տեսախցիկը՝ João Browser-ի iOS հավելվածում ապրանքներ գտնելու, տեքստեր թարգմանելու և ձեզ շրջապատող օբյեկտների մասին տեղեկություններ ստանալու համար</translation>
<translation id="5242426961520127942">QR կոդ՝ João Browser որպես <ph name="USER_NAME" /> մուտք գործելու համար</translation>
<translation id="8313851650939857356">Մեկնարկի սխալ․ <ph name="STARTUP_ERROR" />։</translation>
<translation id="3644336211313412429">Ձեր կազմակերպությունը փակում է João Browser-ը, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION" />։</translation>
<translation id="8321888067342493336">Պահել որպես պատկեր</translation>
<translation id="3150519286474936594"><ph name="USER_EMAIL_ADDRESS" />-ը նախկինում João Browser է օգտագործել</translation>
<translation id="8351551329754447960">Միացնել հմտությունները Chromium-ում</translation>
<translation id="4566781614303801262">Թարմացրեք João Browser-ը, որպեսզի շարունակեք օգտագործել João Browser-ի տվյալները ձեր <ph name="ACCOUNT_EMAIL" /> Google հաշվում։</translation>
<translation id="8404636483124146663">João Browser-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 8 տարբերակը։</translation>
<translation id="8362914115861174987">Թարգմանության լեզու</translation>
<translation id="8367705492654390392">Հարցրեք որևէ բան</translation>
<translation id="8370517070665726704">© Google LLC <ph name="YEAR" />։ Բոլոր իրավունքները պահպանված են:</translation>
<translation id="8954225380790220359">Գաղտնաբառերը և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք João Browser։ Այս գաղտնաբառը կպահվի ձեր Google հաշվում, երբ մուտք գործեք։</translation>
<translation id="208035402574338948">Այնուհետև անհրաժեշտ կլինի վերագործարկել João Browser-ը։</translation>
<translation id="7458698097055456629">João Browser-ը խորհուրդ է տալիս հեռացնել այն։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" /></translation>
<translation id="3428558977667883100">Այս ընդլայնման հրապարակումը չեղարկվել է մշակողի կողմից, և այն կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը João Browser-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="5012944467031125860">Որպեսզի որոշ տվյալներ հնարավոր լինի պահել ձեր Google հաշվում, և դուք կարողանաք օգտագործել դրանք ձեր բոլոր սարքերում, João Browser-ը նախ պետք է հաստատի ձեր ինքնությունը։ Եթե դուրս գաք հիմա, այս տվյալները կջնջվեն։</translation>
<translation id="8822543678238892300">{0,plural, =1{Վերագործարկեք João Browser-ը մեկ օրվա ընթացքում}one{Վերագործարկեք João Browser-ը # օրվա ընթացքում}other{Վերագործարկեք João Browser-ը # օրվա ընթացքում}}</translation>
<translation id="8438543370129609977">Երբ օգտագործում եք «Որոնում պատկերով» գործառույթը, էջի վերնագիրը, URL-ը և բովանդակությունը՝ ներառյալ PDF-ները, ուղարկվում են սերվերին։ <ph name="LEARN_MORE" /></translation>
<translation id="4307944272317199640">Իմանալ ավելին João Browser-ում պատկերների միջոցով որոնման մասին</translation>
<translation id="6024135746436350583">Տեղադրիչի արխիվը վնասված է կամ անվավեր: Նորից ներբեռնեք João Browser-ը:</translation>
<translation id="4933173390191738516">João Browser-ի համար պահանջվում է Windows 10 կամ ավելի նոր տարբերակ։</translation>
<translation id="8463672209299734063">Ըստ ցանկության. օգնեք բարելավել ChromiumOS-ի գործառույթներն ու աշխատանքը՝ Google-ին ավտոմատ կերպով ուղարկելով օգտագործման և դիագնոստիկ տվյալները։</translation>
<translation id="4499703930846496679">João Browser-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար հաստատեք ձեր ինքնությունը</translation>
<translation id="8482493977473846331">Ցույց է տալիս հաղորդագրություն Chromium-ում մուտք գործելու համար</translation>
<translation id="2129903037617090425">João Browser-ը հնացած է</translation>
<translation id="850264194101621529">Շնորհակալություն Chromium-ը որպես ձեր կանխադրված դիտարկիչ ընտրելու համար։</translation>
<translation id="8522801943730206384">Chromium-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ պահում եք դրանք</translation>
<translation id="8525579356836940628">Տեղադրումը կանգնեցվել է</translation>
<translation id="2445505893586445499">Ձեր գաղտնաբառերը, ներդիրները և այլ տվյալներ միշտ հասանելի կլինեն ձեր <ph name="DEVICE_TYPE" />-ի João Browser հավելվածի միջոցով</translation>
<translation id="8548787790260785208">Ստացեք ծանուցում, երբ Chromium-ը հայտնաբերի, որ ձեր գաղտնաբառերից մեկը բացահայտվել է տվյալների հանրային արտահոսքի արդյունքում</translation>
<translation id="8555465886620020932">Ծառայության սխալ՝ <ph name="SERVICE_ERROR" />։</translation>
<translation id="8871890913961794658">João Browser-ի որոշ գործառույթներ և ընդլայնումներ ունեն դյուրանցումներ։ Դուք կարող եք նորից միացնել դրանք։</translation>
<translation id="8556420416730706394">«Որոնում պատկերով» գործառույթից արագ օգտվելու համար սեղմեք կողային վահանակի վերևի հատվածում գտնվող «Ամրացնել» կոճակը</translation>
<translation id="856656450041460113">Որոնել լեզուների ցանկում</translation>
<translation id="9044172203094901282">João Browser-ը կառավարվում է մի քանի կազմակերպության կողմից</translation>
<translation id="8586442755830160949">© <ph name="YEAR" /> The Chromium Authors: Բոլոր իրավունքները պահպանված են:</translation>
<translation id="8601359445272098721">Նորույթ․ դուք կարող եք ձեր էկրանին թարգմանել ինչպես տեքստ, այնպես էլ պատկերներ՝ սեղմելով «Թարգմանել էկրանը» կոճակը</translation>
<translation id="1071663705626404814">João Browser-ի գործարկում...</translation>
<translation id="8624541899164515475">Կարգավորումներ, բացվում է նոր ներդիրում։</translation>
<translation id="8648201657708811153">Google Chrome for Testing-ը չի կարող դառնալ ձեր կանխադրված դիտարկիչը։</translation>
<translation id="5975137268566279898">Այն նաև վերահսկում է João Browser-ի մեկնարկի կամ Omnibox-ից որոնում կատարելու ժամանակ ցուցադրվող էջը:</translation>
<translation id="6358904712334248114">Սա ձեր João Browser-ն է</translation>
<translation id="8712637175834984815">Պատրաստ է</translation>
<translation id="5380190167074430719">Մուտք գործե՞լ João Browser</translation>
<translation id="8747073452963259673">որոնման տարածքի ներքևի ձախ անկյուն՝ <ph name="LEFT" />% ձախից, <ph name="BOTTOM" />% վերևից</translation>
<translation id="878572486461146056">Տեղադրման սխալ. ձեր ցանցի ադմինիստրատորը կիրառել է խմբային կանոն, որը կանխում է տեղադրումը՝ <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Հիշեցնել ավելի ուշ</translation>
<translation id="8871607387186266158">Կիսվեք այս փաստաթղթով Gemini-ի հետ João Browser-ում՝ դրա համառոտ նկարագրությունը ստանալու և լրացուցիչ հարցեր տալու համար</translation>
<translation id="3009329613270131861">Մուտք գործե՞լ João Browser</translation>
<translation id="8823401858233292222">Դարձնել Chromium-ը կանխադրված դիտարկիչ և ամրացնել խնդրագոտում</translation>
<translation id="8826492472752484139">Սեղմեք «Գաղտնաբառերի կառավարիչ»</translation>
<translation id="8833697763442816810">ChromiumOS համակարգ</translation>
<translation id="8852026904190808918">Այս լեզուն օգտագործվում է՝ Chromium-ում ընտրացանկերը, կարգավորումները, զգուշացումները և այլ տեքստեր ցուցադրելու համար</translation>
<translation id="8862326446509486874">Դուք չունեք համապատասխան իրավունքներ՝ համակարգի մակարդակով տեղադրում կատարելու համար: Փորձեք տեղադրումը կատարել որպես Ադմինիստրատոր:</translation>
<translation id="6821836710312478344">Ավելացնել João Browser պրոֆիլ</translation>
<translation id="5139769635207740615">Մուտքի սխալի պատճառով ChromiumOS-ին չհաջողվեց պահել João Browser-ի տվյալները ձեր Google հաշվում</translation>
<translation id="6814613825007700341">Ձեր կազմակերպության կանոնների համաձայն՝ դուք պետք է մուտք գործեք João Browser</translation>
<translation id="1009831347869773172">João Browser-ը փորձում է ցուցադրել գաղտնաբառերը: Մուտքագրեք ձեր Windows-ի գաղտնաբառը՝ այս գործողությունը թույլ տալու համար:</translation>
<translation id="690637523240192979">João Browser-ն այլևս ձեր կանխադրված դիտարկիչը չէ։ Դարձնե՞լ João Browser-ը կանխադրված դիտարկիչ։</translation>
<translation id="225046375773654931">Չհաջողվեց թարմացնել João Browser-ը</translation>
<translation id="8944232836376404813">Այս գործողության արդյունքում տեղի կունենա հետևյալը․
          <ph name="LINE_BREAKS" />
            • Մեկնարկային էջի, նոր ներդիրի էջի, որոնողական համակարգի և ամրացված ներդիրների կարգավորումները կզրոյացվեն
            <ph name="LINE_BREAK" />
            • Ընդլայնումները կանջատվեն
            <ph name="LINE_BREAK" />
            • Քուքիները և կայքերի մյուս ժամանակավոր տվյալները կջնջվեն
            <ph name="LINE_BREAKS" />
            Էջանիշները, պատմությունը և պահված գաղտնաբառերը կպահպանվեն</translation>
<translation id="4349474976990059197">João Browser Enterprise-ի լոգո</translation>
<translation id="3227699293368317033">Օգտագործեք Google-ի անվտանգության գործառույթները ձեր <ph name="DEVICE_TYPE" />-ում João Browser հավելվածի միջոցով</translation>
<translation id="6527164294507620103">Չհաջողվեց գործարկել João Browser-ը, քանի որ պրոֆիլը բացելիս սխալ առաջացավ։ Փորձեք վերագործարկել João Browser-ը։</translation>
<translation id="6741767563284518125">Կառավարել João Browser-ի պրոֆիլները</translation>
<translation id="3101491883380219087">Օգտագործեք ձեր ստեղնաշարը՝ «Gemini-ը João Browser-ում» հավելվածի և ձեր բացված ներդիրի միջև անցում կատարելու համար։</translation>
<translation id="9018218886431812662">Տեղադրումն ավարտվեց</translation>
<translation id="3370247132646333337">João Browser-ն ավելի ապահով դարձնելու համար հետևյալ ընդլայնումներն անջատվել են, որոնք նշված չեն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ում և կարող են ավելացված լինել առանց ձեր իմացության։</translation>
<translation id="1940116386572548863">Մուտք գործել João Browser</translation>
<translation id="8381652653666868014">João Browser-ն արգելափակել է այս ներբեռնումը, քանի որ արխիվացված ֆայլը կարող է այլ ֆայլեր պարունակել, որոնք կարող են վնասագրեր լինել</translation>
<translation id="8374335201144490555">Ձեր գաղտնաբառերը, էջանիշները և պատմությունը կհամաժամացվեն ձեր բոլոր սարքերում։ Հեշտությամբ օգտագործեք ձեզ ծանոթ և սիրելի գործառույթները՝ որպես կանխադրված դիտարկիչ ընտրելով João Browser-ը։ João Browser-ը կամրացվի հավելվածների վահանակում՝ արագ մուտքի համար։</translation>
<translation id="6176486087616698123">Օգտվեք Google-ի լավագույն ԱԲ գործիքներից ձեր հեռախոսի João Browser հավելվածի օգնությամբ</translation>
<translation id="9062666675513499497">Մուտք գործեք Chromium, երբ մուտք եք գործում Google-ի այլ ծառայություններ</translation>
<translation id="724802823738504651">João Browser-ն ավտոմատ փակվել է</translation>
<translation id="2689333215784698609">João Browser-ը հնացել է</translation>
<translation id="8049510467237146160">{0,plural, =1{João Browser-ը կվերագործարկվի մեկ ժամից}one{João Browser-ը կվերագործարկվի # ժամից}other{João Browser-ը կվերագործարկվի # ժամից}}</translation>
<translation id="9106236359747881194">Ընտրեք տեքստը՝ որոնելու համար</translation>
<translation id="8558551666630075184">João Browser-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 8.1 տարբերակը։</translation>
<translation id="1194819784870407331">Բացել հղումը João Browser-ի նոր &amp;ներդիրում</translation>
<translation id="911206726377975832">Ջնջե՞լ նաև ձեր դիտարկումների տվյալները:</translation>
<translation id="9134482777260927479">Օգնություն տնային աշխատանքը կատարելիս</translation>
<translation id="9148058034647219655">Ելնել</translation>
<translation id="548951409840319583">Շարունակեք այնտեղից, որտեղ կանգ էիք առել։ João Browser-ը կարող է վերականգնել ներդիրները յուրաքանչյուր վերագործարկումից հետո։ Այս գործառույթը միացնելու համար անցեք</translation>
<translation id="7614949510548815395">Ձեր համակարգի ադմինիստրատորն այնպես է կարգավորել João Browser-ը, որ <ph name="TARGET_URL_HOSTNAME" /> կայքը բացվի մեկ այլ դիտարկիչով:</translation>
<translation id="3441698750089879771">Վերագործարկել՝ &amp;João Browser-ը թարմացնելու համար</translation>
<translation id="369689859238510548">João Browser (mDNS-In)</translation>
<translation id="8336832914816665097">Անհատականացրեք João Browser-ը</translation>
<translation id="7698429329590050365">João Browser-ը հնարավոր է չաշխատի ինչպես հարկն է, քանի որ այն այլևս չի աջակցվում Windows XP և Windows Vista համակարգերում</translation>
<translation id="190261805571697214">Օգտվեք Google-ի անվտանգության լավագույն գործառույթներից João Browser-ում։</translation>
<translation id="945522503751344254">Կարծիք հայտնել</translation>
<translation id="5554799509799759090">Ո՞վ է օգտագործում João Browser-ը</translation>
<translation id="9153108844196984904">Ուժեղացրեք João Browser-ի անվտանգությունը</translation>
<translation id="983803489796659991">Չհաջողվեց տեղադրել հավելվածը, քանի որ թարմացումն իրականացնող սերվերը չունի հավելվածի համար անհրաժեշտ հեշերի տվյալներ։</translation>
<translation id="6230710687825107323">Օգտագործել João Browser-ն առանց հաշվի</translation>
<translation id="985602178874221306">Chromium Authors</translation>
<translation id="989970834842471429">Ընտրեք ցանկացած տեքստ կամ պատկեր պատկերների որոնման միջոցով որոնում անելու համար</translation>
<translation id="992780518932311116">Ձեր տեղադրության տվյալներն օգտագործելու համար Chromium-ին թույլտվություն տրամադրեք <ph name="BEGIN_LINK" />համակարգի կարգավորումներում<ph name="END_LINK" /></translation>
</translationbundle>