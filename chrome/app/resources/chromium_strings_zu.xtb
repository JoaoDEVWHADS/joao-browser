<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="1026101648481255140">Qalisa Kabusha Ukufaka</translation>
<translation id="1029669172902658969">Qalisa kabusha ukuze ubuyekeze i-&amp;ChromiumOS</translation>
<translation id="4711726241445951349">I-João Browser incoma ukuthi ubuyekeze lesi sandiso</translation>
<translation id="1042552502243217427">Lapho isayithi icela ukulayisha kusengaphambili ngasese amalinki ekhasini layo, i-Chromium isebenzisa amaseva e-Google. Lokhu kufihla ubuwena kusayithi elayishwe ngaphambilini, kodwa i-Google ifunda ukuthi yimaphi amasayithi alayishwa ngaphambilini.</translation>
<translation id="1051793555070215510">Sisize sithuthukise i-Incognito ngokuthatha le nhlolovo yomzuzu o-1.</translation>
<translation id="1065672644894730302">Okuncamelayo kwakho akukwazi ukufundwa.

Ezinye izici kungenzeka zingabi khona futhi izinguquko kokuncamelayo ngeke zize zilondolozwe.</translation>
<translation id="3937976866851867994">Umzali wakho uvale "Izimvume zamasayithi, ama-app, nezandiso" ze-João Browser</translation>
<translation id="8626021334348319355">Ukuze useshe isakhi noma isandiso esithile seJoão Browser, thayipha isinqamuleli sayo kubha yekheli, kulandelwe ukhiye wakho wekhibhodi okhethiwe</translation>
<translation id="9157778882771986870">I-João Browser ifuna ukuthumela amaphasiwedi akho. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="112640046208448578">Thola izinto noma izindawo bese ukopisha noma uhumusha umbhalo. Lapho usebenzisa Usesho Lomfanekiso, isithombe-sikrini sekhasi sithunyelwa eseveni. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">I-Chromium iyisiphequluli sakho esizenzakalelayo</translation>
<translation id="1131805035311359397">Ukuze uhlole uma ngabe amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nakwezinye izinkinga zokuvikela, <ph name="BEGIN_LINK" />ngena ngemvume ku-Chromium<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">Chofoza imenyu ye-João Browser</translation>
<translation id="1157985233335035034">Izilimi zakamuva</translation>
<translation id="1184145431117212167">Ukufaka kwehlulekile ngoba uhlobo lweWindows yakho alusekelwa.</translation>
<translation id="1185134272377778587">Mayelana ne-Chromium</translation>
<translation id="667420476518265356">Thola izexwayiso zokulandelela intengo nge-João Browser efonini yakho</translation>
<translation id="1203500561924088507">Siyabonga ngokufaka. Kufanele uqale kabusha ibhrawuza yakho ngaphambi kokusebenzisa i-<ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">Uma uvula Usesho Lomfanekiso, isihloko sekhasi, i-URL, nekhontenti, okuhlanganisa ama-PDF, kuzothunyelwa ngokuzenzekelayo kuseva. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">Ngenkathi ungene ngemvume, ungasebenzisa amaphasiwedi akho nokuningi ngeGoogle Account yakho kuJoão Browser. Ukuze ushintshe lokhu, iya kokuthi “I-akhawunti yakho kuJoão Browser”.</translation>
<translation id="4866003137980530528">Bonisa iGemini kuJoão Browser kubha yemenyu yeMac</translation>
<translation id="2526294198551578217">Ukuze ukhethe ingxenye yesikrini kuGemini kuJoão Browser, sebenzisa isinqamuleli sekhibhodi.</translation>
<translation id="7068536367561625920">Ngenkathi le thebhu ingasebenzi, inkumbulo iye yenzelwa isikhala ukugcina i-João Browser ishesha. Ungakhetha ukungahlanganisi le sayithi ekutheni ibe engasebenzi.</translation>
<translation id="3669854427836618143">I-João Browser ivimbele lokhu kudawunilodwa ngoba ifayela liyingozi</translation>
<translation id="126567311906253476">Uma ungena ngemvume kumasevisi eGoogle efana neGmail noma iYouTube nge-<ph name="USER_EMAIL" />, ungangena ngemvume ngokuzenzakalela kuChromium nge-akhawunti efanayo</translation>
<translation id="8094399825947986050">Thola iJoão Browser efonini yakho</translation>
<translation id="1290883685122687410">Iphutha lesethaphu: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">Setha iphrofayela yakho entsha ye-João Browser</translation>
<translation id="7591029065989504977">Zama ngeGemini kuJoão Browser</translation>
<translation id="8408989583029959522">I-João Browser idinga ukufinyelela i-Bluetooth ukuze ihlole amadivayisi we-Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">Ngena ngemvume kuJoão Browser efonini yakho</translation>
<translation id="1330562121671411446">Thola ulimi</translation>
<translation id="6026568602942276348">Futhi sula idatha ku-João Browser (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Kuphiniwe! Ungafinyelela futhi Usesho Lomfanekiso ngenkinobho entsha kubha yamathuluzi</translation>
<translation id="1356661055722410047">Okusha! Ungahumusha kokubili umbhalo nezithombe esikrinini sakho</translation>
<translation id="1383876407941801731">Sesha</translation>
<translation id="5807085300679014096">Sebenzisa i-app yeJoão Browser ukuze uqhubeke nokubhrawuza usendleleni</translation>
<translation id="141901961143729572">Yabelana ngemicabango yakho</translation>
<translation id="3736947618013031173">Ukuze wabelane ngewindi lakho, vumela ukurekhodwa kwesikrini kweJoão Browser Kumasethingi Ohlelo.</translation>
<translation id="1478370723027452770">Thola usizo nge-Chrome Yokuhlola</translation>
<translation id="1497802159252041924">Iphutha lokufaka <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Leli khasi livikelwe</translation>
<translation id="4379865404970367448">Yabelana ngethebhu ye-João Browser</translation>
<translation id="4436275659297289591">Ngena ngemvume kuJoão Browser</translation>
<translation id="1547469039832541117">Ivala umsebenzi ogqanyisiwe.</translation>
<translation id="449712764049695153">Phina iJoão Browser</translation>
<translation id="1574377791422810894">Amathuluzi okuphepha e-Chromium</translation>
<translation id="5480232403718129394">IJoão Browser ifuna ukusula idatha Yesiphathi sakho Sephasiwedi. Thayipha iphasiwedi yakho yeWindows ukuze uvumele lokhu.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{Umlawuli wakho udinga ukuthi uqalise kabusha i-João Browser ukuze kusetshenziswe isibuyekezo}=1{Umlawuli wakho udinga ukuthi uqalise kabusha i-João Browser ukuze kusetshenziswe isibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho udinga ukuthi uqalise kabusha i-João Browser ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho udinga ukuthi uqalise kabusha i-João Browser ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="980976428162070137">Thola okuhamba phambili kweGoogle nge-app yeJoão Browser efonini yakho</translation>
<translation id="1625909126243026060">Buyekeza izilawuli eziyinhloko zobumfihlo nokuvikeleka ku-Chromium</translation>
<translation id="1640672724030957280">Iyadawuniloda...</translation>
<translation id="1665602916345474427">Ungene ngemvume njengo-<ph name="USER_NAME" />, <ph name="USER_EMAIL" />, ubulungu. Vula imenyu ye-akhawunti</translation>
<translation id="1708414395296835197">Ungasebenzisa iChromium noma nini lapho uchofoza amalinki emiyalezweni, kumadokhumenti, nakwamanye ama-app Izobuye iphinwe ku-taskbar yakho.</translation>
<translation id="1709772298389099340">Inikeza amalungelo aphakeme e-<ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Lokhu kuzokuvumela ukuthi ukhethe emadivayisini atholakalayo futhi ubonise okuqukethwe kuwo.</translation>
<translation id="6972087163510342335">I-João Browser izosula idatha yokubhrawuza maduze</translation>
<translation id="1736443181683099871">I-Chromium izozama ukuthuthukisa ukufuna ukuya ku-HTTPS</translation>
<translation id="3879288383593333401">Idatha ye-João Browser esuliwe</translation>
<translation id="656496276885630888">I-João Browser izoqala kabusha emizuzwaneni engu-<ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Uma i-HTTPS ingatholakali, i-Chromium izosebenzisa uxhumo olungavikelekile ngaphandle kokukuxwayisa</translation>
<translation id="1226290419185955779">Vumela i-João Browser ukuthi isebenze ngemuva</translation>
<translation id="4231366995273072370">Ukuze senze i-João Browser ivikeleke, sikhubaze ezinye izandiso ezingafakwanga kuhlu lwe-<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> futhi okungenzeka zingezwe ngaphandle kolwazi lakho.</translation>
<translation id="1822049153969905781">Chofoza okuthi <ph name="BEGIN_BOLD" />Yebo<ph name="END_BOLD" /> esazisweni seWindows ukuze uphine iJoão Browser ku-taskbar yakho ukuze uyifinyelele ngokushesha.</translation>
<translation id="1321831992638405531">Phinda ufake i-João Browser</translation>
<translation id="3386967202064865436">I-João Browser izama uku-<ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="70054449700528483">Ngokuzayo uma uvula iJoão Browser ku-<ph name="DEVICE_TYPE" /> yakho, uzobona umyalelo wokusebenzisa Umphathi Wephasiwedi YeGoogle.</translation>
<translation id="1838374766361614909">Sula usesho</translation>
<translation id="5807096362853316123">Ukuze usule idatha yopheqululo kule divayisi kuphela, kuyilapho uyigcina ku-Google Account yakho, <ph name="BEGIN_LINK" />phuma ngemvume ku-João Browser<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">Dawuniloda iJoão Browser efonini yakho ukuze uvule noma usungule amaqembu ethebhu amasha usendleleni.</translation>
<translation id="185970820835152459">Ungaphatha ama-akhawunti we-Google wakho angene ngemvume. Ama-akhawunti wakho we-Google asetshenziselwe i-browser ye-Chromium, i-Play Store, i-Gmail, nokuningi. Uma ufuna ukungeza i-akhawunti yomuntu othile, njengelungu lomndeni, engeza umuntu omusha ku-<ph name="DEVICE_TYPE" /> yakho kunalokho. <ph name="LINK_BEGIN" />Funda kabanzi<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Sesha Ngosesho Lomfanekiso</translation>
<translation id="65457771685016683">U-<ph name="EXISTING_USER" /> usevele ungene ngemvume. Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume kuJoão Browser kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS" /> Uzophinde uthole amabhukhimakhi akho nokuningi ku-<ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Khetha umbhalo</translation>
<translation id="2634119629547215883">Ungena ngemvume nge-akhawunti ephethwe futhi unikezele ukuqondiswa kokulawulwa kwayo ngaphezulu kwephrofayela yakho ye-João Browser. Idatha yakho ye-João Browser, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshelwa unaphakade ku-<ph name="USER_NAME" />. Uzokwazi ukususa le datha nge-Ideshibhodi yama-Akhawunti we-Google, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. Ungadala ngokukhetha iphrofayela entsha ukuze ugcine idatha yakho ekhona ye-João Browser ihlukile. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">IChromium igcina amandla ebhethri ngokukhawulela umsebenzi ongemuva nemiphumela yokubuka, njengokuskrola okubushelelezi namazinga ohlaka lwevidiyo. <ph name="BEGIN_LINK" />Funda kabanzi mayelana Nesongi Samandla<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">Isevisi Yesibuyekezi SeJoão Browser</translation>
<translation id="1911763535808217981">Ngokuvala lokhu, ungangena ngemvume kumasayithi e-Google njenge-Gmail ngaphandle kokungena ngemvume ku-Chromium</translation>
<translation id="4037729269678342163">I-João Browser ayiphenduli. Qalisa kabusha manje?</translation>
<translation id="7563750688920581112">Inhlangano yakho, ebizwa <ph name="MANAGER" />, ifuna ungene ngemvume kuJoão Browser</translation>
<translation id="193439633299369377">I-ChromiumOS idinga ukuphinda iqaliswe ukuze kusetshenziswe isibuyekezo.</translation>
<translation id="7099143775283792684">I-João Browser ivimbele lokhu kudawunilodwa ngoba uhlobo lwefayela alivamile ukudawunilodwa futhi lingase libe yingozi</translation>
<translation id="1953553007165777902">Iyadawuniloda... Kusele imizuzu engu-<ph name="MINUTE" /></translation>
<translation id="1966382378801805537">I-Chromium ayikwazi ukunquma noma isethe isiphequluli esizenzakalelayo</translation>
<translation id="197326043290947695">Bhrawuza ngobuhlakani Ngosesho Lomfanekiso</translation>
<translation id="6185556991023272801">Funda ukuthi kungani i-João Browser ivimba amanye amafayela, ivula kuthebhu entsha</translation>
<translation id="4053636705816895911">Kugcina isofthiwe yakho yeJoão Browser ingeyakamuva. Uma le sevisi ikhutshaziswe noma imisiwe, isofthiwe yakho yeJoão Browser ngeke igcinwe ingeyakamuva, okusho ukuthi ukungavikeleki okungase kuphakame akukwazi ukulungiswa futhi izakhi zingase zingasebenzi. Le sevisi iyazikhipha uma ingekho isofthiwe yeJoão Browser eyisebenzisayo.</translation>
<translation id="2008474315282236005">Lokhu kuzosusa into engu-1 kusuka kule divayisi. Ukuze usebenzise futhi idatha yakho ngokuhamba kwesikhathi, ngena ngemvume ku-Chromium njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Ukufakwa kwehlulekile. Sicela uzame futhi.</translation>
<translation id="2039417478970545937">Amasethingi.</translation>
<translation id="2049376729098081731">Khetha ukuthi ufake phakathi umlando we-Chromium ukuze uthole umuzwa womuntu siqu kumasevisi e-Google</translation>
<translation id="6768767091114123654">Yakhelwe kuJoão Browser ukuze ikusize usungule, ulondoloze, futhi ugcwalise ngokuzenzekelayo amaphasiwedi aqinile. Faka isinqamuleli ukuze ufinyelele kalula.</translation>
<translation id="3571664229232252557">Chofoza inkinobho ethi Vumelanisa IChrome Nomuntu Ngamunye Ekhasini Lethebhu Entsha ukuze unikeze iJoão Browser ukubukeka okusha</translation>
<translation id="4273287215573278663">I-João Browser ivimbele lokhu kudawuniloda ngoba ifayela liyakhohlisa futhi lingase lenze izinguquko ezingalindelekile kudivayisi yakho</translation>
<translation id="9063967192437499581">Uzobona umyalelo wokuzama okuthi <ph name="FEATURE_NAME" /> ngesikhathi esilandelayo lapho uvula iJoão Browser iOS.</translation>
<translation id="8511569826706775962">Amaphasiwedi akho kanye nenye idatha yeJoão Browser oyilondoloze kuGoogle Account yakho izosuswa kule divayisi. Ukuze uphinde uzisebenzise kuJoão Browser, ngena ngemvume futhi.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-João Browser ingasetshenziswanga umzuzu o-1. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}one{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-João Browser ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}other{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-João Browser ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}}</translation>
<translation id="2125838419757773031">Khetha isifunda sesikrini ukuze useshe</translation>
<translation id="2126108037660393668">Ifayela elidawunilodiwe aliphumelelanga lapho liqinisekiswa.</translation>
<translation id="2135919691573380097">Bika le sayithi</translation>
<translation id="2137162749895930932">Vala isikrini sokuhumusha</translation>
<translation id="1308845716497059117">I-João Browser ivimbele lokhu kulanda ngoba isayithi alisebenzisi uxhumano oluvikelekile futhi kungenzeka ukuthi ifayela lonaniwe.</translation>
<translation id="2170098639895543546">Khetha noma yini esekhasini</translation>
<translation id="6705844023496387932">Yenza i-João Browser ngokwezifiso</translation>
<translation id="2174917724755363426">Ukufaka akuqediwe. Uqinisekile ufuna ukukhansela?</translation>
<translation id="7728290795259244895">I-João Browser - Inethiwekhi Yokungena ngemvume - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Buyekeza iphutha lokuchekha: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">Susa i-akhawunti kuJoão Browser</translation>
<translation id="4648870374540039667">Sebenzisa i-app yeJoão Browser ukuze usebenzise amathuluzi okuthenga angcono kakhulu usendleleni</translation>
<translation id="2106116820042118250">Hlala uphephile lapho usendleleni Ngokubhrawuza Okuphephe Ngokuthuthukisiwe kuJoão Browser ye-iOS</translation>
<translation id="2210682093923538346">Isayithi eyingozi. I-Chromium isuse izaziso.</translation>
<translation id="2236949375853147973">Umsebenzi Wami</translation>
<translation id="118764235932893741">Ukuze uthole amakheli akho nokuningi kuwo wonke amadivayisi akho, ngena ngemvume kuJoão Browser. Leli kheli lizolondolozwa kuGoogle Account yakho ngemva kokungena ngemvume.</translation>
<translation id="7254578863532089400">Uma wabelana ngekhompyutha, abangani nomndeni bangadlulisa amehlo ngokuhlukile baphinde basethe i-Chrome ngendlela abafuna ngayo nje.</translation>
<translation id="22571759390241347">Amakhono kuChromium</translation>
<translation id="2283803047247799269">Sesha le thebhu Ngosesho Lomfanekiso</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{IJoão Browser incoma ukumisa ithebhu enciphisa ijubane lebhrawuza yakho}one{IJoão Browser incoma ukumisa amathebhu anciphisa ijubane lebhrawuza yakho}other{IJoão Browser incoma ukumisa amathebhu anciphisa ijubane lebhrawuza yakho}}</translation>
<translation id="2307973900865360088">Kugcine Edokhini</translation>
<translation id="2313870531055795960">Kuhlola ama-URL anohlu lwamasayithi angaphephile agcinwe ku-Chromium. Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-Chromium ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile.</translation>
<translation id="2356070529366658676">Buza</translation>
<translation id="2359808026110333948">Qhubeka</translation>
<translation id="3800730051093461113">Isandiso esithi "<ph name="EXTENSION_NAME" />" sifuna ukuthi ungene ngemvume kuJoão Browser</translation>
<translation id="8758735062658446604">Vala iJoão Browser Esebenza Ngemuva kuma-App</translation>
<translation id="2623595027619107207">Ukuze usebenzise lesi sandiso njenge-<ph name="USER_EMAIL_ADDRESS" />, ngena ngemvume kuJoão Browser.</translation>
<translation id="2384373936468275798">I-ChromiumOS ayikwazanga ukuvumelanisa idatha yakho ngoba imininingwane yokungena ngemvume kwi-akhawunti yakho iphelelwe isikhathi.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{Idivayisi e-1 ye-HID ibifinyelelwa yisandiso se-João Browser esisodwa noma eziningi}=1{Idivayisi e-1 ye-HID ifinyelelwa yisandiso se-João Browser esisodwa noma eziningi}one{Amadivayisi angu-# e-HID abefinyelelwa yisandiso se-João Browser esisodwa noma eziningi}other{Amadivayisi angu-# e-HID abefinyelelwa yisandiso se-João Browser esisodwa noma eziningi}}</translation>
<translation id="6254788431480237503">I-João Browser idinga izimvume zekhamera nemakrofoni kule sayithi</translation>
<translation id="2403703063067034158">Iphutha lokuqala: esinye isenzakalo sokusetha siyaqalisa okwamanje, sicela uzame futhi ngokuhamba kwesikhathi.</translation>
<translation id="3028975423343897358">Vula amalinki kuJoão Browser kunoma iyiphi i-app futhi ugcine ibhrawuza ifinyeleleka ku-taskbar yakho</translation>
<translation id="579079006139156831">Chofoza inkinobho ethi Finyeza ukuze wabelane ngale dokhumenti neGemini kuJoão Browser ukuze uthole iqoqa elisheshayo futhi ubuze imibuzo yokulandelela</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Ngamathuluzi avela ku-Chromium<ph name="END_LINK" />, ungabhrawuza ngokuphepha bese uhlala ulawula</translation>
<translation id="7114471809991869757">U-<ph name="EXISTING_USER" /> usevele ungene ngemvume. Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume kuJoão Browser kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS" /> Uzophinde uthole namaphasiwedi akho nokuningi kuwo wonke amadivayisi akho.</translation>
<translation id="2451727308784734061">Sebenzisa isinqamuleli sakho ukuze ufike ngokushesha Kusiphathi Sephasiwedi. Ungahambisa isinqamuleli sakho esikrinini sasekhaya sekhompyutha yakho noma isiqalisi se-app.</translation>
<translation id="2709136733469807397">I-João Browser izovala maduzane</translation>
<translation id="3652225684487279741">Ku-João Browser</translation>
<translation id="2485422356828889247">Khipha</translation>
<translation id="2513154137948333830">Ukuqalisa kuyadingeka: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Khetha umbhalo Ngosesho Lomfanekiso</translation>
<translation id="1527474262707362156">I-João Browser izama ukufaka amaphasiwedi akhona esikhundleni. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="6480371226914552131">I-João Browser idinga ukufinyelela kusitoreji ukuze ilande amafayela</translation>
<translation id="6318568902186985084">Isisizi se-João Browser</translation>
<translation id="2575822587468774919">Khetha noma yini ukuze useshe Ngosesho Lomfanekiso</translation>
<translation id="4557210258834653476">Ukuze uthole amaphasiwedi akho kanye nokwengeziwe kuwo wonke amadivayisi akho, ngena ngemvume kuJoão Browser</translation>
<translation id="1148164459654218834">Skena ikhodi ye-QR ngefoni yakho ukuze udawunilode iJoão Browser bese ungena ngemvume kuGoogle Account yakho.</translation>
<translation id="235892353478111963">Qhubeka usebenzisa i-João Browser</translation>
<translation id="259935314519650377">Yehlulekile ukufaka enqolobaneni isifaki esidawunilodiwe. Iphutha: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Isistimu</translation>
<translation id="8471946631262724853">Inhlangano yakho ingabona futhi ilawule idatha yopheqululo, efana namabhukhimakhi akho, umlando, namaphasiwedi. Ayikwazi ukubona idatha yokubhrawuza kwamanye amaphrofayela eJoão Browser</translation>
<translation id="2870759219964376597">Qinisekisa ukuthi nguwe ukuze usebenzise futhi ulondoloze idatha yeJoão Browser ku-akhawunti yakho, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="2955972712254986678">{COUNT,plural, =0{Ukuvikelwa Okuthuthukile kudinga ukuthi uqalise kabusha iJoão Browser ukuze usebenzise isibuyekezo}=1{Ukuvikelwa Okuthuthukile kudinga ukuthi uqalise kabusha iJoão Browser ukuze usebenzise isibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Ukuvikelwa Okuthuthukile kudinga ukuthi uqalise kabusha iJoão Browser ukuze usebenzise isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Ukuvikelwa Okuthuthukile kudinga ukuthi uqalise kabusha iJoão Browser ukuze usebenzise isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="8949462882238006192">Qala iJoão Browser</translation>
<translation id="4224214204752803768">Iphutha le sistimu yokusebenza livele ngesikhathi sokufaka. Sicela uphinde ulande i-João Browser.</translation>
<translation id="3141414135710372892">Uma wabelana ngedivayisi, abangane nomndeni bangaphequlula ngokuhlukile baphinde basethe i-Chrome ngendlela abafuna ngayo</translation>
<translation id="8838607803339100223">Ukufinyelela okulula kokusebenzisa iGemini kuJoão Browser kudivayisi yakho yonke, nanoma iJoão Browser incishisiwe.</translation>
<translation id="1679364578146271696">Ithebhu le-João Browser</translation>
<translation id="2718390899429598676">Ngokuvikela okungeziwe, i-Chromium izobethela idatha yakho.</translation>
<translation id="1874696651662237927">Ukuze ususe i-Google Account yakho ku-João Browser, phuma ngemvume</translation>
<translation id="6850669719663104304">Ukuze uthole amaphasiwedi wakho, amabhukhimakhi, nokuningi kuwo wonke amadivayisi akho, ngena ngemvume kuJoão Browser</translation>
<translation id="2738871930057338499">Ayikwazi ukuxhuma ku-inthanethi I-HTTP 403 Yenqatshelwe. Sicela uchekhe ukulungiselelwa kommeleli wakho.</translation>
<translation id="2753623023919742414">Chofoza ukuze useshe</translation>
<translation id="4193420110872590792">Setha iJoão Browser njengesibuki sakho esizenzakalelayo se-PDF</translation>
<translation id="6614401181366354261">Lesi sandiso sinohlelo olungayilungele ikhompyutha futhi asiphephile. Sisuse ku-João Browser ukuze singasakwazi ukubona nokushintsha idatha yakho kumasayithi owavakashelayo, okufaka phakathi ulwazi lwakho lomuntu siqu.</translation>
<translation id="2799223571221894425">Qalisa kabusha</translation>
<translation id="6299858290790311689">IJoão Browser Yakho</translation>
<translation id="2816462166102338036">Sesha le vidiyo ngesakhi esithi Ukusesha Ngezithombe</translation>
<translation id="5896458971800337862">Thola imikhiqizo ngekhamera yakho, ulandelele ukwehliswa kwentengo nokuningi usendleleni ngeJoão Browser ku-iOS.</translation>
<translation id="2841525013647267359">Humusha kusuka</translation>
<translation id="2846251086934905009">Iphutha lokufaka: Isifaki asiqedanga. Ukufakwa kukhanseliwe.</translation>
<translation id="4357241592510111611">Susa kusuka  ku-João Browser...</translation>
<translation id="2850691299438350830">Kukugcina uphephile ku-Chromium futhi kungase kusetshenziswe ukuthuthukisa ukuvikeleka kwakho kwamanye ama-app we-Google lapho ungene ngemvume</translation>
<translation id="2885378588091291677">Isiphathi somsebenzi</translation>
<translation id="8887040619780090085">Mayelana ne-&amp;João Browser</translation>
<translation id="2915996080311180594">Qala Kabusha Ngemuva Kwesikhathi</translation>
<translation id="6619708652934279502">Idatha yakho ibethelwe ngomushwana wakho wokungena. Ifake ukuze usebenzise futhi wonge idatha yeJoão Browser kuGoogle Account yakho.</translation>
<translation id="2945997411976714835">Iphutha lokufaka: Inqubo yesifaki yehlulekile ukuqala.</translation>
<translation id="4566114009566397386">Ngena ngemvume ngokushesha kumasayithi usebenzisa amaphasiwedi alondoloziwe weJoão Browser ku-iOS</translation>
<translation id="562175540137901632">Inhlangano yakho iphatha iJoão Browser</translation>
<translation id="2977470724722393594">I-Chromium isesikhathini samanje</translation>
<translation id="2977506796191543575">Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-Chromium ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile</translation>
<translation id="1776205510657237623">Ukuze uhlale uphephile ku-inthanethi ngokukhethwayo komzali wakho, ngena ngemvume kuJoão Browser</translation>
<translation id="3003694935412297923">Yonke imisebenzi</translation>
<translation id="3374694374267805392">{count,plural, =1{IJoão Browser idinga ukuqinisekisa ukuthi uwena ngaphambi kokuthi idatha ethile ilondolozwe kuGoogle Account yakho futhi isetshenziswe kuwo wonke amadivayisi akho. Uma uphuma ngemvume manje, le datha (into e-1) izosulwa.}one{IJoão Browser idinga ukuqinisekisa ukuthi uwena ngaphambi kokuthi idatha ethile ilondolozwe kuGoogle Account yakho futhi isetshenziswe kuwo wonke amadivayisi akho. Uma uphuma ngemvume manje, le datha (izinto ezingu-{count}) izosulwa.}other{IJoão Browser idinga ukuqinisekisa ukuthi uwena ngaphambi kokuthi idatha ethile ilondolozwe kuGoogle Account yakho futhi isetshenziswe kuwo wonke amadivayisi akho. Uma uphuma ngemvume manje, le datha (izinto ezingu-{count}) izosulwa.}}</translation>
<translation id="4915792193596835645">Vula i-<ph name="URL" /> kuthebhu entsha ku-João Browser.</translation>
<translation id="302551344979399011">Okusha kwe-AI okufana namakhono kulondolozwa kuGoogle Account yakho futhi kulawulwa ngokuhlukile ekuvumelaniseni kweChromium</translation>
<translation id="8367114375553489372">Ingeza ku-João Browser...</translation>
<translation id="3038232873781883849">Ilinde ukufaka...</translation>
<translation id="3045032126857188731">Ulimi oluhunyushiwe: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Vala idayalogi yempendulo</translation>
<translation id="6168172692486433600">Amanye amaphrofayela e-João Browser</translation>
<translation id="884929993636327">Izandiso ziyizengezo ezikuvumela ukuthi uqambe ngokwabahlinzekelwayo iJoão Browser. Ukusuka ekuhlaleni uhlelekile, ukuya ekwenzeni lula imisebenzi yansuku zonke, izandiso zikusiza wenze iJoão Browser ibe ngeyakho.</translation>
<translation id="1525897524206034002">Siza ukwenza i-João Browser ibe ngcono ngokuthumela imibiko yokuphahlazeka ne-<ph name="UMA_LINK" /> ku-Google</translation>
<translation id="2766971658743453990">Sebenzisa i-app yeJoão Browser ukuze uvikele iGoogle usendleleni</translation>
<translation id="4387884830246074210">{NUM_DEVICES,plural, =0{Idivayisi e-1 ye-USB ibifinyelelwa yisandiso se-João Browser esisodwa noma eziningi}=1{Idivayisi e-1 ye-USB ifinyelelwa yisandiso se-João Browser esisodwa noma eziningi}one{Amadivayisi angu-# e-USB abefinyelelwa yisandiso se-João Browser esisodwa noma eziningi}other{Amadivayisi angu-# e-USB abefinyelelwa yisandiso se-João Browser esisodwa noma eziningi}}</translation>
<translation id="3413144813287436446">Umlando weJoão Browser</translation>
<translation id="9192419056064225629">Isifaki sihlulekile ukungaminyanisi ingobo yomlando. Sicela ulande i-João Browser futhi.</translation>
<translation id="310459126943037700">Yehlulekile ukuqeda imisebenzi.</translation>
<translation id="3104828284009500087">Sesha noma yini ekhasini</translation>
<translation id="3508468328135806512">Gcina amaphasiwedi akho, amabhukhimakhi, nomlando kuvunyelaniswe ngokuphelele kuwo wonke amadivayisi. Finyelela kalula izakhi ozaziyo nozithandayo ngokubuyekeza ibhrawuza yakho evuleka ngokuzenzakalelayo ibe yiJoão Browser.</translation>
<translation id="3216151988142306917">I-João Browser isebenzisa imakrofoni yakho.</translation>
<translation id="3130333203120345554">Usesho olusha</translation>
<translation id="3137969841538672700">Hudulela oseshweni</translation>
<translation id="7493177208577109722">Le thebhu isebenzisa izinsiza ezengeziwe. Ukuze uthuthukise ukusebenza kwakho, vumela iJoão Browser ikwenze kungasebenzi.</translation>
<translation id="7239354789967255675">Ukuze wabelane ngesikrini sakho, vumela ukurekhodwa kwesikrini kweJoão Browser Kumasethingi Ohlelo</translation>
<translation id="4955872590603594814">Phinda uqalise i-João Browser</translation>
<translation id="3161522574479303604">Zonke izilimi</translation>
<translation id="4697739132113629685">Vula isixhumanisi kuwindi le-João Browser Inco&amp;gnito</translation>
<translation id="1629247860984475766">Yenza ngendlela oyifisayo iphrofayela yakho entsha ye-João Browser</translation>
<translation id="1905008150929775692">Ungaqhubeka nokuxoxa Ngemodi ye-AI ngaphandle kokushintsha amathebhu. Ukuze uqalise, ngena ngemvume kuJoão Browser. Uzophinde uthole namaphasiwedi akho nokuningi kuwo wonke amadivayisi akho.</translation>
<translation id="4232381420311815141">Ukuze ususe i-Google Account yakho ku-João Browser, phuma ngemvume ku-João Browser ekhasini Lamasethingi</translation>
<translation id="3234316605225071811">Emva kwesikhathi, iChromium ingakucela ukuthi usebenzise ulwazi olulondoloziwe ukuze uzigcwalisele amafomu</translation>
<translation id="6676749542734993844">I-João Browser ayikwazi ukufunda nokubhala umkhombandlela wayo wedatha:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">Sebenzisa amathuluzi akho ayintandokazi eGoogle AI usendleleni ngeJoão Browser ku-iOS.</translation>
<translation id="3286538390144397061">Qala kabusha manje</translation>
<translation id="532528773927600103">Okhiye be-Google API abekho. Okunye ukusebenza kwe-João Browser kuzokhutshazwa.</translation>
<translation id="3296368748942286671">Qhubeka usebenzise izinhlelo zokusebenza ezingemuva uma i-Chromium ivaliwe</translation>
<translation id="3313189106987092621">I-Chromium izokuxwayisa ngaphambi kokulayisha noma iyiphi isayithi isebenzisa uxhumo olungavikelekile</translation>
<translation id="8095477191923518137">Uzophuma ngemvume emasayithini amaningi uma uvala wonke amawindi e-João Browser, ngaphandle kwe-Google Account yakho uma ungene ngemvume ku-João Browser. Ukuvumela amasayithi akukhumbule, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">ikhona elingaphezulu ngakwesokudla lendawo yokusesha: ngakwesokudla okungu-<ph name="RIGHT" />%, phezulu okungu-<ph name="TOP" />%</translation>
<translation id="3366305173356742781">Idatha ye-Chromium ku-akhawunti yakho</translation>
<translation id="3234882977104294240">Sebenzisa amaphasiwedi akho ngeJoão Browser efonini yakho</translation>
<translation id="3387527074123400161">I-ChromiumOS</translation>
<translation id="2974199599420431595">Shintshela kwiphrofayela le-João Browser elikhona kakade?</translation>
<translation id="3412460710772753638">Kokuthi Isiphathi Sephasiwedi kule divayisi</translation>
<translation id="3438772217992559640">Sesha Le Thebhu Ngosesho Lomfanekiso</translation>
<translation id="8318147705317768982">Nweba Ukubhrawuza Okuphephe Ngokuthuthukisiwe ngeJoão Browser efonini yakho</translation>
<translation id="347392028839310978">Yenza iJoão Browser ibe ngeyakho...</translation>
<translation id="3474745554856756813">Lokhu kuzobuyekeza izinto ezingu-<ph name="ITEMS_COUNT" /> kusuka kule divayisi. Ukuze ubuyise idatha yakho, ngena ngemvume ku-<ph name="USER_EMAIL" /> njengo.</translation>
<translation id="5805833167703404998">I-<ph name="SHORTCUT" /> ingashintsha phakathi kwamaphrofayela we-João Browser</translation>
<translation id="1835124883585653877">Sicela uvale wonke amawindi we-João Browser uphinde uzame futhi.</translation>
<translation id="7106246566966568195">Ukuze wabelane ngewindi lakho, vumela ukurekhodwa kwesikrini kweJoão Browser Kumasethingi Ohlelo.</translation>
<translation id="6017005873246021363">U-<ph name="EXISTING_USER" /> usevele ungene ngemvume.  Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume ku-João Browser kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="1146681170626381319">Ikhodi ye-QR yokudawuniloda ibhrawuza yeJoão Browser kumadivayisi eselula</translation>
<translation id="354621070532799440">Isikhumbuzi: Izakhi zokuphepha ezihamba phambili zeGoogle ephaketheni lakho</translation>
<translation id="2488701737291439763">Ukuze wabelane ngesikrini sakho, vumela ukurekhodwa kwesikrini kweJoão Browser Kumasethingi Ohlelo.</translation>
<translation id="3588112919289558122">Ukuvikeleka okuthuthukisiwe kuvala ukulungiselelwa kweJavaScript emasayithini iChromium engawaqapheli</translation>
<translation id="3597003331831379823">Ihlulekile ukuqalisa isethaphu ngamalungelo aphakeme. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">Ngena ngemvume kuJoão Browser</translation>
<translation id="5985252758124395804">Idatha yokuphequlula yalo muntu izosuswa kusukela kule divayisi. Ukuze uphinde uthole idatha, ngena ngemvume ku-João Browser njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{Isibuyekezo esisha se-João Browser siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha.}=1{Isibuyekezo esisha se-João Browser siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Isibuyekezo esisha se-João Browser siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Isibuyekezo esisha se-João Browser siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="3667616615096815454">Ayikwazi ukufaka, uhlelo lokusebenza alwaziwa kuseva.</translation>
<translation id="3675854891107786059">Sebenzisa <ph name="BEGIN_LINK" />umushwana wokungena <ph name="END_LINK" />ukuze ubhale ngokubethela idatha yeChrome kuGoogle Account yakho. Izindlela zokukhokha namakheli kusuka kuGoogle Pay ngeke kubethelwe. Umlando wokubhrawuza ovela kuChromium ngeke uvumelanise.</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{Umlawuli wakho ucela ukuthi uqalise kabusha i-João Browser ukuze kusetshenziswe lesi sibuyekezo}=1{Umlawuli wakho ucela ukuthi uqalise kabusha i-João Browser ukuze kusetshenziswe lesi sibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho ucela ukuthi uqalise kabusha i-João Browser ukuze kusetshenziswe lesi sibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho ucela ukuthi uqalise kabusha i-João Browser ukuze kusetshenziswe lesi sibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="4134769722455445399">Vula isixhumanisi ku&amp;thebhu elisha le-João Browser</translation>
<translation id="3728124580182886854">Linka i-Chromium namanye amasevisi e-Google ngokwenza ngokomuntu ngamunye nangezinye izinjongo</translation>
<translation id="3729187154190517324">Julisa usesho lwakho ngokufaka amathebhu amaningi, amafayela, namathuluzi usebenzisa inkinobho ethi "Faka ithebhu nokuningi".</translation>
<translation id="655691042235349825">Phatha Amaphrofayela e-João Browser</translation>
<translation id="8494798931804571569">Funda ukuthi kungani i-João Browser ivimbela ukudawuniloda okuthile</translation>
<translation id="379589255253486813">I-Chromium izokwazisa uma kukhona okudinga isibuyekezo sakho</translation>
<translation id="3802055581630249637">I-Chromium ilayisha kusengaphambili amakhasi okungenzeka uwavakashele, ukuze alayishe ngokushesha lapho uwavakashela</translation>
<translation id="3810973564298564668">Phatha</translation>
<translation id="6945066279282141856">Ukuze usebenzise amaphasiwedi akho agciniwe, landela ikhodi ye-QR, dawuniloda iJoão Browser ye-iOS bese ungena ngemvume kuGoogle Account yakho</translation>
<translation id="3846683726093018685">**Fingqa:** Ngomusho owodwa onamagama angaphansi kwa-30, chaza abantu ebhekiswe kubo nenjongo eyinhloko yekhontenti yakho eku-screenshot.

          **Phakamisa Imibuzo:** Sungula uhlu lwamachashazi olunemibuzo emi-3 ukuya kwemi-5 eshukumisa ingqondo engase ibuzwe umsebenzisi ukuze asiqonde kahle i-screenshot. Le mibuzo kufanele ihlanganise okungenani owodwa okhuluma ngokuqondile ngento ebukwayo, indlela eklanywe ngayo, noma indawo ekuyo.</translation>
<translation id="4996569675441627032"><ph name="PAGE_TITLE" /> - João Browser</translation>
<translation id="6008740052107737825">IJoão Browser idinga imvume yenethiwekhi yendawo kule sayithi</translation>
<translation id="3885770153807205175">Okokukhetha ulimi</translation>
<translation id="2390004682597453662">Yenza ngokwezifiso uphinde ulawule i-João Browser. Okuthile kudinga ukuthi ukunake - chofoza ngemininingwane.</translation>
<translation id="8262407643678629134">Chofoza igama lakho ukuze uvule i-João Browser uphinde uqale ukudlulisa amehlo.</translation>
<translation id="3892148308691398805">Kopisha umbhalo</translation>
<translation id="2168201717554927204">U-<ph name="EXISTING_USER" /> usengene ngemvume kakade kule phrofayela ye-João Browser. Ukuze uqhubeke nokuphequlula ngokwehlukile, i-João Browser ingakwazi ukukudalela iphrofayela yakho.</translation>
<translation id="1046732460303790107">Lesi sandiso sephula inqubomgomo Yesitolo sewebu se-Chrome, futhi kungenzeka singabi esiphephile. Sisuse ku-João Browser ukuze singasakwazi ukubona nokushintsha idatha yakho kumasayithi owavakashelayo, okufaka phakathi ulwazi lwakho lomuntu siqu.</translation>
<translation id="3941890832296813527">Iphutha lokufaka: Igama lefayela lesifaki alivumelekile noma alisekelwe.</translation>
<translation id="3879366121647289622">I-João Browser izama ukukopisha amaphasiwedi. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="7332365758981378072">Amaphasiwedi akho, izindlela zokukhokha, namakheli owalondoloze kuGoogle Account yakho azosuswa kule divayisi. Ukuze uphinde uzisebenzise kuJoão Browser, ngena ngemvume futhi.</translation>
<translation id="395904275706073188">Amakhasi avikelwe awakwazi ukufundwa. Zama ikhasi elehlukile.</translation>
<translation id="3962647064319009959">Funda ukuthi i-Chromium ikugcina kanjani uphephile</translation>
<translation id="3967822245660637423">Ukulanda kuqedile</translation>
<translation id="3971865010372729242">Uma uthayipha kubha yekheli noma ebhokisini lokusesha, iChromium ithumela okuthayiphayo kusesho lwenhlangano yakho, i-AI, nakumathuluzi omenzeli ukuthola iziphakamiso.</translation>
<translation id="3975724895399328945">Mayelana ne-&amp;Google Chrome Yokuhlola</translation>
<translation id="3997429360543082038">Mayelana ne-ChromiumOS</translation>
<translation id="4010059961270896984">Lapho uvakashela isayithi, iChromium ithumela ingxenye eyi-obfuscation ye-URL kokuthi <ph name="BEGIN_LINK" />Ukubhrawuza ngokuphephile kweGoogle<ph name="END_LINK" /> isebenzisa iseva yangasese efihla ikheli lakho lasesizindeni se-inthanethi. Uma isayithi ingakusekeli okuthile okusolisayo, kuzothunyelwa wonke ama-URL kanye nekhontenti encane yekhasi.</translation>
<translation id="4016217212818346953">Hlala uphephile Ngesiphathi Sephasiwedi</translation>
<translation id="4019629340646866719">I-ChromiumOS yenziwe ukuthi isebenze ngesofthiwe yomthombo ovulekile owengeziwe<ph name="BEGIN_LINK_CROS_OSS" />isofthiwe yomthombo ovulekile<ph name="END_LINK_CROS_OSS" />, njengoba kunjalo ngendawo yokuthuthukiswa kwe-<ph name="BEGIN_LINK_LINUX_OSS" />Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">Isikrini sokuhumusha</translation>
<translation id="4023601594785368013">Ulimi loqobo: <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">Vula amalinki kuJoão Browser kunoma iyiphi i-app. Futhi ukuze ifinyeleleke kalula, iphinwa ku-taskbar yakho.</translation>
<translation id="4036079820698952681">Siza i-Chromium ibengcono ngokubika <ph name="BEGIN_LINK" />izilungiselelo zamanje<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Ukuthuthukiswa kokuphepha okubalulekile nezici ezintsha kuyathokala kunguqulo yakamuva.</translation>
<translation id="4055805654398742145">Umphathi Wephasiwedi</translation>
<translation id="615818333141511791">{COUNT,plural, =1{Inhlangano yakho ivala i-João Browser ngokuzenzekelayo uma ingasetshenziswanga umzuzu o-1. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}one{Inhlangano yakho ivala i-João Browser ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}other{Inhlangano yakho ivala i-João Browser ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}}</translation>
<translation id="4118474109249235144">I-Chromium Incognito</translation>
<translation id="4122186850977583290">Iya ekhasini elithi Mayelana neChromium</translation>
<translation id="9207280419664362385">Qamba ngokwabahlinzekelwayo iChrome ukuze unikeze ibhrawuza yakho ukubukeka okusha</translation>
<translation id="3719803995198923598">Qamba ngokwabahlinzekelwayo iJoão Browser yakho</translation>
<translation id="4148957013307229264">Iyafaka...</translation>
<translation id="2954462321765112214"><ph name="PAGE_TITLE" /> - Inethiwekhi Yokungena ngemvume - i-João Browser</translation>
<translation id="7812363663832111420">Thola izinhlelo zokusebenza ezinhle, amageyimu, izandiso, namatimu we-João Browser.</translation>
<translation id="69200600645763018">Ukuze uthole lesi sandiso nokuningi kuwo wonke amakhompyutha wakho, ngena ngemvume kuJoão Browser</translation>
<translation id="7505863944027312744">Ukuze uhlale uphephile ku-inthanethi ngokukhetha komzali wakho, shintshela kuphrofayela yakho yeJoão Browser lapho usungene ngemvume kakade njengo-<ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Iyakhansela...</translation>
<translation id="4224210481850767180">Ukufaka kukhanseliwe.</translation>
<translation id="8090594705972340646">Xhumanisa idatha yakho ye-João Browser kule akhawunti?</translation>
<translation id="4251772536351901305">Ikuxwayisa mayelana namasayithi ayingozi, ngisho nalawo i-Google ebingazi ngawo ngaphambili, ngokuhlaziya idatha eningi evela kumasayithi kunokuvikela okujwayelekile. Ungakhetha ukweqa izixwayiso ze-Chromium.</translation>
<translation id="5696119579094527589">Phuma Ngemvume ku-João Browser</translation>
<translation id="4271805377592243930">Thola usizo nge-Chromium</translation>
<translation id="4281844954008187215">Imigomo yesevisi</translation>
<translation id="1245307320228150348">Ukufaka kuhlulekile ngenxa yephutha elingacacisiwe. Uma ngabe i-João Browser iyasebenza manje, sicela uyivale uphinde uzame futhi.</translation>
<translation id="7405356088321579627">Khipha amaphasiwedi Ukusuka kuJoão Browser</translation>
<translation id="4304713468139749426">Isiphathi sephasiwedi</translation>
<translation id="4334241893986177674">Sesha lesi sithombe-skrini</translation>
<translation id="212570256141568951">Qalisa iJoão Browser lapho iWindows iqala</translation>
<translation id="4400772909124543403">Asikho isibuyekezo esitholakalayo</translation>
<translation id="7463042547966071103">Phuma ku-João Browser noma kunjalo?</translation>
<translation id="4413205837991854510">Bonisa Isinqamuleli Sokusesha Umfanekiso Njalo</translation>
<translation id="4736206301215400753">Vumela i-João Browser isebenze ngemuva</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{IJoão Browser incoma ukuthi usisuse. <ph name="BEGIN_LINK" />Funda kabanzi mayelana nezandiso ezisekelwayo<ph name="END_LINK" />}one{IJoão Browser incoma ukuthi uzisuse. <ph name="BEGIN_LINK" />Funda kabanzi mayelana nezandiso ezisekelwayo<ph name="END_LINK" />}other{IJoão Browser incoma ukuthi uzisuse. <ph name="BEGIN_LINK" />Funda kabanzi mayelana nezandiso ezisekelwayo<ph name="END_LINK" />}}</translation>
<translation id="5305058100936019600">Yenza ngokwezifiso uphinde ulawule i-João Browser</translation>
<translation id="4427306783828095590">Isivikelo esithuthukisiwe senza okuningi ukuvimba ubugebengu bokweba imininingwane ebucayi kanye uhlelo olungayilungele ikhompyutha</translation>
<translation id="4434353761996769206">Iphutha lesifaki: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3461955321878243607">U-<ph name="MANAGER" /> uphatha iJoão Browser</translation>
<translation id="3379477508903866078">Faka iphrofayela yeJoão Browser</translation>
<translation id="4447409407328223819">Mayelana ne-Chrome Yokuhlola</translation>
<translation id="4074057296993529937">Ukuze usebenzise futhi ulondoloze idatha yeJoão Browser kuGoogle Account yakho, faka umushwana wakho wokungena</translation>
<translation id="4493028449971051158">Iphutha ekuqaliseni: sicela usebenzise isifaki njengomlawuli.</translation>
<translation id="4501471624619070934">Ukufaka kuhlulekile ngoba ukufinyelela kukhawulelwe kuleli zwe.</translation>
<translation id="8624811527667906941">Lesi sandiso asikashicileli izindlela zangasese zokuziphatha, njengokuthi siyiqoqa futhi siyisebenzise kanjani idatha. I-João Browser incoma ukuthi usisuse.</translation>
<translation id="5571435860030744559">Siyakwamukela ku-João Browser; iwindi elisha lesiphequluli livuliwe</translation>
<translation id="8132016625974854930">I-João Browser idinga imvume yokumepha indawo ekuzungezile futhi ilandelele izandla zakho</translation>
<translation id="6599071882590417739">Usuvele ungene ngemvume njengo-<ph name="USER_EMAIL_ADDRESS" /> kwenye iphrofayela ye-João Browser</translation>
<translation id="4548534452171747496">IChromium ilayisha ngaphambilini amakhasi okwenza ukubhrawuza nokusesha kusheshe. <ph name="BEGIN_LINK" />Funda kabanzi mayelana namakhasi okulayisha kuqala<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Uthuthukisa ukuphepha ku-inthanethi kwawo wonke umuntu uma ubika isayithi ocabanga ukuthi liyingozi.</translation>
<translation id="202208802191333704">I-João Browser ivimbele lokhu kudawuniloda ngoba uvale Ukuphequlula Okuphephile futhi ifayela alikwazi ukuqinisekiswa</translation>
<translation id="3128308674776200516">Zama iGoogle Lens ngeJoão Browser efonini yakho</translation>
<translation id="4594305310729380060">Kusiphathi Sephasiwedi kule divayisi</translation>
<translation id="7653380076752216509">Izinhlelo zokusebenza ze-João Browser</translation>
<translation id="4598116752460667024">Sesha noma iyiphi inqubo ohlwini.</translation>
<translation id="4613863813562375431">Uhlobo lwe-ChromiumOS</translation>
<translation id="4621240073146040695">Icishe isesikhathini! Qalisa kabusha i-Chromium ukuze uqedele ukubuyekeza.</translation>
<translation id="1497446027991908251">Isheshisa amasayithi anenjini yeJoão Browser V8 kodwa yenza iJoão Browser ingabi namandla okumelana nokuhlaselwa.</translation>
<translation id="7523749920868634278">Isexwayiso: I-João Browser ayikwazi ukuvimbela izandiso kusuka ekurekhodeni umlando wakho wokudlulisa amehlo. Ukuze ukhubaze lesi sandiso kumodi ye-incognito, yekisa ukukhetha le nketho.</translation>
<translation id="4673151026126227699">Uma futhi wabelana ngemibiko yokusetshenziswa kwe-Chromium, leyo mibiko ihlanganisa nama-URL owavakashelayo</translation>
<translation id="4673710618874938871">Ungene ngemvume njengo-<ph name="USER_NAME" />, ubulungu. Vula imenyu ye-akhawunti</translation>
<translation id="6608258642372806522">Iphrofayela ibukeka isetshenziswa enye inqubo ye-João Browser (<ph name="PROCESS_ID" />) kwenye ikhompyutha (<ph name="HOST_NAME" />). I-João Browser ikhiye iphrofayela ukuze ingamosheki. Uma uqinisekile ukuthi azikho ezinye izinqubo ezisebenzisa le phrofayela, ungavula iphrofayela uphinde uqalise i-João Browser.</translation>
<translation id="4680828127924988555">Khansela Ukufaka</translation>
<translation id="3912572071294857936">Enye idatha yakho yeJoão Browser ayikalondolozwa kuGoogle Account. Zama ukulinda imizuzu embalwa ngaphambi kokuphuma ngemvume. Uma uphuma ngemvume manje, le datha izosulwa.</translation>
<translation id="1077152188344040592">Ngenkathi ungene ngemvume, ungasebenzisa amaphasiwedi akho nokuningi ukusuka kuGoogle Account yakho kuJoão Browser. I-<ph name="SHORTCUT" /> ingashintsha amasethingi wakho wamasevisi eGoogle.</translation>
<translation id="5729536702149847030">Umuntu othile ungene ngemvume ngaphambilini ku-João Browser kule khompuyutha njengo-<ph name="ACCOUNT_EMAIL_LAST" />. Sicela udale umsebenzisi omusha we-João Browser ukuze ugcine ulwazi lwakho luhlukile.</translation>
<translation id="4724676981607797757">Ukufaka kuhlulekile ngenxa yephutha lephrothokholi engasekelwe.</translation>
<translation id="6273241729694500032">Phuma ku-João Browser noma kunjalo?</translation>
<translation id="3239680024825449390">Isibuyekezo esibalulekile sokuvikela se-João Browser sisanda kufakwa. Qalisa kabusha manje bese sizobuyisela amathebhu akho.</translation>
<translation id="4771701986670315895">Awukavakashi kamuva nje. IChromium isuse i-<ph name="PERMISSION_1" />, i-<ph name="PERMISSION_2" />, nokunye okungu-<ph name="COUNT" /> okwengeziwe</translation>
<translation id="1908292729364083164">Uma iGemini kuJoão Browser ivuliwe, iphaneli eseceleni ihlala ivuliwe uma usungula amathebhu amasha</translation>
<translation id="479167709087336770">Lokhu kusebenzisa isihloli sokupeleta esifanayo naleso esisetshenziswe kusesho lwe-Google. Umbhalo owuthayiphayo kusiphequluli uthunyelwa ku-Google. Ungahlala ushintsha le mpatho kuzilungiselelo.</translation>
<translation id="189382710647501724">Sebenzisa i-João Browser ngaphandle kwe-akhawunti</translation>
<translation id="4456919965836032212">Umyalo obambeke ngaphakathi we-João Browser wokuvumela ithrafikhi ye-mDNS.</translation>
<translation id="3486986778673504636">Qalisa kabusha ukuze Ubuyekeze i-&amp;João Browser</translation>
<translation id="4918086044614829423">Yamukela</translation>
<translation id="4918844574251943176">Umfanekiso ukopishiwe</translation>
<translation id="1571932028747131277">I-João Browser kumodi yasemuva.</translation>
<translation id="7612124006067933008">Chofoza ukuze uvale ibhokisi lokungena ngemvume leJoão Browser</translation>
<translation id="2598788273876744576">Ngamaphrofayela weJoão Browser ungahlukanisa zonke izinto zakho zeJoão Browser. Sungula amaphrofayela wabangane nomndeni, noma uhlukanise phakathi komsebenzi nobumnandi.</translation>
<translation id="2115498792600385171">Izihambeli zingasebenzisa i-João Browser ngaphandle kokushiya noma yini ngemuva.</translation>
<translation id="6870732303439257966">I-akhawunti Yakho kuJoão Browser</translation>
<translation id="4366792189726044065">Zingeze ngokwakho ku-João Browser</translation>
<translation id="504699503110800016">Vula imenyu yakho konke</translation>
<translation id="4340125167559705618">Finyelela zonke izintandokazi zakho zeGoogle ngeJoão Browser ku-<ph name="DEVICE_TYPE" /> yakho</translation>
<translation id="4916697359431064123">IJoão Browser idinga imvume ukuze ilandelele izandla zakho</translation>
<translation id="5141988424377517949">Awukavakashi kamuva nje. IChromium isuse i-<ph name="PERMISSION_1" />, i-<ph name="PERMISSION_2" />, i-<ph name="PERMISSION_3" />.</translation>
<translation id="5174969993834422967">Uvamise ukuvimba izaziso. Ukuze uvumele leli sayithi ukuthi likwazise, chofoza isithonjana sesaziso ekhoneni elingakwesokudla lebha yendawo yakho.</translation>
<translation id="5174983315706567306">Asikho isikhala sediski esanele.</translation>
<translation id="961070648267203077">I-akhawunti yeJoão Browser idinga ukuqinisekiswa kabusha</translation>
<translation id="69363826605946518">Qhubeka lapho ugcine khona ngeJoão Browser ku-iOS.</translation>
<translation id="471694954923709047">Phuma ngemvume ku-João Browser</translation>
<translation id="5234764350956374838">Cashisa</translation>
<translation id="5782956358171235578">Vula ilinki kuwindi leJoão Browser Inco&amp;gnito</translation>
<translation id="903712329052383264">Thola i-app yeJoão Browser ukuze ulondoloze amaphasiwedi usendleleni</translation>
<translation id="5277894862589591112">Ukuze ufake izinguquko zakho, qalisa kabusha i-Chromium</translation>
<translation id="5286907366254680517">Okutholiwe</translation>
<translation id="5593827909938092728">Thola i-app yeJoão Browser</translation>
<translation id="5294316920224716406">Uma ubhrawuza ngemodi ye-Incognito, i-Chromium izokuxwayisa ngaphambi kokulayisha isayithi isebenzisa uxhumo olungavikelekile.</translation>
<translation id="1066981078513393795">Isevisi Yangaphakathi Yesibuyekezi SeJoão Browser</translation>
<translation id="5324450571874973775">Zisebenzise kanye nezinye izakhi zeGemini kuChromium</translation>
<translation id="5346389065299425353">Julisa usesho lwakho ngokufaka amathebhu amaningi, amafayela, namathuluzi</translation>
<translation id="1884203704972162365">Thola amazwibela asheshayo ale dokhumenti bese ubuza imibuzo ngeGemini kuJoão Browser</translation>
<translation id="5352264705793813212">I-Chromium ithole izincomo ezithile zokuphepha zokubuyekeza kwakho</translation>
<translation id="4819697639570429319">Amanye Amaphrofayela e-João Browser</translation>
<translation id="7878591304929138776">IChromiumOS ayikwazanga ukulondoloza idatha yeJoão Browser kuGoogle Account yakho ngoba imininingwane yakho yokungena ngemvume ku-akhawunti iphelelwe yisikhathi</translation>
<translation id="5249614051186670898">Ungena ngemvume nge-akhawunti ephethwe futhi unikeza umlawuli wayo ukulawula okungaphezulu kwephrofayela yakho ye-João Browser. Idatha yakho ye-João Browser, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshezelwa unaphakade ku-<ph name="USER_NAME" />. Uzokwazi ukususa le datha nge-Ideshibhodi yama-Akhawunti we-Google, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Ikhodi eyengeziwe: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Ukuze uthole ukwenza ngokomuntu ngamunye, okufaka i-Chromium Kumsebenzi Wewebhu nowe-App</translation>
<translation id="108952623091824942">Funda ukuthi kungani i-João Browser ivimba amanye amafayela</translation>
<translation id="5386450000063123300">Ibuyekeza i-Chromium (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Vumela ukungena ngemvume kwe-Chromium</translation>
<translation id="1265086181910844216">Susa kusuka  ku-João Browser</translation>
<translation id="1500700851187484222">Yehlisa indlela yokusebenza kodwa kwenza iJoão Browser imelane nakakhulu nokuhlaselwa</translation>
<translation id="6665657403278704382">Setha i-João Browser njengesiphequluli sakho esizenzakalelayo</translation>
<translation id="3520901681432894293"><ph name="PAGE_TITLE" /> - João Browser Beta</translation>
<translation id="5994273394215159270">{NUM_TABS,plural, =1{IJoão Browser Incoma Ukumisa Ithebhu Enciphisa Ijubane Lebhrawuza Yakho}one{IJoão Browser Incoma Ukumisa Amathebhu Anciphisa Ijubane Lebhrawuza Yakho}other{IJoão Browser Incoma Ukumisa Amathebhu Anciphisa Ijubane Lebhrawuza Yakho}}</translation>
<translation id="646791423998269453">I-João Browser kungenzeka ingasebenzi ngokufanelekile ngoba ayisasekelwa kule sistimu yokusatshalaliswa kwe-Linux</translation>
<translation id="7249139852479053716">I-João Browser ivimbele lokhu kudawuniloda ngoba ifayela lingalimaza ama-akhawunti wakho omuntu siqu nawenethiwekhi yokuxhumana nomphakathi</translation>
<translation id="478612683981218420">Sicela ulinde ngenkathi i-João Browser ifaka izibuyekezo zesistimu zakamuva.</translation>
<translation id="3466187211963597724">I-João Browser izama ukuhlela amaphasiwedi. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="3133978491361824131">Sebenza ngaphandle kokuphazamiseka ngama-app akho ayintandokazi njengeGoogle Drive neYouTube usendleleni ngeJoão Browser.</translation>
<translation id="5524890928877629608">ikhona elingaphezulu ngakwesokunxele lendawo yokusesha: ngakwesokunxele okungu-<ph name="LEFT" />%, phezulu okungu<ph name="TOP" />%</translation>
<translation id="5527463683072221100">Vula ama-PDF ku-Chromium</translation>
<translation id="5536164441519929134">Buza<ph name="LINE_BREAK" />mayelana nale thebhu</translation>
<translation id="3902123582863904748">Ukuvikeleka, iJoão Browser ivala ukulungiselela kweJavaScript uma uvakashela isayithi okokuqala ngqa.

Uma leli khasi lingasebenzi njengoba kulindelekile, zama ukuvumela ukulungiselela.</translation>
<translation id="5924481826213021755">Bonisa iGemini kuJoão Browser kubha yemenyu yeMac bese uvula isinqamuleli sekhibhodi</translation>
<translation id="4988760628116707723">U-<ph name="EXISTING_USER" /> usevele ungene ngemvume. Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume kuJoão Browser kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS" /> Uzophinde uthole ulwazi lwakho olulondoloziwe nokuningi ku-<ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">Iphutha ekuqaliseni: sicela usebenzise isifaki njengomsebenzisi ovamile, hhayi njengomlawuli.</translation>
<translation id="697769674160644707">Sebenzisa iJoão Browser ngokuzenzakalelayo futhi uyenze iphinwe</translation>
<translation id="5596627076506792578">Izinketho eziningi</translation>
<translation id="5605834417512968703">Khetha noma yini ukuze useshe Ngosesho Lomfanekiso noma ucindezele u-escape ukuze uphume Kusesho Lomfanekiso</translation>
<translation id="5618818588972826921">Khetha noma yimuphi umbhalo noma isithombe ukuze useshe Ngosesho Lwezithombe noma cindezela u-escape ukuze uphume Oseshweni Lwezithombe</translation>
<translation id="2497422928854452258">{0,plural, =0{Isibuyekezo se-João Browser siyatholakala}=1{Isibuyekezo se-João Browser siyatholakala}one{Isibuyekezo se-João Browser sitholakala ngezinsuku ezingu-#}other{Isibuyekezo se-João Browser sitholakala ngezinsuku ezingu-#}}</translation>
<translation id="5643865575100044307">Yisule njalo idatha yesayithi kudivayisi yakho lapho uvala i-Chromium</translation>
<translation id="620465883043431255">Sicela uqalise kabusha i-João Browser manje</translation>
<translation id="5690427481109656848">I-Google LLC</translation>
<translation id="5698481217667032250">Veza i-Chromium ngalolu limi</translation>
<translation id="569897634095159764">Ayikwazi ukuxhuma ku-inthanethi Iseva elibamba idinga ukufakazela ubuqiniso.</translation>
<translation id="5768371961535086509">IChromium ikhulula inkumbulo kumathebhu angasebenzi. Lokhu kunikeza amathebhu asebenzayo namanye ama-app izinsiza zekhompyutha ezengeziwe futhi kugcina iChromium ishesha. Amathebhu akho angasebenzi aphinde asebenze ngokuzenzekela uma ubuyela kuwo. <ph name="BEGIN_LINK" />Funda kabanzi mayelana Nesilondolozi Senkumbulo<ph name="END_LINK" /></translation>
<translation id="8866372822266732235">Uma ukhohlwa umushwana wakho wokungena noma ufuna ukushintsha le sethingi, <ph name="SETTINGS_LINK" /> idatha yeJoão Browser ku-akhawunti yakho</translation>
<translation id="2106070764285625641">Yenza ngokwezifiso uphinde ulawule i-João Browser. Setha i-João Browser njengokwakho okuzenzakalelayo.</translation>
<translation id="9077878413488413377">Gcina amaphasiwedi wakho, amabhukhimakhi, nomlando kuvunyelaniswe ngokuphelele kuwo wonke amadivayisi ngokusetha iJoão Browser njengebhrawuza yakho ezenzakalelayo.</translation>
<translation id="5809516625706423866">Ayikwazi ukuxhuma ku-inthanethi I-HTTP 401 Ayigunyaziwe. Sicela uchekhe ukulungiselelwa kommeleli wakho.</translation>
<translation id="614221876503883218">Isheshisa amasayithi ngenjini yeJoão Browser V8 kodwa yenza iJoão Browser imelane kancane nokuhlaselwa. Le sethingi livaliwe.</translation>
<translation id="8788365803279840995">Ukuze usebenzise futhi ulondoloze idatha yeJoão Browser kuGoogle Account yakho, buyekeza iJoão Browser</translation>
<translation id="5824893331272123205">Ayikwazanga ukulayisha leli phaneli, zama futhi</translation>
<translation id="5805760187441013922">Siyakwamukela ku-João Browser</translation>
<translation id="5867606647614813312">Ivula izakhi ezengeziwe ukuze inikeze izivikelo eziqinile zeChromium</translation>
<translation id="5871205389137001634">Chofoza ukuze uphume Kusesho Lomfanekiso</translation>
<translation id="8367098380158627809">I-João Browser ithole ukuthi lezi zinto zinohlelo olungayilungele ikhompyutha</translation>
<translation id="5889361821821684993">I-Chromium ihlale ihlola ukuze iqinisekise ukuthi ibhrawuza inamasethingi aphephe kakhulu. Sizokwazisa uma kukhona okudinga ukubuyekezwa.</translation>
<translation id="5895138241574237353">Qalisa kabusha</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - Inethiwekhi Yokugena ngemvume</translation>
<translation id="5924017743176219022">Ixhuma Ku-inthanethi...</translation>
<translation id="7627350220326904504">Masilungiselele iJoão Browser yakho</translation>
<translation id="5941711191222866238">Nciphisa</translation>
<translation id="8680863040348007215">Ukuze uthole le bhukhimakhi nokuningi kuwo wonke amadivayisi akho, ngena ngemvume kuJoão Browser</translation>
<translation id="2008232276062354182">Yenza iJoão Browser Yakho</translation>
<translation id="5960071705175224773">Amasethingi akho ashintshwe yi-app engaziwa</translation>
<translation id="5977420883993828287">Kuphiniwe! Sebenzisa Imisebenzi Engokomongo futhi kubha yamathuluzi</translation>
<translation id="5889362640603897718">{COUNT,plural, =1{Inhlangano yakho ivala i-João Browser ngokuzenzekelayo uma ingasetshenziswanga umzuzu o-1.}one{Inhlangano yakho ivala i-João Browser ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#.}other{Inhlangano yakho ivala i-João Browser ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#.}}</translation>
<translation id="4971097497342057998">Buyekeza i-João Browser ukuze uqale ukuvumelanisa</translation>
<translation id="5990360079535151574">Ukusukela kunkinobho ethi "Imisebenzi Engokomongo" kubha yamathuluzi, ungaphinde uvule Imisebenzi Engokomongo ukuze ubuze imibuzo ngenkathi ubhrawuza</translation>
<translation id="6003112304606738118">Iyadawuniloda... Kusele amahora angu-<ph name="HOURS" /></translation>
<translation id="6009821354356307391">Cela ukulandelela</translation>
<translation id="6040143037577758943">Vala</translation>
<translation id="2100398097168307292">Thola okwengeziwe ngokuthenga ku-inthanethi uma usebenzisa i-app yeJoão Browser ku-<ph name="DEVICE_TYPE" /> yakho</translation>
<translation id="6058380562449900225">Ukuvikela idatha lakho vumela i-Chromium isuse izimvume kumasayithi ongakawavakasheli muva nje. Ayizimisi izaziso.</translation>
<translation id="4735359759698689867">&amp;Vula ku-João Browser</translation>
<translation id="6069027071882229820">Kopisha njengesithombe</translation>
<translation id="2274675514456642321">I-<ph name="EXTENSION_NAME" /> ingezwe ku-João Browser</translation>
<translation id="147381942282490529">Enza ngendlela oyifisayo uphinde ulawule i-João Browser. Isibuyekezo siyatholakala.</translation>
<translation id="8775234022739879423">Kuvuliwe • I-João Browser ayikwazi ukuqinisekisa ukuthi lesi sandiso sivela kuphi</translation>
<translation id="6634821567165410381">I-akhawunti yakho kuJoão Browser</translation>
<translation id="4398707227122702993">Vumela isandiso ukuze ubonise izicelo zokufinyelela kubha yamathuluzi ye-João Browser</translation>
<translation id="5370941509199989624">I-<ph name="FILE_NAME" /> iyingozi, ngakho-ke i-João Browser iyivimbile.</translation>
<translation id="5119118887583954582">I-João Browser izovala maduzane futhi isule idatha</translation>
<translation id="576637711620229618">Ungashintsha phakathi kwamaphrofayela we-João Browser lapha</translation>
<translation id="615103374448673771">Uma uvumela amakhukhi, i-Chromium ingase iwasebenzise lapho ilayisha kusengaphambili</translation>
<translation id="6165508094623778733">Funda kabanzi</translation>
<translation id="3738215896821824918">Sula idatha yeJoão Browser e-akhawuntini yakho</translation>
<translation id="2145111683361496197">Leli fayela kungenzeka libe nobungozi<ph name="LINE_BREAK" />I-João Browser ingakuhlolela lokhu okudawunilodwayo uma unikeza iphasiwedi. Ulwazi mayelana nefayela luthunyelwa kokuthi Ukuphequlula ngokuphephile kwe-Google, kodwa okuqukethwe kufayela kanye nephasiwedi kusala kudivayisi yakho.</translation>
<translation id="6182736845697986886">Ukufaka kuhlulekile ngenxa yephutha langaphakathi leseva yokubuyekeza.</translation>
<translation id="6050294746023477088">Yenza isiqinisekiso sokuthi ungene ngemvume ku-João Browser ku-<ph name="TARGET_DEVICE_NAME" /> yakho bese uzama ukuthumela futhi.</translation>
<translation id="3395167674702947885">Le khompyutha isivele inenguqulo yakamuva kakhulu ye-João Browser. Uma isofthiwe ingasebenzi, sicela ukhiphe i-João Browser uphinde uzame futhi.</translation>
<translation id="4384214545531685923">{0,plural, =0{I-João Browser izoqalisa kabusha manje}=1{I-João Browser izoqalisa kabusha kusekhondi elingu-1}one{I-João Browser izoqalisa kabusha kumasekhondi angu-#}other{I-João Browser izoqalisa kabusha kumasekhondi angu-#}}</translation>
<translation id="5880255774989397049">I-João Browser idinga imvume yokufinyelela kusitoreji ukuze idawunilode amafayela</translation>
<translation id="6245734527075554892">Kuhlola ama-URL anohlu lwamasayithi angaphephile agcinwe ku-Chromium</translation>
<translation id="1959823478027154444">Yenza i-João Browser ibe yisiphequluli esizenzakalelayo</translation>
<translation id="6248988683584659830">Izilungiselelo zosesho</translation>
<translation id="9191635841540101343">Thola izakhi zokuphepha ezihamba phambili zeGoogle usendleleni, nge-app yeJoão Browser efonini yakho</translation>
<translation id="538350741885862188">Phuma ku-João Browser?</translation>
<translation id="161121067714522736">Lawa mathebhu asebenzisa izinsiza ezengeziwe. Ukuze uthuthukise ukusebenza kwakho, vumela iJoão Browser iwenze angasebenzi.</translation>
<translation id="2095090272560293574">Yenza ngokwezifiso iphrofayela yakho ye-João Browser</translation>
<translation id="6290827346642914212">Qama iphrofayela lakho le-Chromium</translation>
<translation id="6472525517562723285">Isandiso sifuna ukuthi ungene kuJoão Browser</translation>
<translation id="2069878195899746465">I-<ph name="FILE_NAME" /> kungenzeka ibe ingozi, ngakho-ke i-João Browser iyivimbile.</translation>
<translation id="1283909912629029170">I-João Browser isebenzisa ikhamela yakho.</translation>
<translation id="323902744000752306">Okunye ukusebenza ku-João Browser kuyaqhubeka. Sicela uzame futhi emuva kwesikhathi.</translation>
<translation id="1292164882596462877">Manje kulula ukusebenzisa i-João Browser nge-Akhawunti yakho ye-Google nakumakhompyutha abiwe.</translation>
<translation id="6411450594978516531">Thola ukufinyelela okulula ezakhini ozaziyo, ozithandayo, futhi ozethembayo ngokusetha iJoão Browser njengebhrawuza yakho evuleka ngokuzenzakalelayo.</translation>
<translation id="3344301749774719950">Isinqamuleli se-João Browser</translation>
<translation id="8395825163097750991">I-João Browser ivimbele lokhu kudawunilodwa ngoba ifayela alivamile ukudawunilodwa futhi lingase libe yingozi</translation>
<translation id="7683737657427846440">Ingabe uqinisekile ukuthi ufuna ukukhipha i-João Browser?</translation>
<translation id="6375219077595103062">Engeza isinqamuleli Kusiphathi Sephasiwedi</translation>
<translation id="6388799252195623474">ngisize ngalokhu</translation>
<translation id="6966523531135953867">Ukuze uqhubeke, ngena ngemvume kuJoão Browser njengo-<ph name="EMAIL" />. Lokhu kuqinisekisa ukuthi unezinqubomgomo zenhlangano yakho.</translation>
<translation id="5146608242127807773">Ilogo ye-João Browser ngaphakathi kwesikrini sekhompyutha.</translation>
<translation id="6361476216650509195">I-João Browser yisiphequluli sewebhu esiqalisa amakhasi wewebhu nezinhlelo zokusebenza ngesivinini sombani. Iyashesha, izinzile, futhi isebenziseka kalula. Dlulisa amehlo kuwebhu ngokuvikeleke kakhulu ngokuvikelwa kuhlelo olungayilungele ikhompyutha nobugebengu bokweba imininingwane ebucayi eyakhelwe ku-João Browser.</translation>
<translation id="7864687914956920860">Ukuze uqinisekise ukuthi ungakwazi njalo ukusebenzisa futhi ulondoloze idatha yeJoão Browser kuGoogle Account yakho, qinisekisa ukuthi nguwe</translation>
<translation id="1160920197193662978">IJoão Browser iyashesha ukuqalisa futhi izakhi ezisebenzisa iJavaScript kufanele zisebenze ngendlela eziklanywe ngayo</translation>
<translation id="6436260184216827876">Usesho Lomfanekiso alutholakali. Zama futhi kamuva.</translation>
<translation id="6442900851116057561">Qalisa kabusha i-ChromiumOS</translation>
<translation id="6443470774889161065">I-Chromium ilayisha kusengaphambili amakhasi engeziwe ongase uwavakashele, ukuze alayishe ngokushesha kakhudlwana lapho uwavakashela</translation>
<translation id="3730564967922511625">Dawuniloda iJoão Browser efonini yakho ukuze ulandelele izintengo futhi uthole izexwayiso uma intengo yehla kunoma yiliphi isayithi</translation>
<translation id="3753019081686930624">Kuvaliwe • I-João Browser ayikwazi ukuqinisekisa ukuthi lesi sandiso sivela kuphi</translation>
<translation id="5444641426058108434">Siyakwamukela kumaphrofayela we-João Browser</translation>
<translation id="5103470775766355478">Ngokuzayo uma uvula iJoão Browser ku-<ph name="DEVICE_TYPE" /> yakho, uzobona umyalelo wokusebenzisa amaqembu amathebhu.</translation>
<translation id="9087231386723579740">Susa I-akhawunti kuJoão Browser</translation>
<translation id="4984395209542302039">Iphinde ilawule ukuthi iliphi ikhasi eliboniswa lapho uqala i-João Browser.</translation>
<translation id="648319183876919572">Ukubhrawuza Ngokuphepha Okugqamile kwenza okuningi ukukuvikela kumawebhusayithi ayingozi nakokudawunilodiwe</translation>
<translation id="1524792685704191751">Khipha i-João Browser</translation>
<translation id="6637504267182028286">Izinqamuleli zivulwe ku-João Browser</translation>
<translation id="1478247638436966279">Inhlangano yakho ivala i-João Browser uma ingasetshenziswa isikhathi esingu-<ph name="TIMEOUT_DURATION" />. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.</translation>
<translation id="1311233187253046133">Iphrofayela ngalinye linolwazi lwalo lwe-João Browser njengamabhukhimakhi, umlando, amaphasiwedi, nokuningi</translation>
<translation id="6563921047760808519">Funda kabanzi mayelana <ph name="BEGIN_LINK" />nokuthi i-Chromium igcina kanjani idatha yakho iyimfihlo<ph name="END_LINK" /></translation>
<translation id="1643078533228697915">Izinguquko kule sethingi zizosetshenziswa uma iJoão Browser iqala kabusha.</translation>
<translation id="1918630514771863338">Lawula izandiso zakho ngokuchofoza Izandiso kumenyu eyinhloko yeJoão Browser.</translation>
<translation id="4229328298978407243">Ungashintsha ukuze ubone amaphasiwedi kusuka kwenye iphrofayela ye-João Browser</translation>
<translation id="7717252965531997879">Sebenzisa i-app yeJoão Browser ukuze usebenzise amathuluzi e-AI ahamba phambili usendleleni</translation>
<translation id="6570579332384693436">Ukuze kulungiswe amaphutha okupeletwa, i-Chromium ithumela umbhalo owuthayiphayo kuzinkambu zombhalo ku-Google</translation>
<translation id="5374627817618267090">Iya kuzilungiselelo zesaziso se-João Browser</translation>
<translation id="6600016381025017075">Sesha noma yini kuleli khasi</translation>
<translation id="264335610358256197">Izinguquko zakho zizosebenza ngesikhathi esilandelayo uma uqalisa kabusha i-João Browser.</translation>
<translation id="2657584510687441826">IJoão Browser manje iqala ukusebenza lapho iWindows iqala ukuze uqale ukubhrawuza ngokushesha. Ungavala lokhu kumasethingi.</translation>
<translation id="5482413402708094860">Qhubeka lapho ogcine khona: IJoão Browser ibuyisele amathebhu esikhathi esedlule Ungakuvala lokhu ku-</translation>
<translation id="5022765692226673603">I-João Browser idinga imvume yekhamera ukudala imephu ye-3D yendawo yakho ekuzungezile</translation>
<translation id="6669284030132180248">Uma futhi ulondoloza amabhukhimakhi ku-Google Account yakho, ungakwazi ukulandelela izintengo zomkhiqizo ku-Chromium futhi waziswe uma intengo yehla.</translation>
<translation id="6676384891291319759">Finyelela i-inthanethi?</translation>
<translation id="668175097507315160">I-ChromiumOS ayikwazanga ukuvumelanisa idatha yakho yenxa yephutha lokungena ngemvume.</translation>
<translation id="3982573751008180181">Susa idatha yale app kusukela kuJoão Browser</translation>
<translation id="5613723096388999601">I-João Browser idinga imvume yemakrofoni kule sayithi</translation>
<translation id="6712881677154121168">Iphutha lokudawuniloda: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="9190188975825967506">Iphrofayela yakho ayikwazi ukusetshenziswa ngoba isuka kunguqulo entsha ye-João Browser.&#32;

Ezinye izici kungenzeka zingatholakali. Sicela ucacise umkhombandlela wephrofayela ehlukile noma usebenzise inguqulo entsha ye-João Browser.</translation>
<translation id="6729124504294600478">Ukuze uthole ukwenza ngokomuntu ngamunye nezinye izakhi, ezifaka i-Chromium Kumsebenzi wewebhu nowe-app nakumasevisi alinkiwe e-Google</translation>
<translation id="6957684879859415418">I-João Browser isivele ifakiwe kubo bonke abasebenzisi kukhompuyutha yakho.</translation>
<translation id="4411262692912917677">Ukuze uthole amabhukhimakhi nokuningi kuwo wonke amadivayisi akho, ngena ngemvume kuJoão Browser. Le bhokhimakhi izolondolozwa kuGoogle Account yakho ngemva kokungena ngemvume.</translation>
<translation id="6064901610880747710">Isheshisa amasayithi ngenjini yeJoão Browser V8 kodwa yenza iJoão Browser imelane kancane nokuhlaselwa. Le sethingi livuliwe.</translation>
<translation id="4530735110472079436">{count,plural, =1{Enye idatha yakho yeJoão Browser ayikalondolozwa kuGoogle Account yakho njengamanje. Zama ukulinda imizuzu embalwa ngaphambi kokuphuma ngemvume. Uma uphuma ngemvume manje, le datha (into e-1) izosulwa.}one{Enye idatha yakho yeJoão Browser ayikalondolozwa kuGoogle Account yakho njengamanje. Zama ukulinda imizuzu embalwa ngaphambi kokuphuma ngemvume. Uma uphuma ngemvume manje, le datha (izinto ezingu-{count}) izosulwa.}other{Enye idatha yakho yeJoão Browser ayikalondolozwa kuGoogle Account yakho njengamanje. Zama ukulinda imizuzu embalwa ngaphambi kokuphuma ngemvume. Uma uphuma ngemvume manje, le datha (izinto ezingu-{count}) izosulwa.}}</translation>
<translation id="9176853308971176490">I-João Browser incoma ukuthi uskene leli fayela ngenxa yokuthi kungenzeka ukuthi liyingozi.</translation>
<translation id="6779406956731413166">I-ChromiumOS yenziwa yenzeke yi-<ph name="BEGIN_LINK_CROS_OSS" />isofthiwe yomthombo ovulekile<ph name="END_LINK_CROS_OSS" /> engeziwe.</translation>
<translation id="6831043979455480757">Humusha</translation>
<translation id="6412488898785231889">I-João Browser ikuvumela kuthi wazi amaphasiwedi akho afakwe engcupheni</translation>
<translation id="684888714667046800">Ayikwazi ukuxhuma ku-inthanethi. Uma usebenzisa uhlelo lokuvikela, sicela uqinisekise ukuthi i-<ph name="PRODUCT_EXE_NAME" /> ikuhlelo lwabagunyaziwe.</translation>
<translation id="6750640664545078431">I-João Browser - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Ithebhu yokuqhubeka</translation>
<translation id="6862030660799253820">Sesha lesi sithombe ngesakhi esithi Ukusesha Ngezithombe</translation>
<translation id="4260365383290377081">I-João Browser ithole ukuthi i-"<ph name="EXTENSION_NAME" />" inohlelo olungayilungele ikhompyutha</translation>
<translation id="6877155553248388166">ikhona elingezansi ngakwesokudla lendawo yokusesha: ngakwesokudla okungu-<ph name="RIGHT" />%, ngezansi okungu-<ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">Kopisha</translation>
<translation id="6898028264630240901">Ungaphina Imisebenzi Engokomongo ukuze ubuze imibuzo kalula njengoba ubhrawuza</translation>
<translation id="6985817498888719203">Setha iJoão Browser njengebhrawuza evuleka ngokuzenzekela yakho uphinde uyiphine ku-taskbar yakho</translation>
<translation id="5277424858974213042">&amp;Lawula amaphrofayela eJoão Browser</translation>
<translation id="2726137364317931343">Lesi senzo sizokwenza lokhu:
          <ph name="LINE_BREAKS" />
            • Setha kabusha ikhasi lakho lokuqalisa, ikhasi lethebhu entsha, injini yokusesha namathebhu aphiniwe
            <ph name="LINE_BREAK" />
            • Vala izandiso
            <ph name="LINE_BREAK" />
            • Sula amakhukhi nenye idatha yesikhashana yesayithi
            <ph name="LINE_BREAK" />
            • Setha kabusha izinqamuleli zeJoão Browser
            <ph name="LINE_BREAKS" />
            Amabhukhimakhi, umlando, namaphasiwedi alondoloziwe ngeke aze athinteke.</translation>
<translation id="2901988969322822496">Ufinyelele umkhawulo weJoão Browser wamabhukhimakhi angu-<ph name="BOOKMARK_LIMIT" />, ngakho amanye amabhukhimakhi akho awakalondolozwa kuGoogle Account yakho okwamanje.

Amabhukhimakhi amasha awakwazi ukulondolozwa e-akhawuntini yakho uze usule amanye. Uma uphuma ngemvume manje, amabhukhimakhi angalondoloziwe azosulwa.</translation>
<translation id="6203410920314218280">Vula isixhumanisi kuwindi le-João Browser inco&amp;gnito</translation>
<translation id="6965382102122355670">KULUNGILE</translation>
<translation id="6985329841647292029">Imigomo ye-ChromiumOS</translation>
<translation id="8064285182627814996">Bhala umushwana wokungena ozowusebenzisa futhi ulondoloze idatha yeJoão Browser ku-akhawunti yakho, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="7011190694940573312">Ukufakwa kwehlulekile ngenxa yokuthi lolu hlobo lwesistimu yokusebenza alusekelwe.</translation>
<translation id="7024536598735240744">Iphutha lokuvula: <ph name="UNPACK_ERROR" />.</translation>
<translation id="181803036615530330">Yenza i-João Browser Ibe Ngeyakho</translation>
<translation id="7047386856539490735">Ingabe ibe wusizo le miphumela?</translation>
<translation id="2478245051737698828">Buyekeza i-João Browser</translation>
<translation id="452909342278940733">Uma isithombe singanayo incazelo ephelele, i-João Browser izozama ukukunikezela eyodwa. Ukuze udale izincazelo, izithombe zithunyelwa ku-Google.</translation>
<translation id="8606769615526968368">Thola amandla e-AI uma usebenzisa i-app yeJoão Browser ku-<ph name="DEVICE_TYPE" /> yakho</translation>
<translation id="2061960765882453684">Thatha amaphasiwedi akho, amathebhu nokuningi usendleleni nge-app yeJoão Browser efonini yakho</translation>
<translation id="7141270731789036260">Yenza i-Chrome ibe ngokwezifiso ukuze ihlolwe</translation>
<translation id="7147227333672430807">Ungasebenzisa iChromium noma nini lapho uchofoza amalinki emiyalezweni, amadokhumenti, namanye ama-app</translation>
<translation id="6949173677980969871">Susa <ph name="EXTENSION_NAME" /> kuJoão Browser</translation>
<translation id="3556355753960287061">Inhlangano yakho isula idatha ye-João Browser uma ingasetshenziswa isikhathi esingu-<ph name="TIMEOUT_DURATION" />. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.</translation>
<translation id="8689006320829658442">I-João Browser idinga imvume yekhamera kule sayithi</translation>
<translation id="7501884108538572227">Ayikwazanga ukuqalisa i-João Browser. Zama futhi.</translation>
<translation id="5484563502710761706">Buza noma yini, lapho ukhona, ngeGemini kuJoão Browser</translation>
<translation id="3823264355161086552">Gcina iJoão Browser Edokhini yakho ukuze ufike kuyo ngokushesha noma nini</translation>
<translation id="9153902741226700840">Sebenzisa i-João Browser noma nini lapho uchofoza amalinki emiyalezweni, kumadokhumenti, nakwamanye ama-app</translation>
<translation id="7216228761061470870">Uma usebenzisa Usesho Lomfanekiso kudeskithophu, isihloko sekhasi, i-URL, nekhontenti, okuhlanganisa ama-PDF, kuthunyelwa kuseva</translation>
<translation id="7950844619283784703">Isiphathi somsebenzi - I-João Browser</translation>
<translation id="133513825972536773">U-<ph name="EXISTING_USER" /> usevele ungene ngemvume. Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume kuJoão Browser kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS" /> Uzothola nemininingwane yakho elondoloziwe nokuningi kuwo wonke amadivayisi akho.</translation>
<translation id="4558982617284733740">Qala ukubhrawuza ngokushesha: IJoão Browser manje ingaqala lapho iWindows iqala.</translation>
