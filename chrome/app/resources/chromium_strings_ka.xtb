<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Chromium-ის ამ ენაზე ჩვენება</translation>
<translation id="569897634095159764">ინტერნეტთან დაკავშირება ვერ ხერხდება. პროქსი-სერვერი საჭიროებს ავტორიზაციას.</translation>
<translation id="5768371961535086509">Chromium გაასუფთავებს მეხსიერებას უმოქმედო ჩანართებიდან. აქტიურ ჩანართებსა და სხვა აპებს კომპიუტერის მეტი რესურსის გამოყენების საშუალება მიეცემა, რაც დააჩქარებს Chromium-საც. თქვენი არააქტიური ჩანართები ავტომატურად გააქტიურდება, როცა მათ დაუბრუნდებით. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი მეხსიერების დამზოგის შესახებ<ph name="END_LINK" /></translation>
<translation id="8866372822266732235">საიდუმლო ფრაზის დავიწყების ან ამ პარამეტრის შეცვლის სურვილის შემთხვევაში, ცადეთ João Browser მონაცემების <ph name="SETTINGS_LINK" /> თქვენს ანგარიშში</translation>
<translation id="2106070764285625641">მოირგეთ და მართეთ João Browser. დააყენეთ João Browser ნაგულისხმევად.</translation>
<translation id="9077878413488413377">დაასინქრონეთ თქვენი პაროლები, სანიშნეები და ისტორია თქვენს მოწყობილობებში, რისთვისაც João Browser ნაგულისხმევ ბრაუზერად უნდა დააყენოთ.</translation>
<translation id="5809516625706423866">ინტერნეტთან დაკავშირება ვერ ხერხდება. HTTP 401 — არ არის ავტორიზაცია. შეამოწმეთ პროქსი-სერვერის კონფიგურაცია.</translation>
<translation id="614221876503883218">აჩქარებს João Browser-ის V8 მექანიზმის მქონე საიტების მუშაობას, მაგრამ João Browser ოდნავ ნაკლებად უძლებს შეტევებს. ეს პარამეტრი გამორთულია.</translation>
<translation id="8788365803279840995">João Browser-ის მონაცემების თქვენს Google ანგარიშში გამოყენებისა და შენახვისთვის განაახლეთ João Browser</translation>
<translation id="5824893331272123205">ეს პანელი ვერ ჩაიტვირთა, ხელახლა ცადეთ</translation>
<translation id="5805760187441013922">მოგესალმებათ João Browser!</translation>
<translation id="5867606647614813312">ჩართავს დამატებით ფუნქციებს Chromium-ის ყველაზე ძლიერი დაცვის უზრუნველსაყოფად</translation>
<translation id="5871205389137001634">დააწკაპუნეთ სურათების ძიებიდან გასასვლელად</translation>
<translation id="8367098380158627809">João Browser-მა აღმოაჩინა, რომ შემდეგი ერთეულები შეიცავს მავნე პროგრამას:</translation>
<translation id="5889361821821684993">Chromium რეგულარულად ამოწმებს, არის თუ არა თქვენს ბრაუზერში ყველაზე უსაფრთხო პარამეტრები. გაცნობებთ, თუ რაიმეს შემოწმება იქნება საჭირო.</translation>
<translation id="5895138241574237353">გადატვირთვა</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> — ქსელში შესვლა</translation>
<translation id="5924017743176219022">მიმდინარეობს ინტერნეტთან დაკავშირება...</translation>
<translation id="7627350220326904504">მოამზადეთ თქვენი João Browser</translation>
<translation id="5941711191222866238">ჩაკეცვა</translation>
<translation id="8680863040348007215">ამ სანიშნისა და სხვა კონტენტის თქვენს მოწყობილობაში მისაღებად შედით João Browser-ში</translation>
<translation id="2008232276062354182">მოირგეთ João Browser</translation>
<translation id="5960071705175224773">თქვენი პარამეტრები შეცვალა უცნობმა აპმა</translation>
<translation id="5977420883993828287">ჩამაგრებულია! ხელახლა გამოიყენეთ კონტექსტური ამოცანები ხელსაწყოთა ზოლიდან</translation>
<translation id="5889362640603897718">{COUNT,plural, =1{თქვენი ორგანიზაცია ავტომატურად ხურავს João Browser-ს, როცა ის 1 წუთის განმავლობაში არ გამოიყენება.}other{თქვენი ორგანიზაცია ავტომატურად ხურავს João Browser-ს, როცა ის # წუთის განმავლობაში არ გამოიყენება.}}</translation>
<translation id="4971097497342057998">სინქრონიზაციის დასაწყებად, განაახლეთ João Browser</translation>
<translation id="5990360079535151574">ხელსაწყოთა ზოლზე არსებული ღილაკით „კონტექსტური ამოცანები“ შეგიძლიათ, ნებისმიერ დროს დაუბრუნდეთ ამ ფუნქციას და დასვათ კითხვები ინტერნეტში ძიების პარალელურად</translation>
<translation id="6003112304606738118">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="HOURS" /> საათი</translation>
<translation id="6009821354356307391">გაგზავნეთ შემდგომი მოთხოვნა</translation>
<translation id="6040143037577758943">დახურვა</translation>
<translation id="2100398097168307292">მეტად გამოიყენეთ ონლაინ შოპინგის შესაძლებლობები, როდესაც სარგებლობთ João Browser აპით თქვენს <ph name="DEVICE_TYPE" />-ზე</translation>
<translation id="6058380562449900225">თქვენი მონაცემების დაცვის მიზნით, მიეცით საშუალება Chromium-ს გააუქმოს ნებართვები საიტებს, რომლებზეც ბოლო დროს არ გადასულხართ. აღნიშნული არ გათიშავს შეტყობინებების მიღების ფუნქციას.</translation>
<translation id="4735359759698689867">João Browser-ში &amp;გახსნა</translation>
<translation id="6069027071882229820">სურათად კოპირება</translation>
<translation id="2274675514456642321"><ph name="EXTENSION_NAME" /> დაემატა João Browser-ს</translation>
<translation id="147381942282490529">მოირგეთ და გააკონტროლეთ João Browser. ხელმისაწვდომია განახლება.</translation>
<translation id="8775234022739879423">ჩართული • João Browser ვერ ადასტურებს ამ გაფართოების წარმომავლობას</translation>
<translation id="6634821567165410381">თქვენი ანგარიში João Browser-ში</translation>
<translation id="4398707227122702993">გაფართოებისთვის João Browser-ის ხელსაწყოთა ზოლში წვდომის მოთხოვნების ჩვენების დაშვება</translation>
<translation id="5370941509199989624">João Browser-მა დაბლოკა <ph name="FILE_NAME" />, რადგან ის სახიფათოა.</translation>
<translation id="5119118887583954582">João Browser მალე დაიხურება, ხოლო მონაცემები წაიშლება</translation>
<translation id="576637711620229618">აქ შეგიძლიათ João Browser პროფილებს შორის გადართვა</translation>
<translation id="615103374448673771">ქუქი-ჩანაწერების დაშვების შემთხვევაში, Chromium-მა, შესაძლოა, გამოიყენოს ისინი წინასწარ ჩატვირთვისთვის</translation>
<translation id="6165508094623778733">შეიტყვეთ მეტი</translation>
<translation id="3738215896821824918">გაასუფთავეთ João Browser-ის მონაცემები თქვენს ანგარიშში</translation>
<translation id="2145111683361496197">ეს ფაილი, შესაძლოა, სახიფათო იყოს<ph name="LINE_BREAK" />João Browser-ს შეუძლია, თქვენ ნაცვლად შეამოწმოს ეს ჩამოტვირთვა, თუ პაროლს მიუთითებთ. ფაილის შესახებ ინფორმაცია ეგზავნება Google Safe Browsing-ს, თუმცა ფაილების შიგთავსი და პაროლი რჩება თქვენს მოწყობილობაზე.</translation>
<translation id="6182736845697986886">ინსტალაცია ვერ მოხერხდა განახლების სერვერის შიდა შეცდომის გამო.</translation>
<translation id="6050294746023477088">დარწმუნდით, რომ თქვენს <ph name="TARGET_DEVICE_NAME" />-ზე შესული ხართ João Browser-ში, შემდეგ კი ხელახლა ცადეთ გაგზავნა.</translation>
<translation id="3395167674702947885">ამ კომპიუტერს უკვე აქვს João Browser.-ის უფრო ახალი ვერსია. იმ შემთხვევაში, თუ პროგრამა არ მუშაობს, გთხოვთ, განახორციელეთ João Browser-ის დეინსტალაცია და სცადეთ ისევ.</translation>
<translation id="4384214545531685923">{0,plural, =0{João Browser ახლა ხელახლა გაეშვება}=1{João Browser ხელახლა გაეშვება 1 წამში}other{João Browser ხელახლა გაეშვება # წამში}}</translation>
<translation id="5880255774989397049">ფაილების ჩამოსატვირთად João Browser საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="6245734527075554892">შეამოწმებს URL-ების თანხვედრას Chromium-ში შენახულ არაუსაფრთხო საიტების სიასთან</translation>
<translation id="1959823478027154444">João Browser გახდეს ნაგულისხმევი ბრაუზერი</translation>
<translation id="6248988683584659830">ძიების პარამეტრები</translation>
<translation id="9191635841540101343">მიიღეთ Google-ის უსაფრთხოების საუკეთესო ფუნქციები ნებისმიერი ადგილიდან, João Browser აპის მეშვეობით თქვენს ტელეფონში</translation>
<translation id="538350741885862188">გსურთ João Browser-იდან გამოსვლა?</translation>
<translation id="161121067714522736">ეს ჩანართები დამატებით რესურსებს მოიხმარს. ეფექტურობის გაზრდის მიზნით, ნება დართეთ João Browser-ს, ჩანართები უმოქმედო რეჟიმში გადაიტანოს.</translation>
<translation id="2095090272560293574">თქვენი João Browser პროფილის მორგება</translation>
<translation id="6290827346642914212">დაასათაურეთ თქვენი Chromium პროფილი</translation>
<translation id="6472525517562723285">გაფართოების გამოსაყენებლად შედით João Browser-ში</translation>
<translation id="2069878195899746465">João Browser-მა დაბლოკა <ph name="FILE_NAME" />, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="1283909912629029170">João Browser იყენებს თქვენს კამერას.</translation>
<translation id="323902744000752306">João Browser-ში სხვა ოპერაცია მიმდინარეობს. გთხოვთ, ცადოთ მოგვიანებით.</translation>
<translation id="1292164882596462877">ყველა საერთო მოხმარების კომპიუტერზე ადვილი გახდა Google ანგარიშით João Browser-ის გამოყენება.</translation>
<translation id="6411450594978516531">დააყენეთ João Browser ნაგულისხმევ ბრაუზერად და მიიღეთ მარტივი წვდომა იმ ფუნქციებზე, რომლებსაც იცნობთ, გიყვართ და ენდობით.</translation>
<translation id="3344301749774719950">João Browser-ის მალსახმობი</translation>
<translation id="8395825163097750991">João Browser-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="7683737657427846440">ნამდვილად გსურთ მოახდინოთ João Browser-ის დეინსტალაცია?</translation>
<translation id="6375219077595103062">დაამატეთ პაროლების მმართველის მალსახმობი</translation>
<translation id="6388799252195623474">დახმარება მჭირდება</translation>
<translation id="6966523531135953867">გასაგრძელებლად შედით João Browser-ში ანგარიშით <ph name="EMAIL" />. ამგვარად თქვენს ხელთ იქნება თქვენი ორგანიზაციის დებულებები.</translation>
<translation id="5146608242127807773">João Browser-ის ლოგო კომპიუტერის ეკრანზე.</translation>
<translation id="6361476216650509195">João Browser არის ვებ ბრაუზერი, რომელიც ვებგვერდებს და აპლიკაციებს ელვისებური სისწრაფით ხსნის. ის არის სწრაფი, სტაბილური და გამოსაყენებლად მარტივი. დაათვალიერეთ ვები უფრო უსაფრთხოდ João Browser-ში ჩაშენებული საზიანო პროგრამული უზრუნველყოფისა და თაღლითობისგან დაცვის საშუალებით.</translation>
<translation id="7864687914956920860">დაადასტურეთ ვინაობა, რომ თქვენს Google ანგარიშში გამოიყენოთ და შეინახოთ João Browser-ის მონაცემები</translation>
<translation id="1160920197193662978">João Browser უფრო სწრაფად, ხოლო ფუნქციები, რომლებიც JavaScript-ს იყენებს, დანიშნულებისამებრ იმუშავებს</translation>
<translation id="6436260184216827876">სურათების ძიება მიუწვდომელია. ცადეთ მოგვიანებით.</translation>
<translation id="6442900851116057561">გადატვირთეთ ChromiumOS</translation>
<translation id="6443470774889161065">Chromium წინასწარ ჩატვირთავს უფრო მეტ გვერდს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="3730564967922511625">ჩამოტვირთეთ João Browser თქვენს ტელეფონში, რომ თვალი ადევნოთ ფასებს და მიიღოთ გაფრთხილებები, როცა რომელიმე საიტზე ფასი დაიკლებს</translation>
<translation id="3753019081686930624">გამორთული • João Browser ვერ ადასტურებს ამ გაფართოების წარმომავლობას</translation>
<translation id="5444641426058108434">მოგესალმებათ João Browser პროფილები</translation>
<translation id="5103470775766355478">შემდეგ ჯერზე, როცა გახსნით João Browser-ს თქვენს <ph name="DEVICE_TYPE" />-ში, დაინახავთ მოთხოვნას ჩანართების ჯგუფების გამოყენების შესახებ.</translation>
<translation id="9087231386723579740">ანგარიშის ამოშლა João Browser-იდან</translation>
<translation id="4984395209542302039">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება João Browser-ის გაშვებისას.</translation>
<translation id="648319183876919572">გაძლიერებული Safe Browsing მეტად გიცავთ სახიფათო ვებსაიტებისა და ჩამოტვირთვებისგან</translation>
<translation id="1524792685704191751">João Browser-ის დეინსტალაცია</translation>
<translation id="6637504267182028286">მალსახმობები იხსნება João Browser-ში</translation>
<translation id="1478247638436966279">თქვენი ორგანიზაცია ხურავს João Browser-ს, როცა ის <ph name="TIMEOUT_DURATION" /> არ გამოიყენება. დათვალიერების მონაცემები წაიშალა. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="1311233187253046133">თითოეულ პროფილში ინახება საკუთარი João Browser ინფორმაცია, როგორიცაა სანიშნეები, ისტორია, პაროლები და სხვა</translation>
<translation id="6556755379298048869">მოიძიეთ კლავიატურის მალსახმობით.</translation>
<translation id="6563921047760808519">შეიტყვეთ მეტი იმის შესახებ, თუ <ph name="BEGIN_LINK" />როგორ ინარჩუნებს Chromium თქვენი მონაცემების კონფიდენციალურობას<ph name="END_LINK" /></translation>
<translation id="1643078533228697915">ამ პარამეტრის ცვლილება ამოქმედდება João Browser-ის გადატვირთვისთანავე.</translation>
<translation id="1918630514771863338">მართეთ თქვენი გაფართოებები João Browser-ის მთავარ მენიუში „გაფართოებებზე“ დაწკაპუნებით.</translation>
<translation id="4229328298978407243">ახლა შეგიძლიათ გადართვა, პაროლები სხვა João Browser პროფილიდან რომ ნახოთ</translation>
<translation id="7717252965531997879">გამოიყენეთ João Browser აპი, რომ საუკეთესო AI ხელსაწყოები თან იქონიოთ</translation>
<translation id="6570579332384693436">მართლწერის შეცდომების გასასწორებლად, Chromium თქვენ მიერ ტექსტის ველში აკრეფილ ტექსტებს Google-ს უგზავნის</translation>
<translation id="5374627817618267090">João Browser-ის შეტყობინების პარამეტრებზე გადასვლა</translation>
<translation id="6600016381025017075">მოძებნეთ ნებისმიერი რამ ამ გვერდზე</translation>
<translation id="264335610358256197">თქვენი ცვლილებები გააქტიურდება João Browser-ის შემდეგი გაშვებისას.</translation>
<translation id="2657584510687441826">João Browser ახლა Windows-ის ჩართვისას გაეშვება, რათა დათვალიერება მომენტალურად დაიწყოთ. ამის გამორთვა პარამეტრებიდან შეგიძლიათ.</translation>
<translation id="5482413402708094860">გააგრძელეთ იქიდან, სადაც გაჩერდით: João Browser-მა აღადგინა ჩანართები თქვენი ბოლო სესიიდან. ამის გამორთვა შეგიძლიათ აქ:</translation>
<translation id="5022765692226673603">თქვენი შემოგარენის 3-განზომილებიანი რუკის შესაქმნელად João Browser საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="6669284030132180248">თუ თქვენს სანიშნეებს Google ანგარიშშიც ინახავთ, შეგიძლიათ თვალი მიადევნოთ პროდუქტების ფასებს Chromium-ში და შეიტყოთ, როცა ფასი დაიკლებს</translation>
<translation id="6676384891291319759">წვდომა ინტერნეტზე</translation>
<translation id="668175097507315160">ChromiumOS-მა ვერ დაასინქრონა თქვენი მონაცემები შესვლის შეცდომის გამო.</translation>
<translation id="3982573751008180181">ამ აპის მონაცემების João Browser-იდან ამოშლა</translation>
<translation id="5613723096388999601">João Browser საჭიროებს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="6712881677154121168">შეცდომა ჩამოტვირთვისას: <ph name="DOWNLOAD_ERROR" /></translation>
<translation id="9190188975825967506">თქვენი პროფილის გამოყენება შეუძლებელია, რადგან ის João Browser-ის უახლესი ვერსიიდანაა.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს. გთხოვთ მიუთითოთ სხვადასხვა პროფილის დირექტორია ან გამოიყენეთ João Browser-ის ახალი ვერსია.</translation>
<translation id="6729124504294600478">პერსონალიზაციის და სხვა ფუნქციებით რომ ისარგებლოთ, დაურთეთ Chromium როგორც ვებსა და აპებში აქტივობას, ისე მიბმულ Google სერვისებს</translation>
<translation id="6957684879859415418">João Browser უკვე დაინსტალირებულია თქვენი კომპიუტერის ყველა მომხმარებლისთვის.</translation>
<translation id="4411262692912917677">შედით João Browser-ში, რომ მიიღოთ სანიშნეები და სხვა მონაცემები თქვენს ყველა მოწყობილობაზე. შესვლის შემდეგ ეს სანიშნე შეინახება თქვენს Google ანგარიშში.</translation>
<translation id="6064901610880747710">აჩქარებს João Browser-ის V8 მექანიზმის მქონე საიტების მუშაობას, მაგრამ João Browser ოდნავ ნაკლებად უძლებს შეტევებს. ეს პარამეტრი ჩართულია.</translation>
<translation id="4530735110472079436">{count,plural, =1{თქვენი João Browser-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Google ანგარიშში. ანგარიშიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში აღნიშნული მონაცემები (1 ერთეული) წაიშლება.}other{თქვენი João Browser-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Google ანგარიშში. ანგარიშიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში აღნიშნული მონაცემები ({count} ერთეული) წაიშლება.}}</translation>
<translation id="9176853308971176490">João Browser გირჩევთ, დაასკანიროთ ეს ფაილი, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="6779406956731413166">ChromiumOS-ს უზრუნველყოფს დამატებითი <ph name="BEGIN_LINK_CROS_OSS" />ღია წყაროს პროგრამული უზრუნველყოფა<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6831043979455480757">თარგმნა</translation>
<translation id="6412488898785231889">João Browser გაცნობებთ, თუ თქვენს პაროლებს ვინმე გატეხავს</translation>
<translation id="684888714667046800">ინტერნეტთან დაკავშირება ვერ ხერხდება. თუ ქსელის დაცვას იყენებთ, დარწმუნდით, რომ <ph name="PRODUCT_EXE_NAME" /> დაშვებულთა სიაშია.</translation>
<translation id="6750640664545078431">João Browser — <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">შეეხეთ გასაგრძელებლად</translation>
<translation id="6862030660799253820">სურათების ძიების მეშვეობით ამ სურათის ძიება</translation>
<translation id="6869568587896659271">ვებსაიტებზე წვდომა პირდაპირ მისამართთა ზოლის ქვემოდან</translation>
<translation id="4260365383290377081">João Browser-მა აღმოაჩინა, რომ „<ph name="EXTENSION_NAME" />“ შეიცავს მავნე პროგრამას</translation>
<translation id="6877155553248388166">ძიების არეალის ქვედა მარჯვენა კუთხე: მარჯვნივ <ph name="RIGHT" />%, ქვემოთ <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">კოპირება</translation>
<translation id="6898028264630240901">შეგიძლიათ ჩაამაგროთ კონტექსტური ამოცანები, რათა დასვათ კითხვები დათვალიერებისას</translation>
<translation id="6985817498888719203">დააყენეთ João Browser ნაგულისხმევ ბრაუზერად და ჩაამაგრეთ ის თქვენს ამოცანათა ზოლში</translation>
<translation id="5277424858974213042">João Browser პროფილების &amp;მართვა</translation>
<translation id="2726137364317931343">ეს მოქმედება:
          <ph name="LINE_BREAKS" />
            • გადააყენებს თქვენს გაშვების გვერდს, ახალი ჩანართის გვერდს, საძიებო სისტემას და ჩამაგრებულ ჩანართებს
            <ph name="LINE_BREAK" />
            • გათიშავს გაფართოებებს
            <ph name="LINE_BREAK" />
            • წაშლის ქუქი-ჩანაწერებს და საიტების სხვა დროებით მონაცემებს
            <ph name="LINE_BREAK" />
            • გადააყენებს João Browser-ის მალსახმობებს
            <ph name="LINE_BREAKS" />
            სანიშნეები, ისტორია და შენახული პაროლები ხელუხლებელი დარჩება.</translation>
<translation id="2901988969322822496">თქვენ მიაღწიეთ João Browser-ის <ph name="BOOKMARK_LIMIT" /> სანიშნის ლიმიტს, ამიტომ თქვენი ზოგიერთი სანიშნე ჯერ არ შენახულა თქვენს Google ანგარიშში.

ახალი სანიშნეების შენახვა თქვენს ანგარიშში ვერ მოხერხდება, სანამ რამდენიმეს არ წაშლით. ახლა გასვლის შემთხვევაში შეუნახავი სანიშნები წაიშლება.</translation>
<translation id="6203410920314218280">ბმულის გახსნა João Browser-ის ინკო&amp;გნიტო ფანჯარაში</translation>
<translation id="6965382102122355670">კარგი</translation>
<translation id="6985329841647292029">ChromiumOS პირობები</translation>
<translation id="8064285182627814996">შეიყვანეთ თქვენი საიდუმლო ფრაზა, რომ გამოიყენოთ და შეინახოთ João Browser-ის მონაცემები თქვენს ანგარიშში, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="7011190694940573312">ინსტალაცია ვერ მოხერხდა, რადგან ოპერაციული სისტემის ეს ვერსია მხარდაჭერილი არ არის.</translation>
<translation id="7024536598735240744">შეცდომა ამოღებისას: <ph name="UNPACK_ERROR" />.</translation>
<translation id="181803036615530330">მოირგეთ João Browser</translation>
<translation id="7047386856539490735">გამოგადგათ ეს შედეგები?</translation>
<translation id="2478245051737698828">განაახლეთ João Browser</translation>
<translation id="452909342278940733">თუ სურათს არ ექნება სასარგებლო აღწერილობა, João Browser შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება Google-ში.</translation>
<translation id="8606769615526968368">მიიღეთ ხელოვნური ინტელექტის შესაძლებლობები, როცა João Browser აპს იყენებთ თქვენს <ph name="DEVICE_TYPE" />-ზე</translation>
<translation id="2061960765882453684">თქვენი პაროლები, ჩანართები და სხვა მონაცემები მუდამ თქვენთანაა João Browser აპით თქვენს ტელეფონში</translation>
<translation id="7141270731789036260">Chrome for Testing-ის მორგება</translation>
<translation id="7147227333672430807">შეგიძლიათ გამოიყენოთ Chromium, როცა შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე აწკაპუნებთ.</translation>
<translation id="6949173677980969871">ამოშალეთ <ph name="EXTENSION_NAME" /> João Browser-იდან</translation>
<translation id="3556355753960287061">თქვენი ორგანიზაცია შლის João Browser-ის მონაცემებს, როცა ის <ph name="TIMEOUT_DURATION" /> არ გამოიყენება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="8689006320829658442">João Browser საჭიროებს კამერზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="7501884108538572227">João Browser-ის გაშვება ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="5484563502710761706">იკითხეთ ნებისმიერი რამ პირდაპირ იქ, სადაც ხართ, Gemini-ს მეშვეობით João Browser-ში</translation>
<translation id="3823264355161086552">დატოვეთ João Browser თქვენს სამაგრში, რომ მისი გახსნა ნებისმიერ დროს სწრაფად შეძლოთ</translation>
<translation id="9153902741226700840">გამოიყენეთ João Browser შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე ყოველი დაწკაპუნებისას.</translation>
<translation id="7216228761061470870">როცა სურათების ძიებას იყენებთ დესკტოპზე, გვერდის სათაური, URL და კონტენტი, PDF-ების ჩათვლით, იგზავნება სერვერზე</translation>
<translation id="7950844619283784703">დავალებათა მენეჯერი - João Browser</translation>
<translation id="133513825972536773"><ph name="EXISTING_USER" /> მზად არის ავტორიზაციისთვის. ცალკე დათვალიერების გასაგრძელებლად შედით João Browser-ში თქვენს პირად პროფილში ანგარიშით <ph name="USER_EMAIL_ADDRESS" />. თქვენს ყველა მოწყობილობაში მიიღებთ შენახულ ინფორმაციასა და სხვა მონაცემებს.</translation>
<translation id="4558982617284733740">მომენტალურად დაიწყეთ დათვალიერება: João Browser-ის გაშვება ახლა Windows-ის ჩართვისთანავე არის შესაძლებელი.</translation>
<translation id="7274695763216404502">ჩამაგრებულია! ისევ გამოიყენეთ სურათების ძიება ხელსაწყოთა ზოლიდან</translation>
<translation id="7288567540154601580">ჩანართები და გაფართოებები</translation>
<translation id="5494571279964989269">{NUM_EXTENSIONS,plural, =1{João Browser გირჩევთ, ამოშალოთ ის}other{João Browser გირჩევთ, ამოშალოთ ისინი}}</translation>
<translation id="2269053214123323740">სისტემის აუდიოს გასაზიარებლად გახსენით სისტემის პარამეტრები და დაუშვით „მხოლოდ სისტემის აუდიოს ჩაწერა“ João Browser-ისთვის. დაგჭირდებათ João Browser-ის გადატვირთვა.</translation>
<translation id="731795002583552498">მიმდინარეობს Chromium-ის განახლება</translation>
<translation id="9065168747010082551">თქვენი გამორჩეული ფაილი დაზიანებულია ან არასწორია.

João Browser ვერ შეძლებს თქვენი პარამეტრების აღდგენას.</translation>
<translation id="7324051657739063017">შეგიძლიათ ხელახლა გახსნათ „კონტექსტური ამოცანები“, რათა დასვათ კითხვები ინტერნეტში ძიების პარალელურად</translation>
<translation id="4159250197688136733">თქვენი ვები, სანიშნეები და João Browser-ის სხვა მასალა არის აქ.</translation>
<translation id="7347827960336370838">თქვენი დაშიფრული მონაცემების წაკითხვა შეუძლია მხოლოდ მას, ვინც თქვენი საიდუმლო ფრაზა იცის. საიდუმლო ფრაზა არ იგზავნება Google-ში და არ ინახება მის მიერ. თუ საიდუმლო ფრაზა დაგავიწყდათ ან ამ პარამეტრის შეცვლა გსურთ, <ph name="BEGIN_LINK" />თქვენს ანგარიშში Chromium მონაცემების<ph name="END_LINK" /> წაშლა მოგიწევთ.</translation>
<translation id="1062903713270840396">თქვენი სისტემის ადმინისტრატორმა მოახდინა João Browser-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME" />-ზე წვდომისთვის საჭიროა <ph name="ALTERNATIVE_BROWSER_NAME" />-ის გახსნა.</translation>
<translation id="7352651011704765696">რაღაც არასწორად წარიმართა</translation>
<translation id="5817362738974335084">მომავალში João Browser-ის განახლებების მისაღებად დაგჭირდებათ macOS 13 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს macOS 12-ს.</translation>
<translation id="7376384068949534168">ბოლო დროს არ ყოფილხართ. Chromium-მა ამოშალა <ph name="PERMISSION_1" /> და <ph name="PERMISSION_2" />.</translation>
<translation id="73786666777299047">Chrome Web Store-ის გახსნა</translation>
<translation id="5724625487458697703">Gemini-ს ჩვენება João Browser-ის სისტემურ არეში</translation>
<translation id="7401687852903179959">ამ ვიდეოში ძიება სურათების ძიებით</translation>
<translation id="1088684725931971005">João Browser ახლა თქვენი ნაგულისხმევი ბრაუზერია</translation>
<translation id="7479848806300971661">გააგრძელეთ იქიდან, სადაც გაჩერდით: João Browser აღადგენს თქვენს ჩანართებს ყოველი გადატვირთვის შემდეგ. ამის გამოსართავად გადადით</translation>
<translation id="1258077876605261365">João Browser-ში პაროლების იმპორტი</translation>
<translation id="5293062713751091377">1. დააწკაპუნეთ <ph name="BUTTON_LABEL" />-ზე ქვემოთ
2. დააწკაპუნეთ <ph name="BUTTON_2" />ზე Windows-ის პარამეტრებში
3. დააწკაპუნეთ <ph name="BUTTON_3" />-ზე Windows-ის შეტყობინებაში, რომ ჩაამაგროთ João Browser ამოცანათა ზოლში სწრაფი წვდომისთვის</translation>
<translation id="1941496545060769345"><ph name="PAGE_TITLE" /> — João Browser Dev</translation>
<translation id="7450541714075000668">ტექსტი დაკოპირდა</translation>
<translation id="7458892263350425044">თქვენი მიკროფონი რომ გამოიყენოთ, გახსენით <ph name="BEGIN_LINK" />სისტემის პარამეტრები<ph name="END_LINK" /> და მიანიჭეთ Chromium-ს წვდომა</translation>
<translation id="5422859338435319909">João Browser-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 7-ს.</translation>
<translation id="7467949745582939695">გსურთ Chromium-ის ხელახლა გაშვება?</translation>
<translation id="7707324976708178089">შეუძლებელია იმავე João Browser-ის ვერსიის დაყენება, რომელიც ამჟამად გაშვებულია. დახურეთ João Browser და ხელახლა სცადეთ.</translation>
<translation id="7510190804000607802">შეხსენება: Google-ის საუკეთესო შესაძლებლობები თქვენს ხელთ</translation>
<translation id="751935028865900641">საიტები, სავარაუდოდ, არ იმუშავებს მოლოდინისამებრ. Chromium-ის ყველა ფანჯრის დახურვისას სისტემიდან გამოხვალთ საიტების უმეტესობაზე, გამონაკლისია თქვენი Google ანგარიში, თუ მასში შესული ხართ Chromium-იდან.</translation>
<translation id="5325102834460669866">{0,plural, =1{João Browser ხელახლა გაეშვება 1 წუთში}other{João Browser ხელახლა გაეშვება # წუთში}}</translation>
<translation id="7565444033145385702">თქვენი მონაცემების დაცვის მიზნით, მიეცით საშუალება Chromium-ს გაუუქმოს ნებართვები საიტებს, რომლებზეც ბოლო დროს არ გადასულხართ.</translation>
<translation id="8099958128052689767">გაუშვით João Browser ავტომატურად, რომ მომენტალურად დაიწყოთ დათვალიერება.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ინსტალატორი</translation>
<translation id="7125257608567714221">João Browser იყენებს თქვენს კამერას და მიკროფონს.</translation>
<translation id="227045421902171569">João Browser გაუმჯობესდა</translation>
<translation id="5356567285381070312">ახლა თქვენთვის ხელმისაწვდომია მეტი ფუნქცია João Browser-ში</translation>
<translation id="7624307931717240213">ინფორმაციას ვიყენებთ ამ სერვისის გასაუმჯობესებლად. იხილეთ კონფიდენციალურობის დებულება და მომსახურების პირობები.</translation>
<translation id="7649070708921625228">დახმარება</translation>
<translation id="5714374331629713291">João Browser აპის ჩამოტვირთვა</translation>
<translation id="7658239707568436148">გაუქმება</translation>
<translation id="549378870470819535">João Browser არ არის თქვენი ნაგულისხმევი ბრაუზერი</translation>
<translation id="6574348346278803862">მოახდინეთ João Browser-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
<translation id="7699779824407626136">Chromium-ის განახლება</translation>
<translation id="3304080024230377341">თქვენი ნამუშევარი დაცულია João Browser-ში</translation>
<translation id="7716950018788545737">ამოცანა(ები) დასრულდა.</translation>
<translation id="77283119132245232">უზრუნველყოფს სისტემის კონტროლის სერვისს <ph name="BROWSER_NAME" />-ისთვის. თუ ეს სერვისი გათიშულია, ბრაუზერის მიერ შექმნილი ეფექტურობის ჩანაწერები არ მიიღებს მონაწილეობას სისტემის დონის მოვლენებში, როგორიცაა კონტექსტის გადართვა თუ მზა ნაკადების მოვლენები.</translation>
<translation id="7745317241717453663">ეს მოქმედება წაშლის თქვენს დათვალიერების მონაცემებს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Chromium-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">ინსტალერმა ვერ შექმნა დროებითი დირექტორია. გთხოვთ, გადაამოწმოთ დისკზე თავისუფალი სივრცე და პროგრამული უზრუნველყოფის დაყენების ნებართვა.</translation>
<translation id="4713120944298974980">João Browser-ში ძიება</translation>
<translation id="5804390944809171853">ნაგულისხმევ João Browser-ზე გადაყენება</translation>
<translation id="6930487390575519812">João Browser-ში თქვენი ნამუშევრის დაცვის უზრუნველსაყოფად თქვენი ორგანიზაცია შეძლებს გარკვეული ინფორმაციის ნახვას ან მართვას, როდესაც João Browser-ში ხართ შესული.</translation>
<translation id="5214761769821670245">დააყენეთ João Browser ნაგულისხმევ ბრაუზერად და ჩაამაგრეთ ის ამოცანათა ზოლში</translation>
<translation id="1294697217796985566">ააჩქარეთ João Browser-ის მუშაობა</translation>
<translation id="1278345486417353853"><ph name="PAGE_TITLE" /> — João Browser Canary</translation>
<translation id="7803986347287457849">გაურთულეთ თქვენ მიერ მონახულებული საიტების შესახებ ინფორმაციის ნახვა მათ, ვისაც წვდომა აქვს თქვენს ინტერნეტ-ტრაფიკზე. Chromium იყენებს უსაფრთო კავშირს საიტის IP მისამართის საპოვნელად DNS-ში (დომენური სახელების სისტემა).</translation>
<translation id="7810005234485217901">შეგიძლიათ, ჩაამაგროთ სურათების ძიება მასზე მარტივად წვდომისთვის</translation>
<translation id="489728561211958943">João Browser პროფილი ამ ანგარიშით უკვე არსებობს ამ მოწყობილობაზე</translation>
<translation id="7845233973568007926">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME" />-ის გამოყენებამდე თქვენი კომპიუტერი უნდა გადატვირთოთ.</translation>
<translation id="5294768452950207882">თქვენი საძიებო სისტემა შეიცვალა João Browser-ს მიღმა. თქვენი დაცვის მიზნით, João Browser-მა დააბრუნა ის თავდაპირველ ნაგულისხმევ პარამეტრებზე. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3244974069468656925">მოირგეთ João Browser, რათა მას ახალი იერი შესძინოთ</translation>
<translation id="7859018312476869945">მისამართთა ზოლში ან საძიებო ველში ტექსტის აკრეფისას უკეთესი შემოთავაზებების მისაღებად Chromium თქვენ მიერ აკრეფილ ტექსტს გაუგზავნის თქვენს ნაგულისხმევ საძიებო სისტემას. აღნიშნული ფუნქცია გამორთულია ინკოგნიტო რეჟიმში.</translation>
<translation id="6517519572778941051">João Browser ვერ განახლდა უახლეს ვერსიაზე, რომელსაც დამატებულ აქვს ახალი ფუნქციები და უსაფრთხოების სისტემის შესწორებები.</translation>
<translation id="7872446069773932638">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="SECONDS" /> წამი</translation>
<translation id="7873537467422636035">თუ საიდუმლო ფრაზა დაგავიწყდათ ან ამ პარამეტრის შეცვლა გსურთ, <ph name="BEGIN_LINK" />წაშალეთ თქვენს ანგარიშში Chromium მონაცემები<ph name="END_LINK" /></translation>
<translation id="1722038268139386345">სწრაფად გახსენით Gemini João Browser-ში, როდესაც ის დაგჭირდებათ</translation>
<translation id="8344320926817290924">João Browser-ის დაყენება ნაგულისხმევად</translation>
<translation id="7934340546140346950">Chromium ავტომატურად განაახლებს HTTPS-თან დაუცველ კავშირებს, როცა ეს შესაძლებელი იქნება</translation>
<translation id="3755057387338907970">თქვენ შესული ხართ João Browser-ში როგორც <ph name="USER_EMAIL_ADDRESS" />. გთხოვთ გამოიყენოთ იგივე ანგარიში ხელახლა შესვლისას.</translation>
<translation id="929903348843569380"><ph name="EXISTING_USER" /> მზად არის ავტორიზაციისთვის. ცალკე დათვალიერების გასაგრძელებლად შედით João Browser-ში თქვენს პირად პროფილში ანგარიშით <ph name="USER_EMAIL_ADDRESS" />. თქვენს ყველა მოწყობილობაში მიიღებთ სანიშნეებსა და სხვა მონაცემებს.</translation>
<translation id="7975919845073681630">ეს Chromium-ის მეორადი ინსტალაცია არის და ნაგულისხმევ ბრაუზერად ის ვერ დაყენდება.</translation>
<translation id="8905411496853397218">უცნობი წყაროებიდან მომავალ გაფართოებებს, აპებსა და თემებს შეუძლია თქვენი მოწყობილობის დაზიანება. João Browser გირჩევთ, ისინი მხოლოდ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-დან დააინსტალიროთ.</translation>
<translation id="6306672714476596428">მაქსიმალურად გამოიყენეთ Google თქვენს <ph name="DEVICE_TYPE" />-ზე João Browser აპის მეშვეობით</translation>
<translation id="8004582292198964060">ბრაუზერი</translation>
<translation id="8010081455002666927">ავტომატური ამოცნობა</translation>
<translation id="2172829664765531568">João Browser-ისთვის წვდომის მინიჭების შემდეგ ცალკეული ვებსაიტები შეძლებს თქვენგან წვდომის მოთხოვნას.</translation>
<translation id="74641100973032765">ჩაამაგრეთ João Browser ამოცანათა ზოლში, რომ ნებისმიერ დროს გამოიყენოთ ის</translation>
<translation id="80471789339884597">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME" />-ის გამოყენებამდე თქვენი ყველა ბრაუზერი უნდა გადატვირთოთ.</translation>
<translation id="8054112667659782652">სურათების ძიების მალსახმობის ყოველთვის ჩვენება</translation>
