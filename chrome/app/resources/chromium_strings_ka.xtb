<translation id="1547469039832541117">დაასრულებს მონიშნულ ამოცანას.</translation>
<translation id="449712764049695153">João Browser-ის ჩამაგრება</translation>
<translation id="1574377791422810894">Chromium-ის უსაფრთხოების ხელსაწყოები</translation>
<translation id="5480232403718129394">João Browser-ს სურს თქვენი პაროლების მმართველის მონაცემების წაშლა. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{განახლების მისასადაგებლად თქვენი ადმინისტრატორი მოითხოვს João Browser-ის ხელახლა გაშვებას}=1{განახლების მისასადაგებლად თქვენი ადმინისტრატორი მოითხოვს João Browser-ის ხელახლა გაშვებას. თქვენი ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}other{განახლების მისასადაგებლად თქვენი ადმინისტრატორი მოითხოვს João Browser-ის ხელახლა გაშვებას. თქვენი # ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}}</translation>
<translation id="980976428162070137">მიიღეთ Google-ის საუკეთესო ფუნქციები João Browser აპის მეშვეობით თქვენს ტელეფონში</translation>
<translation id="1625909126243026060">გადახედეთ კონფიდენციალურობისა და უსაფრთხოების მართვის საკვანძო საშუალებებს Chromium-ში</translation>
<translation id="1640672724030957280">მიმდინარეობს ჩამოტვირთვა…</translation>
<translation id="1665602916345474427">შესული ხართ, როგორც <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, წევრობა. ანგარიშის მენიუს გახსნა</translation>
<translation id="1708414395296835197">შეგიძლიათ გამოიყენოთ Chromium, როცა შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე აწკაპუნებთ. ის ასევე ჩამაგრდება თქვენს ამოცანათა ზოლში.</translation>
<translation id="1709772298389099340">უზრუნველყოფს მაღალ პრივილეგიებს <ph name="BROWSER_NAME" />-ისთვის.</translation>
<translation id="1722488837206509557">ამის საშუალებით თქვენ აირჩევთ ხელმისაწვდომი მოწყობილობებიდან და მათზე კონტენტს აჩვენებთ.</translation>
<translation id="6972087163510342335">João Browser მალე წაშლის დათვალიერების მონაცემებს</translation>
<translation id="1736443181683099871">Chromium შეეცდება, გადაიტანოს ნავიგაცია HTTPS-ზე</translation>
<translation id="3879288383593333401">João Browser-ის მონაცემები გასუფთავდა</translation>
<translation id="656496276885630888">João Browser გაეშვება <ph name="REMAINING_TIME" />-ში</translation>
<translation id="1749104137266986751">როცა HTTPS მიუწვდომელია, Chromium გამოიყენებს დაუცველ კავშირს თქვენი გაფრთხილების გარეშე</translation>
<translation id="1226290419185955779">დავრთოთ ნება João Browser-ს გაშვებული იყოს ფონურ რეჟიმში</translation>
<translation id="4231366995273072370">João Browser-ის უსაფრთხოების გაზრდის მიზნით, ჩვენ გავთიშეთ რამდენიმე გაფართოება, რომელიც არ არის ჩამოთვლილი <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ში და, შესაძლოა, დამატებულია თქვენი თანხმობის გარეშე.</translation>
<translation id="1822049153969905781">აირჩიეთ <ph name="BEGIN_BOLD" />დიახ<ph name="END_BOLD" /> Windows-ის შეტყობინებაში, რომ ჩაამაგროთ João Browser ამოცანათა ზოლში სწრაფი წვდომისთვის.</translation>
<translation id="1321831992638405531">João Browser-ის ხელახალი ინსტალაცია</translation>
<translation id="3386967202064865436">João Browser ცდილობს შემდეგს: <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="70054449700528483">შემდეგ ჯერზე, როცა გახსნით João Browser-ს თქვენს <ph name="DEVICE_TYPE" />-ში, დაინახავთ მოთხოვნას Google პაროლების მმართველის გამოყენების შესახებ.</translation>
<translation id="1838374766361614909">ძიების გასუფთავება</translation>
<translation id="5807096362853316123">დათვალიერების მონაცემების მხოლოდ ამ მოწყობილობიდან წასაშლელად და Google ანგარიშში მათ შესანარჩუნებლად <ph name="BEGIN_LINK" />გამოდით João Browser-იდან<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">ჩამოტვირთეთ João Browser თქვენს ტელეფონში, რომ გახსნათ ან შექმნათ ჩანართების ახალი ჯგუფები გზიდან.</translation>
<translation id="185970820835152459">შეგიძლიათ მართოთ თქვენი სისტემაში შესული Google ანგარიშები. თქვენი Google ანგარიშები გამოიყენება Chromium ბრაუზერისთვის, Play Store-ისთვის, Gmail-ისთვის და სხვა პროდუქტებისთვის. თუ სხვისი, მაგალითად, ოჯახის წევრის, ანგარიშის დამატება გსურთ, სანაცვლოდ დაამატეთ ახალი პიროვნება თქვენს <ph name="DEVICE_TYPE" />-ს. <ph name="LINK_BEGIN" />შეიტყვეთ მეტი<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">სურათების ძიებით მოძიება</translation>
<translation id="65457771685016683"><ph name="EXISTING_USER" /> მზად არის ავტორიზაციისთვის. ცალკე დათვალიერების გასაგრძელებლად შედით João Browser-ში თქვენს პირად პროფილში ანგარიშით <ph name="USER_EMAIL_ADDRESS" />. თქვენს სანიშნეებსა და სხვა მონაცემებს ასევე მიიღებთ <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">ტექსტის არჩევა</translation>
<translation id="2634119629547215883">თქვენ შედიხართ სისტემაში მართული ანგარიშით და ამით აძლევთ ადმინისტრატორს კონტროლს თქვენს João Browser-ის პროფილზე. თქვენი João Browser-ის მონაცემები, როგორიცაა პროგრამები, სანიშნეები, ისტორია, პაროლები და სხვა პარამეტრები სამუდამოდ მიემაგრება <ph name="USER_NAME" />-ს. თქვენ შეძლებთ ამ მონაცემების წაშლას Google ანგარიშების საინფორმაციო დაფის მეშვეობით, თუმცა ამ მონაცემების დაკავშირებას სხვა ანგარიშთან ვერ შეძლებთ. სურვილისამებრ, შეგიძლიათ შექმნათ ახალი პროფილი, არსებული João Browser-ის მონაცემების ცალკე შესანახად. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium დაზოგავს ბატარეის მუხტს ვიზუალური ეფექტებისა (მაგალითად, ლივლივა გადაადგილებისა და ვიდეოკადრების სიხშირის) და ფონური აქტივობის შეზღუდვის გზით. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი ენერგიის დამზოგის შესახებ<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">João Browser-ის განმაახლებელი სერვისი</translation>
<translation id="1911763535808217981">ამ პარამეტრის გამორთვის შემთხვევაში, Google-ის საიტებში (მაგალითად, Gmail-ში) შესვლას შეძლებთ Chromium-ში შესვლის გარეშე</translation>
<translation id="4037729269678342163">João Browser არ პასუხობს. გავუშვათ ხელახლა?</translation>
<translation id="7563750688920581112">თქვენი ორგანიზაცია, <ph name="MANAGER" />, მოითხოვს, რომ João Browser-ში შეხვიდეთ</translation>
<translation id="193439633299369377">განახლების მისასადაგებლად ChromiumOS უნდა გადაიტვირთოს.</translation>
<translation id="7099143775283792684">João Browser-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ტიპის ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="1953553007165777902">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="MINUTE" /> წუთი</translation>
<translation id="1966382378801805537">Chromium ნაგულისხმევ ბრაუზერს ვერ საზღვრავს, ან ვერ აყენებს</translation>
<translation id="197326043290947695">დაათვალიერეთ უფრო ჭკვიანურად სურათების ძიების მეშვეობით</translation>
<translation id="6185556991023272801">შეიტყვეთ, რატომ ბლოკავს João Browser ზოგიერთ ფაილს, გაიხსნება ახალ ჩანართში</translation>
<translation id="4053636705816895911">იზრუნებს, რომ თქვენი João Browser-ის პროგრამული უზრუნველყოფა განახლებული იყოს. თუ ეს სერვისი გაითიშება ან შეჩერდება, João Browser-ის პროგრამული უზრუნველყოფა აღარ განახლდება, რაც იმას ნიშნავს, რომ უსაფრთხოებასთან დაკავშირებული პოტენციური საფრთხეების აღმოფხვრა აღარ მოხდება და ფუნქციებმა შეიძლება არ იმუშაოს. ეს სერვისი დეინსტალირდება, როცა მისით მოსარგებლე João Browser-ის პროგრამული უზრუნველყოფა არ არსებობს.</translation>
<translation id="2008474315282236005">ეს მოქმედება წაშლის 1 ერთეულს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Chromium-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">ინსტალაცია ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="2039417478970545937">პარამეტრები.</translation>
<translation id="2049376729098081731">აირჩიეთ, დაერთოს თუ არა Chromium ისტორია, Google სერვისებში უფრო პერსონალიზებული ფუნქციებით რომ ისარგებლოთ</translation>
<translation id="6768767091114123654">ჩაშენებულია João Browser-ში, რათა დაგეხმაროთ ძლიერი პაროლების შექმნაში, შენახვასა და ავტომატურად შევსებაში. დაამატეთ მალსახმობი მარტივი წვდომისთვის.</translation>
<translation id="3571664229232252557">დააწკაპუნეთ ღილაკზე „João Browser-ის მორგება“ ახალი ჩანართის გვერდზე, რათა João Browser-ს ახალი იერი შესძინოთ</translation>
<translation id="4273287215573278663">João Browser-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ეს ფაილი შეცდომაში შემყვანია და მას შეუძლია მოულოდნელი ცვლილებების განხორციელება თქვენს მოწყობილობაზე</translation>
<translation id="9063967192437499581">João Browser iOS-ის მომდევნო ჯერზე გახსნისას ნახავთ მოთხოვნას <ph name="FEATURE_NAME" />-ის ცდის შესახებ.</translation>
<translation id="8511569826706775962">თქვენი პაროლები და João Browser-ის სხვა მონაცემები, რომლებიც შენახულია თქვენს Google ანგარიშში, ამოიშლება ამ მოწყობილობიდან. João Browser-ში რომ ისინი ხელახლა გამოიყენოთ, საჭიროა ანგარიშში შესვლა.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{თქვენი ორგანიზაცია ავტომატურად შლის დათვალიერების მონაცემებს, როცა João Browser არ გამოიყენება 1 წუთის განმავლობაში. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს. თქვენი ჩანართები გახსნილი დარჩება.}other{თქვენი ორგანიზაცია ავტომატურად შლის დათვალიერების მონაცემებს, როცა João Browser არ გამოიყენება # წუთის განმავლობაში. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს. თქვენი ჩანართები გახსნილი დარჩება.}}</translation>
<translation id="2125838419757773031">ძიებისთვის აირჩიეთ ეკრანის არეალი</translation>
<translation id="2126108037660393668">ჩამოტვირთული ფაილის დადასტურება ვერ მოხერხდა.</translation>
<translation id="2135919691573380097">ამ საიტის შესახებ მოხსენება</translation>
<translation id="2137162749895930932">თარგმნის ეკრანის დახურვა</translation>
<translation id="1308845716497059117">João Browser-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ეს საიტი არ იყენებს დაცულ კავშირს, ამიტომ ფაილი, შესაძლოა, მოდიფიცირებული იყოს</translation>
<translation id="2170098639895543546">აირჩიეთ გვერდზე არსებული ნებისმიერი რამ</translation>
<translation id="6705844023496387932">João Browser-ის მორგება</translation>
<translation id="2174917724755363426">ინსტალაცია არ დასრულებულა. ნამდვილად გსურთ გაუქმება?</translation>
<translation id="7728290795259244895">João Browser — ქსელში შესვლა — <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">შეცდომა განახლების შემოწმებისასr: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">ანგარიშის ამოშლა João Browser-იდან</translation>
<translation id="4648870374540039667">გამოიყენეთ João Browser აპი, რომ შოპინგის საუკეთესო ხელსაწყოები თან იქონიოთ</translation>
<translation id="2106116820042118250">დაიცავით უსაფრთხოება მგზავრობისას გაძლიერებული Safe Browsing-ის მეშვეობით João Browser-ზე iOS-ისთვის</translation>
<translation id="2210682093923538346">სახიფათო საიტი Chromium-მა ამოშალა შეტყობინებები.</translation>
<translation id="2236949375853147973">ჩემი აქტივობა</translation>
<translation id="118764235932893741">შედით João Browser-ში, რომ მიიღოთ მისამართები და სხვა მონაცემები თქვენს ყველა მოწყობილობაზე. შესვლის შემდეგ ეს მისამართი შეინახება თქვენს Google ანგარიშში.</translation>
<translation id="7254578863532089400">თუ თქვენ გაზიარებული გაქვთ კომპიუტერი, თქვენი მეგობრები და ოჯახის წევრები შეძლებენ დამოუკიდებლად დათვალიერებას და João Browser-ის დაყენებას სურვილისამებრ.</translation>
<translation id="22571759390241347">უნარები Chromium-ში</translation>
<translation id="2283803047247799269">ამ ჩანართში ძიება სურათების ძიების მეშვეობით</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{João Browser გირჩევთ, დააპაუზოთ ჩანართი, რომელიც ანელებს თქვენი ბრაუზერის მუშაობას}other{João Browser გირჩევთ, დააპაუზოთ ჩანართები, რომლებიც ანელებს თქვენი ბრაუზერის მუშაობას}}</translation>
<translation id="2307973900865360088">სამაგრში დატოვება</translation>
<translation id="2313870531055795960">შეამოწმებს URL-ების თანხვედრას Chromium-ში შენახულ არაუსაფრთხო საიტების სიასთან. საიტის მიერ პაროლის მოპარვის მცდელობის ან თქვენ მიერ საზიანო ფაილის ჩამოტვირთვის შემთხვევაში Chromium-ის მიერ Safe Browsing-ს გაეგზავნება URL-ები და შესაბამისი გვერდის კონტენტის გარკვეული ნაწილი.</translation>
<translation id="2356070529366658676">მკითხე</translation>
<translation id="2359808026110333948">გაგრძელება</translation>
<translation id="3800730051093461113">„<ph name="EXTENSION_NAME" />“ გაფართოების გამოსაყენებლად შედით João Browser-ში</translation>
<translation id="8758735062658446604">João Browser-ის აპების ფონურ რეჟიმში მუშაობის გათიშვა</translation>
<translation id="2623595027619107207">ეს გაფართოება რომ გამოიყენოთ <ph name="USER_EMAIL_ADDRESS" /> ანგარიშით, შედით João Browser-ში.</translation>
<translation id="2384373936468275798">ChromiumOS-მა ვერ დაასინქრონა თქვენი მონაცემები, რადგან თქვენი ანგარიშის შესვლის დეტალები მოძველდა.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{1 HID მოწყობილობაზე წვდომა ხორციელდებოდა ერთი ან რამდენიმე João Browser გაფართოების მიერ}=1{1 HID მოწყობილობაზე წვდომა ხორციელდება ერთი ან რამდენიმე João Browser გაფართოების მიერ}other{# HID მოწყობილობაზე წვდომა ხორციელდება ერთი ან რამდენიმე João Browser გაფართოების მიერ}}</translation>
<translation id="6254788431480237503">João Browser საჭიროებს კამერისა და მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="2403703063067034158">გაშვების შეცდომა: გაშვების სხვა პროცესი მიმდინარეობს, მოგვიანებით ცადეთ.</translation>
<translation id="3028975423343897358">გახსენით ბმულები João Browser-ში ნებისმიერი აპიდან და გახადეთ ის ხელმისაწვდომი ამოცანათა ზოლიდან</translation>
<translation id="579079006139156831">დააწკაპუნეთ შეჯამების ღილაკზე, რომ გაუზიაროთ ეს დოკუმენტი Gemini-ს João Browser-ში და მიიღოთ სწრაფი მიმოხილვა და დასვათ შემდგომი შეკითხვები</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Chromium-ში არსებული ხელსაწყოები<ph name="END_LINK" /> დაგეხმარებათ, უსაფრთხოდ დაათვალიეროთ ვები და შეინარჩუნოთ კონტროლი</translation>
<translation id="7114471809991869757"><ph name="EXISTING_USER" /> მზად არის ავტორიზაციისთვის. ცალკე დათვალიერების გასაგრძელებლად შედით João Browser-ში თქვენს პირად პროფილში ანგარიშით <ph name="USER_EMAIL_ADDRESS" />. თქვენს ყველა მოწყობილობაში მიიღებთ პაროლებსა და სხვა მონაცემებს.</translation>
<translation id="2451727308784734061">ისარგებლეთ მალსახმობით, პაროლების მმართველზე სწრაფად რომ გადახვიდეთ. მალსახმობის გადატანა შეგიძლიათ თქვენი კომპიუტერის მთავარ ეკრანზე ან აპების გამშვებში.</translation>
