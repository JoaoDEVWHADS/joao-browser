<translation id="4697739132113629685">ბმულის გახსნა João Browser-ის ინკო&amp;გნიტო ფანჯარაში</translation>
<translation id="1629247860984475766">მოირგეთ თქვენი ახალი João Browser პროფილი</translation>
<translation id="1905008150929775692">შეგიძლიათ, განაგრძოთ ჩეთი ხელოვნური ინტელექტის რეჟიმში ჩანართების გადართვის გარეშე. დასაწყებად შედით João Browser-ში. თქვენს ყველა მოწყობილობაში მიიღებთ პაროლებსა და სხვა მონაცემებს.</translation>
<translation id="4232381420311815141">João Browser-იდან Google ანგარიში რომ ამოშალოთ, საჭიროა, სისტემიდან გახვიდეთ João Browser-ის პარამეტრების გვერდზე</translation>
<translation id="3234316605225071811">მოგვიანებით Chromium გკითხავთ, გსურთ თუ არა შენახული ინფორმაციის გამოყენება ფორმების ავტომატურად შესავსებად</translation>
<translation id="6676749542734993844">João Browser ვერ ახერხებს თავის მონაცემთა დირექტორიაში წაკითხვას და ჩაწერის განხორციელებას:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">თან იქონიეთ Google-ის ხელოვნური ინტელექტის რჩეული ხელსაწყოები João Browser-ის მეშვეობით iOS-ზე.</translation>
<translation id="3286538390144397061">გადატვირთეთ ახლა</translation>
<translation id="532528773927600103">Google API გასაღები გამოტოვებულია. João Browser-ის ზოგიერთი ფუნქცია გამორთული იქნება.</translation>
<translation id="3296368748942286671">ფონური პროგრამების გაშვების გაგრძელება, როდესაც Chromium იხურება</translation>
<translation id="3313189106987092621">Chromium გაგაფრთხილებთ ნებისმიერი საიტის დაუცველი კავშირის გამოყენებით ჩატვირთვამდე</translation>
<translation id="8095477191923518137">João Browser-ის ყველა ფანჯრის დახურვისას სისტემიდან გამოხვალთ საიტების უმეტესობაზე, გამონაკლისია თქვენი Google ანგარიში, თუ მასში შესული ხართ João Browser-იდან. ვებსაიტებმა რომ დაგიმახსოვროთ, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">ძიების არეალის ზედა მარჯვენა კუთხე: მარჯვნივ <ph name="RIGHT" />%, ზემოთ <ph name="TOP" />%</translation>
<translation id="3366305173356742781">Chromium-ის მონაცემები თქვენს ანგარიშში</translation>
<translation id="3234882977104294240">გამოიყენეთ თქვენი პაროლები João Browser-ით თქვენს ტელეფონში</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="2974199599420431595">გსურთ არსებულ João Browser პროფილზე გადართვა?</translation>
<translation id="3412460710772753638">პაროლების მმართველში ამ მოწყობილობაზე</translation>
<translation id="3438772217992559640">ამ ჩანართში ძიება სურათების ძიებით</translation>
<translation id="8318147705317768982">გაახანგრძლივეთ გაძლიერებული Safe Browsing João Browser-ით თქვენს ტელეფონში</translation>
<translation id="347392028839310978">João Browser-ის პერსონალიზება...</translation>
<translation id="3474745554856756813">ეს მოქმედება წაშლის <ph name="ITEMS_COUNT" /> ერთეულს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Chromium-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="5805833167703404998"><ph name="SHORTCUT" /> გადართავს João Browser პროფილებს</translation>
<translation id="1835124883585653877">დახურეთ João Browser-ის ყველა ფანჯარა და ხელახლა სცადეთ.</translation>
<translation id="7106246566966568195">თქვენი ფანჯრის გასაზიარებლად დაუშვით ეკრანის ჩაწერა João Browser-ისთვის სისტემის პარამეტრებში</translation>
<translation id="6017005873246021363"><ph name="EXISTING_USER" /> მზად არის შესასვლელად.  ცალკე დათვალიერების გასაგრძელებლად შედით João Browser-ში თქვენს პირად პროფილში <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="1146681170626381319">QR კოდი João Browser ბრაუზერის მობილურ მოწყობილობებზე ჩამოსატვირთად</translation>
<translation id="354621070532799440">შეხსენება: Google-ის უსაფრთხოების საუკეთესო ფუნქციები თქვენს ხელთ</translation>
<translation id="2488701737291439763">თქვენი ეკრანის გასაზიარებლად დაუშვით ეკრანის ჩაწერა João Browser-ისთვის სისტემის პარამეტრებში.</translation>
<translation id="3588112919289558122">გაძლიერებული დაცვა თიშავს JavaScript-ის ოპტიმიზაციას იმ საიტებისთვის, რომლებსაც Chromium ვერ ამოიცნობს</translation>
<translation id="3597003331831379823">მაღალი პრივილეგიებით დაყენების გაშვება ვერ მოხერხდა. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">João Browser-ში შესვლა</translation>
<translation id="5985252758124395804">ამ პიროვნების დათვალიერების მონაცემები წაიშლება ამ მოწყობილობიდან. მონაცემების აღსადგენად შედით João Browser-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{ხელმისაწვდომია João Browser-ის განახლება, რომელიც მას მიესადაგება ხელახლა გაშვებისთანავე.}=1{ხელმისაწვდომია João Browser-ის განახლება, რომელიც მას მიესადაგება ხელახლა გაშვებისთანავე. თქვენი ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}other{ხელმისაწვდომია João Browser-ის განახლება, რომელიც მას მიესადაგება ხელახლა გაშვებისთანავე. თქვენი # ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}}</translation>
<translation id="3667616615096815454">ინსტალაცია ვერ მოხერხდა, რადგან აპლიკაცია სერვერისთვის ცნობილი არ არის.</translation>
<translation id="3675854891107786059">გამოიყენეთ თქვენი <ph name="BEGIN_LINK" />საკუთარი საიდუმლო ფრაზა<ph name="END_LINK" /> თქვენს Google ანგარიშში შენახული Chromium-ის ყველა მონაცემის დაშიფვრისთვის. Google Pay-ში არსებული გადახდის მეთოდები და მისამართები არ დაიშიფრება. Chromium-ში არსებული დათვალიერების ისტორია არ სინქრონიზდება.</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ João Browser-ის ხელახლა გაშვებას}=1{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ João Browser-ის ხელახლა გაშვებას. თქვენი ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}other{ამ განახლების მისასადაგებლად ადმინისტრატორი გთხოვთ João Browser-ის ხელახლა გაშვებას. თქვენი # ინკოგნიტო ფანჯარა ხელახლა არ გაიხსნება.}}</translation>
<translation id="4134769722455445399">ბმულის გახსნა João Browser-ის ახალ ჩა&amp;ნართში</translation>
<translation id="3728124580182886854">მიაბით ერთმანეთს Chromium და სხვა Google სერვისები პერსონალიზებისა და სხვა მიზნით</translation>
<translation id="3729187154190517324">გააღრმავეთ თქვენი ძიება რამდენიმე ჩანართის, ფაილისა და ხელსაწყოს დამატებით ღილაკის „ჩანართისა და სხვათა დამატება“ გამოყენებით.</translation>
<translation id="655691042235349825">João Browser-ის პროფილების მართვა</translation>
<translation id="8494798931804571569">შეიტყვეთ, რატომ ბლოკავს João Browser ზოგიერთ ჩამოტვირთვას</translation>
<translation id="379589255253486813">Chromium გაცნობებთ, თუ რაიმეს შემოწმება დაგჭირდებათ</translation>
<translation id="3802055581630249637">Chromium წინასწარ ჩატვირთავს გვერდებს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="3810973564298564668">მართვა</translation>
<translation id="6945066279282141856">შენახული პაროლების გამოსაყენებლად მიჰყევით QR კოდს, ჩამოტვირთეთ João Browser iOS-ისთვის და შედით თქვენს Google ანგარიშში</translation>
<translation id="3846683726093018685">**შეჯამება:** მაქსიმუმ 30-სიტყვიანი წინადადებით აღწერეთ ეკრანის ანაბეჭდში მოცემული კონტენტის ძირითადი თემა და დანიშნულება.

          **შეკითხვების შემოთავაზება:** შექმენით ბურთულებიანი სია 3-5 დამაფიქრებელი შეკითხვისგან, რომლებიც შეიძლება მომხმარებელმა დასვას ეკრანის ანაბეჭდის უკეთ გასაგებად. ამ შეკითხვებიდან ერთ-ერთი აუცილებლად უნდა ეხებოდეს კონკრეტულად ვიზუალურ ობიექტს, მის დიზაინსა თუ განთავსებას.</translation>
<translation id="4996569675441627032"><ph name="PAGE_TITLE" /> - João Browser</translation>
<translation id="6008740052107737825">João Browser საჭიროებს ადგილობრივ ქსელზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="3885770153807205175">ენის ამომრჩევი</translation>
<translation id="2390004682597453662">მოირგეთ და გააკონტროლეთ João Browser. საჭიროა თქვენი ყურადღება — დააწკაპუნეთ დეტალური ინფორმაციისთვის.</translation>
<translation id="8262407643678629134">João Browser ის გახსნისა და დათვალიერების დაწყებისათვის დააჭირეთ თქვენი სახელს.</translation>
<translation id="3892148308691398805">ტექსტის კოპირება</translation>
<translation id="2168201717554927204"><ph name="EXISTING_USER" /> უკვე შესულია ამ João Browser პროფილში. თქვენი დათვალიერების მონაცემები რომ განაცალკევოთ, João Browser-ს შეუძლია თქვენთვის პერსონალური პროფილის შექმნა.</translation>
<translation id="1046732460303790107">ეს გაფართოება არღვევს Chrome Web Store-ის წესებს და ის, შესაძლოა, არ იყოს უსაფრთხო. წაშალეთ ის João Browser-იდან, რომ მას აღარ შეეძლოს თქვენი მონაცემების (მათ შორის, პერსონალური ინფორმაციის) ნახვა და შეცვლა თქვენ მიერ მონახულებულ საიტებზე.</translation>
<translation id="3941890832296813527">შეცდომა ინსტალაციისას: ინსტალატორის ფაილის სახელი არასწორი ან მხარდაუჭერელია.</translation>
<translation id="3879366121647289622">João Browser ცდილობს პაროლების კოპირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="7332365758981378072">ამ მოწყობილობიდან ამოიშლება თქვენი პაროლები, გადახდის მეთოდები და მისამართები, რომლებიც შეინახეთ თქვენს Google ანგარიშში. João Browser-ში რომ ისინი ხელახლა გამოიყენოთ, საჭიროა ანგარიშში შესვლა.</translation>
<translation id="395904275706073188">დაცული გვერდების წაკითხვა შეუძლებელია. ცადეთ სხვა გვერდი.</translation>
<translation id="3962647064319009959">შეიტყვეთ, როგორ ზრუნავს Chromium თქვენს უსაფრთხოებაზე</translation>
<translation id="3967822245660637423">ჩამოტვირთვა დასრულდა</translation>
<translation id="3971865010372729242">როდესაც მისამართთა ზოლში ან საძიებო ველში ტექსტი შეგყავთ, Chromium აგზავნის მას თქვენი ორგანიზაციის საძიებო სისტემაში, ხელოვნურ ინტელექტთან და აგენტის ხელსაწყოებში, რათა მიიღოს შემოთავაზებები.</translation>
<translation id="3975724895399328945">Google Chrome for Testing-ის შ&amp;ესახებ</translation>
<translation id="3997429360543082038">ChromiumOS-ის შესახებ</translation>
<translation id="4010059961270896984">თქვენ მიერ საიტის მონახულებისას Chromium გაუგზავნის URL-ის შენიღბულ ნაწილს <ph name="BEGIN_LINK" />Google Safe Browsing<ph name="END_LINK" />-ს კონფიდენციალურობის სერვერის მეშვეობით, რომელიც მალავს თქვენს IP მისამართს. თუ საიტი რაიმე საეჭვოს მოიმოქმედებს, გაიგზავნება სრული URL-ები და გვერდების კონტენტის ფრაგმენტებიც.</translation>
<translation id="4016217212818346953">იყავით უსაფრთხოდ პაროლების მმართველთან ერთად</translation>
<translation id="4019629340646866719">ChromiumOS და <ph name="BEGIN_LINK_LINUX_OSS" />Linux-ის შემუშავების გარემო <ph name="END_LINK_LINUX_OSS" /> მუშაობს <ph name="BEGIN_LINK_CROS_OSS" />ღია კოდის დამატებითი პროგრამული უზრუნველყოფის<ph name="END_LINK_CROS_OSS" /> დამსახურებით.</translation>
<translation id="4022972681110646219">ეკრანის თარგმნა</translation>
<translation id="4023601594785368013">ორიგინალის ენა: <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">გახსნის ბმულებს João Browser-ში ნებისმიერი აპიდან. დამატებით, მარტივი წვდომისთვის ის ჩამაგრდება თქვენს ამოცანათა ზოლში.</translation>
<translation id="4036079820698952681">ხელი შეუწყვეთ Chromium-ის გაუმჯობესებას <ph name="BEGIN_LINK" />მიმდინარე პარამეტრების<ph name="END_LINK" /> გამოგზავნის მეშვეობით</translation>
<translation id="4050175100176540509">უსაფრთხოების მნიშვნელოვანი გაუმჯობესება და ახალი თვისებები ხელმისაწვდომია უახლეს ვერსიაში.</translation>
<translation id="4055805654398742145">პ&amp;აროლების მმართველი</translation>
<translation id="615818333141511791">{COUNT,plural, =1{თქვენი ორგანიზაცია ავტომატურად ხურავს João Browser-ს, როცა ის 1 წუთის განმავლობაში არ გამოიყენება. დათვალიერების მონაცემები წაიშლება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.}other{თქვენი ორგანიზაცია ავტომატურად ხურავს João Browser-ს, როცა ის # წუთის განმავლობაში არ გამოიყენება. დათვალიერების მონაცემები წაიშლება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.}}</translation>
<translation id="4118474109249235144">Chromium-ის ინკოგნიტო რეჟიმი</translation>
<translation id="4122186850977583290">Chromium-ის შესახებ ინფორმაციის გვერდზე გადასვლა</translation>
<translation id="9207280419664362385">მოირგეთ Chrome — შესძინეთ მას ახალი იერი</translation>
<translation id="3719803995198923598">თქვენი João Browser-ის მორგება</translation>
<translation id="4148957013307229264">ინსტალაცია…</translation>
<translation id="2954462321765112214"><ph name="PAGE_TITLE" /> — ქსელში შესვლა — João Browser</translation>
<translation id="7812363663832111420">აღმოაჩინეთ შესანიშნავი აპები, თამაშები, გაფართოებები და თემები João Browser-ისთვის.</translation>
<translation id="69200600645763018">ამ გაფართოების და სხვა ერთეულების თქვენს კომპიუტერზე მისაღებად შედით João Browser-ში</translation>
<translation id="7505863944027312744">ონლაინ უსაფრთხოების დასაცავად, თქვენი მშობლის არჩევანით, გადართეთ João Browser პროფილზე, რომელშიც უკვე შესული ხართ, როგორც <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">მიმდინარეობს გაუქმება…</translation>
<translation id="4224210481850767180">ინსტალაცია გაუქმდა.</translation>
<translation id="8090594705972340646">დავუკავშიროთ თქვენი João Browser მონაცემები ამ ანგარიშის?</translation>
<translation id="4251772536351901305">გაგაფრთხილებთ სახიფათო საიტების შესახებ (თუნდაც Google-ისთვის იქამდე უცნობის შესახებ) საიტებიდან იმაზე მეტი მონაცემის სკანირების მეშვეობით, ვიდრე სტანდარტული დაცვის შემთხვევაში. სურვილისამებრ, შეგიძლიათ გამოტოვოთ Chromium-ის გაფრთხილებები.</translation>
<translation id="5696119579094527589">João Browser-იდან გასვლა</translation>
<translation id="4271805377592243930">Chromium-თან დაკავშირებული დახმარების მიღება</translation>
<translation id="4281844954008187215">მომსახურების პირობები</translation>
<translation id="1245307320228150348">ინსტალაცია ვერ განხორციელდა განუსაზღვრელი შეცდომის გამო. თუ João Browser ამჟამად გაშვებულია, დახურეთ იგი და ხელახლა სცადეთ.</translation>
<translation id="7405356088321579627">João Browser-იდან პაროლების ექსპორტი</translation>
<translation id="4304713468139749426">პაროლების მმართველი</translation>
<translation id="4334241893986177674">ეკრანის ამ ანაბეჭდის მოძიება</translation>
<translation id="5785541112027363087">მოიძიეთ ინფორმაცია და დასვით კითხვები ნებისმიერი ადგილიდან, მაშინაც კი, როცა João Browser ჩაკეცილია</translation>
<translation id="212570256141568951">João Browser-ის გაშვება Windows-ის ჩართვისას</translation>
<translation id="4400772909124543403">განახლებები ხელმისაწვდომი არ არის.</translation>
<translation id="7463042547966071103">მაინც გსურთ João Browser-იდან გასვლა?</translation>
<translation id="4413205837991854510">სურათების ძიების მალსახმობის ყოველთვის ჩვენება</translation>
<translation id="4736206301215400753">João Browser-ისთვის ფონურ რეჟიმში მუშაობის დაშვება</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{João Browser გირჩევთ მის ამოშლას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი მხარდაჭერილი გაფართოებების შესახებ<ph name="END_LINK" />}other{João Browser გირჩევთ მათ ამოშლას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი მხარდაჭერილი გაფართოებების შესახებ<ph name="END_LINK" />}}</translation>
<translation id="5305058100936019600">João Browser-ის მორგება და კონტროლი</translation>
<translation id="4427306783828095590">გაძლიერებული დაცვა გთავაზობთ ფიშინგისა და მავნე პროგრამებისგან დაცვის მეტ საშუალებას</translation>
<translation id="4434353761996769206">ინსტალატორის შეცდომა: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3461955321878243607"><ph name="MANAGER" /> მართავს João Browser-ს</translation>
<translation id="3379477508903866078">João Browser პროფილის დამატება</translation>
<translation id="4447409407328223819">Chrome for Testing-ის შესახებ</translation>
<translation id="4074057296993529937">თქვენს Google ანგარიშში João Browser-ის მონაცემები რომ გამოიყენოთ და შეინახოთ, შეიყვანეთ თქვენი საიდუმლო ფრაზა</translation>
<translation id="4493028449971051158">გაშვების შეცდომა: ინსტალატორი გაუშვით, როგორც ადმინისტრატორმა.</translation>
<translation id="4501471624619070934">ინსტალაცია ვერ მოხერხდა, რადგან წვდომა შეზღუდულია ამ ქვეყანაში</translation>
<translation id="8624811527667906941">ამ გაფართოებას არ გამოუქვეყნებია კონფიდენციალური ინფორმაციის გამოყენების პრაქტიკა, მაგალითად, მონაცემების შეგროვებისა და გამოყენების წესები. João Browser გირჩევთ მის ამოშლას.</translation>
<translation id="5571435860030744559">მოგესალმებით João Browser-ში; გახსნილია ბრაუზერის ახალი ფანჯარა</translation>
<translation id="8132016625974854930">თქვენი გარემოს მოსანიშნად და თქვენი ხელებისთვის თვალის მიდევნებისთვის João Browser საჭრიროებს ნებართვას</translation>
<translation id="6599071882590417739">თქვენ უკვე შესული ხართ João Browser-ის სხვა პროფილში როგორც <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4548534452171747496">Chromium წინასწარ ჩატვირთავს გვერდებს, რაც დააჩქარებს დათვალიერებას და ძიებას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი წინასწარ ჩატვირთული გვერდების შესახებ<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">გააძლიერეთ ონლაინ უსაფრთხოება ყველასთვის, როცა მოხსენებას გაგზავნით საიტის შესახებ, რომელიც, თქვენი აზრით, საზიანოა.</translation>
<translation id="202208802191333704">João Browser-მა დაბლოკა ეს ჩამოტვირთვა, რადგან Safe Browsing გამორთეთ და ფაილის შემოწმება ვერ ხერხდება</translation>
<translation id="3128308674776200516">ცადეთ Google Lens João Browser-ით თქვენს ტელეფონში</translation>
<translation id="4594305310729380060">პაროლების მმართველში ამ მოწყობილობაზე</translation>
<translation id="7653380076752216509">João Browser პროგრამები</translation>
<translation id="4598116752460667024">სიიდან ნებისმიერი პროცესის მოძიება.</translation>
<translation id="4613863813562375431">ChromiumOS-ის ვერსია</translation>
<translation id="4621240073146040695">განახლება თითქმის მზად არის! დასასრულებლად, ხელახლა გაუშვით Chromium.</translation>
<translation id="1497446027991908251">აჩქარებს João Browser-ის V8 მექანიზმის მქონე საიტების მუშაობას, მაგრამ João Browser ოდნავ ნაკლებად უძლებს შეტევებს</translation>
<translation id="7523749920868634278">გაფრთხილება: João Browser ვერ შეუშლის ხელს გაფართოებებს დათვალიერების ისტორიის შენახვაში. ინკოგნიტო რეჟიმში ამ გაფართოების გასათიშად მოხსენით მონიშვნა ამ ვარიანტზე.</translation>
<translation id="4673151026126227699">თუ Chromium-ის მოხმარების ანგარიშებსაც გააზიარებთ, მათ თქვენ მიერ მონახულებულ URL-ებიც დაერთვება</translation>
<translation id="4673710618874938871">შესული ხართ, როგორც <ph name="USER_NAME" />, წევრობა. ანგარიშის მენიუს გახსნა</translation>
<translation id="6608258642372806522">როგორც ჩანს, პროფილი გამოიყენება სხვა João Browser პროცესის მიერ (<ph name="PROCESS_ID" />) სხვა კომპიუტერში (<ph name="HOST_NAME" />). João Browser-მა დაბლოკა პროფილი, რათა არ დაზიანდეს. თუ დარწმუნებული ხართ, რომ სხვა პროცესები არ იყენებენ ამ პროფილს, შეგიძლიათ განბლოკოთ პროფილი და ხელახლა გაუშვათ João Browser.</translation>
<translation id="4680828127924988555">ინსტალაციის გაუქმება</translation>
<translation id="3912572071294857936">თქვენი João Browser-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Google ანგარიშში. სისტემიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში, აღნიშნული მონაცემები წაიშლება.</translation>
<translation id="1077152188344040592">როცა შესული ხართ, João Browser-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი Google ანგარიშიდან. <ph name="SHORTCUT" /> შეცვლის თქვენი Google სერვისების პარამეტრებს.</translation>
<translation id="5729536702149847030">João Browser-ში უკვე განხორციელდა შესვლა ამ კომპიუტერიდან, როგორც <ph name="ACCOUNT_EMAIL_LAST" />. გთხოვთ, შექმნათ João Browser-ის ახალი მომხმარებელი თქვენი ინფორმაციის ცალკე შესანახად.</translation>
<translation id="4724676981607797757">ინსტალაცია ვერ მოხერხდა მხარდაუჭერელი პროტოკოლის შეცდომის გამო.</translation>
<translation id="6273241729694500032">მაინც გსურთ João Browser-იდან გასვლა?</translation>
<translation id="3239680024825449390">João Browser-ს ეს-ესაა მიესადაგა უსაფრთხოების საგანგებო განახლება. გადატვირთეთ ის ახლავე (თქვენი ჩანართები აღდგება).</translation>
<translation id="4771701986670315895">ბოლო დროს არ ყოფილხართ. Chromium-მა ამოშალა <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> და კიდევ <ph name="COUNT" />.</translation>
<translation id="1908292729364083164">თუ Gemini João Browser-ში გახსნილია, გვერდითი პანელი ღია რჩება ახალი ჩანართების შექმნისას</translation>
<translation id="479167709087336770">ეს ფუნქცია იყენებს მართლწერის იმ შემმოწმებელს, რომელიც გამოიყენება Google Search-ში. ბრაუზერში თქვენ მიერ აკრეფილი ტექსტი ეგზავნება Google-ს. ამ ქცევის შეცვლა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
