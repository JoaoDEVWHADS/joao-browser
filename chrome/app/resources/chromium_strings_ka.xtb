<translation id="8833697763442816810">ChromiumOS სისტემა</translation>
<translation id="8852026904190808918">ეს ენა გამოიყენება მენიუს, პარამეტრების, გაფრთხილებებისა და სხვა ტექსტური კონტენტის Chromium-ში საჩვენებლად</translation>
<translation id="8862326446509486874">თქვენ არ გაქვთ შესაბამისი უფლებები სისტემის დონეზე ინსტალაციისთვის. სცადეთ ინსტალაციის პროგრამის ხელახლა გაშვება ადმინისტრატორის სტატუსით.</translation>
<translation id="6821836710312478344">João Browser პროფილის დამატება</translation>
<translation id="5139769635207740615">ChromiumOS-მა ვერ შეინახა João Browser-ის მონაცემები თქვენს Google ანგარიშში ავტორიზაციის შეცდომის გამო</translation>
<translation id="6814613825007700341">თქვენი ორგანიზაცია მოითხოვს, რომ João Browser-ში შეხვიდეთ</translation>
<translation id="1009831347869773172">João Browser ცდილობს პაროლების ჩვენებას. ჩაწერეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="690637523240192979">João Browser აღარ არის თქვენი ნაგულისხმევი ბრაუზერი. გახდეს João Browser ნაგულისხმევი ბრაუზერი?</translation>
<translation id="225046375773654931">João Browser-ის განახლება ვერ მოხერხდა</translation>
<translation id="8944232836376404813">ეს მოქმედება:
          <ph name="LINE_BREAKS" />
            • გადააყენებს თქვენს გაშვების გვერდს, ახალი ჩანართის გვერდს, საძიებო სისტემას და ჩამაგრებულ ჩანართებს
            <ph name="LINE_BREAK" />
            • გათიშავს გაფართოებებს
            <ph name="LINE_BREAK" />
            • წაშლის ქუქი-ჩანაწერებს და საიტების სხვა დროებით მონაცემებს
            <ph name="LINE_BREAKS" />
            სანიშნეები, ისტორია და შენახული პაროლები ხელუხლებელი დარჩება.</translation>
<translation id="4960303269157380091">საიტებისთვის João Browser-ის მალსახმობების ჩვენება</translation>
<translation id="4349474976990059197">João Browser Enterprise-ის ლოგო</translation>
<translation id="3227699293368317033">თან იქონიეთ Google-ის უსაფრთხოება João Browser აპის მეშვეობით თქვენს <ph name="DEVICE_TYPE" />-ზე</translation>
<translation id="6527164294507620103">João Browser-ის გაშვება შეუძლებელია, რადგან თქვენი პროფილის გახსნისას მოხდა შეცდომა. ცადეთ João Browser-ის გადატვირთვა.</translation>
<translation id="6741767563284518125">João Browser-ის პროფილების მართვა</translation>
<translation id="3101491883380219087">Gemini João Browser-სა და გახსნილ ჩანართს შორის გადაადგილდით კლავიატურის მეშვეობით.</translation>
<translation id="9018218886431812662">ინსტალაცია დასრულდა</translation>
<translation id="3370247132646333337">João Browser-ის უსაფრთხოების გასაძლიერებლად, ჩვენ გავთიშეთ შემდეგი გაფართოება, რომელიც არ არის ხელმისაწვდომი <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ში და, შესაძლოა, თქვენი თანხმობის გარეშე დაემატა.</translation>
<translation id="1940116386572548863">შედით João Browser-ში</translation>
<translation id="5471723344588240291">João Browser-ით ძიების ჩვენება Mac-ის მენიუს ზოლში და კლავიატურის მალსახმობის ჩართვა</translation>
<translation id="8381652653666868014">João Browser-მა დაბლოკა ეს ჩამოტვირთვა, რადგან არქივის ფაილი შეიცავს სხვა ფაილებს, რომლებშიც, შესაძლოა, მავნე პროგრამა იმალებოდეს</translation>
<translation id="8374335201144490555">დაასინქრონეთ თქვენი პაროლები, სანიშნეები და ისტორია თქვენს მოწყობილობებში. ნაგულისხმევ ბრაუზერად João Browser-ის დაყენებით მარტივად მიიღეთ წვდომა თქვენთვის ნაცნობ და საყვარელ ფუნქციებზე. João Browser ჩამაგრდება თქვენს ამოცანათა ზოლში სწრაფი წვდომისთვის.</translation>
<translation id="6176486087616698123">გამოიყენეთ Google-ის საუკეთესო AI ხელსაწყოები João Browser აპით თქვენს ტელეფონში</translation>
<translation id="9062666675513499497">შედით Chromium-ში, როცა Google-ის სხვა სერვისებში შედიხართ</translation>
<translation id="724802823738504651">João Browser ავტომატურად დაიხურა</translation>
<translation id="2689333215784698609">João Browser მოძველდა</translation>
<translation id="8049510467237146160">{0,plural, =1{João Browser ხელახლა გაეშვება 1 საათში}other{João Browser ხელახლა გაეშვება # საათში}}</translation>
<translation id="9106236359747881194">მონიშნეთ ტექსტი მოსაძებნად</translation>
<translation id="8558551666630075184">João Browser-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 8.1-ს.</translation>
<translation id="1194819784870407331">ბმულის გახსნა João Browser-ის ახალ ჩა&amp;ნართში</translation>
<translation id="911206726377975832">ასევე წაშალოთ თქვენი დათვალიერების მონაცემები?</translation>
<translation id="9134482777260927479">დახმარება საშინაო დავალებაში</translation>
<translation id="9148058034647219655">გასვლა</translation>
<translation id="548951409840319583">გააგრძელეთ იქიდან, სადაც გაჩერდით: João Browser-ს შეუძლია თქვენი ჩანართების აღდგენა ყოველი გადატვირთვის შემდეგ. ამის ჩასართავად გადადით აქ:</translation>
<translation id="7614949510548815395">თქვენი სისტემის ადმინისტრატორმა მოახდინა João Browser-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME" />-ზე წვდომისთვის საჭიროა ალტერნატიული ბრაუზერის გახსნა.</translation>
<translation id="3441698750089879771">ხელახლა გაშვება &amp;João Browser-ის გასაახლებლად</translation>
<translation id="369689859238510548">João Browser (mDNS-In)</translation>
<translation id="8336832914816665097">მოირგეთ João Browser</translation>
<translation id="7698429329590050365">João Browser-მა შეიძლება არასწორად იმუშაოს, რადგან ის აღარ არის მხარდაჭერილი Windows XP-სა და Windows Vista-ზე</translation>
<translation id="190261805571697214">მიიღეთ Google-ის უსაფრთხოების საუკეთესო ფუნქციები გზაში João Browser-ის მეშვეობით.</translation>
<translation id="945522503751344254">შეფასების გაგზავნა</translation>
<translation id="5554799509799759090">ვინ იყენებს João Browser-ს?</translation>
<translation id="9153108844196984904">ისარგებლეთ João Browser-ის უსაფრთხოების ყველაზე ძლიერი ფუნქციებით</translation>
<translation id="983803489796659991">ინსტალაცია ვერ მოხერხდა, რადგან განახლების სერვერს არ აქვს ამ აპლიკაციის ჰეშ-მონაცემები.</translation>
<translation id="6230710687825107323">João Browser-ის გამოყენება ანგარიშის გარეშე</translation>
<translation id="985602178874221306">Chromium-ის ავტორები</translation>
<translation id="989970834842471429">მონიშნეთ ნებისმიერი ტექსტი თუ სურათი, რისი მოძებნაც გსურთ სურათების ძიებით</translation>
<translation id="992780518932311116">თქვენი მდებარეობა რომ გამოიყენოთ, გახსენით <ph name="BEGIN_LINK" />სისტემის პარამეტრები<ph name="END_LINK" /> და მიანიჭეთ Chromium-ს წვდომა</translation>
</translationbundle>