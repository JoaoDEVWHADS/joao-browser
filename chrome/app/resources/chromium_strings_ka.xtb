<!DOCTYPE translationbundle>
<translationbundle lang="ka">
<translation id="1026101648481255140">ინსტალაციის გაგრძელება</translation>
<translation id="1029669172902658969">ხელახლა გაშვება &amp;ChromiumOS-ის გასაახლებლად</translation>
<translation id="4711726241445951349">João Browser გირჩევთ, შეამოწმოთ ეს გაფართოება</translation>
<translation id="1042552502243217427">როცა საიტი გთხოვთ, უფლება მისცეთ, კონფიდენციალურად ჩატვირთოს თავის გვერდზე არსებული ბმულები, Chromium გამოიყენებს Google-ის სერვერებს. აღნიშნული დამალავს თქვენს ვინაობას წინასწარ ჩატვირთული საიტისგან, თუმცა Google-ს ეცოდინება, რომელი საიტები იტვირთება წინასწარ.</translation>
<translation id="1051793555070215510">დაგვეხმარეთ ინკოგნიტო რეჟიმის გაუმჯობესებაში ამ 1-წუთიანი გამოკითხვით.</translation>
<translation id="1065672644894730302">თქვენი პარამეტრების წაკითხვა შეუძლებელია.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს და პარამეტრების ცვლილებები არ იქნება შენახული.</translation>
<translation id="3937976866851867994">თქვენმა მშობელმა გამორთო „ნებართვები საიტებისთვის, აპებისა და გაფართოებებისთვის“ João Browser-ისთვის</translation>
<translation id="8626021334348319355">João Browser-ის კონკრეტული ფუნქციის ან გაფართოების მოსაძებნად აკრიფეთ მისი მალსახმობი მისამართთა ზოლში, რასაც მოჰყვება თქვენ მიერ არჩეული კლავიატურის კლავიში</translation>
<translation id="571817873405657554">João Browser-ით ძიების სისტემურ არეში ჩვენება და კლავიატურის მალსახმობის ჩართვა</translation>
<translation id="9157778882771986870">João Browser ითხოვს თქვენი პაროლების ექსპორტირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="112640046208448578">მოახდინეთ საგნების თუ ადგილების იდენტიფიცირება, დააკოპირეთ ან თარგმნეთ ტექსტი. სურათების ძიების გამოყენებისას გვერდის ეკრანის ანაბეჭდი იგზავნება სერვერზე. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium თქვენი ნაგულისხმევი ბრაუზერია</translation>
<translation id="1131805035311359397"><ph name="BEGIN_LINK" />შედით Chromium-ში<ph name="END_LINK" />, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს პაროლებს.</translation>
<translation id="2795895511109336240">დაწკაპუნებით აირჩიეთ João Browser-ის მენიუ</translation>
<translation id="1157985233335035034">ბოლოდროინდელი ენები</translation>
<translation id="1184145431117212167">ინსტალაცია ვერ მოხერხდა, რადგან Windows-ის თქვენი ვერსია არ არის მხარდაჭერილი.</translation>
<translation id="1185134272377778587">Chromium-ის შესახებ</translation>
<translation id="667420476518265356">მიიღეთ თქვენს ტელეფონში ფასების მეთვალყურის გაფრთხილებები João Browser-ის მეშვეობით</translation>
<translation id="1203500561924088507">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME" />-ის გამოყენებამდე თქვენი ბრაუზერი უნდა გადატვირთოთ.</translation>
<translation id="1232234696885483911">სურათების ძიების გახსნისას გვერდის სათაური, URL და კონტენტი, PDF-ების ჩათვლით, ავტომატურად გაიგზავნება სერვერზე. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">როცა შესული ხართ, João Browser-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი Google ანგარიშიდან. ამ პარამეტრის შესაცვლელად გახსენით „თქვენი ანგარიში João Browser-ში“.</translation>
<translation id="4866003137980530528">Gemini-ს ჩვენება João Browser-ში Mac-ის მენიუს ზოლში</translation>
<translation id="2526294198551578217">João Browser-ში Gemini-ში ეკრანის ნაწილის ასარჩევად გამოიყენეთ კლავიატურის მალსახმობი.</translation>
<translation id="7068536367561625920">სანამ ეს ჩანართი უმოქმედო იყო, João Browser-ის სისწრაფის შესანარჩუნებლად მეხსიერება გათავისუფლდა. სურვილისამებრ, შეგიძლიათ აირჩიოთ, რომ ეს საიტი ყოველთვის გამოირიცხოს უმოქმედოთა რიგებიდან.</translation>
<translation id="3669854427836618143">João Browser-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ეს ფაილი სახიფათოა</translation>
<translation id="126567311906253476">Google სერვისებში, მაგალითად, Gmail-სა თუ YouTube-ში <ph name="USER_EMAIL" />-ით შესვლისას შეგიძლიათ Chromium-შიც იმავე ანგარიშით შეხვიდეთ</translation>
