<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="si">
<translation id="1026101648481255140">ස්ථාපනය නැවත ආරම්භ කරන්න</translation>
<translation id="1029669172902658969">&amp;ChromiumOS යාවත්කාලීන කිරීමට යළි දියත් කරන්න</translation>
<translation id="4711726241445951349">João Browser ඔබට මෙම දිගුව සමාලෝචනය කිරීමට නිර්දේශ කරයි</translation>
<translation id="1042552502243217427">අඩවියක් ඒවායේ පිටුවේ සබැඳි පෞද්ගලිකව පූර්ව පූරණය කිරීමට ඉල්ලා සිටින විට, Chromium Google සේවාදායක භාවිත කරයි. මෙය පූර්ව පූරණය කර ඇති අඩවියෙන් ඔබේ අනන්‍යතාව සඟවන නමුත්, Google පූර්ව පූරණය කරනු ලබන අඩවි මොනවා දැයි ඉගෙන ගනියි.</translation>
<translation id="1051793555070215510">මෙම මිනිත්තු 1ක සමීක්ෂණයට සහභාගී වීමෙන් අප්‍රසිද්ධ වැඩි දියුණු කිරීමට අපට උදවු කරන්න.</translation>
<translation id="1065672644894730302">ඔබේ තේරීම් කියවිය නොහැක.

ඇතැම් විශේෂාංගයන් නොපැවතිය හැකි අතර තේරීම් වල සිදුකරන වෙනස්ක්ම් නොසුරැකෙනු ඇත.</translation>
<translation id="3937976866851867994">ඔබේ මාපියන් João Browser සඳහා "වෙබ් අඩවි, යෙදුම්, සහ දිගු සඳහා වන අවසර" අක්‍රිය කර ඇත</translation>
<translation id="8626021334348319355">නිශ්චිත João Browser විශේෂාංගයක් හෝ දිගුවක් සෙවීමට, ලිපින තීරුවේ එහි කෙටිමඟ ටයිප් කරන්න, ඉන්පසු ඔබ තෝරා ගත් යතුරුපුවරු යතුර</translation>
<translation id="9157778882771986870">João Browser හට ඔබගේ මුරපද නිර්යාත කිරීමට අවශ්‍යය. මේ සඳහා අවසර දීමට ඔබගේ Windows මුරපදය ටයිප් කරන්න.</translation>
<translation id="112640046208448578">දේවල් හෝ ස්ථාන හඳුනාගෙන පෙළ පිටපත් කරන්න හෝ පරිවර්තනය කරන්න. ඔබ රූප සෙවීම භාවිත කරන විට, පිටුවේ තිර රුවක් සේවාදායකයට යවනු ලැබේ. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium ඔබේ පෙරනිමි බ්‍රව්සරය වේ</translation>
<translation id="1131805035311359397">ඔබගේ මුරපද දත්ත කඩ කිරීම්වලින් සහ අනෙකුත් ආරක්ෂක ගැටලුවලින් සුරක්ෂිතද යන්න පරීක්ෂා කිරීමට, <ph name="BEGIN_LINK" />Chromium වෙත පුරන්න<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">João Browser මෙනුව ක්ලික් කරන්න</translation>
<translation id="1157985233335035034">මෑත භාෂා</translation>
<translation id="1184145431117212167">ඔබේ Windows අනුවාදය සඳහා සහය නොදක්වන නිසා ස්ථාපනය අසමත් විය.</translation>
<translation id="1185134272377778587">Chromium පිළිබඳ</translation>
<translation id="667420476518265356">ඔබේ දුරකථනයෙන් João Browser සමග මිල නිරීක්ෂණ ඇඟවීම් ලබා ගන්න</translation>
<translation id="1203500561924088507">ස්ථාපනය කිරීම වෙනුවෙන් ස්තුතියි. ඔබ <ph name="BUNDLE_NAME" /> භාවිත කිරීමට පෙර ඔබගේ බ්‍රවුසරය යළි ඇරඹිය යුතුය.</translation>
<translation id="1232234696885483911">ඔබ රූප සෙවීම විවෘත කරන විට, පිටුවේ මාතෘකාව, URL, සහ PDF ඇතුළු අන්තර්ගතය ස්වයංක්‍රීයව සේවාදායකය වෙත යවනු ලැබේ. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">ඔබ පුරනය වී සිටින අතරතුර, ඔබට João Browser තුළ ඔබේ Google ගිණුමෙන් ඔබේ මුරපද සහ තවත් ඒවා භාවිත කළ හැක මෙය වෙනස් කිරීමට, “João Browser තුළ ඔබේ ගිණුම” වෙත යන්න.</translation>
<translation id="4866003137980530528">Mac මෙනු තීරුවේ João Browser තුළ Gemini පෙන්වන්න</translation>
<translation id="2526294198551578217">João Browser තුළ Gemini තුළ තිරයේ කොටසක් තේරීමට, යතුරුපුවරු කෙටිමඟ භාවිතා කරන්න.</translation>
<translation id="7068536367561625920">මෙම පටිත්ත අක්‍රියව තිබෙන අතරේ, João Browser වේගවත්ව තබා ගැනීම සඳහා මතකය නිදහස් කරන ලදි. ඔබට මෙම අඩවිය අක්‍රිය වීමෙන් සැම විට බැහැර කිරීමට තෝරා ගත හැක.</translation>
<translation id="3669854427836618143">ගොනුව භයානක නිසා João Browser මෙම බාගැනීම අවහිර කර ඇත</translation>
<translation id="126567311906253476"><ph name="USER_EMAIL" /> සමග Gmail හෝ YouTube වැනි Google සේවාවලට පුරන විට, ඔබට එම ගිණුමෙන්ම Chromium වෙත ස්වයංක්‍රීයව පුරනය විය හැක</translation>
<translation id="8094399825947986050">ඔබේ දුරකථනයෙන් João Browser ලබා ගන්න</translation>
<translation id="1290883685122687410">පිහිටුවීමේ දෝෂයකි: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">ඔබගේ නව João Browser පැතිකඩ පිහිටුවන්න</translation>
<translation id="7591029065989504977">João Browser හි Gemini සමග උත්සාහ කරන්න</translation>
<translation id="8408989583029959522">බ්ලූටූත් උපාංග ගවේෂණය කිරීමට João Browser හට බ්ලූටූත් ප්‍රවේශය අවශ්‍යයි.<ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">ඔබේ දුරකථනයෙන් João Browser වෙත පුරන්න</translation>
<translation id="1330562121671411446">භාෂාව අනාවරණය කරන්න</translation>
<translation id="6026568602942276348">João Browser වෙතින් ද දත්ත මකන්න (<ph name="URL" />)</translation>
<translation id="1345251407431278948">අමුණන ලදි! ඔබට මෙවලම් තීරුවේ ඇති නව බොත්තමෙන් රූප සෙවීම වෙත නැවත ප්‍රවේශ විය හැක</translation>
<translation id="1356661055722410047">අලුත්! ඔබට ඔබේ තිරයේ ඇති පෙළ සහ පින්තූර දෙකම පරිවර්තනය කළ හැක</translation>
<translation id="1383876407941801731">සොයන්න</translation>
<translation id="5807085300679014096">යන ගමන් බ්‍රවුස් කිරීම තබා ගැනීමට João Browser යෙදුම භාවිතා කරන්න</translation>
<translation id="141901961143729572">ඔබේ සිතුවිලි බෙදා ගන්න</translation>
<translation id="3736947618013031173">ඔබේ කවුළුව බෙදා ගැනීමට, පද්ධති සැකසීම් තුළ João Browser සඳහා තිර පටිගත කිරීමට ඉඩ දෙන්න.</translation>
<translation id="1478370723027452770">පරීක්ෂා කිරීම සඳහා Chrome සමග උදවු ලබා ගන්න</translation>
<translation id="1497802159252041924">ස්ථාපනය කිරීමේ දෝෂයක්: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">මෙම පිටුව ආරක්ෂිතයි.</translation>
<translation id="4379865404970367448">João Browser පටිත්තක් බෙදා ගන්න</translation>
<translation id="4436275659297289591">João Browser වෙත පිවිසෙන්න</translation>
<translation id="1547469039832541117">උද්දීපනය කළ කාර්යය නිමා කරයි.</translation>
<translation id="449712764049695153">João Browser අමුණන්න</translation>
<translation id="1574377791422810894">Chromium හි සුරක්ෂිතතා මෙවලම්</translation>
<translation id="5480232403718129394">João Browser හට ඔබේ මුරපද කළමනාකරු දත්ත මැකීමට අවශ්‍යයි. මෙයට ඉඩ දීමට ඔබේ Windows මුරපදය ටයිප් කරන්න.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{යාවත්කාලීනයක් යෙදීමට ඔබ João Browser නැවත ආරම්භ කිරීම පරිපාලකයාට අවශ්‍ය වේ}=1{යාවත්කාලීනයක් යෙදීමට ඔබ João Browser නැවත ආරම්භ කිරීම පරිපාලකයාට අවශ්‍ය වේ. ඔබේ අප්‍රසිද්ධ කවුළුව යළි විවෘත නොවෙයි.}one{යාවත්කාලීනයක් යෙදීමට ඔබ João Browser නැවත ආරම්භ කිරීම පරිපාලකයාට අවශ්‍ය වේ. ඔබේ අප්‍රසිද්ධ කවුළු # යළි විවෘත නොවෙයි.}other{යාවත්කාලීනයක් යෙදීමට ඔබ João Browser නැවත ආරම්භ කිරීම පරිපාලකයාට අවශ්‍ය වේ. ඔබේ අප්‍රසිද්ධ කවුළු # යළි විවෘත නොවෙයි.}}</translation>
<translation id="980976428162070137">ඔබේ දුරකථනයේ João Browser යෙදුම සමග Google හි හොඳම දේ ලබා ගන්න</translation>
<translation id="1625909126243026060">Chromium හි ප්‍රධාන පෞද්ගලිකත්ව සහ ආරක්ෂක පාලන සමාලෝචනය කරන්න</translation>
<translation id="1640672724030957280">බාගනිමින්...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" />, සාමාජිකත්වය ලෙස පුරනය විය. ගිණුම් මෙනුව විවෘත කරන්න</translation>
<translation id="1708414395296835197">ඔබ පණිවිඩ, ලේඛන, සහ වෙනත් යෙදුම්වල සබැඳි ක්ලික් කරන ඕනෑම වේලාවක ඔබට Chromium භාවිත කළ හැක. එය ඔබේ කාර්ය තීරුවට ද අමුණනු ඇත.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> සඳහා උසස් වරප්‍රසාද ලබා දෙයි.</translation>
<translation id="1722488837206509557">මෙය ඔබට පවතින උපාංගවලින් තේරීමට සහ ඒවායේ අන්තර්ගතය පෙන්වීමට ඉඩ දෙනු ඇත.</translation>
<translation id="6972087163510342335">João Browser ඉක්මනින් බ්‍රවුස් කිරීමේ දත්ත මකනු ඇත</translation>
<translation id="1736443181683099871">Chromium සංචාලන HTTPS වෙත උත්ශ්‍රේණි කිරීමට උත්සාහ කරනු ඇත</translation>
<translation id="3879288383593333401">João Browser දත්ත හිස් කරන ලදී</translation>
<translation id="656496276885630888">João Browser <ph name="REMAINING_TIME" />කින් යළි ඇරඹෙනු ඇත</translation>
<translation id="1749104137266986751">HTTPS නොමැති විට, Chromium ඔබට අනතුරු ඇඟවීමකින් තොරව අනාරක්ෂිත සම්බන්ධතාවයක් භාවිතා කරනු ඇත</translation>
<translation id="1226290419185955779">පසුබිමේ João Browser ධාවනය වීමට ඉඩ දෙන්න</translation>
<translation id="4231366995273072370">João Browser වඩාත් ආරක්ෂිත කිරීම සඳහා, අප විසින් <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ලැයිස්තුගත කළ නොමැති හා ඔබේ දැනුමෙන් තොරව එක්කළ ඇතැම් දිගු අක්‍රීය කර ඇත.</translation>
<translation id="1822049153969905781">ඉක්මන් ප්‍රවේශය සඳහා João Browser ඔබේ කාර්ය තීරුවට ඇමිණීමට, Windows දැනුම්දීමෙහි ඇති <ph name="BEGIN_BOLD" />ඔව්<ph name="END_BOLD" /> යන්න ක්ලික් කරන්න.</translation>
<translation id="1321831992638405531">João Browser ප්‍රතිස්ථාපනය කරන්න</translation>
<translation id="3386967202064865436">João Browser <ph name="AUTHENTICATION_PURPOSE" /> සඳහා උත්සාහ කරයි</translation>
<translation id="70054449700528483">මීළඟ වතාවේ ඔබ ඔබේ <ph name="DEVICE_TYPE" /> මත João Browser විවෘත කරන විට, Google මුරපද කළමනාකරු භාවිත කිරීමට ප්‍රේරකයක් ඔබට පෙනෙනු ඇත.</translation>
<translation id="1838374766361614909">සෙවීම හිස් කරන්න</translation>
<translation id="5807096362853316123">එය ඔබේ Google ගිණුම තුළ තබා ගන්නා අතර මෙම උපාංගයෙන් පමණක් බ්‍රවුස් කිරීමේ දත්ත මැකීමට, <ph name="BEGIN_LINK" />João Browser වෙතින් වරන්න<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">ගමනේ දී නව පටිති සමූහ විවෘත කිරීමට හෝ තැනීමට ඔබේ දුරකථනයට João Browser බාගන්න.</translation>
<translation id="185970820835152459">ඔබට ඔබගේ පුරන ලද Google ගිණුම් කළමනාකරණය කළ හැකිය. ඔබගේ Google ගිණුම් Chromium බ්‍රව්සරය, Play Store, Gmail සහ තවත් දේ සඳහා භාවිත කෙරේ. ඔබට පවුලේ සාමාජිකයකු වැනි, වෙනත් යම් කෙනෙකු සඳහා ගිණුමක් එක් කිරීමට අවශ්‍ය නම්, ඒ වෙනුවට ඔබගේ <ph name="DEVICE_TYPE" /> වෙත නව පුද්ගලයකු එක් කරන්න. <ph name="LINK_BEGIN" />තව දැන ගන්න<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">රූප සෙවීම සමග සොයන්න</translation>
<translation id="65457771685016683"><ph name="EXISTING_USER" /> දැනටමත් පුරනය වී නැත. ඔබේ බ්‍රවුස් කිරීම වෙනම තබා ගැනීමට, <ph name="USER_EMAIL_ADDRESS" /> ලෙස ඔබේම පැතිකඩෙන් João Browser හට පුරන්න. ඔබට <ph name="DEVICE" /> වෙතින් ඔබේ පිටුසන් සහ තවත් දේ ද ලැබෙනු ඇත.</translation>
<translation id="1880677175115548835">පාඨය තෝරන්න</translation>
<translation id="2634119629547215883">ඔබ කළමනාකරණය කළ ගිණුමක් වෙත සයින් ඉන් වන අතර ඔබේ João Browser පැතිකඩෙහි පරිපාලක පාලනය ලබා දේ. යෙදුම්, පිටු සලකුණු, ඉතිහාසය, රහස්වචන, සහ අනෙකුත් පසුතල වැනි ඔබේ João Browser දත්ත ස්ථිරවම <ph name="USER_NAME" /> වෙත බැඳෙනු ඇත. Google Accounts Dashboard හරහා මෙම දත්ත මැකීමට ඔබට හැකි වනු ඇත, නමුත් ඔබට මෙම දත්ත වෙනත් ගිණුමක් සමඟ සම්බන්ධ කළ නොහැක. ඔබේ පවතින João Browser දත්ත වෙනමම තබා ගැනීමට ඔබට විකල්ප වශයෙන් නව පැතිකඩක් සෑදිය හැකිය. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium පසුබිම් ක්‍රියාකාරකම් සහ සුමට අනුචලන සහ වීඩියෝ රාමු අනුපාත වැනි දෘශ්‍ය ප්‍රයෝග සීමා කිරීමෙන් බැටරි බලය සංරක්ෂණය කරයි. <ph name="BEGIN_LINK" />බලශක්ති සුරැකුම පිළිබඳ තව දැන ගන්න<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">João Browser යාවත්කාලීන සේවාව</translation>
<translation id="1911763535808217981">මෙය අක්‍රිය කිරීමෙන්, ඔබට Chromium වෙත පුරනය නොවී Gmail වැනි Google වෙබ් අඩවිවලට පුරනය විය හැක.</translation>
<translation id="4037729269678342163">João Browser ප්‍රතිචාර නොදක්වයි. නැවත දියත් කරන්නද?</translation>
<translation id="7563750688920581112">ඔබේ සංවිධානයට, <ph name="MANAGER" />, ඔබ João Browser වෙත පුරනය වීමට අවශ්‍යයි</translation>
<translation id="193439633299369377">යාවත්කාලීනය යෙදීමට ChromiumOS යළි ඇරඹිය යුතුය.</translation>
<translation id="7099143775283792684">ගොනු වර්ගය සාමාන්‍යයෙන් බාගත නොවන නිසා සහ එය භයානක විය හැකි නිසා João Browser මෙම බාගැනීම අවහිර කර ඇත</translation>
<translation id="1953553007165777902">බාගනිමින්... මිනිත්තු <ph name="MINUTE" />ක් ඉතිරිව ඇත</translation>
<translation id="1966382378801805537">Chromium හට පෙරනිමි බ්‍රව්සරය නිර්ණය කිරීමට හෝ සැකසීමට නොහැකිය</translation>
<translation id="197326043290947695">රූප සෙවීම සමඟ වඩාත් සුහුරු ලෙස බ්‍රවුස් කරන්න</translation>
<translation id="6185556991023272801">João Browser නව පටිත්තක විවෘත වන සමහර ගොනු අවහිර කරන්නේ මන්දැයි ඉගෙන ගන්න</translation>
<translation id="4053636705816895911">ඔබේ João Browser මෘදුකාංගය යාවත්කාලීනව තබයි. මෙම සේවාව අබල කර ඇත්නම් හෝ නතර වුවහොත්, ඔබේ João Browser මෘදුකාංගය යාවත්කාලීනව නොතිබෙනු ඇත, එනම් මතු විය හැකි ආරක්ෂක අවදානම් නිරාකරණය කළ නොහැකි අතර විශේෂාංග ක්‍රියා නොකරනු ඇත. මෙම සේවාව භාවිත කරන João Browser මෘදුකාංගයක් නොමැති විට එය අස්ථාපනය වෙයි.</translation>
<translation id="2008474315282236005">මෙය මෙම උපාංගයෙන් අයිතම 1ක් මකනු ඇත. ඔබගේ දත්ත පසුව ලබා ගැනීමට, <ph name="USER_EMAIL" /> ලෙස Chromium වෙත පුරන්න.</translation>
<translation id="2018879682492276940">ස්ථාපනය අසාර්ථක විය. කරුණාකර නැවත උත්සාහ කරන්න.</translation>
<translation id="2039417478970545937">සැකසීම්</translation>
<translation id="2049376729098081731">Google සේවාවල වඩාත් පුද්ගලිකකරණය කළ අත්දැකීම් සඳහා Chromium ඉතිහාසය ඇතුළත් කළ යුතුද යන්න තෝරන්න</translation>
<translation id="6768767091114123654">ඔබට ශක්තිමත් මුරපද තැනීම, සුරැකීම සහ ස්වයං පිරවීම සඳහා උදවු කිරීම João Browser තුළට ම ඇතුළත් කර ඇත. පහසු ප්‍රවේශය සඳහා කෙටිමඟ එක් කරන්න.</translation>
<translation id="3571664229232252557">João Browser හට නව පෙනුමක් ලබා දීමට නව පටිති පිටුවේ João Browser අභිරුචි කරන්න බොත්තම ක්ලික් කරන්න</translation>
<translation id="4273287215573278663">ගොනුව රැවටිලිකාර සහ ඔබේ උපාංගයට අනපේක්ෂිත වෙනස්කම් සිදු කළ හැකි නිසා João Browser මෙම බාගැනීම අවහිර කර ඇත</translation>
<translation id="9063967192437499581">ඔබ මීළඟ වතාවේ João Browser iOS විවෘත කරන විට <ph name="FEATURE_NAME" /> උත්සාහ කිරීමට ඔබට ප්‍රේරකයක් පෙනෙනු ඇත.</translation>
<translation id="8511569826706775962">ඔබ ඔබේ Google ගිණුමේ සුරකින ලද ඔබේ මුරපද සහ අනෙකුත් João Browser දත්ත මෙම උපාංගයෙන් ඉවත් කරනු ලැබේ. ඒවා නැවත João Browser තුළ භාවිතා කිරීමට, නැවත පුරනය වන්න.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{1 මිනිත්තුවකට João Browser භාවිත නොකරන විට ඔබේ සංවිධානය බ්‍රවුස් කිරීමේ දත්ත ස්වයංක්‍රීයව මකයි. මෙයට ඉතිහාසය, ස්වයං පිරවුම, සහ බාගැනීම් ඇතුළත් විය හැක. ඔබේ පටිති විවෘතව පවතියි.}one{මිනිත්තු #කට João Browser භාවිත නොකරන විට ඔබේ සංවිධානය බ්‍රවුස් කිරීමේ දත්ත ස්වයංක්‍රීයව මකයි. මෙයට ඉතිහාසය, ස්වයං පිරවුම, සහ බාගැනීම් ඇතුළත් විය හැක. ඔබේ පටිති විවෘතව පවතියි.}other{මිනිත්තු #කට João Browser භාවිත නොකරන විට ඔබේ සංවිධානය බ්‍රවුස් කිරීමේ දත්ත ස්වයංක්‍රීයව මකයි. මෙයට ඉතිහාසය, ස්වයං පිරවුම, සහ බාගැනීම් ඇතුළත් විය හැක. ඔබේ පටිති විවෘතව පවතියි.}}</translation>
<translation id="2125838419757773031">සෙවීමට තිරයේ කලාපය තෝරන්න</translation>
<translation id="2126108037660393668">බාගත කළ ගොනුව සත්‍යාපනය කිරීම අසමත් විය.</translation>
<translation id="2135919691573380097">මෙම අඩවිය වාර්තා කරන්න</translation>
<translation id="2137162749895930932">පරිවර්තන තිරය වසන්න</translation>
<translation id="1308845716497059117">වෙබ් අඩවිය සුරක්ෂිත සබැඳුමක් භාවිතා නොකරන නිසා සහ ගොනුව විකෘති වී ඇති නිසා João Browser මෙම බාගැනීම අවහිර කර ඇත</translation>
<translation id="2170098639895543546">පිටුවෙහි ඕනෑම දෙයක් තෝරන්න</translation>
<translation id="6705844023496387932">João Browser අභිරුචිකරණය කරන්න</translation>
<translation id="2174917724755363426">ස්ථාපනය සම්පූර්ණ නැත. ඔබට අවලංගු කිරීමට අවශ්‍ය බව විශ්වාසද?</translation>
