<translation id="6412488898785231889">João Browser ប្រាប់អ្នក​ឱ្យដឹងថាតើពាក្យ​សម្ងាត់របស់អ្នក​ធ្លាប់ត្រូវបានវាយលុកឬអត់</translation>
<translation id="684888714667046800">មិនអាចភ្ជាប់ទៅអ៊ីនធឺណិតបានទេ។ ប្រសិនបើអ្នក​ប្រើជញ្ជាំង​ភ្លើង សូម​ប្រាកដថា <ph name="PRODUCT_EXE_NAME" /> ស្ថិត​នៅក្នុង​បញ្ជីអនុញ្ញាត។</translation>
