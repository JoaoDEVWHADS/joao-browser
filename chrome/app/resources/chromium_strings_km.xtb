<translation id="9018218886431812662">ការដំឡើង​បានបញ្ចប់</translation>
<translation id="3370247132646333337">ដើម្បីធ្វើឲ្យ João Browser មានសុវត្ថិភាពជាងមុន យើងបានបិទដំណើរកម្មវិធីបន្ថែមមួយចំនួនដែលមិនត្រូវបានរាយនៅក្នុង <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ហើយអាចត្រូវបានបន្ថែមដោយពុំមានការជូនដំណឹងដល់អ្នក។</translation>
<translation id="1940116386572548863">ចូលទៅ João Browser</translation>
<translation id="5471723344588240291">បង្ហាញការស្វែងរកតាមរយៈ João Browser នៅក្នុងរបារម៉ឺនុយ Mac និងបើកផ្លូវកាត់​ក្ដារ​ចុច</translation>
<translation id="8381652653666868014">João Browser បានទប់ស្កាត់​ការទាញយកនេះ ដោយសារ​ឯកសារ​ក្នុង​បណ្ណសារនេះ​រួមមាន​ឯកសារ​ផ្សេងទៀត​ដែលអាច​លាក់កម្មវិធីគ្រោះថ្នាក់</translation>
<translation id="8374335201144490555">បន្តធ្វើ​សមកាលកម្ម​ពាក្យសម្ងាត់ ចំណាំ និង​ប្រវត្តិ​របស់អ្នក​បានយ៉ាងល្អ​ឥតខ្ចោះ​នៅលើ​ឧបករណ៍​នានា។ ងាយស្រួល​ចូលប្រើ​មុខងារ​ដែលអ្នក​ស្គាល់ និង​ពេញចិត្ត​ដោយ​ប្ដូរ​កម្មវិធីរុករកតាមអ៊ីនធឺណិតលំនាំដើម​របស់អ្នក​ទៅ João Browser។ João Browser នឹង​ត្រូវបានខ្ទាស់​ទៅរបារកិច្ចការ​របស់អ្នក ដើម្បី​ចូលប្រើបានរហ័ស។</translation>
<translation id="6176486087616698123">ប្រើឧបករណ៍ AI ល្អបំផុតរបស់ Google តាមរយៈកម្មវិធី João Browser នៅលើទូរសព្ទរបស់អ្នក</translation>
<translation id="9062666675513499497">ចូលគណនីលើ Chromium នៅពេលអ្នកចូលសេវាកម្ម Google ផ្សេងទៀត</translation>
<translation id="724802823738504651">João Browser ត្រូវបានបិទ​ដោយស្វ័យប្រវត្តិ</translation>
<translation id="2689333215784698609">João Browser ហួសសម័យហើយ</translation>
<translation id="8049510467237146160">{0,plural, =1{João Browser នឹង​ចាប់ផ្ដើមឡើងវិញ​ក្នុងរយៈពេល​មួយ​ម៉ោងទៀត}other{João Browser នឹង​ចាប់ផ្ដើមឡើងវិញ​ក្នុងរយៈពេល # ម៉ោងទៀត}}</translation>
<translation id="9106236359747881194">ជ្រើសរើសអក្សរដើម្បីស្វែងរក</translation>
<translation id="8558551666630075184">ដើម្បីទទួលបានកំណែថ្មីរបស់ João Browser នាពេលខាងមុខ អ្នកនឹងត្រូវការ Windows 10 ឬកំណែក្រោយនេះ។ កុំព្យូទ័រនេះកំពុងប្រើ Windows 8.1។</translation>
<translation id="1194819784870407331">បើក​តំណ​នៅក្នុងផ្ទាំង​ João Browser ថ្មី</translation>
<translation id="911206726377975832">លុបទិន្នន័យរុករករបស់អ្នកផងដែរ?</translation>
<translation id="9134482777260927479">ជំនួយ​កិច្ចការ​សាលា</translation>
<translation id="9148058034647219655">ចាកចេញ</translation>
<translation id="548951409840319583">បន្តពី​ចំណុច​ដែលអ្នក​បានឈប់៖ João Browser អាចស្ដារ​ផ្ទាំង​របស់អ្នកបាន រាល់ពេល​ដែលអ្នក​ចាប់ផ្ដើម​ឡើងវិញ។ ដើម្បី​បើកមុខងារនេះ សូមចូល​ទៅកាន់</translation>
<translation id="7614949510548815395">អ្នក​គ្រប់គ្រង​ប្រព័ន្ធ​របស់អ្នកបាន​កំណត់​រចនាសម្ព័ន្ធ João Browser ឱ្យបើក​កម្មវិធីរុករកតាម​អ៊ីនធឺណិត​ផ្សេងសម្រាប់​ចូលប្រើ <ph name="TARGET_URL_HOSTNAME" /> ។</translation>
<translation id="3441698750089879771">ចាប់​ផ្តើមឡើងវិញដើម្បីដំឡើងកំណែ &amp;João Browser</translation>
<translation id="369689859238510548">João Browser (mDNS-In)</translation>
<translation id="8336832914816665097">កំណត់​ឱ្យ João Browser ក្លាយជារបស់អ្នក</translation>
<translation id="7698429329590050365">João Browser អាច​នឹង​​ដំណើរការ​មិន​​ត្រឹមត្រូវ​ ដោយសារ​វា​មិន​អាចប្រើ​បាន​នៅលើ Windows XP ឬ Windows Vista ទៀត​ឡើយ។</translation>
<translation id="190261805571697214">ទទួលបានមុខងារសុវត្ថិភាពល្អបំផុតរបស់ Google ពេលធ្វើដំណើរតាមរយៈ João Browser។</translation>
<translation id="945522503751344254">ផ្ញើមតិ</translation>
<translation id="5554799509799759090">តើនរណា​កំពុងប្រើ João Browser?</translation>
<translation id="9153108844196984904">ទទួលបាន​សុវត្ថិភាពខ្លាំង​បំផុតរបស់ João Browser</translation>
<translation id="983803489796659991">ការដំឡើងមិនបានសម្រេចទេ ដោយសារម៉ាស៊ីនមេដំឡើងកំណែមិនមានទិន្នន័យកូដតំណាងសម្រាប់កម្មវិធី។</translation>
<translation id="6230710687825107323">ប្រើ João Browser ដោយមិនប្រើគណនី</translation>
<translation id="985602178874221306">ផលិតករ Chromium</translation>
<translation id="989970834842471429">ជ្រើសរើស​អក្សរ ឬ​រូបភាព ដើម្បី​ស្វែងរក​ដោយប្រើ​ការស្វែងរក​រូបភាព</translation>
<translation id="992780518932311116">ដើម្បីប្រើ​ទីតាំង​របស់អ្នក សូមផ្ដល់​សិទ្ធិចូលប្រើឱ្យ Chromium នៅក្នុង<ph name="BEGIN_LINK" />ការកំណត់ប្រព័ន្ធ<ph name="END_LINK" /></translation>
