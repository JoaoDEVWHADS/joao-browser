<translation id="3428558977667883100">អ្នកអភិវឌ្ឍន៍កម្មវិធីបន្ថែមនេះបានឈប់បោះផ្សាយកម្មវិធីបន្ថែមនេះ ហើយវាប្រហែលជាមិនមានសុវត្ថិភាពនោះទេ។ សូមដកកម្មវិធីបន្ថែមនេះចេញពី João Browser ដូច្នេះវាមិនអាចមើលឃើញ និងផ្លាស់ប្ដូរទិន្នន័យរបស់អ្នកនៅលើគេហទំព័រដែលអ្នកចូលមើលបានទៀតទេ រួមទាំងព័ត៌មានផ្ទាល់ខ្លួនរបស់អ្នក។</translation>
<translation id="5012944467031125860">João Browser ត្រូវការផ្ទៀងផ្ទាត់ថាជាអ្នក មុនពេលដែលទិន្នន័យមួយចំនួនអាចត្រូវបានរក្សាទុកនៅក្នុងគណនី Google របស់អ្នក និងត្រូវបានប្រើនៅលើឧបករណ៍ទាំងអស់របស់អ្នក។ ប្រសិនបើអ្នក​ចេញពីគណនី​ឥឡូវនេះ ទិន្នន័យនេះ​នឹងត្រូវបាន​លុប។</translation>
<translation id="8822543678238892300">{0,plural, =1{ចាប់ផ្ដើម João Browser ឡើងវិញ​ក្នុងរយៈពេល​មួយ​ថ្ងៃទៀត}other{ចាប់ផ្ដើម João Browser ឡើងវិញ​ក្នុងរយៈពេល # ថ្ងៃទៀត}}</translation>
