<translation id="5370941509199989624"><ph name="FILE_NAME" /> មានគ្រោះថ្នាក់ ដូច្នេះ João Browser បានរារាំងវា។</translation>
<translation id="5119118887583954582">João Browser នឹង​បិទ រួច​លុប​ទិន្នន័យ​ក្នុង​ពេល​ឆាប់ៗ​នេះ</translation>
<translation id="576637711620229618">អ្នកអាចប្ដូររវាងកម្រងព័ត៌មាន João Browser នៅទីនេះ</translation>
<translation id="615103374448673771">ប្រសិនបើអ្នក​អនុញ្ញាតខូគី Chromium អាច​ប្រើខូគី​ទាំងនោះ​នៅ​ពេល​ផ្ទុកជាមុន</translation>
<translation id="6165508094623778733">ស្វែងយល់​បន្ថែម</translation>
<translation id="3738215896821824918">សម្អាត​ទិន្នន័យ João Browser នៅក្នុង​គណនី​របស់អ្នក</translation>
<translation id="2145111683361496197">ឯកសារនេះ​អាចបង្ក​គ្រោះថ្នាក់<ph name="LINE_BREAK" />João Browser អាច​ពិនិត្យមើល​ការទាញយកនេះ​សម្រាប់អ្នកបាន ប្រសិនបើអ្នក​ផ្ដល់​ពាក្យសម្ងាត់។ ព័ត៌មាន​អំពី​ឯកសារនេះ​ត្រូវបាន​បញ្ជូនទៅ​ការរុករកដោយសុវត្ថិភាព​នៅលើ Google ប៉ុន្តែ​ពាក្យ​សម្ងាត់ និង​ខ្លឹមសារ​ឯកសារនេះ​បន្តស្ថិតនៅលើ​ឧបករណ៍​របស់អ្នក។</translation>
<translation id="6182736845697986886">ការដំឡើងមិនបានសម្រេចទេ ដោយសារមានបញ្ហាផ្នែកខាងក្នុងម៉ាស៊ីនមេដំឡើងកំណែ។</translation>
<translation id="6050294746023477088">ត្រូវប្រាកដថា អ្នកចូល João Browser នៅលើ <ph name="TARGET_DEVICE_NAME" /> របស់អ្នក បន្ទាប់មកសាកល្បងផ្ញើម្ដងទៀត។</translation>
<translation id="3395167674702947885">កុំព្យូទ័រនេះមានកំណែ João Browser ថ្មីជាងនេះរួចហើយ។ ប្រសិនបើកម្មវិធីនេះមិនដំណើរការ សូមលុបការតំឡើង João Browser ហើយព្យាយាមម្តងទៀត។</translation>
<translation id="4384214545531685923">{0,plural, =0{João Browser នឹង​ចាប់ផ្តើមឡើងវិញ​ឥឡូវនេះ}=1{João Browser នឹង​ចាប់ផ្ដើមឡើងវិញ​ក្នុងរយៈពេល 1 វិនាទីទៀត}other{João Browser នឹង​ចាប់ផ្ដើមឡើងវិញ​ក្នុងរយៈពេល # វិនាទីទៀត}}</translation>
<translation id="5880255774989397049">João Browser ត្រូវការ​ការអនុញ្ញាត​ឱ្យចូលប្រើ​ទំហំផ្ទុក ដើម្បីទាញយក​ឯកសារ</translation>
<translation id="6245734527075554892">ពិនិត្យ URL ធៀបនឹងបញ្ជីគេហទំព័រគ្មានសុវត្ថិភាព ដែលរក្សាទុកនៅក្នុង Chromium</translation>
<translation id="1959823478027154444">ដាក់ João Browser ជាកម្មវិធីរុករកលំនាំដើម</translation>
<translation id="6248988683584659830">ការកំណត់ការស្វែងរក</translation>
<translation id="9191635841540101343">ទទួលបានមុខងារសុវត្ថិភាពល្អបំផុតរបស់ Google ពេលធ្វើដំណើរតាមរយៈកម្មវិធី João Browser នៅលើទូរសព្ទរបស់អ្នក</translation>
<translation id="538350741885862188">ចាកចេញពី João Browser ឬ?</translation>
<translation id="161121067714522736">ផ្ទាំង​ទាំងនេះ​កំពុង​ប្រើប្រាស់​ធនធាន​បន្ថែម។ ដើម្បី​កែលម្អ​ប្រតិបត្តិការ​របស់អ្នក សូមអនុញ្ញាតឱ្យ João Browser ធ្វើឱ្យផ្ទាំង​ទាំងនេះ​ប្រែជា​អសកម្ម។</translation>
<translation id="2095090272560293574">ប្ដូរកម្រងព័ត៌មាន João Browser របស់អ្នកតាមបំណង</translation>
<translation id="6290827346642914212">ដាក់ឈ្មោះកម្រងព័ត៌មាន Chromium របស់អ្នក</translation>
<translation id="6472525517562723285">កម្មវិធី​បន្ថែម​ចង់ឱ្យ​អ្នកចូលគណនីលើ João Browser</translation>
<translation id="2069878195899746465"><ph name="FILE_NAME" /> អាចបង្កគ្រោះថ្នាក់ ដូច្នេះ João Browser បានរារាំងវា។</translation>
<translation id="1283909912629029170">João Browser កំពុងប្រើកាមេរ៉ារបស់អ្នក។</translation>
<translation id="323902744000752306">ប្រតិបត្តិការផ្សេងទៀតនៅលើ João Browser កំពុងដំណើរការ សូមព្យាយាមម្តងទៀតនៅពេលក្រោយ។</translation>
<translation id="1292164882596462877">ឥឡូវនេះ វាមានភាពងាយស្រួលក្នុងការប្រើ João Browser ជាមួយគណនី Google របស់អ្នក និងនៅលើកុំព្យូទ័រដែលបានចែករំលែក។</translation>
<translation id="6411450594978516531">ងាយស្រួល​ចូលប្រើ​មុខងារ​ដែលអ្នក​ស្គាល់ ពេញចិត្ត និង​ជឿទុកចិត្ត​ដោយ​កំណត់ João Browser ជា​កម្មវិធីរុករកតាមអ៊ីនធឺណិតលំនាំដើម​របស់អ្នក។</translation>
<translation id="3344301749774719950">ផ្លូវ​កាត់ João Browser</translation>
<translation id="8395825163097750991">João Browser បានទប់ស្កាត់​ការទាញយកនេះ ដោយសារ​ឯកសារនេះ​មិនត្រូវបាន​ទាញយក​ជាទូទៅទេ ហើយវាអាច​បង្កគ្រោះថ្នាក់</translation>
<translation id="7683737657427846440">តើអ្នកប្រាកដថាចង់លុបការតំឡើង João Browser ទេ?</translation>
<translation id="6375219077595103062">បញ្ចូល​ផ្លូវកាត់​ទៅកាន់​កម្មវិធីគ្រប់គ្រង​ពាក្យសម្ងាត់</translation>
<translation id="6388799252195623474">ជួយខ្ញុំ​ពាក់ព័ន្ធនឹង​ករណីនេះ</translation>
<translation id="6966523531135953867">ដើម្បី​បន្ត សូម​ចូលគណនី João Browser ជា <ph name="EMAIL" />។ ការធ្វើបែបនេះ​ធានាថា អ្នកគោរពតាម​គោលការណ៍​របស់ស្ថាប័ន​អ្នក។</translation>
<translation id="5146608242127807773">រូបសញ្ញា João Browser នៅក្នុង​អេក្រង់​កុំព្យូទ័រ។</translation>
<translation id="6361476216650509195">João Browser គឺជាកម្មវិធីរុករកអ៊ីនធឺណិត ដែលដំណើរការគេហទំព័រ និងកម្មវិធីបានយ៉ាងរហ័សបំផុត។ វាលឿន មានស្ថេរភាព និងងាយស្រួលប្រើ។ រុករកគេហទំព័រប្រកបដោយសុវត្ថិភាពជាមួយការពារពីមេរោគ និងការលួចឆ្មក់យកទិន្នន័យដែលភ្ជាប់នៅក្នុង João Browser។</translation>
<translation id="7864687914956920860">ដើម្បី​ប្រាកដថា​អ្នកអាចប្រើ និង​រក្សាទុក​ទិន្នន័យ João Browser នៅក្នុង​គណនី Google របស់អ្នក​បានជានិច្ច សូម​ផ្ទៀងផ្ទាត់​ថាជាអ្នក</translation>
<translation id="1160920197193662978">João Browser ដំណើរការ​លឿន​ជាងមុន ហើយ​មុខងារដែលប្រើ JavaScript គួរតែ​ដំណើរការ​ដូចដែលបាន​រចនាឡើង</translation>
<translation id="6436260184216827876">មិនអាចប្រើការស្វែងរករូបភាពបានទេ។ សូមព្យាយាមម្ដងទៀតនៅពេលក្រោយ។</translation>
<translation id="6442900851116057561">ចាប់ផ្តើម ChromiumOS ឡើងវិញ</translation>
<translation id="6443470774889161065">Chromium ផ្ទុកជាមុន​នូវទំព័រ​កាន់តែច្រើនទៀតដែល​អ្នក​ទំនង​ជា​ចូលមើល ដើម្បីឱ្យទំព័រ​ទាំង​នោះ​ផ្ទុក​កាន់តែ​លឿន​នៅ​ពេល​អ្នក​ចូលមើល</translation>
<translation id="3730564967922511625">ទាញយក João Browser នៅលើ​ទូរសព្ទ​របស់អ្នក​ដើម្បី​តាមដានតម្លៃ និង​ទទួលបាន​ការជូនដំណឹង នៅពេលដែល​មានការធ្លាក់ថ្លៃ​នៅលើ​គេហទំព័រ​ណាមួយ</translation>
<translation id="3753019081686930624">បិទ • João Browser មិនអាចផ្ទៀងផ្ទាត់ប្រភពរបស់កម្មវិធីបន្ថែម​នេះបានទេ</translation>
<translation id="5444641426058108434">សូមស្វាគមន៍​មកកាន់កម្រង​ព័ត៌មាន João Browser</translation>
<translation id="5103470775766355478">នៅពេល​អ្នកបើក João Browser នៅលើ <ph name="DEVICE_TYPE" /> របស់អ្នក​នៅលើកក្រោយ អ្នក​នឹងឃើញ​សារតម្រុយ​ដែលប្រាប់​ឱ្យប្រើ​ក្រុមផ្ទាំង។</translation>
<translation id="9087231386723579740">ដក​គណនី​ចេញពី João Browser</translation>
<translation id="4984395209542302039">វាក៏គ្រប់គ្រងអ្វីដែលត្រូវបានបង្ហាញនៅលើទំព័រដែរ នៅពេលអ្នកចាប់ផ្តើម João Browser។</translation>
<translation id="648319183876919572">ការរុករក​ដោយសុវត្ថិភាពបន្ថែម​ធ្វើបានកាន់តែច្រើនក្នុងការការពារអ្នកពី​ការទាញយក និងគេហទំព័រ​គ្រោះថ្នាក់</translation>
<translation id="1524792685704191751">លុបការតំឡើង João Browser</translation>
<translation id="6637504267182028286">ផ្លូវកាត់​បើក​នៅក្នុង João Browser</translation>
<translation id="1478247638436966279">ស្ថាប័ន​របស់អ្នក​បិទ João Browser នៅពេលដែល​មិនប្រើប្រាស់វា​រយៈពេល <ph name="TIMEOUT_DURATION" />។ ទិន្នន័យរុករក​ត្រូវបាន​លុប។ ទិន្នន័យ​នេះ​អាច​រួមមាន​ប្រវត្តិ ការ​បំពេញស្វ័យប្រវត្តិ និង​ការទាញ​យក។</translation>
<translation id="1311233187253046133">កម្រងព័ត៌មាននីមួយៗមានព័ត៌មាន João Browser របស់វាផ្ទាល់ដូចជា ចំណាំ ប្រវត្តិ ពាក្យ​សម្ងាត់ និងអ្វីៗជាច្រើនទៀត</translation>
<translation id="6556755379298048869">ស្វែងរកដោយប្រើផ្លូវកាត់​ក្ដារ​ចុច។</translation>
<translation id="6563921047760808519">ស្វែងយល់​បន្ថែម​អំពី<ph name="BEGIN_LINK" />របៀបដែល Chromium រក្សាទិន្នន័យ​របស់អ្នក​ជាលក្ខណៈ​ឯកជន<ph name="END_LINK" /></translation>
<translation id="1643078533228697915">ការផ្លាស់ប្ដូរ​ចំពោះ​ការកំណត់នេះ​នឹង​ត្រូវបាន​អនុវត្ត​បន្ទាប់ពី João Browser ចាប់ផ្ដើម​ឡើងវិញ។</translation>
<translation id="1918630514771863338">គ្រប់គ្រង​កម្មវិធីបន្ថែម​របស់អ្នក​ដោយ​ចុច "កម្មវិធីបន្ថែម" នៅក្នុង​ម៉ឺនុយ​ចម្បង​របស់ João Browser។</translation>
<translation id="4229328298978407243">អ្នកអាចប្ដូរ ដើម្បីមើល​ពាក្យសម្ងាត់​ពីកម្រងព័ត៌មាន João Browser ផ្សេងទៀត</translation>
<translation id="7717252965531997879">ប្រើកម្មវិធី João Browser ដើម្បីយកឧបករណ៍ AI ល្អបំផុតតាមខ្លួនពេលធ្វើដំណើរ</translation>
<translation id="6570579332384693436">ដើម្បី​កែ​កំហុសអក្ខរាវិរុទ្ធ​, Chromium ផ្ញើ​អក្សរ​ដែលអ្នក​វាយបញ្ចូល​នៅក្នុង​កន្លែង​បញ្ចូលអក្សរ​ទៅ Google</translation>
<translation id="5374627817618267090">ចូលទៅ​កាន់ការ​កំណត់​ការជូន​ដំណឹង João Browser</translation>
<translation id="6600016381025017075">ស្វែងរកអ្វីមួយនៅលើទំព័រនេះ</translation>
<translation id="264335610358256197">ការផ្លាស់ប្តូររបស់អ្នកនឹងមានប្រសិទ្ធភាពនៅពេលដែលបើកដំណើរការ João Browser ឡើងវិញពេលក្រោយ។</translation>
<translation id="2657584510687441826">ឥឡូវនេះ João Browser ចាប់ផ្ដើម នៅពេល Windows ចាប់ផ្ដើម ដូច្នេះអ្នកអាចចាប់ផ្ដើមរុករកភ្លាមៗ។ អ្នកអាចបិទលក្ខណៈនេះ​បាននៅក្នុងការកំណត់។</translation>
<translation id="5482413402708094860">បន្តពី​ចំណុច​ដែលអ្នក​បានឈប់៖ João Browser បានស្ដារ​ផ្ទាំង​របស់អ្នក​ពីវគ្គ​ចុងក្រោយ​របស់អ្នក។ អ្នកអាច​បិទមុខងារនេះ​បាននៅក្នុង</translation>
<translation id="5022765692226673603">João Browser ត្រូវការ​ការអនុញ្ញាត​កាមេរ៉ា ដើម្បីបង្កើត​ផែនទី 3D នៃមជ្ឈដ្ឋានជុំវិញ​របស់អ្នក</translation>
<translation id="6669284030132180248">ប្រសិនបើអ្នកក៏រក្សាទុកចំណាំរបស់អ្នកនៅក្នុងគណនី Google របស់អ្នក នោះអ្នកអាចតាមដានតម្លៃផលិតផលនៅក្នុង Chromium និងទទួលបានការជូនដំណឹងនៅពេលមានការធ្លាក់ថ្លៃ</translation>
<translation id="6676384891291319759">ចូលប្រើអ៊ីនធឺណិត</translation>
<translation id="668175097507315160">ChromiumOS មិនអាចធ្វើ​សមកាលកម្មទិន្នន័យរបស់អ្នកបានទេ ដោយសារមានបញ្ហាក្នុងការចូលគណនី។</translation>
<translation id="3982573751008180181">ដក​ទិន្នន័យ​កម្មវិធីនេះ​ចេញពី João Browser</translation>
<translation id="5613723096388999601">João Browser ត្រូវការ​ការអនុញ្ញាត​មីក្រូហ្វូន​សម្រាប់​គេហទំព័រនេះ</translation>
<translation id="6712881677154121168">បញ្ហា​ក្នុងការទាញយក៖ <ph name="DOWNLOAD_ERROR" />។</translation>
<translation id="9190188975825967506">ទម្រង់របស់អ្នកមិនអាចត្រូវបានប្រើទេ ពីព្រោះវាមកពីកំណែ João Browser ថ្មីជាងនេះ។

លក្ខណៈពិសេសមួយចំនួនអាចប្រហែលជាមិនមានទេ។.សូមបញ្ជាក់ពីថតឯកសារទម្រង់ផ្សេងទៀត ឬប្រើកំណែ João Browser ថ្មីជាងនេះ។</translation>
<translation id="6729124504294600478">ដើម្បីទទួលបានការកំណត់​ឱ្យមានលក្ខណៈផ្ទាល់ខ្លួន និងមុខងារផ្សេងទៀត សូមរួមបញ្ចូល Chromium នៅក្នុងសកម្មភាពកម្មវិធី និងគេហទំព័រ និងសេវាកម្ម Google ដែលបានភ្ជាប់</translation>
<translation id="6957684879859415418">João Browser ត្រូវបានដំឡើងរួចហើយសម្រាប់អ្នកប្រើទាំងអស់នៅលើកុំព្យូទ័ររបស់អ្នក។</translation>
<translation id="4411262692912917677">ដើម្បី​ទទួលបាន​ចំណាំ​របស់អ្នក និង​អ្វីៗជាច្រើនទៀត​នៅលើ​ឧបករណ៍​ទាំងអស់​របស់អ្នក សូម​ចូលគណនី João Browser។ ចំណាំ​នេះនឹង​ត្រូវបាន​រក្សាទុក​នៅក្នុង​គណនី Google របស់អ្នក បន្ទាប់ពី​អ្នកចូល​គណនី។</translation>
<translation id="6064901610880747710">បង្កើន​ល្បឿន​គេហទំព័រ​ដោយប្រើ​ម៉ាស៊ីន V8 របស់ João Browser ប៉ុន្តែ​ធ្វើឱ្យ João Browser មិនសូវធន់នឹង​ការវាយប្រហារ​បន្តិច។ ការកំណត់​នេះ​ត្រូវ​បានបើក។</translation>
<translation id="4530735110472079436">{count,plural, =1{ទិន្នន័យ João Browser មួយចំនួន​របស់អ្នក​មិនទាន់​ត្រូវបាន​រក្សាទុក​នៅក្នុង​គណនី Google របស់អ្នក​ទេ។ សូម​សាកល្បង​រង់ចាំ​បន្តិច មុនពេល​ចេញពី​គណនី។ ប្រសិនបើអ្នក​ចេញពីគណនី​ឥឡូវនេះ ទិន្នន័យនេះ (ធាតុ 1) នឹងត្រូវបាន​លុប។}other{ទិន្នន័យ João Browser មួយចំនួន​របស់អ្នក​មិនទាន់​ត្រូវបាន​រក្សាទុក​នៅក្នុង​គណនី Google របស់អ្នក​ទេ។ សូម​សាកល្បង​រង់ចាំ​បន្តិច មុនពេល​ចេញពី​គណនី។ ប្រសិនបើអ្នក​ចេញពីគណនី​ឥឡូវនេះ (ធាតុ {count}) នឹងត្រូវបាន​លុប។}}</translation>
<translation id="9176853308971176490">João Browser ណែនាំឱ្យស្កេនឯកសារនេះ ដោយសារវាអាចបង្កគ្រោះថ្នាក់។</translation>
<translation id="6779406956731413166">ChromiumOS អាចបង្កើតឡើងដោយ<ph name="BEGIN_LINK_CROS_OSS" />កម្មវិធីកូដ​ចំហ<ph name="END_LINK_CROS_OSS" />បន្ថែម។</translation>
