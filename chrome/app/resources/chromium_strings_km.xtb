<translation id="6877155553248388166">ជ្រុង​ខាងក្រោម​ផ្នែក​ខាងស្ដាំ​នៃ​តំបន់​ស្វែងរក៖ ស្ដាំ <ph name="RIGHT" />%, ក្រោម <ph name="BOTTOM" />%</translation>
