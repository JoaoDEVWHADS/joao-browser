<translation id="5768371961535086509">Chromium សម្អាតអង្គចងចាំ​ពីផ្ទាំងដែលអសកម្ម។ ការធ្វើបែបនេះ​ផ្ដល់​ធនធានកុំព្យូទ័រ​បន្ថែម​ដល់​ផ្ទាំង​ដែលសកម្ម និងកម្មវិធីផ្សេងទៀត ព្រមទាំង​រក្សាឱ្យ Chromium មានល្បឿនលឿន។ ផ្ទាំង​ដែលអសកម្ម​របស់អ្នក​ប្រែជា​សកម្ម​ឡើងវិញដោយស្វ័យប្រវត្តិ នៅពេលអ្នកត្រឡប់ទៅផ្ទាំងទាំងនោះវិញ។ <ph name="BEGIN_LINK" />ស្វែងយល់​បន្ថែម​អំពី​មុខងារសន្សំសំចៃអង្គចងចាំ<ph name="END_LINK" /></translation>
<translation id="8866372822266732235">ប្រសិនបើអ្នក​ភ្លេចឃ្លាសម្ងាត់​របស់អ្នក ឬ​ចង់ប្ដូរ​ការកំណត់​នេះ សូម<ph name="SETTINGS_LINK" />ទិន្នន័យ João Browser នៅក្នុង​គណនី​របស់អ្នក</translation>
<translation id="2106070764285625641">គ្រប់គ្រង និង​ប្ដូរ João Browser តាមបំណង។ កំណត់ João Browser ជា​កម្មវិធីរុករកតាមអ៊ីនធឺណិតលំនាំដើម​របស់អ្នក។</translation>
<translation id="9077878413488413377">បន្តធ្វើ​សមកាលកម្ម​ពាក្យសម្ងាត់ ចំណាំ និង​ប្រវត្តិ​របស់អ្នក​បានយ៉ាងល្អ​ឥតខ្ចោះ​នៅលើ​ឧបករណ៍​នានា​ដោយកំណត់ João Browser ជា​កម្មវិធីរុករក​តាមអ៊ីនធឺណិត​លំនាំដើម​របស់អ្នក។</translation>
<translation id="5809516625706423866">មិនអាចភ្ជាប់ទៅអ៊ីនធឺណិតបានទេ។ មិន​អនុញ្ញាត HTTP 401 ទេ។ សូម​ពិនិត្យមើល​ការកំណត់​រចនាសម្ព័ន្ធ​ប្រូកស៊ី​របស់អ្នក។</translation>
<translation id="614221876503883218">បង្កើន​ល្បឿន​គេហទំព័រ​ដោយប្រើ​ម៉ាស៊ីន V8 របស់ João Browser ប៉ុន្តែ​ធ្វើឱ្យ João Browser មិនសូវធន់នឹង​ការវាយប្រហារ​បន្តិច។ ការកំណត់​នេះត្រូវបាន​បិទ។</translation>
