<!DOCTYPE translationbundle>
<translationbundle lang="sl">
<translation id="1026101648481255140">Nadaljuj namestitev</translation>
<translation id="1029669172902658969">Znova zaženite, če želite posodobiti &amp;Chromium OS</translation>
<translation id="4711726241445951349">João Browser priporoča, da pregledate to razširitev</translation>
<translation id="1042552502243217427">Ko spletno mesto zahteva zasebno vnaprejšnje nalaganje povezav na svoji strani, Chromium uporabi Googlove strežnike. S tem je vaša identiteta skrita pred vnaprej naloženim mestom, vendar Google izve, katera spletna mesta se vnaprej nalagajo.</translation>
<translation id="1051793555070215510">Izpolnite to enominutno anketo in nam pomagajte izboljšati anonimni način.</translation>
<translation id="1065672644894730302">Nastavitev ni mogoče prebrati.

Nekatere funkcije morda niso na voljo in spremembe nastavitev ne bodo shranjene.</translation>
<translation id="3937976866851867994">Tvoj starš je izklopil »Dovoljenja za spletna mesta, aplikacije in razširitve« za João Browser</translation>
<translation id="8626021334348319355">Če želite iskati po določeni funkciji ali razširitvi João Browsera, v naslovni vrstici vnesite ustrezno bližnjico in nato izbrano tipko na tipkovnici</translation>
<translation id="9157778882771986870">João Browser želi izvoziti gesla. Če želite omogočiti to, vnesite geslo za Windows.</translation>
<translation id="112640046208448578">Določite stvari ali mesta in kopirajte ali prevedite besedilo. Če uporabljate slikovno iskanje, se posnetek zaslona strani pošlje strežniku. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium je privzeti brskalnik</translation>
<translation id="1131805035311359397">Če želite preveriti, ali so gesla varna pred podatkovnimi kršitvami in drugimi varnostnimi težavami, <ph name="BEGIN_LINK" />se prijavite v Chromium<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">Kliknite João Browserov meni</translation>
<translation id="1157985233335035034">Nedavni jeziki</translation>
<translation id="1184145431117212167">Namestitev ni uspela, ker vaša različica sistema Windows ni podprta.</translation>
<translation id="1185134272377778587">O Chromiumu</translation>
<translation id="667420476518265356">Prejemanje opozoril o spremljanju cen s João Browserom v telefonu</translation>
<translation id="1203500561924088507">Hvala, ker ste se odločili za namestitev. Preden uporabite <ph name="BUNDLE_NAME" />, morate znova zagnati brskalnik.</translation>
<translation id="1232234696885483911">Ko odprete slikovno iskanje, se naslov strani, URL in vsebina, vključno z datotekami PDF, samodejno pošljejo v strežnik. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">Ko ste prijavljeni, lahko v João Browseru uporabljate svoja gesla in drugo iz računa Google. Če želite to spremeniti, odprite »Vaš račun v João Browseru«.</translation>
<translation id="4866003137980530528">Prikaz Geminija v João Browseru v menijski vrstici Maca</translation>
<translation id="2526294198551578217">Če želite v Geminiju v João Browseru izbrati del zaslona, uporabite bližnjične tipke.</translation>
<translation id="7068536367561625920">Ko je bil ta zavihek neaktiven, je bil pomnilnik sproščen, da je bil João Browser še naprej hiter. Izberete lahko, da to spletno mesto ni nikoli neaktivno.</translation>
<translation id="3669854427836618143">João Browser je blokiral ta prenos, ker je datoteka nevarna</translation>
<translation id="126567311906253476">Pri prijavi v Googlove storitve, kot je Gmail ali YouTube, z računom <ph name="USER_EMAIL" /> se lahko z istim računom samodejno prijavite v Chromium</translation>
<translation id="8094399825947986050">Prenesite João Browser v telefon</translation>
<translation id="1290883685122687410">Napaka pri nastavitvi: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">Nastavitev novega profila v João Browseru</translation>
<translation id="7591029065989504977">Preizkusite z Geminijem v João Browseru</translation>
<translation id="8408989583029959522">João Browser potrebuje dostop do Bluetootha za raziskovanje&#32;
 naprav Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">Prijava v João Browser v telefonu</translation>
<translation id="1330562121671411446">Zaznaj jezik</translation>
<translation id="6026568602942276348">Iz João Browsera izbriši tudi podatke (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Pripeto. Do slikovnega iskanja lahko znova dostopate z novim gumbom v orodni vrstici.</translation>
<translation id="1356661055722410047">Novo! Prevedete lahko besedilo in slike na zaslonu.</translation>
<translation id="1383876407941801731">Išči</translation>
<translation id="5807085300679014096">Uporabite aplikacijo João Browser za brskanje na poti</translation>
<translation id="141901961143729572">Povejte svoje mnenje</translation>
<translation id="3736947618013031173">Če želite deliti okno, v sistemskih nastavitvah omogočite snemanje zaslona za João Browser.</translation>
<translation id="1478370723027452770">Pomoč za Chrome for Testing</translation>
<translation id="1497802159252041924">Napaka pri namestitvi: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Ta stran je zaščitena</translation>
<translation id="4379865404970367448">Deljenje zavihka v João Browseru</translation>
<translation id="4436275659297289591">Prijava v João Browser</translation>
<translation id="1547469039832541117">Konča označeno opravilo.</translation>
<translation id="449712764049695153">Pripni João Browser</translation>
<translation id="1574377791422810894">Varnostna orodja v Chromiumu</translation>
<translation id="5480232403718129394">João Browser želi izbrisati podatke upravitelja gesel. Če želite to omogočiti, vnesite geslo za Windows.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{Skrbnik zahteva, da za uveljavitev te posodobitve znova zaženete João Browser.}=1{Skrbnik zahteva, da za uveljavitev te posodobitve znova zaženete João Browser. Anonimno okno se ne bo znova odprlo.}one{Skrbnik zahteva, da za uveljavitev te posodobitve znova zaženete João Browser. # anonimno okno se ne bo znova odprlo.}two{Skrbnik zahteva, da za uveljavitev te posodobitve znova zaženete João Browser. # anonimni okni se ne bosta znova odprli.}few{Skrbnik zahteva, da za uveljavitev te posodobitve znova zaženete João Browser. # anonimna okna se ne bodo znova odprla.}other{Skrbnik zahteva, da za uveljavitev te posodobitve znova zaženete João Browser. # anonimnih oken se ne bo znova odprlo.}}</translation>
<translation id="980976428162070137">Z aplikacijo João Browser v telefonu izkoristite najboljše, kar ponuja Google</translation>
<translation id="1625909126243026060">Oglejte si ključne kontrolnike zasebnosti in varnosti v Chromiumu.</translation>
<translation id="1640672724030957280">Prenos ...</translation>
<translation id="1665602916345474427">Prijavljeni ste kot <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, naročnina. Odpri meni računa</translation>
<translation id="1708414395296835197">Chromium lahko uporabljate ob vsakem kliku povezav v sporočilih, dokumentih in drugih aplikacijah. Pripet bo tudi v opravilno vrstico.</translation>
<translation id="1709772298389099340">Zagotovi povečane pravice za brskalnik <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Tako boste lahko izbirali med razpoložljivimi napravami in v njih prikazali vsebino.</translation>
<translation id="6972087163510342335">João Browser bo kmalu izbrisal podatke brskanja</translation>
<translation id="1736443181683099871">Chromium bo poskusil nadgraditi pomikanje na HTTPS</translation>
<translation id="3879288383593333401">Podatki João Browsera so izbrisani</translation>
<translation id="656496276885630888">João Browser se bo znova zagnal čez toliko časa: <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Če HTTPS ni na voljo, Chromium uporabi povezavo, ki ni varna, ne da bi vas opozoril</translation>
<translation id="1226290419185955779">Naj se João Browser izvaja v ozadju</translation>
<translation id="4231366995273072370">Zaradi večje varnosti smo v João Browseru onemogočili nekatere razširitve, ki niso navedene v storitvi <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> in so bile morda dodane brez vaše vednosti.</translation>
<translation id="1822049153969905781">Kliknite <ph name="BEGIN_BOLD" />Da<ph name="END_BOLD" /> v obvestilu sistema Windows, če želite João Browser pripeti v opravilno vrstico za hitri dostop.</translation>
<translation id="1321831992638405531">Vnovična namestitev João Browsera</translation>
<translation id="3386967202064865436">João Browser poskuša <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="70054449700528483">Ko boste naslednjič odprli João Browser v napravi <ph name="DEVICE_TYPE" />, bo prikazan poziv za uporabo Googlovega upravitelja gesel.</translation>
<translation id="1838374766361614909">Čiščenje iskanja</translation>
<translation id="5807096362853316123">Če želite izbrisati podatke brskanja samo iz te naprave, v računu Google pa jih želite ohraniti, <ph name="BEGIN_LINK" />se odjavite iz João Browsera<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">Prenesite João Browser v telefon, da boste lahko na poti odpirali ali ustvarjali nove skupine zavihkov.</translation>
<translation id="185970820835152459">Upravljate lahko račune Google, v katere ste prijavljeni. Računi Google se uporabljajo za brskalnik Chromium, Trgovino Play, Gmail in drugo. Če želite dodati račun za nekoga drugega, na primer družinskega člana, v napravo <ph name="DEVICE_TYPE" /> dodajte novo osebo. <ph name="LINK_BEGIN" />Več o tem<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Iskanje s slikovnim iskanjem</translation>
<translation id="65457771685016683">Uporabnik <ph name="EXISTING_USER" /> je že prijavljen. Če želite ločiti brskanje, se v João Browseru prijavite v svoj profil kot <ph name="USER_EMAIL_ADDRESS" />. Dostopali boste lahko tudi do zaznamkov in drugega v <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Izbira besedila</translation>
<translation id="2634119629547215883">Prijavljate se z upravljanim računom in s tem njegovemu skrbniku omogočate nadzor vašega profila v João Browseru. Vaši podatki v João Browseru, kot so aplikacije, zaznamki, zgodovina, gesla in druge nastavitve, bodo postali trajno povezani z uporabnikom <ph name="USER_NAME" />. Te podatke boste lahko izbrisali na nadzorni plošči za Google Račune, vendar jih ne boste mogli povezati z drugim računom. Če želite, lahko ustvarite nov profil, da bodo obstoječi podatki v João Browseru ostali ločeni. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium varčuje z energijo baterije tako, da omeji dejavnost v ozadju in vizualne učinke, kot sta tekoče pomikanje in število sličic v sekundi pri videoposnetkih. <ph name="BEGIN_LINK" />Preberite več o varčevanju z energijo<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">João Browserova storitev za posodabljanje</translation>
<translation id="1911763535808217981">Če to izklopite, se lahko prijavite na Googlovih spletnih mestih, kot je Gmail, ne da bi se morali prijaviti v Chromium</translation>
<translation id="4037729269678342163">João Browser se ne odziva. Ga želite znova zagnati?</translation>
<translation id="7563750688920581112">Vaša organizacija (<ph name="MANAGER" />) zahteva, da se prijavite v João Browser</translation>
<translation id="193439633299369377">Če želite uveljaviti posodobitev, morate znova zagnati Chromium OS.</translation>
<translation id="7099143775283792684">João Browser je blokiral ta prenos, ker se vrsta datoteke ne prenaša pogosto in je morda nevarna</translation>
<translation id="1953553007165777902">Prenašanje … Še <ph name="MINUTE" /> min.</translation>
<translation id="1966382378801805537">Chromium ne more določiti ali nastaviti privzetega brskalnika</translation>
<translation id="197326043290947695">Brskajte pametneje s slikovnim iskanjem</translation>
<translation id="6185556991023272801">Preberite, zakaj João Browser blokira nekatere datoteke, odpre se na novem zavihku</translation>
<translation id="4053636705816895911">Poskrbi, da je programska oprema João Browsera posodobljena. Če je ta storitev onemogočena ali ustavljena, programska oprema João Browsera ne bo posodobljena, kar pomeni, da varnostnih ranljivosti, ki se lahko pojavijo, ni mogoče odpraviti in funkcije morda ne delujejo. Ta storitev se samodejno odstrani, če ni programske opreme João Browsera, ki bi jo uporabljala.</translation>
<translation id="2008474315282236005">S tem bo iz te naprave izbrisan 1 element. Če želite pozneje prenesti podatke, se v Chromium prijavite kot <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Namestitev ni uspela. Poskusite znova.</translation>
<translation id="2039417478970545937">Nastavitve.</translation>
<translation id="2049376729098081731">Izberite, ali želite, da je zaradi osebno bolj prilagojenih izkušenj v Googlovih storitvah vključena zgodovina v Chromiumu.</translation>
<translation id="6768767091114123654">Vgrajen je v João Browser, da vam pomaga ustvarjati, shranjevati in samodejno izpolnjevati močna gesla. Dodajte bližnjico za preprost dostop.</translation>
<translation id="3571664229232252557">Kliknite gumb za prilagajanje João Browsera na novem zavihku s povezavami, da bo João Browser videti drugače</translation>
<translation id="4273287215573278663">João Browser je blokiral ta prenos, ker je datoteka zavajajoča in v napravi morda izvaja nepričakovane spremembe</translation>
<translation id="9063967192437499581">Ko boste naslednjič odprli João Browser za iOS, bo prikazan poziv, da preizkusite funkcijo <ph name="FEATURE_NAME" />.</translation>
<translation id="8511569826706775962">Gesla in drugi podatki v João Browseru, ki ste jih shranili v računu Google, bodo odstranjeni iz te naprave. Če jih želite znova uporabljati v João Browseru, se znova prijavite.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{Organizacija samodejno izbriše podatke brskanja, če João Browsera ne uporabljate 1 minuto. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose. Zavihki bodo ostali odprti.}one{Organizacija samodejno izbriše podatke brskanja, če João Browsera ne uporabljate # minuto. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose. Zavihki bodo ostali odprti.}two{Organizacija samodejno izbriše podatke brskanja, če João Browsera ne uporabljate # minuti. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose. Zavihki bodo ostali odprti.}few{Organizacija samodejno izbriše podatke brskanja, če João Browsera ne uporabljate # minute. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose. Zavihki bodo ostali odprti.}other{Organizacija samodejno izbriše podatke brskanja, če João Browsera ne uporabljate # minut. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose. Zavihki bodo ostali odprti.}}</translation>
<translation id="2125838419757773031">Izberite območje zaslona za iskanje</translation>
<translation id="2126108037660393668">Napaka pri preverjanju prenesene datoteke.</translation>
<translation id="2135919691573380097">Prijava tega spletnega mesta</translation>
<translation id="2137162749895930932">Zapiranje zaslona za prevajanje</translation>
<translation id="1308845716497059117">João Browser je blokiral ta prenos, ker spletno mesto ne uporablja varne povezave in so v datoteko morda posegali</translation>
<translation id="2170098639895543546">Izberite kar koli na strani</translation>
<translation id="6705844023496387932">Prilagodi João Browser</translation>
<translation id="2174917724755363426">Namestitev še ni končana. Ali ste prepričani, da jo želite preklicati?</translation>
<translation id="7728290795259244895">João Browser – Prijava v omrežje – <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Napaka pri preverjanju posodobitev: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">Odstranitev računa iz João Browsera</translation>
<translation id="4648870374540039667">Uporabite aplikacijo João Browser in imejte najboljša orodja za nakupovanje vedno pri roki</translation>
<translation id="2106116820042118250">Ostanite varnejši na poti z izboljšanim varnim brskanjem v João Browseru za iOS</translation>
<translation id="2210682093923538346">Nevarno spletno mesto. Chromium je odstranil dovoljenje za obvestila.</translation>
<translation id="2236949375853147973">Moja dejavnost</translation>
<translation id="118764235932893741">Če želite dostopati do naslovov in drugega v vseh napravah, se prijavite v João Browser. Ta naslov bo po prijavi shranjen v računu Google.</translation>
<translation id="7254578863532089400">Če računalnik souporabljate z drugimi, lahko prijatelji in sorodniki ločeno brskajo ter nastavijo João Browser tako, kot ga želijo.</translation>
<translation id="22571759390241347">Veščine v Chromiumu</translation>
<translation id="2283803047247799269">Iščite po tem zavihku s slikovnim iskanjem</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{João Browser priporoča, da začasno zaustavite zavihek, ki upočasnjuje brskalnik}one{João Browser priporoča, da začasno zaustavite zavihke, ki upočasnjujejo brskalnik}two{João Browser priporoča, da začasno zaustavite zavihke, ki upočasnjujejo brskalnik}few{João Browser priporoča, da začasno zaustavite zavihke, ki upočasnjujejo brskalnik}other{João Browser priporoča, da začasno zaustavite zavihke, ki upočasnjujejo brskalnik}}</translation>
<translation id="2307973900865360088">Obdrži v vrstici Dock</translation>
<translation id="2313870531055795960">Preveri URL-je, tako da jih primerja s seznamom spletnih mest, ki niso varna, shranjenim v Chromiumu. Če vam spletno mesto poskusi ukrasti geslo ali če prenašate škodljivo datoteko, lahko Chromium prav tako pošlje URL-je, vključno z delčki vsebine strani, Varnemu brskanju.</translation>
<translation id="2356070529366658676">Vprašaj</translation>
<translation id="2359808026110333948">Naprej</translation>
<translation id="3800730051093461113">Razširitev »<ph name="EXTENSION_NAME" />« želi, da se prijavite v João Browser</translation>
<translation id="8758735062658446604">Onemogoči João Browser, ki se izvaja v ozadju za aplikacije</translation>
<translation id="2623595027619107207">Če želite to razširitev uporabljati kot <ph name="USER_EMAIL_ADDRESS" />, se prijavite v João Browser.</translation>
<translation id="2384373936468275798">Chromium OS ni mogel sinhronizirati podatkov, ker so podatki za prijavo v račun zastareli.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{Najmanj ena razširitev za João Browser je dostopala do 1 naprave HID}=1{Najmanj ena razširitev za João Browser dostopa do 1 naprave HID}one{Najmanj ena razširitev za João Browser dostopa do # naprave HID}two{Najmanj ena razširitev za João Browser dostopa do # naprav HID}few{Najmanj ena razširitev za João Browser dostopa do # naprav HID}other{Najmanj ena razširitev za João Browser dostopa do # naprav HID}}</translation>
<translation id="6254788431480237503">João Browser potrebuje dovoljenje za fotoaparat in mikrofon za to spletno mesto.</translation>
<translation id="2403703063067034158">Napaka pri zagonu: Trenutno se izvaja še en primer nastavitve. Poskusite znova pozneje.</translation>
<translation id="3028975423343897358">Povezave iz poljubne aplikacije odprite v João Browseru in poskrbite, da bo brskalnik dostopen v opravilni vrstici</translation>
<translation id="579079006139156831">Kliknite gumb za povzetek, če želite ta dokument deliti z Geminijem v João Browseru, da pridobite hiter pregled in zastavite dodatna vprašanja</translation>
<translation id="2440750600860946460">Z <ph name="BEGIN_LINK" />orodji iz Chromiuma<ph name="END_LINK" /> lahko varno brskate in imate nadzor</translation>
<translation id="7114471809991869757">Uporabnik <ph name="EXISTING_USER" /> je že prijavljen. Če želite ločiti brskanje, se v João Browseru prijavite v svoj profil kot <ph name="USER_EMAIL_ADDRESS" />. V vseh svojih napravah boste imeli na voljo tudi gesla in drugo.</translation>
<translation id="2451727308784734061">Z bližnjico lahko hitro odprete Upravitelja gesel. Bližnjico lahko premaknete na začetni zaslon računalnika ali v zaganjalnik aplikacij.</translation>
<translation id="2709136733469807397">João Browser se bo kmalu zaprl</translation>
<translation id="3652225684487279741">V João Browseru</translation>
<translation id="2485422356828889247">Odmeščanje</translation>
<translation id="2513154137948333830">Potreben je vnovičen zagon: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Izberite besedilo s slikovnim iskanjem</translation>
<translation id="1527474262707362156">João Browser poskuša zamenjati obstoječa gesla. Če želite to omogočiti, vnesite geslo za Windows.</translation>
<translation id="6480371226914552131">João Browser potrebuje za prenos datotek dostop do shrambe</translation>
<translation id="6318568902186985084">Pomoč za João Browser</translation>
<translation id="2575822587468774919">Izberite kar koli za iskanje s slikovnim iskanjem</translation>
<translation id="4557210258834653476">Če želite dostopati do gesel in drugega v vseh napravah, se prijavite v João Browser</translation>
<translation id="1148164459654218834">S telefonom optično preberite kodo QR, da prenesete João Browser, in se prijavite v račun Google.</translation>
<translation id="235892353478111963">Še naprej uporabljaj João Browser</translation>
<translation id="259935314519650377">Prenesenega namestitvenega programa ni bilo mogoče predpomniti. Napaka: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Sistem</translation>
<translation id="8471946631262724853">Vaša organizacija si lahko ogleda in upravlja podatke brskanja, na primer zaznamke, zgodovino in gesla. V drugih profilih v João Browseru si ne more ogledati podatkov brskanja.</translation>
<translation id="2870759219964376597">Potrdite, da ste to vi, če želite podatke iz João Browsera uporabljati in shranjevati v računu, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="2955972712254986678">{COUNT,plural, =0{Dodatna zaščita zahteva, da za uveljavitev posodobitve znova zaženete João Browser}=1{Dodatna zaščita zahteva, da za uveljavitev posodobitve znova zaženete João Browser. Anonimno okno se ne bo znova odprlo.}one{Dodatna zaščita zahteva, da za uveljavitev posodobitve znova zaženete João Browser. # anonimno okno se ne bo znova odprlo.}two{Dodatna zaščita zahteva, da za uveljavitev posodobitve znova zaženete João Browser. # anonimni okni se ne bosta znova odprli.}few{Dodatna zaščita zahteva, da za uveljavitev posodobitve znova zaženete João Browser. # anonimna okna se ne bodo znova odprla.}other{Dodatna zaščita zahteva, da za uveljavitev posodobitve znova zaženete João Browser. # anonimnih oken se ne bo znova odprlo.}}</translation>
<translation id="8949462882238006192">Zagon João Browsera</translation>
<translation id="4224214204752803768">Napaka v operacijskem sistemu med namestitvijo. Znova prenesite João Browser.</translation>
<translation id="3141414135710372892">Če napravo souporabljate z drugimi, lahko prijatelji in sorodniki ločeno brskajo ter nastavijo João Browser tako, kot ga želijo.</translation>
<translation id="8838607803339100223">Preprost dostop za uporabo Geminija v João Browseru v napravi, tudi če je João Browser pomanjšan.</translation>
<translation id="1679364578146271696">Zavihek v João Browseru</translation>
<translation id="2718390899429598676">Zaradi večje varnosti bo Chromium šifriral vaše podatke.</translation>
<translation id="1874696651662237927">Če želite račun Google odstraniti iz João Browsera, se odjavite</translation>
<translation id="6850669719663104304">Če želite dostopati do gesel, zaznamkov in drugega v vseh napravah, se prijavite v João Browser</translation>
<translation id="2738871930057338499">Internetne povezave ni mogoče vzpostaviti. Koda napake HTTP je »403 Forbidden«. Preverite konfiguracijo strežnika proxy configuration.</translation>
<translation id="2753623023919742414">Kliknite, če želite iskati</translation>
<translation id="4193420110872590792">Nastavite João Browser kot privzeti pregledovalnik PDF-jev</translation>
<translation id="6614401181366354261">Ta razširitev vsebuje zlonamerno programsko opremo in ni varna. Odstranite jo iz João Browsera, da si ne bo mogla več ogledati vaših podatkov na obiskanih spletnih mestih, vključno z osebnimi podatki, in jih spreminjati.</translation>
<translation id="2799223571221894425">Vnovičen zagon</translation>
<translation id="6299858290790311689">Vaš João Browser</translation>
<translation id="2816462166102338036">Iščite ta videoposnetek s slikovnim iskanjem</translation>
<translation id="5896458971800337862">Z aplikacijo João Browser v sistemu iOS odkrivajte izdelke s fotoaparatom, spremljajte znižanja cen in več tudi na poti.</translation>
<translation id="2841525013647267359">Prevedi iz jezika</translation>
<translation id="2846251086934905009">Napaka pri namestitvi: Namestitveni program se ni dokončal. Namestitev je bila prekinjena.</translation>
<translation id="4357241592510111611">Odstranitev iz João Browsera ...</translation>
<translation id="2850691299438350830">Skrbi za vašo varnost v Chromiumu in ga je mogoče uporabiti za okrepitev varnosti v drugih Googlovih aplikacijah, ko ste prijavljeni.</translation>
<translation id="2885378588091291677">Upravitelj opravil</translation>
<translation id="8887040619780090085">O &amp;João Browseru</translation>
<translation id="2915996080311180594">Znova zaženi pozneje</translation>
<translation id="6619708652934279502">Podatki so šifrirani z vašim geslom. Vnesite ga, če želite podatke iz João Browsera uporabljati in shranjevati v računu Google.</translation>
<translation id="2945997411976714835">Napaka pri namestitvi: Proces namestitvenega programa se ni zagnal.</translation>
<translation id="4566114009566397386">Hitreje se prijavite na spletnih mestih z uporabo shranjenih gesel za João Browser v sistemu iOS</translation>
<translation id="562175540137901632">João Browser upravlja vaša organizacija</translation>
<translation id="2977470724722393594">Chromium je posodobljen</translation>
<translation id="2977506796191543575">Če vam spletno mesto poskusi ukrasti geslo ali če prenašate škodljivo datoteko, lahko Chromium prav tako pošlje URL-je, vključno z delčki vsebine strani, Varnemu brskanju.</translation>
<translation id="1776205510657237623">Zaradi večje varnosti v spletu s starševimi izbirami se prijavi v João Browser</translation>
<translation id="3003694935412297923">Vsa opravila</translation>
<translation id="3374694374267805392">{count,plural, =1{João Browser mora preveriti vašo identiteto, preden bo mogoče nekatere podatke shraniti v račun Google in jih uporabiti v vseh vaših napravah. Če se odjavite zdaj, bodo ti podatki (1 element) izbrisani.}one{João Browser mora preveriti vašo identiteto, preden bo mogoče nekatere podatke shraniti v račun Google in jih uporabiti v vseh vaših napravah. Če se odjavite zdaj, bodo ti podatki ({count} element) izbrisani.}two{João Browser mora preveriti vašo identiteto, preden bo mogoče nekatere podatke shraniti v račun Google in jih uporabiti v vseh vaših napravah. Če se odjavite zdaj, bodo ti podatki ({count} elementa) izbrisani.}few{João Browser mora preveriti vašo identiteto, preden bo mogoče nekatere podatke shraniti v račun Google in jih uporabiti v vseh vaših napravah. Če se odjavite zdaj, bodo ti podatki ({count} elementi) izbrisani.}other{João Browser mora preveriti vašo identiteto, preden bo mogoče nekatere podatke shraniti v račun Google in jih uporabiti v vseh vaših napravah. Če se odjavite zdaj, bodo ti podatki ({count} elementov) izbrisani.}}</translation>
<translation id="4915792193596835645">Odprite <ph name="URL" /> na novem zavihku v João Browseru.</translation>
<translation id="302551344979399011">Inovacije umetne inteligence, kot so veščine, se shranijo v račun Google in upravljajo ločeno od sinhronizacije za Chromium</translation>
<translation id="8367114375553489372">Dodajanje v João Browser ...</translation>
<translation id="3038232873781883849">Čakanje na namestitev …</translation>
<translation id="3045032126857188731">Jezik prevoda: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Zapiranje pogovornega okna za povratne informacije</translation>
<translation id="6168172692486433600">Drugi profili v João Browseru</translation>
<translation id="884929993636327">Razširitve so dodatki, s katerimi lahko prilagodite João Browser. Razširitve vam pomagajo, da João Browser prilagodite svojim potrebam, od organiziranja do poenostavljanja vsakodnevnih opravil.</translation>
<translation id="1525897524206034002">Pomagajte izboljšati João Browser – Googlu pošiljajte poročila o zrušitvah in ta dokument: <ph name="UMA_LINK" />.</translation>
<translation id="2766971658743453990">Uporabite aplikacijo João Browser, da boste z Googlom varni tudi na poti</translation>
<translation id="4387884830246074210">{NUM_DEVICES,plural, =0{Najmanj ena razširitev za João Browser je dostopala do 1 naprave USB}=1{Najmanj ena razširitev za João Browser dostopa do 1 naprave USB}one{Najmanj ena razširitev za João Browser dostopa do # naprave USB}two{Najmanj ena razširitev za João Browser dostopa do # naprav USB}few{Najmanj ena razširitev za João Browser dostopa do # naprav USB}other{Najmanj ena razširitev za João Browser dostopa do # naprav USB}}</translation>
<translation id="3413144813287436446">Zgodovina v João Browseru</translation>
<translation id="9192419056064225629">Namestitvenemu programu ni uspelo razširiti arhiva. Znova prenesite João Browser.</translation>
<translation id="310459126943037700">Opravil ni bilo mogoče končati.</translation>
<translation id="3104828284009500087">Iščite kar koli na strani</translation>
<translation id="3508468328135806512">Poskrbite, da so gesla, zaznamki in zgodovina popolnoma sinhronizirani v vseh napravah. Posodobite privzeti brskalnik na João Browser in preprosto dostopajte do funkcij, ki jih poznate in so vam všeč.</translation>
<translation id="3216151988142306917">João Browser uporablja vaš mikrofon.</translation>
<translation id="3130333203120345554">Novo iskanje</translation>
<translation id="3137969841538672700">Povlecite, če želite iskati</translation>
<translation id="7493177208577109722">Ta zavihek uporablja dodatna sredstva. Če želite izboljšati učinkovitost delovanja, pustite João Browseru, da ga spremeni v neaktivnega.</translation>
<translation id="7239354789967255675">Če želite deliti zaslon, v sistemskih nastavitvah omogočite snemanje zaslona za João Browser.</translation>
<translation id="4955872590603594814">Znova zaženite João Browser</translation>
<translation id="3161522574479303604">Vsi jeziki</translation>
<translation id="4697739132113629685">Odpri povezavo v João Browserovem oknu brez bele&amp;ženja zgodovine</translation>
<translation id="1629247860984475766">Prilagajanje novega profila v João Browseru</translation>
<translation id="1905008150929775692">Z načinom umetne inteligence lahko klepetate naprej, ne da bi preklopili zavihke. Če želite začeti, se prijavite v João Browser. V vseh svojih napravah boste imeli na voljo tudi gesla in drugo.</translation>
<translation id="4232381420311815141">Če želite račun Google odstraniti iz João Browsera, se na strani z nastavitvami odjavite iz João Browsera</translation>
<translation id="3234316605225071811">Chromium vas lahko pozneje vpraša, ali želite uporabiti shranjene podatke za samodejno izpolnjevanje obrazcev</translation>
<translation id="6676749542734993844">João Browser ne more brati svojega imenika s podatki ali pisati vanj:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">Vzemite svoja priljubljena Googlova orodja z umetno inteligenco na pot z aplikacijo João Browser v iOS-u.</translation>
<translation id="3286538390144397061">Znova zaženi</translation>
<translation id="532528773927600103">Manjkajo ključi za Google API. Nekatere funkcije João Browsera bodo onemogočene.</translation>
<translation id="3296368748942286671">Nadaljuj izvajanje aplikacij v ozadju, ko je Chromium zaprt</translation>
<translation id="3313189106987092621">Chromium vas bo opozoril pred nalaganjem katerega koli spletnega mesta prek povezave, ki ni varna</translation>
<translation id="8095477191923518137">Ko zaprete vsa João Browserova okna, boste odjavljeni z večine spletnih mest z izjemo računa Google, če ste prijavljeni v João Browser. Če želite, da si vas spletna mesta zapomnijo, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">zgornji desni kot območja za iskanje: desno <ph name="RIGHT" /> %, zgoraj <ph name="TOP" /> %</translation>
<translation id="3366305173356742781">Podatki v Chromiumu v vašem računu</translation>
<translation id="3234882977104294240">Uporabljajte gesla s João Browserom v telefonu</translation>
<translation id="3387527074123400161">Chromium OS</translation>
<translation id="2974199599420431595">Želite preklopiti na obstoječi profil v João Browseru?</translation>
<translation id="3412460710772753638">V Upravitelju gesel v tej napravi</translation>
<translation id="3438772217992559640">Iščite po tem zavihku s slikovnim iskanjem</translation>
<translation id="8318147705317768982">Razširite izboljšano varno brskanje s João Browserom v telefonu</translation>
<translation id="347392028839310978">João Browser prilagajamo vam …</translation>
<translation id="3474745554856756813">S tem bo iz te naprave izbrisanih več elementov (<ph name="ITEMS_COUNT" />). Če želite pozneje prenesti podatke, se v Chromium prijavite kot <ph name="USER_EMAIL" />.</translation>
<translation id="5805833167703404998">Bližnjica <ph name="SHORTCUT" /> omogoča preklop med profili v João Browseru</translation>
<translation id="1835124883585653877">Zaprite vsa okna João Browsera in poskusite znova.</translation>
<translation id="7106246566966568195">Če želite deliti okno, v sistemskih nastavitvah omogočite snemanje zaslona za João Browser.</translation>
<translation id="6017005873246021363">Uporabnik <ph name="EXISTING_USER" /> je že prijavljen.  Če želite ločiti brskanje, se v João Browseru prijavite v svoj profil kot <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="1146681170626381319">Koda QR za prenos brskalnika João Browser v mobilnih napravah</translation>
<translation id="354621070532799440">Opomnik: Googlove najboljše varnostne funkcije v vašem žepu</translation>
<translation id="2488701737291439763">Če želite deliti zaslon, v sistemskih nastavitvah omogočite snemanje zaslona za João Browser.</translation>
<translation id="3588112919289558122">Izboljšana zaščita izklopi optimizacijo JavaScripta za spletna mesta, ki jih Chromium ne prepozna</translation>
<translation id="3597003331831379823">Nastavitve s povečanimi pravicami ni bilo mogoče izvesti. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">Prijava v João Browser</translation>
<translation id="5985252758124395804">Podatki brskanja te osebe bodo izbrisani iz te naprave. Če želite podatke obnoviti, se prijavite v João Browser kot <ph name="USER_EMAIL" />.</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{Na voljo je nova posodobitev za João Browser, ki bo nameščena, takoj ko ga znova zaženete.}=1{Na voljo je nova posodobitev za João Browser, ki bo nameščena, takoj ko ga znova zaženete. Anonimno okno se ne bo znova odprlo.}one{Na voljo je nova posodobitev za João Browser, ki bo nameščena, takoj ko ga znova zaženete. # anonimno okno se ne bo znova odprlo.}two{Na voljo je nova posodobitev za João Browser, ki bo nameščena, takoj ko ga znova zaženete. # anonimni okni se ne bosta znova odprli.}few{Na voljo je nova posodobitev za João Browser, ki bo nameščena, takoj ko ga znova zaženete. # anonimna okna se ne bodo znova odprla.}other{Na voljo je nova posodobitev za João Browser, ki bo nameščena, takoj ko ga znova zaženete. # anonimnih oken se ne bo znova odprlo.}}</translation>
<translation id="3667616615096815454">Namestitev ni mogoča, ker strežnik ne pozna aplikacije.</translation>
<translation id="3675854891107786059">Za šifriranje vseh podatkov v Chromiumu v računu Google uporabite <ph name="BEGIN_LINK" />svoje geslo<ph name="END_LINK" />. Plačilna sredstva in naslovi iz Googla Pay ne bodo šifrirani. Zgodovina brskanja v Chromiumu se ne bo sinhronizirala.</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{Skrbnik prosi, da za uveljavitev te posodobitve znova zaženete João Browser.}=1{Skrbnik prosi, da za uveljavitev te posodobitve znova zaženete João Browser. Anonimno okno se ne bo znova odprlo.}one{Skrbnik prosi, da za uveljavitev te posodobitve znova zaženete João Browser. # anonimno okno se ne bo znova odprlo.}two{Skrbnik prosi, da za uveljavitev te posodobitve znova zaženete João Browser. # anonimni okni se ne bosta znova odprli.}few{Skrbnik prosi, da za uveljavitev te posodobitve znova zaženete João Browser. # anonimna okna se ne bodo znova odprla.}other{Skrbnik prosi, da za uveljavitev te posodobitve znova zaženete João Browser. # anonimnih oken se ne bo znova odprlo.}}</translation>
<translation id="4134769722455445399">Odpiranje povezave na novem &amp;zavihku v João Browseru</translation>
<translation id="3728124580182886854">Povežite Chromium in druge Googlove storitve za osebno prilagajanje in druge namene</translation>
<translation id="3729187154190517324">Poglobite iskanje tako, da dodate več zavihkov, datotek in orodij z gumbom »Dodajte zavihek in drugo«.</translation>
<translation id="655691042235349825">Upravljanje profilov v João Browseru</translation>
<translation id="8494798931804571569">Preberite, zakaj João Browser blokira nekatere prenose</translation>
<translation id="379589255253486813">Chromium vas bo obvestil, če boste morali kaj pregledati</translation>
<translation id="3802055581630249637">Chromium vnaprej naloži strani, ki jih boste verjetno obiskali, da se ob obisku naložijo še hitreje</translation>
<translation id="3810973564298564668">Upravljaj</translation>
<translation id="6945066279282141856">Če želite uporabljati shranjena gesla, uporabite kodo QR, prenesite João Browser za iOS in se prijavite v račun Google</translation>
<translation id="3846683726093018685">**Povzemi:** V enem stavku z največ 30 besedami opiši glavni predmet in namen vsebine na posnetku zaslona.

          **Predlagaj vprašanja:** Generiraj označen seznam s 3–5 vprašanji, ki spodbujajo razmišljanje in jih lahko uporabnik zastavi za boljše razumevanje posnetka zaslona. Ta vprašanja morajo vključevati vsaj eno, ki se nanaša posebej na vizualni predmet, njegovo obliko ali njegovo umestitev.</translation>
<translation id="4996569675441627032"><ph name="PAGE_TITLE" /> – João Browser</translation>
<translation id="6008740052107737825">João Browser za to spletno mesto potrebuje dovoljenje za lokalno omrežje</translation>
<translation id="3885770153807205175">Izbirnik jezika</translation>
<translation id="2390004682597453662">Prilagajanje in nadziranje João Browsera. Nekaj morate preveriti – kliknite za podrobnosti.</translation>
<translation id="8262407643678629134">Kliknite ime, da odprete João Browser in začnete brskati.</translation>
<translation id="3892148308691398805">Kopiraj besedilo</translation>
<translation id="2168201717554927204">Uporabnik <ph name="EXISTING_USER" /> je že prijavljen v ta profil v João Browseru. Če želite ločiti brskanje, lahko João Browser za vas ustvari nov profil.</translation>
<translation id="1046732460303790107">Ta razširitev krši pravilnik Spletne trgovine Chrome in morda ni varna. Odstranite jo iz João Browsera, da si ne bo mogla več ogledati vaših podatkov na obiskanih spletnih mestih, vključno z osebnimi podatki, in jih spreminjati.</translation>
<translation id="3941890832296813527">Napaka pri namestitvi: Ime datoteke namestitvenega programa je neveljavno ali ni podprto.</translation>
<translation id="3879366121647289622">João Browser poskuša kopirati gesla. Če želite to omogočiti, vnesite geslo za Windows.</translation>
<translation id="7332365758981378072">Gesla, plačilna sredstva in naslovi, ki ste jih shranili v računu Google, bodo odstranjeni iz te naprave. Če jih želite znova uporabljati v João Browseru, se vnovič prijavite.</translation>
<translation id="395904275706073188">Zaščitenih strani ni mogoče prebrati. Poskusite z drugo stranjo.</translation>
<translation id="3962647064319009959">Preberite, kako vas Chromium varuje</translation>
<translation id="3967822245660637423">Prenos končan</translation>
<translation id="3971865010372729242">Ko vnašate v naslovno vrstico ali iskalno polje, Chromium vaše vnose pošlje v orodja za iskanje, orodja z umetno inteligenco in agentska orodja organizacije zaradi prejemanja predlogov.</translation>
<translation id="3975724895399328945">O različici &amp;Google Chrome for Testing</translation>
<translation id="3997429360543082038">O sistemu Chromium OS</translation>
<translation id="4010059961270896984">Ko obišete spletno mesto, Chromium prek strežnika za zasebnost, ki skrije vaš naslov IP, <ph name="BEGIN_LINK" />Google Varnemu brskanju<ph name="END_LINK" /> pošlje zakriti del URL-jev. Če spletno mesto naredi kaj sumljivega, se pošljejo tudi celotni URL-ji in delčki vsebine strani.</translation>
<translation id="4016217212818346953">Poskrbite za svojo varnost z upraviteljem gesel</translation>
<translation id="4019629340646866719">Chromium OS omogoča dodatna <ph name="BEGIN_LINK_CROS_OSS" />odprtokodna programska oprema<ph name="END_LINK_CROS_OSS" />, enako kot <ph name="BEGIN_LINK_LINUX_OSS" />razvojno okolje Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">Prevedi zaslon</translation>
<translation id="4023601594785368013">Izvirni jezik: <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">Povezave iz poljubne aplikacije odprite v João Browseru, ki bo pripet v opravilno vrstico, da boste lažje dostopali do njega.</translation>
<translation id="4036079820698952681">Pomagajte izboljšati Chromium s poročanjem o <ph name="BEGIN_LINK" />trenutnih nastavitvah<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">V najnovejši različici so na voljo pomembne varnostne izboljšave in nove funkcije.</translation>
<translation id="4055805654398742145">Upravitelj g&amp;esel</translation>
