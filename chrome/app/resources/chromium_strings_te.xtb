<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="te">
<translation id="1026101648481255140">ఇన్‌స్టలేషన్‌ను కొనసాగించండి</translation>
<translation id="1029669172902658969">&amp;ChromiumOSను అప్‌డేట్ చేయడానికి రీ-లాంచ్ చేయండి</translation>
<translation id="4711726241445951349">ఈ ఎక్స్‌టెన్షన్‌ను రివ్యూ చేయమని João Browser మీకు సిఫార్సు చేస్తోంది</translation>
<translation id="1042552502243217427">వారి పేజీలో లింక్‌లను ప్రైవేట్‌గా ప్రీ - లోడ్ చేయమని సైట్ కోరినప్పుడు, Chromium, Google సర్వర్‌లను ఉపయోగిస్తుంది. ఇది ప్రీ - లోడ్ చేయబడిన సైట్ నుండి మీ గుర్తింపును దాచిపెడుతుంది, కానీ ఏ సైట్‌లు ప్రీ - లోడ్ అయ్యాయి అనేది Googleకు తెలుస్తుంది.</translation>
<translation id="1051793555070215510">ఈ 1 నిమిషం సర్వేను పూర్తి చేసి అజ్ఞాత మోడ్‌ను మెరుగుపరచడంలో మాకు సహాయపడండి.</translation>
<translation id="1065672644894730302">మీ ప్రాధాన్యతలు చదవబడలేవు. కొన్ని లక్షణాలు అందుబాటులో ఉండకపోవచ్చు మరియు ప్రాధాన్యతలకు మార్పులు సేవ్ చేయబడకపోవచ్చు.</translation>
<translation id="3937976866851867994">João Browserలో సైట్‌లు, యాప్‌లు, ఎక్స్‌టెన్షన్‌లకు సంబంధించిన అనుమతులను మీ తల్లి/తండ్రి ఆఫ్ చేశారు</translation>
<translation id="8626021334348319355">నిర్దిష్ట João Browser ఫీచర్ లేదా ఎక్స్‌టెన్షన్‌ను సెర్చ్ చేయడానికి, అడ్రస్ బార్‌లో దాని షార్ట్‌కట్‌ను టైప్ చేసి, ఆపై మీరు ఎంచుకున్న కీబోర్డ్ కీని టైప్ చేయండి</translation>
<translation id="9157778882771986870">João Browser మీ పాస్‌వర్డ్‌లను ఎగుమతి చేయాలనుకుంటోంది. దీనిని అనుమతించడం కోసం మీ Windows పాస్‌వర్డ్‌ని టైప్ చేయండి.</translation>
<translation id="112640046208448578">వస్తువులను లేదా ప్రదేశాలను గుర్తించండి, టెక్స్ట్‌ను కాపీ చేయండి లేదా అనువదించండి. మీరు ఇమేజ్ సెర్చ్‌ను ఉపయోగించినప్పుడు, పేజీకి సంబంధించిన స్క్రీన్‌షాట్, సర్వర్‌కు పంపబడుతుంది. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">మీ డిఫాల్ట్ బ్రౌజర్ Chromium</translation>
<translation id="1131805035311359397">డేటా ఉల్లంఘనల నుండి, ఇతర భద్రతా సమస్యల నుండి మీ పాస్‌వర్డ్‌లు సురక్షితంగా ఉన్నాయో లేదో చెక్ చేయడానికి, <ph name="BEGIN_LINK" />Chromiumకు సైన్ ఇన్ చేయండి<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">João Browser మెనూను క్లిక్ చేయండి</translation>
<translation id="1157985233335035034">ఇటీవలి భాషలు</translation>
<translation id="1184145431117212167">మీ Windows వెర్షన్‌ సపోర్ట్ చేయనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="1185134272377778587">Chromium గురించి</translation>
<translation id="667420476518265356">మీ ఫోన్‌లో João Browserతో ధర ట్రాకింగ్ అలర్ట్‌లను పొందండి</translation>
<translation id="1203500561924088507">ఇన్‌స్టాల్ చేసినందుకు ధన్యవాదాలు. <ph name="BUNDLE_NAME" />‌ను ఉపయోగించడానికి ముందు మీరు బ్రౌజర్‌ను తప్పకుండా రీస్టార్ట్ చేయాలి.</translation>
<translation id="1232234696885483911">మీరు ఇమేజ్ సెర్చ్‌ను తెరిచినప్పుడు, PDFలతో సహా పేజీ టైటిల్, URL, కంటెంట్ ఆటోమేటిక్‌గా సర్వర్‌కు పంపబడతాయి. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">మీరు సైన్ ఇన్ చేసినప్పుడు, João Browserలో మీ Google ఖాతా నుండి సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, మరిన్నింటిని ఉపయోగించవచ్చు. దీన్ని మార్చడానికి, “João Browserలో మీ ఖాతా”కు వెళ్లండి.</translation>
<translation id="4866003137980530528">Mac మెనూ బార్‌లో João Browserలో Geminiని చూపండి</translation>
<translation id="2526294198551578217">João Browserలోని Geminiలో స్క్రీన్ మీద మీకు కావాల్సిన భాగాన్ని ఎంచుకోవడానికి, కీబోర్డ్ షార్ట్‌కట్‌ను ఉపయోగించండి.</translation>
<translation id="7068536367561625920">ఈ ట్యాబ్ ఇన్‌యాక్టివ్‌గా ఉన్నప్పుడు, João Browserను వేగంగా ఉంచడానికి మెమరీ ఖాళీ చేయబడింది. మీరు ఏ సమయంలోనైనా ఈ సైట్ ఇన్‌యాక్టివ్‌గా ఉండకుండా మినహాయించడాన్ని ఎంచుకోవచ్చు.</translation>
<translation id="3669854427836618143">ఫైల్ ప్రమాదకరంగా ఉన్నందున João Browser ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="126567311906253476"><ph name="USER_EMAIL" />‌తో Gmail లేదా YouTube వంటి Google సర్వీస్‌లకు ఆటోమేటిక్‌గా సైన్ ఇన్ చేస్తున్నప్పుడు, మీరు అదే ఖాతాతో Chromiumకి సైన్ ఇన్ చేయవచ్చు</translation>
<translation id="8094399825947986050">మీ ఫోన్‌లో João Browserను పొందండి</translation>
<translation id="1290883685122687410">సెటప్ ఎర్రర్: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">మీ కొత్త João Browser ప్రొఫైల్‍ను సెట్ అప్ చేయండి</translation>
<translation id="7591029065989504977">João Browserలో Geminiని ట్రై చేయండి</translation>
<translation id="8408989583029959522">బ్లూటూత్ పరికరాలను&#32;
 అన్వేషించడానికి João Browserకు బ్లూటూత్ యాక్సెస్ అవసరం. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">మీ ఫోన్‌లో João Browserకు సైన్ ఇన్ చేయండి</translation>
<translation id="1330562121671411446">భాషను గుర్తించండి</translation>
<translation id="6026568602942276348">João Browser (<ph name="URL" />) నుండి కూడా డేటాను తొలగించండి</translation>
<translation id="1345251407431278948">పిన్ చేశారు! మీరు టూల్‌బార్‌లోని కొత్త బటన్‌ను ఉపయోగించి ఇమేజ్ సెర్చ్‌ను మళ్లీ యాక్సెస్ చేయవచ్చు</translation>
<translation id="1356661055722410047">కొత్తది! మీరు ఇప్పుడు మీ స్క్రీన్‌పై టెక్స్ట్‌ను, ఇమేజ్‌లను రెండింటినీ అనువదించవచ్చు</translation>
<translation id="1383876407941801731">సెర్చ్</translation>
<translation id="5807085300679014096">ప్రయాణంలోనూ బ్రౌజింగ్‌ను కొనసాగించడానికి João Browser యాప్‌ను ఉపయోగించండి</translation>
<translation id="141901961143729572">మీ ఆలోచనలను షేర్ చేయండి</translation>
<translation id="3736947618013031173">మీ విండోను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో João Browser కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి.</translation>
<translation id="1478370723027452770">Chrome for Testingకు సంబంధించి సహాయాన్ని పొందండి</translation>
<translation id="1497802159252041924">ఇన్‌స్టాలేషన్ ఎర్రర్: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">ఈ పేజీకి ప్రొటెక్షన్ జోడించబడింది</translation>
<translation id="4379865404970367448">João Browser ట్యాబ్‌ను షేర్ చేయండి</translation>
<translation id="4436275659297289591">João Browserకు సైన్ ఇన్ చేయండి</translation>
<translation id="1547469039832541117">హైలైట్ అయిన టాస్క్‌ను ముగిస్తుంది.</translation>
<translation id="449712764049695153">João Browserను పిన్ చేయండి</translation>
<translation id="1574377791422810894">Chromium భద్రతా టూల్స్</translation>
<translation id="5480232403718129394">João Browser మీ Password Manager డేటాను తొలగించాలనుకుంటోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు João Browserను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు}=1{అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు João Browserను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు João Browserను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="980976428162070137">మీ ఫోన్‌లోని João Browser యాప్‌తో Google అందించే అత్యుత్తమ ప్రయోజనాలను పొందండి</translation>
<translation id="1625909126243026060">Chromiumలోని ముఖ్య గోప్యతా, సెక్యూరిటీ కంట్రోల్స్‌ను రివ్యూ చేయండి</translation>
<translation id="1640672724030957280">డౌన్‌లోడ్ చేయబడుతోంది...</translation>
<translation id="1665602916345474427">మీరు మెంబర్‌షిప్ ఉన్న <ph name="USER_NAME" />‌గా, <ph name="USER_EMAIL" /> ఈమెయిల్‌తో సైన్ ఇన్ చేశారు. ఖాతా మెనూను తెరవండి</translation>
<translation id="1708414395296835197">మీరు మెసేజ్‌ల్లో, డాక్యుమెంట్‌ల్లో, ఇంకా ఇతర యాప్‌ల్లో ఉండే లింక్‌లను క్లిక్ చేసినప్పుడల్లా Chromiumను ఉపయోగించవచ్చు. ఇది మీ టాస్క్‌బార్‌కు కూడా పిన్ చేయబడుతుంది.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> కోసం అదనపు అధికారాలను అందిస్తుంది.</translation>
<translation id="1722488837206509557">ఇది అందుబాటులో ఉన్న పరికరాల నుండి ఎంచుకోవడానికి, వాటిలో కంటెంట్‌ను డిస్‌ప్లే చేయడానికి మిమ్మల్ని అనుమతిస్తుంది.</translation>
<translation id="6972087163510342335">João Browser త్వరలోనే బ్రౌజింగ్ డేటాను తొలగిస్తుంది</translation>
<translation id="1736443181683099871">Chromium నావిగేషన్‌లను HTTPSకి అప్‌గ్రేడ్ చేయడానికి ట్రై చేస్తుంది</translation>
<translation id="3879288383593333401">João Browser డేటా తీసేసింది</translation>
<translation id="656496276885630888">João Browser <ph name="REMAINING_TIME" /> సమయంలో రీస్టార్ట్ అవుతుంది</translation>
<translation id="1749104137266986751">HTTPS అందుబాటులో లేనప్పుడు, Chromium మిమ్మల్ని హెచ్చరించకుండా సురక్షితం కాని కనెక్షన్‌ను ఉపయోగిస్తుంది</translation>
<translation id="1226290419185955779">బ్యాక్‌గ్రౌండ్‌లో João Browserని అమలు చేయడానికి అనుమతించండి</translation>
<translation id="4231366995273072370">João Browserను సురక్షితం చేయడానికి, మేము <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />లో లిస్ట్‌ చేయబడని మరియు మీకు తెలియకుండానే జోడించబడిన కొన్ని ఎక్స్‌టెన్షన్‌లను నిలిపివేసాము.</translation>
<translation id="1822049153969905781">João Browserను మీ టాస్క్‌బార్‌కు పిన్ చేసి, దాన్ని ఫాస్ట్‌గా యాక్సెస్ చేసేందుకు, Windows నోటిఫికేషన్‌లో <ph name="BEGIN_BOLD" />Yes<ph name="END_BOLD" />ను క్లిక్ చేయండి</translation>
<translation id="1321831992638405531">João Browserను మళ్లీ ఇన్‌స్టాల్ చేయి</translation>
<translation id="3386967202064865436"><ph name="AUTHENTICATION_PURPOSE" /> కోసం João Browser ట్రై చేస్తోంది</translation>
<translation id="70054449700528483">మీరు నెక్స్ట్ టైమ్ మీ <ph name="DEVICE_TYPE" />‌లో João Browserను తెరిచినప్పుడు, Google Password Managerను ట్రై చేయమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="1838374766361614909">శోధనను తీసివేయండి</translation>
<translation id="5807096362853316123">ఈ పరికరం నుండి మాత్రమే బ్రౌజింగ్ డేటాను తొలగించడానికి, దీన్ని మీ Google ఖాతాలో ఉంచుతూ, <ph name="BEGIN_LINK" />João Browser నుండి సైన్ అవుట్ చేయండి<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">ప్రయాణంలో ఉన్నప్పుడు కొత్త ట్యాబ్ గ్రూప్‌లను తెరవడానికి లేదా క్రియేట్ చేయడానికి మీ ఫోన్‌లో João Browserను డౌన్‌లోడ్ చేసుకోండి.</translation>
<translation id="185970820835152459">మీరు సైన్ ఇన్ చేసిన Google ఖాతాలను మీరు మేనేజ్ చేయవచ్చు. Chromium బ్రౌజర్, Play Store, Gmail, ఇంకా మరిన్నింటి కోసం మీ Google ఖాతాలు ఉపయోగించబడతాయి. ఫ్యామిలీ మెంబర్ వంటి వారి కోసం మీరు ఖాతాను జోడించాలనుకుంటే, బదులుగా కొత్త వ్యక్తిని మీ <ph name="DEVICE_TYPE" />కు జోడించండి. <ph name="LINK_BEGIN" />మరింత తెలుసుకోండి<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయండి</translation>
<translation id="65457771685016683"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో João Browserకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE" /> నుండి మీ బుక్‌మార్క్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="1880677175115548835">టెక్స్ట్‌ను ఎంచుకోండి</translation>
<translation id="2634119629547215883">మీరు నిర్వహించబడే ఖాతాతో సైన్ ఇన్ చేస్తున్నారు. దీని నిర్వాహకునికి మీ João Browser ప్రొఫైల్‌పై నియంత్రణను అందిస్తున్నారు. మీ యాప్‌లు, బుక్‌మార్క్‌లు, హిస్టరీ, పాస్‌వర్డ్‌లు, ఇతర సెట్టింగ్‌ల వంటి మీ João Browser డేటా శాశ్వతంగా <ph name="USER_NAME" />కు అనుబంధించబడుతుంది. మీరు Google ఖాతాల డ్యాష్‌బోర్డ్ ద్వారా ఈ డేటాను తొలగించవచ్చు. కానీ ఈ డేటాను మరో ఖాతాతో అనుబంధించలేరు. మీరు ప్రస్తుతం ఉన్న మీ João Browser డేటాను వేరుగా ఉంచడానికి ఐచ్ఛికంగా కొత్త ప్రొఫైల్‌ను క్రియేట్ చేయవచ్చు. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium బ్యాక్‌గ్రౌండ్ యాక్టివిటీని, స్మూత్ స్క్రోలింగ్, వీడియో ఫ్రేమ్ రేట్‌ల వంటి విజువల్ ఎఫెక్ట్‌లను పరిమితం చేయడం ద్వారా బ్యాటరీ పవర్‌ను ఆదా చేస్తుంది. <ph name="BEGIN_LINK" />ఎనర్జీ సేవర్ గురించి మరింత తెలుసుకోండి<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">João Browser అప్‌డేటర్ సర్వీస్</translation>
<translation id="1911763535808217981">దీనిని ఆఫ్ చేయడం ద్వారా, మీరు Chromiumకి సైన్ ఇన్ చేయకుండానే Gmail లాంటి Google సైట్‌లలో సైన్ ఇన్ చేయగలరు</translation>
<translation id="4037729269678342163">João Browser ప్రతిస్పందించడం లేదు. ఇప్పుడు మళ్లీ ప్రారంభించాలా?</translation>
<translation id="7563750688920581112">మీ సంస్థ పాలసీ, <ph name="MANAGER" /> ప్రకారం మీరు João Browserకు సైన్ ఇన్ చేయాలి</translation>
<translation id="193439633299369377">అప్‌డేట్‌ను వర్తింపజేయడానికి ChromiumOSను రీస్టార్ట్ చేయాలి.</translation>
<translation id="7099143775283792684">ఫైల్ రకం సాధారణంగా డౌన్‌లోడ్ అవ్వదు, అలాగే ఇది ప్రమాదకరమైనది అయినందున João Browser ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="1953553007165777902">డౌన్‌లోడ్ అవుతోంది... <ph name="MINUTE" /> నిమిషం(లు) సమయం మిగిలి ఉంది</translation>
<translation id="1966382378801805537">Chromium డిఫాల్ట్ బ్రౌజర్‌ను నిశ్చయించలేదు లేదా సెట్ చేయలేదు</translation>
<translation id="197326043290947695">ఇమేజ్ సెర్చ్‌తో స్మార్ట్‌గా బ్రౌజ్ చేయండి</translation>
<translation id="6185556991023272801">João Browser కొన్ని ఫైళ్లను బ్లాక్ చేసి, కొత్త ట్యాబ్‌లో ఎందుకు తెరుస్తుందో తెలుసుకోండి</translation>
<translation id="4053636705816895911">మీ João Browser సాఫ్ట్‌వేర్‌ను అప్‌డేట్‌గా ఉంచుతుంది. ఈ సర్వీస్ డిజేబుల్ చేయబడినా లేదా ఆపివేయబడినా, మీ João Browser సాఫ్ట్‌వేర్ అప్‌డేట్ చేసి ఉంచబడదు, అంటే సంభవించే సెక్యూరిటీ లోపాలను పరిష్కరించడం సాధ్యం కాదు, ఫీచర్‌లు పని చేయకపోవచ్చు. João Browser సాఫ్ట్‌వేర్ ఉపయోగించనప్పుడు ఈ సర్వీస్ దానికదే అన్‌ఇన్‌స్టాల్ అవుతుంది.</translation>
<translation id="2008474315282236005">ఇది ఈ పరికరం నుండి 1 అంశాన్ని తొలగిస్తుంది. మీ డేటాను తర్వాత తిరిగి పొందడానికి, Chromiumకు <ph name="USER_EMAIL" /> లాగా సైన్ ఇన్ చేయండి.</translation>
<translation id="2018879682492276940">ఇన్‌స్టాల్ చేయడం విఫలమైంది. దయచేసి మళ్లీ ట్రై చేయండి.</translation>
<translation id="2039417478970545937">సెట్టింగ్‌లు.</translation>
<translation id="2049376729098081731">Google సర్వీస్‌లలో మరింత వ్యక్తిగతీకరించిన అనుభవం కోసం Chromium హిస్టరీని చేర్చాలో, లేదో ఎంచుకోండి</translation>
<translation id="6768767091114123654">మీరు బలమైన పాస్‌వర్డ్‌లను క్రియేట్ చేయడానికి, సేవ్ చేయడానికి, ఆటోఫిల్ చేయడానికి సాయపడేలా ఇది João Browserలో బిల్ట్-ఇన్‌గా వస్తుంది. సులభంగా యాక్సెస్ చేయడానికి షార్ట్‌కట్‌ను జోడించండి.</translation>
<translation id="3571664229232252557">João Browserకు కొత్త రూపాన్ని అందించడానికి కొత్త ట్యాబ్ పేజీలో João Browserను అనుకూలంగా మార్చండి బటన్‌ను క్లిక్ చేయండి</translation>
<translation id="4273287215573278663">ఫైల్ మోసపూరితమైనది అలాగే మీ పరికరానికి ఊహించని మార్పులు చేసే అవకాశం ఉన్నందున João Browser ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="9063967192437499581">మీరు నెక్స్ట్ టైమ్ João Browser iOSను తెరిచినప్పుడు, <ph name="FEATURE_NAME" />‌ను ట్రై చేయమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="8511569826706775962">మీ Google ఖాతాలో మీరు సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, ఇతర João Browser డేటా ఈ డివైజ్ నుండి తీసివేయబడతాయి. వాటిని మళ్లీ João Browserలో ఉపయోగించడానికి, తిరిగి సైన్ ఇన్ చేయండి.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{João Browserను 1 నిమిషం పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా బ్రౌజింగ్ డేటాను తొలగిస్తుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు. మీ ట్యాబ్‌లు తెరిచి ఉంటాయి.}other{João Browserను # నిమిషాల పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా బ్రౌజింగ్ డేటాను తొలగిస్తుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు. మీ ట్యాబ్‌లు తెరిచి ఉంటాయి.}}</translation>
<translation id="2125838419757773031">సెర్చ్ చేయడానికి స్క్రీన్‌పై భాగాన్ని ఎంచుకోండి</translation>
<translation id="2126108037660393668">డౌన్‌లోడ్ చేయబడిన ఫైల్ వెరిఫికేషన్ విఫలమైంది.</translation>
<translation id="2135919691573380097">ఈ సైట్‌ను రిపోర్ట్ చేయండి</translation>
<translation id="2137162749895930932">స్క్రీన్‌ను అనువదించండి అనే ఆప్షన్‌ను మూసివేయండి</translation>
<translation id="1308845716497059117">సైట్ సురక్షిత కనెక్షన్‌ను ఉపయోగించని అలాగే ఫైల్ ట్యాంపర్ చేయబడిన కారణంగా João Browser ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="2170098639895543546">పేజీలో ఏదైనా ఎంచుకోండి</translation>
<translation id="6705844023496387932">João Browserను అనుకూలంగా మార్చండి</translation>
<translation id="2174917724755363426">ఇన్‌స్టాలేషన్ పూర్తి కాలేదు. మీరు ఖచ్చితంగా రద్దు చేయాలనుకుంటున్నారా?</translation>
<translation id="7728290795259244895">João Browser - నెట్‌వర్క్ సైన్ ఇన్ - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">అప్‌డేట్‌ల కోసం చెక్ చేసేటప్పుడు ఎర్రర్ ఏర్పడింది: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">João Browser నుండి ఖాతాను తీసివేయండి</translation>
<translation id="4648870374540039667">అత్యుత్తమ షాపింగ్ టూల్స్‌ను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లడానికి João Browser యాప్‌ను ఉపయోగించండి</translation>
<translation id="2106116820042118250">iOS కోసం João Browserలో మెరుగైన సురక్షిత బ్రౌజింగ్‌కు సంబంధించి ప్రయాణంలో సురక్షితంగా ఉండండి</translation>
<translation id="2210682093923538346">హానికరమైన సైట్. Chromium నోటిఫికేషన్‌లను తీసివేసింది.</translation>
<translation id="2236949375853147973">నా యాక్టివిటీ</translation>
<translation id="118764235932893741">João Browserకు సైన్ ఇన్ చేసి, మీ పరికరాలన్నింటిలో మీ అడ్రస్‌లను, ఇంకా మరిన్నింటిని పొందండి. మీరు సైన్ ఇన్ చేసిన తర్వాత ఈ అడ్రస్ మీ Google ఖాతాలో సేవ్ అవుతుంది.</translation>
<translation id="7254578863532089400">మీరు కంప్యూటర్‌ను షేర్‌ చేస్తే, స్నేహితులు, ఫ్యామిలీ మెంబర్‌లు విడివిడిగా బ్రౌజ్ చేయవచ్చు. João Browserను వారికి నచ్చిన రీతిలో సెటప్ చేసుకోవచ్చు.</translation>
<translation id="22571759390241347">Chromiumలో స్కిల్స్</translation>
<translation id="2283803047247799269">ఇమేజ్ సెర్చ్‌తో ఈ ట్యాబ్‌ను సెర్చ్ చేయండి</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌ను పాజ్ చేయమని João Browser సిఫార్సు చేస్తుంది}other{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌లను పాజ్ చేయమని João Browser సిఫార్సు చేస్తుంది}}</translation>
<translation id="2307973900865360088">డాక్‌లో ఉంచండి</translation>
<translation id="2313870531055795960">Chromiumలో స్టోర్ చేయబడిన సురక్షితం కాని సైట్‌ల లిస్ట్‌తో కూడిన URLలను చెక్ చేస్తుంది. ఏదైనా సైట్ మీ పాస్‌వర్డ్‌ను దొంగిలించే ప్రయత్నం చేసినా, లేదంటే ఏదైనా హానికరమైన ఫైల్‌ను మీరు డౌన్‌లోడ్ చేసినా, సదరు URLలను, ఆయా పేజీల కంటెంట్‌లోని కొన్ని భాగాలను కూడా Chromium, 'సురక్షిత బ్రౌజింగ్'కు పంపవచ్చు.</translation>
<translation id="2356070529366658676">అడుగు</translation>
<translation id="2359808026110333948">కొనసాగించండి</translation>
<translation id="3800730051093461113">ఎక్స్‌టెన్షన్ "<ph name="EXTENSION_NAME" />" కోసం, మీరు João Browserకు సైన్ ఇన్ చేయాలి</translation>
<translation id="8758735062658446604">యాప్‌లకు సంబంధించి బ్యాక్‌గ్రౌండ్‌లో రన్ అవుతున్న João Browserను డిజేబుల్ చేయండి</translation>
<translation id="2623595027619107207"><ph name="USER_EMAIL_ADDRESS" />‌గా ఈ ఎక్స్‌టెన్షన్‌ను ఉపయోగించడానికి, João Browserకు సైన్ ఇన్ చేయండి.</translation>
<translation id="2384373936468275798">మీ ఖాతా సైన్ ఇన్ వివరాల గడువు ముగిసినందున ChromiumOS మీ డేటాను సింక్ చేయలేకపోయింది.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{ఒకటి లేదా అంతకంటే ఎక్కువ João Browser ఎక్స్‌టెన్షన్‌లు 1 HID డివైజ్‌ను యాక్సెస్ చేస్తున్నాయి}=1{1 HID డివైజ్ ఒకటి లేదా అంతకంటే ఎక్కువ João Browser ఎక్స్‌టెన్షన్‌ల ద్వారా యాక్సెస్ చేయబడుతోంది}other{ఒకటి లేదా అంతకంటే ఎక్కువ João Browser ఎక్స్‌టెన్షన్‌లు # HID డివైజ్‌లను యాక్సెస్ చేస్తున్నాయి}}</translation>
<translation id="6254788431480237503">ఈ సైట్ కోసం João Browserకు కెమెరా, ఇంకా మైక్రోఫోన్ అనుమతులు అవసరం</translation>
<translation id="2403703063067034158">స్టార్టప్ ఎర్రర్: ప్రస్తుతం వేరొక సెటప్ రన్ అవుతోంది, దయచేసి తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="3028975423343897358">ఏదైనా యాప్ నుండి João Browserలో లింక్‌లను తెరవండి, మీ టాస్క్‌బార్‌లో బ్రౌజర్‌ను యాక్సెస్ చేయండి</translation>
<translation id="579079006139156831">త్వరగా ఓవర్‌వ్యూ పొందడానికి, ఫాలో-అప్ ప్రశ్నలు అడగడానికి ఈ డాక్యుమెంట్‌ను João Browserలోని Geminiకి షేర్ చేసేందుకు 'సారాంశం' బటన్‌ను క్లిక్ చేయండి</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Chromium నుండి టూల్స్‌<ph name="END_LINK" />‌తో, మీరు సురక్షితంగా బ్రౌజ్ చేయవచ్చు, కంట్రోల్‌లో ఉండవచ్చు</translation>
<translation id="7114471809991869757"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో João Browserకి సైన్ ఇన్ చేయండి. మీరు మీ డివైజ్‌లన్నింటిలో మీ పాస్‌వర్డ్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="2451727308784734061">Password Managerను త్వరగా చేరుకోవడానికి మీ షార్ట్‌కట్‌ను ఉపయోగించండి. మీరు మీ షార్ట్‌కట్‌ను మీ కంప్యూటర్ మొదటి స్క్రీన్ లేదా యాప్ లాంచర్‌కు తరలించవచ్చు.</translation>
<translation id="2709136733469807397">João Browser త్వరలోనే మూసివేయబడుతుంది</translation>
<translation id="3652225684487279741">João Browserలో</translation>
<translation id="2485422356828889247">అన్ఇన్‌స్టాల్ చేయి</translation>
<translation id="2513154137948333830">రీబూట్ అవసరం: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">ఇమేజ్ సెర్చ్‌ను ఉపయోగించి టెక్స్ట్‌ను ఎంచుకోండి</translation>
<translation id="1527474262707362156">João Browser ఇప్పటికే ఉన్న పాస్‌వర్డ్‌లను రీప్లేస్ చేయడానికి ట్రై చేస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="6480371226914552131">ఫైళ్లను డౌన్‌లోడ్ చేయడానికి João Browserకు స్టోరేజ్‌ యాక్సెస్ అవసరం</translation>
<translation id="6318568902186985084">João Browser సహాయకం</translation>
<translation id="2575822587468774919">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడానికి ఏదైనా ఎంచుకోండి</translation>
<translation id="4557210258834653476">మీ పరికరాలన్నిటిలో మీ పాస్‌వర్డ్‌లను, ఇంకా మరిన్నింటిని పొందడానికి João Browserకు సైన్ ఇన్ చేయండి</translation>
<translation id="1148164459654218834">João Browserను డౌన్‌లోడ్ చేసి, మీ Google ఖాతాకు సైన్ ఇన్ చేయడానికి మీ ఫోన్‌తో QR కోడ్‌ను స్కాన్ చేయండి.</translation>
<translation id="235892353478111963">João Browserని ఉపయోగించడం కొనసాగించండి</translation>
<translation id="259935314519650377">డౌన్‌లోడ్ చేసిన ఇన్‌స్టాలర్‌ను కాష్ చేయడంలో విఫలమైంది. ఎర్రర్: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">సిస్టమ్</translation>
<translation id="8471946631262724853">మీ సంస్థ మీ బుక్‌మార్క్‌లు, హిస్టరీ, అలాగే పాస్‌వర్డ్‌ల వంటి బ్రౌజింగ్ డేటాను చూడగలదు, మేనేజ్ చేయగలదు. ఇతర João Browser ప్రొఫైల్స్‌లోని బ్రౌజింగ్ డేటాను ఇది చూడలేదు</translation>
<translation id="2870759219964376597">మీ ఖాతా <ph name="ACCOUNT_EMAIL" />‌లో João Browser డేటాను ఉపయోగించింది, సేవ్ చేసింది మీరేనని వెరిఫై చేయండి</translation>
<translation id="2955972712254986678">{COUNT,plural, =0{అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు João Browserను రీ-లాంచ్ చేయాలని అడ్వాన్స్‌డ్ ప్రొటెక్షన్ కోరుతోంది}=1{అడ్వాన్స్‌డ్ ప్రొటెక్షన్ కోసం, మీరు అప్‌డేట్‌ను వర్తింపజేయడానికి João Browserను రీ-లాంచ్ చేయాలి. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{అడ్వాన్స్‌డ్ ప్రొటెక్షన్ కోసం, మీరు అప్‌డేట్‌ను వర్తింపజేయడానికి João Browserను రీ-లాంచ్ చేయాలి. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="8949462882238006192">João Browserని ప్రారంభించండి</translation>
<translation id="4224214204752803768">ఇన‌స్ట‌లేష‌న్‌ సమయంలో ఆపరేటింగ్ సిస్టమ్ ఎర్ర‌ర్‌ ఏర్పడింది. దయచేసి João Browserను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="3141414135710372892">మీరు ఒక డివైజ్‌ను షేర్ చేస్తే, ఫ్రెండ్స్, ఫ్యామిలీ విడివిడిగా బ్రౌజ్ చేయవచ్చు, João Browserను వారికి నచ్చిన విధంగా సెటప్ చేసుకోవచ్చు</translation>
<translation id="8838607803339100223">João Browser మినిమైజ్ చేయబడినప్పటికీ, మీ డివైజ్‌లో ఎక్కడి నుండైనా Geminiని సులభంగా యాక్సెస్ చేసి ఉపయోగించుకోండి.</translation>
<translation id="1679364578146271696">João Browser ట్యాబ్</translation>
<translation id="2718390899429598676">అదనపు భద్రత కోసం, Chromium మీ డేటాను ఎన్‌క్రిప్ట్ చేస్తుంది.</translation>
<translation id="1874696651662237927">João Browser నుండి మీ Google ఖాతాను తీసివేయడానికి, సైన్ అవుట్ చేయండి</translation>
<translation id="6850669719663104304">మీ డివైజ్‌లన్నింటిలో మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, ఇంకా మరిన్నింటిని పొందడానికి João Browserకు సైన్ ఇన్ చేయండి</translation>
<translation id="2738871930057338499">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. HTTP 403 అనుమతి లేదు. దయచేసి మీ ప్రాక్సీ కాన్ఫిగరేషన్‌ను చెక్ చేయండి.</translation>
<translation id="2753623023919742414">సెర్చ్ చేయడానికి క్లిక్ చేయండి</translation>
<translation id="4193420110872590792">మీ ఆటోమేటిక్ సెట్టింగ్ PDF వ్యూయర్‌గా João Browserను సెట్ చేయండి</translation>
<translation id="6614401181366354261">ఈ ఎక్స్‌టెన్షన్‌లో మాల్‌వేర్ ఉంది, ఇది సురక్షితం కాకపోవచ్చు. João Browser నుండి దాన్ని తీసివేయండి, తద్వారా ఇది మీ వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="2799223571221894425">మళ్లీ ప్రారంభించండి</translation>
<translation id="6299858290790311689">మీ João Browser</translation>
<translation id="2816462166102338036">ఇమేజ్ సెర్చ్‌తో ఈ వీడియోను సెర్చ్ చేయండి</translation>
<translation id="5896458971800337862">iOSలోని João Browserతో ప్రయాణంలోనూ మీ కెమెరాతో ప్రోడక్ట్‌లను కనుగొనండి, ధరల తగ్గుదలను ట్రాక్ చేయండి, ఇంకా మరెన్నో చేయండి.</translation>
<translation id="2841525013647267359">ఈ భాష నుండి అనువదించండి</translation>
<translation id="2846251086934905009">ఇన్‌స్టాల్ లోపం: ఇన్‌స్టాలర్ ప్రాసెస్‌ను పూర్తి చేయలేదు. ఇన్‌స్టాలేషన్ రద్దు చేయబడింది.</translation>
<translation id="4357241592510111611">João Browser నుండి తీసివేయండి...</translation>
<translation id="2850691299438350830">Chromiumలో మిమ్మల్ని సురక్షితంగా ఉంచుతుంది, మీరు సైన్ ఇన్ చేసినప్పుడు ఇతర Google యాప్‌లలో మీ సెక్యూరిటీని మెరుగుపరచడానికి ఉపయోగించబడవచ్చు</translation>
<translation id="2885378588091291677">విధి సంచాలకులు</translation>
<translation id="8887040619780090085">&amp;João Browser గురించి</translation>
<translation id="2915996080311180594">తర్వాత రీస్టార్ట్ చేయండి</translation>
<translation id="6619708652934279502">మీ రహస్య పదబంధంతో మీ డేటా ఎన్‌క్రిప్ట్ అయింది. మీ Google ఖాతాలో João Browser డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి దాన్ని ఎంటర్ చేయండి.</translation>
<translation id="2945997411976714835">ఇన్‌స్టలేషన్ ఎర్రర్: ఇన్‌స్టాలర్ ప్రాసెస్‌ను ప్రారంభించడంలో విఫలమైంది.</translation>
<translation id="4566114009566397386">iOSలో João Browser కోసం సేవ్ చేసిన పాస్‌వర్డ్‌లను ఉపయోగించి సైట్‌లకు వేగంగా సైన్ ఇన్ చేయండి</translation>
<translation id="562175540137901632">మీ సంస్థ João Browserను మేనేజ్ చేస్తుంది</translation>
<translation id="2977470724722393594">Chromium తాజాగా ఉంది</translation>
<translation id="2977506796191543575">ఏదైనా సైట్ మీ పాస్‌వర్డ్‌ను దొంగిలించే ప్రయత్నం చేసినా, లేదంటే ఏదైనా హానికరమైన ఫైల్‌ను మీరు డౌన్‌లోడ్ చేసినా, సదరు URLలను, ఆయా పేజీల కంటెంట్‌లోని కొన్ని భాగాలను కూడా Chromium, 'సురక్షిత బ్రౌజింగ్'కు పంపవచ్చు</translation>
<translation id="1776205510657237623">మీ తల్లి/తండ్రి ఛాయిస్‌లతో ఆన్‌లైన్‌లో సురక్షితంగా ఉండటానికి, João Browserకు సైన్ ఇన్ చేయండి</translation>
<translation id="3003694935412297923">అన్ని టాస్క్‌లు</translation>
<translation id="3374694374267805392">{count,plural, =1{మీ Google ఖాతాలో కొంత డేటాను సేవ్ చేయడానికి, దాన్ని మీ డివైజ్‌లన్నింటిలో ఉపయోగించుకోవడానికి ముందు, అది మీరేనని João Browser ధృవీకరించాలి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా (1 ఐటెమ్) తొలగించబడుతుంది.}other{మీ Google ఖాతాలో కొంత డేటాను సేవ్ చేయడానికి, దాన్ని మీ డివైజ్‌లన్నింటిలో ఉపయోగించుకోవడానికి ముందు, అది మీరేనని João Browser ధృవీకరించాలి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా ({count} ఐటెమ్‌లు) తొలగించబడుతుంది.}}</translation>
<translation id="4915792193596835645"><ph name="URL" /> ను João Browserలో కొత్త ట్యాబ్‌లో తెరవండి.</translation>
<translation id="302551344979399011">స్కిల్స్ వంటి AI ఆవిష్కరణలు మీ Google ఖాతాలో సేవ్ చేయబడతాయి, Chromium సింక్ నుండి విడిగా మేనేజ్ చేయబడతాయి</translation>
<translation id="8367114375553489372">João Browserకి జోడిస్తోంది...</translation>
<translation id="3038232873781883849">ఇన్‌స్టాల్ చేయడానికి వేచి ఉంది...</translation>
<translation id="3045032126857188731">అనువదించిన భాష: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">ఫీడ్‌బ్యాక్ డైలాగ్‌ను మూసివేయండి</translation>
<translation id="6168172692486433600">ఇతర João Browser ప్రొఫైల్స్</translation>
<translation id="884929993636327">ఎక్స్‌టెన్షన్‌లు అనేవి João Browserను అనుకూలంగా మార్చడానికి మిమ్మల్ని అనుమతించే యాడ్-ఆన్‌లు. ఆర్గనైజ్డ్‌గా ఉండటం నుండి రోజువారీ టాస్క్‌లను సులభతరం చేయడం వరకు, João Browserను మీ స్వంతం చేసుకోవడంలో ఎక్స్‌టెన్షన్‌లు మీకు సహాయపడతాయి.</translation>
<translation id="1525897524206034002">Googleకు వినియోగ గణాంకాలు, <ph name="UMA_LINK" />ను పంపడం ద్వారా João Browserను మెరుగుపరచడంలో సహాయపడండి</translation>
<translation id="2766971658743453990">ప్రయాణంలోనూ Google భద్రతను పొందడానికి João Browser యాప్‌ను ఉపయోగించండి</translation>
<translation id="4387884830246074210">{NUM_DEVICES,plural, =0{ఒకటి లేదా అంతకంటే ఎక్కువ João Browser ఎక్స్‌టెన్షన్‌లు 1 USB డివైజ్‌ను యాక్సెస్ చేస్తున్నాయి}=1{1 USB డివైజ్ ఒకటి లేదా అంతకంటే ఎక్కువ João Browser ఎక్స్‌టెన్షన్‌ల ద్వారా యాక్సెస్ చేయబడుతోంది}other{ఒకటి లేదా అంతకంటే ఎక్కువ João Browser ఎక్స్‌టెన్షన్‌లు # USB డివైజ్‌లను యాక్సెస్ చేస్తున్నాయి}}</translation>
<translation id="3413144813287436446">João Browser హిస్టరీ</translation>
<translation id="9192419056064225629">ఇన్‌స్టాలర్ ఆర్కైవ్‌ను వాస్తవ పరిమాణానికి తీసుకుని రావడంలో విఫలమైంది. దయచేసి João Browserను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="310459126943037700">టాస్క్(లు) ముగించడంలో విఫలమైంది.</translation>
<translation id="3104828284009500087">పేజీలో ఏదైనా సెర్చ్ చేయండి</translation>
<translation id="3508468328135806512">మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, హిస్టరీని డివైజ్‌లన్నింటిలో పర్‌ఫెక్ట్‌గా సింక్ చేసి ఉంచుకోండి. మీ ఆటోమేటిక్ బ్రౌజర్‌ను João Browserకు అప్‌డేట్ చేయడం ద్వారా మీకు తెలిసిన, మీరు ఇష్టపడే ఫీచర్‌లను సులభంగా యాక్సెస్ చేయండి.</translation>
<translation id="3216151988142306917">João Browser మీ మైక్రోఫోన్‌ని ఉపయోగిస్తోంది.</translation>
<translation id="3130333203120345554">కొత్త సెర్చ్</translation>
<translation id="3137969841538672700">సెర్చ్ చేయడానికి ఇమేజ్‌లో కొంత భాగాన్ని ఎంచుకోండి</translation>
<translation id="7493177208577109722">ఈ ట్యాబ్ అదనపు రిసోర్స్‌లను ఉపయోగిస్తోంది. మీ పనితీరును మెరుగుపరచడానికి, దాన్ని ఇన్‌యాక్టివ్‌గా ఉంచడానికి João Browserకు అనుమతినివ్వండి.</translation>
<translation id="7239354789967255675">మీ స్క్రీన్‌ను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో João Browser కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి</translation>
<translation id="4955872590603594814">João Browserను పునఃప్రారంభించండి</translation>
<translation id="3161522574479303604">అన్ని భాషలు</translation>
<translation id="4697739132113629685">João Browser అజ్ఞా&amp;త విండోలో లింక్‌ను తెరువు</translation>
<translation id="1629247860984475766">మీ కొత్త João Browser ప్రొఫైల్‌ను అనుకూలంగా మార్చుకోండి</translation>
<translation id="1905008150929775692">మీరు ట్యాబ్‌లను మార్చకుండానే AI మోడ్‌తో చాట్ చేయవచ్చు. ప్రారంభించడానికి, João Browserకు సైన్ ఇన్ చేయండి. మీ డివైజ్‌లన్నిటిలో మీ పాస్‌వర్డ్‌లు, మరిన్ని ప్రయోజనాలను కూడా పొందుతారు.</translation>
<translation id="4232381420311815141">João Browser నుండి మీ Google ఖాతాను తీసివేయడానికి, సెట్టింగ్‌ల పేజీలోని João Browser నుండి సైన్ అవుట్ చేయండి</translation>
<translation id="3234316605225071811">తర్వాత, మీ కోసం ఫారమ్‌లను ఆటోఫిల్ చేయడానికి సేవ్ చేసిన సమాచారాన్ని ఉపయోగించాలనుకుంటున్నారా అని Chromium అడగవచ్చు</translation>
<translation id="6676749542734993844">João Browser దీని డేటా డైరెక్టరీని చదవలేదు మరియు దీనిలో రాయ‌లేదు: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">iOSలోని João Browserతో మీకు నచ్చిన Google AI టూల్స్‌ను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి.</translation>
<translation id="3286538390144397061">ఇప్పుడు పునఃప్రారంభించండి</translation>
<translation id="532528773927600103">Google API కీలు లేవు. João Browser కార్యాచరణలో కొంత భాగం నిలిపివేయబడుతుంది.</translation>
<translation id="3296368748942286671">Chromium మూసివేయబడినప్పుడు నేపథ్య యాప్‌లను అమలు చేయడాన్ని కొనసాగించండి</translation>
<translation id="3313189106987092621">సురక్షితం కాని కనెక్షన్‌ను ఉపయోగించి ఏదైనా సైట్‌ను లోడ్ చేసే ముందు Chromium మిమ్మల్ని హెచ్చరిస్తుంది</translation>
<translation id="8095477191923518137">మీరు João Browserకు సైన్ ఇన్ చేసినట్లయితే, João Browser విండోలన్నింటినీ మూసివేసినప్పుడు, మీ Google ఖాతా మినహా, దాదాపుగా సైట్‌లన్నింటి నుండి సైన్ అవుట్ అవుతారు. మిమ్మల్ని సైట్‌లు గుర్తుంచుకోవడానికి, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">సెర్చ్ ఏరియాకు ఎగువ కుడి మూలన: కుడి వైపు <ph name="RIGHT" />%, ఎగువ <ph name="TOP" />%</translation>
<translation id="3366305173356742781">మీ ఖాతాలోని Chromium డేటా</translation>
<translation id="3234882977104294240">మీ ఫోన్‌లో João Browserతో మీ పాస్‌వర్డ్‌లను ఉపయోగించండి</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="2974199599420431595">ప్రస్తుతం ఉన్న João Browser ప్రొఫైల్‌కు స్విచ్ చేయాలా?</translation>
<translation id="3412460710772753638">ఈ పరికరంలోని పాస్‌వర్డ్ మేనేజర్‌లో</translation>
<translation id="3438772217992559640">"ఇమేజ్ సెర్చ్‌"తో ఈ ట్యాబ్‌ను సెర్చ్ చేయండి</translation>
<translation id="8318147705317768982">మీ ఫోన్‌లో João Browserతో మెరుగైన సురక్షిత బ్రౌజింగ్‌ను విస్తరించండి</translation>
<translation id="347392028839310978">మీరు కోరుకున్న విధంగా João Browser వ్యక్తిగతీకరించబడుతోంది...</translation>
<translation id="3474745554856756813">ఇది ఈ పరికరం నుండి <ph name="ITEMS_COUNT" /> అంశాలను తొలగిస్తుంది. మీ డేటాను తర్వాత తిరిగి పొందడానికి, Chromiumకు <ph name="USER_EMAIL" /> లాగా సైన్ ఇన్ చేయండి.</translation>
<translation id="5805833167703404998"><ph name="SHORTCUT" /> João Browser ప్రొఫైళ్ల మధ్య స్విచ్ చేయగలదు</translation>
<translation id="1835124883585653877">దయచేసి అన్ని João Browser విండోలను మూసివేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="7106246566966568195">మీ విండోను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో João Browser కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి</translation>
<translation id="6017005873246021363"><ph name="EXISTING_USER" />‌తో ఇప్పటికే సైన్ ఇన్ చేశారు.  మీ బ్రౌజింగ్‌ను ప్రత్యేకంగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />‌గా మీ స్వంత ప్రొఫైల్‌లో João Browserకి సైన్ ఇన్ చేయండి.</translation>
<translation id="1146681170626381319">మొబైల్ డివైజ్‌లలో João Browser బ్రౌజర్‌ను డౌన్‌లోడ్ చేయడానికి QR కోడ్</translation>
<translation id="354621070532799440">రిమైండర్: Google అత్యుత్తమ భద్రతా ఫీచర్‌లు ఇక ఎల్లప్పుడూ మీతోనే!</translation>
<translation id="2488701737291439763">మీ స్క్రీన్‌ను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో João Browser కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి.</translation>
<translation id="3588112919289558122">Chromium గుర్తించని సైట్‌లకు మెరుగైన రక్షణ JavaScript ఆప్టిమైజేషన్‌ను ఆఫ్ చేస్తుంది</translation>
<translation id="3597003331831379823">అదనపు అధికారాలతో సెటప్‌ను రన్ చేయడం విఫలమైంది. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">João Browserకు సైన్ ఇన్ చేయండి</translation>
<translation id="5985252758124395804">ఈ వ్యక్తి బ్రౌజింగ్ డేటా‌ ఈ పరికరం నుండి తొలగించబడుతుంది. డేటాను పునరుద్ధరించడానికి, <ph name="USER_EMAIL" />గా João Browserకు సైన్ ఇన్ చేయండి.</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{João Browserకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు పునఃప్రారంభించిన వెంటనే వర్తింపజేయబడుతుంది.}=1{João Browserకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు పునఃప్రారంభించిన వెంటనే వర్తింపజేయబడుతుంది. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{João Browserకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు పునఃప్రారంభించిన వెంటనే వర్తింపజేయబడుతుంది. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="3667616615096815454">ఇన్‌స్టాల్ చేయడం సాధ్యపడలేదు, అప్లికేషన్‌ను సర్వర్ గుర్తించలేదు.</translation>
<translation id="3675854891107786059">మీ Google ఖాతాలో Chromium డేటా మొత్తాన్ని ఎన్‌క్రిప్ట్ చేయడానికి మీ <ph name="BEGIN_LINK" />స్వంత రహస్య పదబంధాన్ని<ph name="END_LINK" /> ఉపయోగించండి. Google Pay నుండి పేమెంట్ ఆప్షన్‌లు, అడ్రస్‌లు ఎన్‌క్రిప్ట్ అవ్వవు. Chromiumకు చెందిన బ్రౌజింగ్ హిస్టరీ సింక్ అవ్వదు.</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{ఈ అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు João Browserను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు}=1{ఈ అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు João Browserను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{ఈ అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు João Browserను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="4134769722455445399">కొత్త João Browser &amp;ట్యాబ్‌లో లింక్‌ని తెరువు</translation>
<translation id="3728124580182886854">వ్యక్తిగతీకరణ, ఇతర ప్రయోజనాల కోసం Chromium, ఇతర Google సర్వీస్‌లను లింక్ చేయండి</translation>
<translation id="3729187154190517324">"ట్యాబ్‌ను, మరిన్నింటిని జోడించండి" బటన్‌ను ఉపయోగించి పలు ట్యాబ్‌లు, ఫైల్స్, టూల్స్‌ను జోడించడం ద్వారా మీ సెర్చ్‌ను మరింత లోతుగా చేయండి.</translation>
<translation id="655691042235349825">João Browser ప్రొఫైళ్లను మేనేజ్ చేయండి</translation>
<translation id="8494798931804571569">João Browser కొన్ని డౌన్‌లోడ్‌లను ఎందుకు బ్లాక్ చేస్తుందో తెలుసుకోండి</translation>
<translation id="379589255253486813">దేనికైనా మీ రివ్యూ అవసరం అయితే, Chromium మీకు తెలియజేస్తుంది</translation>
<translation id="3802055581630249637">Chromium మీరు చూసే అవకాశం ఉన్న పేజీలను ప్రీ - లోడ్ చేస్తుంది, తద్వారా మీరు వాటిని చూసినప్పుడు అవి మరింత త్వరగా లోడ్ అవుతాయి</translation>
<translation id="3810973564298564668">మేనేజ్ చేయండి</translation>
<translation id="6945066279282141856">మీరు సేవ్ చేసిన పాస్‌వర్డ్‌లను ఉపయోగించడానికి, QR కోడ్‌ను ఫాలో అయ్యి, iOSకు సంబంధించిన João Browserను డౌన్‌లోడ్ చేసి, ఆపై మీ Google ఖాతాకు సైన్ ఇన్ చేయండి</translation>
<translation id="3846683726093018685">**సారాంశం:** 30 పదాల కన్నా తక్కువ ఉన్న ఒక వాక్యంలో, స్క్రీన్‌షాట్‌లో ప్రధాన సబ్జెక్ట్, కంటెంట్ ఉద్దేశాన్ని వివరించండి.

          **ప్రశ్నలను సూచించండి:** స్క్రీన్‌షాట్‌ను బాగా అర్థం చేసుకోవడానికి యూజర్ అడగగలిగే ఆలోచనను రేకెత్తించే విధంగా ఉండే 3-5 ప్రశ్నల బుల్లెట్‌లతో కూడిన లిస్ట్‌ను జెనరేట్ చేయండి. ఈ ప్రశ్నలలో కనీసం ఒక విజువల్ ఆబ్జెక్ట్, దాని డిజైన్, లేదా దాని లొకేషన్‌కు సంబంధించి నిర్దిష్టంగా ఒక ప్రశ్న అయినా ఉండాలి.</translation>
<translation id="4996569675441627032"><ph name="PAGE_TITLE" /> - João Browser</translation>
<translation id="6008740052107737825">ఈ సైట్ కోసం João Browserకు లోకల్ నెట్‌వర్క్ అనుమతి అవసరం</translation>
<translation id="3885770153807205175">భాష సెలెక్టర్</translation>
<translation id="2390004682597453662">João Browserను అనుకూలంగా మార్చండి మరియు నియంత్రించండి. మీరు గమనించాల్సిన విషయం ఒకటి ఉంది - వివరాల కోసం క్లిక్ చేయండి.</translation>
<translation id="8262407643678629134">João Browserను తెరిచి, బ్రౌజింగ్‌ను ప్రారంభించడానికి మీ పేరును క్లిక్ చేయండి.</translation>
<translation id="3892148308691398805">టెక్స్ట్‌ను కాపీ చేయి</translation>
<translation id="2168201717554927204"><ph name="EXISTING_USER" /> ఇప్పటికే ఈ João Browser ప్రొఫైల్‌కు సైన్ ఇన్ చేశారు. మీరు బ్రౌజ్ చేసిన వాటిని విడిగా ఉంచడానికి, João Browser మీ కోసం మీ సొంత ప్రొఫైల్‌ను క్రియేట్ చేయగలదు.</translation>
<translation id="1046732460303790107">ఈ ఎక్స్‌టెన్ష‌న్ Chrome వెబ్ స్టోర్ పాలసీని ఉల్లంఘిస్తోంది, ఇది సురక్షితం కాకపోవచ్చు. João Browser నుండి దాన్ని తీసివేయండి, తద్వారా ఇది మీ వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="3941890832296813527">ఇన్‌స్టలేషన్ ఎర్రర్: ఇన్‌స్టాలర్ ఫైల్ పేరు చెల్లదు లేదా సపోర్ట్ చేయదు.</translation>
<translation id="3879366121647289622">పాస్‌వర్డ్‌లను కాపీ చేయడానికి João Browser ప్రయత్నిస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="7332365758981378072">మీరు Google ఖాతాలో సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, పేమెంట్ ఆప్షన్‌లు, ఇంకా అడ్రస్‌లు ఈ పరికరం నుండి తీసివేయబడతాయి. వాటిని మళ్లీ João Browserలో ఉపయోగించడానికి, తిరిగి సైన్ ఇన్ చేయండి.</translation>
<translation id="395904275706073188">ప్రొటెక్షన్ ఉన్న పేజీలను రీడ్ చేయడం సాధ్యం కాలేదు. వేరే పేజీని ట్రై చేయండి.</translation>
<translation id="3962647064319009959">Chromium మిమ్మల్ని ఎలా సురక్షితంగా ఉంచుతుందో తెలుసుకోండి</translation>
<translation id="3967822245660637423">డౌన్‌లోడ్ పూర్తయింది</translation>
<translation id="3971865010372729242">మీరు అడ్రస్ బార్ లేదా సెర్చ్ బాక్స్‌లో టైప్ చేసినప్పుడు, Chromium మీరు టైప్ చేసే దాన్ని మీ సంస్థకు సంబంధించిన సెర్చ్, AI, ఇంకా ఏజెంట్ టూల్స్‌కు పంపి, మీకు సూచనలను అందిస్తుంది.</translation>
<translation id="3975724895399328945">&amp;Google Chrome for Testing పరిచయం</translation>
<translation id="3997429360543082038">ChromiumOS గురించి</translation>
<translation id="4010059961270896984">మీరు సైట్‌కు వెళ్లినప్పుడు, Chromium మీ IP అడ్రస్‌ను దాచిపెట్టే గోప్యతా సర్వర్ ద్వారా URLకు సంబంధించిన గందరగోళానికి గురి చేసే భాగాన్ని <ph name="BEGIN_LINK" />Google సురక్షిత బ్రౌజింగ్<ph name="END_LINK" />కు పంపుతుంది. ఏదైనా సైట్ అనుమానాస్పదంగా ఉంటే, పూర్తి URLలు, పేజీ కంటెంట్‌కు సంబంధించిన బిట్‌లు కూడా పంపబడతాయి.</translation>
<translation id="4016217212818346953">Password Managerతో సురక్షితంగా ఉండండి</translation>
<translation id="4019629340646866719">ChromiumOS అనేది <ph name="BEGIN_LINK_LINUX_OSS" />Linux డెవలప్‌మెంట్ ఎన్విరాన్‌మెంట్<ph name="END_LINK_LINUX_OSS" /> తరహాలోనే, అదనపు <ph name="BEGIN_LINK_CROS_OSS" />ఓపెన్ సోర్స్ సాఫ్ట్‌వేర్<ph name="END_LINK_CROS_OSS" /> ద్వారా సాధ్యమైంది.</translation>
<translation id="4022972681110646219">స్క్రీన్‌ను అనువదించండి</translation>
<translation id="4023601594785368013">అసలు భాష: <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">ఏదైనా యాప్ నుండి João Browserలో లింక్‌లను తెరవండి. అలాగే సులభంగా యాక్సెస్ చేయడానికి, అది మీ టాస్క్‌బార్‌కు పిన్ అవుతుంది.</translation>
<translation id="4036079820698952681"><ph name="BEGIN_LINK" />ప్రస్తుత సెట్టింగ్‌లను<ph name="END_LINK" /> రిపోర్ట్ చేయడం ద్వారా Chromiumను మెరుగుపరచడంలో సహాయపడండి</translation>
<translation id="4050175100176540509">ముఖ్యమైన భద్రతా మెరుగుదలలు మరియు కొత్త ఫీచర్‌లు తాజా వెర్షన్‌లో అందుబాటులో ఉన్నాయి.</translation>
<translation id="4055805654398742145">Password Manager</translation>
<translation id="615818333141511791">{COUNT,plural, =1{João Browserను 1 నిమిషం పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది. బ్రౌజింగ్ డేటాను తొలగించడం జరుగుతుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు.}other{João Browserను # నిమిషాల పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది. బ్రౌజింగ్ డేటాను తొలగించడం జరుగుతుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు.}}</translation>
<translation id="4118474109249235144">Chromium అజ్ఞాత మోడ్</translation>
<translation id="4122186850977583290">Chromium పేజీ వివరాలకు వెళ్లండి</translation>
<translation id="9207280419664362385">మీ బ్రౌజర్‌కు కొత్త రూపాన్ని అందించడానికి João Browserను అనుకూలంగా మార్చండి</translation>
<translation id="3719803995198923598">మీ João Browserను అనుకూలంగా మార్చండి</translation>
<translation id="4148957013307229264">వ్యవస్థాపిస్తోంది...</translation>
<translation id="2954462321765112214"><ph name="PAGE_TITLE" /> - నెట్‌వర్క్ సైన్ ఇన్ - João Browser</translation>
<translation id="7812363663832111420">João Browser కోసం గొప్ప యాప్‌లు, ఆటలు, ఎక్స్‌టెన్షన్‌లు మరియు థీమ్‌లను కనుగొనండి.</translation>
<translation id="69200600645763018">మీ కంప్యూటర్‌లన్నింటిలో ఈ ఎక్స్‌టెన్షన్‌తో పాటు మరిన్నింటిని పొందడానికి João Browserకు సైన్ ఇన్ చేయండి</translation>
<translation id="7505863944027312744">మీ తల్లి/తండ్రి ఛాయిస్‌లతో ఆన్‌లైన్‌లో సురక్షితంగా ఉండటానికి, మీరు ఇప్పటికే <ph name="USER_EMAIL_ADDRESS" />‌గా సైన్ ఇన్ చేసిన మీ João Browser ప్రొఫైల్‌కు మారండి</translation>
<translation id="4222932583846282852">రద్దు చేస్తోంది...</translation>
<translation id="4224210481850767180">ఇన్‌స్టాలేషన్ రద్దు చేయబడింది.</translation>
<translation id="8090594705972340646">మీ João Browser డేటాను ఈ ఖాతాకు జోడించాలా?</translation>
<translation id="4251772536351901305">స్టాండర్డ్ రక్షణ కంటే ఎక్కువగా సైట్‌లలోని డేటాను విశ్లేషించి, Googleకు మనుపెన్నడూ తెలియని ప్రమాదకరమైన సైట్‌ల గురించి కూడా ఇది హెచ్చరిస్తుంది. Chromium హెచ్చరికలను స్కిప్ చేయడానికి మీరు ఎంచుకోవచ్చు.</translation>
<translation id="5696119579094527589">João Browser నుండి సైన్ అవుట్ చేయండి</translation>
<translation id="4271805377592243930">Chromium గురించి సహాయాన్ని పొందండి</translation>
<translation id="4281844954008187215">సర్వీస్ నియమాలు</translation>
<translation id="1245307320228150348">పేర్కొనబడని ఎర్రర్ కారణంగా ఇన్‌స్టాలేషన్ విఫలమైంది. ప్రస్తుతం João Browser అమలు చేయబడుతుంటే, దయచేసి దీనిని మూసివేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="7405356088321579627">João Browser నుండి పాస్‌వర్డ్‌లను ఎగుమతి చేయండి</translation>
<translation id="4304713468139749426">పాస్‌వర్డ్ మేనేజర్</translation>
<translation id="4334241893986177674">ఈ స్క్రీన్‌షాట్ కోసం సెర్చ్ చేయండి</translation>
<translation id="212570256141568951">Windows ప్రారంభమైనప్పుడు João Browserను ప్రారంభించండి</translation>
<translation id="4400772909124543403">అప్‌డేట్ ఏదీ అందుబాటులో లేదు</translation>
<translation id="7463042547966071103">ఏదేమైనా João Browser నుండి నిష్క్రమించాలా?</translation>
<translation id="4413205837991854510">ఇమేజ్ సెర్చ్ షార్ట్‌కట్‌ను ఎల్లప్పుడూ చూపించండి</translation>
<translation id="4736206301215400753">బ్యాక్‌గ్రౌండ్‌లో అమలయ్యేందుకు João Browserని అనుమతించండి</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{మీరు దాన్ని తీసివేయవలసిందిగా João Browser సిఫార్సు చేస్తోంది. <ph name="BEGIN_LINK" />సపోర్ట్ చేసే ఎక్స్‌టెన్షన్‌ల గురించి మరింత తెలుసుకోండి<ph name="END_LINK" />}other{మీరు వాటిని తీసివేయవలసిందిగా João Browser సిఫార్సు చేస్తోంది. <ph name="BEGIN_LINK" />సపోర్ట్ చేసే ఎక్స్‌టెన్షన్‌ల గురించి మరింత తెలుసుకోండి<ph name="END_LINK" />}}</translation>
<translation id="5305058100936019600">João Browserను అనుకూలంగా మార్చండి మరియు నియంత్రించండి</translation>
<translation id="4427306783828095590">ఫిషింగ్, అలాగే మాల్‌వేర్‌ను బ్లాక్ చేయడానికి మెరుగుపరచిన రక్షణ మరింత చేయగలదు</translation>
<translation id="4434353761996769206">ఇన్‌స్టాలర్ ఎర్రర్: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3461955321878243607"><ph name="MANAGER" />, João Browserను మేనేజ్ చేస్తుంది</translation>
<translation id="3379477508903866078">João Browser ప్రొఫైల్‌ను జోడించండి</translation>
<translation id="4447409407328223819">Chrome for Testing పరిచయం</translation>
<translation id="4074057296993529937">మీ Google ఖాతాలోని João Browser డేటాను ఉపయోగించడానికి, అందులో డేటాను సేవ్ చేయడానికి, మీ రహస్య పదబంధాన్ని ఎంటర్ చేయండి</translation>
<translation id="4493028449971051158">స్టార్టప్ ఎర్రర్: దయచేసి ఇన్‌స్టాలర్‌ను అడ్మినిస్ట్రేటర్‌గా రన్ చేయండి.</translation>
<translation id="4501471624619070934">ఈ దేశంలో యాక్సెస్ పరిమితం చేయబడినందున ఇన్‌స్టలేషన్ విఫలమైంది.</translation>
<translation id="8624811527667906941">ఈ ఎక్స్‌టెన్షన్ అది డేటాను ఎలా సేకరిస్తుంది, దాన్ని ఎలా ఉపయోగిస్తుంది వంటి గోప్యతా పద్ధతులను పబ్లిష్ చేయలేదు. మీరు దాన్ని తీసివేయవలసిందిగా João Browser సిఫార్సు చేస్తోంది.</translation>
<translation id="5571435860030744559">João Browserకు స్వాగతం; కొత్త బ్రౌజర్ విండో తెరవబడింది</translation>
<translation id="8132016625974854930">మీ పరిసరాలను మ్యాప్ చేయడానికి, మీ చేతి సంజ్ఞలు అలాగే కదలికలను ట్రాక్ చేయడానికి João Browserకి అనుమతి అవసరం</translation>
<translation id="6599071882590417739">మీరు ఇప్పటికే మరొక João Browser ప్రొఫైల్‌లో <ph name="USER_EMAIL_ADDRESS" />‌గా సైన్ ఇన్ చేశారు</translation>
<translation id="4548534452171747496">Chromium పేజీలను ప్రీ - లోడ్ చేస్తుంది, దీని వల్ల బ్రౌజింగ్, సెర్చింగ్ త్వరగా అవుతుంది. <ph name="BEGIN_LINK" />ప్రీ - లోడ్ పేజీల గురించి మరింత తెలుసుకోండి<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">మీరు హానికరమని భావించే సైట్‌ను రిపోర్ట్ చేసినప్పుడు అందరికీ ఆన్‌లైన్ భద్రతను మెరుగుపరచండి.</translation>
<translation id="202208802191333704">మీరు సురక్షిత బ్రౌజింగ్‌ను ఆఫ్ చేశారు అలాగే ఫైల్‌ను వెరిఫై చేయడం సాధ్యం కానందున João Browser ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="3128308674776200516">మీ ఫోన్‌లో João Browserతో Google Lensను ట్రై చేయండి</translation>
<translation id="4594305310729380060">ఈ పరికరంలోని పాస్‌వర్డ్ మేనేజర్‌కు</translation>
<translation id="7653380076752216509">João Browser యాప్‌లు</translation>
<translation id="4598116752460667024">లిస్ట్ నుండి ఏదైనా ప్రాసెస్ కోసం సెర్చ్ చేయండి.</translation>
<translation id="4613863813562375431">ChromiumOS వెర్షన్</translation>
<translation id="4621240073146040695">దాదాపుగా నవీకృతంగా ఉంది! అప్‌డేట్‌ను పూర్తి చేయడానికి Chromiumని పునఃప్రారంభించండి.</translation>
<translation id="1497446027991908251">João Browserకు చెందిన V8 ఇంజిన్, వెబ్‌సైట్లను స్పీడ్‌గా లోడ్ చేస్తుంది. అయితే సైబర్ అటాక్‌ల‌ను ఎదుర్కోవ‌డంలో తక్కువ రెసిస్టెన్స్‌ను (నిరోధకతను) చూపిస్తుంది</translation>
<translation id="7523749920868634278">హెచ్చరిక: João Browser మీ బ్రౌజింగ్ హిస్టరీను రికార్డ్ చేయకుండా ఎక్స్‌టెన్ష‌న్‌లను నివారించలేదు. ఈ ఎక్స్‌టెన్ష‌న్‌ను అజ్ఞాత మోడ్‌లో డిజేబుల్ చేయడానికి, ఈ ఆప్షన్‌ను రద్దు చేయండి.</translation>
<translation id="4673151026126227699">మీరు Chromium వినియోగ రిపోర్ట్‌లను కూడా షేర్ చేస్తున్నట్లయితే, ఆ రిపోర్ట్‌లలో మీరు సందర్శించే URLలు ఉంటాయి</translation>
<translation id="4673710618874938871">మీరు మెంబర్‌షిప్ ఉన్న <ph name="USER_NAME" />‌గా సైన్ ఇన్ చేశారు. ఖాతా మెనూను తెరవండి</translation>
<translation id="6608258642372806522">ఈ ప్రొఫైల్‌ను మరొక కంప్యూటర్ (<ph name="HOST_NAME" />)లో మరో João Browser ప్రాసెస్ (<ph name="PROCESS_ID" />) ఉపయోగిస్తున్నట్లు కనిపిస్తోంది. João Browser ప్రొఫైల్‌ను లాక్ చేసినందున అది పాడవదు. ఈ ప్రొఫైల్‌ను వేరే ప్రాసెస్‌లు ఏవీ ఉపయోగించడం లేదని మీకు ఖచ్చితంగా తెలిస్తే, ప్రొఫైల్‌ను అన్‌లాక్ చేసి João Browserను మళ్లీ ప్రారంభించవచ్చు.</translation>
<translation id="4680828127924988555">ఇన్‌స్టాలేషన్‌ను రద్దు చేయండి</translation>
<translation id="3912572071294857936">మీ João Browser డేటాలో కొంత భాగం ఇంకా మీ Google ఖాతాలో సేవ్ కాలేదు. సైన్ అవుట్ చేయడానికి ముందు, కొన్ని నిమిషాలు వేచి ఉండటానికి ట్రై చేయండి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా తొలగించబడుతుంది.</translation>
<translation id="1077152188344040592">మీరు సైన్ ఇన్ చేసినప్పుడు, João Browserలో మీ Google ఖాతా నుండి సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, మరిన్నింటిని ఉపయోగించవచ్చు. <ph name="SHORTCUT" /> మీ Google సర్వీస్‌ల సెట్టింగ్‌లను మార్చగలదు.</translation>
<translation id="5729536702149847030">ఒకరు ఈ కంప్యూటర్‌లో మునుపు <ph name="ACCOUNT_EMAIL_LAST" /> లాగా João Browserకు సైన్ ఇన్ చేశారు. దయచేసి మీ సమాచారాన్ని విడిగా ఉంచేందుకు కొత్త João Browser వినియోగదారును క్రియేట్ చేయండి.</translation>
<translation id="4724676981607797757">సపోర్ట్ చేయని ప్రోటోకాల్ ఎర్రర్ కారణంగా ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="6273241729694500032">ఏదేమైనా João Browserని మూసివేయాలా?</translation>
<translation id="3239680024825449390">João Browserకి సంబంధించిన ప్రత్యేక భద్రతా అప్‌డేట్ వర్తింపజేయబడింది. ఇప్పుడే పునఃప్రారంభించండి, మేము మీ ట్యాబ్‌లను పునరుద్ధరిస్తాము.</translation>
<translation id="4771701986670315895">మీరు ఇటీవల వెళ్లలేదు. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, మరో <ph name="COUNT" />‌ను తీసివేసింది.</translation>
<translation id="1908292729364083164">João Browserలో Gemini తెరిచి ఉంటే, కొత్త ట్యాబ్‌లను క్రియేట్ చేసేటప్పుడు సైడ్ ప్యానెల్ తెరిచి ఉంటుంది</translation>
<translation id="479167709087336770">Google Searchలో ఉపయోగించే స్పెల్ చెకర్‌నే ఇది ఉపయోగిస్తుంది. మీరు బ్రౌజర్‌లో టైప్ చేసే టెక్స్ట్‌ను Googleకు పంపుతుంది. ఈ ఆప్షన్‌ను తర్వాత ఎప్పుడైనా మీరు సెట్టింగ్‌లలో మార్చవచ్చు.</translation>
<translation id="189382710647501724">ఖాతా లేకుండా João Browserను ఉపయోగించండి</translation>
<translation id="4456919965836032212">mDNS ట్రాఫిక్‌ను అనుమతించడానికి João Browser ఇన్‌బౌండ్ నియమం.</translation>
<translation id="3486986778673504636">&amp;João Browserను అప్‌డేట్ చేయడానికి రీ-లాంచ్ చేయండి</translation>
<translation id="4918086044614829423">ఆమోదించు</translation>
<translation id="4918844574251943176">ఇమేజ్ కాపీ చేయబడింది</translation>
<translation id="1571932028747131277">João Browser నేపథ్య మోడ్‌లో ఉంది.</translation>
<translation id="7612124006067933008">క్లిక్ చేసి, João Browser సైన్ ఇన్ డైలాగ్‌ను మూసివేయండి</translation>
<translation id="2598788273876744576">João Browser ప్రొఫైళ్లతో, మీ João Browser సంబంధిత అంశాలన్నింటినీ విభజించవచ్చు. ఫ్రెండ్స్, ఫ్యామిలీ కోసం ప్రొఫైళ్లను క్రియేట్ చేయండి, లేదా ఆఫీస్, వినోదం మధ్య ప్రొఫైళ్లను విభజించి ఉపయోగించండి.</translation>
<translation id="2115498792600385171">గెస్ట్‌లు ఎటువంటి హిస్టరీని వదలకుండానే João Browserను ఉపయోగించవచ్చు.</translation>
<translation id="6870732303439257966">João Browserలో మీ ఖాతా</translation>
<translation id="4366792189726044065">João Browserకు మిమ్మల్ని జోడించుకోండి</translation>
<translation id="504699503110800016">ఓవర్‌ఫ్లో మెనూను ఓపెన్ చేయండి</translation>
<translation id="4340125167559705618">మీ <ph name="DEVICE_TYPE" />‌లో João Browserతో మీకు ఇష్టమైన Google ఫీచర్‌లన్నింటినీ యాక్సెస్ చేయండి</translation>
<translation id="4916697359431064123">João Browser మీ హ్యాండ్స్‌ను ట్రాక్ చేయడానికి అనుమతి అవసరం</translation>
<translation id="5141988424377517949">మీరు ఇటీవల వెళ్లలేదు. Chromium <ph name="PERMISSION_1" />,‌ <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />ను తీసివేసింది.</translation>
<translation id="5174969993834422967">మీరు సాధారణంగా నోటిఫికేషన్‌లను బ్లాక్ చేస్తుంటారు. ఈ సైట్ నుండి నోటిఫికేషన్‌లను పొందాలంటే, మీ లొకేషన్ బార్ కుడి మూలన ఉన్న నోటిఫికేషన్ చిహ్నాన్ని క్లిక్ చేయండి.</translation>
<translation id="5174983315706567306">తగినంత డిస్క్ స్పేస్ లేదు.</translation>
<translation id="961070648267203077">João Browser ఖాతాకు మళ్లీ ప్రామాణీకరణ అనసరమవుతుంది</translation>
<translation id="69363826605946518">iOSలో João Browserతో మీరు ఎక్కడ ఆపారో అక్కడి నుండే కొనసాగించండి.</translation>
<translation id="471694954923709047">João Browser నుండి సైన్ అవుట్ చేయండి</translation>
<translation id="5234764350956374838">తొలగించండి</translation>
<translation id="5782956358171235578">João Browser అజ్ఞా&amp;త విండోలో లింక్‌ను తెరువు</translation>
<translation id="903712329052383264">ప్రయాణంలో పాస్‌వర్డ్‌లను సేవ్ చేయడానికి João Browser యాప్‌ను పొందండి</translation>
<translation id="5277894862589591112">మీ మార్పులను వర్తింపజేయడానికి, Chromiumని పునఃప్రారంభించండి</translation>
<translation id="5286907366254680517">గుర్తించబడింది</translation>
<translation id="5593827909938092728">João Browser యాప్‌ను పొందండి</translation>
<translation id="5294316920224716406">అజ్ఞాత మోడ్‌లో బ్రౌజ్ చేస్తున్నప్పుడు, సురక్షితం కాని కనెక్షన్‌ను ఉపయోగించి సైట్‌ను లోడ్ చేసే ముందు Chromium మిమ్మల్ని హెచ్చరిస్తుంది</translation>
<translation id="1066981078513393795">João Browser అప్‌డేటర్ ఇంటర్నల్ సర్వీస్</translation>
<translation id="5324450571874973775">Chromiumలో ఇతర Gemini ఫీచర్‌లతో పాటు వాటిని ఉపయోగించండి</translation>
<translation id="5346389065299425353">పలు ట్యాబ్‌లు, ఫైల్స్, టూల్స్‌ను జోడించడం ద్వారా మీ సెర్చ్‌ను మరింత లోతుగా చేయండి</translation>
<translation id="1884203704972162365">ఈ డాక్యుమెంట్ క్విక్ ఓవర్‌వ్యూను పొందండి, João Browserలో Geminiతో ప్రశ్నలు అడగండి</translation>
<translation id="5352264705793813212">Chromium మీ రివ్యూ కోసం కొన్ని భద్రతా సిఫార్సులను కనుగొంది</translation>
<translation id="4819697639570429319">ఇతర João Browser ప్రొఫైల్స్</translation>
<translation id="7878591304929138776">మీ ఖాతా సైన్-ఇన్ వివరాలు అవుట్-ఆఫ్-డేట్ అయినందున (కాలం చెల్లినందున), ChromiumOS మీ Google ఖాతాలో João Browser డేటాను సేవ్ చేయలేకపోయింది</translation>
<translation id="5249614051186670898">మీరు నిర్వహించబడే ఖాతాతో సైన్ ఇన్ చేస్తున్నారు. దీని నిర్వాహకునికి మీ João Browser ప్రొఫైల్‌పై నియంత్రణను అందిస్తున్నారు. మీ యాప్‌లు, బుక్‌మార్క్‌లు, హిస్టరీ, పాస్‌వర్డ్‌లు, ఇతర సెట్టింగ్‌ల వంటి మీ João Browser డేటా శాశ్వతంగా <ph name="USER_NAME" />కు అనుబంధించబడుతుంది. మీరు Google ఖాతాల డ్యాష్‌బోర్డ్ ద్వారా ఈ డేటాను తొలగించవచ్చు. కానీ ఈ డేటాను మరో ఖాతాతో అనుబంధించలేరు. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">అదనపు కోడ్: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">వ్యక్తిగతీకరణను పొందడానికి, వెబ్ &amp; యాప్ యాక్టివిటీలో Chromiumను చేర్చండి</translation>
<translation id="108952623091824942">João Browser కొన్ని ఫైల్స్‌ను ఎందుకు బ్లాక్ చేస్తుందో తెలుసుకోండి</translation>
<translation id="5386450000063123300">Chromium నవీకరించబడుతోంది (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Chromium సైన్-ఇన్‌ని అనుమతించండి</translation>
<translation id="1265086181910844216">João Browser నుండి తీసివేయండి</translation>
<translation id="1500700851187484222">పనితీరును తగ్గిస్తుంది, కానీ João Browser, సైబర్ అటాక్‌ల‌ను ఎదుర్కోవ‌డంలో ఎక్కువ రెసిస్టెన్స్‌ను (నిరోధకతను) చూపిస్తుంది</translation>
<translation id="6665657403278704382">João Browserను మీ డిఫాల్ట్ బ్రౌజర్‌గా సెట్ చేయండి</translation>
<translation id="3520901681432894293"><ph name="PAGE_TITLE" /> - João Browser బీటా</translation>
<translation id="5994273394215159270">{NUM_TABS,plural, =1{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌ను పాజ్ చేయమని João Browser సిఫార్సు చేస్తుంది}other{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌లను పాజ్ చేయమని João Browser సిఫార్సు చేస్తుంది}}</translation>
<translation id="646791423998269453">João Browserకు ఇక ఈ Linux డిస్ట్రిబ్యూషన్‌లో సపోర్ట్ లేనందున అది సరిగ్గా పని చేయకపోవచ్చు</translation>
<translation id="7249139852479053716">ఈ డౌన్‌లోడ్‌ను João Browser బ్లాక్ చేసింది, ఎందుకంటే మీ వ్యక్తిగత, సోషల్ నెట్‌వర్క్ ఖాతాలకు ఆ ఫైల్ హాని కలిగించగలదు</translation>
<translation id="478612683981218420">దయచేసి João Browser తాజా సిస్టమ్ అప్‌డేట్‌లను ఇన్‌స్టాల్ చేస్తున్నప్పుడు వేచి ఉండండి.</translation>
<translation id="3466187211963597724">పాస్‌వర్డ్‌లను ఎడిట్ చేయడానికి João Browser ప్రయత్నిస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="3133978491361824131">João Browserతో ప్రయాణంలోనూ Google Drive, YouTube వంటి మీకు ఇష్టమైన యాప్‌లను అవాంతరాలు లేకుండా సులభంగా ఉపయోగించుకోండి.</translation>
<translation id="5524890928877629608">సెర్చ్ ఏరియాకు ఎగువ ఎడమ మూలన: ఎడమ వైపు <ph name="LEFT" />%, ఎగువ <ph name="TOP" />%</translation>
<translation id="5527463683072221100">Chromiumలో PDFలను తెరవండి</translation>
<translation id="5536164441519929134">ఈ ట్యాబ్ గురించి<ph name="LINE_BREAK" />అడగండి</translation>
<translation id="3902123582863904748">సెక్యూరిటీ కోసం, మీరు మొదటిసారి సైట్‌ను సందర్శించినప్పుడు João Browser, JavaScript ఆప్టిమైజేషన్‌ను ఆఫ్ చేస్తుంది.

ఈ పేజీ ఆశించిన విధంగా పని చేయకపోతే, ఆప్టిమైజేషన్‌ను అనుమతించడానికి ట్రై చేయండి.</translation>
<translation id="5924481826213021755">Mac మెనూ బార్‌లో João Browserలో Geminiని కనిపించేలా చేసి, కీబోర్డ్ షార్ట్‌కట్‌ను ఆన్ చేయండి</translation>
<translation id="4988760628116707723"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో João Browserకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE" /> నుండి సేవ్ చేసిన మీ సమాచారాన్ని, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="5579324208890605088">స్టార్టప్ ఎర్రర్: దయచేసి ఇన్‌స్టాలర్‌ను అడ్మినిస్ట్రేటర్‌గా కాకుండా ఒక సాధారణ యూజర్‌గా రన్ చేయండి.</translation>
<translation id="697769674160644707">పిన్ అయ్యేలా చేయడానికి ఆటోమేటిక్‌గా João Browserను ఉపయోగించండి</translation>
<translation id="5596627076506792578">మరిన్ని ఆప్షన్‌లు</translation>
<translation id="5605834417512968703">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడానికి ఏదైనా ఎంచుకోండి లేదా ఇమేజ్ సెర్చ్ నుండి ఎగ్జిట్ అవ్వడానికి Escapeను నొక్కండి</translation>
<translation id="5618818588972826921">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడానికి ఏదైనా టెక్స్ట్ లేదా ఇమేజ్‌ను ఎంచుకోండి లేదా ఇమేజ్ సెర్చ్ నుండి ఎగ్జిట్ అవ్వడానికి Escapeను నొక్కండి</translation>
<translation id="2497422928854452258">{0,plural, =0{ఒక João Browser అప్‌డేట్ అందుబాటులో ఉంది}=1{ఒక João Browser అప్‌డేట్ అందుబాటులో ఉంది}other{ఒక João Browser అప్‌డేట్ # రోజులుగా అందుబాటులో ఉంది}}</translation>
<translation id="5643865575100044307">మీరు Chromiumను మూసివేసినప్పుడల్లా మీ పరికరంలోని సైట్ డేటాను తొలగించండి</translation>
<translation id="620465883043431255">దయచేసి ఇప్పుడు João Browserను మళ్ళీ ప్రారంభించండి</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Chromiumను ఈ భాషలో ప్రదర్శించు</translation>
<translation id="569897634095159764">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. ప్రాక్సీ సర్వర్ ప్రామాణీకరణ కోరుతోంది.</translation>
<translation id="5768371961535086509">Chromium ఇన్‌యాక్టివ్ ట్యాబ్‌ల నుండి మెమరీని ఖాళీ చేస్తుంది. దీని ద్వారా యాక్టివ్ ట్యాబ్‌లకు, ఇతర యాప్‌లకు మరిన్ని కంప్యూటర్ రిసోర్స్‌లు లభిస్తాయి, దీనితో Chromium వేగంగా పని చేస్తుంది. మీ ఇన్‌యాక్టివ్ ట్యాబ్‌లకు మీరు తిరిగి వచ్చినప్పుడు, అవి ఆటోమేటిక్‌గా మళ్లీ యాక్టివ్‌గా మారతాయి. <ph name="BEGIN_LINK" />మెమరీ సేవర్ గురించి మరింత తెలుసుకోండి<ph name="END_LINK" /></translation>
<translation id="8866372822266732235">మీ రహస్య పదబంధాన్ని మీరు మర్చిపోయినా లేదా ఈ సెట్టింగ్‌ను మార్చాలనుకున్నా, మీ ఖాతాలోని João Browser డేటాను <ph name="SETTINGS_LINK" /></translation>
<translation id="2106070764285625641">João Browserను అనుకూలంగా మార్చండి, కంట్రోల్ చేయండి. João Browserను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయండి.</translation>
<translation id="9077878413488413377">João Browserను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసుకోవడం ద్వారా, మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, హిస్టరీని డివైజ్‌లన్నింటిలో పర్‌ఫెక్ట్‌గా సింక్ చేసి ఉంచుకోండి.</translation>
<translation id="5809516625706423866">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. HTTP 401 అనధికార యాక్సెస్. దయచేసి మీ ప్రాక్సీ కాన్ఫిగరేషన్‌ను చెక్ చేయండి.</translation>
<translation id="614221876503883218">João Browser V8 ఇంజిన్‌తో సైట్‌లను వేగవంతం చేస్తుంది కానీ João Browser అటాక్‌లకు కొద్దిగా తక్కువ నిరోధకతను కలిగిస్తుంది. ఈ సెట్టింగ్ ఆఫ్ చేయబడింది.</translation>
<translation id="8788365803279840995">మీ Google ఖాతాలో João Browser డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి, João Browserను అప్‌డేట్ చేయండి</translation>
<translation id="5824893331272123205">ఈ ప్యానెల్‌ను లోడ్ చేయడం సాధ్యపడలేదు, మళ్లీ ట్రై చేయండి</translation>
<translation id="5805760187441013922">João Browserకు స్వాగతం</translation>
<translation id="5867606647614813312">Chromium అత్యంత శక్తివంతమైన రక్షణలను అందించడానికి అదనపు ఫీచర్‌లను ఆన్ చేస్తుంది</translation>
<translation id="5871205389137001634">ఇమేజ్ సెర్చ్‌ నుండి ఎగ్జిట్ అవ్వడానికి క్లిక్ చేయండి</translation>
<translation id="8367098380158627809">ఈ ఐటెమ్‌లు మాల్‌వేర్‌ను కలిగి ఉన్నట్టుగా João Browser కనుగొన్నది:</translation>
<translation id="5889361821821684993">మీ బ్రౌజర్ సెట్టింగ్‌లు అత్యంత సురక్షితంగా ఉండేలా చూసుకోవడానికి Chromium క్రమం తప్పకుండా చెక్ చేస్తూ ఉంటుంది. దేనికైనా మీ రివ్యూ అవసరం అయితే, మేము మీకు తెలియజేస్తాము.</translation>
<translation id="5895138241574237353">మళ్ళీ ప్రారంభించండి</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - నెట్‌వర్క్ సైన్ ఇన్</translation>
<translation id="5924017743176219022">ఇంటర్నెట్‌కు కనెక్ట్ చేస్తోంది...</translation>
<translation id="7627350220326904504">మీ João Browserను సిద్ధం చేద్దాం</translation>
<translation id="5941711191222866238">కనిష్టీకరించు</translation>
<translation id="8680863040348007215">మీ పరికరాలన్నింటిలో ఈ బుక్‌మార్క్‌తో పాటు మరిన్ని పొందడానికి, João Browserకు సైన్ ఇన్ చేయండి</translation>
<translation id="2008232276062354182">João Browserను మీకు నచ్చినట్లు సెటప్ చేయండి</translation>
<translation id="5960071705175224773">మీ సెట్టింగ్‌లు తెలియని యాప్ ద్వారా మార్చబడ్డాయి</translation>
<translation id="5977420883993828287">పిన్ చేశారు! టూల్‌బార్ నుండి సందర్భోచితమైన టాస్క్‌లను మళ్లీ ఉపయోగించండి</translation>
<translation id="5889362640603897718">{COUNT,plural, =1{João Browserను 1 నిమిషం పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది.}other{João Browserను # నిమిషాల పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది.}}</translation>
<translation id="4971097497342057998">సింక్‌ను ప్రారంభించడానికి João Browserను అప్‌డేట్ చేయండి</translation>
<translation id="5990360079535151574">టూల్‌బార్‌లోని "సందర్భోచితమైన టాస్క్‌లు" బటన్ నుండి, మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి సందర్భోచితమైన టాస్క్‌లను మళ్లీ తెరవవచ్చు</translation>
<translation id="6003112304606738118">డౌన్‌లోడ్ అవుతోంది... <ph name="HOURS" /> గంట(లు) సమయం మిగిలి ఉంది</translation>
<translation id="6009821354356307391">అదనపు క్వెరీని అడగండి</translation>
<translation id="6040143037577758943">మూసివేయండి</translation>
<translation id="2100398097168307292">మీ <ph name="DEVICE_TYPE" />‌లో João Browser యాప్‌ను ఉపయోగించినప్పుడు, ఆన్‌లైన్ షాపింగ్‌లో మరిన్ని ప్రయోజనాలను పొందండి</translation>
<translation id="6058380562449900225">మీ డేటాను సురక్షితంగా ఉంచడానికి, మీరు ఇటీవల ఉపయోగించని సైట్‌లకు అనుమతులను తీసివేయడానికి Chromiumకు అనుమతినివ్వండి. నోటిఫికేషన్‌లు అందుతూనే ఉంటాయి.</translation>
<translation id="4735359759698689867">&amp;João Browserలో తెరవండి</translation>
<translation id="6069027071882229820">ఇమేజ్‌గా కాపీ చేయండి</translation>
<translation id="2274675514456642321">João Browserకు <ph name="EXTENSION_NAME" /> జోడించబడింది</translation>
<translation id="147381942282490529">João Browserను అనుకూలంగా మార్చండి మరియు నియంత్రించండి. అప్‌డేట్ అందుబాటులో ఉంది.</translation>
<translation id="8775234022739879423">ఆన్‌లో ఉంది • ఈ ఎక్స్‌టెన్షన్ ఎక్కడ నుండి వచ్చిందో João Browser వెరిఫై చేయలేదు</translation>
<translation id="6634821567165410381">João Browserలో మీ ఖాతా</translation>
<translation id="4398707227122702993">João Browser టూల్‌బార్‌లో యాక్సెస్ రిక్వెస్ట్‌లను చూపడానికి ఎక్స్‌టెన్షన్‌ను అనుమతించండి</translation>
<translation id="5370941509199989624"><ph name="FILE_NAME" /> హానికరం, కావున João Browser దాన్ని బ్లాక్ చేసింది.</translation>
<translation id="5119118887583954582">João Browser త్వరలోనే మూసివేయబడుతుంది, డేటా తొలగించబడుతుంది</translation>
<translation id="576637711620229618">మీరు ఇక్కడ João Browser ప్రొఫైళ్ల మధ్య స్విచ్ అవ్వవచ్చు</translation>
<translation id="615103374448673771">మీరు కుక్కీలను అనుమతిస్తే, ప్రీ - లోడ్ చేసేటప్పుడు Chromium వాటిని ఉపయోగించవచ్చు</translation>
<translation id="6165508094623778733">మరింత తెలుసుకోండి</translation>
<translation id="3738215896821824918">మీ ఖాతాలో João Browser డేటాను క్లియర్ చేయండి</translation>
<translation id="2145111683361496197">ఈ ఫైల్ ప్రమాదకరమైనది కావచ్చు<ph name="LINE_BREAK" />మీరు పాస్‌వర్డ్‌ను అందించినట్లయితే João Browser మీ కోసం ఈ డౌన్‌లోడ్‌ను చెక్ చేస్తుంది. ఫైల్ గురించిన సమాచారం Google సురక్షిత బ్రౌజింగ్‌కు పంపబడుతుంది, అయితే ఫైల్ కంటెంట్, పాస్‌వర్డ్ మీ పరికరంలో ఉంటాయి.</translation>
<translation id="6182736845697986886">అప్‌డేట్ సర్వర్ అంతర్గత ఎర్రర్ కారణంగా ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="6050294746023477088">మీ <ph name="TARGET_DEVICE_NAME" />లో మీరు João Browserకు సైన్ ఇన్ చేశారని నిర్ధారించుకుని, ఆపై మళ్లీ పంపడానికి ట్రై చేయండి.</translation>
<translation id="3395167674702947885">ఈ కంప్యూటర్‌లో ఇప్పటికే మరింత తాజాదైన João Browser వెర్షన్ ఉంది. సాఫ్ట్‌వేర్ పని చేయకపోతే, దయచేసి João Browserను అన్ఇన్‌స్టాల్ చేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="4384214545531685923">{0,plural, =0{João Browser ఇప్పుడు తిరిగి ప్రారంభించబడుతుంది}=1{1 సెకనులో João Browser తిరిగి ప్రారంభించబడుతుంది}other{# సెకన్లలో João Browser తిరిగి ప్రారంభించబడుతుంది}}</translation>
<translation id="5880255774989397049">ఫైళ్లను డౌన్‌లోడ్ చేయడానికి João Browserకు స్టోరేజ్ యాక్సెస్‌కు సంబంధించిన అనుమతి అవసరం</translation>
<translation id="6245734527075554892">Chromiumలో స్టోర్ చేయబడిన సురక్షితం కాని సైట్‌ల లిస్ట్‌తో కూడిన URLలను చెక్ చేస్తుంది</translation>
<translation id="1959823478027154444">João Browserను డిఫాల్ట్ బ్రౌజర్‌గా చేయి</translation>
<translation id="6248988683584659830">సెర్చ్ సెట్టింగ్‌లు</translation>
<translation id="9191635841540101343">మీ ఫోన్‌లోని João Browser యాప్‌తో, ప్రయాణంలోనూ Google అత్యుత్తమ సేఫ్టీ ఫీచర్‌లను పొందండి</translation>
<translation id="538350741885862188">João Browser నుండి సైన్ అవుట్ చేయాలా?</translation>
<translation id="161121067714522736">ఈ ట్యాబ్‌లు అదనపు రిసోర్స్‌లను ఉపయోగిస్తున్నాయి. మీ పనితీరును మెరుగుపరచడానికి, వాటిని ఇన్‌యాక్టివ్‌గా ఉంచడానికి João Browserకు అనుమతినివ్వండి.</translation>
<translation id="2095090272560293574">మీ João Browser ప్రొఫైల్‌ను అనుకూలంగా మార్చండి</translation>
<translation id="6290827346642914212">మీ Chromium ప్రొఫైల్‌కు పేరు పెట్టండి</translation>
<translation id="6472525517562723285">ఒక ఎక్స్‌టెన్షన్ మీరు João Browserకి సైన్ ఇన్ చేయాల్సిందిగా కోరుతోంది</translation>
<translation id="2069878195899746465"><ph name="FILE_NAME" /> హానికరం కావచ్చు, కావున João Browser దాన్ని బ్లాక్ చేసింది.</translation>
<translation id="1283909912629029170">João Browser మీ కెమెరాను ఉపయోగిస్తోంది.</translation>
<translation id="323902744000752306">João Browserలో మరొక వ్యవస్థాపన జరుగుతోంది. దయచేసి తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="1292164882596462877">ఇప్పుడు మీ Google ఖాతాతో, షేర్ చేయ‌బ‌డిన కంప్యూట‌ర్‌ల‌లో João Browserను సులభంగా ఉపయోగించవచ్చు.</translation>
<translation id="6411450594978516531">João Browserను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయడం ద్వారా మీకు తెలిసిన, మీరు ఇష్టపడే, విశ్వసించే ఫీచర్‌లకు యాక్సెస్‌ను సులభంగా పొందండి.</translation>
<translation id="3344301749774719950">João Browser షార్ట్‌కట్</translation>
<translation id="8395825163097750991">ఫైల్ సాధారణంగా డౌన్‌లోడ్ అవ్వని, అలాగే ఇది ప్రమాదకరమైనది అయినందున João Browser ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="7683737657427846440">మీరు ఖచ్చితంగా João Browserను అన్ఇన్‌స్టాల్ చేయాలనుకుంటున్నారా?</translation>
<translation id="6375219077595103062">Password Managerకు షార్ట్‌కట్‌ను జోడించండి</translation>
<translation id="6388799252195623474">ఈ విషయంలో నాకు సహాయం కావాలి</translation>
<translation id="6966523531135953867">కొనసాగించడానికి, João Browserకి <ph name="EMAIL" />‌తో సైన్ ఇన్ చేయండి. ఇది మీ సంస్థకు సంబంధించిన పాలసీలను మీరు పొందారని నిర్ధారిస్తుంది.</translation>
<translation id="5146608242127807773">కంప్యూటర్ స్క్రీన్‌లో João Browser లోగో.</translation>
<translation id="6361476216650509195">João Browser అనేది మెరుపు వేగంతో వెబ్‌పేజీలను మరియు యాప్‌ల‌ను అమలు చేసే వెబ్ బ్రౌజర్. ఇది వేగవంతమైనది, స్థిరమైనది మరియు ఉపయోగించడానికి సులభమైనది. João Browserలో రూపొందించిన మాల్‌వేర్‌ మరియు ఫిషింగ్ రక్షణతో మరింత సురక్షితంగా వెబ్‌లో బ్రౌజ్ చేయండి.</translation>
<translation id="7864687914956920860">మీరు మీ Google ఖాతాలో João Browser డేటాను ఎల్లప్పుడూ ఉపయోగించగలరని, సేవ్ చేయగలరని నిర్ధారించుకోవడానికి, ఇది మీరేనని వెరిఫై చేయండి</translation>
<translation id="1160920197193662978">João Browser మరింత వేగంగా పని చేస్తుంది, JavaScriptను ఉపయోగించే ఫీచర్‌లు డిజైన్ చేసిన విధంగానే పని చేస్తాయి</translation>
<translation id="6436260184216827876">ఇమేజ్ సెర్చ్ అందుబాటులో లేదు. తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="6442900851116057561">ChromiumOSను రీస్టార్ట్ చేయండి</translation>
<translation id="6443470774889161065">Chromium మీరు సందర్శించే అవకాశం ఉన్న ఇంకా మరిన్ని పేజీలను ప్రీ - లోడ్ చేస్తుంది, తద్వారా మీరు వాటిని సందర్శించినప్పుడు అవి మరింత త్వరగా లోడ్ అవుతాయి</translation>
<translation id="3730564967922511625">ధరలను ట్రాక్ చేయడానికి, ఏదైనా సైట్‌లో ధర తగ్గినప్పుడు అలర్ట్‌లను పొందడానికి మీ ఫోన్‌లో João Browserను డౌన్‌లోడ్ చేసుకోండి</translation>
<translation id="3753019081686930624">ఆఫ్‌లో ఉంది • ఈ ఎక్స్‌టెన్షన్ ఎక్కడ నుండి వచ్చిందో João Browser వెరిఫై చేయలేదు</translation>
<translation id="5444641426058108434">João Browser ప్రొఫైళ్లకు స్వాగతం</translation>
<translation id="5103470775766355478">మీరు నెక్స్ట్ టైమ్ మీ <ph name="DEVICE_TYPE" />‌లో João Browserను తెరిచినప్పుడు, ట్యాబ్ గ్రూప్‌లను ఉపయోగించమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="9087231386723579740">João Browser నుండి ఖాతాను తీసివేయండి</translation>
<translation id="4984395209542302039">ఇది మీరు João Browserని ప్రారంభించేటప్పుడు చూపబడే పేజీని కూడా నియంత్రిస్తుంది.</translation>
<translation id="648319183876919572">ప్రమాదకరమైన వెబ్‌సైట్‌ల నుండి, డౌన్‌లోడ్‌ల నుండి మెరుగైన సురక్షిత బ్రౌజింగ్ మీకు మరింత రక్షణను అందిస్తుంది</translation>
<translation id="1524792685704191751">João Browserను అన్ఇన్‌స్టాల్ చేయి</translation>
<translation id="6637504267182028286">షార్ట్‌కట్‌లు João Browserలో తెరవబడతాయి</translation>
<translation id="1478247638436966279">João Browserను <ph name="TIMEOUT_DURATION" /> సమయం పాటు వినియోగించకపోతే, మీ సంస్థ దానిని మూసివేస్తుంది. బ్రౌజింగ్ డేటా తొలగించబడింది. ఈ తొలగించబడే డేటాలో హిస్టరీ, ఆటోమేటిక్‌గా పూరించబడిన డేటా, ఇంకా డౌన్‌లోడ్‌లు ఉండవచ్చు.</translation>
<translation id="1311233187253046133">ప్రతి ప్రొఫైల్‌లో బుక్‌మార్క్‌లు, హిస్టరీ, పాస్‌వర్డ్‌లు లాంటి దాని సొంత João Browser సమాచారం ఉంటుంది</translation>
<translation id="6563921047760808519"><ph name="BEGIN_LINK" />Chromium మీ డేటాను ఎలా ప్రైవేట్‌గా ఉంచుతుంది<ph name="END_LINK" /> అనే దాని గురించి మరింత తెలుసుకోండి</translation>
<translation id="1643078533228697915">João Browser రీస్టార్ట్ అయిన తర్వాత ఈ సెట్టింగ్‌కు మార్పులు వర్తింపజేయడం జరుగుతుంది.</translation>
<translation id="1918630514771863338">João Browser ప్రధాన మెనూలోని ఎక్స్‌టెన్షన్‌లను క్లిక్ చేయడం ద్వారా మీ ఎక్స్‌టెన్షన్‌లను మేనేజ్ చేయండి.</translation>
<translation id="4229328298978407243">మీరు మరొక João Browser ప్రొఫైల్‌కు మారి, పాస్‌వర్డ్‌లను చూడవచ్చు</translation>
<translation id="7717252965531997879">అత్యుత్తమ AI టూల్స్‌ను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లడానికి João Browser యాప్‌ను ఉపయోగించండి</translation>
<translation id="6570579332384693436">అక్షరక్రమ లోపాలను పరిష్కరించడానికి, మీరు వచన ఫీల్డ్‌లలో టైప్ చేసే వచనాన్ని, Chromium Googleకు పంపుతుంది</translation>
<translation id="5374627817618267090">João Browser నోటిఫికేషన్ సెట్టింగ్‌లకు వెళ్లు</translation>
<translation id="6600016381025017075">ఈ పేజీలో దేన్నైనా సెర్చ్ చేయండి</translation>
<translation id="264335610358256197">మీ మార్పులు మీరు João Browserని మరుసటిసారి ప్రారంభించినప్పుడు ప్రభావాన్ని చూపుతాయి.</translation>
<translation id="2657584510687441826">Windows ప్రారంభమైనప్పుడు João Browser ఇప్పుడు ప్రారంభమవుతుంది, కాబట్టి మీరు తక్షణమే బ్రౌజింగ్‌ను ప్రారంభించవచ్చు. మీరు దీన్ని సెట్టింగ్‌లలో ఆఫ్ చేయవచ్చు.</translation>
<translation id="5482413402708094860">మీరు ఆపివేసిన చోట నుండి కొనసాగించండి: João Browser మీ చివరి సెషన్ నుండి మీ ట్యాబ్‌లను రీస్టోర్ చేస్తుంది. మీరు వీటిలో ఆఫ్ చేయవచ్చు</translation>
<translation id="5022765692226673603">మీ పరిసరాల 3D మ్యాప్‌ను క్రియేట్ చేయడానికి João Browserకు కెమెరా అనుమతి అవసరం</translation>
<translation id="6669284030132180248">మీ బుక్‌మార్క్‌లను Google ఖాతాలో కూడా సేవ్ చేస్తే, మీరు Chromiumలో ప్రోడక్ట్ ధరలను ట్రాక్ చేయవచ్చు, ధర తగ్గినప్పుడు తెలియజేయబడుతుంది</translation>
<translation id="6676384891291319759">ఇంటర్నెట్‌ను యాక్సెస్ చేయండి</translation>
<translation id="668175097507315160">సైన్ ఇన్ చేయడంలో ఎర్రర్ ఏర్పడినందున ChromiumOS మీ డేటాను సింక్ చేయలేకపోయింది.</translation>
<translation id="3982573751008180181">João Browser నుండి ఈ యాప్ డేటాను తీసివేయండి</translation>
<translation id="5613723096388999601">ఈ సైట్ కోసం João Browserకు మైక్రోఫోన్ అనుమతి అవసరం</translation>
<translation id="6712881677154121168">డౌన్‌లోడ్ చేయడంలో ఎర్రర్ ఏర్పడింది: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="9190188975825967506">మీ ప్రొఫైల్, కొత్త João Browser వెర్షన్‌కు చెందినది కాబట్టి, దీనిని ఉపయోగించడం సాధ్యపడదు.

కొన్ని ఫీచర్‌లు అందుబాటులో ఉండకపోవచ్చు. దయచేసి వేరొక ప్రొఫైల్ డైరెక్టరీని పేర్కొనండి లేదా João Browser యొక్క కొత్త వెర్షన్‌ను ఉపయోగించండి.</translation>
<translation id="6729124504294600478">వ్యక్తిగతీకరణను, ఇతర ఫీచర్‌లను పొందడానికి, Chromiumను 'వెబ్ &amp; యాప్ యాక్టివిటీ'లో, లింక్ అయిన Google సర్వీస్‌లలో చేర్చండి</translation>
<translation id="6957684879859415418">మీ కంప్యూటర్‌లోని వినియోగదారులందరికీ João Browser ఇప్పటికే ఇన్‌స్టాల్ చేయబడింది.</translation>
<translation id="4411262692912917677">మీ డివైజ్‌లన్నింటిలో మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, ఇంకా మరిన్నింటిని పొందడానికి João Browserకు సైన్ ఇన్ చేయండి మీరు సైన్ ఇన్ చేసిన తర్వాత ఈ బుక్‌మార్క్ మీ Google ఖాతాలో సేవ్ అవుతుంది.</translation>
<translation id="6064901610880747710">João Browser V8 ఇంజిన్‌తో సైట్‌లను వేగవంతం చేస్తుంది కానీ João Browser అటాక్‌లకు కొద్దిగా తక్కువ నిరోధకతను కలిగిస్తుంది. ఈ సెట్టింగ్ ఆన్ చేయబడింది.</translation>
<translation id="4530735110472079436">{count,plural, =1{మీ João Browser డేటాలో కొంత భాగం, ఇంకా మీ Google ఖాతాలో సేవ్ కాలేదు. సైన్ అవుట్ చేయడానికి ముందు, కొన్ని నిమిషాలు వేచి ఉండటానికి ట్రై చేయండి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా (1 ఐటెమ్) తొలగించబడుతుంది.}other{మీ João Browser డేటాలో కొంత భాగం, ఇంకా మీ Google ఖాతాలో సేవ్ కాలేదు. సైన్ అవుట్ చేయడానికి ముందు, కొన్ని నిమిషాలు వేచి ఉండటానికి ట్రై చేయండి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా ({count} ఐటెమ్‌లు) తొలగించబడుతుంది.}}</translation>
<translation id="9176853308971176490">ఈ ఫైల్ ప్రమాదకరమైనది కావచ్చు, కాబట్టి దీనిని స్కాన్ చేయమని João Browser సిఫార్సు చేస్తోంది.</translation>
<translation id="6779406956731413166">ChromiumOS అనేది అదనపు <ph name="BEGIN_LINK_CROS_OSS" />ఓపెన్ సోర్స్ సాఫ్ట్‌వేర్<ph name="END_LINK_CROS_OSS" /> ద్వారా సాధ్యమైంది.</translation>
<translation id="6831043979455480757">అనువదించు</translation>
<translation id="6412488898785231889">మీ పాస్‌వర్డ్‌లు ఎప్పుడైనా హ్యాక్ అయితే, João Browser మీకు తెలియచేస్తుంది</translation>
<translation id="684888714667046800">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. మీరు ఫైర్‌వాల్‌ను ఉపయోగిస్తుంటే, దయచేసి <ph name="PRODUCT_EXE_NAME" /> వైట్‌లిస్ట్‌లో ఉందని నిర్ధారించుకోండి.</translation>
<translation id="6750640664545078431">João Browser - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">కొనసాగించడానికి ట్యాబ్ చేయండి</translation>
<translation id="6862030660799253820">ఇమేజ్ సెర్చ్‌తో ఈ ఇమేజ్‌ను సెర్చ్ చేయండి</translation>
<translation id="4260365383290377081">"<ph name="EXTENSION_NAME" />"లో మాల్‌వేర్ ఉన్నట్టుగా João Browser కనుగొన్నది</translation>
<translation id="6877155553248388166">సెర్చ్ ఏరియాకు దిగువ కుడి మూలన: కుడి వైపు <ph name="RIGHT" />%, దిగువ <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">కాపీ చేయండి</translation>
<translation id="6898028264630240901">మీరు బ్రౌజ్ చేస్తున్నప్పుడు సులభంగా ప్రశ్నలు అడిగేందుకు సందర్భోచితమైన టాస్క్‌లను పిన్ చేయవచ్చు</translation>
<translation id="6985817498888719203">João Browserను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసి, దానిని మీ టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="5277424858974213042">&amp;João Browser ప్రొఫైల్స్‌ను మేనేజ్ చేయండి</translation>
<translation id="2726137364317931343">ఈ చర్య కారణంగా:
          <ph name="LINE_BREAKS" />
            • మీ ప్రారంభ పేజీ, కొత్త ట్యాబ్ పేజీ, సెర్చ్ ఇంజిన్, పిన్ చేసిన ట్యాబ్‌లు రీసెట్ అవుతాయి
            <ph name="LINE_BREAK" />
            • ఎక్స్‌టెన్షన్‌లు డిజేబుల్ అవుతాయి
            <ph name="LINE_BREAK" />
            • కుక్కీలు, ఇతర తాత్కాలిక సైట్ డేటాను తొలగించడం జరుగుతుంది
            <ph name="LINE_BREAK" />
            • João Browser షార్ట్‌కట్‌లు రీసెట్ అవుతాయి
            <ph name="LINE_BREAKS" />
            బుక్‌మార్క్స్, హిస్టరీ, ఇంకా సేవ్ అయిన పాస్‌వర్డ్‌లు ప్రభావితం కావు.</translation>
<translation id="2901988969322822496">మీరు João Browser పరిమితి అయిన <ph name="BOOKMARK_LIMIT" /> బుక్‌మార్క్‌లను చేరుకున్నారు, కాబట్టి మీ బుక్‌మార్క్‌లలో కొన్ని ఇంకా మీ Google ఖాతాలో సేవ్ కాలేదు.

మీరు కొన్ని బుక్‌మార్క్‌లను తొలగించే వరకు మీ ఖాతాలో కొత్త బుక్‌మార్క్‌లను సేవ్ చేయడం సాధ్యపడదు. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, సేవ్ చేయని బుక్‌మార్క్‌లు తొలగించబడతాయి.</translation>
<translation id="6203410920314218280">João Browser అజ్ఞా&amp;త విండోలో లింక్‌ను తెరువు</translation>
<translation id="6965382102122355670">సరే</translation>
<translation id="6985329841647292029">ChromiumOS నియమాలు</translation>
<translation id="8064285182627814996">మీ ఖాతా <ph name="ACCOUNT_EMAIL" />‌లో João Browser డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి మీ రహస్య పదబంధాన్ని ఎంటర్ చేయండి</translation>
<translation id="7011190694940573312">ఈ వెర్షన్ ఆపరేటింగ్ సిస్టమ్ సపోర్ట్ చేయనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="7024536598735240744">డెవలపర్ మోడ్‌లో ఉన్న ఎర్రర్: <ph name="UNPACK_ERROR" />.</translation>
<translation id="181803036615530330">João Browserను మీకు నచ్చిన విధంగా తయారు చేసుకోండి</translation>
<translation id="7047386856539490735">ఈ ఫలితాలు ఉపయోగకరంగా ఉన్నాయా?</translation>
<translation id="2478245051737698828">João Browserను అప్‌డేట్ చేయి</translation>
<translation id="452909342278940733">చిత్రంలో ఉపయోగకరమైన వివరణ లేకుంటే, మీ కోసం ఒక వివరణను అందించడానికి João Browser ప్రయత్నిస్తుంది. వివరణలను క్రియేట్ చేయడానికి, చిత్రాలు Googleకు పంపబడతాయి.</translation>
<translation id="8606769615526968368">మీ <ph name="DEVICE_TYPE" />‌లో João Browser యాప్‌ను ఉపయోగించి AI సామర్థ్యాలను పొందండి</translation>
<translation id="2061960765882453684">మీ ఫోన్‌లోని João Browser యాప్‌తో మీ పాస్‌వర్డ్‌లు, ట్యాబ్‌లు, మరిన్నింటిని ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి</translation>
<translation id="7141270731789036260">Chrome for Testingను అనుకూలంగా మార్చండి</translation>
<translation id="7147227333672430807">మీరు మెసేజ్‌ల్లో, డాక్యుమెంట్‌ల్లో, ఇంకా ఇతర యాప్‌ల్లో ఉండే లింక్‌లను క్లిక్ చేసినప్పుడల్లా Chromiumను ఉపయోగించవచ్చు</translation>
<translation id="6949173677980969871">João Browser నుండి <ph name="EXTENSION_NAME" />‌ను తీసివేయండి</translation>
<translation id="3556355753960287061">João Browser డేటాను <ph name="TIMEOUT_DURATION" /> సమయం పాటు వినియోగించకపోతే, మీ సంస్థ దానిని తొలగిస్తుంది. ఈ తొలగించబడే డేటాలో హిస్టరీ, ఆటోమేటిక్‌గా పూరించబడిన డేటా, ఇంకా డౌన్‌లోడ్‌లు ఉండవచ్చు.</translation>
<translation id="8689006320829658442">ఈ సైట్ కోసం João Browserకు కెమెరా అనుమతి అవసరం</translation>
<translation id="7501884108538572227">João Browserను ప్రారంభించడం సాధ్యపడలేదు. మళ్లీ ట్రై చేయండి.</translation>
<translation id="5484563502710761706">João Browserలో Geminiతో, మీరు ఎక్కడ ఉన్నా సరే, ఏదైనా అడగండి</translation>
<translation id="3823264355161086552">João Browserను మీకు కావలసినప్పుడల్లా త్వరగా పొందడానికి దాన్ని మీ డాక్‌లో ఉంచుకోండి</translation>
<translation id="9153902741226700840">మీరు మెసేజ్‌లలో, డాక్యుమెంట్‌లలో, ఇంకా ఇతర యాప్‌లలో ఉండే లింక్‌లను క్లిక్ చేసినప్పుడల్లా João Browserను ఉపయోగించండి</translation>
<translation id="7216228761061470870">మీరు డెస్క్‌టాప్‌లో ఇమేజ్ సెర్చ్‌ను ఉపయోగించినప్పుడు, పేజీ టైటిల్, URL, అలాగే PDFలతో సహా అందులోని కంటెంట్ అంతా సర్వర్‌కు వెళుతుంది.</translation>
<translation id="7950844619283784703">విధి నిర్వాహకుడు - João Browser</translation>
<translation id="133513825972536773"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో João Browserకి సైన్ ఇన్ చేయండి. మీరు మీ డివైజ్‌లన్నింటిలో సేవ్ చేసిన మీ సమాచారాన్ని, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="4558982617284733740">తక్షణమే బ్రౌజింగ్‌ను ప్రారంభించండి: Windows ప్రారంభమైనప్పుడు João Browser ఇప్పుడు ప్రారంభించబడుతుంది.</translation>
<translation id="7274695763216404502">పిన్ చేశారు! టూల్‌బార్ నుండి ఇమేజ్ సెర్చ్‌ను మళ్లీ ఉపయోగించండి</translation>
<translation id="7288567540154601580">ట్యాబ్‌లు, ఎక్స్‌టెన్షన్‌లు</translation>
<translation id="5494571279964989269">{NUM_EXTENSIONS,plural, =1{మీరు దాన్ని తీసివేయవలసిందిగా João Browser సిఫార్సు చేస్తోంది}other{మీరు వాటిని తీసివేయవలసిందిగా João Browser సిఫార్సు చేస్తోంది}}</translation>
<translation id="2269053214123323740">సిస్టమ్ ఆడియోను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లను తెరిచి, João Browser కోసం 'సిస్టమ్ ఆడియో రికార్డింగ్ మాత్రమే'ను అనుమతించండి. ఆపై మీరు João Browserను రీస్టార్ట్ చేయాలి.</translation>
<translation id="731795002583552498">Chromiumని అప్‌డేట్ చేస్తోంది</translation>
<translation id="9065168747010082551">మీ ప్రాధాన్యతల ఫైల్ పాడైంది లేదా చెల్లదు. João Browser మీ సెట్టింగ్‌లను పునరుద్ధరించలేకపోయింది.</translation>
<translation id="7324051657739063017">మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి మీరు సందర్భోచితమైన టాస్క్‌లను మళ్లీ తెరవవచ్చు</translation>
<translation id="4159250197688136733">మీ వెబ్, బుక్‌మార్క్‌లు మరియు ఇతర João Browser అంశాలు ఇక్కడ చూపబడతాయి.</translation>
<translation id="7347827960336370838">మీ రహస్య పదబంధం ఉన్న కొంతమంది మాత్రమే ఎన్‌క్రిప్ట్ చేసిన మీ డేటాను చదవగలరు. రహస్య పదబంధం Googleకు పంపబడదు లేదా Googleలో స్టోర్ అవ్వదు. మీరు మీ రహస్య పదభందాన్ని మర్చిపోతే లేదా ఈ సెట్టింగ్‌ను మార్చాలనుకుంటే, మీరు <ph name="BEGIN_LINK" />మీ ఖాతాలోని Chromium డేటాను తొలగించాల్సి ఉంటుంది<ph name="END_LINK" />.</translation>
<translation id="1062903713270840396"><ph name="TARGET_URL_HOSTNAME" />ను యాక్సెస్ చేయడం కోసం <ph name="ALTERNATIVE_BROWSER_NAME" />ను తెరిచే విధంగా João Browserను మీ సిస్టమ్ నిర్వాహకుడు కాన్ఫిగర్ చేశారు.</translation>
<translation id="7352651011704765696">ఏదో తప్పు జరిగింది</translation>
<translation id="5817362738974335084">భవిష్యత్తులో João Browser అప్‌డేట్‌లను పొందడానికి, మీకు macOS 13 కానీ, అంతకన్నా లేటెస్ట్ వెర్షన్ కానీ ఉండాలి. ఈ కంప్యూటర్ macOS 12 వెర్షన్‌ను ఉపయోగిస్తోంది.</translation>
<translation id="7376384068949534168">మీరు ఇటీవల వెళ్లలేదు. Chromium <ph name="PERMISSION_1" />,‌ <ph name="PERMISSION_2" />ను తీసివేసింది.</translation>
<translation id="73786666777299047">Chrome వెబ్ స్టోర్‌ను తెరవండి</translation>
<translation id="5724625487458697703">సిస్టమ్ ట్రేలో João Browserలో Geminiని చూడండి</translation>
<translation id="7401687852903179959">"ఇమేజ్ సెర్చ్‌"తో ఈ వీడియోను సెర్చ్ చేయండి</translation>
<translation id="1088684725931971005">João Browser ఇప్పుడు మీ ఆటోమేటిక్ బ్రౌజర్</translation>
<translation id="7479848806300971661">మీరు ఆపివేసిన చోట నుండి కొనసాగించండి: మీరు రీస్టార్ట్ చేసిన ప్రతిసారీ João Browser మీ ట్యాబ్‌లను రీస్టోర్ చేస్తుంది. దీన్ని ఆఫ్ చేసి, ఇక్కడికి వెళ్లండి</translation>
<translation id="1258077876605261365">João Browserకు పాస్‌వర్డ్‌లను దిగుమతి చేయండి</translation>
<translation id="5293062713751091377">1. దిగువున <ph name="BUTTON_LABEL" /> ఆప్షన్‌ను క్లిక్ చేయండి
2. మీ Windows సెట్టింగ్‌లలో <ph name="BUTTON_2" />‌ను క్లిక్ చేయండి
3. క్విక్ యాక్సెస్ కోసం João Browserను మీ టాస్క్‌బార్‌కు పిన్ చేయడానికి, Windows నోటిఫికేషన్‌లో <ph name="BUTTON_3" />‌ను క్లిక్ చేయండి</translation>
<translation id="1941496545060769345"><ph name="PAGE_TITLE" /> - João Browser Dev</translation>
<translation id="7450541714075000668">టెక్స్ట్ కాపీ చేయబడింది</translation>
<translation id="7458892263350425044">మైక్రోఫోన్‌ను ఉపయోగించడానికి, <ph name="BEGIN_LINK" />సిస్టమ్ సెట్టింగ్‌ల<ph name="END_LINK" />‌లో Chromiumకు యాక్సెస్ ఇవ్వండి</translation>
<translation id="5422859338435319909">భవిష్యత్తులో João Browser అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 7ను ఉపయోగిస్తోంది.</translation>
<translation id="7467949745582939695">Chromiumను రీ-లాంచ్ చేయాలా?</translation>
<translation id="7707324976708178089">ప్రస్తుతం అమలు అవుతోన్న అదే João Browser వెర్షన్‌ను ఇన్‌స్టాల్ చేయలేరు. దయచేసి João Browserను మూసివేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="7510190804000607802">రిమైండర్: Google అత్యుత్తమ ఫీచర్‌లు ఇక ఎల్లప్పుడూ మీతోనే!</translation>
<translation id="751935028865900641">సైట్‌లు బహుశా ఊహించిన విధంగా పని చేస్తాయి. మీరు Chromiumకు సైన్ ఇన్ చేసినట్లయితే మీ Google ఖాతా మినహా అన్ని Chromium విండోలను మూసివేసినప్పుడు మీరు చాలా సైట్‌ల నుండి సైన్ అవుట్ చేయబడతారు.</translation>
<translation id="5325102834460669866">{0,plural, =1{1 నిమిషంలో João Browser తిరిగి ప్రారంభించబడుతుంది}other{# నిమిషాల్లో João Browser తిరిగి ప్రారంభించబడుతుంది}}</translation>
<translation id="7565444033145385702">మీ డేటాను సురక్షితంగా ఉంచడానికి, మీరు ఇటీవల ఉపయోగించని సైట్‌లకు అనుమతులను తీసివేయడానికి Chromiumకు అనుమతినివ్వండి.</translation>
<translation id="8099958128052689767">తక్షణమే బ్రౌజింగ్‌ను ప్రారంభించడానికి João Browserను ఆటోమేటిక్‌గా లాంచ్ చేయండి.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ఇన్‌స్టాలర్</translation>
<translation id="7125257608567714221">João Browser మీ కెమెరా మరియు మైక్రోఫోన్‌ని ఉపయోగిస్తోంది.</translation>
<translation id="227045421902171569">João Browser ఇప్పుడు మెరుగైంది</translation>
<translation id="5356567285381070312">ఇప్పుడు మీకు João Browserలో మరిన్ని ఫీచర్లు అందుబాటులో ఉన్నాయి</translation>
<translation id="7624307931717240213">ఈ సర్వీస్‌ను మెరుగుపరచడానికి మేము సమాచారాన్ని ఉపయోగిస్తాము. గోప్యతా పాలసీని, సర్వీస్ నియమాలను చూడండి.</translation>
<translation id="7649070708921625228">సహాయం</translation>
<translation id="5714374331629713291">João Browser యాప్‌ను పొందండి</translation>
<translation id="7658239707568436148">రద్దు చేయండి</translation>
<translation id="549378870470819535">João Browser మీ డిఫాల్ట్ బ్రౌజర్ కాదు</translation>
<translation id="6574348346278803862">మీ పరికరాల అంతటా João Browserను సింక్ చేయండి మరియు వ్యక్తిగతీకరించండి</translation>
<translation id="7699779824407626136">Chromium అప్‌డేట్</translation>
<translation id="3304080024230377341">João Browserలో మీ వర్క్ సురక్షితంగా ఉంటుంది</translation>
<translation id="7716950018788545737">టాస్క్(లు) ముగిసింది.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME" />‌కు సిస్టమ్‌ను ట్రేస్ చేసే సర్వీస్‌లను అందిస్తోంది. ఈ సర్వీస్ డిజేబుల్ అయితే, బ్రౌజర్ ద్వారా క్రియేట్ అయిన పనితీరు ట్రేస్‌లలో కాంటెక్స్ట్ స్విచ్, సిద్ధంగా ఉన్న థ్రెడ్ ఈవెంట్‌ల వంటి సిస్టమ్ అంతటికీ సంబంధించిన ఈవెంట్‌లు ఉండవు.</translation>
<translation id="7745317241717453663">ఇది ఈ పరికరం నుండి మీ బ్రౌజింగ్ డేటాను తొలగిస్తుంది. మీ డేటాను తర్వాత తిరిగి పొందడానికి, Chromiumకు <ph name="USER_EMAIL" /> లాగా సైన్ ఇన్ చేయండి.</translation>
<translation id="7747138024166251722">ఇన్‌స్టాలర్ ఒక తాత్కాలిక డైరక్టరీని సృష్టించలేకపోయింది. సాఫ్ట్‌వేర్‌ను ఇన్‌స్టాల్ చేయడానికి దయచేసి ఖాళీ డిస్క్ స్థలం, అనుమతిని చెక్ చేయండి.</translation>
<translation id="4713120944298974980">João Browserలో సెర్చ్ చేయండి</translation>
<translation id="5804390944809171853">ఆటోమేటిక్‌గా ఉండే João Browser రూపానికి రీసెట్ చేయండి</translation>
<translation id="6930487390575519812">João Browserలో మీ వర్క్‌ను సురక్షితంగా ఉంచేందుకు, మీరు João Browserకు సైన్-ఇన్ చేసినప్పుడు మీ సంస్థ నిర్దిష్ట సమాచారాన్ని చూడగలదు లేదా మేనేజ్ చేయగలదు.</translation>
<translation id="5214761769821670245">João Browserను ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసి, టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="1294697217796985566">João Browserను వేగవంతం చేయండి</translation>
<translation id="1278345486417353853"><ph name="PAGE_TITLE" /> - João Browser Canary</translation>
<translation id="7803986347287457849">మీ ఇంటర్నెట్ ట్రాఫిక్‌కు యాక్సెస్ ఉన్న వ్యక్తులు మీరు బ్రౌజ్ చేసే సైట్‌లను చూడటం కష్టతరం చేయండి. DNS (డొమైన్ నేమ్ సిస్టమ్)లో సైట్ IP అడ్రస్‌ను చూసేందుకు Chromium సురక్షితమైన కనెక్షన్‌ను ఉపయోగిస్తుంది.</translation>
<translation id="7810005234485217901">సులభంగా యాక్సెస్ చేయడం కోసం మీరు ఇమేజ్ సెర్చ్‌ను పిన్ చేయవచ్చు</translation>
<translation id="489728561211958943">ఈ పరికరంలో ఇప్పటికే ఈ ఖాతాతో ఒక João Browser ప్రొఫైల్ ఉంది</translation>
<translation id="7845233973568007926">ఇన్‌స్టాల్ చేసినందుకు ధన్యవాదాలు. <ph name="BUNDLE_NAME" />‌ను ఉపయోగించడానికి ముందు మీరు కంప్యూటర్‌ను తప్పకుండా రీస్టార్ట్ చేయాలి.</translation>
<translation id="5294768452950207882">మీ సెర్చ్ ఇంజిన్ João Browser వెలుపల నుండి మార్చబడింది. మిమ్మల్ని రక్షించడానికి, దాని ఒరిజినల్ ఆటోమేటిక్ సెట్టింగ్‌కు João Browser దాన్ని రీసెట్ చేసింది. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3244974069468656925">João Browserకు కొత్త రూపాన్ని అందించడానికి దాన్ని అనుకూలంగా మార్చండి</translation>
<translation id="7859018312476869945">మీరు అడ్రస్ బార్‌లో లేదా సెర్చ్ బాక్స్‌లో టైప్ చేసినప్పుడు, మెరుగైన సూచనలను పొందడానికి Chromium మీరు టైప్ చేసిన దానిని మీ ఆటోమేటిక్ సెర్చ్ ఇంజిన్‌కు పంపుతుంది. అజ్ఞాత మోడ్‌లో ఇది ఆఫ్‌లో ఉంటుంది.</translation>
<translation id="6517519572778941051">João Browserను తాజా వెర్షన్‌కు అప్‌డేట్ చేయడం సాధ్యం కాలేదు, కాబట్టి మీరు కొత్త ఫీచర్‌లు మరియు భద్రతా పరిష్కారాలను పొందడం లేదు.</translation>
<translation id="7872446069773932638">డౌన్‌లోడ్ అవుతోంది... <ph name="SECONDS" /> సెకను(లు) సమయం మిగిలి ఉంది</translation>
<translation id="7873537467422636035">మీ రహస్య పదబంధాన్ని మీరు మర్చిపోయినా లేదా ఈ సెట్టింగ్‌ను మార్చాలనుకున్నా, <ph name="BEGIN_LINK" />మీ ఖాతాలోని Chromium డేటాను తొలగించండి<ph name="END_LINK" /></translation>
<translation id="1722038268139386345">మీకు అవసరమైనప్పుడల్లా João Browserలో Geminiని త్వరగా తెరవండి</translation>
<translation id="8344320926817290924">João Browserను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయండి</translation>
<translation id="7934340546140346950">వీలైనప్పుడు, Chromium ఆటోమేటిక్‌గా సురక్షితం కాని కనెక్షన్‌లను HTTPSకు అప్‌గ్రేడ్ చేస్తుంది</translation>
<translation id="3755057387338907970">మీరు <ph name="USER_EMAIL_ADDRESS" />గా João Browserకు సైన్ ఇన్ చేశారు. దయచేసి మళ్లీ సైన్ ఇన్ చేయడానికి ఇదే ఖాతాను ఉపయోగించండి.</translation>
<translation id="929903348843569380"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో João Browserకి సైన్ ఇన్ చేయండి. మీరు మీ అన్ని డివైజ్‌లలో మీ బుక్‌మార్క్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="7975919845073681630">ఇది Chromium రెండవ ఇన‌స్ట‌లేష‌న్. దీన్ని మీ డిఫాల్ట్ బ్రౌజర్‌గా చేయడం సాధ్యపడదు.</translation>
<translation id="8905411496853397218">తెలియని మూలాలకు చెందిన ఎక్స్‌టెన్షన్‌లు, యాప్‌లు, రూపాలు మీ పరికరానికి హాని కలిగించవచ్చు. <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> నుండి మాత్రమే వాటిని ఇన్‌స్టాల్ చేయని João Browser సిఫార్సు చేస్తోంది</translation>
<translation id="6306672714476596428">మీ<ph name="DEVICE_TYPE" />‌లోని João Browser యాప్‌తో Google అందించే అత్యుత్తమ ప్రయోజనాలను పొందండి</translation>
<translation id="8004582292198964060">బ్రౌజర్</translation>
<translation id="8010081455002666927">ఆటోమేటిక్ గుర్తింపు</translation>
<translation id="2172829664765531568">ఓసారి João Browserకి యాక్సెస్ లభించాక, ఆపై వెబ్‌సైట్‌లకు ఏమైనా యాక్సెస్‌ కావాలంటే అవి మిమ్మల్ని అడగవచ్చు.</translation>
<translation id="74641100973032765">João Browserను మీకు కావలసినప్పుడల్లా త్వరగా పొందడానికి దాన్ని టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="80471789339884597">ఇన్‌స్టాల్ చేసినందుకు ధన్యవాదాలు. <ph name="BUNDLE_NAME" />‌ను ఉపయోగించే ముందు మీరు తప్పకుండా మీ అన్ని బ్రౌజర్‌లను రీస్టార్ట్ చేయాలి.</translation>
<translation id="8054112667659782652">ఇమేజ్ సెర్చ్ షార్ట్‌కట్‌ను ఎల్లప్పుడూ చూపించండి</translation>
<translation id="8069447462453318634">"టూల్‌బార్‌కు పిన్ చేయండి" ఆప్షన్‌ను ఎంచుకోండి</translation>
<translation id="5039671129725402518">యాప్‌లకు సంబంధించి బ్యాక్‌గ్రౌండ్‌లో రన్ అవుతున్న João Browserను డిజేబుల్ చేయండి</translation>
<translation id="80790299200510644">ఇమేజ్ సెర్చ్</translation>
<translation id="8086881907087796310">మీ కంప్యూటర్ కనీస హార్డ్‌వేర్ అవసరాలకు అనుగుణంగా లేనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome for Testing</translation>
<translation id="2430877582155731716">ఈ సైట్ కోసం João Browserకు లొకేషన్ అనుమతి అవసరం</translation>
<translation id="8298045348217323">మీరు నెక్స్ట్ టైమ్ మీ <ph name="DEVICE_TYPE" />‌లో João Browserను తెరిచినప్పుడు, ధర ట్రాకింగ్ అలర్ట్‌లను ఎనేబుల్ చేయమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="3827347991254458074">మీ ఫోన్‌లోని João Browser యాప్‌తో మీకు నచ్చిన వస్తువుల ధరలు తగ్గినప్పుడు అలర్ట్‌లను పొందండి</translation>
<translation id="8118331347066725040">Lensతో సెర్చ్ చేయడం కోసం ఫీడ్‌బ్యాక్‌ను పంపండి</translation>
<translation id="2580039965224265556">ఇక మీకు నచ్చినట్లుగా João Browser</translation>
<translation id="8133124826068723441">మీ డొమైన్ కోసం సింక్ అందుబాటులో లేనందున, ChromiumOS మీ డేటాను సింక్ చేయలేకపోయింది.</translation>
<translation id="813913629614996137">ప్రారంభిస్తోంది...</translation>
<translation id="7940955011992997426">కీబోర్డ్ షార్ట్‌కట్‌తో João Browserలో Geminiని తెరవండి.</translation>
<translation id="7560319627203819845">João Browser అదనపు సర్వీస్ నియమాలు</translation>
<translation id="7133741820744999589">ఈ ఫైల్ అపాయకరమైనది, కాబట్టి João Browser దీన్ని బ్లాక్ చేసింది.</translation>
<translation id="8177472873527554730">పేజీలో కంటెంట్ కనుగొనడం సాధ్యం కాలేదు</translation>
<translation id="8200109504272824693">మీ ఖాతా, <ph name="USER_EMAIL" />‌లో Chromium డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి మీ రహస్య పదబంధాన్ని ఎంటర్ చేయండి</translation>
<translation id="820759916613250543">"ఇమేజ్ సెర్చ్‌"తో ఈ ఇమేజ్‌ను సెర్చ్ చేయండి</translation>
<translation id="8221491193165283816">మీరు సాధారణంగా నోటిఫికేషన్‌లను బ్లాక్ చేస్తుంటారు. ఈ సైట్ నుండి నోటిఫికేషన్‌లను పొందాలంటే, ఇక్కడ క్లిక్ చేయండి.</translation>
<translation id="8223363452568144035">మీ కెమెరాను ఉపయోగించడానికి, <ph name="BEGIN_LINK" />సిస్టమ్ సెట్టింగ్‌ల<ph name="END_LINK" />‌లో Chromiumకు యాక్సెస్ ఇవ్వండి</translation>
<translation id="8132864687089402359">ఈ ఎక్స్‌టెన్షన్ ఎక్కడ నుండి వచ్చిందో João Browser వెరిఫై చేయడం సాధ్యం కాదు, ఇది సురక్షితం కాకపోవచ్చు. João Browser నుండి దాన్ని తీసివేయండి, తద్వారా ఇది వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="7600652022483599804">చిత్రంలో ఉపయోగకరమైన వివరణ లేకుంటే, మీ కోసం ఒక వివరణను అందించడానికి João Browser ప్రయత్నిస్తుంది. వివరణలను క్రియేట్ చేయడానికి, చిత్రాలు Googleకు పంపబడతాయి. మీరు దీన్ని ఎప్పుడైనా సెట్టింగ్‌లలో ఆఫ్ చేయవచ్చు.</translation>
<translation id="8703735741562140394">కొత్త ప్రొఫైల్‌లో João Browserకి సైన్ ఇన్ చేయాలా?</translation>
<translation id="2830039647655087365"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో João Browserకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE" /> నుండి మీ పాస్‌వర్డ్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="1802935470126307750">సిస్టమ్ ట్రేలో João Browserలో Geminiని చూపించి, కీబోర్డ్ షార్ట్‌కట్‌ను ఆన్ చేయండి</translation>
<translation id="8286943863733751221">సురక్షితం కాని సైట్‌లు, డౌన్‌లోడ్‌ల గురించి <ph name="BEGIN_LINK" />Chromium మిమ్మల్ని హెచ్చరిస్తుంది<ph name="END_LINK" /></translation>
<translation id="8295827201165805317">మీరు ఇటీవల వెళ్లలేదు. Chromium <ph name="PERMISSION" />‌ను తీసివేసింది.</translation>
<translation id="481989138594406896">João Browser iOS యాప్‌లో మీ కెమెరాతో మీరు చూసే వాటిని షాపింగ్ చేయండి, అనువదించండి, అలాగే గుర్తించండి</translation>
<translation id="5242426961520127942">João Browserకు <ph name="USER_NAME" />‌గా సైన్ ఇన్ చేయడానికి QR కోడ్</translation>
<translation id="8313851650939857356">స్టార్టప్ ఎర్రర్: <ph name="STARTUP_ERROR" />.</translation>
<translation id="3644336211313412429">João Browserను <ph name="TIMEOUT_DURATION" /> సమయం పాటు వినియోగించకపోతే, మీ సంస్థ దానిని మూసివేస్తుంది.</translation>
<translation id="8321888067342493336">ఇమేజ్‌గా సేవ్ చేయండి</translation>
<translation id="3150519286474936594"><ph name="USER_EMAIL_ADDRESS" /> మునుపు João Browserని ఉపయోగించింది</translation>
<translation id="8351551329754447960">Chromiumలో స్కిల్స్‌ను ఎనేబుల్ చేయండి</translation>
<translation id="4566781614303801262">మీ Google ఖాతా <ph name="ACCOUNT_EMAIL" />‌లోని João Browser డేటాను ఉపయోగించేందుకు João Browserను అప్‌డేట్ చేయండి</translation>
<translation id="8404636483124146663">భవిష్యత్తు João Browser అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 8ను ఉపయోగిస్తోంది.</translation>
<translation id="8362914115861174987">ఈ భాషలోకి అనువదించండి</translation>
<translation id="8367705492654390392">ఏదైనా అడగండి</translation>
<translation id="8370517070665726704">కాపీరైట్ <ph name="YEAR" /> సర్వ హక్కులు Google LLCకి రిజర్వ్ అయ్యాయి.</translation>
<translation id="8954225380790220359">మీ పరికరాలన్నిటిలో మీ పాస్‌వర్డ్‌లను, ఇంకా మరిన్నింటిని పొందడానికి João Browserకు సైన్ ఇన్ చేయండి. ఈ పాస్‌వర్డ్, మీరు సైన్ ఇన్ చేసిన తర్వాత మీ Google ఖాతాలో సేవ్ అవుతుంది.</translation>
<translation id="208035402574338948">ఆపై మీరు João Browserను రీస్టార్ట్ చేయాలి.</translation>
<translation id="7458698097055456629">మీరు దాన్ని తీసివేయవలసిందిగా João Browser సిఫార్సు చేస్తోంది. <ph name="BEGIN_LINK" />సపోర్ట్ చేసే ఎక్స్‌టెన్షన్‌ల గురించి మరింత తెలుసుకోండి<ph name="END_LINK" /></translation>
<translation id="3428558977667883100">ఈ ఎక్స్‌టెన్షన్ పబ్లిషింగ్‌ను దాని డెవలపర్ రద్దు చేశారు, ఇది సురక్షితం కాకపోవచ్చు. João Browser నుండి దాన్ని తీసివేయండి, తద్వారా ఇది మీ వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="5012944467031125860">మీ Google ఖాతాలో కొంత డేటాను సేవ్ చేయడానికి, దాన్ని మీ డివైజ్‌లన్నింటిలో ఉపయోగించుకోవడానికి ముందు João Browser ఇది మీరేనని వెరిఫై చేయాలి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా తొలగించబడుతుంది.</translation>
<translation id="8822543678238892300">{0,plural, =1{ఒక రోజులోపు João Browserను తిరిగి ప్రారంభించండి}other{# రోజులలోపు João Browserను తిరిగి ప్రారంభించండి}}</translation>
<translation id="8438543370129609977">మీరు ఇమేజ్ సెర్చ్‌ను ఉపయోగించడం ద్వారా, PDFలతో పాటు పేజీ టైటిల్, URL, ఇంకా కంటెంట్ సర్వర్‌కు పంపబడతాయి. <ph name="LEARN_MORE" /></translation>
<translation id="4307944272317199640">João Browserలో ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడం గురించి మరింత తెలుసుకోండి</translation>
<translation id="6024135746436350583">ఇన్‌స్టాలర్ ఆర్కైవ్ పాడైంది లేదా చెల్లదు. దయచేసి João Browserను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="4933173390191738516">João Browserకు Windows 10 లేదా అంతకంటే ఆధునికమైన వెర్షన్ అవసరం.</translation>
<translation id="8463672209299734063">ఆప్షనల్: Googleకు సమస్య విశ్లేషణ, అలాగే వినియోగ డేటాను ఆటోమేటిక్‌గా పంపడం ద్వారా ChromiumOS ఫీచర్‌లను, ఇంకా పనితీరును మెరుగుపరచడంలో సహాయపడండి.</translation>
<translation id="4499703930846496679">మీ Google ఖాతాలో João Browser డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి, ఇది మీరేనని వెరిఫై చేయండి</translation>
<translation id="8482493977473846331">Chromiumకు సైన్ ఇన్ చేయడానికి ప్రాంప్ట్‌లను చూపిస్తుంది</translation>
<translation id="2129903037617090425">João Browser కాలం చెల్లినది</translation>
<translation id="850264194101621529">మీ ఆటోమేటిక్ బ్రౌజర్‌గా Chromiumను ఎంచుకున్నందుకు ధన్యవాదాలు!</translation>
<translation id="8522801943730206384">మీరు వాటిని సేవ్ చేసినప్పుడు Chromium మీ పాస్‌వర్డ్‌లను చెక్ చేయగలదు</translation>
<translation id="8525579356836940628">ఇన్‌స్టాలేషన్ ఆగిపోయింది</translation>
<translation id="2445505893586445499">మీ <ph name="DEVICE_TYPE" />‌లోని João Browser యాప్‌తో మీ పాస్‌వర్డ్‌లు, ట్యాబ్‌లు, మరిన్నింటిని ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి</translation>
<translation id="8548787790260785208">Chromium మీ పాస్‌వర్డ్‌లలో ఒకదానిని పబ్లిక్ డేటా ఉల్లంఘనలో కనుగొంటే హెచ్చరికను పొందండి</translation>
<translation id="8555465886620020932">సర్వీస్ ఎర్రర్: <ph name="SERVICE_ERROR" />.</translation>
<translation id="8871890913961794658">కొన్ని João Browser ఫీచర్‌లు, ఎక్స్‌టెన్షన్‌లు షార్ట్‌కట్‌లతో వస్తాయి. మీరు వాటిని తిరిగి ఆన్ చేయడాన్ని ఎంచుకోవచ్చు.</translation>
<translation id="8556420416730706394">సులభంగా యాక్సెస్ చేయడం కోసం మీరు ఇమేజ్ సెర్చ్‌ను పిన్ చేయవచ్చు; సైడ్ ప్యానెల్‌లో ఎగువున ఉన్న 'పిన్ చేయండి' బటన్‌ను క్లిక్ చేయండి</translation>
<translation id="856656450041460113">భాష లిస్ట్‌ను సెర్చ్ చేయండి</translation>
<translation id="9044172203094901282">పలు సంస్థలు João Browserను మేనేజ్ చేస్తాయి</translation>
<translation id="8586442755830160949">కాపీరైట్ <ph name="YEAR" /> Chromium రచయితలు. అన్ని హ‌క్కులు రిజ‌ర్వ్ చేయ‌బ‌డ్డాయి.</translation>
<translation id="8601359445272098721">కొత్తది! "స్క్రీన్‌ను అనువదించండి" బటన్‌ను ఎంచుకోవడం ద్వారా, మీరు ఇప్పుడు మీ స్క్రీన్‌పై టెక్స్ట్‌ను, ఇమేజ్‌లను రెండింటినీ అనువదించవచ్చు</translation>
<translation id="1071663705626404814">João Browserని ప్రారంభిస్తోంది...</translation>
<translation id="8624541899164515475">సెట్టింగ్‌లు, కొత్త ట్యాబ్‌లో తెరుచుకుంటాయి.</translation>
<translation id="8648201657708811153">Chrome for Testingను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయడం సాధ్యపడదు.</translation>
<translation id="5975137268566279898">ఇది మీరు João Browserను ప్రారంభించేటప్పుడు లేదా ఓమ్నిబాక్స్ నుండి వెతికేటప్పుడు చూపబడే పేజీని కూడా నియంత్రిస్తుంది.</translation>
<translation id="6358904712334248114">ఇది మీ João Browser</translation>
<translation id="8712637175834984815">అర్థమైంది</translation>
<translation id="5380190167074430719">João Browserకు సైన్ ఇన్ చేయాలా?</translation>
<translation id="8747073452963259673">సెర్చ్ ఏరియాకు దిగువ ఎడమ మూలన: ఎడమ వైపు <ph name="LEFT" />%, దిగువ <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">ఇన్‌స్టలేషన్ ఎర్రర్: మీ నెట్‌వర్క్ అడ్మినిస్ట్రేటర్ ఇన్‌స్టాలేషన్‌ను నిరోధించే గ్రూప్ పాలసీని వర్తింపజేశారు: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">నాకు తర్వాత గుర్తు చేయి</translation>
<translation id="8871607387186266158">త్వరగా ఓవర్‌వ్యూ పొందడానికి, ఫాలో-అప్ ప్రశ్నలు అడగడానికి, João Browser లోని Gemini తో ఈ డాక్యుమెంట్‌ను షేర్ చేయండి</translation>
<translation id="3009329613270131861">João Browserకు సైన్ ఇన్ చేయాలా?</translation>
<translation id="8823401858233292222">Chromiumను ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసి, టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="8826492472752484139">“Password Manager”ను క్లిక్ చేయండి</translation>
<translation id="8833697763442816810">ChromiumOS సిస్టమ్</translation>
<translation id="8852026904190808918">Chromiumలో మెనూలు, సెట్టింగ్‌లు, అలర్ట్‌లు, ఇతర టెక్స్ట్‌ను డిస్‌ప్లే చేయడానికి ఈ భాష ఉపయోగించబడుతుంది</translation>
<translation id="8862326446509486874">సిస్టమ్-స్థాయిలో ఇన్‌స్టాల్‌ చేయ‌డానికి మీకు సరైన హక్కులు లేవు. నిర్వాహకుడి లాగా ఇన్‌స్టాలర్‌ను మ‌ళ్లీ రన్ చేయ‌డానికి ప్రయత్నించండి.</translation>
<translation id="6821836710312478344">João Browser ప్రొఫైల్‌ను జోడించండి</translation>
<translation id="5139769635207740615">సైన్-ఇన్ చేయడంలో ఎర్రర్ వచ్చింది. అందువల్ల ChromiumOS మీ Google ఖాతాలో João Browser డేటాను సేవ్ చేయలేకపోయింది</translation>
<translation id="6814613825007700341">మీ సంస్థ పాలసీ ప్రకారం మీరు João Browserకు సైన్ ఇన్ చేయాలి</translation>
<translation id="1009831347869773172">João Browser పాస్‌వర్డ్‌లను చూపడానికి ప్రయత్నిస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="690637523240192979">João Browser ఇకపై మీ ఆటోమేటిక్ బ్రౌజర్‌గా ఉండదు. João Browserను ఆటోమేటిక్ బ్రౌజర్‌గా చేయాలా?</translation>
<translation id="225046375773654931">João Browserని అప్‌డేట్ చేయడం సాధ్యం కాదు</translation>
<translation id="8944232836376404813">ఈ చర్య కారణంగా:
          <ph name="LINE_BREAKS" />
            • మీ ప్రారంభ పేజీ, కొత్త ట్యాబ్ పేజీ, సెర్చ్ ఇంజిన్, పిన్ చేసిన ట్యాబ్‌లు రీసెట్ చేయబడతాయి
            <ph name="LINE_BREAK" />
            • ఎక్స్‌టెన్షన్‌లు డిజేబుల్ చేయబడతాయి
            <ph name="LINE_BREAK" />
            • కుక్కీలు, ఇతర తాత్కాలిక సైట్ డేటాను తొలగించడం జరుగుతుంది
            <ph name="LINE_BREAKS" />
            బుక్‌మార్క్స్, హిస్టరీ, ఇంకా సేవ్ అయిన పాస్‌వర్డ్‌లు ప్రభావితం కావు.</translation>
<translation id="4349474976990059197">João Browser Enterprise లోగో</translation>
<translation id="3227699293368317033">మీ <ph name="DEVICE_TYPE" />‌లోని João Browser యాప్‌తో Google భద్రతను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి.</translation>
<translation id="6527164294507620103">మీ ప్రొఫైల్‌ను తెరుస్తున్నప్పుడు ఏదో పొరపాటు జరిగినందున João Browserను ప్రారంభించడం సాధ్యపడలేదు. João Browserను రీస్టార్ట్ చేయడానికి ట్రై చేయండి.</translation>
<translation id="6741767563284518125">João Browser ప్రొఫైళ్లను మేనేజ్ చేయండి</translation>
<translation id="3101491883380219087">João Browserలోని Gemini, మీరు తెరిచిన ట్యాబ్ మధ్య నావిగేట్ చేయడానికి మీ కీబోర్డ్‌ను ఉపయోగించండి.</translation>
<translation id="9018218886431812662">ఇన్‌స్టాలేషన్ పూర్తయింది</translation>
<translation id="3370247132646333337">João Browserని సురక్షితం చేయడానికి, మేము కింది ఎక్స్‌టెన్షన్‌ను నిలిపివేసాము, ఇది <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />లో లిస్ట్‌ చేయబడలేదు మరియు మీకు తెలియకుండా జోడించబడి ఉండవచ్చు.</translation>
<translation id="1940116386572548863">João Browserకు సైన్ ఇన్ చేయండి</translation>
<translation id="8381652653666868014">ఈ డౌన్‌లోడ్‌ను João Browser బ్లాక్ చేసింది, ఎందుకంటే ఆ ఆర్కైవ్ ఫైల్‌లో మాల్‌వేర్‌ను దాచి ఉంచగల ఇతర ఫైల్స్ ఉన్నాయి</translation>
<translation id="8374335201144490555">మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, హిస్టరీని డివైజ్‌లన్నింటిలో పర్‌ఫెక్ట్‌గా సింక్ చేసి ఉంచుకోండి. మీ ఆటోమేటిక్ బ్రౌజర్‌ను João Browserకు అప్‌డేట్ చేయడం ద్వారా మీకు తెలిసిన, మీరు ఇష్టపడే ఫీచర్‌లను సులభంగా యాక్సెస్ చేయండి. క్విక్ యాక్సెస్ కోసం João Browser మీ టాస్క్‌బార్‌కు పిన్ చేయబడుతుంది.</translation>
<translation id="6176486087616698123">మీ ఫోన్‌లోని João Browser యాప్‌తో Googleకు చెందిన అత్యుత్తమ AI టూల్స్‌ను ఉపయోగించుకోండి</translation>
<translation id="9062666675513499497">మీరు ఇతర Google సర్వీస్‌లకు సైన్ ఇన్ చేసినప్పుడు Chromiumకి సైన్ ఇన్ చేయండి</translation>
<translation id="724802823738504651">João Browser ఆటోమేటిక్‌గా మూసివేయబడింది</translation>
<translation id="2689333215784698609">João Browser కాలం చెల్లినది</translation>
<translation id="8049510467237146160">{0,plural, =1{ఒక గంటలో João Browser తిరిగి ప్రారంభించబడుతుంది}other{# గంటల్లో João Browser తిరిగి ప్రారంభించబడుతుంది}}</translation>
<translation id="9106236359747881194">సెర్చ్ చేయడానికి టెక్స్ట్‌ను ఎంచుకోండి</translation>
<translation id="8558551666630075184">భవిష్యత్తులో João Browser అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 8.1ను ఉపయోగిస్తోంది.</translation>
<translation id="1194819784870407331">కొత్త João Browser &amp;ట్యాబ్‌లో లింక్‌ని తెరువు</translation>
<translation id="911206726377975832">మీ బ్రౌజింగ్ డేటాను కూడా తొలగించాలా?</translation>
<translation id="9134482777260927479">హోమ్‌వర్క్‌లో సహాయం</translation>
<translation id="9148058034647219655">నిష్క్రమించండి</translation>
<translation id="548951409840319583">మీరు ఆపివేసిన చోట నుండి కొనసాగించండి: మీరు రీస్టార్ట్ చేసిన ప్రతిసారీ João Browser మీ ట్యాబ్‌లను రీస్టోర్ చేయగలదు. దీన్ని ఆన్ చేయడానికి, వీటికి వెళ్లండి</translation>
<translation id="7614949510548815395"><ph name="TARGET_URL_HOSTNAME" />‌ను యాక్సెస్ చేయడం కోసం ఒక ప్రత్యామ్నాయ బ్రౌజర్‌ను తెరిచే విధంగా João Browserను మీ సిస్టమ్ నిర్వాహకులు కాన్ఫిగర్ చేశారు.</translation>
<translation id="3441698750089879771">&amp;João Browserను అప్‌డేట్ చేయడానికి రీ-లాంచ్ చేయండి</translation>
<translation id="369689859238510548">João Browser (mDNS-In)</translation>
<translation id="8336832914816665097">João Browserను మీకు అనుకూలంగా ఉండే విధంగా వ్యక్తిగతీకరించుకోండి</translation>
<translation id="7698429329590050365">João Browserకి ఇప్పుడు Windows XP లేదా Windows Vistaలో మద్దతు లేనందున ఇది సరిగ్గా పని చేయకపోవచ్చు</translation>
<translation id="190261805571697214">ప్రయాణంలోనూ Google అత్యుత్తమ భద్రతా ఫీచర్‌లను João Browserతో పొందండి.</translation>
<translation id="945522503751344254">ఫీడ్‌బ్యాక్ పంపండి</translation>
<translation id="5554799509799759090">João Browserను ఎవరు ఉపయోగిస్తున్నారు?</translation>
<translation id="9153108844196984904">João Browser అత్యంత సురక్షితమైన సెక్యూరిటీని పొందండి</translation>
<translation id="983803489796659991">అప్‌డేట్ సర్వర్‌లో అప్లికేషన్ కోసం హ్యాష్ డేటా లేనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="6230710687825107323">ఖాతా లేకుండా João Browserను ఉపయోగించండి</translation>
<translation id="985602178874221306">Chromium రచయితలు</translation>
<translation id="989970834842471429">"ఇమేజ్ సెర్చ్‌"తో సెర్చ్ చేయడానికి టెక్స్ట్‌ను లేదా ఇమేజ్‌ను ఎంచుకోండి</translation>
<translation id="992780518932311116">మీ లొకేషన్‌ను ఉపయోగించడానికి, <ph name="BEGIN_LINK" />సిస్టమ్ సెట్టింగ్‌ల<ph name="END_LINK" />‌లో Chromiumకు యాక్సెస్ ఇవ్వండి</translation>
</translationbundle>