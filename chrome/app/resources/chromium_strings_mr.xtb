<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="mr">
<translation id="1026101648481255140">इंस्टॉलेशन पुन्‍हा सुरू करा</translation>
<translation id="1029669172902658969">&amp;ChromiumOS अपडेट करण्यासाठी पुन्हा लाँच करा</translation>
<translation id="4711726241445951349">João Browser हे तुम्हाला या एक्स्टेंशनचे पुनरावलोकन करण्याची शिफारस करते</translation>
<translation id="1042552502243217427">साइटने त्यांच्या पेजवरील लिंक खाजगीरीत्या प्रीलोड करण्यास सांगितल्यास, Chromium हे Google सर्व्हर वापरते. हे प्रीलोड केलेल्या साइटपासून तुमची ओळख लपवते, पण कोणत्या साइट प्रीलोड केल्या जातात हे Google ला समजते.</translation>
<translation id="1051793555070215510">हे १ मिनिटाचे सर्वेक्षण पूर्ण करून आम्हाला गुप्त मोड मध्ये सुधारणा करण्यात मदत करा.</translation>
<translation id="1065672644894730302">तुमची प्राधान्ये वाचता आली नाहीत.
काही वैशिष्‍ट्ये अनुपलब्ध असू शकतात आणि प्राधान्यांमधील बदल सेव्ह केले जाणार नाहीत.</translation>
<translation id="3937976866851867994">तुमच्या पालकांनी João Browser साठी "साइट, अ‍ॅप्स आणि एक्स्टेंशनकरिता परवानग्या" बंद केल्या आहेत</translation>
<translation id="8626021334348319355">विशिष्ट João Browser वैशिष्ट्य किंवा एक्स्टेंशन शोधण्यासाठी, त्याचा शॉर्टकट आणि त्यानंतर तुम्ही निवडलेली कीबोर्ड की अ‍ॅड्रेस बारमध्ये टाइप करा</translation>
<translation id="571817873405657554">सिस्टीम ट्रेमध्ये João Browser वापरून शोध दाखवा आणि कीबोर्ड शॉर्टकट सुरू करा</translation>
<translation id="9157778882771986870">João Browser ला तुमचे पासवर्ड निर्यात करायचे आहेत. हे करू देण्यासाठी तुमचा Windows पासवर्ड टाइप करा.</translation>
<translation id="112640046208448578">गोष्टी किंवा ठिकाणे ओळखा आणि मजकूर कॉपी अथवा भाषांतरित करा. तुम्ही इमेज शोध वापरता, तेव्हा पेजचा स्क्रीनशॉट सर्व्हरला पाठवला जातो. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium तुमचा डीफॉल्ट ब्राउझर आहे</translation>
<translation id="1131805035311359397">तुमचे पासवर्ड डेटा भंग आणि इतर सुरक्षा समस्यांपासून सुरक्षित आहेत हे तपासण्यासाठी, <ph name="BEGIN_LINK" />Chromium मध्ये साइन इन करा<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">João Browser मेनूवर क्लिक करा</translation>
<translation id="1157985233335035034">अलीकडील भाषा</translation>
<translation id="1184145431117212167">तुमच्या Windows च्या आवृत्तीला सपोर्ट नसल्यामुळे इंस्टॉलेशन करता आले नाही.</translation>
<translation id="1185134272377778587">Chromium बद्दल</translation>
<translation id="667420476518265356">तुमच्या फोनवर João Browser सह किमतीचा माग ठेवण्याशी संबंधित अलर्ट मिळवा</translation>
<translation id="1203500561924088507">इंस्टॉल केल्याबद्दल धन्यवाद. तुम्ही <ph name="BUNDLE_NAME" /> वापरण्यापूर्वी तुमचा ब्राउझर रीस्टार्ट करणे आवश्यक आहे.</translation>
<translation id="1232234696885483911">तुम्ही इमेज शोध उघडता, तेव्हा PDFs सह पेजचे शीर्षक, URL आणि आशय आपोआप सर्व्हरला पाठवला जाईल. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">तुम्ही साइन इन केलेले असताना, João Browser मध्ये तुमच्या Google खाते मधून तुमचे पासवर्ड आणि आणखी बऱ्याच गोष्टी वापरू शकता. हे बदलण्यासाठी, “João Browser मधील तुमचे खाते” वर जा.</translation>
<translation id="4866003137980530528">Mac मेनू बारमधील João Browser मधील Gemini दाखवा</translation>
<translation id="2526294198551578217">João Browser मधील Gemini मध्ये स्क्रीनचा भाग निवडण्यासाठी, कीबोर्ड शॉर्टकट वापरा.</translation>
<translation id="7068536367561625920">हा टॅब इनॅक्टिव्ह असताना, João Browser ला जलद ठेवण्यासाठी मेमरी मोकळी करण्यात आली होती. ही साइट इनॅक्टिव्ह राहण्यापासून नेहमी वगळली जावी असे तुम्ही निवडू शकता.</translation>
<translation id="3669854427836618143">फाइल धोकादायक असल्याने João Browser ने हे डाउनलोड ब्लॉक केले आहे</translation>
<translation id="126567311906253476"><ph name="USER_EMAIL" /> वापरून Gmail किंवा YouTube सारख्या Google सेवांमध्ये साइन इन करताना, तुम्ही तेच खाते वापरून Chromium मध्ये आपोआप साइन इन करू शकता</translation>
<translation id="8094399825947986050">तुमच्या फोनवर João Browser मिळवा</translation>
<translation id="1290883685122687410">सेटअप एरर: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">तुमची नवीन João Browser प्रोफाइल सेट करा</translation>
<translation id="7591029065989504977">João Browser मधील Gemini वापरून पहा</translation>
<translation id="8408989583029959522">ब्लूटूथ डिव्हाइस एक्सप्लोर करण्यासाठी João Browser ला&#32;
 ब्लूटूथ चा ॲक्सेस हवा आहे. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">तुमच्या फोनवर João Browser मध्ये साइन इन करा</translation>
<translation id="1330562121671411446">भाषा डिटेक्ट करा</translation>
<translation id="6026568602942276348">तसेच João Browser मधून डेटा हटवा (<ph name="URL" />)</translation>
<translation id="1345251407431278948">पिन केले आहे! तुम्ही टूलबारवरील नवीन बटण वापरून इमेज शोध पुन्हा अ‍ॅक्सेस करू शकता</translation>
<translation id="1356661055722410047">नवीन! तुम्ही तुमच्या स्क्रीनवरील मजकूर आणि इमेज दोन्हींचे भाषांतर करू शकता</translation>
<translation id="1383876407941801731">शोधा</translation>
<translation id="5807085300679014096">फिरतीवर असताना ब्राउझ करणे सुरू ठेवण्यासाठी João Browser अ‍ॅप वापरा</translation>
<translation id="141901961143729572">तुमचे विचार शेअर करा</translation>
<translation id="3736947618013031173">तुमची विंडो शेअर करण्यासाठी, सिस्टीम सेटिंग्ज मध्ये João Browser साठी स्क्रीन रेकॉर्डिंगला अनुमती द्या.</translation>
<translation id="1478370723027452770">Chrome for Testing शी संबंधित मदत मिळवा</translation>
<translation id="1497802159252041924">इंस्टॉलसंबंधित एरर: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">हे पेज सुरक्षित आहे</translation>
<translation id="4379865404970367448">João Browser टॅब शेअर करा</translation>
<translation id="4436275659297289591">João Browser मध्ये साइन इन करा</translation>
<translation id="1547469039832541117">हायलाइट केलेली टास्क संपवते.</translation>
<translation id="449712764049695153">João Browser पिन करा</translation>
<translation id="1574377791422810894">Chromium ची सुरक्षितता टूल</translation>
<translation id="5480232403718129394">João Browser ला तुमचा Password Manager डेटा हटवायचा आहे. याला अनुमती देण्यासाठी तुमचा Windows पासवर्ड टाइप करा.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{अपडेट लागू करता यावे यासाठी तुम्ही João Browser पुन्हा लाँच करण्याची तुमच्या ॲडमिनिस्ट्रेटरला गरज आहे}=1{अपडेट लागू करता यावे यासाठी तुम्ही João Browser पुन्हा लाँच करण्याची तुमच्या ॲडमिनिस्ट्रेटरला गरज आहे. तुमची गुप्त विंडो पुन्हा उघडणार नाही.}other{अपडेट लागू करता यावे यासाठी तुम्ही João Browser पुन्हा लाँच करण्याची तुमच्या ॲडमिनिस्ट्रेटरला गरज आहे. तुमच्या # गुप्त विंडो पुन्हा उघडणार नाहीत.}}</translation>
<translation id="980976428162070137">तुमच्या फोनवरील João Browser अ‍ॅपसह Google चा सर्वोत्तम अनुभव मिळवा</translation>
<translation id="1625909126243026060">Chromium मधील महत्त्वाच्या गोपनीयता आणि सुरक्षा नियंत्रणांचे पुनरावलोकन करा</translation>
<translation id="1640672724030957280">डाऊनलोड करीत आहे...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" />, सदस्यत्व म्हणून साइन इन केले आहे. खाते मेनू उघडा</translation>
<translation id="1708414395296835197">तुम्ही मेसेज, दस्तऐवज आणि इतर अ‍ॅप्स यांमधील लिंकवर कधीही क्लिक कराल, तेव्हा Chromium वापरू शकता. ते तुमच्या टास्कबारवरदेखील पिन केले जाईल.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> साठी वाढीव विशेषाधिकार देते.</translation>
<translation id="1722488837206509557">यामुळे तुम्हाला उपलब्ध डिव्हाइसमधून निवडता येईल आणि आशय दाखवता येईल.</translation>
<translation id="6972087163510342335">João Browser लवकरच ब्राउझिंग डेटा हटवेल</translation>
<translation id="1736443181683099871">Chromium हे नेव्हिगेशन HTTPS वर अपग्रेड करण्याचा प्रयत्न करेल</translation>
<translation id="3879288383593333401">João Browser डेटा साफ करण्यात आला</translation>
<translation id="656496276885630888"><ph name="REMAINING_TIME" /> मध्ये João Browser रीस्टार्ट होईल</translation>
<translation id="1749104137266986751">HTTPS उपलब्ध नसल्यास, Chromium तुम्हाला चेतावणी न देता असुरक्षित कनेक्शन वापरेल</translation>
<translation id="1226290419185955779">João Browser बॅकग्राउंडमध्ये सुरू द्या</translation>
<translation id="4231366995273072370">João Browser अधिक सुरक्षित बनविण्‍यासाठी, आम्‍ही <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> मध्‍ये सूचीबद्ध नसलेले आणि आपल्‍या माहिती शिवाय कदाचित जोडले गेलेले काही विस्‍तार अक्षम केले.</translation>
<translation id="1822049153969905781">झटपट अ‍ॅक्सेस करण्याकरिता Chrome तुमच्या टास्कबारवर पिन करण्यासाठी Windows नोटिफिकेशनमध्ये <ph name="BEGIN_BOLD" />होय<ph name="END_BOLD" /> वर क्लिक करा.</translation>
<translation id="1321831992638405531">João Browser पुनर्स्थापित करा</translation>
<translation id="3386967202064865436">João Browser <ph name="AUTHENTICATION_PURPOSE" /> याचा प्रयत्न करत आहे</translation>
<translation id="70054449700528483">तुम्ही पुढील वेळी तुमच्या <ph name="DEVICE_TYPE" /> वर João Browser उघडल्यावर, तुम्हाला Google Password Manager वापरण्यासाठी प्रॉम्प्ट दिसेल.</translation>
<translation id="1838374766361614909">शोध साफ करा</translation>
<translation id="5807096362853316123">तुमच्या Google खाते मध्ये ब्राउझिंग डेटा राखून ठेवून, तो फक्त या डिव्हाइसवरून हटवण्यासाठी, <ph name="BEGIN_LINK" />João Browser मधून साइन आउट करणे<ph name="END_LINK" /> हे करा.</translation>
<translation id="6396384011117650379">फिरतीवर असताना नवीन टॅब गट उघडण्यासाठी किंवा तयार करण्यासाठी तुमच्या फोनवर João Browser डाउनलोड करा.</translation>
<translation id="185970820835152459">तुम्ही तुमची साइन इन केलेली Google खाती व्यवस्थापित करू शकता. तुमची Google खाती Chromium ब्राउझर, Play Store, Gmail आणि बर्‍याच गोष्टींसाठी वापरली जातात. तुम्हाला कुटुंब सदस्यासारख्या इतर कोणासाठी खाते जोडायचे असल्यास, त्याऐवजी तुमच्या <ph name="DEVICE_TYPE" /> वर नवीन व्यक्ती जोडा. <ph name="LINK_BEGIN" />अधिक जाणून घ्या<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">इमेज शोध वापरून शोधा</translation>
<translation id="65457771685016683"><ph name="EXISTING_USER" /> यांनी आधीच साइन इन केले आहे. तुमचे ब्राउझिंग स्वतंत्र ठेवण्यासाठी, तुमच्या स्वतःच्या प्रोफाइलमधील João Browser मध्ये <ph name="USER_EMAIL_ADDRESS" /> म्हणून साइन इन करा. तुम्हाला <ph name="DEVICE" /> कडून तुमचे बुकमार्क आणि आणखी बऱ्याच गोष्टीदेखील मिळतील.</translation>
<translation id="1880677175115548835">मजकूर निवडा</translation>
<translation id="2634119629547215883">तुम्ही एका व्यवस्थापित खात्यासह साइन इन करत आहात आणि तुमच्या João Browser प्रोफाइलवर त्याच्या ॲडमिनिस्ट्रेटरला नियंत्रण देत आहात. तुमचा João Browser डेटा, जसे की तुमचे अ‍ॅप्स, बुकमार्क, इतिहास, पासवर्ड आणि अन्य सेटिंग्ज <ph name="USER_NAME" /> वर कायमच्या बद्ध होतील. तुम्ही Google खाती डॅशबोर्डद्वारे हा डेटा हटवण्यात सक्षम व्हाल, परंतु तुम्ही दुसर्‍या खात्यासह हा डेटा संबद्ध करण्यात सक्षम असणार नाही. तुम्ही तुमचा विद्यमान João Browser डेटा वेगळी ठेवण्यासाठी एक नवीन पर्यायी प्रोफाइल तयार करू शकता. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium हे स्मूथ स्क्रोलिंग आणि व्हिडिओ फ्रेम रेटसारखी बॅकग्राउंड अ‍ॅक्टिव्हिटी व व्हिज्युअल इफेक्ट मर्यादित करून बॅटरी पॉवरची बचत करते. <ph name="BEGIN_LINK" />एनर्जी सेव्हर बद्दल अधिक जाणून घ्या<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">João Browser Updater सेवा</translation>
<translation id="1911763535808217981">हे बंद करून, तुम्ही Chromium वर साइन इन न करता Gmail सारख्या Google साइटवर साइन इन करू शकता</translation>
<translation id="4037729269678342163">João Browser असंवादी आहे. आता पुन्‍हा लाँच करायचे?</translation>
<translation id="7563750688920581112">तुमची संस्थेच्या <ph name="MANAGER" /> नुसार तुम्ही João Browser मध्ये साइन इन करणे आवश्यक आहे</translation>
<translation id="193439633299369377">अपडेट लागू करण्यासाठी ChromiumOS रीस्टार्ट करणे आवश्यक आहे.</translation>
<translation id="7099143775283792684">फाइल प्रकार सामान्यतः डाउनलोड केला जात नसल्याने João Browser ने हे डाउनलोड ब्लॉक केले आहे आणि तो धोकादायक असू शकतो</translation>
