<!DOCTYPE translationbundle>
<translationbundle lang="lo">
<translation id="1026101648481255140">ສືບຕໍ່ການຕິດຕັ້ງ</translation>
<translation id="1029669172902658969">ເລີ່ມເປີດໃຊ້ໃໝ່ເພື່ອອັບເດດ &amp;ChromiumOS</translation>
<translation id="4711726241445951349">João Browser ຂໍແນະນຳໃຫ້ທ່ານກວດສອບສ່ວນຂະຫຍາຍນີ້</translation>
<translation id="1042552502243217427">ເມື່ອເວັບໄຊຂໍໂຫຼດລິ້ງຢູ່ໜ້າເວັບຂອງເຂົາເຈົ້າໄວ້ກ່ອນລ່ວງໜ້າແບບສ່ວນຕົວ, Chromium ຈະໃຊ້ເຊີບເວີຂອງ Google. ການດຳເນີນການນີ້ຈະເຊື່ອງຕົວຕົນຂອງທ່ານຈາກເວັບໄຊທີ່ໂຫຼດກ່ອນລ່ວງໜ້າ, ແຕ່ Google ຈະສຶກສາວ່າເວັບໄຊໃດໄດ້ຮັບການໂຫຼດກ່ອນລ່ວງໜ້າ.</translation>
<translation id="1051793555070215510">ຊ່ວຍພວກເຮົາປັບປຸງໂໝດບໍ່ເປີດເຜີຍຕົວຕົນໂດຍເຮັດແບບສຳຫຼວດ 1 ນາທີນີ້.</translation>
<translation id="1065672644894730302">ບໍ່ສາມາດອ່ານຄວາມມັກຂອງທ່ານໄດ້.

ບາງຄຸນສົມບັດ​ອາດຈະບໍ່ມີໃຫ້ ແລະການປ່ຽນແປງຕໍ່ຄວາມມັກຈະບໍ່ຖືກບັນທຶກ.</translation>
<translation id="3937976866851867994">ພໍ່ແມ່ຂອງທ່ານໄດ້ປິດ "ການອະນຸຍາດສຳລັບເວັບໄຊ, ແອັບ ແລະ ສ່ວນຂະຫຍາຍ" ສຳລັບ João Browser ແລ້ວ</translation>
<translation id="8626021334348319355">ເພື່ອຊອກຫາຄຸນສົມບັດ ຫຼື ສ່ວນຂະຫຍາຍທີ່ສະເພາະຂອງ João Browser, ໃຫ້ພິມທາງລັດຂອງຄຸນສົມບັດ ຫຼື ສ່ວນຂະຫຍາຍໃສ່ໃນແຖບທີ່ຢູ່, ຕາມດ້ວຍປຸ່ມແປ້ນພິມທີ່ທ່ານເລືອກໄວ້</translation>
<translation id="9157778882771986870">João Browser ຕ້ອງການສົ່ງອອກລະຫັດຜ່ານຂອງທ່ານ. ກະລຸນາພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດສິ່ງນີ້.</translation>
<translation id="112640046208448578">ລະບຸສິ່ງຂອງ ຫຼື ສະຖານທີ່ ແລ້ວສຳເນົາ ຫຼື ແປຂໍ້ຄວາມ. ເມື່ອທ່ານໃຊ້ການຊອກຫາຮູບ, ລະບົບຈະສົ່ງຮູບໜ້າຈໍຂອງໜ້າເວັບໄປໃຫ້ເຊີບເວີ. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium ແມ່ນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="1131805035311359397">ເພື່ອກວດເບິ່ງວ່າລະຫັດຜ່ານຂອງທ່ານປອດໄພຈາກການລະເມີດຂໍ້ມູນ ແລະ ບັນຫາຄວາມປອດໄພອື່ນຫຼືບໍ່, ກະລຸນາ <ph name="BEGIN_LINK" />ເຂົ້າສູ່ລະບົບ Chromium<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">ຄລິກເມນູ João Browser</translation>
<translation id="1157985233335035034">ພາສາຫຼ້າສຸດ</translation>
<translation id="1184145431117212167">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກລະບົບບໍ່ຮອງຮັບ Windows ເວີຊັນທີ່ທ່ານໃຊ້.</translation>
<translation id="1185134272377778587">ກ່ຽວ​ກັບ Chromium</translation>
<translation id="667420476518265356">ຮັບການແຈ້ງເຕືອນການຕິດຕາມລາຄາດ້ວຍ João Browser ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="1203500561924088507">ຂໍຂອບໃຈສຳລັບການຕິດຕັ້ງ. ທ່ານຈະຕ້ອງຣີສະຕາດໂປຣແກຣມທ່ອງເວັບຂອງທ່ານກ່ອນການໃຊ້ <ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">ເມື່ອທ່ານເປີດການຊອກຫາຮູບ, ລະບົບຈະສົ່ງຊື່ໜ້າ, URL ແລະ ເນື້ອຫາ, ຮວມທັງ PDF ໄປຫາເຊີບເວີໂດຍອັດຕະໂນມັດ. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">ໃນລະຫວ່າງທີ່ທ່ານເຂົ້າສູ່ລະບົບ, ທ່ານສາມາດໃຊ້ລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກບັນຊີ Google ຂອງທ່ານໃນ João Browser ໄດ້. ເພື່ອປ່ຽນສິ່ງນີ້, ໃຫ້ເຂົ້າໄປ “ບັນຊີຂອງທ່ານໃນ João Browser”.</translation>
<translation id="4866003137980530528">ສະແດງ Gemini ໃນ João Browser ໃນແຖບເມນູຂອງ Mac</translation>
<translation id="2526294198551578217">ເພື່ອເລືອກພາກສ່ວນໜຶ່ງຂອງໜ້າຈໍໃນ Gemini ໃນ João Browser, ໃຫ້ໃຊ້ຄີລັດ.</translation>
<translation id="7068536367561625920">ໃນຂະນະທີ່ແຖບນີ້ບໍ່ມີການນຳໃຊ້, ລະບົບຈະເພີ່ມພື້ນທີ່ຫວ່າງໃນໜ່ວຍຄວາມຈຳເພື່ອໃຫ້ໃຊ້ João Browser ໄດ້ຢ່າງວ່ອງໄວຢູ່ຕະຫຼອດ. ທ່ານສາມາດເລືອກຍົກເວັ້ນໃຫ້ເວັບໄຊນີ້ເຮັດວຽກຕະຫຼອດເວລາໄດ້.</translation>
<translation id="3669854427836618143">João Browser ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກໄຟລ໌ເປັນອັນຕະລາຍ</translation>
<translation id="126567311906253476">ເມື່ອເຂົ້າສູ່ລະບົບບໍລິການຕ່າງໆຂອງ Google ເຊັ່ນ: Gmail ຫຼື YouTube ດ້ວຍ <ph name="USER_EMAIL" />, ທ່ານສາມາດເຂົ້າສູ່ລະບົບ Chromium ດ້ວຍບັນຊີດຽວກັນໄດ້ໂດຍອັດຕະໂນມັດ</translation>
<translation id="8094399825947986050">ດາວໂຫຼດ João Browser ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="1290883685122687410">ຂໍ້ຜິດພາດໃນການຕັ້ງຄ່າ: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">ຕັ້ງຄ່າໂປຣໄຟລ໌ João Browser ໃໝ່ຂອງທ່ານ</translation>
<translation id="7591029065989504977">ລອງໃຊ້ Gemini ໃນ João Browser</translation>
<translation id="8408989583029959522">João Browser ຕ້ອງການສິດເຂົ້າເຖິງ Bluetooth ເພື່ອສຳຫຼວດ&#32;
 ອຸປະກອນ Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">ເຂົ້າສູ່ລະບົບ João Browser ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="1330562121671411446">ກວດຫາພາສາ</translation>
<translation id="6026568602942276348">ລຶບຂໍ້ມູນອອກຈາກ João Browser (<ph name="URL" />) ນຳ</translation>
<translation id="1345251407431278948">ປັກໝຸດແລ້ວ! ທ່ານສາມາດເຂົ້າເຖິງການຊອກຫາຮູບໄດ້ອີກຄັ້ງຈາກປຸ່ມໃໝ່ໃນແຖບເຄື່ອງມື</translation>
<translation id="1356661055722410047">ໃໝ່! ທ່ານສາມາດແປໄດ້ທັງຂໍ້ຄວາມ ແລະ ຮູບພາບຢູ່ໜ້າຈໍຂອງທ່ານ</translation>
<translation id="1383876407941801731">ຊອກຫາ</translation>
<translation id="5807085300679014096">ໃຊ້ແອັບ João Browser ເພື່ອທ່ອງເວັບໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="141901961143729572">ແບ່ງປັນຄວາມຄິດຂອງທ່ານ</translation>
<translation id="3736947618013031173">ເພື່ອແບ່ງປັນໜ້າຈໍຂອງທ່ານ, ໃຫ້ອະນຸຍາດການບັນທຶກໜ້າຈໍສຳລັບ João Browser ໃນການຕັ້ງຄ່າລະບົບ.</translation>
<translation id="1478370723027452770">ຮັບຄວາມຊ່ວຍເຫຼືອກ່ຽວກັບ Chrome ສຳລັບການທົດສອບ</translation>
<translation id="1497802159252041924">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">ໜ້ານີ້ໄດ້ຮັບການປ້ອງກັນ</translation>
<translation id="4379865404970367448">ແບ່ງປັນແຖບ João Browser</translation>
<translation id="4436275659297289591">ເຂົ້າສູ່ລະບົບ João Browser</translation>
<translation id="1547469039832541117">ສິ້ນສຸດໜ້າວຽກທີ່ໄຮໄລ້.</translation>
<translation id="449712764049695153">ປັກໝຸດ João Browser</translation>
<translation id="1574377791422810894">ເຄື່ອງມືຄວາມປອດໄພຂອງ Chromium</translation>
<translation id="5480232403718129394">João Browser ຕ້ອງການລຶບຂໍ້ມູນຕົວຈັດການລະຫັດຜ່ານຂອງທ່ານ. ກະລຸນາພິມລະຫັດຜ່ານ Windows ຂອງທ່ານເພື່ອອະນຸຍາດສິ່ງນີ້.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ João Browser ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ}=1{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ João Browser ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ João Browser ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານ # ລາຍການຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="980976428162070137">ຮັບປະໂຫຍດສູງສຸດຈາກ Google ດ້ວຍແອັບ João Browser ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="1625909126243026060">ກວດສອບການຄວບຄຸມຄວາມເປັນສ່ວນຕົວ ແລະ ຄວາມປອດໄພຫຼັກໃນ Chromium</translation>
<translation id="1640672724030957280">ກຳລັງດາວໂຫຼດ...</translation>
<translation id="1665602916345474427">ເຂົ້າສູ່ລະບົບໃນຊື່ <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, ສະມາຊິກ. ເປີດເມນູບັນຊີ</translation>
<translation id="1708414395296835197">ທ່ານສາມາດໃຊ້ Chromium ໄດ້ທຸກເທື່ອທີ່ທ່ານຄລິກລິ້ງໃນຂໍ້ຄວາມ, ເອກະສານ ແລະ ແອັບອື່ນໆ. ນອກຈາກນີ້, ລະບົບຍັງຈະປັກໝຸດໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານນຳ.</translation>
<translation id="1709772298389099340">ໃຫ້ສິດທິພິເສດລະດັບສູງສຳລັບ <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">ວິທີນີ້ຈະຊ່ວຍໃຫ້ທ່ານສາມາດເລືອກຈາກອຸປະກອນທີ່ພ້ອມນຳໃຊ້ ແລະ ສະແດງເນື້ອຫາຢູ່ອຸປະກອນເຫຼົ່ານັ້ນ.</translation>
<translation id="6972087163510342335">João Browser ຈະລຶບຂໍ້ມູນການທ່ອງເວັບໃນໄວໆນີ້</translation>
<translation id="1736443181683099871">Chromium ຈະພະຍາຍາມອັບເກຣດການນຳທາງເປັນ HTTPS</translation>
<translation id="3879288383593333401">ລຶບລ້າງຂໍ້ມູນ João Browser ແລ້ວ</translation>
<translation id="656496276885630888">João Browser ຈະຣີສະຕາດໃນ <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">ເມື່ອບໍ່ສາມາດໃຊ້ HTTPS ໄດ້, Chromium ຈະໃຊ້ການເຊື່ອມຕໍ່ທີ່ບໍ່ປອດໄພໂດຍບໍ່ເຕືອນທ່ານ</translation>
<translation id="1226290419185955779">ປ່ອຍໃຫ້ João Browser ແລ່ນຢູ່ໃນພື້ນຫຼັງ</translation>
<translation id="4231366995273072370">ເພື່ອເຮັດໃຫ້ João Browser ປອດໄພຂຶ້ນ, ພວກເຮົາປິດໃຊ້ງານບາງສ່ວນຂະຫຍາຍທີ່ບໍ່ໄດ້ມີລາຍຊື່ຢູ່ໃນ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ແລະອາດຈະຖືກເພີ່ມເຂົ້າໂດຍທີ່ທ່ານບໍ່ຮູ້ຈັກ.</translation>
<translation id="1822049153969905781">ຄລິກ <ph name="BEGIN_BOLD" />ແມ່ນ<ph name="END_BOLD" /> ໃນການແຈ້ງເຕືອນ Windows ເພື່ອປັກໝຸດ João Browser ໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານເພື່ອການເຂົ້າເຖິງດ່ວນ.</translation>
<translation id="1321831992638405531">ຕິດຕັ້ງ João Browser ຄືນໃໝ່</translation>
<translation id="3386967202064865436">João Browser ກຳລັງພະຍາຍາມໃຊ້ <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="70054449700528483">ເທື່ອຕໍ່ໄປທີ່ທ່ານເປີດ João Browser ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ, ທ່ານຈະເຫັນຂໍ້ຄວາມແຈ້ງໃຫ້ໃຊ້ຕົວຈັດການລະຫັດຜ່ານ Google.</translation>
<translation id="1838374766361614909">ລຶບ​ການ​ຊອກ​ຫາ</translation>
<translation id="5807096362853316123">ເພື່ອລຶບຂໍ້ມູນການທ່ອງເວັບໃນອຸປະກອນນີ້ເທົ່ານັ້ນ, ແຕ່ຍັງຮັກສາຂໍ້ມູນດັ່ງກ່າວໄວ້ໃນບັນຊີ Google ຂອງທ່ານ, ໃຫ້ <ph name="BEGIN_LINK" />ອອກຈາກລະບົບ João Browser<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">ດາວໂຫຼດ João Browser ຢູ່ໂທລະສັບຂອງທ່ານເພື່ອເປີດ ຫຼື ສ້າງກຸ່ມແຖບໃໝ່ໄດ້ທຸກບ່ອນທຸກເວລາ.</translation>
<translation id="185970820835152459">ທ່ານສາມາດຈັດການບັນຊີ Google ທີ່ເຂົ້າສູ່ລະບົບແລ້ວຂອງທ່ານໄດ້. ບັນຊີ Google ຂອງທ່ານແມ່ນໃຊ້ສຳລັບໂປຣແກຣມທ່ອງເວັບ Chromium, Play Store, Gmail ແລະ ອື່ນໆ. ຫາກທ່ານຕ້ອງການເພີ່ມບັນຊີໃຫ້ຄົນອື່ນ ເຊັ່ນ: ສະມາຊິກຄອບຄົວ, ໃຫ້ເພີ່ມຄົນໃໝ່ໃສ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານແທນ. <ph name="LINK_BEGIN" />ສຶກສາເພີ່ມເຕີມ<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">ຊອກຫາດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="65457771685016683"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" /> ນຳ.</translation>
<translation id="1880677175115548835">ເລືອກຂໍ້ຄວາມ</translation>
<translation id="2634119629547215883">ທ່ານກໍາລັງລົງຊື່ເຂົ້າ​ໃຊ້ດ້ວຍບັນຊີຄຸ້ມຄອງ ແລະໃຫ້ຜູ້ຄວບຄຸມຂອງມັນຄວບຄຸມໂປຣໄຟລ໌ João Browser ຂອງທ່ານ. ຂໍ້ມູນ João Browser ຂອງທ່ານ, ເຊັ່ນ: ແອັບ, ບຸກມາກສ໌, ປະຫວັດ, ລະຫັດຜ່ານ, ແລະການຕັ້ງຄ່າອື່ນໆຂອງທ່ານຈະຜູກ​ມັດ​ກັບ <ph name="USER_NAME" /> ຢ່າງຖາວອນ. ທ່ານຈະສາມາດລຶບຂໍ້ມູນນີ້ໄດ້ຜ່ານ Google Accounts Dashboard, ແຕ່ທ່ານຈະບໍ່ສາມາດເອົາຂໍ້ມູນນີ້ເຂົ້າຮ່ວມກັບບັນຊີອື່ນໄດ້. ​ໂດຍ​ເລືອກ​ໄດ້ ທ່ານ​ສາມາດ​ສ້າງໂປຣໄຟລ໌​ໃໝ່​ເພື່ອ​ຮັກສາ​ຂໍ້ມູນ João Browser ທີ່​ມີ​ຢູ່​ຂອງ​ທ່ານ​ແຍກ​ຕ່າງຫາກ. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium ຈະຊ່ວຍປະຢັດພະລັງງານແບັດເຕີຣີໂດຍການຈຳກັດກິດຈະກຳຢູ່ພື້ນຫຼັງ ແລະ ເອັບເຟັກພາບ ເຊັ່ນ: ການເລື່ອນທີ່ນຸ້ມນວນ ແລະ ອັດຕາເຟຣມວິດີໂອ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບຕົວປະຢັດພະລັງງານ<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">ບໍລິການ João Browser Updater</translation>
<translation id="1911763535808217981">ໂດຍການປິດສິ່ງນີ້, ທ່ານສາມາດເຂົ້າສູ່ລະບົບເວັບໄຊຂອງ Google ເຊັ່ນ: Gmail ໄດ້ໂດຍບໍ່ຕ້ອງເຂົ້າສູ່ລະບົບ Chromium</translation>
<translation id="4037729269678342163">João Browser ບໍ່ຕອບຮັບ. ເລີ່ມເປີດໃຊ້ໃໝ່ດຽວນີ້ບໍ?</translation>
<translation id="7563750688920581112">ອົງກອນຂອງທ່ານ, <ph name="MANAGER" />, ກຳນົດໃຫ້ທ່ານເຂົ້າສູ່ລະບົບ João Browser</translation>
<translation id="193439633299369377">ຈຳເປັນຕ້ອງຣີສະຕາດ ChromiumOS ເພື່ອນຳໃຊ້ການອັບເດດ.</translation>
<translation id="7099143775283792684">João Browser ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກໄຟລ໌ປະເພດນີ້ບໍ່ໄດ້ມີການດາວໂຫຼດໂດຍທົ່ວໄປ ແລະ ອາດເປັນອັນຕະລາຍ</translation>
<translation id="1953553007165777902">ກຳລັງດາວໂຫຼດ... ຍັງເຫຼືອ <ph name="MINUTE" /> ນາທີ</translation>
<translation id="1966382378801805537">Chromium ບໍ່ສາມາດກຳນົດ ຫຼື ຕັ້ງໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນໄດ້</translation>
<translation id="197326043290947695">ທ່ອງເວັບຢ່າງອັດສະລິຍະຂຶ້ນດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="6185556991023272801">ສຶກສາວ່າເປັນຫຍັງ João Browser ຈຶ່ງບລັອກບາງໄຟລ໌, ເປີດໃນແຖບໃໝ່</translation>
<translation id="4053636705816895911">ກະລຸນາອັບເດດຊອບແວ João Browser ໃຫ້ເປັນເວີຊັນຫຼ້າສຸດຢູ່ສະເໝີ. ຫາກປິດການນຳໃຊ້ ຫຼື ຢຸດບໍລິການນີ້, ຊອບແວ João Browser ຂອງທ່ານຈະບໍ່ໄດ້ຮັບການອັບເດດ, ເຊິ່ງໝາຍຄວາມວ່າຊ່ອງຫວ່າງດ້ານຄວາມປອດໄພທີ່ອາດເກີດຂຶ້ນຈະບໍ່ສາມາດແກ້ໄຂໄດ້ ແລະ ຄຸນສົມບັດອາດບໍ່ເຮັດວຽກ. ບໍລິການນີ້ຈະຖອນການຕິດຕັ້ງຕົວເອງເມື່ອບໍ່ມີຊອບແວ João Browser ນຳໃຊ້ຢູ່.</translation>
<translation id="2008474315282236005">ນີ້ຈະລຶບ 1 ລາຍການອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຂອງທ່ານຄືນໃນພາຍຫຼັງ, ກະລຸນາເຂົ້າສູ່ລະບົບ Chromium ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">ການຕິດຕັ້ງບໍ່ສຳເລັດ. ກະລຸນາລອງໃໝ່.</translation>
<translation id="2039417478970545937">ການຕັ້ງຄ່າ.</translation>
<translation id="2049376729098081731">ເລືອກວ່າຈະໃຫ້ຮວມປະຫວັດ Chromium ສຳລັບປະສົບການທີ່ປັບແຕ່ງສ່ວນຕົວໃນບໍລິການ Google ຫຼືບໍ່</translation>
<translation id="6768767091114123654">ຕິດຕັ້ງມາໃນ João Browser ເພື່ອຊ່ວຍທ່ານສ້າງ, ບັນທຶກ ແລະ ຕື່ມຂໍ້ມູນລະຫັດຜ່ານຍາກໂດຍອັດຕະໂນມັດ. ເພີ່ມທາງລັດເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ງ່າຍ.</translation>
<translation id="3571664229232252557">ຄລິກປຸ່ມປັບແຕ່ງ João Browser ຢູ່ໜ້າແຖບໃໝ່ເພື່ອໃຫ້ João Browser ມີຮູບລັກໃໝ່</translation>
<translation id="4273287215573278663">João Browser ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກໄຟລ໌ມີການຫຼອກລວງ ແລະ ອາດເຮັດການປ່ຽນແປງທີ່ບໍ່ຄາດຄິດກັບອຸປະກອນຂອງທ່ານ</translation>
<translation id="9063967192437499581">ທ່ານຈະເຫັນຂໍ້ຄວາມແຈ້ງໃຫ້ລອງໃຊ້ <ph name="FEATURE_NAME" /> ໃນເທື່ອຕໍ່ໄປທີ່ທ່ານເປີດ João Browser ຢູ່ iOS.</translation>
<translation id="8511569826706775962">ລະບົບຈະລຶບລະຫັດຜ່ານຂອງທ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງ João Browser ທີ່ທ່ານບັນທຶກໄວ້ໃນບັນຊີ Google ຂອງທ່ານອອກຈາກອຸປະກອນນີ້. ເພື່ອໃຊ້ຂໍ້ມູນເຫຼົ່ານີ້ໃນ João Browser, ໃຫ້ເຂົ້າສູ່ລະບົບອີກຄັ້ງ.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{ອົງກອນຂອງທ່ານຈະລຶບຂໍ້ມູນການທ່ອງເວັບອອກໂດຍອັດຕະໂນມັດເມື່ອບໍ່ໄດ້ໃຊ້ João Browser ເປັນເວລາ 1 ນາທີ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ. ແຖບຂອງທ່ານຈະຍັງເປີດຢູ່.}other{ອົງກອນຂອງທ່ານຈະລຶບຂໍ້ມູນການທ່ອງເວັບອອກໂດຍອັດຕະໂນມັດເມື່ອບໍ່ໄດ້ໃຊ້ João Browser ເປັນເວລາ # ນາທີ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ. ແຖບຂອງທ່ານຈະຍັງເປີດຢູ່.}}</translation>
<translation id="2125838419757773031">ເລືອກພື້ນທີ່ໜ້າຈໍເພື່ອຊອກຫາ</translation>
<translation id="2126108037660393668">ໄຟລ໌ທີ່ດາວໂຫຼດໄວ້ບໍ່ຜ່ານການຢັ້ງຢືນ.</translation>
<translation id="2135919691573380097">ລາຍງານເວັບໄຊນີ້</translation>
<translation id="2137162749895930932">ປິດໜ້າຈໍແປພາສາ</translation>
<translation id="1308845716497059117">João Browser ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກເວັບໄຊບໍ່ໄດ້ໃຊ້ການເຊື່ອມຕໍ່ທີ່ປອດໄພ ແລະ ໄຟລ໌ອາດມີການດັດແປງ</translation>
<translation id="2170098639895543546">ເລືອກສິ່ງໃດກໍໄດ້ໃນໜ້າ</translation>
<translation id="6705844023496387932">ປັບແຕ່ງ João Browser</translation>
<translation id="2174917724755363426">ການຕິດຕັ້ງບໍ່ສຳເລັດ. ທ່ານແນ່ໃຈບໍ່ວ່າທ່ານຕ້ອງການຍົກເລີກ?</translation>
<translation id="7728290795259244895">João Browser - ການເຂົ້າສູ່ລະບົບເຄືອຂ່າຍ - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">ກວດສອບການອັບເດດຜິດພາດ: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">ລຶບບັນຊີອອກຈາກ João Browser</translation>
<translation id="4648870374540039667">ໃຊ້ແອັບ João Browser ເພື່ອນຳເຄື່ອງມືການຊື້ເຄື່ອງທີ່ດີທີ່ສຸດໄປໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="2106116820042118250">ປອດໄພຍິ່ງຂຶ້ນໃນໂໝດເວລາເດີນທາງດ້ວຍ Safe Browsing ທີ່ປັບປຸງດີຂຶ້ນຢູ່ João Browser ສໍາລັບ iOS</translation>
<translation id="2210682093923538346">ເວັບໄຊທີ່ເປັນອັນຕະລາຍ. Chromium ໄດ້ລຶບສິດເຂົ້າເຖິງການແຈ້ງເຕືອນອອກແລ້ວ.</translation>
<translation id="2236949375853147973">ການເຄື່ອນໄຫວຂອງຂ້ອຍ</translation>
<translation id="118764235932893741">ເພື່ອຮັບທີ່ຢູ່ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser. ລະບົບຈະບັນທຶກທີ່ຢູ່ນີ້ໄວ້ໃນບັນຊີ Google ຂອງທ່ານຫຼັງຈາກທີ່ທ່ານເຂົ້າສູ່ລະບົບ.</translation>
<translation id="7254578863532089400">ຖ້າທ່ານແຊຣ໌ຄອມພິວເຕີ, ໝູ່​ເພື່ອນ ແລະຄອບຄົວຂອງທ່ານ ສາມາດທ່ອງເນັດໄດ້ແຍກຕ່າງຫາກ ແລະຕັ້ງ João Browser ໄດ້ຕາມ​ແບບທີ່ພວກເຂົາຕ້ອງການ.</translation>
<translation id="22571759390241347">ທັກສະໃນ Chromium</translation>
<translation id="2283803047247799269">ຊອກຫາແຖບນີ້ດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{João Browser ແນະນຳໃຫ້ຢຸດແຖບທີ່ເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານເຮັດວຽກຊ້າລົງຊົ່ວຄາວ}other{João Browser ແນະນຳໃຫ້ຢຸດແຖບທີ່ເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານເຮັດວຽກຊ້າລົງຊົ່ວຄາວ}}</translation>
<translation id="2307973900865360088">ເກັບໄວ້ໃນດັອກ</translation>
<translation id="2313870531055795960">ກວດສອບ URL ກັບລາຍຊື່ເວັບໄຊທີ່ບໍ່ປອດໄພທີ່ຈັດເກັບໄວ້ໃນ Chromium. ຖ້າມີເວັບໄຊໃດໜຶ່ງພະຍາຍາມລັກເອົາລະຫັດຜ່ານຂອງທ່ານ ຫຼື ເມື່ອທ່ານດາວໂຫຼດໄຟລ໌ອັນຕະລາຍ, Chromium ອາດສົ່ງ URL, ຮວມທັງເນື້ອຫາບາງສ່ວນຂອງໜ້າໄປໃຫ້ Safe Browsing.</translation>
<translation id="2356070529366658676">ຖາມ</translation>
<translation id="2359808026110333948">ສືບຕໍ່</translation>
<translation id="3800730051093461113">ສ່ວນຂະຫຍາຍ "<ph name="EXTENSION_NAME" />" ຕ້ອງການໃຫ້ທ່ານເຂົ້າສູ່ລະບົບ João Browser</translation>
<translation id="8758735062658446604">ປິດການນຳໃຊ້ João Browser ທີ່ເຮັດວຽກໃນພື້ນຫຼັງສຳລັບແອັບ</translation>
<translation id="2623595027619107207">ເພື່ອໃຊ້ສ່ວນຂະຫຍາຍນີ້ດ້ວຍ <ph name="USER_EMAIL_ADDRESS" />, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser.</translation>
<translation id="2384373936468275798">ChromiumOS ບໍ່ສາມາດຊິ້ງຂໍ້ມູນຂອງທ່ານໄດ້ເນື່ອງຈາກລາຍລະອຽດການເຂົ້າສູ່ລະບົບຂອງທ່ານເກົ່າແລ້ວ.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{ມີສ່ວນຂະຫຍາຍ João Browser ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ HID 1 ເຄື່ອງ}=1{ມີສ່ວນຂະຫຍາຍ João Browser ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ HID 1 ເຄື່ອງ}other{ມີສ່ວນຂະຫຍາຍ João Browser ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ HID # ເຄື່ອງ}}</translation>
<translation id="6254788431480237503">João Browser ຕ້ອງການການອະນຸຍາດກ້ອງຖ່າຍຮູບ ແລະ ໄມໂຄຣໂຟນສຳລັບເວັບໄຊນີ້</translation>
<translation id="2403703063067034158">ສະຕາດອັບຜິດພາດ: ຂະນະນີ້ມີການຕັ້ງຄ່າອື່ນກຳລັງເຮັດວຽກຢູ່, ກະລຸນາລອງໃໝ່ພາຍຫຼັງ.</translation>
<translation id="3028975423343897358">ເປີດລິ້ງໃນ João Browser ຈາກແອັບໃດກໍໄດ້ ແລະ ເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບເຂົ້າເຖິງໄດ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານ</translation>
<translation id="579079006139156831">ຄລິກປຸ່ມສະຫຼຸບເພື່ອແບ່ງປັນເອກະສານນີ້ກັບ Gemini ໃນ João Browser ເພື່ອເບິ່ງພາບຮວມໂດຍຫຍໍ້ ແລະ ຖາມຄຳຖາມຕິດຕາມຜົນ</translation>
<translation id="2440750600860946460">ດ້ວຍ <ph name="BEGIN_LINK" />ເຄື່ອງມືຈາກ Chromium<ph name="END_LINK" />, ທ່ານຈະສາມາດທ່ອງເວັບໄດ້ຢ່າງປອດໄພ ແລະ ຄວບຄຸມສິ່ງຕ່າງໆໄດ້</translation>
<translation id="7114471809991869757"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານໄດ້ນຳ.</translation>
<translation id="2451727308784734061">ໃຊ້ທາງລັດຂອງທ່ານເພື່ອເຂົ້າຫາຕົວຈັດການລະຫັດຜ່ານຢ່າງວ່ອງໄວ. ທ່ານສາມາດຍ້າຍທາງລັດຂອງທ່ານໄປຫາໜ້າຈໍຫຼັກຂອງຄອມພິວເຕີ ຫຼື ຕົວເປີດແອັບຂອງທ່ານໄດ້.</translation>
<translation id="2709136733469807397">João Browser ຈະປິດໃນໄວໆນີ້</translation>
<translation id="3652225684487279741">ໃນ João Browser</translation>
<translation id="2485422356828889247">ຖອນ​ຕິດ​ຕັ້ງ</translation>
<translation id="2513154137948333830">ຕ້ອງປິດເປີດໃໝ່: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">ເລືອກຂໍ້ຄວາມດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="1527474262707362156">João Browser ກຳລັງພະຍາຍາມປ່ຽນແທນລະຫັດຜ່ານທີ່ມີຢູ່. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານໃສ່ເພື່ອອະນຸຍາດສິ່ງນີ້.</translation>
<translation id="6480371226914552131">João Browser ຕ້ອງການເຂົ້າເຖິງບ່ອນເກັບຂໍ້ມູນເພື່ອດາວໂຫຼດໄຟລ໌</translation>
<translation id="6318568902186985084">ຜູ້​ຊ່ວຍ João Browser</translation>
<translation id="2575822587468774919">ເລືອກຫຍັງກໍໄດ້ເພື່ອຊອກຫາດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="4557210258834653476">ເພື່ອຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser</translation>
<translation id="1148164459654218834">ສະແກນລະຫັດ QR ດ້ວຍໂທລະສັບຂອງທ່ານເພື່ອດາວໂຫຼດ João Browser ແລະ ເຂົ້າສູ່ລະບົບບັນຊີ Google ຂອງທ່ານ.</translation>
<translation id="235892353478111963">ສືບຕໍ່ນຳໃຊ້ João Browser</translation>
<translation id="259935314519650377">ການແຄສຕົວຕິດຕັ້ງທີ່ດາວໂຫຼດໄວ້ບໍ່ສຳເລັດ. ຂໍ້ຜິດພາດ: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">ລະ​ບົບ</translation>
<translation id="8471946631262724853">ອົງກອນຂອງທ່ານສາມາດເບິ່ງ ແລະ ຈັດການຂໍ້ມູນການທ່ອງເວັບ ເຊັ່ນ: ບຸກມາກ, ປະຫວັດ ແລະ ລະຫັດຜ່ານຂອງທ່ານໄດ້. ແຕ່ຈະບໍ່ເຫັນຂໍ້ມູນການທ່ອງເວັບໃນໂປຣໄຟລ໌ João Browser ອື່ນໆ</translation>
<translation id="2870759219964376597">ຢັ້ງຢືນວ່າມັນແມ່ນທ່ານທີ່ຈະໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ João Browser ໃນບັນຊີຂອງທ່ານ, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="2955972712254986678">{COUNT,plural, =0{ການປົກປ້ອງຂັ້ນສູງກຳນົດໃຫ້ທ່ານຕ້ອງເລີ່ມເປີດໃຊ້ João Browser ໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ}=1{ການປົກປ້ອງຂັ້ນສູງກຳນົດໃຫ້ທ່ານຕ້ອງເລີ່ມເປີດໃຊ້ João Browser ໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ການປົກປ້ອງຂັ້ນສູງກຳນົດໃຫ້ທ່ານຕ້ອງເລີ່ມເປີດໃຊ້ João Browser ໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານ # ລາຍການຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="8949462882238006192">ເລີ່ມ João Browser</translation>
<translation id="4224214204752803768">ເກີດຄວາມຜິດພາດດ້ານລະບົບປະຕິບັດການໃນລະຫວ່າງການຕິດຕັ້ງ. ກະລຸນາດາວໂຫຼດ João Browser ອີກ.</translation>
<translation id="3141414135710372892">ຖ້າທ່ານໃຊ້ອຸປະກອນຮ່ວມກັນ, ໝູ່ ແລະ ຄອບຄົວສາມາດທ່ອງເວັບແຍກຕ່າງຫາກ ແລະ ຕັ້ງຄ່າ João Browser ໃນແບບທີ່ເຂົາເຈົ້າຕ້ອງການໄດ້</translation>
<translation id="8838607803339100223">ເຂົ້າເຖິງເພື່ອໃຊ້ Gemini ໃນ João Browser ໃນອຸປະກອນຕ່າງໆຂອງທ່ານໄດ້ຢ່າງງ່າຍດາຍ, ເຖິງແມ່ນວ່າຈະຫຍໍ້ João Browser ຢູ່.</translation>
<translation id="1679364578146271696">ແຖບ João Browser</translation>
<translation id="2718390899429598676">ເພື່ອຄວາມປອດໄພເພີ່ມເຕີມ, Chromium ຈະເຂົ້າລະຫັດຂໍ້ມູນຂອງທ່ານ.</translation>
<translation id="1874696651662237927">ເພື່ອລຶບບັນຊີ Google ຂອງທ່ານອອກຈາກ João Browser, ໃຫ້ອອກຈາກລະບົບ</translation>
<translation id="6850669719663104304">ເພື່ອເຂົ້າເຖິງລະຫັດຜ່ານ, ບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser</translation>
<translation id="2738871930057338499">ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບອິນເຕີເນັດໄດ້. HTTP 403 ຖືກຫ້າມ. ກະລຸນາກວດສອບການຕັ້ງຄ່າພຣັອກຊີຂອງທ່ານ.</translation>
<translation id="2753623023919742414">ຄລິກເພື່ອຊອກຫາ</translation>
<translation id="4193420110872590792">ຕັ້ງຄ່າ João Browser ເປັນໂປຣແກຣມອ່ານ PDF ເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="6614401181366354261">ສ່ວນຂະຫຍາຍນີ້ມີເມົາແວ ແລະ ບໍ່ປອດໄພ. ລຶບສ່ວນຂະຫຍາຍດັ່ງກ່າວອອກຈາກ João Browser ເພື່ອບໍ່ໃຫ້ເບິ່ງ ແລະ ປ່ຽນຂໍ້ມູນຂອງທ່ານຢູ່ເວັບໄຊທີ່ທ່ານເຂົ້າເບິ່ງ, ເຊິ່ງຮວມເຖິງຂໍ້ມູນສ່ວນຕົວຂອງທ່ານ.</translation>
<translation id="2799223571221894425">ເລີ່ມເປີດໃຊ້ໃໝ່</translation>
<translation id="6299858290790311689">João Browser ຂອງທ່ານ</translation>
<translation id="2816462166102338036">ຊອກຫາວິດີໂອນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="5896458971800337862">ຄົ້ນພົບຜະລິດຕະພັນດ້ວຍກ້ອງຂອງທ່ານ, ຕິດຕາມລາຄາທີ່ຫຼຸດລົງ ແລະ ອື່ນໆໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍ João Browser ຢູ່ iOS.</translation>
<translation id="2841525013647267359">ແປຈາກພາສາ</translation>
<translation id="2846251086934905009">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: ຕົວຕິດຕັ້ງເຮັດວຽກໄດ້ບໍ່ສົມບູນ. ຍົກເລີກການຕິດຕັ້ງແລ້ວ.</translation>
<translation id="4357241592510111611">ເອົາ​ອອກ​ຈາກ João Browser...</translation>
<translation id="2850691299438350830">ຮັກສາຄວາມປອດໄພຂອງທ່ານໃນ Chromium ແລະ ອາດຖືກໃຊ້ເພື່ອປັບປຸງຄວາມປອດໄພຂອງທ່ານໃນແອັບ Google ອື່ນໆເມື່ອທ່ານເຂົ້າສູ່ລະບົບ.</translation>
<translation id="2885378588091291677">ຕົວຈັດການໜ້າວຽກ</translation>
<translation id="8887040619780090085">ກ່ຽວ​ກັບ​ João Browser</translation>
<translation id="2915996080311180594">ຣິສະຕາດໃນພາຍຫຼັງ</translation>
<translation id="6619708652934279502">ຂໍ້ມູນຂອງທ່ານໄດ້ຖືກເຂົ້າລະຫັດໄວ້ດ້ວຍລະຫັດຜ່ານຂອງທ່ານ. ລະບຸລະຫັດຜ່ານເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ João Browser ໃນບັນຊີ Google ຂອງທ່ານ.</translation>
<translation id="2945997411976714835">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: ເລີ່ມຂັ້ນຕອນຂອງຕົວຕິດຕັ້ງບໍ່ສຳເລັດ.</translation>
<translation id="4566114009566397386">ເຂົ້າສູ່ລະບົບເວັບໄຊໄວຂຶ້ນໂດຍໃຊ້ລະຫັດຜ່ານທີ່ບັນທຶກໄວ້ສຳລັບ João Browser ຢູ່ iOS</translation>
<translation id="562175540137901632">ອົງການຂອງທ່ານຈັດການ João Browser</translation>
<translation id="2977470724722393594">Chromium ແມ່ນເວີຊັນໃໝ່ຫຼ້າສຸດແລ້ວ</translation>
<translation id="2977506796191543575">ຖ້າມີເວັບໄຊໃດໜຶ່ງພະຍາຍາມລັກເອົາລະຫັດຜ່ານຂອງທ່ານ ຫຼື ເມື່ອທ່ານດາວໂຫຼດໄຟລ໌ອັນຕະລາຍ, Chromium ອາດສົ່ງ URL, ຮວມທັງເນື້ອຫາບາງສ່ວນຂອງໜ້າໄປໃຫ້ Safe Browsing</translation>
<translation id="1776205510657237623">ເພື່ອທ່ອງໂລກອອນລາຍຢ່າງປອດໄພຍິ່ງຂຶ້ນດ້ວຍຕົວເລືອກຂອງຜູ້ປົກຄອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບໃນ João Browser</translation>
<translation id="3003694935412297923">ໜ້າວຽກທັງໝົດ</translation>
<translation id="3374694374267805392">{count,plural, =1{João Browser ຕ້ອງການຢັ້ງຢືນວ່າແມ່ນທ່ານແທ້ກ່ອນຈະສາມາດບັນທຶກຂໍ້ມູນບາງຢ່າງໃນບັນຊີ Google ຂອງທ່ານ ແລະ ໃຊ້ຢູ່ອຸປະກອນຂອງທ່ານທັງໝົດໄດ້. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ (1 ລາຍການ) ຈະຖືກລຶບ.}other{João Browser ຕ້ອງການຢັ້ງຢືນວ່າແມ່ນທ່ານແທ້ກ່ອນຈະສາມາດບັນທຶກຂໍ້ມູນບາງຢ່າງໃນບັນຊີ Google ຂອງທ່ານ ແລະ ໃຊ້ຢູ່ອຸປະກອນຂອງທ່ານທັງໝົດໄດ້. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ ({count} ລາຍການ) ຈະຖືກລຶບ.}}</translation>
<translation id="4915792193596835645">ເປີດ <ph name="URL" /> ໃນແຖບໃໝ່ໃນ João Browser.</translation>
<translation id="302551344979399011">ລະບົບຈະບັນທຶກນະວັດຕະກຳ AI ເຊັ່ນ: ທັກສະ ໄວ້ໃນບັນຊີ Google ຂອງທ່ານ ແລະ ຈັດການແຍກຕ່າງຫາກຈາກ Chromium Sync</translation>
<translation id="8367114375553489372">ກໍາລັງເພີ່ມ João Browser...</translation>
<translation id="3038232873781883849">ກຳ​ລັງ​ລໍ​ຖ້າ​ຕິດ​ຕັ້ງ...</translation>
<translation id="3045032126857188731">ພາສາທີ່ແປ: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">ປິດກ່ອງໂຕ້ຕອບຄຳຕິຊົມ</translation>
<translation id="6168172692486433600">ໂປຣໄຟລ໌ João Browser ອື່ນ</translation>
<translation id="884929993636327">ສ່ວນຂະຫຍາຍແມ່ນສ່ວນເສີມທີ່ຊ່ວຍໃຫ້ທ່ານປັບແຕ່ງ João Browser ໄດ້. ຕັ້ງແຕ່ການຈັດລະບຽບໄປຈົນຮອດການເຮັດໃຫ້ໜ້າວຽກປະຈຳວັນງ່າຍຂຶ້ນ, ສ່ວນຂະຫຍາຍຊ່ວຍໃຫ້ທ່ານປັບແຕ່ງ João Browser ໃຫ້ເປັນຂອງທ່ານເອງໄດ້.</translation>
<translation id="1525897524206034002">ຊ່ວຍເຮັດໃຫ້ João Browser ດີຂຶ້ນໂດຍການສົ່ງລາຍງານການ​ຂັດຂ້ອງ ແລະ  <ph name="UMA_LINK" />  ຫາ Google.</translation>
<translation id="2766971658743453990">ໃຊ້ແອັບ João Browser ເພື່ອນຳຄວາມປອດໄພຂອງ Google ໄປໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="4387884830246074210">{NUM_DEVICES,plural, =0{ມີສ່ວນຂະຫຍາຍ João Browser ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ USB 1 ເຄື່ອງ}=1{ມີສ່ວນຂະຫຍາຍ João Browser ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ USB 1 ເຄື່ອງ}other{ມີສ່ວນຂະຫຍາຍ João Browser ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ USB # ເຄື່ອງ}}</translation>
<translation id="3413144813287436446">ປະຫວັດ João Browser</translation>
<translation id="9192419056064225629">ຕົວຕິດຕັ້ງບໍ່ສາມາດ​ຄາຍ​ການບີບອັດຄັງເກັບມ້ຽນ. ກະລຸນາດາວໂຫຼດ João Browser ອີກ.</translation>
<translation id="310459126943037700">ເຮັດໃຫ້ໜ້າວຽກສິ້ນສຸດບໍ່ສຳເລັດ.</translation>
<translation id="3104828284009500087">ຊອກຫາສິ່ງຕ່າງໆຢູ່ໜ້າເວັບ</translation>
<translation id="3508468328135806512">ຊິ້ງລະຫັດຜ່ານ, ບຸກມາກ ແລະ ປະຫວັດຂອງທ່ານໃນອຸປະກອນຕ່າງໆໄດ້ຢ່າງສົມບູນແບບ. ເຂົ້າເຖິງຄຸນສົມບັດທີ່ທ່ານຮູ້ຈັກ ແລະ ມັກໄດ້ຢ່າງງ່າຍດາຍໂດຍອັບເດດໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານເປັນ João Browser.</translation>
<translation id="3216151988142306917">João Browser ກໍາລັງໃຊ້​ໄມໂຄຣໂຟນຂອງ​ທ່ານ​.</translation>
<translation id="3130333203120345554">ຊອກຫາໃໝ່</translation>
<translation id="3137969841538672700">ລາກເພື່ອຊອກຫາ</translation>
<translation id="7493177208577109722">ແຖບນີ້ກຳລັງໃຊ້ຊັບພະຍາກອນເພີ່ມເຕີມ. ເພື່ອປັບປຸງປະສິດທິພາບຂອງທ່ານ, ໃຫ້ João Browser ຊ່ວຍເຮັດໃຫ້ມັນບໍ່ເຮັດວຽກ.</translation>
<translation id="7239354789967255675">ເພື່ອແບ່ງປັນໜ້າຈໍຂອງທ່ານ, ໃຫ້ອະນຸຍາດການບັນທຶກໜ້າຈໍສຳລັບ João Browser ໃນການຕັ້ງຄ່າລະບົບ</translation>
<translation id="4955872590603594814">ປິດແລ້ວເປີດ João Browser ຄືນໃໝ່</translation>
<translation id="3161522574479303604">ທຸກ​ພາ​ສາ</translation>
<translation id="4697739132113629685">ເປີດລິ້ງໃນໜ້າຈໍທີ່ບໍ່ເຜີຍຕົວຕົນຂອງ João Browser</translation>
<translation id="1629247860984475766">ປັບແຕ່ງໂປຣໄຟລ໌ João Browser ໃໝ່ຂອງທ່ານ</translation>
<translation id="1905008150929775692">ທ່ານສາມາດສົນທະນາກັບໂໝດ AI ຕໍ່ໄປໄດ້ໂດຍບໍ່ຕ້ອງສະຫຼັບແຖບ. ເພື່ອເລີ່ມຕົ້ນ, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser. ນອກຈາກນີ້, ທ່ານຍັງຈະຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານໄດ້ນຳ.</translation>
<translation id="4232381420311815141">ເພື່ອລຶບບັນຊີ Google ຂອງທ່ານອອກຈາກ João Browser, ໃຫ້ອອກຈາກລະບົບ João Browser ໃນໜ້າການຕັ້ງຄ່າ</translation>
<translation id="3234316605225071811">ຕໍ່ມາ, Chromium ຈະສາມາດຖາມວ່າທ່ານຕ້ອງການໃຊ້ຂໍ້ມູນທີ່ບັນທຶກໄວ້ເພື່ອຕື່ມແບບຟອມໃຫ້ທ່ານຫຼືບໍ່</translation>
<translation id="6676749542734993844">João Browser ບໍ່ສາມາດອ່ານ ແລະຂຽນໄປໃສ່ໄດເຣັກຕໍຣີຂໍ້ມູນຂອງມັນໄດ້:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">ນຳເຄື່ອງມື Google AI ທີ່ທ່ານມັກໄປໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍ João Browser ຢູ່ iOS.</translation>
<translation id="3286538390144397061">ປິດເປີດໃໝ່ດຽວນີ້</translation>
<translation id="532528773927600103">ລະຫັດ Google API ຫາຍໄປ. ການເຮັດໜ້າທີ່ບາງອັນຂອງ João Browser ຈະປິດໃຊ້ງານ.</translation>
<translation id="3296368748942286671">ສືບຕໍ່ແລ່ນແອັບພື້ນຫຼັງ ເມື່ອ Chromium ປິດ</translation>
<translation id="3313189106987092621">Chromium ຈະເຕືອນທ່ານກ່ອນການໂຫຼດເວັບໄຊໃດກໍຕາມທີ່ກຳລັງໃຊ້ການເຊື່ອມຕໍ່ທີ່ບໍ່ປອດໄພ</translation>
<translation id="8095477191923518137">ທ່ານຈະອອກຈາກລະບົບຂອງເວັບໄຊສ່ວນໃຫຍ່ເມື່ອທ່ານປິດໜ້າຈໍ João Browser ທັງໝົດຍົກເວັ້ນບັນຊີ Google ຂອງທ່ານຫາກທ່ານເຂົ້າສູ່ລະບົບ João Browser. ເພື່ອໃຫ້ເວັບໄຊຈື່ທ່ານໄດ້, ກະລຸນາ <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">ມຸມຂວາເທິງຂອງພື້ນທີ່ຊອກຫາ: ຂວາ <ph name="RIGHT" />%, ເທິງ <ph name="TOP" />%</translation>
<translation id="3366305173356742781">ຂໍ້ມູນ Chromium ໃນບັນຊີຂອງທ່ານ</translation>
<translation id="3234882977104294240">ໃຊ້ລະຫັດຜ່ານຂອງທ່ານກັບ João Browser ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="2974199599420431595">ສະຫຼັບເປັນໂປຣໄຟລ໌ João Browser ທີ່ມີຢູ່ກ່ອນແລ້ວບໍ?</translation>
<translation id="3412460710772753638">ໃນຕົວຈັດການລະຫັດຜ່ານຢູ່ອຸປະກອນນີ້</translation>
<translation id="3438772217992559640">ຊອກຫາແຖບນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="8318147705317768982">ຂະຫຍາຍ Safe Browsing ທີ່ປັບປຸງດີຂຶ້ນດ້ວຍ João Browser ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="347392028839310978">ກຳລັງປັບແຕ່ງ João Browser ໃນແບບຂອງທ່ານ...</translation>
<translation id="3474745554856756813">ນີ້ຈະລຶບ <ph name="ITEMS_COUNT" /> ລາຍການອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຂອງທ່ານຄືນໃນພາຍຫຼັງ, ກະລຸນາເຂົ້າສູ່ລະບົບ Chromium ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="5805833167703404998"><ph name="SHORTCUT" /> ສາມາດສະຫຼັບລະຫວ່າງໂປຣໄຟລ໌ João Browser ໄດ້</translation>
<translation id="1835124883585653877">ກະລຸນາປິດທຸກໜ້າຕ່າງ João Browser ແລະລອງໃໝ່ອີກ.</translation>
<translation id="7106246566966568195">ເພື່ອແບ່ງປັນໜ້າຈໍຂອງທ່ານ, ໃຫ້ອະນຸຍາດການບັນທຶກໜ້າຈໍສຳລັບ João Browser ໃນການຕັ້ງຄ່າລະບົບ</translation>
<translation id="6017005873246021363"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ.  ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງໃນຖານະ <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="1146681170626381319">ລະຫັດ QR ເພື່ອດາວໂຫຼດໂປຣແກຣມທ່ອງເວັບ João Browser ຢູ່ອຸປະກອນມືຖື</translation>
<translation id="354621070532799440">ການແຈ້ງເຕືອນ: ຄຸນສົມບັດດ້ານຄວາມປອດໄພທີ່ດີທີ່ສຸດຂອງ Google ໃນກະເປົາຂອງທ່ານ</translation>
<translation id="2488701737291439763">ເພື່ອແບ່ງປັນໜ້າຈໍຂອງທ່ານ, ໃຫ້ອະນຸຍາດການບັນທຶກໜ້າຈໍສຳລັບ João Browser ໃນການຕັ້ງຄ່າລະບົບ.</translation>
<translation id="3588112919289558122">ການປົກປ້ອງທີ່ປັບປຸງດີຂຶ້ນຈະປິດການເພີ່ມປະສິດທິພາບ JavaScript ສຳລັບເວັບໄຊທີ່ Chromium ບໍ່ຮູ້ຈັກ</translation>
<translation id="3597003331831379823">ເອີ້ນໃຊ້ການຕັ້ງຄ່າດ້ວຍສິດທິພິເສດລະດັບສູງບໍ່ສຳເລັດ. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">ເຂົ້າສູ່ລະບົບ João Browser</translation>
<translation id="5985252758124395804">ຂໍ້ມູນການທ່ອງເວັບຂອງບຸກຄົນນີ້ຈະຖືກລຶບອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຄືນມາ, ກະລຸນາເຂົ້າສູ່ລະບົບ João Browser ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{ມີການອັບເດດໃໝ່ສຳລັບ João Browser ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່.}=1{ມີການອັບເດດໃໝ່ສຳລັບ João Browser ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ມີການອັບເດດໃໝ່ສຳລັບ João Browser ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານ # ລາຍການຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="3667616615096815454">ບໍ່ສາມາດຕິດຕັ້ງໄດ້, ເຊີບເວີບໍ່ຮູ້ຈັກແອັບພລິເຄຊັນ.</translation>
<translation id="3675854891107786059">ໃຊ້ <ph name="BEGIN_LINK" />ລະຫັດຜ່ານຂອງທ່ານເອງ<ph name="END_LINK" /> ໃນການເຂົ້າລະຫັດຂໍ້ມູນ Chromium ທັງໝົດໃນບັນຊີ Google ຂອງທ່ານ. ວິທີການຈ່າຍເງິນ ແລະ ທີ່ຢູ່ຈາກ Google Pay ຈະບໍ່ໄດ້ຖືກເຂົ້າລະຫັດໄວ້. ປະຫວັດການທ່ອງເວັບຈາກ Chromium ຈະບໍ່ຊິ້ງ.</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ João Browser ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້}=1{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ João Browser ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ João Browser ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານ # ລາຍການຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="4134769722455445399">ເປີດລິ້ງໃນແຖບ João Browser ໃໝ່</translation>
<translation id="3728124580182886854">ລິ້ງ Chromium ແລະ ບໍລິການອື່ນໆຂອງ Google ເພື່ອການປັບແຕ່ງເປັນແບບສ່ວນຕົວ ແລະ ຈຸດປະສົງອື່ນໆ</translation>
<translation id="3729187154190517324">ເຈາະເລິກການຊອກຫາຂອງທ່ານໂດຍການເພີ່ມແຖບ, ໄຟລ໌ ແລະ ເຄື່ອງມືຫຼາຍລາຍການໂດຍໃຊ້ປຸ່ມ "ເພີ່ມແຖບ ແລະ ອື່ນໆ".</translation>
<translation id="655691042235349825">ຈັດການໂປຣໄຟລ໌ João Browser</translation>
<translation id="8494798931804571569">ສຶກສາວ່າເປັນຫຍັງ João Browser ຈຶ່ງບລັອກການດາວໂຫຼດບາງລາຍການ</translation>
<translation id="379589255253486813">Chromium ຈະແຈ້ງໃຫ້ທ່ານຮູ້ຫາກມີສິ່ງໃດທີ່ທ່ານຕ້ອງກວດສອບ</translation>
<translation id="3802055581630249637">Chromium ໂຫຼດໜ້າເວັບທີ່ທ່ານອາດຈະເຂົ້າເບິ່ງໄວ້ກ່ອນລ່ວງໜ້າ, ເພື່ອໃຫ້ພວກມັນໂຫຼດໄວຂຶ້ນເມື່ອທ່ານເຂົ້າເບິ່ງ</translation>
<translation id="3810973564298564668">ຈັດການ</translation>
<translation id="6945066279282141856">ເພື່ອໃຊ້ລະຫັດຜ່ານທີ່ບັນທຶກໄວ້ຂອງທ່ານ, ໃຫ້ເຂົ້າໄປຕາມລະຫັດ QR, ດາວໂຫຼດ João Browser ສຳລັບ iOS ແລ້ວເຂົ້າສູ່ລະບົບບັນຊີ Google ຂອງທ່ານ</translation>
<translation id="3846683726093018685">**ສະຫຼຸບ:** ໃນປະໂຫຍກດຽວທີ່ມີບໍ່ເກີນ 30 ຄຳ, ໃຫ້ອະທິບາຍເລື່ອງຫຼັກ ແລະ ຈຸດປະສົງຂອງເນື້ອຫາໃນຮູບໜ້າຈໍ.

          **ແນະນຳຄຳຖາມ:** ສ້າງລາຍຊື່ສັນຍາລັກຂອງຄຳຖາມກະຕຸ້ນຄວາມຄິດ 3-5 ຂໍ້ທີ່ຜູ້ໃຊ້ອາດຖາມເພື່ອສ້າງຄວາມເຂົ້າໃຈຮູບໜ້າຈໍໄດ້ດີຍິ່ງຂຶ້ນ. ຄຳຖາມເຫຼົ່ານີ້ຄວນມີຢ່າງໜ້ອຍ 1 ຂໍ້ທີ່ກ່ຽວກັບວັດຖຸພາບ, ການອອກແບບ ຫຼື ຕຳແໜ່ງຂອງວັດຖຸນັ້ນໂດຍສະເພາະ.</translation>
<translation id="4996569675441627032"><ph name="PAGE_TITLE" /> - João Browser</translation>
<translation id="6008740052107737825">João Browser ຕ້ອງການການອະນຸຍາດເຂົ້າເຖິງເຄືອຂ່າຍພາຍໃນສຳລັບເວັບໄຊນີ້</translation>
<translation id="3885770153807205175">ຕົວເລືອກພາສາ</translation>
<translation id="2390004682597453662">ປັບແຕ່ງ ແລະ ຄວບຄຸມ João Browser. ມີບາງຢ່າງທີ່ທ່ານຕ້ອງດຳເນີນການ - ຄລິກສຳລັບລາຍລະອຽດ.</translation>
<translation id="8262407643678629134">ຄລິກ​ທີ່​ຊື່​ຂອງ​ທ່ານ​ເພື່ອ​ເປີດ João Browser ແລະ​ເລີ່ມ​ຕົ້ນທ່ອງເນັດ.</translation>
<translation id="3892148308691398805">ສຳເນົາຂໍ້ຄວາມ</translation>
<translation id="2168201717554927204"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບໂປຣໄຟລ໌ João Browser ນີ້ຢູ່ກ່ອນແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, João Browser ສາມາດສ້າງໂປຣໄຟລ໌ຂອງທ່ານເອງໃຫ້ທ່ານໄດ້.</translation>
<translation id="1046732460303790107">ສ່ວນຂະຫຍາຍນີ້ລະເມີດນະໂຍບາຍ Chrome Web Store ແລະ ອາດບໍ່ປອດໄພ. ລຶບສ່ວນຂະຫຍາຍດັ່ງກ່າວອອກຈາກ João Browser ເພື່ອບໍ່ໃຫ້ເບິ່ງ ແລະ ປ່ຽນຂໍ້ມູນຂອງທ່ານຢູ່ເວັບໄຊທີ່ທ່ານເຂົ້າເບິ່ງ, ເຊິ່ງຮວມເຖິງຂໍ້ມູນສ່ວນຕົວຂອງທ່ານ.</translation>
<translation id="3941890832296813527">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: ຊື່ໄຟລ໌ຂອງຕົວຕິດຕັ້ງບໍ່ຖືກຕ້ອງ ຫຼື ລະບົບບໍ່ຮອງຮັບ.</translation>
<translation id="3879366121647289622">João Browser ກໍາລັງພະຍາຍາມສຳເນົາລະຫັດຜ່ານ. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດໃຫ້ສຳເນົາໄດ້.</translation>
<translation id="7332365758981378072">ລະບົບຈະລຶບລະຫັດຜ່ານ, ວິທີການຈ່າຍເງິນ ແລະ ທີ່ຢູ່ທີ່ທ່ານບັນທຶກໄວ້ໃນບັນຊີ Google ຂອງທ່ານອອກຈາກອຸປະກອນນີ້. ເພື່ອໃຊ້ຂໍ້ມູນເຫຼົ່ານີ້ໃນ João Browser, ໃຫ້ເຂົ້າສູ່ລະບົບອີກຄັ້ງ.</translation>
<translation id="395904275706073188">ບໍ່ສາມາດອ່ານໜ້າທີ່ມີການປ້ອງກັນໄດ້. ລອງໃຊ້ໜ້າອື່ນ.</translation>
<translation id="3962647064319009959">ສຶກສາວິທີການທີ່ Chromium ຮັກສາຄວາມປອດໄພໃຫ້ທ່ານ</translation>
<translation id="3967822245660637423">ດາວ​ໂຫຼດ​ສຳ​ເລັດ</translation>
<translation id="3971865010372729242">ເມື່ອທ່ານພິມໃນແຖບທີ່ຢູ່ ຫຼື ກ່ອງຊອກຫາ, Chromium ຈະສົ່ງສິ່ງທີ່ທ່ານພິມໄປຫາເຄື່ອງມືຊອກຫາ, AI ແລະ ເຄື່ອງມືຕົວແທນຂອງອົງກອນຂອງທ່ານເພື່ອຮັບຄຳແນະນຳ.</translation>
<translation id="3975724895399328945">ກ່ຽວກັບ Google Chrome ສຳລັບການທົດສອບ</translation>
<translation id="3997429360543082038">ກ່ຽວກັບ ChromiumOS</translation>
<translation id="4010059961270896984">ເມື່ອທ່ານເຂົ້າເບິ່ງເວັບໄຊ, Chromium ຈະເອົາສະເພາະບາງສ່ວນຂອງ URL ມາສ້າງຄວາມສັບສົນແລ້ວສົ່ງໄປໃຫ້ <ph name="BEGIN_LINK" />Google Safe Browsing<ph name="END_LINK" /> ຜ່ານເຊີບເວີຄວາມເປັນສ່ວນຕົວທີ່ເຊື່ອງທີ່ຢູ່ IP ຂອງທ່ານ. ຫາກເວັບໄຊເຮັດສິ່ງທີ່ໜ້າສົງໄສ, ລະບົບຈະສົ່ງ URL ແບບເຕັມ ແລະ ເນື້ອຫາຂອງໜ້າເວັບບາງສ່ວນນຳ.</translation>
<translation id="4016217212818346953">ປອດໄພຢູ່ສະເໝີດ້ວຍຕົວຈັດການລະຫັດຜ່ານ</translation>
<translation id="4019629340646866719">ChromiumOS ເກີດຂຶ້ນໄດ້ດ້ວຍ <ph name="BEGIN_LINK_CROS_OSS" />ຊອບແວໂອເພນຊອດ<ph name="END_LINK_CROS_OSS" /> ເພີ່ມເຕີມ, ຮວມທັງ <ph name="BEGIN_LINK_LINUX_OSS" />ສະພາບແວດລ້ອມການພັດທະນາ Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">ແປໜ້າຈໍ</translation>
<translation id="4023601594785368013">ພາສາຕົ້ນສະບັບ: <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">ເປີດລິ້ງໃນ João Browser ຈາກແອັບໃດກໍໄດ້. ພ້ອມທັງເພື່ອເຂົ້າເຖິງໄດ້ງ່າຍ, ມັນຈະຖືກປັກໝຸດໃສ່ແຖບໜ້າວຽກຂອງທ່ານ.</translation>
<translation id="4036079820698952681">ຊ່ວຍເຮັດໃຫ້ Chromium ດີຂຶ້ນໂດຍການລາຍງານ <ph name="BEGIN_LINK" />ການຕັ້ງຄ່າປັດຈຸບັນ<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">ການ​ປັບ​ປຸງ​ຄວາມ​ປອດ​ໄພ​ທີ່​ສຳ​ຄັນ ແລະ​ຄຸນ​ສົມ​ບັດ​ໃໝ່​ມີ​ໃຫ້​ຢູ່​ໃນ​ເວີ​ຊັນ​ຫຼ້າ​ສຸດ.</translation>
<translation id="4055805654398742145">ຕົວຈັດການລະຫັດຜ່ານ</translation>
<translation id="615818333141511791">{COUNT,plural, =1{ອົງກອນຂອງທ່ານຈະປິດ João Browser ໂດຍອັດຕະໂນມັດເມື່ອບໍ່ມີການນຳໃຊ້ເປັນເວລາ 1 ນາທີ. ລຶບຂໍ້ມູນການທ່ອງເວັບອອກແລ້ວ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ.}other{ອົງກອນຂອງທ່ານຈະປິດ João Browser ໂດຍອັດຕະໂນມັດເມື່ອບໍ່ມີການນຳໃຊ້ເປັນເວລາ # ນາທີ. ລຶບຂໍ້ມູນການທ່ອງເວັບອອກແລ້ວ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ.}}</translation>
<translation id="4118474109249235144">ໂໝດບໍ່ເປີດເຜີຍຕົວຕົນໃນ Chromium</translation>
<translation id="4122186850977583290">ເຂົ້າໄປໜ້າກ່ຽວກັບ Chromium</translation>
<translation id="9207280419664362385">ປັບແຕ່ງ João Browser ເພື່ອສ້າງຮູບລັກໃໝ່ໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານ</translation>
<translation id="3719803995198923598">ປັບແຕ່ງ João Browser ຂອງທ່ານ</translation>
<translation id="4148957013307229264">ກໍາລັງ​ຕິດ​ຕັ້ງ...</translation>
<translation id="2954462321765112214"><ph name="PAGE_TITLE" /> - ການເຂົ້າສູ່ລະບົບເຄືອຂ່າຍ - João Browser</translation>
<translation id="7812363663832111420">ຄົ້ນພົບແອັບ, ເກມ, ສ່ວນຂະຫຍາຍ ແລະ ຮູບແບບສີສັນສຳລັບ João Browser.</translation>
<translation id="69200600645763018">ເພື່ອຮັບສ່ວນຂະຫຍາຍນີ້ ແລະ ອື່ນໆຢູ່ຄອມພິວເຕີທັງໝົດຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser</translation>
<translation id="7505863944027312744">ເພື່ອທ່ອງໂລກອອນລາຍຢ່າງປອດໄພຍິ່ງຂຶ້ນດ້ວຍຕົວເລືອກຂອງຜູ້ປົກຄອງຂອງທ່ານ, ໃຫ້ປ່ຽນໄປໃຊ້ໂປຣໄຟລ໌ João Browser ຂອງທ່ານທີ່ເຂົ້າສູ່ລະບົບໃນຖານະ <ph name="USER_EMAIL_ADDRESS" /> ຢູ່ກ່ອນແລ້ວ</translation>
<translation id="4222932583846282852">ກຳລັງຍົກເລີກ...</translation>
<translation id="4224210481850767180">ການຕິດຕັ້ງຖືກຍົກເລີກ.</translation>
<translation id="8090594705972340646">ລິ້ງ João Browser ຂອງ​ທ່ານກັບບັນຊີນີ້ບໍ?</translation>
<translation id="4251772536351901305">ເຕືອນທ່ານກ່ຽວກັບເວັບໄຊທີ່ເປັນອັນຕະລາຍ, ແມ່ນແຕ່ເວັບໄຊທີ່ Google ບໍ່ຮູ້ຈັກມາກ່ອນ, ໂດຍການວິເຄາະຂໍ້ມູນຈາກເວັບໄຊຫຼາຍກວ່າການປົກປ້ອງມາດຕະຖານ. ທ່ານສາມາດເລືອກທີ່ຈະຂ້າມຄຳເຕືອນຂອງ Chromium ໄດ້.</translation>
<translation id="5696119579094527589">ອອກຈາກລະບົບ João Browser</translation>
<translation id="4271805377592243930">ຂໍຄວາມຊ່ວຍເຫຼືອເລື່ອງ Chromium</translation>
<translation id="4281844954008187215">ຂໍ້ກໍານົດການບໍລິການ</translation>
<translation id="1245307320228150348">ການ​ຕິດ​ຕັ້ງ​ບໍ່​ສໍາ​ເລັດ​ອັນ ​ເນື່ອງ​ມາ​ຈາກ​ຄວາມ​ຜິດພາດທີ່ບໍ່ລະບຸໄວ້​. ຖ້າ João Browser ກໍາລັງແລ່ນຢູ່ໃນປະຈຸບັນ​, ກະ​ລຸ​ນາ​ປິດ​ມັນ ​ແລະ​ລອງໃໝ່​ອີກ​.</translation>
<translation id="7405356088321579627">ສົ່ງອອກລະຫັດຜ່ານຈາກ João Browser</translation>
<translation id="4304713468139749426">ຕົວຈັດການລະຫັດຜ່ານ</translation>
<translation id="4334241893986177674">ຊອກຫາຮູບໜ້າຈໍນີ້</translation>
<translation id="212570256141568951">ເປີດໃຊ້ João Browser ເມື່ອ Windows ເລີ່ມເຮັດວຽກ</translation>
<translation id="4400772909124543403">ບໍ່ມີອັບເດດພ້ອມນຳໃຊ້</translation>
<translation id="7463042547966071103">ຢືນຢັນການອອກຈາກ João Browser ບໍ?</translation>
<translation id="4413205837991854510">ສະແດງທາງລັດການຊອກຫາຮູບສະເໝີ</translation>
<translation id="4736206301215400753">ໃຫ້ João Browser ເປີດໃຊ້ຢູ່ໃນພື້ນຫຼັງ</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{João Browser ແນະນຳໃຫ້ທ່ານລຶບອອກ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບສ່ວນຂະຫຍາຍທີ່ຮອງຮັບ<ph name="END_LINK" />}other{João Browser ແນະນຳໃຫ້ທ່ານລຶບອອກ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບສ່ວນຂະຫຍາຍທີ່ຮອງຮັບ<ph name="END_LINK" />}}</translation>
<translation id="5305058100936019600">ກໍານົດໃຊ້ ແລະ​ຄວບ​ຄຸມ João Browser</translation>
<translation id="4427306783828095590">ການປົກປ້ອງທີ່ປັບປຸງດີຂຶ້ນເຮັດໄດ້ຫຼາຍກວ່າໃນການບລັອກການຫຼອກເອົາຂໍ້ມູນ ແລະ ເມົາແວ</translation>
<translation id="4434353761996769206">ຕົວຕິດຕັ້ງຜິດພາດ: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3461955321878243607"><ph name="MANAGER" /> ຈັດການ João Browser</translation>
<translation id="3379477508903866078">ເພີ່ມໂປຣໄຟລ໌ João Browser</translation>
<translation id="4447409407328223819">ກ່ຽວກັບ Chrome ສຳລັບການທົດສອບ</translation>
<translation id="4074057296993529937">ເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ João Browser ໃນບັນຊີ Google ຂອງທ່ານ, ກະລຸນາລະບຸລະຫັດຜ່ານຂອງທ່ານ</translation>
<translation id="4493028449971051158">ຂໍ້ຜິດພາດໃນການເລີ່ມຕົ້ນ: ກະລຸນາເອີ້ນໃຊ້ຕົວຕິດຕັ້ງໃນຖານະຜູ້ເບິ່ງແຍງລະບົບ.</translation>
<translation id="4501471624619070934">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກສິດເຂົ້າເຖິງຖືກຈຳກັດໃນປະເທດນີ້.</translation>
<translation id="8624811527667906941">ສ່ວນຂະຫຍາຍນີ້ບໍ່ໄດ້ເຜີຍແຜ່ຂໍ້ປະຕິບັດຄວາມເປັນສ່ວນຕົວ, ເຊັ່ນ: ວິທີທີ່ມັນຮວບຮວມ ແລະ ໃຊ້ຂໍ້ມູນ. João Browser ແນະນຳໃຫ້ທ່ານລຶບອອກ.</translation>
<translation id="5571435860030744559">ຍິນດີຕ້ອນຮັບສູ່ João Browser; ເປີດໜ້າຈໍໂປຣແກຣມທ່ອງເວັບໃໝ່ແລ້ວ</translation>
<translation id="8132016625974854930">João Browser ຕ້ອງໄດ້ຮັບການອະນຸຍາດເພື່ອສ້າງແຜນທີ່ພື້ນທີ່ອ້ອມຂ້າງຂອງທ່ານ ແລະ ຕິດຕາມການເຄື່ອນໄຫວຂອງມືທ່ານ</translation>
<translation id="6599071882590417739">ທ່ານເຂົ້າສູ່ລະບົບດ້ວຍ <ph name="USER_EMAIL_ADDRESS" /> ໃນໂປຣໄຟລ໌ João Browser ອື່ນຢູ່ກ່ອນແລ້ວ</translation>
<translation id="4548534452171747496">Chromium ຈະໂຫຼດໜ້າເວັບກ່ອນລ່ວງໜ້າເຊິ່ງເຮັດໃຫ້ເລືອກເບິ່ງ ແລະ ຊອກຫາໄດ້ໄວຂຶ້ນ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບໜ້າໂຫຼດກ່ອນລ່ວງໜ້າ<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">ປັບປຸງຄວາມປອດໄພຢູ່ໂລກອອນລາຍໃຫ້ດີຍິ່ງຂຶ້ນສຳລັບທຸກຄົນເມື່ອທ່ານລາຍງານເວັບໄຊທີ່ທ່ານຄິດວ່າເປັນອັນຕະລາຍ.</translation>
<translation id="202208802191333704">João Browser ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກທ່ານປິດ Safe Browsing ແລະ ເຮັດໃຫ້ບໍ່ສາມາດຢັ້ງຢືນໄຟລ໌ໄດ້</translation>
<translation id="3128308674776200516">ລອງໃຊ້ Google Lens ກັບ João Browser ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="4594305310729380060">ຫາຕົວຈັດການລະຫັດຜ່ານຢູ່ອຸປະກອນນີ້</translation>
<translation id="7653380076752216509">ແອັບ João Browser</translation>
<translation id="4598116752460667024">ຊອກຫາຂະບວນການໃດໆຈາກລາຍຊື່.</translation>
<translation id="4613863813562375431">ເວີຊັນ ChromiumOS</translation>
<translation id="4621240073146040695">ອັບເດດໃກ້ແລ້ວໆ! ກະລຸນາປິດແລ້ວເປີດ Chromium ຄືນໃໝ່ເພື່ອສິ້ນສຸດຂັ້ນຕອນການອັບເດດ.</translation>
<translation id="1497446027991908251">ເພີ່ມຄວາມໄວເວັບໄຊດ້ວຍເຄື່ອງຈັກ V8 ຂອງ João Browser ແຕ່ເຮັດໃຫ້ João Browser ມີຄວາມທົນທານຕໍ່ການໂຈມຕີໜ້ອຍລົງເລັກນ້ອຍ</translation>
<translation id="7523749920868634278">ຄຳເຕືອນ: João Browser ບໍ່ສາມາດປ້ອງກັນສ່ວນຂະຫຍາຍບໍ່ໃຫ້ບັນທຶກປະຫວັດການທ່ອງເວັບຂອງທ່ານໄດ້. ເພື່ອປິດການນຳໃຊ້ສ່ວນຂະຫຍາຍນີ້ໃນໂໝດທີ່ບໍ່ເປີດເຜີຍຕົວຕົນ, ກະລຸນາບໍ່ເລືອກຕົວເລືອກນີ້.</translation>
<translation id="4673151026126227699">ຫາກທ່ານແບ່ງປັນລາຍງານການນຳໃຊ້ Chromium ນຳ, ລາຍງານເຫຼົ່ານັ້ນຈະຮວມເອົາ URL ທີ່ທ່ານເຂົ້າເບິ່ງໄວ້ພ້ອມ</translation>
<translation id="4673710618874938871">ເຂົ້າສູ່ລະບົບໃນຊື່ <ph name="USER_NAME" />, ສະມາຊິກ. ເປີດເມນູບັນຊີ</translation>
<translation id="6608258642372806522">ປະກົດວ່າໂປຣໄຟລ໌ໃຊ້ງານຢູ່ໂດຍຂະບວນການ João Browser ອື່ນ (<ph name="PROCESS_ID" />) ຢູ່ໃນຄອມພິວເຕີອື່ນ (<ph name="HOST_NAME" />). João Browser ໄດ້ລັອກໂປຣໄຟລ໌ໄວ້ ເພື່ອບໍ່ໃຫ້ມັນໄດ້ຮັບການ​ຂັດຂ້ອງ. ຖ້າທ່ານແນ່ໃຈວ່າ ບໍ່ມີຂະບວນການອື່ນໃຊ້ໂປຣໄຟລ໌ນີ້ຢູ່, ທ່ານສາມາດປົດລັອກໂປຣໄຟລ໌ ແລະເລີ່ມເປີດໃຊ້ João Browser ໃໝ່ໄດ້.</translation>
<translation id="4680828127924988555">ຍົກເລີກການຕິດຕັ້ງ</translation>
<translation id="3912572071294857936">ຂໍ້ມູນ João Browser ບາງສ່ວນຂອງທ່ານຍັງບໍ່ໄດ້ຖືກບັນທຶກໄປໃສ່ໃນບັນຊີ Google ຂອງທ່ານເທື່ອ. ກະລຸນາລໍຖ້າສອງສາມນາທີກ່ອນອອກຈາກລະບົບ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ຈະຖືກລຶບ.</translation>
<translation id="1077152188344040592">ໃນລະຫວ່າງທີ່ທ່ານເຂົ້າສູ່ລະບົບ, ທ່ານສາມາດໃຊ້ລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກບັນຊີ Google ຂອງທ່ານໃນ João Browser ໄດ້. ໂດຍສາມາດໃຊ້ <ph name="SHORTCUT" /> ເພື່ອປ່ຽນການຕັ້ງຄ່າບໍລິການ Google ຂອງທ່ານໄດ້.</translation>
<translation id="5729536702149847030">ຄົນອື່ນເຄີຍເຂົ້າສູ່ລະບົບ João Browser ໃນຄອມພິວເຕີນີ້ເປັນ <ph name="ACCOUNT_EMAIL_LAST" /> ມາກ່ອນແລ້ວ. ກະລຸນາສ້າງຜູ້ໃຊ້ João Browser ໃໝ່ເພື່ອເກັບຂໍ້ມູນຂອງທ່ານໃຫ້ແຍກກັນຕ່າງຫາກ.</translation>
<translation id="4724676981607797757">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກຂໍ້ຜິດພາດໂປຣຕໍຄໍທີ່ບໍ່ຮອງຮັບ.</translation>
<translation id="6273241729694500032">ຢືນຢັນການອອກຈາກ João Browser ບໍ?</translation>
<translation id="3239680024825449390">ຫາກໍນຳໃຊ້ການອັບເດດຄວາມປອດໄພພິເສດສຳລັບ João Browser ແລ້ວ. ກະລຸນາປິດເປີດໃໝ່ຕອນນີ້ເລີຍ ແລ້ວພວກເຮົາຈະກູ້ຄືນແຖບຂອງທ່ານ.</translation>
<translation id="4771701986670315895">ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. Chromium ໄດ້ລຶບ <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> ແລະ ອີກ <ph name="COUNT" /> ລາຍການອອກແລ້ວ.</translation>
<translation id="1908292729364083164">ຫາກ Gemini ໃນ João Browser ເປີດຢູ່, ແຜງຄວບຄຸມດ້ານຂ້າງຈະເປີດຢູ່ເມື່ອສ້າງແຖບໃໝ່</translation>
<translation id="479167709087336770">ນີ້ໃຊ້ຕົວກວດການສະກົດຄໍາດຽວກັນກັບທີ່ໃຊ້ໃນ Google ຊອກຫາ. ຂໍ້ຄວາມທີ່ທ່ານພິມໃນໂປຣແກຣມທ່ອງເວັບຖືກສົ່ງໃຫ້ Google. ທ່ານສາມາດປ່ຽນລັກສະນະການນໍາໃຊ້ນີ້ໄດ້ສະເໝີໃນການຕັ້ງຄ່າ.</translation>
<translation id="189382710647501724">ໃຊ້ João Browser ໂດຍບໍ່ມີບັນຊີ</translation>
<translation id="4456919965836032212">ກົດລະບຽບຂາເຂົ້າສໍາລັບ João Browser ເພື່ອອະນຸຍາດການຈາລະຈອນ mDNS.</translation>
<translation id="3486986778673504636">ເລີ່ມເປີດໃຊ້ໃໝ່ເພື່ອອັບເດດ &amp;João Browser</translation>
<translation id="4918086044614829423">ຍອມ​ຮັບ</translation>
<translation id="4918844574251943176">ສຳເນົາຮູບແລ້ວ</translation>
<translation id="1571932028747131277">João Browser ຢູ່ໃນໂໝດພື້ນຫຼັງ.</translation>
<translation id="7612124006067933008">ຄລິກເພື່ອປິດກ່ອງໂຕ້ຕອບການເຂົ້າສູ່ລະບົບ João Browser</translation>
<translation id="2598788273876744576">ໂປຣໄຟລ໌ João Browser ຊ່ວຍໃຫ້ທ່ານສາມາດແຍກຂໍ້ມູນທັງໝົດໃນ João Browser ຂອງທ່ານອອກຈາກກັນໄດ້. ສ້າງໂປຣໄຟລ໌ສຳລັບໝູ່ ແລະ ຄອບຄົວ, ຫຼື ແຍກການເຮັດວຽກອອກຈາກຄວາມບັນເທີງ.</translation>
<translation id="2115498792600385171">ແຂກສາມາດໃຊ້ João Browser ໂດຍ​ບໍ່​ມີ​ການປະອັນໃດໄວ້ເບື້ອງຫຼັງ.</translation>
<translation id="6870732303439257966">ບັນຊີຂອງທ່ານໃນ João Browser</translation>
<translation id="4366792189726044065">ເພີ່ມທ່ານເອງໃສ່ João Browser</translation>
<translation id="504699503110800016">ເປີດເມນູລົ້ນ</translation>
<translation id="4340125167559705618">ເຂົ້າເຖິງ Google ທີ່ທ່ານມັກທັງໝົດດ້ວຍ João Browser ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="4916697359431064123">João Browser ຕ້ອງໄດ້ຮັບການອະນຸຍາດເພື່ອຕິດຕາມການເຄື່ອນໄຫວຂອງມືທ່ານ</translation>
<translation id="5141988424377517949">ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. Chromium ໄດ້ລຶບ <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" /> ອອກແລ້ວ.</translation>
<translation id="5174969993834422967">ໂດຍປົກກະຕິແລ້ວທ່ານບລັອກການແຈ້ງເຕືອນ. ເພື່ອໃຫ້ເວັບໄຊນີ້ແຈ້ງເຕືອນທ່ານ, ໃຫ້ຄລິກທີ່ໄອຄອນການແຈ້ງເຕືອນຢູ່ມຸມຂວາຂອງແຖບສະຖານທີ່ຂອງທ່ານ.</translation>
<translation id="5174983315706567306">ພື້ນທີ່ດິສກ໌ບໍ່ພຽງພໍ.</translation>
<translation id="961070648267203077">ບັນຊີ João Browser ຕ້ອງມີການພິສູດຢືນຢັນຄືນໃໝ່</translation>
<translation id="69363826605946518">ດຳເນີນການຕໍ່ຈາກຈຸດທີ່ທ່ານຄ້າງໄວ້ດ້ວຍ João Browser ຢູ່ iOS.</translation>
<translation id="471694954923709047">ອອກຈາກລະບົບ João Browser</translation>
<translation id="5234764350956374838">ປ່ອຍໄປ</translation>
<translation id="5782956358171235578">ເປີດລິ້ງໃນໜ້າຈໍທີ່ບໍ່ເຜີຍຕົວຕົນຂອງ João Browser</translation>
<translation id="903712329052383264">ດາວໂຫຼດແອັບ João Browser ເພື່ອບັນທຶກລະຫັດຜ່ານໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="5277894862589591112">ເພື່ອນຳໃຊ້ການປ່ຽນແປງຂອງທ່ານ, ກະລຸນາເປີດ Chromium ຄືນໃໝ່</translation>
<translation id="5286907366254680517">ກວດພົບ</translation>
<translation id="5593827909938092728">ດາວໂຫຼດແອັບ João Browser</translation>
<translation id="5294316920224716406">ເມື່ອທ່ອງເວັບໃນໂໝດບໍ່ເປີດເຜີຍຕົວຕົນ, Chromium ຈະເຕືອນທ່ານກ່ອນການໂຫຼດເວັບໄຊທີ່ກຳລັງໃຊ້ການເຊື່ອມຕໍ່ທີ່ບໍ່ປອດໄພ</translation>
<translation id="1066981078513393795">ບໍລິການພາຍໃນຂອງ João Browser Updater</translation>
<translation id="5324450571874973775">ໃຊ້ພ້ອມກັບຄຸນສົມບັດອື່ນໆຂອງ Gemini ໃນ Chromium</translation>
<translation id="5346389065299425353">ເຈາະເລິກການຊອກຫາຂອງທ່ານໂດຍການເພີ່ມແຖບ, ໄຟລ໌ ແລະ ເຄື່ອງມືຫຼາຍລາຍການ</translation>
<translation id="1884203704972162365">ຮັບພາບຮວມໂດຍຫຍໍ້ຂອງເອກະສານນີ້ ແລະ ຖາມຄຳຖາມດ້ວຍ Gemini ໃນ João Browser</translation>
<translation id="5352264705793813212">Chromium ພົບຄຳແນະນຳດ້ານຄວາມປອດໄພບາງຢ່າງທີ່ທ່ານຕ້ອງກວດສອບ</translation>
<translation id="4819697639570429319">ໂປຣໄຟລ໌ João Browser ອື່ນ</translation>
<translation id="7878591304929138776">ChromiumOS ບໍ່ສາມາດບັນທຶກຂໍ້ມູນ João Browser ໃນບັນຊີ Google ຂອງທ່ານໄດ້ເນື່ອງຈາກລາຍລະອຽດການເຂົ້າສູ່ລະບົບບັນຊີຂອງທ່ານເກົ່າແລ້ວ</translation>
<translation id="5249614051186670898">ທ່ານກໍາລັງລົງຊື່ເຂົ້າ​ໃຊ້ດ້ວຍບັນຊີຄຸ້ມຄອງ ແລະໃຫ້ຜູ້ຄວບຄຸມຂອງມັນຄວບຄຸມໂປຣໄຟລ໌ João Browser ຂອງທ່ານ. ຂໍ້ມູນ João Browser ຂອງທ່ານ, ເຊັ່ນ: ແອັບ, ບຸກມາກສ໌, ປະຫວັດ, ລະຫັດຜ່ານ, ແລະການຕັ້ງຄ່າອື່ນໆຂອງທ່ານຈະຖືກຜູກ​ມັດ​ກັບ <ph name="USER_NAME" /> ຢ່າງຖາວອນ. ທ່ານຈະສາມາດລຶບຂໍ້ມູນນີ້ໄດ້ຜ່ານ Google Accounts Dashboard, ແຕ່ທ່ານຈະບໍ່ສາມາດເອົາຂໍ້ມູນນີ້ເຂົ້າຮ່ວມກັບບັນຊີອື່ນໄດ້. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">ລະຫັດເພີ່ມເຕີມ: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">ເພື່ອຮັບການປັບແຕ່ງເປັນແບບສ່ວນຕົວ, ໃຫ້ຮວມ Chromium ໄວ້ໃນການເຄື່ອນໄຫວເວັບ ແລະ ແອັບ</translation>
<translation id="108952623091824942">ສຶກສາວ່າເປັນຫຍັງ João Browser ຈຶ່ງບລັອກໄຟລ໌ບາງລາຍການ</translation>
<translation id="5386450000063123300">ກຳລັງອັບເດດ Chromium (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">ອະນຸຍາດການເຂົ້າສູ່ລະບົບ Chromium</translation>
<translation id="1265086181910844216">ເອົາ​ອອກ​ຈາກ João Browser</translation>
<translation id="1500700851187484222">ຫຼຸດປະສິດທິພາບ ແຕ່ເຮັດໃຫ້ João Browser ທົນທານຕໍ່ການໂຈມຕີໄດ້ຫຼາຍຂຶ້ນ</translation>
<translation id="6665657403278704382">ຕັ້ງ João Browser ເປັນບຣາວ​ເຊີມາດຕະຖານຂອງທ່ານ</translation>
<translation id="3520901681432894293"><ph name="PAGE_TITLE" /> - João Browser Beta</translation>
<translation id="5994273394215159270">{NUM_TABS,plural, =1{João Browser ແນະນຳໃຫ້ຢຸດແຖບທີ່ເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານເຮັດວຽກຊ້າລົງຊົ່ວຄາວ}other{João Browser ແນະນຳໃຫ້ຢຸດແຖບທີ່ເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານເຮັດວຽກຊ້າລົງຊົ່ວຄາວ}}</translation>
<translation id="646791423998269453">João Browser ອາດເຮັດວຽກໄດ້ບໍ່ຖືກຕ້ອງເນື່ອງຈາກ Linux distribution ນີ້ບໍ່ຮອງຮັບມັນອີກຕໍ່ໄປແລ້ວ.</translation>
<translation id="7249139852479053716">João Browser ບລັອກການດາວໂຫຼດນີ້ເພາະວ່າໄຟລ໌ສາມາດເປັນອັນຕະລາຍຕໍ່ບັນຊີສ່ວນຕົວ ແລະ ບັນຊີເຄືອຂ່າຍສັງຄົມຂອງທ່ານໄດ້</translation>
<translation id="478612683981218420">ກະ​ລຸ​ນາ​ລໍ​ຖ້າ​ໃນ​ຂະ​ນະ​ທີ່ João Browser ​ຕິດ​ຕັ້ງ​ການອັບເດດລະບົບຫລ້າ​ສຸດ.</translation>
<translation id="3466187211963597724">João Browser ກໍາລັງພະຍາຍາມແກ້ໄຂລະຫັດຜ່ານ. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດໃຫ້ສຳເນົາໄດ້.</translation>
<translation id="3133978491361824131">ເຮັດວຽກຮ່ວມກັບແອັບທີ່ທ່ານມັກ ເຊັ່ນ: Google Drive ແລະ YouTube ໄດ້ຢ່າງລ່ຽນໄຫຼທຸກບ່ອນທຸກເວລາດ້ວຍ João Browser.</translation>
<translation id="5524890928877629608">ມຸມຊ້າຍເທິງຂອງພື້ນທີ່ຊອກຫາ: ຊ້າຍ <ph name="LEFT" />%, ເທິງ <ph name="TOP" />%</translation>
<translation id="5527463683072221100">ເປີດ PDF ໃນ Chromium</translation>
<translation id="5536164441519929134">ຖາມ<ph name="LINE_BREAK" />ກ່ຽວກັບແຖບນີ້</translation>
<translation id="3902123582863904748">ເພື່ອຄວາມປອດໄພ, João Browser ຈະປິດການເພີ່ມປະສິດທິພາບ JavaScript ເມື່ອທ່ານເຂົ້າເບິ່ງເວັບໄຊເປັນເທື່ອທຳອິດ.

ຫາກໜ້ານີ້ບໍ່ເຮັດວຽກຕາມທີ່ຄາດໄວ້, ໃຫ້ລອງອະນຸຍາດການເພີ່ມປະສິດທິພາບ.</translation>
<translation id="5924481826213021755">ສະແດງ Gemini ໃນ João Browser ໃນແຖບເມນູຂອງ Mac ແລະ ເປີດຄີລັດ</translation>
<translation id="4988760628116707723"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບຂໍ້ມູນທີ່ບັນທຶກໄວ້ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" /> ນຳ.</translation>
<translation id="5579324208890605088">ຂໍ້ຜິດພາດໃນການເລີ່ມຕົ້ນ: ກະລຸນາເອີ້ນໃຊ້ຕົວຕິດຕັ້ງໃນຖານະຜູ້ໃຊ້ທົ່ວໄປ, ບໍ່ແມ່ນໃນຖານະຜູ້ເບິ່ງແຍງລະບົບ.</translation>
<translation id="697769674160644707">ໃຊ້ João Browser ເປັນຄ່າເລີ່ມຕົ້ນ ແລະ ປັກໝຸດມັນໄວ້</translation>
<translation id="5596627076506792578">ໂຕ​ເລືອກ​ເພີ່ມ​ເຕີມ</translation>
<translation id="5605834417512968703">ເລືອກຫຍັງກໍໄດ້ເພື່ອຊອກຫາດ້ວຍການຊອກຫາຮູບ ຫຼື ກົດ Escape ເພື່ອອອກຈາກຄຸນສົມບັດນີ້</translation>
<translation id="5618818588972826921">ເລືອກຂໍ້ຄວາມ ຫຼື ຮູບເພື່ອຊອກຫາດ້ວຍການຊອກຫາຮູບ ຫຼື ກົດ Escape ເພື່ອອອກຈາກການຊອກຫາຮູບ</translation>
<translation id="2497422928854452258">{0,plural, =0{ມີການອັບເດດ João Browser}=1{ມີການອັບເດດ João Browser}other{ມີການອັບເດດ João Browser ເປັນເວລາ # ມື້ແລ້ວ}}</translation>
<translation id="5643865575100044307">ລຶບຂໍ້ມູນເວັບໄຊຈາກອຸປະກອນຂອງທ່ານທຸກເທື່ອທີ່ທ່ານປິດ Chromium</translation>
<translation id="620465883043431255">ກະລຸນາປິດເປີດ João Browser ຄືນໃໝ່ຕອນນີ້</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">ສະ​ແດງ Chromium ເປັນພາສານີ້</translation>
<translation id="569897634095159764">ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບອິນເຕີເນັດໄດ້. ພຣັອກຊີເຊີບເວີຕ້ອງມີການພິສູດຢືນຢັນ.</translation>
<translation id="5768371961535086509">Chromium ຈະເພີ່ມໜ່ວຍຄວາມຈຳຈາກແຖບທີ່ບໍ່ໄດ້ນຳໃຊ້. ເຊິ່ງນີ້ເຮັດໃຫ້ແຖບທີ່ນຳໃຊ້ຢູ່ ແລະ ແອັບອື່ນໆມີຊັບພະຍາກອນສຳລັບຄອມພິວເຕີເພີ່ມຂຶ້ນ ແລະ ຊ່ວຍໃຫ້ Chromium ເຮັດວຽກໄດ້ໄວ. ແຖບທີ່ບໍ່ມີການນຳໃຊ້ຂອງທ່ານຈະກັບມາເຮັດວຽກໂດຍອັດຕະໂນມັດອີກຄັ້ງເມື່ອທ່ານກັບຄືນໄປຫາແຖບເຫຼົ່ານັ້ນ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບຕົວປະຢັດໜ່ວຍຄວາມຈຳ<ph name="END_LINK" /></translation>
<translation id="8866372822266732235">ຫາກທ່ານລືມລະຫັດຜ່ານຂອງທ່ານ ຫຼື ຕ້ອງການປ່ຽນການຕັ້ງຄ່ານີ້, <ph name="SETTINGS_LINK" /> ຂໍ້ມູນ João Browser ໃນບັນຊີຂອງທ່ານ</translation>
<translation id="2106070764285625641">ປັບແຕ່ງ ແລະ ຄວບຄຸມ João Browser. ຕັ້ງ João Browser ເປັນຄ່າເລີ່ມຕົ້ນຂອງທ່ານ.</translation>
<translation id="9077878413488413377">ຊິ້ງລະຫັດຜ່ານ, ບຸກມາກ ແລະ ປະຫວັດຂອງທ່ານໃນອຸປະກອນຕ່າງໆໄດ້ຢ່າງສົມບູນແບບໂດຍຕັ້ງ João Browser ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ.</translation>
<translation id="5809516625706423866">ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບອິນເຕີເນັດໄດ້. HTTP 401 ບໍ່ໄດ້ຮັບອະນຸຍາດ. ກະລຸນາກວດສອບການຕັ້ງຄ່າພຣັອກຊີຂອງທ່ານ.</translation>
<translation id="614221876503883218">ເພີ່ມຄວາມໄວເວັບໄຊດ້ວຍເຄື່ອງຈັກ V8 ຂອງ João Browser ແຕ່ເຮັດໃຫ້ João Browser ມີຄວາມທົນທານຕໍ່ການໂຈມຕີໜ້ອຍລົງເລັກນ້ອຍ. ການຕັ້ງຄ່ານີ້ປິດຢູ່.</translation>
<translation id="8788365803279840995">ເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ João Browser ໃນບັນຊີ Google ຂອງທ່ານ, ກະລຸນາອັບເດດ João Browser</translation>
<translation id="5824893331272123205">ບໍ່ສາມາດໂຫຼດແຜງນີ້ໄດ້, ກະລຸນາລອງໃໝ່</translation>
<translation id="5805760187441013922">ຍິນ​ດີ​ຕ້ອນ​ຮັບສູ່ João Browser</translation>
<translation id="5867606647614813312">ເປີດຄຸນສົມບັດເພີ່ມເຕີມເພື່ອໃຫ້ການປົກປ້ອງທີ່ເຂັ້ມງວດທີ່ສຸດຂອງ Chromium</translation>
<translation id="5871205389137001634">ຄລິກເພື່ອອອກຈາກການຊອກຫາຮູບ</translation>
<translation id="8367098380158627809">João Browser ພົບວ່າລາຍການເຫຼົ່ານີ້ມີເມົາແວ:</translation>
<translation id="5889361821821684993">Chromium ຈະກວດສອບເປັນປະຈຳເພື່ອໃຫ້ແນ່ໃຈວ່າໂປຣແກຣມທ່ອງເວັບຂອງທ່ານມີການຕັ້ງຄ່າທີ່ປອດໄພທີ່ສຸດ. ພວກເຮົາຈະແຈ້ງໃຫ້ທ່ານຮູ້ຫາກມີຫຍັງທີ່ຕ້ອງໃຫ້ທ່ານກວດສອບ.</translation>
<translation id="5895138241574237353">ເລີ່ມຕົ້ນໃໝ່</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - ການເຂົ້າສູ່ລະບົບເຄືອຂ່າຍ</translation>
<translation id="5924017743176219022">ກຳ​ລັງ​ເຊື່ອມ​ຕໍ່​ອິນ​ເຕີ​ເນັດ...</translation>
<translation id="7627350220326904504">ມາກຽມ João Browser ຂອງທ່ານໃຫ້ພ້ອມນຳໃຊ້ກັນເລີຍ</translation>
<translation id="5941711191222866238">ຫຍໍ້ລົງ</translation>
<translation id="8680863040348007215">ເພື່ອຮັບເອົາບຸກມາກນີ້ ແລະ ອື່ນໆອີກໃນທຸກອຸປະກອນຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser</translation>
<translation id="2008232276062354182">ເຮັດໃຫ້ João Browser ເປັນຂອງທ່ານ</translation>
<translation id="5960071705175224773">ແອັບທີ່ບໍ່ຮູ້ຈັກປ່ຽນການຕັ້ງຄ່າຂອງທ່ານ</translation>
<translation id="5977420883993828287">ປັກໝຸດແລ້ວ! ໃຊ້ໜ້າວຽກຕາມບໍລິບົດອີກຄັ້ງຈາກແຖບເຄື່ອງມື</translation>
<translation id="5889362640603897718">{COUNT,plural, =1{ອົງກອນຂອງທ່ານຈະປິດ João Browser ໂດຍອັດຕະໂນມັດເມື່ອບໍ່ມີການນຳໃຊ້ເປັນເວລາ 1 ນາທີ.}other{ອົງກອນຂອງທ່ານຈະປິດ João Browser ໂດຍອັດຕະໂນມັດເມື່ອບໍ່ມີການນຳໃຊ້ເປັນເວລາ # ນາທີ.}}</translation>
<translation id="4971097497342057998">ອັບເດດ João Browser ເພື່ອເລີ່ມຊິ້ງຂໍ້ມູນ</translation>
<translation id="5990360079535151574">ຈາກປຸ່ມ "ໜ້າວຽກຕາມບໍລິບົດ" ຢູ່ແຖບເຄື່ອງມື, ທ່ານສາມາດເປີດໜ້າວຽກຕາມບໍລິບົດອີກຄັ້ງເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="6003112304606738118">ກຳລັງດາວໂຫຼດ... ຍັງເຫຼືອ <ph name="HOURS" /> ຊົ່ວໂມງ</translation>
<translation id="6009821354356307391">ຂໍການຕິດຕາມຜົນ</translation>
<translation id="6040143037577758943">ປິດ</translation>
<translation id="2100398097168307292">ໃຊ້ປະໂຫຍດເພີ່ມເຕີມຈາກການຊື້ເຄື່ອງອອນລາຍເມື່ອທ່ານໃຊ້ແອັບ João Browser ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="6058380562449900225">ເພື່ອປົກປ້ອງຂໍ້ມູນຂອງທ່ານ, ອະນຸຍາດໃຫ້ Chromium ລຶບການອະນຸຍາດອອກຈາກເວັບໄຊທີ່ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. ແຕ່ບໍ່ຢຸດການແຈ້ງເຕືອນ.</translation>
<translation id="4735359759698689867">&amp;ເປີດໃນ João Browser</translation>
<translation id="6069027071882229820">ສຳເນົາເປັນຮູບ</translation>
<translation id="2274675514456642321">ເພີ່ມ <ph name="EXTENSION_NAME" /> ໃສ່ João Browser ແລ້ວ</translation>
<translation id="147381942282490529">ປັບແຕ່ງ ແລະ ຄວບຄຸມ João Browser. ມີການອັບເດດແລ້ວ</translation>
<translation id="8775234022739879423">ເປີດ • João Browser ບໍ່ສາມາດຢັ້ງຢືນໄດ້ວ່າສ່ວນຂະຫຍາຍນີ້ມາຈາກໃສ</translation>
<translation id="6634821567165410381">ບັນຊີຂອງທ່ານໃນ João Browser</translation>
<translation id="4398707227122702993">ອະນຸຍາດໃຫ້ສ່ວນຂະຫຍາຍສະແດງຄຳຮ້ອງຂໍສິດເຂົ້າເຖິງໃນແຖບເຄື່ອງມື João Browser</translation>
<translation id="5370941509199989624"><ph name="FILE_NAME" /> ອັນຕະລາຍ, ສະນັ້ນ João Browser ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="5119118887583954582">João Browser ຈະປິດ ແລະ ລຶບຂໍ້ມູນໃນໄວໆນີ້</translation>
<translation id="576637711620229618">ທ່ານສາມາດສະຫຼັບລະຫວ່າງໂປຣໄຟລ໌ João Browser ໄດ້ຢູ່ບ່ອນນີ້</translation>
<translation id="615103374448673771">ຫາກທ່ານອະນຸຍາດໃຫ້ໃຊ້ຄຸກກີ້ໄດ້, Chromium ອາດໃຊ້ພວກມັນເມື່ອໂຫຼດກ່ອນລ່ວງໜ້າ</translation>
<translation id="6165508094623778733">ສຶກສາ​ເພີ່ມ​ເຕີມ</translation>
<translation id="3738215896821824918">ລຶບລ້າງຂໍ້ມູນ João Browser ໃນບັນຊີຂອງທ່ານ</translation>
<translation id="2145111683361496197">ໄຟລ໌ນີ້ອາດເປັນອັນຕະລາຍ<ph name="LINE_BREAK" />João Browser ສາມາດກວດສອບການດາວໂຫຼດນີ້ໃຫ້ທ່ານໄດ້ຫາກທ່ານລະບຸລະຫັດຜ່ານ. ຂໍ້ມູນກ່ຽວກັບໄຟລ໌ຈະຖືກສົ່ງໄປຫາ Google Safe Browsing, ແຕ່ເນື້ອຫາໄຟລ໌ ແລະ ລະຫັດຜ່ານຈະຍັງຢູ່ໃນອຸປະກອນຂອງທ່ານ.</translation>
<translation id="6182736845697986886">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກເຊີບເວີອັບເດດເກີດຂໍ້ຜິດພາດພາຍໃນ.</translation>
<translation id="6050294746023477088">ກວດໃຫ້ແນ່ໃຈວ່າທ່ານໄດ້ເຂົ້າສູ່ລະບົບ Chrome ໃນ <ph name="TARGET_DEVICE_NAME" /> ຂອງທ່ານ ແລ້ວລອງສົ່ງໃໝ່.</translation>
<translation id="3395167674702947885">ຄອມພິວເຕີນີ້ມີ João Browser ລຸ້ນໃໝ່ກ່ວາຢູ່ຮຽບຮ້ອຍແລ້ວ. ຖ້າຊອບແວບໍ່ເຮັດວຽກ, ກະລຸນາຖອນຕິດຕັ້ງ João Browser ແລະລອງໃໝ່ອີກ.</translation>
<translation id="4384214545531685923">{0,plural, =0{João Browser ຈະເປີດຄືນໃໝ່ດຽວນີ້}=1{João Browser ຈະເປີດຄືນໃໝ່ໃນ 1 ວິນາທີ}other{João Browser ຈະເປີດຄືນໃໝ່ໃນ # ວິນາທີ}}</translation>
<translation id="5880255774989397049">João Browser ຕ້ອງການການອະນຸຍາດເຂົ້າເຖິງບ່ອນຈັດເກັບຂໍ້ມູນເພື່ອດາວໂຫຼດໄຟລ໌</translation>
<translation id="6245734527075554892">ກວດສອບ URL ກັບລາຍຊື່ເວັບໄຊທີ່ບໍ່ປອດໄພທີ່ຈັດເກັບໄວ້ໃນ Chromium</translation>
<translation id="1959823478027154444">ເຮັດ João Browser ເປັນບຣາວ​ເຊີມາດຕະຖານ</translation>
<translation id="6248988683584659830">ການຕັ້ງຄ່າຄົ້ນຫາ</translation>
<translation id="9191635841540101343">ໃຊ້ຄຸນສົມບັດຄວາມປອດໄພທີ່ດີທີ່ສຸດຂອງ Google ໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ João Browser ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="538350741885862188">ອອກຈາກລະບົບ João Browser ບໍ?</translation>
<translation id="161121067714522736">ແຖບເຫຼົ່ານີ້ໃຊ້ຊັບພະຍາກອນຫຼາຍເປັນພິເສດ. ເພື່ອປັບປຸງປະສິດທິພາບຂອງທ່ານ, ກະລຸນາໃຫ້ João Browser ຊ່ວຍປິດນຳໃຊ້ແຖບເຫຼົ່ານີ້.</translation>
<translation id="2095090272560293574">ປັບແຕ່ງໂປຣໄຟລ໌ João Browser ຂອງທ່ານ</translation>
<translation id="6290827346642914212">ຕັ້ງຊື່ໂປຣໄຟລ໌ Chromium ຂອງທ່ານ</translation>
<translation id="6472525517562723285">ສ່ວນຂະຫຍາຍຕ້ອງການໃຫ້ທ່ານເຂົ້າສູ່ລະບົບ João Browser</translation>
<translation id="2069878195899746465"><ph name="FILE_NAME" /> ອາດຈະອັນຕະລາຍ, ສະນັ້ນ João Browser ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="1283909912629029170">João Browser ກໍາລັງໃຊ້​ກ້ອງ​ຖ່າຍ​ຮູບຂອງ​ທ່ານ​.</translation>
<translation id="323902744000752306">ການດຳເນີນການອື່ນໃນ João Browser ພວມດຳເນີນຢູ່. ກະລຸນາລອງອີກຄັ້ງໃນພາຍຫຼັງ.</translation>
<translation id="1292164882596462877">ດຽວນີ້ມັນງ່າຍທີ່ຈະໃຊ້ João Browser ກັບບັນຊີ Google ຂອງທ່ານ ແລະຢູ່ໃນຄອມພິວເຕີທີ່ແຊຣ໌ແລ້ວ.</translation>
<translation id="6411450594978516531">ເຂົ້າເຖິງຄຸນສົມບັດທີ່ທ່ານຮູ້ຈັກ, ມັກ ແລະ ໄວ້ວາງໃຈໄດ້ຢ່າງງ່າຍດາຍໂດຍການຕັ້ງຄ່າ João Browser ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ.</translation>
<translation id="3344301749774719950">ທາງລັດ João Browser</translation>
<translation id="8395825163097750991">João Browser ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກໄຟລ໌ບໍ່ໄດ້ມີການດາວໂຫຼດໂດຍທົ່ວໄປ ແລະ ອາດເປັນອັນຕະລາຍ</translation>
<translation id="7683737657427846440">ທ່ານແນ່ໃຈບໍວ່າ ທ່ານຕ້ອງການຖອນຕິດຕັ້ງ João Browser?</translation>
<translation id="6375219077595103062">ເພີ່ມທາງລັດໃສ່ຕົວຈັດການລະຫັດຜ່ານ</translation>
<translation id="6388799252195623474">ຊ່ວຍຂ້ອຍໃນເລື່ອງນີ້</translation>
<translation id="6966523531135953867">ເພື່ອສືບຕໍ່, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser ດ້ວຍ <ph name="EMAIL" />. ການດຳເນີນການນີ້ຈະກວດສອບວ່າທ່ານມີນະໂຍບາຍຂອງອົງກອນຂອງທ່ານແລ້ວ.</translation>
<translation id="5146608242127807773">ໂລໂກ້ João Browser ພາຍໃນໜ້າຈໍຄອມພິວເຕີ.</translation>
<translation id="6361476216650509195">João Browser ແມ່ນບຣາວເຊີເວັບທີ່ແລ່ນໜ້າເວັບ ແລະແອັບພລິເຄຊັນດ້ວຍຄວາມໄວແບບສາຍຟ້າແມັບ. ມັນໄວ, ໝັ້ນຄົງ, ແລະໃຊ້ງ່າຍ. ທ່ອງເວັບໄດ້ປອດໄພກ່ວາດ້ວຍການປົກປ້ອງມາລແວ ແລະພິຊຊິງທີ່ສ້າງຢູ່ໃນຕົວ João Browser.</translation>
<translation id="7864687914956920860">ເພື່ອກວດສອບໃຫ້ແນ່ໃຈວ່າທ່ານສາມາດໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ João Browser ໃນບັນຊີ Google ຂອງທ່ານໄດ້ຕະລອດເວລາ, ກະລຸນາຢັ້ງຢືນວ່າແມ່ນທ່ານ</translation>
<translation id="1160920197193662978">João Browser ເຮັດວຽກໄດ້ໄວຂຶ້ນ ແລະ ຄຸນສົມບັດທີ່ໃຊ້ JavaScript ຄວນເຮັດວຽກຕາມທີ່ອອກແບບໄວ້</translation>
<translation id="6436260184216827876">ການຊອກຫາຮູບບໍ່ພ້ອມນຳໃຊ້. ກະລຸນາລອງໃໝ່ໃນພາຍຫຼັງ.</translation>
<translation id="6442900851116057561">ຣີສະຕາດ ChromiumOS</translation>
<translation id="6443470774889161065">Chromium ໂຫຼດໜ້າເວັບໄວ້ກ່ອນລ່ວງໜ້າເພີ່ມຫຼາຍຂຶ້ນສຳລັບໜ້າທີ່ທ່ານອາດຈະເຂົ້າເບິ່ງ, ເພື່ອໃຫ້ພວກມັນໂຫຼດໄວຂຶ້ນເມື່ອທ່ານເຂົ້າເບິ່ງ</translation>
<translation id="3730564967922511625">ດາວໂຫຼດ João Browser ຢູ່ໂທລະສັບຂອງທ່ານເພື່ອຕິດຕາມລາຄາ ແລະ ຮັບການແຈ້ງເຕືອນເມື່ອລາຄາຫຼຸດລົງໃນເວັບໄຊໃດກໍຕາມ</translation>
<translation id="3753019081686930624">ປິດ • João Browser ບໍ່ສາມາດຢັ້ງຢືນໄດ້ວ່າສ່ວນຂະຫຍາຍນີ້ມາຈາກໃສ</translation>
<translation id="5444641426058108434">ຍິນດີຕ້ອນຮັບສູ່ໂປຣໄຟລ໌ João Browser</translation>
<translation id="5103470775766355478">ເທື່ອຕໍ່ໄປທີ່ທ່ານເປີດ João Browser ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ, ທ່ານຈະເຫັນຂໍ້ຄວາມແຈ້ງໃຫ້ໃຊ້ກຸ່ມແຖບ.</translation>
<translation id="9087231386723579740">ລຶບບັນຊີອອກຈາກ João Browser</translation>
<translation id="4984395209542302039">ມັນຍັງຄວບຄຸມວ່າຈະໃຫ້ສະແດງໜ້າໃດຂຶ້ນ ເມື່ອທ່ານເລີ່ມຕົ້ນເປີດ João Browser.</translation>
<translation id="648319183876919572">Safe Browsing ທີ່ປັບປຸງດີຂຶ້ນຊ່ວຍປົກປ້ອງທ່ານຈາກເວັບໄຊ ແລະ ການດາວໂຫຼດທີ່ອັນຕະລາຍ</translation>
<translation id="1524792685704191751">ຖອນ​ຕິດ​ຕັ້ງ João Browser</translation>
<translation id="6637504267182028286">ເປີດທາງລັດໃນ João Browser</translation>
<translation id="1478247638436966279">ອົງກອນຂອງທ່ານປິດ João Browser ໄວ້ເມື່ອມັນບໍ່ໄດ້ຖືກນຳໃຊ້ເປັນເວລາ <ph name="TIMEOUT_DURATION" />. ຂໍ້ມູນການທ່ອງເວັບຖືກລຶບອອກແລ້ວ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ.</translation>
<translation id="1311233187253046133">ແຕ່ລະໂປຣໄຟລ໌ມີຂໍ້ມູນ João Browser ຂອງມັນເອງ ເຊັ່ນ: ບຸກມາກ, ປະຫວັດ, ລະຫັດຜ່ານ ແລະ ອື່ນໆອີກ</translation>
<translation id="6563921047760808519">ສຶກສາເພີ່ມເຕີມກ່ຽວກັບ <ph name="BEGIN_LINK" />ວິທີທີ່ Chromium ຮັກສາຂໍ້ມູນຂອງທ່ານໃຫ້ເປັນສ່ວນຕົວ<ph name="END_LINK" /></translation>
<translation id="1643078533228697915">ການປ່ຽນແປງການຕັ້ງຄ່ານີ້ຈະມີຜົນນຳໃຊ້ເມື່ອ João Browser ຣີສະຕາດ.</translation>
<translation id="1918630514771863338">ຈັດການສ່ວນຂະຫຍາຍຂອງທ່ານໂດຍການຄລິກສ່ວນຂະຫຍາຍໃນເມນູຫຼັກຂອງ João Browser.</translation>
<translation id="4229328298978407243">ທ່ານສາມາດສະຫຼັບເພື່ອເບິ່ງລະຫັດຜ່ານຈາກໂປຣໄຟລ໌ João Browser ອື່ນໄດ້</translation>
<translation id="7717252965531997879">ໃຊ້ແອັບ João Browser ເພື່ອນຳເຄື່ອງມື AI ທີ່ດີທີ່ສຸດໄປໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="6570579332384693436">ເພື່ອແກ້ໄຂການສະກົດຄຳຜິດ, Chromium ສົ່ງຂໍ້ຄວາມທີ່ທ່ານພິມໃນຊ່ອງຂໍ້ຄວາມໃຫ້ Google</translation>
<translation id="5374627817618267090">ໄປຫາການຕັ້ງຄ່າການແຈ້ງເຕືອນຂອງ João Browser</translation>
<translation id="6600016381025017075">ຊອກຫາຫຍັງກໍໄດ້ໃນໜ້ານີ້</translation>
<translation id="264335610358256197">ການປ່ຽນແປງຂອງທ່ານຈະມີຜົນຄັ້ງຕໍ່ໄປທີ່ທ່ານເລີ່ມເປີດໃຊ້ João Browser ໃໝ່.</translation>
<translation id="2657584510687441826">ຕອນນີ້ລະບົບຈະເປີດໃຊ້ João Browser ເມື່ອ Windows ເລີ່ມເຮັດວຽກເພື່ອໃຫ້ທ່ານສາມາດເລີ່ມທ່ອງເວັບໄດ້ທັນທີ. ທ່ານສາມາດປິດການດຳເນີນການນີ້ໄດ້ໃນການຕັ້ງຄ່າ.</translation>
<translation id="5482413402708094860">ສືບຕໍ່ຈາກບ່ອນທີ່ທ່ານຄ້າງໄວ້: João Browser ໄດ້ກູ້ຄືນແທັບຂອງທ່ານຈາກເຊດຊັນຫຼ້າສຸດຂອງທ່ານ. ທ່ານສາມາດປິດໃຊ້ສິ່ງນີ້ໄດ້ໃນ</translation>
<translation id="5022765692226673603">João Browser ຕ້ອງການການອະນຸຍາດກ້ອງຖ່າຍຮູບເພື່ອສ້າງແຜນທີ່ 3 ມິຕິຂອງສິ່ງອ້ອມຕົວທ່ານ</translation>
<translation id="6669284030132180248">ນອກຈາກນັ້ນ, ຫາກທ່ານບັນທຶກບຸກມາກຂອງທ່ານໃນບັນຊີ Google ຂອງທ່ານ, ທ່ານສາມາດຕິດຕາມລາຄາຜະລິດຕະພັນໃນ Chromium ແລະ ຮັບການແຈ້ງເຕືອນເມື່ອລາຄາຫຼຸດລົງໄດ້</translation>
<translation id="6676384891291319759">ການເຂົ້າຫາອິນເຕີເນັດ</translation>
<translation id="668175097507315160">ChromiumOS ບໍ່ສາມາດຊິ້ງຂໍ້ມູນຂອງທ່ານໄດ້ເນື່ອງຈາກການເຂົ້າສູ່ລະບົບຜິດພາດ.</translation>
<translation id="3982573751008180181">ລຶບຂໍ້ມູນຂອງແອັບນີ້ອອກຈາກ João Browser</translation>
<translation id="5613723096388999601">João Browser ຕ້ອງການການອະນຸຍາດໄມໂຄຣໂຟນສຳລັບເວັບໄຊນີ້</translation>
<translation id="6712881677154121168">ດາວໂຫຼດຜິດພາດ: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="9190188975825967506">ບໍ່ສາມາດໃຊ້ໂປຣໄຟລ໌ຂອງທ່ານໄດ້ ເພາະວ່າມັນມາຈາກ João Browser ລຸ້ນໃໝ່ກ່ວາ.

ບາງ​ຄຸນສົມບັດອາດຈະບໍ່ມີ​ໃຫ້. ກະລຸນາລະບຸລາຍຊື່ບັນຊີໂປຣໄຟລ໌ຕ່າງ ຫຼືໃຊ້ João Browser ລຸ້ນໃໝ່ກ່ວາ.</translation>
<translation id="6729124504294600478">ເພື່ອຮັບການປັບແຕ່ງເປັນແບບສ່ວນຕົວ ແລະ ຄຸນສົມບັດອື່ນໆ, ໃຫ້ຮວມ Chromium ໄວ້ໃນການເຄື່ອນໄຫວເວັບ ແລະ ແອັບ ພ້ອມທັງບໍລິການ Google ທີ່ລິ້ງໄວ້</translation>
<translation id="6957684879859415418">ຕິດຕັ້ງ João Browser ສຳລັບຜູ້ໃຊ້ທຸກຄົນໃນຄອມພິວເຕີຂອງທ່ານແລ້ວ.</translation>
<translation id="4411262692912917677">ເພື່ອເຂົ້າເຖິງບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser. ລະບົບຈະບັນທຶກບຸກມາກນີ້ໄວ້ໃນບັນຊີ Google ຂອງທ່ານຫຼັງຈາກທີ່ທ່ານເຂົ້າສູ່ລະບົບ.</translation>
<translation id="6064901610880747710">ເພີ່ມຄວາມໄວເວັບໄຊດ້ວຍເຄື່ອງຈັກ V8 ຂອງ João Browser ແຕ່ເຮັດໃຫ້ João Browser ມີຄວາມທົນທານຕໍ່ການໂຈມຕີໜ້ອຍລົງເລັກນ້ອຍ. ການຕັ້ງຄ່ານີ້ເປີດຢູ່.</translation>
<translation id="4530735110472079436">{count,plural, =1{ຂໍ້ມູນ João Browser ບາງສ່ວນຂອງທ່ານຍັງບໍ່ໄດ້ຖືກບັນທຶກໄວ້ໃນບັນຊີ Google ຂອງທ່ານເທື່ອ. ກະລຸນາລໍຖ້າສອງສາມນາທີກ່ອນອອກຈາກລະບົບ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ (1 ລາຍການ) ຈະຖືກລຶບ.}other{ຂໍ້ມູນ João Browser ບາງສ່ວນຂອງທ່ານຍັງບໍ່ໄດ້ຖືກບັນທຶກໄວ້ໃນບັນຊີ Google ຂອງທ່ານເທື່ອ. ກະລຸນາລໍຖ້າສອງສາມນາທີກ່ອນອອກຈາກລະບົບ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ ({count} ລາຍການ) ຈະຖືກລຶບ.}}</translation>
<translation id="9176853308971176490">João Browser ແນະນຳໃຫ້ສະແກນໄຟລ໌ນີ້ເນື່ອງຈາກມັນອາດເປັນອັນຕະລາຍໄດ້.</translation>
<translation id="6779406956731413166">ChromiumOS ເກີດຂຶ້ນໄດ້ດ້ວຍ <ph name="BEGIN_LINK_CROS_OSS" />ຊອບແວໂອເພນຊອດ<ph name="END_LINK_CROS_OSS" /> ເພີ່ມເຕີມ.</translation>
<translation id="6831043979455480757">ແປພາສາ</translation>
<translation id="6412488898785231889">João Browser ແຈ້ງໃຫ້ທ່ານຮູ້ຖ້າມີຄົນຮູ້ລະຫັດຜ່ານຂອງທ່ານ</translation>
<translation id="684888714667046800">ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບອິນເຕີເນັດໄດ້. ຫາກທ່ານໃຊ້ firewall, ກະລຸນາກວດສອບໃຫ້ໝັ້ນໃຈວ່າ <ph name="PRODUCT_EXE_NAME" /> ຢູ່ໃນລາຍຊື່ອະນຸຍາດ.</translation>
<translation id="6750640664545078431">João Browser - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">ແຕະເພື່ອສືບຕໍ່</translation>
<translation id="6862030660799253820">ຊອກຫາຮູບນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="4260365383290377081">João Browser ພົບວ່າ "<ph name="EXTENSION_NAME" />" ມີເມົາແວ</translation>
<translation id="6877155553248388166">ມຸມຂວາລຸ່ມຂອງພື້ນທີ່ຊອກຫາ: ຂວາ <ph name="RIGHT" />%, ລຸ່ມ <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">ສຳເນົາ</translation>
<translation id="6898028264630240901">ທ່ານສາມາດປັກໝຸດໜ້າວຽກຕາມບໍລິບົດເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="6985817498888719203">ຕັ້ງ João Browser ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ ແລະ ປັກໝຸດມັນໃສ່ແຖບໜ້າວຽກຂອງທ່ານ</translation>
<translation id="5277424858974213042">&amp;ຈັດການໂປຣໄຟລ໌ João Browser</translation>
<translation id="2726137364317931343">ການດຳເນີນການນີ້ຈະເຮັດສິ່ງຕໍ່ໄປນີ້:
          <ph name="LINE_BREAKS" />
            • ຣີເຊັດໜ້າເລີ່ມຕົ້ນ, ໜ້າແຖບໃໝ່, ໂປຣແກຣມຊອກຫາ ແລະ ແຖບທີ່ປັກໝຸດແລ້ວຂອງທ່ານ
            <ph name="LINE_BREAK" />
            • ປິດການນຳໃຊ້ສ່ວນຂະຫຍາຍ
            <ph name="LINE_BREAK" />
            • ລຶບຄຸກກີ້ ແລະ ຂໍ້ມູນເວັບໄຊຊົ່ວຄາວອື່ນໆ
            <ph name="LINE_BREAK" />
            • ຣີເຊັດທາງລັດຂອງ João Browser
            <ph name="LINE_BREAKS" />
            ການດຳເນີນການນີ້ຈະບໍ່ມີຜົນກັບບຸກມາກ, ປະຫວັດ ແລະ ລະຫັດຜ່ານທີ່ບັນທຶກໄວ້.</translation>
<translation id="2901988969322822496">ທ່ານບັນທຶກບຸກມາກຂອງ João Browser ຮອດຂີດຈຳກັດ <ph name="BOOKMARK_LIMIT" /> ລາຍການແລ້ວ, ດັ່ງນັ້ນລະບົບຈຶ່ງຍັງບໍ່ໄດ້ບັນທຶກບຸກມາກບາງລາຍການຂອງທ່ານໃສ່ໃນບັນຊີ Google ຂອງທ່ານເທື່ອ.

ທ່ານຈະບໍ່ສາມາດບັນທຶກບຸກມາກໃໝ່ໃສ່ໃນບັນຊີຂອງທ່ານໄດ້ຈົນກວ່າທ່ານຈະລຶບບຸກມາກບາງລາຍການອອກ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ລະບົບຈະລຶບບຸກມາກທີ່ຍັງບໍ່ໄດ້ບັນທຶກໄວ້ອອກ.</translation>
<translation id="6203410920314218280">ເປີດລິ້ງໃນໜ້າຈໍທີ່ບໍ່ເຜີຍຕົວຕົນຂອງ João Browser</translation>
<translation id="6965382102122355670">ຕົກລົງ</translation>
<translation id="6985329841647292029">ຂໍ້ກຳນົດ ChromiumOS</translation>
<translation id="8064285182627814996">ໃສ່ລະຫັດຜ່ານຂອງທ່ານເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ João Browser ໃນບັນຊີຂອງທ່ານ, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="7011190694940573312">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກລະບົບບໍ່ຮອງຮັບລະບົບປະຕິບັດການເວີຊັນນີ້.</translation>
<translation id="7024536598735240744">ແຕກໄຟລ໌ຜິດພາດ: <ph name="UNPACK_ERROR" />.</translation>
<translation id="181803036615530330">ຕັ້ງຄ່າ João Browser ແບບກຳນົດເອງ</translation>
<translation id="7047386856539490735">ຜົນການຊອກຫາເຫຼົ່ານີ້ມີປະໂຫຍດຫຼືບໍ່?</translation>
<translation id="2478245051737698828">ອັບເດດ João Browser</translation>
<translation id="452909342278940733">ຖ້າຮູບບໍ່ມີລາຍລະອຽດທີ່ເປັນປະໂຫຍດ, João Browser ຈະພະຍາຍາມໃຫ້ລາຍລະອຽດແກ່ທ່ານ. ເພື່ອສ້າງລາຍລະອຽດ, ລະບົບຈະສົ່ງຮູບພາບໃຫ້ Google.</translation>
<translation id="8606769615526968368">ສຳຜັດປະສິດທິພາບຂອງ AI ເມື່ອທ່ານໃຊ້ແອັບ João Browser ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="2061960765882453684">ເຂົ້າເຖິງລະຫັດຜ່ານ, ແຖບ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ João Browser ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="7141270731789036260">ປັບແຕ່ງ Chrome for Testing</translation>
<translation id="7147227333672430807">ທ່ານສາມາດໃຊ້ Chromium ໄດ້ທຸກເທື່ອທີ່ທ່ານຄລິກລິ້ງໃນຂໍ້ຄວາມ, ເອກະສານ ແລະ ແອັບອື່ນໆ</translation>
<translation id="6949173677980969871">ລຶບ <ph name="EXTENSION_NAME" /> ອອກຈາກ João Browser</translation>
<translation id="3556355753960287061">ອົງກອນຂອງທ່ານລຶບຂໍ້ມູນຂອງ João Browser ອອກເມື່ອມັນບໍ່ໄດ້ຖືກນຳໃຊ້ເປັນເວລາ <ph name="TIMEOUT_DURATION" />. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ.</translation>
<translation id="8689006320829658442">João Browser ຕ້ອງການການອະນຸຍາດກ້ອງຖ່າຍຮູບສຳລັບເວັບໄຊນີ້</translation>
<translation id="7501884108538572227">ບໍ່ສາມາດເປີດໃຊ້ João Browser ໄດ້. ກະລຸນາລອງອີກຄັ້ງ.</translation>
<translation id="5484563502710761706">ຖາມຫຍັງກໍໄດ້, ຈາກບ່ອນທີ່ທ່ານຢູ່, ດ້ວຍ Gemini ໃນ João Browser</translation>
<translation id="3823264355161086552">ເກັບ João Browser ໃນດັອກຂອງທ່ານເພື່ອໄປໃຊ້ມັນຢ່າງວ່ອງໄວໄດ້ທຸກເວລາ</translation>
<translation id="9153902741226700840">ໃຊ້ João Browser ຕອນໃດກໍໄດ້ທີ່ທ່ານຄລິກລິ້ງໃນຂໍ້ຄວາມ, ເອກະສານ ແລະ ແອັບອື່ນໆ</translation>
<translation id="7216228761061470870">ເມື່ອທ່ານໃຊ້ຄຸນສົມບັດຊອກຫາຮູບຢູ່ເດັສທັອບ, ລະບົບຈະສົ່ງຊື່ໜ້າ, URL ແລະ ເນື້ອຫາ, ຮວມທັງ PDF ໄປຫາເຊີບເວີ</translation>
<translation id="7950844619283784703">ຕົວຈັດການໜ້າວຽກ - João Browser</translation>
<translation id="133513825972536773"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບຂໍ້ມູນທີ່ບັນທຶກໄວ້ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານນຳ.</translation>
<translation id="4558982617284733740">ເລີ່ມທ່ອງເວັບໄດ້ທັນທີ: ຕອນນີ້ລະບົບສາມາດເປີດໃຊ້ João Browser ເມື່ອ Windows ເລີ່ມເຮັດວຽກໄດ້ແລ້ວ.</translation>
<translation id="7274695763216404502">ປັກໝຸດແລ້ວ! ໃຊ້ການຊອກຫາຮູບອີກຄັ້ງຈາກແຖບເຄື່ອງມື</translation>
<translation id="7288567540154601580">ແຖບ ແລະ ສ່ວນຂະຫຍາຍ</translation>
<translation id="5494571279964989269">{NUM_EXTENSIONS,plural, =1{João Browser ແນະນຳໃຫ້ທ່ານລຶບອອກ}other{João Browser ແນະນຳໃຫ້ທ່ານລຶບອອກ}}</translation>
<translation id="2269053214123323740">ເພື່ອແບ່ງປັນສຽງຂອງລະບົບ, ໃຫ້ເປີດການຕັ້ງຄ່າລະບົບ ແລະ ອະນຸຍາດ 'ການບັນທຶກສຽງຂອງລະບົບເທົ່ານັ້ນ' ສຳລັບ João Browser. ຈາກນັ້ນທ່ານຈະຕ້ອງຣີສະຕາດ João Browser.</translation>
<translation id="731795002583552498">ກໍາລັງອັບເດດ Chromium</translation>
<translation id="9065168747010082551">ໄຟລ໌ທີ່ມັກຂອງທ່ານເສຍຫາຍ ຫຼືໃຊ້ບໍ່ໄດ້.

João Browser ບໍ່ສາມາດກູ້ການຕັ້ງຄ່າຂອງທ່ານຄືນໄດ້.</translation>
<translation id="7324051657739063017">ທ່ານສາມາດເປີດໜ້າວຽກຕາມບໍລິບົດຄືນໃໝ່ເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="4159250197688136733">ເວັບຂອງທ່ານ, ບຸກມາກສ໌, ແລະ João Browser ອື່ນສົດຢູ່ທີ່ນີ້.</translation>
<translation id="7347827960336370838">ມີພຽງບຸກຄົນທີ່ມີລະຫັດຜ່ານຂອງທ່ານເທົ່ານັ້ນທີ່ສາມາດອ່ານຂໍ້ມູນທີ່ໄດ້ຖືກເຂົ້າລະຫັດໄວ້ຂອງທ່ານໄດ້. Google ຈະບໍ່ໄດ້ຮັບ ຫຼື ຈັດເກັບລະຫັດຜ່ານດັ່ງກ່າວ. ຫາກທ່ານລືມລະຫັດຜ່ານຂອງຕົນເອງ ຫຼື ຕ້ອງການປ່ຽນການຕັ້ງຄ່ານີ້, ທ່ານຈະຕ້ອງ <ph name="BEGIN_LINK" />ລຶບຂໍ້ມູນ Chromium ໃນບັນຊີຂອງທ່ານ<ph name="END_LINK" />.</translation>
<translation id="1062903713270840396">ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານໄດ້ກຳນົດຄ່າໃຫ້ João Browser ເປີດ <ph name="ALTERNATIVE_BROWSER_NAME" /> ເພື່ອເຂົ້າເຖິງ <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">ມີ​ບາງ​ອັນ​ຜິດ​ພາດ</translation>
<translation id="5817362738974335084">ເພື່ອຮັບການອັບເດດ João Browser ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ macOS 13 ຂຶ້ນໄປ. ຄອມພິວເຕີເຄື່ອງນີ້ກຳລັງໃຊ້ macOS 12.</translation>
<translation id="7376384068949534168">ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. Chromium ໄດ້ລຶບ <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> ອອກແລ້ວ.</translation>
<translation id="73786666777299047">ເປີດ Chrome Web Store</translation>
<translation id="5724625487458697703">ສະແດງ Gemini ໃນ João Browser ໃນຖາດລະບົບ</translation>
<translation id="7401687852903179959">ຊອກຫາວິດີໂອນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="1088684725931971005">ຕອນນີ້ João Browser ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານແລ້ວ</translation>
<translation id="7479848806300971661">ສືບຕໍ່ຈາກບ່ອນທີ່ທ່ານຄ້າງໄວ້: João Browser ຈະກູ້ຄືນແຖບຂອງທ່ານໄດ້ທຸກຄັ້ງທີ່ທ່ານປິດເປີດໃໝ່. ເພື່ອປິດໃຊ້ສິ່ງນີ້, ໃຫ້ໄປຫາ</translation>
<translation id="1258077876605261365">ນຳເຂົ້າລະຫັດຜ່ານໃສ່ João Browser</translation>
<translation id="5293062713751091377">1. ຄລິກ <ph name="BUTTON_LABEL" /> ທາງລຸ່ມ
2. ຄລິກ <ph name="BUTTON_2" /> ໃນການຕັ້ງຄ່າ Windows ຂອງທ່ານ
3. ຄລິກ <ph name="BUTTON_3" /> ໃນການແຈ້ງເຕືອນ Windows ເພື່ອປັກໝຸດ João Browser ໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ຢ່າງວ່ອງໄວ</translation>
<translation id="1941496545060769345"><ph name="PAGE_TITLE" /> - João Browser Dev</translation>
<translation id="7450541714075000668">ສຳເນົາຂໍ້ຄວາມແລ້ວ</translation>
<translation id="7458892263350425044">ເພື່ອໃຊ້ໄມໂຄຣໂຟນຂອງທ່ານ, ກະລຸນາມອບສິດເຂົ້າເຖິງໃຫ້ Chromium ໃນ <ph name="BEGIN_LINK" />ການຕັ້ງຄ່າລະບົບ<ph name="END_LINK" /></translation>
<translation id="5422859338435319909">ເພື່ອໄດ້ຮັບການອັບເດດ João Browser ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ Windows 10 ຫຼື ໃໝ່ກວ່ານັ້ນ. ຄອມພິວເຕີນີ້ກຳລັງນຳໃຊ້ Windows 7.</translation>
<translation id="7467949745582939695">ເລີ່ມເປີດໃຊ້ Chromium ໃໝ່ບໍ?</translation>
<translation id="7707324976708178089">ບໍ່ສາມາດຕິດຕັ້ງ João Browser ລຸ້ນດຽວກັບທີ່ກໍາລັງແລ່ນຢູ່ໃນປະຈຸບັນ​ໄດ້. ກະລຸນາປິດ João Browser ແລະລອງໃໝ່ອີກ.</translation>
<translation id="7510190804000607802">ການແຈ້ງເຕືອນ: ປະໂຫຍດສູງສຸດຈາກ Google ໃນກະເປົາຂອງທ່ານ</translation>
<translation id="751935028865900641">ເວັບໄຊອາດເຮັດວຽກຕາມທີ່ຄາດໄວ້. ທ່ານຈະອອກຈາກລະບົບຂອງເວັບໄຊສ່ວນໃຫຍ່ເມື່ອທ່ານປິດໜ້າຈໍ Chromium ທັງໝົດຍົກເວັ້ນບັນຊີ Google ຂອງທ່ານຫາກທ່ານເຂົ້າສູ່ລະບົບ Chromium.</translation>
<translation id="5325102834460669866">{0,plural, =1{João Browser ຈະເປີດຄືນໃໝ່ໃນ 1 ນາທີ}other{João Browser ຈະເປີດຄືນໃໝ່ໃນ # ນາທີ}}</translation>
<translation id="7565444033145385702">ເພື່ອປົກປ້ອງຂໍ້ມູນຂອງທ່ານ, ກະລຸນາອະນຸຍາດໃຫ້ Chromium ລຶບການອະນຸຍາດອອກຈາກເວັບໄຊທີ່ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້.</translation>
<translation id="8099958128052689767">ເປີດໃຊ້ João Browser ໂດຍອັດຕະໂນມັດເພື່ອເລີ່ມທ່ອງເວັບໄດ້ທັນທີ.</translation>
<translation id="7583399374488819119">ຕົວຕິດຕັ້ງ <ph name="COMPANY_NAME" /></translation>
<translation id="7125257608567714221">João Browser ກໍາລັງໃຊ້​ກ້ອງ​ຖ່າຍ​ຮູບ​ ແລະໄມໂຄຣໂຟນຂອງ​ທ່ານ​.</translation>
<translation id="227045421902171569">João Browser ​ດີກ​ວ່າແລ້ວ</translation>
<translation id="5356567285381070312">ຕອນນີ້ທ່ານມີຄຸນສົມບັດເພີ່ມເຕີມໃນ João Browser</translation>
<translation id="7624307931717240213">ພວກເຮົາໃຊ້ຂໍ້ມູນເພື່ອປັບປຸງບໍລິການນີ້. ເບິ່ງນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ ແລະ ຂໍ້ກຳນົດບໍລິການ.</translation>
<translation id="7649070708921625228">ຊ່ວຍ​ເຫຼືອ</translation>
<translation id="5714374331629713291">ດາວໂຫຼດແອັບ João Browser</translation>
<translation id="7658239707568436148">ຍົກ​ເລີກ​</translation>
<translation id="549378870470819535">João Browser ບໍ່ແມ່ນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="6574348346278803862">ຊິ້ງຂໍ້ມູນ ແລະ ປັບແຕ່ງ João Browser ໃຫ້ເປັນແບບສ່ວນຕົວໃນທົ່ວອຸປະກອນຂອງທ່ານ</translation>
<translation id="7699779824407626136">ການອັບເດດ Chromium</translation>
<translation id="3304080024230377341">ວຽກຂອງທ່ານປອດໄພໃນ João Browser</translation>
<translation id="7716950018788545737">ໜ້າວຽກສິ້ນສຸດແລ້ວ.</translation>
<translation id="77283119132245232">ໃຫ້ບໍລິການຕິດຕາມລະບົບສຳລັບ <ph name="BROWSER_NAME" />. ຫາກປິດການນຳໃຊ້ບໍລິການນີ້, ການຕິດຕາມປະສິດທິພາບທີ່ສ້າງຂຶ້ນໂດຍໂປຣແກຣມທ່ອງເວັບຈະບໍ່ຮວມກິດຈະກຳທົ່ວລະບົບ ເຊັ່ນ: ກິດຈະກຳປ່ຽນບໍລິບົດ ແລະ ກິດຈະກຳຫົວຂໍ້ທີ່ພ້ອມນຳໃຊ້.</translation>
<translation id="7745317241717453663">ນີ້ຈະລຶບຂໍ້ມູນການທ່ອງເວັບຂອງທ່ານອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຂອງທ່ານຄືນໃນພາຍຫຼັງ, ກະລຸນາເຂົ້າສູ່ລະບົບ Chromium ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">ຕົວຕິດຕັ້ງບໍ່ສາມາດສ້າງໄດເຣັກຕໍຣີຊົ່ວຄາວໄດ້. ກະລຸນາກວດເບິ່ງບ່ອນ​ວ່າງດິສກ໌ ແລະການອະນຸຍາດ ເພື່ອຕິດຕັ້ງຊອບແວ.</translation>
<translation id="4713120944298974980">ຊອກຫາໃນ João Browser</translation>
<translation id="5804390944809171853">ຣີເຊັດເປັນ João Browser ແບບຄ່າເລີ່ມຕົ້ນ</translation>
<translation id="6930487390575519812">ເພື່ອຮັກສາຄວາມປອດໄພໃຫ້ກັບວຽກຂອງທ່ານໃນ João Browser, ອົງກອນຂອງທ່ານຈະສາມາດເບິ່ງ ຫຼື ຈັດການຂໍ້ມູນບາງຢ່າງໄດ້ເມື່ອທ່ານເຂົ້າສູ່ລະບົບ João Browser.</translation>
<translation id="5214761769821670245">ຕັ້ງ João Browser ເປັນຄ່າເລີ່ມຕົ້ນ ແລະ ປັກໝຸດໄວ້ຢູ່ແຖບໜ້າວຽກ</translation>
<translation id="1294697217796985566">ເຮັດໃຫ້ João Browser ໄວຂຶ້ນ</translation>
<translation id="1278345486417353853"><ph name="PAGE_TITLE" /> - João Browser Canary</translation>
<translation id="7803986347287457849">ເຮັດໃຫ້ຜູ້ທີ່ມີສິດເຂົ້າເຖິງທຣາບຟິກອິນເຕີເນັດຂອງທ່ານເບິ່ງວ່າທ່ານເຂົ້າເບິ່ງເວັບໄຊໃດແດ່ໄດ້ຍາກຂຶ້ນ. Chromium ໃຊ້ການເຊື່ອມຕໍ່ທີ່ປອດໄພເພື່ອຊອກຫາທີ່ຢູ່ IP ຂອງເວັບໄຊໃນ DNS (ລະບົບຊື່ໂດເມນ).</translation>
<translation id="7810005234485217901">ທ່ານສາມາດປັກໝຸດການຊອກຫາຮູບເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ງ່າຍ</translation>
<translation id="6236248311946713296">ເລືອກສິ່ງທີ່ຈະແບ່ງປັນກັບ João Browser</translation>
<translation id="489728561211958943">ມີໂປຣໄຟລ໌ João Browser ກັບບັນຊີນີ້ຢູ່ອຸປະກອນນີ້ຢູ່ກ່ອນແລ້ວ</translation>
<translation id="7845233973568007926">ຂໍຂອບໃຈສຳລັບການຕິດຕັ້ງ. ທ່ານຈະຕ້ອງຣີສະຕາດຄອມພິວເຕີຂອງທ່ານກ່ອນການໃຊ້ <ph name="BUNDLE_NAME" />.</translation>
<translation id="5294768452950207882">ມີການປ່ຽນໂປຣແກຣມຊອກຫາຂອງທ່ານຈາກພາຍນອກ João Browser. ເພື່ອປົກປ້ອງທ່ານ, João Browser ໄດ້ຣີເຊັດໂປຣແກຣມດັ່ງກ່າວເປັນຄ່າເລີ່ມຕົ້ນເກົ່າ. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3244974069468656925">ປັບແຕ່ງ João Browser ເພື່ອໃຫ້ມີຮູບລັກໃໝ່</translation>
<translation id="7859018312476869945">ເມື່ອທ່ານພິມໃນແຖບທີ່ຢູ່ ຫຼື ກ່ອງຊອກຫາ, Chromium ຈະສົ່ງສິ່ງທີ່ທ່ານພິມໄປຫາໂປຣແກຣມຊອກຫາຄ່າເລີ່ມຕົ້ນຂອງທ່ານເພື່ອຮັບການແນະນຳທີ່ດີຍິ່ງຂຶ້ນ. ສິ່ງນີ້ຖືກປິດໃນໂໝດບໍ່ເປີດເຜີຍຕົວຕົນ.</translation>
<translation id="6517519572778941051">João Browser ບໍ່ສາມາດອັບເດດເປັນເວີຊັນຫຼ້າສຸດໄດ້, ສະນັ້ນທ່ານກຳລັງພາດຄຸນສົມບັດ ແລະ ການແກ້ໄຂດ້ານຄວາມປອດໄພໃໝ່ໆຢູ່.</translation>
<translation id="7872446069773932638">ກຳລັງດາວໂຫຼດ... ຍັງເຫຼືອ <ph name="SECONDS" /> ວິນາທີ</translation>
<translation id="7873537467422636035">ຫາກທ່ານລືມລະຫັດຜ່ານຂອງຕົນເອງ ຫຼື ຕ້ອງການປ່ຽນການຕັ້ງຄ່ານີ້, ໃຫ້ <ph name="BEGIN_LINK" />ລຶບຂໍ້ມູນ Chromium ໃນບັນຊີຂອງທ່ານ<ph name="END_LINK" /></translation>
<translation id="1722038268139386345">ເປີດ Gemini ໃນ João Browser ໄດ້ຢ່າງວ່ອງໄວທຸກເທື່ອທີ່ທ່ານຕ້ອງການ</translation>
<translation id="8344320926817290924">ຕັ້ງ João Browser ເປັນຄ່າເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="7934340546140346950">Chromium ອັບເກຣດການເຊື່ອມຕໍ່ທີ່ບໍ່ປອດໄພເປັນ HTTPS ໂດຍອັດຕະໂນມັດຫາກເປັນໄປໄດ້</translation>
<translation id="3755057387338907970">ທ່ານ​ໄດ້ລົງຊື່ເຂົ້າໃຊ້ João Browser ເປັນ <ph name="USER_EMAIL_ADDRESS" />. ກະ​ລຸ​ນາ​​ໃຊ້​ບັນ​ຊີ​ດຽວ​ກັນ​ ເພື່ອລົງຊື່ເຂົ້າໃຊ້ອີກ.</translation>
<translation id="929903348843569380"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຢູ່ອຸປະກອນທຸກເຄື່ອງຂອງທ່ານນຳ.</translation>
<translation id="7975919845073681630">ນີ້ແມ່ນການຕິດຕັ້ງສຳຮອງຂອງ Chromium ແລະ ບໍ່ສາມາດຖືກຕັ້ງເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນໄດ້.</translation>
<translation id="8905411496853397218">ສ່ວນຂະຫຍາຍ, ແອັບ ແລະ ຮູບແບບສີສັນຈາກແຫຼ່ງຂໍ້ມູນທີ່ບໍ່ຮູ້ຈັກອາດເປັນອັນຕະລາຍກັບອຸປະກອນຂອງທ່ານໄດ້. João Browser ແນະນຳໃຫ້ຕິດຕັ້ງພວກມັນຈາກ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ເທົ່ານັ້ນ</translation>
<translation id="6306672714476596428">ຮັບປະໂຫຍດສູງສຸດຈາກ Google ດ້ວຍແອັບ João Browser ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="8004582292198964060">ບຣາວ​ເຊີ</translation>
<translation id="8010081455002666927">ກວດຫາອັດຕະໂນມັດ</translation>
<translation id="2172829664765531568">ເມື່ອ João Browser ມີການເຂົ້າເຖິງ, ເວັບໄຊຈະສາມາດຮ້ອງຂໍການເຂົ້າເຖິງນຳທ່ານ.</translation>
<translation id="74641100973032765">ປັກໝຸດ João Browser ໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ຢ່າງວ່ອງໄວທຸກເວລາ</translation>
<translation id="80471789339884597">ຂໍຂອບໃຈສຳລັບການຕິດຕັ້ງ. ທ່ານຈະຕ້ອງຣີສະຕາດໂປຣແກຣມທ່ອງເວັບຂອງທ່ານທັງໝົດກ່ອນການໃຊ້ <ph name="BUNDLE_NAME" />.</translation>
<translation id="8054112667659782652">ສະແດງທາງລັດການຊອກຫາຮູບສະເໝີ</translation>
<translation id="8069447462453318634">ເລືອກ "ປັກໝຸດໄວ້ຢູ່ແຖບເຄື່ອງມື"</translation>
<translation id="5039671129725402518">ປິດການນຳໃຊ້ João Browser ທີ່ເຮັດວຽກໃນພື້ນຫຼັງສຳລັບແອັບ</translation>
<translation id="80790299200510644">ຊອກຫາຮູບ</translation>
<translation id="8086881907087796310">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກຄອມພິວເຕີຂອງທ່ານບໍ່ເປັນໄປຕາມຂໍ້ກຳນົດຂັ້ນຕ່ຳສຳລັບຮາດແວ.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome for Testing</translation>
<translation id="2430877582155731716">João Browser ຕ້ອງການການອະນຸຍາດສະຖານທີ່ສຳລັບເວັບໄຊນີ້</translation>
<translation id="8298045348217323">ເທື່ອຕໍ່ໄປທີ່ທ່ານເປີດ João Browser ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ, ທ່ານຈະເຫັນຂໍ້ຄວາມແຈ້ງໃຫ້ເປີດການນຳໃຊ້ການແຈ້ງເຕືອນການຕິດຕາມລາຄາ.</translation>
<translation id="3827347991254458074">ຮັບການແຈ້ງເຕືອນລາຄາຫຼຸດລົງສຳລັບສິນຄ້າທີ່ທ່ານສົນໃຈດ້ວຍແອັບ João Browser ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="8118331347066725040">ສົ່ງຄຳຕິຊົມສຳລັບການຊອກຫາດ້ວຍ Lens</translation>
<translation id="2580039965224265556">ປັບປ່ຽນ João Browser ໃນແບບຂອງທ່ານ</translation>
<translation id="8133124826068723441">ChromiumOS ບໍ່ສາມາດຊິ້ງຂໍ້ມູນຂອງທ່ານໄດ້ເນື່ອງຈາກການຊິ້ງຂໍ້ມູນບໍ່ສາມາດໃຊ້ໄດ້ສຳລັບໂດເມນຂອງທ່ານ.</translation>
<translation id="813913629614996137">ກຳລັງລິເລີ່ມ...</translation>
<translation id="7940955011992997426">ເປີດ Gemini ໃນ João Browser ດ້ວຍຄີລັດ.</translation>
<translation id="7560319627203819845">ຂໍ້ກຳນົດບໍລິການເພີ່ມເຕີມຂອງ João Browser</translation>
<translation id="7133741820744999589">ໄຟລ໌ນີ້ເປັນອັນຕະລາຍ, ສະນັ້ນ João Browser ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="8177472873527554730">ບໍ່ພົບເນື້ອຫາໃນໜ້າ</translation>
<translation id="8200109504272824693">ໃສ່ລະຫັດຜ່ານຂອງທ່ານເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Chromium ໃນບັນຊີຂອງທ່ານ, <ph name="USER_EMAIL" /></translation>
<translation id="820759916613250543">ຊອກຫາຮູບນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="8221491193165283816">ໂດຍປົກກະຕິແລ້ວທ່ານບລັອກການແຈ້ງເຕືອນ. ເພື່ອອະນຸຍາດໃຫ້ເວັບໄຊນີ້ແຈ້ງເຕືອນທ່ານ, ກະລຸນາຄລິກບ່ອນນີ້.</translation>
<translation id="8223363452568144035">ເພື່ອໃຊ້ກ້ອງຂອງທ່ານ, ກະລຸນາມອບສິດເຂົ້າເຖິງໃຫ້ Chromium ໃນ <ph name="BEGIN_LINK" />ການຕັ້ງຄ່າລະບົບ<ph name="END_LINK" /></translation>
<translation id="8132864687089402359">João Browser ບໍ່ສາມາດຢັ້ງຢືນໄດ້ວ່າສ່ວນຂະຫຍາຍນີ້ມາຈາກໃສ ແລະ ມັນອາດບໍ່ປອດໄພ. ລຶບສ່ວນຂະຫຍາຍດັ່ງກ່າວອອກຈາກ João Browser ເພື່ອບໍ່ໃຫ້ເບິ່ງ ແລະ ປ່ຽນຂໍ້ມູນຂອງທ່ານຢູ່ເວັບໄຊທີ່ທ່ານເຂົ້າເບິ່ງ, ເຊິ່ງຮວມເຖິງຂໍ້ມູນສ່ວນຕົວ.</translation>
<translation id="7600652022483599804">ຖ້າຮູບບໍ່ມີລາຍລະອຽດທີ່ເປັນປະໂຫຍດ, João Browser ຈະພະຍາຍາມໃຫ້ລາຍລະອຽດແກ່ທ່ານ. ເພື່ອສ້າງລາຍລະອຽດ, ລະບົບຈະສົ່ງຮູບພາບໃຫ້ Google. ທ່ານສາມາດປິດສິ່ງນີ້ໃນການຕັ້ງຄ່າໄດ້ທຸກເວລາ.</translation>
<translation id="8703735741562140394">ເຂົ້າສູ່ລະບົບ João Browser ໃນໂປຣໄຟລ໌ໃໝ່ບໍ?</translation>
<translation id="2830039647655087365"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" /> ນຳ.</translation>
<translation id="1802935470126307750">ສະແດງ Gemini ໃນ João Browser ໃນຖາດລະບົບ ແລະ ເປີດຄີລັດ</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Chromium ຈະເຕືອນທ່ານ<ph name="END_LINK" /> ກ່ຽວກັບເວັບໄຊ ແລະ ການດາວໂຫຼດທີ່ບໍ່ປອດໄພ</translation>
<translation id="8295827201165805317">ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. Chromium ໄດ້ລຶບສິດເຂົ້າເຖິງ <ph name="PERMISSION" /> ອອກແລ້ວ.</translation>
<translation id="481989138594406896">ເລືອກຊື້, ແປພາສາ ແລະ ລະບຸສິ່ງທີ່ທ່ານເຫັນດ້ວຍກ້ອງຂອງທ່ານຢູ່ແອັບ João Browser iOS</translation>
<translation id="5242426961520127942">ລະຫັດ QR ເພື່ອເຂົ້າສູ່ລະບົບ João Browser ໃນຊື່ <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">ຂໍ້ຜິດພາດໃນການເລີ່ມຕົ້ນ: <ph name="STARTUP_ERROR" />.</translation>
<translation id="3644336211313412429">ອົງກອນຂອງທ່ານປິດ João Browser ໄວ້ເມື່ອມັນບໍ່ໄດ້ຖືກນຳໃຊ້ເປັນເວລາ <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8321888067342493336">ບັນທຶກເປັນຮູບ</translation>
<translation id="3150519286474936594"><ph name="USER_EMAIL_ADDRESS" /> ເຄີຍໃຊ້ João Browser ໃນເມື່ອກ່ອນ</translation>
<translation id="8351551329754447960">ເປີດການນຳໃຊ້ທັກສະໃນ Chromium</translation>
<translation id="4566781614303801262">ອັບເດດ João Browser ເພື່ອສືບຕໍ່ນຳໃຊ້ຂໍ້ມູນ João Browser ໃນບັນຊີ Google ຂອງທ່ານ, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="8404636483124146663">ເພື່ອໄດ້ຮັບການອັບເດດ João Browser ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ Windows 10 ຫຼື ໃໝ່ກວ່ານັ້ນ. ຄອມພິວເຕີນີ້ກຳລັງນຳໃຊ້ Windows 8.</translation>
<translation id="8362914115861174987">ແປພາສາເປັນ</translation>
<translation id="8367705492654390392">ຖາມຫຍັງກໍໄດ້</translation>
<translation id="8370517070665726704">ລິຂະສິດ <ph name="YEAR" /> Google LLC. ສະຫງວນສິດທັງໝົດ.</translation>
<translation id="8954225380790220359">ເພື່ອຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ João Browser. ລະບົບຈະບັນທຶກລະຫັດຜ່ານນີ້ໄວ້ໃນບັນຊີ Google ຂອງທ່ານຫຼັງຈາກທີ່ທ່ານເຂົ້າສູ່ລະບົບ.</translation>
<translation id="208035402574338948">ຈາກນັ້ນທ່ານຈະຕ້ອງຣີສະຕາດ João Browser.</translation>
<translation id="7458698097055456629">João Browser ແນະນຳໃຫ້ທ່ານລຶບອອກ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບສ່ວນຂະຫຍາຍທີ່ຮອງຮັບ<ph name="END_LINK" /></translation>
<translation id="3428558977667883100">ນັກພັດທະນາຍົກເລີກການເຜີຍແຜ່ສ່ວນຂະຫຍາຍນີ້ແລ້ວ ແລະ ອາດບໍ່ປອດໄພ. ລຶບສ່ວນຂະຫຍາຍດັ່ງກ່າວອອກຈາກ João Browser ເພື່ອບໍ່ໃຫ້ເບິ່ງ ແລະ ປ່ຽນຂໍ້ມູນຂອງທ່ານຢູ່ເວັບໄຊທີ່ທ່ານເຂົ້າເບິ່ງ, ເຊິ່ງຮວມເຖິງຂໍ້ມູນສ່ວນຕົວຂອງທ່ານ.</translation>
<translation id="5012944467031125860">João Browser ຕ້ອງການຢັ້ງຢືນວ່າແມ່ນທ່ານກ່ອນຈະບັນທຶກຂໍ້ມູນບາງຢ່າງໃນບັນຊີ Google ຂອງທ່ານ ແລະ ໃຊ້ຢູ່ອຸປະກອນຂອງທ່ານທັງໝົດ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ຈະຖືກລຶບ.</translation>
<translation id="8822543678238892300">{0,plural, =1{ເປີດໃຊ້ João Browser ຄືນໃໝ່ພາຍໃນໜຶ່ງມື້}other{ເປີດໃຊ້ João Browser ຄືນໃໝ່ພາຍໃນ # ມື້}}</translation>
<translation id="8438543370129609977">ເມື່ອທ່ານໃຊ້ຄຸນສົມບັດຊອກຫາຮູບ, ລະບົບຈະສົ່ງຊື່ໜ້າ, URL ແລະ ເນື້ອຫາ, ຮວມທັງ PDF ໄປຫາເຊີບເວີ. <ph name="LEARN_MORE" /></translation>
<translation id="4307944272317199640">ສຶກສາເພີ່ມເຕີມກ່ຽວກັບການຊອກຫາດ້ວຍການຊອກຫາຮູບໃນ João Browser</translation>
<translation id="6024135746436350583">ຄັງຕົວຕິດຕັ້ງຖືກເສຍຫາຍ ຫຼືໃຊ້ບໍ່ໄດ້. ກະລຸນາດາວໂຫຼດ João Browser ອີກ.</translation>
<translation id="4933173390191738516">João Browser ຕ້ອງໃຊ້ Windows 10 ຂຶ້ນໄປ.</translation>
<translation id="8463672209299734063">ຕົວເລືອກເສີມ: ຊ່ວຍປັບປຸງຄຸນສົມບັດ ແລະ ປະສິດທິພາບຂອງ ChromiumOS ໂດຍການສົ່ງຂໍ້ມູນການວິນິໄສ ແລະ ການນຳໃຊ້ໄປໃຫ້ Google ໂດຍອັດຕະໂນມັດ.</translation>
<translation id="4499703930846496679">ເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ João Browser ໃນບັນຊີ Google ຂອງທ່ານ, ກະລຸນາຢັ້ງຢືນວ່າແມ່ນທ່ານ</translation>
<translation id="8482493977473846331">ສະແດງຂໍ້ຄວາມເພື່ອເຂົ້າສູ່ລະບົບຫາ Chromium</translation>
<translation id="2129903037617090425">João Browser ຫຼ້າສະໄໝແລ້ວ</translation>
<translation id="850264194101621529">ຂໍຂອບໃຈທີ່ເລືອກ Chromium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ!</translation>
<translation id="8522801943730206384">Chromium ສາມາດກວດເບິ່ງລະຫັດຜ່ານຂອງທ່ານເມື່ອທ່ານບັນທຶກພວກມັນໄວ້</translation>
<translation id="8525579356836940628">ຢຸດການຕິດຕັ້ງແລ້ວ</translation>
<translation id="2445505893586445499">ເຂົ້າເຖິງລະຫັດຜ່ານ, ແຖບ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ João Browser ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="8548787790260785208">ຮັບຄຳເຕືອນຫາກ Chromium ພົບໜຶ່ງໃນລະຫັດຜ່ານຂອງທ່ານໃນການລະເມີດຂໍ້ມູນສາທາລະນະ</translation>
<translation id="8555465886620020932">ບໍລິການຜິດພາດ: <ph name="SERVICE_ERROR" />.</translation>
<translation id="8871890913961794658">ຄຸນສົມບັດ ແລະ ສ່ວນຂະຫຍາຍບາງຢ່າງຂອງ João Browser ມາພ້ອມກັບທາງລັດ. ທ່ານສາມາດເລືອກທີ່ຈະເປີດໃຊ້ອີກຄັ້ງໄດ້.</translation>
<translation id="8556420416730706394">ທ່ານສາມາດປັກໝຸດການຊອກຫາຮູບເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ງ່າຍ; ໂດຍການຄລິກປຸ່ມປັກໝຸດຢູ່ເທິງສຸດຂອງແຜງຄວບຄຸມດ້ານຂ້າງ</translation>
<translation id="856656450041460113">ຊອກຫາລາຍການພາສາ</translation>
<translation id="9044172203094901282">ຫຼາຍອົງການຈັດການ João Browser</translation>
<translation id="8586442755830160949">ລິຂະສິດ <ph name="YEAR" /> ຜູ້ຂຽນ Chromium. ສະຫງວນສິດທັງໝົດ.</translation>
<translation id="8601359445272098721">ໃໝ່! ທ່ານສາມາດແປໄດ້ທັງຂໍ້ຄວາມ ແລະ ຮູບພາບຢູ່ໜ້າຈໍຂອງທ່ານໂດຍເລືອກປຸ່ມ "ແປໜ້າຈໍ"</translation>
<translation id="1071663705626404814">ກຳລັງເປີດໃຊ້ João Browser...</translation>
<translation id="8624541899164515475">ການຕັ້ງຄ່າ, ເປີດໃນແຖບໃໝ່.</translation>
<translation id="8648201657708811153">ບໍ່ສາມາດຕັ້ງ Google Chrome ສຳລັບການທົດສອບເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານໄດ້.</translation>
<translation id="5975137268566279898">ມັນຍັງຄວບຄຸມວ່າຈະໃຫ້ສະແດງໜ້າໃດຂຶ້ນ ເມື່ອທ່ານເລີ່ມຕົ້ນເປີດ João Browser ຫຼືຄົ້ນຫາຈາກ Omnibox.</translation>
<translation id="6358904712334248114">ນີ້​ແມ່ນ João Browser ຂອງ​ທ່ານ</translation>
<translation id="8712637175834984815">ເຂົ້າໃຈແລ້ວ</translation>
<translation id="5380190167074430719">ເຂົ້າສູ່ລະບົບ João Browser ບໍ?</translation>
<translation id="8747073452963259673">ມຸມຊ້າຍລຸ່ມຂອງພື້ນທີ່ຊອກຫາ: ຊ້າຍ <ph name="LEFT" />%, ລຸ່ມ <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: ຜູ້ເບິ່ງແຍງລະບົບເຄືອຂ່າຍຂອງທ່ານໃຊ້ນະໂຍບາຍລະດັບກຸ່ມເຊິ່ງປ້ອງກັນການຕິດຕັ້ງ: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">ແຈ້ງເຕືອນຂ້ອຍໃນພາຍຫຼັງ</translation>
<translation id="8871607387186266158">ແບ່ງປັນເອກະສານນີ້ກັບ Gemini ໃນ João Browser ເພື່ອຮັບພາບຮວມໂດຍຫຍໍ້ ແລະ ຖາມຄຳຖາມຕິດຕາມຜົນ</translation>
<translation id="3009329613270131861">ເຂົ້າສູ່ລະບົບ João Browser ບໍ?</translation>
<translation id="8823401858233292222">ຕັ້ງ Chromium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນ ແລະ ປັກໝຸດໄວ້ຢູ່ແຖບໜ້າວຽກ</translation>
<translation id="8826492472752484139">ຄລິກ “ຕົວຈັດການລະຫັດຜ່ານ”</translation>
<translation id="8833697763442816810">ລະບົບ ChromiumOS</translation>
<translation id="8852026904190808918">ລະບົບຈະໃຊ້ພາສານີ້ເພື່ອສະແດງເມນູ, ການຕັ້ງຄ່າ, ແຈ້ງເຕືອນ ແລະ ຂໍ້ຄວາມອື່ນໆໃນ Chromium</translation>
<translation id="8862326446509486874">ທ່ານບໍ່ມີສິດທິທີ່ເໝາະສົມສໍາລັບຕິດຕັ້ງ​ໃນລະດັບລະບົບ. ລອງແລ່ນຕົວຕິດຕັ້ງນີ້ອີກ​ໃນ​ຖານະ​ເປັນ​ຜູ້ຄວບຄຸມ.</translation>
<translation id="6821836710312478344">ເພີ່ມໂປຣໄຟລ໌ João Browser</translation>
<translation id="5139769635207740615">ChromiumOS ບໍ່ສາມາດບັນທຶກຂໍ້ມູນ João Browser ໃນບັນຊີ Google ຂອງທ່ານໄດ້ເນື່ອງຈາກເກີດຂໍ້ຜິດພາດໃນການເຂົ້າສູ່ລະບົບ</translation>
<translation id="6814613825007700341">ອົງກອນຂອງທ່ານກຳນົດໃຫ້ທ່ານເຂົ້າສູ່ລະບົບ João Browser</translation>
<translation id="1009831347869773172">João Browser ກໍາລັງພະຍາຍາມສະແດງລະຫັດຜ່ານ. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດອັນນີ້.</translation>
<translation id="690637523240192979">João Browser ບໍ່ແມ່ນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານອີກຕໍ່ໄປ. ຕັ້ງຄ່າ João Browser ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນບໍ?</translation>
<translation id="225046375773654931">ບໍ່ສາມາດອັບເດດ João Browser ໄດ້</translation>
<translation id="8944232836376404813">ການດຳເນີນການນີ້ຈະເຮັດສິ່ງຕໍ່ໄປນີ້
          <ph name="LINE_BREAKS" />
            • ຣີເຊັດໜ້າເລີ່ມຕົ້ນ, ໜ້າແຖບໃໝ່, ໂປຣແກຣມຊອກຫາ ແລະ ແຖບທີ່ປັກໝຸດແລ້ວຂອງທ່ານ
            <ph name="LINE_BREAK" />
            • ປິດການນຳໃຊ້ສ່ວນຂະຫຍາຍ
            <ph name="LINE_BREAK" />
            • ລຶບຄຸກກີ້ ແລະ ຂໍ້ມູນເວັບໄຊຊົ່ວຄາວອື່ນໆ
            <ph name="LINE_BREAKS" />
            ການດຳເນີນການນີ້ຈະບໍ່ມີຜົນກັບບຸກມາກ, ປະຫວັດ ແລະ ລະຫັດຜ່ານທີ່ບັນທຶກໄວ້.</translation>
<translation id="4349474976990059197">ໂລໂກ້ João Browser Enterprise</translation>
<translation id="3227699293368317033">ນຳຄວາມປອດໄພຂອງ Google ໄປໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ João Browser ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="6527164294507620103">ບໍ່ສາມາດເລີ່ມ João Browser ໄດ້ເນື່ອງຈາກມີບາງຢ່າງຜິດພາດເກີດຂຶ້ນເມື່ອເປີດໂປຣໄຟລ໌ຂອງທ່ານ. ລອງຣີສະຕາດ João Browser.</translation>
<translation id="6741767563284518125">ຈັດການໂປຣໄຟລ໌ João Browser</translation>
<translation id="3101491883380219087">ໃຊ້ແປ້ນພິມຂອງທ່ານເພື່ອນຳທາງລະຫວ່າງ Gemini ໃນ João Browser ແລະ ແຖບທີ່ເປີດຢູ່ຂອງທ່ານ.</translation>
<translation id="9018218886431812662">ສຳເລັດການຕິດຕັ້ງແລ້ວ</translation>
<translation id="3370247132646333337">ເພື່ອເຮັດໃຫ້ João Browser ປອດໄພຂຶ້ນ, ພວກເຮົາປິດໃຊ້ງານບາງສ່ວນການ​ຕໍ່​ເຂົ້າ​ຫາ ທີ່​ບໍ່​ໄດ້​ເຮັດ​ເປັນ​ລາຍ​ການ​ໄວ້​ຢູ່​ໃນ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ແລະ​ອາດ​ຈະ​ຖືກ​ເອົາ​ເພີ່ມ​ເຂົ້າ​ໂດຍ​ທີ່​ທ່ານ​ບໍ່​ຮູ້​ຈັກ.</translation>
<translation id="1940116386572548863">ລົງຊື່ເຂົ້າ​ໃຊ້ João Browser</translation>
<translation id="8381652653666868014">João Browser ບລັອກການດາວໂຫຼດນີ້ເພາະວ່າໄຟລ໌ທີ່ເກັບໄວ້ໃນແຟ້ມມີໄຟລ໌ອື່ນໆທີ່ອາດຈະເຊື່ອງເມົາແວໄວ້</translation>
<translation id="8374335201144490555">ຊິ້ງລະຫັດຜ່ານ, ບຸກມາກ ແລະ ປະຫວັດຂອງທ່ານໃນອຸປະກອນຕ່າງໆໄດ້ຢ່າງສົມບູນແບບ. ເຂົ້າເຖິງຄຸນສົມບັດທີ່ທ່ານຮູ້ຈັກ ແລະ ມັກໄດ້ຢ່າງງ່າຍດາຍໂດຍອັບເດດໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານເປັນ João Browser. ລະບົບຈະປັກໝຸດ João Browser ໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ຢ່າງວ່ອງໄວ.</translation>
<translation id="6176486087616698123">ໃຊ້ເຄື່ອງມື AI ທີ່ດີທີ່ສຸດຂອງ Google ດ້ວຍແອັບ João Browser ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="9062666675513499497">ເຂົ້າສູ່ລະບົບ Chromium ເມື່ອທ່ານເຂົ້າສູ່ລະບົບບໍລິການອື່ນໆຂອງ Google</translation>
<translation id="724802823738504651">João Browser ຖືກປິດໂດຍອັດຕະໂນມັດ</translation>
<translation id="2689333215784698609">João Browser ຫຼ້າສະໄໝແລ້ວ</translation>
<translation id="8049510467237146160">{0,plural, =1{João Browser ຈະເປີດຄືນໃໝ່ໃນໜຶ່ງຊົ່ວໂມງ}other{João Browser ຈະເປີດຄືນໃໝ່ໃນ # ຊົ່ວໂມງ}}</translation>
<translation id="9106236359747881194">ເລືອກຂໍ້ຄວາມທີ່ຈະຊອກຫາ</translation>
<translation id="8558551666630075184">ເພື່ອໄດ້ຮັບການອັບເດດ João Browser ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ Windows 10 ຫຼື ໃໝ່ກວ່ານັ້ນ. ຄອມພິວເຕີນີ້ກຳລັງນຳໃຊ້ Windows 8.1.</translation>
<translation id="1194819784870407331">ເປີດລິ້ງໃນແຖບ João Browser ໃໝ່</translation>
<translation id="911206726377975832">ລຶບຂໍ້ມູນການທ່ອງເນັດຂອງທ່ານນໍາບໍ?</translation>
<translation id="9134482777260927479">ຄວາມຊ່ວຍເຫຼືອໃນການເຮັດວຽກບ້ານ</translation>
<translation id="9148058034647219655">ອອກ</translation>
<translation id="548951409840319583">ສືບຕໍ່ຈາກບ່ອນທີ່ທ່ານຄ້າງໄວ້: João Browser ສາມາດກູ້ຄືນແຖບຂອງທ່ານໄດ້ທຸກຄັ້ງທີ່ທ່ານປິດເປີດໃໝ່. ເພື່ອເປີດໃຊ້ສິ່ງນີ້, ໃຫ້ໄປຫາ</translation>
<translation id="7614949510548815395">ຜູ້ເບິ່ງແຍງລະບົບໄດ້ກຳນົດຄ່າ João Browser ໃຫ້ເປີດໂປຣແກຣມທ່ອງເວັບສຳຮອງເພື່ອເຂົ້າເຖິງ <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="3441698750089879771">ເລີ່ມເປີດໃຊ້ໃໝ່ເພື່ອອັບເດດ &amp;João Browser</translation>
<translation id="369689859238510548">João Browser (mDNS-In)</translation>
<translation id="8336832914816665097">ຕັ້ງຄ່າ João Browser ໃນແບບຂອງທ່ານເອງ</translation>
<translation id="7698429329590050365">João Browser ອາດຈະບໍ່ເຮັດວຽກຢ່າງຖືກຕ້ອງ ເພາະວ່າມັນບໍ່ຖືກຮອງຮັບໃນ Windows XP ຫຼື Windows Vista ອີກຕໍ່ໄປ</translation>
<translation id="190261805571697214">ໃຊ້ຄຸນສົມບັດຄວາມປອດໄພທີ່ດີທີ່ສຸດຂອງ Google ໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍ João Browser.</translation>
<translation id="945522503751344254">ສົ່ງ​ຄໍາ​ຄິດ​​ເຫັນ</translation>
<translation id="5554799509799759090">ໃຜກຳລັງໃຊ້ João Browser)</translation>
<translation id="9153108844196984904">ໃຊ້ຄວາມປອດໄພຂັ້ນສູງສຸດຂອງ João Browser</translation>
<translation id="983803489796659991">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກເຊີບເວີອັບເດດບໍ່ມີຂໍ້ມູນ hash ໃດໆສຳລັບແອັບພລິເຄຊັນ.</translation>
<translation id="6230710687825107323">ໃຊ້ João Browser ໂດຍບໍ່ມີບັນຊີ</translation>
<translation id="985602178874221306">ຜູ້ຂຽນ Chromium</translation>
<translation id="989970834842471429">ເລືອກຂໍ້ຄວາມ ຫຼື ຮູບເພື່ອຊອກຫາດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="992780518932311116">ເພື່ອໃຊ້ສະຖານທີ່ຂອງທ່ານ, ກະລຸນາມອບສິດເຂົ້າເຖິງໃຫ້ Chromium ໃນ <ph name="BEGIN_LINK" />ການຕັ້ງຄ່າລະບົບ<ph name="END_LINK" /></translation>
</translationbundle>