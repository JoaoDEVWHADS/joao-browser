<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="mn">
<translation id="1026101648481255140">Үргэлжлүүлэн суулгах</translation>
<translation id="1029669172902658969">&amp;ChromiumOS-г шинэчлэхийн тулд дахин ачаална уу</translation>
<translation id="4711726241445951349">João Browser танд энэ өргөтгөлийг шалгахыг зөвлөж байна</translation>
<translation id="1042552502243217427">Сайт өөрийн хуудсан дээр холбооснуудыг нууцлалтайгаар урьдчилан ачаалахыг хүсэхэд Chromium Google-н серверүүдийг ашиглана. Энэ нь таны таниулбарыг урьдчилан ачаалсан сайтаас нуух ч Google ямар сайтуудыг урьдчилан ачаалдгийг мэдэж авна.</translation>
<translation id="1051793555070215510">Бидэнд энэ 1 минутын судалгааг бөглөж Нууцлалтай горимыг сайжруулахад тусална уу.</translation>
<translation id="1065672644894730302">Таны хүсэлтийг уншиж чадахгүй байна. 

Зарим үйлдлүүд нь боломжгүй байж магадгүй бөгөөд сонголтонд хийсэн өөрчлөлтүүд хадгалагдахгүй.</translation>
<translation id="3937976866851867994">Таны эцэг эх João Browser-н "Сайт, апп болон өргөтгөлүүдийн зөвшөөрөл"-ийг унтраасан байна</translation>
<translation id="8626021334348319355">João Browser-н тодорхой онцлог, өргөтгөлийг хайхын тулд хаяг оруулах хэсэгт товчлолыг нь сонгосон товчлуурт гарын товчийн хамт шивж оруулна уу</translation>
<translation id="9157778882771986870">João Browser таны нууц үгийг экспортлох хүсэлтэй байна. Үүнийг зөвшөөрч байгаа бол Windows-н нууц үгээ оруулна уу.</translation>
<translation id="112640046208448578">Зүйл болон газрыг таньж, текст хуулж эсвэл орчуулна. Таныг Зурган хайлтыг ашиглахад хуудасны дэлгэцийн агшныг сервер лүү илгээнэ. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium таны өгөгдмөл хөтөч</translation>
<translation id="1131805035311359397">Нууц үгнүүддээ өгөгдлийн зөрчил болон аюулгүй байдлын өөр асуудал байхгүй болохыг шалгахын тулд <ph name="BEGIN_LINK" />Chromium-д нэвтэрнэ үү<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">João Browser цэсийг товшино уу</translation>
<translation id="1157985233335035034">Саяхан сонгосон хэлнүүд</translation>
<translation id="1184145431117212167">Таны Windows-н хувилбарыг дэмждэггүй тул суулгаж чадсангүй.</translation>
<translation id="1185134272377778587">Chromium-ийн тухай</translation>
<translation id="667420476518265356">Утсан дээрээ João Browser-р үнэ мөшгөх мэдэгдэл аваарай</translation>
<translation id="1203500561924088507">Суулгасанд баярлалаа. Та <ph name="BUNDLE_NAME" />-г ашиглахаасаа өмнө хөтчөө дахин эхлүүлэх ёстой.</translation>
<translation id="1232234696885483911">Таныг Зурган хайлтыг нээхэд хуудасны гарчиг, URL болон PDF зэрэг контентыг сервер лүү автоматаар илгээнэ. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">Та нэвтэрсэн байхдаа João Browser-д Google Бүртгэлээсээ нууц үг болон бусад зүйлээ ашиглах боломжтой. Үүнийг өөрчлөхийн тулд “João Browser дахь таны бүртгэл” рүү очно уу.</translation>
<translation id="4866003137980530528">Mac-н цэсийн мөрд João Browser дахь Gemini-г харуулах</translation>
<translation id="2526294198551578217">João Browser дахь Gemini-д дэлгэцийн хэсгийг сонгохын тулд товчлуурын шууд холбоосыг ашиглана уу.</translation>
<translation id="7068536367561625920">Энэ табыг идэвхгүй үед João Browser-г хурдан байлгахын тулд санах ойг чөлөөлсөн. Та энэ сайтыг идэвхгүй болохоос үргэлж хасахаар сонгох боломжтой.</translation>
<translation id="3669854427836618143">Энэ файл аюултай тул João Browser энэ таталтыг блоклосон</translation>
<translation id="126567311906253476"><ph name="USER_EMAIL" />-р Gmail эсвэл YouTube зэрэг Google-н үйлчилгээнд нэвтрэх үед та тухайн бүртгэлээр Chromium-д автоматаар нэвтрэх боломжтой</translation>
<translation id="8094399825947986050">Утсан дээрээ João Browser-г аваарай</translation>
<translation id="1290883685122687410">Тохируулгын алдаа: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">João Browser-н шинэ профайлаа тохируулах</translation>
<translation id="7591029065989504977">João Browser дахь Gemini-р туршиж үзэх</translation>
<translation id="8408989583029959522">João Browser-д Bluetooth төхөөрөмжүүдийг судлахад&#32;
 Bluetooth-н хандалт шаардлагатай. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">Утсан дээрээ João Browser-д нэвтрэх</translation>
<translation id="1330562121671411446">Хэл илрүүлэх</translation>
<translation id="6026568602942276348">Мөн João Browser-с өгөгдөл устгах (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Бэхэлсэн! Та Зурган хайлтад самбар дээрх шинэ товчоос дахин хандах боломжтой</translation>
<translation id="1356661055722410047">Шинэ! Та дэлгэц дээрх текст, зургийн аль алиныг орчуулах боломжтой</translation>
<translation id="1383876407941801731">Хайлт</translation>
<translation id="5807085300679014096">Явж байх зуураа үргэлжлүүлэн үзэхийн тулд João Browser аппыг ашиглаарай</translation>
<translation id="141901961143729572">Бодол санаагаа хуваалц</translation>
<translation id="3736947618013031173">Цонхоо хуваалцахын тулд Системийн тохиргоонд João Browser-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү.</translation>
<translation id="1478370723027452770">Chrome for Testing-р тусламж авах</translation>
<translation id="1497802159252041924">Суулгалтын алдаа: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Энэ хуудсыг хамгаалагдсан байна</translation>
<translation id="4379865404970367448">João Browser-н таб хуваалцах</translation>
<translation id="4436275659297289591">João Browser-д нэвтрэх</translation>
<translation id="1547469039832541117">Тодруулсан ажлыг дуусгана.</translation>
<translation id="449712764049695153">João Browser-г бэхлэх</translation>
<translation id="1574377791422810894">Chromium-н аюулгүй байдлын хэрэгсэл</translation>
<translation id="5480232403718129394">João Browser таны Нууц үгний менежерийн өгөгдлийг устгахыг хүсэж байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{Шинэчлэлтийг хэрэгжүүлэхийн тулд João Browser-г дахин ачаалахыг таны администратор танаас шаардаж байна}=1{Шинэчлэлтийг хэрэгжүүлэхийн тулд João Browser-г дахин ачаалахыг таны администратор танаас шаардаж байна. Таны нууцлалтай цонхыг дахин нээхгүй.}other{Шинэчлэлтийг хэрэгжүүлэхийн тулд João Browser-г дахин ачаалахыг таны администратор танаас шаардаж байна. Таны # нууцлалтай цонхыг дахин нээхгүй.}}</translation>
<translation id="980976428162070137">Утсан дээрээ João Browser аппаар Google-н шилдэг зүйлсийг аваарай</translation>
<translation id="1625909126243026060">Chromium-н нууцлал болон аюулгүй байдлын үндсэн хяналтуудыг шалгана уу</translation>
<translation id="1640672724030957280">Татаж байна...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" /> <ph name="USER_EMAIL" />-р гишүүнчлэлийн эрхтэйгээр нэвтэрсэн. Бүртгэлийн цэсийг нээх</translation>
<translation id="1708414395296835197">Та мессеж, баримт бичиг болон бусад апп дахь холбоосон дээр товших бүрдээ Chromium-г ашиглах боломжтой. Үүнийг мөн таны ажлын хэсэгт бэхэлнэ.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" />-н нэмэлт эрхээр хангадаг.</translation>
<translation id="1722488837206509557">Энэ нь танд боломжтой төхөөрөмжүүд сонгож, тэдгээр төхөөрөмжид контент үзүүлэх боломжийг олгоно.</translation>
<translation id="6972087163510342335">João Browser удахгүй интернэтээр үзсэн өгөгдлийг устгана</translation>
<translation id="1736443181683099871">Chromium навигацуудыг HTTPS болгож сайжруулахаар оролдоно</translation>
<translation id="3879288383593333401">João Browser-н өгөгдлийг устгасан</translation>
<translation id="656496276885630888">João Browser-г <ph name="REMAINING_TIME" />-н дараа дахин эхлүүлнэ</translation>
<translation id="1749104137266986751">HTTPS боломжгүй үед Chromium танд сануулалгүйгээр аюултай холболт ашиглана</translation>
<translation id="1226290419185955779">João Browser-ыг арын орчинд ажиллуулах</translation>
<translation id="4231366995273072370">João Browser аюулгүй байдлыг нэмэгдүүлэхийн тулд бид <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ны жагсаалтад байхгүй бөгөөд танд мэдэгдэлгүйгээр нэмэгдсэн байж болзошгүй зарим өргөтгөлүүдийг идэвхгүй болгосон.</translation>
<translation id="1822049153969905781">João Browser-г ажлын хэсэгтээ бэхэлж, шуурхай хандахын тулд Windows-н мэдэгдэл дэх <ph name="BEGIN_BOLD" />Тийм<ph name="END_BOLD" /> дээр товшино уу</translation>
<translation id="1321831992638405531">João Browser-ыг дахин суулгах</translation>
<translation id="3386967202064865436">João Browser <ph name="AUTHENTICATION_PURPOSE" /> оролдож байна</translation>
<translation id="70054449700528483">Та дараагийн удаа <ph name="DEVICE_TYPE" /> дээрээ João Browser-г нээхдээ Google Нууц үгний менежерийг ашиглах сануулга харна.</translation>
<translation id="1838374766361614909">Хайлтыг арилгах</translation>
<translation id="5807096362853316123">Интернэтээр үзсэн өгөгдлөө Google Бүртгэлдээ үлдээж, зөвхөн энэ төхөөрөмжөөс устгахын тулд <ph name="BEGIN_LINK" />João Browser-с гарна уу<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">Явж байх зуураа шинэ табын бүлэг нээх эсвэл үүсгэхийн тулд утсан дээрээ João Browser-г татаарай.</translation>
<translation id="185970820835152459">Та нэвтэрсэн Google Бүртгэлүүдээ удирдах боломжтой. Таны Google Бүртгэлүүдийг Chromium хөтөч, Play Store, Gmail болон бусад дээр ашигладаг. Хэрэв та гэр бүлийн гишүүн зэрэг өөр хэн нэгний бүртгэлийг нэмэхийг хүсвэл оронд нь өөрийн <ph name="DEVICE_TYPE" />-д шинэ хүн нэмнэ үү. <ph name="LINK_BEGIN" />Нэмэлт мэдээлэл авах<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Зурган хайлтаар хайх</translation>
<translation id="65457771685016683"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд João Browser-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн <ph name="DEVICE" />-с хавчуурга болон бусад зүйлээ авна.</translation>
<translation id="1880677175115548835">Текст сонгох</translation>
<translation id="2634119629547215883">Та удирдлагатай бүртгэл рүү нэвтрэн орсноор түүний админд нь өөрийн João Browser-ын хувийн мэдээллийг удирдах эрхийг олгож байна гэсэн үг юм. Таны João Browser-ын мэдээлэл, аппликейшн, хайлтын жагсаалт, түүх, нууц үг болон бусад тохиргоонууд <ph name="USER_NAME" /> руу нэгдэх болно. Та энэ мэдээллийг Google-ийн Хяналтын самбарыг ашиглан устгаж болох хэдий ч энэ мэдээллийг өөр данс руу нэгтгэж чадахгүй. Та одоо байгаа João Browser-ын мэдээллийг тусад нь хадгалахын тулд шинэ хувийн мэдээлэл үүсгэж болно. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium саадгүй гүйлгэх, видеоны фреймийн хурд зэрэг арын үйл ажиллагаа болон визуал эффектийг хязгаарласнаар батарейн цэнэгийг хэмнэнэ. <ph name="BEGIN_LINK" />Эрчим хүч хэмнэгчийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">João Browser Шинэчлэгч үйлчилгээ</translation>
<translation id="1911763535808217981">Үүнийг унтрааснаар та Gmail зэрэг Google-н сайтуудад Chromium-д нэвтрэлгүйгээр нэвтэрч болно</translation>
<translation id="4037729269678342163">João Browser ажиллахгүй байна. Дахин эхлүүлэх үү?</translation>
<translation id="7563750688920581112">Танай байгууллага болох <ph name="MANAGER" /> таныг João Browser-д нэвтрэхийг шаардаж байна</translation>
<translation id="193439633299369377">Шинэчлэлтийг хэрэгжүүлэхийн тулд ChromiumOS-г дахин эхлүүлэх шаардлагатай.</translation>
<translation id="7099143775283792684">Файлын төрлийг ихэвчлэн татдаггүй бөгөөд энэ нь аюултай байж магадгүй тул João Browser энэ таталтыг блоклосон</translation>
<translation id="1953553007165777902">Татаж байна... <ph name="MINUTE" /> минут үлдсэн</translation>
<translation id="1966382378801805537">Chromium нь өгөгдмөл хөтчийг тодорхойлох эсвэл тохируулах боломжгүй</translation>
<translation id="197326043290947695">Зурган хайлтаар илүү ухаалгаар үзээрэй</translation>
<translation id="6185556991023272801">João Browser зарим файлыг яагаад блоклодог болохыг мэдэж авна уу, шинэ табд нээгдэнэ</translation>
<translation id="4053636705816895911">Таны João Browser программ хангамжийг хамгийн шинэ байлгана. Хэрэв энэ үйлчилгээг идэвхгүй болгосон эсвэл зогсоосон бол таны João Browser-н программ хангамж хамгийн шинэ байхгүй бөгөөд энэ нь аюулгүй байдлын гарч болзошгүй сул эмзэг байдлыг засах боломжгүй, мөн онцлогууд ажиллахгүй байж магадгүй гэсэн үг юм. Энэ үйлчилгээг ашигладаг João Browser-н программ хангамж байхгүй байхад энэ үйлчилгээ өөрийгөө устгана.</translation>
<translation id="2008474315282236005">Энэ нь төхөөрөмжөөс 1 зүйл устгана. Өгөгдлөө дараа сэргээхийн тулд Chromium-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="2018879682492276940">Суулгаж чадсангүй. Дахин оролдоно уу.</translation>
<translation id="2039417478970545937">Тохиргоо.</translation>
<translation id="2049376729098081731">Google-н үйлчилгээнүүдэд илүү хувийн болгосон туршлага авахын тулд Chromium-н түүхийг багтаах эсэхээ сонгоно уу</translation>
<translation id="6768767091114123654">Танд сайн нууц үг үүсгэх, хадгалах, автоматаар бөглөхөд туслахын тулд João Browser-д суурилуулсан. Хялбар хандахын тулд товчлолыг нэмээрэй.</translation>
<translation id="3571664229232252557">João Browser-д шинэ дүр төрх өгөхийн тулд Шинэ таб хуудсан дээрх João Browser-г тусгайлан өөрчлөх товчин дээр товшино уу</translation>
<translation id="4273287215573278663">Файл нь хуурамч бөгөөд таны төхөөрөмжид гэнэтийн өөрчлөлт хийж магадгүй тул João Browser энэ таталтыг блоклосон</translation>
<translation id="9063967192437499581">Та дараагийн удаа João Browser iOS-г нээхдээ <ph name="FEATURE_NAME" />-г туршиж үзэхийг сануулсан сануулга харна.</translation>
<translation id="8511569826706775962">Таны Google Бүртгэлдээ хадгалсан нууц үг болон João Browser-н бусад өгөгдлийг энэ төхөөрөмжөөс хасна. Тэдгээрийг João Browser-д дахин ашиглахын тулд буцаж нэвтэрнэ үү.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{João Browser-г 1 минутын турш ашиглаагүй үед танай байгууллага интернэтээр үзсэн өгөгдлийг автоматаар устгана. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно. Таны табууд нээлттэй хэвээр үлдэнэ.}other{João Browser-г # минутын турш ашиглаагүй үед танай байгууллага интернэтээр үзсэн өгөгдлийг автоматаар устгана. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно. Таны табууд нээлттэй хэвээр үлдэнэ.}}</translation>
<translation id="2125838419757773031">Хайх дэлгэцийн хэсэг сонгох</translation>
<translation id="2126108037660393668">Татсан файлын баталгаажуулалт амжилтгүй боллоо.</translation>
<translation id="2135919691573380097">Энэ сайтыг мэдээлэх</translation>
<translation id="2137162749895930932">Орчуулах дэлгэцийг хаах</translation>
<translation id="1308845716497059117">Сайт аюулгүй холболт ашиглахгүй байгаа бөгөөд файлыг оролдсон байж магадгүй тул João Browser энэ таталтыг блоклосон</translation>
<translation id="2170098639895543546">Хуудсан дээрх дурын зүйлийг сонгоно уу</translation>
<translation id="6705844023496387932">João Browser-г өөрчлөх</translation>
<translation id="2174917724755363426">Суулгаж дуусаагүй байна. Та цуцлахдаа итгэлтэй байна уу?</translation>
<translation id="7728290795259244895">João Browser - Сүлжээнд нэвтрэх - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Шалгалтын алдааг шинэчлэх: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">João Browser-с бүртгэл хасах</translation>
<translation id="4648870374540039667">João Browser аппыг ашиглан худалдан авалтын шилдэг хэрэгслүүдийг явж байх зуураа ашиглаарай</translation>
<translation id="2106116820042118250">iOS-т зориулсан João Browser дээрх Сайжруулсан аюулгүй хөтчийг ашиглан явж байх зуур илүү аюулгүй байгаарай</translation>
<translation id="2210682093923538346">Аюултай сайт. Chromium мэдэгдлүүдийг хассан.</translation>
<translation id="2236949375853147973">Миний үйл ажиллагаа</translation>
<translation id="118764235932893741">Хаяг болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд João Browser-д нэвтэрнэ үү. Таныг нэвтэрсний дараа энэ хаягийг Google Бүртгэлд тань хадгална.</translation>
<translation id="7254578863532089400">Хэрэв та компьютероо дундаа ашиглаж байгаа бол таны найз нөхөд, гэр бүл  тусдаа хайлт хийж,  өөрсдийн хүссэнээрээ João Browser-ыг тохируулж болно.</translation>
<translation id="22571759390241347">Chromium-н Ур чадвар</translation>
<translation id="2283803047247799269">Зурган хайлтаар энэ табаас хайх</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{João Browser таны хөтчийг удаашруулж буй табыг түр зогсоохыг зөвлөж байна}other{João Browser таны хөтчийг удаашруулж буй табуудыг түр зогсоохыг зөвлөж байна}}</translation>
<translation id="2307973900865360088">Суурилуулагчид байлгах</translation>
<translation id="2313870531055795960">URL-г Chromium-д хадгалсан аюултай сайтын жагсаалттай харьцуулж шалгадаг. Хэрэв сайт таны нууц үгийг хулгайлах гэж оролдвол эсвэл таныг аюултай файл татах үед Chromium нь хуудасны контентын зэрэг URL-г Аюулгүй хайлт руу мөн илгээж болзошгүй.</translation>
<translation id="2356070529366658676">Асуух</translation>
<translation id="2359808026110333948">Цааш</translation>
<translation id="3800730051093461113">"<ph name="EXTENSION_NAME" />" өргөтгөл таныг João Browser-д нэвтрэхийг хүсэж байна</translation>
<translation id="8758735062658446604">Аппуудын хувьд João Browser-г дэвсгэрт ажиллуулахыг идэвхгүй болгох</translation>
<translation id="2623595027619107207">Энэ өргөтгөлийг <ph name="USER_EMAIL_ADDRESS" />-р ашиглахын тулд João Browser-д нэвтэрнэ үү.</translation>
<translation id="2384373936468275798">Таны бүртгэлийн нэвтрэх дэлгэрэнгүй мэдээлэл хуучирсан тул ChromiumOS таны өгөгдлийг синк хийж чадсангүй.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{1 HID төхөөрөмжид нэг эсвэл түүнээс олон João Browser-н өргөтгөл хандаж байсан}=1{1 HID төхөөрөмжид нэг эсвэл түүнээс олон João Browser-н өргөтгөл хандаж байна}other{# HID төхөөрөмжид нэг эсвэл түүнээс олон João Browser-н өргөтгөл хандаж байна}}</translation>
<translation id="6254788431480237503">João Browser-д энэ сайтад зориулж камер болон микрофоны зөвшөөрөл шаардлагатай</translation>
<translation id="2403703063067034158">Эхлэхэд алдаа гарлаа: одоогоор тохируулгын өөр нэг инстанс ажиллаж байна. Дараа дахин оролдоно уу.</translation>
<translation id="3028975423343897358">Дурын аппаас холбоосыг João Browser-д нээж, хөтчийг ажлын хэсэгтээ хандах боломжтой байлгаарай</translation>
<translation id="579079006139156831">Шуурхай тойм авах, араас нь лавлах асуулт асуухаар энэ баримт бичгийг João Browser дахь Gemini-тай хуваалцахын тулд Хураангуйлах товчин дээр товшино уу</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Chromium-н хэрэгслийн<ph name="END_LINK" /> тусламжтайгаар та аюулгүй үзэх болон хяналтыг гартаа байлгах боломжтой</translation>
<translation id="7114471809991869757"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд João Browser-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн бүх төхөөрөмж дээрээ нууц үг болон бусад зүйлээ авна.</translation>
<translation id="2451727308784734061">Нууц үгний менежерт шуурхай очихын тулд товчлолоо ашиглана уу. Та товчлолоо компьютерын үндсэн нүүр эсвэл апп байршуулагч руугаа зөөх боломжтой.</translation>
<translation id="2709136733469807397">João Browser-г удахгүй хаана</translation>
<translation id="3652225684487279741">João Browser-д</translation>
<translation id="2485422356828889247">Устгах</translation>
<translation id="2513154137948333830">Дахин асаах шаардлагатай: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Зурган хайлтаар текст сонгоно уу</translation>
<translation id="1527474262707362156">João Browser одоо байгаа нууц үгнүүдийг солихоор оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="6480371226914552131">Файл татахын тулд João Browser-д сангийн хандалт шаардлагатай</translation>
<translation id="6318568902186985084">João Browser-ийн туслагч</translation>
<translation id="2575822587468774919">Зурган хайлтаар хайхыг хүссэн зүйлээ сонгоно уу</translation>
<translation id="4557210258834653476">Нууц үг болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд João Browser-д нэвтэрнэ үү</translation>
<translation id="1148164459654218834">João Browser-г татаж, Google Бүртгэлдээ нэвтрэхийн тулд утсаараа QR кодыг скан хийнэ үү.</translation>
<translation id="235892353478111963">João Browser-г үргэлжлүүлэн ашиглах</translation>
<translation id="259935314519650377">Татсан суулгагчийг завсрын санах ойд хадгалж чадсангүй. Алдаа: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Систем</translation>
<translation id="8471946631262724853">Танай байгууллага таны хавчуурга, түүх, нууц үг зэрэг интернэтээр үзсэн өгөгдлийг харж, удирдах боломжтой. Энэ нь João Browser-н бусад профайл дахь интернэтээр үзсэн өгөгдлийг харах боломжгүй</translation>
<translation id="2870759219964376597"><ph name="ACCOUNT_EMAIL" /> бүртгэлдээ João Browser-н өгөгдлөө ашиглах, хадгалахын тулд өөрийгөө мөн болохыг баталгаажуулна уу</translation>
<translation id="2955972712254986678">{COUNT,plural, =0{Дэвшилтэт хамгаалалт нь шинэчлэлтийг хэрэгжүүлэхийн тулд танаас João Browser-г дахин ачаалахыг шаарддаг}=1{Дэвшилтэт хамгаалалт нь шинэчлэлтийг хэрэгжүүлэхийн тулд танаас João Browser-г дахин ачаалахыг шаарддаг. Таны нууцлалтай цонх дахин нээгдэхгүй.}other{Дэвшилтэт хамгаалалт нь шинэчлэлтийг хэрэгжүүлэхийн тулд танаас João Browser-г дахин ачаалахыг шаарддаг. Таны нууцлалтай # цонх дахин нээгдэхгүй.}}</translation>
<translation id="8949462882238006192">João Browser-г эхлүүлэх</translation>
<translation id="4224214204752803768">Суулгалтын явцад үйлдлийн системийн алдаа гарлаа. João Browser-ыг дахин татаж авна уу.</translation>
<translation id="3141414135710372892">Хэрэв та төхөөрөмжийг дундаа ашигладаг бол найз нөхөд, гэр бүл тань хөтчөөр тусдаа үзэж, João Browser-г хүссэнээрээ тохируулах боломжтой</translation>
<translation id="8838607803339100223">João Browser-г жижгэрүүлсэн байсан ч төхөөрөмж дээрээ João Browser дахь Gemini-г ашиглахын тулд хялбархан хандаарай.</translation>
<translation id="1679364578146271696">João Browser таб</translation>
<translation id="2718390899429598676">Таны аюулгүй байдлыг сайжруулахын тулд Chromium таны өгөгдлийг шифрлэх болно.</translation>
<translation id="1874696651662237927">Google Бүртгэлээ João Browser-с хасахын тулд гарна уу</translation>
<translation id="6850669719663104304">Нууц үг, хавчуурга болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд João Browser-д нэвтэрнэ үү</translation>
<translation id="2738871930057338499">Интернэтэд холбогдох боломжгүй байна. HTTP 403 хориотой. Прокси тохируулгаа шалгана уу.</translation>
<translation id="2753623023919742414">Хайхын тулд товшино уу</translation>
<translation id="4193420110872590792">João Browser-г өгөгдмөл PDF үзэгчээрээ тохируулах</translation>
<translation id="6614401181366354261">Энэ өргөтгөл хортой программ агуулж байгаа бөгөөд аюултай байна. Үүнийг João Browser-с хассанаар энэ нь цаашид таны хувийн мэдээллийг оруулаад зочилсон сайтуудын тань өгөгдлийг харах болон өөрчлөх боломжгүй болно.</translation>
<translation id="2799223571221894425">Дахин эхлүүлэх</translation>
<translation id="6299858290790311689">Таны João Browser</translation>
<translation id="2816462166102338036">Зурган хайлтаар энэ видеог хай</translation>
<translation id="5896458971800337862">iOS дээрх João Browser-р камераараа бүтээгдэхүүн олж, үнийн бууралт болон илүү ихийг явж байх зуураа хянаарай.</translation>
<translation id="2841525013647267359">Дараах хэлээс орчуулах</translation>
<translation id="2846251086934905009">Суулгах үед алдаа гарлаа: Суулгагч дуусгаагүй. Суулгалтыг тасалсан.</translation>
<translation id="4357241592510111611">João Browser-аас устгах ...</translation>
<translation id="2850691299438350830">Таныг нэвтэрсэн үед Chromium дээр таны аюулгүй байдлыг хангадаг бөгөөд Google-н бусад апп дахь таны аюулгүй байдлыг сайжруулахын тулд ашиглаж болзошгүй</translation>
<translation id="2885378588091291677">Асуудлын менежер</translation>
<translation id="8887040619780090085">João Browser-ын тухай</translation>
<translation id="2915996080311180594">Дараа дахин эхлүүлэх</translation>
<translation id="6619708652934279502">Таны өгөгдлийг нэвтрэх үгээр тань шифрлэдэг. Google Бүртгэлдээ João Browser-н өгөгдлөө ашиглах, хадгалахын тулд нэвтрэх үгээ оруулна уу.</translation>
<translation id="2945997411976714835">Суулгах үед алдаа гарлаа: Суулгагч явцыг эхлүүлж чадсангүй.</translation>
<translation id="4566114009566397386">iOS-т зориулсан João Browser-д хадгалсан нууц үгээ ашиглан сайтад илүү хурдан нэвтрээрэй</translation>
<translation id="562175540137901632">Танай байгууллага João Browser-г удирддаг</translation>
<translation id="2977470724722393594">Chromium-г шинэчилсэн байна</translation>
<translation id="2977506796191543575">Хэрэв сайт таны нууц үгийг хулгайлахаар оролдох эсвэл таныг аюултай файл татах үед Chromium URL-г хуудасны бага зэрэг контентын хамт Аюулгүй үзэх рүү мөн илгээж болзошгүй</translation>
<translation id="1776205510657237623">Эцэг эхийнхээ сонголтуудаар онлайн орчинд илүү аюулгүй байхын тулд João Browser-д нэвтэрнэ үү</translation>
<translation id="3003694935412297923">Бүх ажил</translation>
<translation id="3374694374267805392">{count,plural, =1{Зарим өгөгдлийг таны Google Бүртгэлд хадгалж, бүх төхөөрөмж дээр тань ашиглах боломжтой болохын өмнө João Browser таныг мөн болохыг баталгаажуулах шаардлагатай байна. Хэрэв та одоо гарвал энэ өгөгдлийг (1 зүйл) устгана.}other{Зарим өгөгдлийг таны Google Бүртгэлд хадгалж, бүх төхөөрөмж дээр тань ашиглах боломжтой болохын өмнө João Browser таныг мөн болохыг баталгаажуулах шаардлагатай байна. Хэрэв та одоо гарвал энэ өгөгдлийг ({count} зүйл) устгана.}}</translation>
<translation id="4915792193596835645"><ph name="URL" />-г João Browser-д шинэ табд нээнэ үү.</translation>
<translation id="302551344979399011">Ур чадвар зэрэг ХОУ-ы инновацыг таны Google Бүртгэлд хадгалж, Chromium Синкээс тусад нь удирддаг</translation>
<translation id="8367114375553489372">João Browser-д өгөгдөл нэмэх нь ...</translation>
<translation id="3038232873781883849">Суулгахыг хүлээж байна...</translation>
<translation id="3045032126857188731">Орчуулсан хэл: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Санал хүсэлтийн харилцах цонхыг хаах</translation>
<translation id="6168172692486433600">João Browser-н бусад профайл</translation>
<translation id="884929993636327">Өргөтгөл нь танд João Browser-г тусгайлан өөрчлөх боломжийг олгодог нэмэлт юм. Цэгцтэй байхаас эхлээд өдөр тутмын ажлыг хялбаршуулах хүртэл өргөтгөл танд João Browser-г өөрийн болгоход тусалдаг.</translation>
<translation id="1525897524206034002">Алдаа ослын тайлан болон <ph name="UMA_LINK" />-ыг Google рүү илгээх замаар João Browser-ыг улам сайжруулахад тусална уу.</translation>
<translation id="2766971658743453990">Google-н аюулгүй байдлын онцлогуудыг явж байх зуураа авахын тулд João Browser аппыг ашиглаарай</translation>
<translation id="4387884830246074210">{NUM_DEVICES,plural, =0{1 USB төхөөрөмжид нэг эсвэл түүнээс олон João Browser-н өргөтгөл хандаж байсан}=1{1 USB төхөөрөмжид нэг эсвэл түүнээс олон João Browser-н өргөтгөл хандаж байна}other{# USB төхөөрөмжид нэг эсвэл түүнээс олон João Browser-н өргөтгөл хандаж байна}}</translation>
<translation id="3413144813287436446">João Browser-н түүх</translation>
<translation id="9192419056064225629">Програм суулгагч нь архивыг задалж үл чадсан тул João Browser-г дахин татаж авна уу.</translation>
<translation id="310459126943037700">Ажил(ууд)-ыг дуусгаж чадсангүй.</translation>
<translation id="3104828284009500087">Хуудсан дээрх аливаа зүйлийг хайна уу</translation>
<translation id="3508468328135806512">Нууц үг, хавчуурга, түүхээ төхөөрөмжүүд дээр төгс синк хийсэн байлгаарай. Та өгөгдмөл хөтчөө João Browser болгон шинэчилж мэддэг, дуртай онцлогууддаа хялбархан хандаарай.</translation>
<translation id="3216151988142306917">João Browser нь таны микрофоныг ашиглаж байна.</translation>
<translation id="3130333203120345554">Шинэ хайлт</translation>
<translation id="3137969841538672700">Хайхын тулд чирнэ үү</translation>
<translation id="7493177208577109722">Энэ таб нэмэлт нөөц ашиглаж байна. Гүйцэтгэлээ сайжруулахын тулд João Browser-д энэ табыг идэвхгүй болгохыг зөвшөөрнө үү.</translation>
<translation id="7239354789967255675">Дэлгэцээ хуваалцахын тулд Системийн тохиргоонд João Browser-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү</translation>
<translation id="4955872590603594814">João Browser-г дахин эхлүүлэх</translation>
<translation id="3161522574479303604">Бүх хэл</translation>
<translation id="4697739132113629685">Холбоосыг João Browser-н нууцлалтай цонхонд нээх</translation>
<translation id="1629247860984475766">João Browser-н шинэ профайлаа тохируулна уу</translation>
<translation id="1905008150929775692">Та таб сэлгэхгүйгээр ХОУ-ы горимтой үргэлжлүүлэн чатлах боломжтой. Эхлүүлэхийн тулд João Browser-д нэвтэрнэ үү. Та мөн бүх төхөөрөмж дээрээ нууц үг болон бусад зүйлээ авна.</translation>
<translation id="4232381420311815141">Google Бүртгэлээ João Browser-с хасахын тулд Тохиргооны хуудсанд João Browser-с гарна уу</translation>
<translation id="3234316605225071811">Дараа нь Chromium танаас хадгалсан мэдээллийг танд зориулж маягтыг автоматаар бөглөхөд ашигламаар байгаа эсэхийг асууж болно</translation>
<translation id="6676749542734993844">João Browser нь өөрийн өгөгдлийн сан руу уншуулж бас бичиж чадахгүй байна: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">iOS дээрх João Browser-р Google-н ХОУ-ы дуртай хэрэгслүүдээ явж байх зуураа ашиглаарай.</translation>
<translation id="3286538390144397061">Одоо дахин эхлүүлнэ үү</translation>
<translation id="532528773927600103">Google-ийн API түлхүүр байхгүй байна. João Browser-ийн зарим функц идэвхгүй болно.</translation>
<translation id="3296368748942286671">Chromium-ийг хаахад ард байгаа програмуудыг ажиллуулсан хэвээр бай.</translation>
<translation id="3313189106987092621">Chromium аюултай холболт ашиглан аливаа сайтыг ачаалахаас өмнө танд сануулна</translation>
<translation id="8095477191923518137">Хэрэв та João Browser-д нэвтэрсэн бол таныг João Browser-н бүх цонхыг хаах үед Google Бүртгэлээс тань бусад ихэнх сайтаас гаргана. Сайтад таныг санахыг зөвшөөрөхийн тулд <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">хайлтын хэсгийн баруун дээд булан: баруун <ph name="RIGHT" />%, дээд <ph name="TOP" />%</translation>
<translation id="3366305173356742781">Таны бүртгэлийн Chromium-н өгөгдөл</translation>
<translation id="3234882977104294240">Утсан дээрээ João Browser-р нууц үгнүүдээ ашиглах</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="2974199599420431595">João Browser-н одоо байгаа профайл руу сэлгэх үү?</translation>
<translation id="3412460710772753638">Энэ төхөөрөмж дээрх Нууц үгний менежерт</translation>
<translation id="3438772217992559640">Зурган хайлтаар энэ табаас хайх</translation>
<translation id="8318147705317768982">Утсан дээрээ João Browser-р Сайжруулсан аюулгүй хөтчийг өргөтгөх</translation>
<translation id="347392028839310978">João Browser-г өөрийн болгоорой...</translation>
<translation id="3474745554856756813">Энэ нь төхөөрөмжөөс <ph name="ITEMS_COUNT" /> зүйл устгана. Өгөгдлөө дараа сэргээхийн тулд Chromium-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="5805833167703404998"><ph name="SHORTCUT" /> João Browser-н профайлууд хооронд сэлгэх боломжтой</translation>
<translation id="1835124883585653877">João Browser-н бүх цонхыг хаасны дараагаар дахин хандана уу.</translation>
<translation id="7106246566966568195">Цонхоо хуваалцахын тулд Системийн тохиргоонд João Browser-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү</translation>
<translation id="6017005873246021363"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна.  Хөтчийн үзэлтээ тусдаа байлгахын тулд João Browser-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү.</translation>
<translation id="1146681170626381319">Хөдөлгөөнт төхөөрөмж дээр João Browser хөтчийг татах QR код</translation>
<translation id="354621070532799440">Сануулагч: Google-н аюулгүй байдлын шилдэг онцлогууд таны халаасанд байна</translation>
<translation id="2488701737291439763">Дэлгэцээ хуваалцахын тулд Системийн тохиргоонд João Browser-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү.</translation>
<translation id="3588112919289558122">Сайжруулсан хамгаалалт нь Chromium-н танихгүй сайтуудын JavaScript-н оновчлолыг унтраадаг</translation>
<translation id="3597003331831379823">Нэмэлт эрхтэйгээр тохируулгыг ажиллуулж чадсангүй. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">João Browser-д нэвтрэх</translation>
<translation id="5985252758124395804">Энэ хэрэглэгчийн хөтчийн өгөгдлийг энэ төхөөрөмжөөс устгана. Өгөгдлийг сэргээхийн тулд João Browser-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{João Browser-н шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалах үед түүнийг хэрэгжүүлэх болно.}=1{João Browser-н шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалах үед түүнийг хэрэгжүүлэх болно. Таны нууцлалтай цонхыг дахин нээхгүй.}other{João Browser-н шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалах үед түүнийг хэрэгжүүлэх болно. Таны # нууцлалтай цонхыг дахин нээхгүй.}}</translation>
<translation id="3667616615096815454">Суулгах боломжгүй. Аппликэйшнийг сервер танихгүй байна.</translation>
<translation id="3675854891107786059">Google Бүртгэлийнхээ Chromium-н бүх өгөгдлийг шифрлэхийн тулд <ph name="BEGIN_LINK" />өөрийн нэвтрэх үгийг<ph name="END_LINK" /> ашиглана уу. Google Pay-н төлбөрийн хэрэгсэл, хаягийг шифрлэхгүй. Chromium-н хөтчийн түүхийг синк хийхгүй.</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{Энэ шинэчлэлтийг хэрэгжүүлэхийн тулд João Browser-г дахин ачаалахыг таны администратор танаас хүсэж байна}=1{Энэ шинэчлэлтийг хэрэгжүүлэхийн тулд João Browser-г дахин ачаалахыг таны администратор танаас хүсэж байна. Таны нууцлалтай цонхыг дахин нээхгүй.}other{Энэ шинэчлэлтийг хэрэгжүүлэхийн тулд João Browser-г дахин ачаалахыг таны администратор танаас хүсэж байна. Таны # нууцлалтай цонхыг дахин нээхгүй.}}</translation>
<translation id="4134769722455445399">Холбоосыг шинэ João Browser болон табад нээх</translation>
<translation id="3728124580182886854">Хувийн болгох болон бусад зорилгоор Chromium болон Google-н бусад үйлчилгээг холбоно уу</translation>
<translation id="3729187154190517324">"Таб болон бусад зүйл нэмэх" товчийг ашиглан олон таб, файл, хэрэгсэл нэмж хайлтаа гүнзгийрүүлээрэй.</translation>
<translation id="655691042235349825">João Browser-н профайлуудыг удирдах</translation>
<translation id="8494798931804571569">João Browser зарим татаж авсан файлыг яагаад блоклодог болохыг мэдэж авах</translation>
<translation id="379589255253486813">Та ямар нэг зүйлийг шалгах шаардлагатай бол Chromium танд мэдэгдэнэ</translation>
<translation id="3802055581630249637">Chromium таны зочлох магадлалтай хуудаснуудыг урьдчилан ачаалах бөгөөд ингэснээр тэдгээр нь таныг зочлох үед илүү хурдан ачаална</translation>
<translation id="3810973564298564668">удирдах</translation>
<translation id="6945066279282141856">Хадгалсан нууц үгнүүдээ ашиглахын тулд QR кодыг уншуулаад, iOS-т зориулсан João Browser-г татаж, Google Бүртгэлдээ нэвтэрнэ үү</translation>
<translation id="3846683726093018685">**Хураангуйлах:** 30-аас цөөн үгтэй нэг өгүүлбэрээр дэлгэцийн агшны агуулгын үндсэн сэдэв, зорилгыг тайлбарлана уу.

          **Асуулт санал болгох:** Хэрэглэгч дэлгэцийн агшныг илүү сайн ойлгохын тулд асууж болох 3-5 бодлогошруулах асуултын жагсаалтын тэмдэгтэй жагсаалт (bulleted list) үүсгэнэ үү. Эдгээр асуултын дор хаяж нэг нь визуал объект, үүний дизайн, байршлын талаарх тодорхой асуулт байх ёстой.</translation>
<translation id="4996569675441627032"><ph name="PAGE_TITLE" /> - João Browser</translation>
<translation id="6008740052107737825">João Browser-д энэ сайтын хувьд дотоод сүлжээний зөвшөөрөл шаардлагатай</translation>
<translation id="3885770153807205175">Хэл сонгогч</translation>
<translation id="2390004682597453662">João Browser-г өөрчилж, хянана уу. Та ямар нэг зүйлд анхаарлаа хандуулах шаардлагатай байна. Дэлгэрэнгүй мэдээлэл авахын тулд товшино уу.</translation>
<translation id="8262407643678629134">João Browser-г нээх мөн хөтөчийг ашиглаж эхлэхийн тулд өөрийн нэр дээр дарна уу.</translation>
<translation id="3892148308691398805">Текстийг хуулах</translation>
<translation id="2168201717554927204"><ph name="EXISTING_USER" /> João Browser-н энэ профайлд аль хэдийн нэвтэрсэн байна. Таны хөтчийн үзэлтийг тусад нь байлгахын тулд João Browser танд өөрийн гэсэн профайл үүсгэж өгөх боломжтой.</translation>
<translation id="1046732460303790107">Энэ өргөтгөл Chrome Веб Дэлгүүрийн бодлогыг зөрчиж байгаа бөгөөд аюултай байж магадгүй. Үүнийг João Browser-с хассанаар энэ нь цаашид таны хувийн мэдээллийг оруулаад зочилсон сайтуудын тань өгөгдлийг харах болон өөрчлөх боломжгүй болно.</translation>
<translation id="3941890832296813527">Суулгах үед алдаа гарлаа: Суулгагчийн файлын нэр буруу эсвэл дэмжигдээгүй.</translation>
<translation id="3879366121647289622">João Browser нь нууц үгс хуулахыг оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="7332365758981378072">Таны Google Бүртгэлдээ хадгалсан нууц үг, төлбөрийн хэрэгсэл, хаягуудыг энэ төхөөрөмжөөс хасна. Тэдгээрийг João Browser-д дахин ашиглахын тулд буцаж нэвтэрнэ үү.</translation>
<translation id="395904275706073188">Хамгаалагдсан хуудсыг унших боломжгүй. Өөр хуудас туршиж үзнэ үү.</translation>
<translation id="3962647064319009959">Chromium таныг хэрхэн аюулгүй байлгадаг болохыг мэдэж авна уу</translation>
<translation id="3967822245660637423">Татаж авч дууслаа</translation>
<translation id="3971865010372729242">Таныг хаяг оруулах хэсэг, хайх хэсэгт шивэх үед Chromium зөвлөмж авахын тулд таны шивсэн зүйлийг танай байгууллагын хайлт, ХОУ, агентын хэрэгслүүд рүү илгээдэг.</translation>
<translation id="3975724895399328945">&amp;Google Chrome for Testing-н тухай</translation>
<translation id="3997429360543082038">ChromiumOS-н тухай</translation>
<translation id="4010059961270896984">Таныг сайтад зочлоход Chromium таны IP хаягийг нуудаг нууцлалын серверээр дамжуулан URL-н будилуулсан хэсгийг <ph name="BEGIN_LINK" />Google-н аюулгүй хөтөч<ph name="END_LINK" /> рүү илгээнэ. Хэрэв сайт ямар нэг сэжигтэй зүйл хийвэл бүтэн URL, хуудасны контентын багахан хэсгийг мөн илгээнэ.</translation>
<translation id="4016217212818346953">Нууц үгний менежерээр аюулгүй байгаарай</translation>
<translation id="4019629340646866719">ChromiumOS-г <ph name="BEGIN_LINK_LINUX_OSS" />Linux-н хөгжүүлэлтийн орчин <ph name="END_LINK_LINUX_OSS" /> болох нэмэлт <ph name="BEGIN_LINK_CROS_OSS" />нээлттэй эх кодын программ хангамжаар<ph name="END_LINK_CROS_OSS" /> боломжтой болгосон.</translation>
<translation id="4022972681110646219">Дэлгэцийг орчуулах</translation>
<translation id="4023601594785368013">Эх хэл: <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">Дурын аппаас холбоосыг João Browser-д нээнэ үү. Түүнчлэн хялбар хандахад зориулж үүнийг таны ажлын хэсэгт бэхэлдэг.</translation>
<translation id="4036079820698952681"><ph name="BEGIN_LINK" />Одоогийн тохиргоог<ph name="END_LINK" /> мэдэгдэж Chromium-г сайжруулахад тусална уу</translation>
<translation id="4050175100176540509">Хамгийн сүүлийн хувилбар дээр аюулгүй байдлын чухал сайжруулалт болон шинэ функцийг санал болгож байна.</translation>
<translation id="4055805654398742145">Нууц үгний менежер</translation>
<translation id="615818333141511791">{COUNT,plural, =1{João Browser-г 1 минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана. Интернэтээр үзсэн өгөгдлийг устгадаг. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.}other{João Browser-г # минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана. Интернэтээр үзсэн өгөгдлийг устгадаг. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.}}</translation>
<translation id="4118474109249235144">Chromium-н нууцлалын горим</translation>
<translation id="4122186850977583290">Chromium-н тухай хуудас руу очно уу</translation>
<translation id="9207280419664362385">Хөтчидөө шинэ дүр төрх өгөхийн тулд João Browser-г тусгайлан өөрчилнө үү</translation>
<translation id="3719803995198923598">João Browser-аа тусгайлан өөрчлөх</translation>
<translation id="4148957013307229264">Суулгаж байна...</translation>
<translation id="2954462321765112214"><ph name="PAGE_TITLE" /> - Сүлжээнд нэвтрэх - João Browser</translation>
<translation id="7812363663832111420">João Browser-д зориулсан гайхалтай апп, тоглоом, өргөтгөл болон дэлгэцийн зургуудыг олж сонирхоорой.</translation>
<translation id="69200600645763018">Энэ өргөтгөл болон илүү ихийг бүх компьютер дээрээ авахын тулд João Browser-д нэвтэрнэ үү</translation>
<translation id="7505863944027312744">Эцэг эхийнхээ сонголтуудаар онлайн орчинд илүү аюулгүй байхын тулд та <ph name="USER_EMAIL_ADDRESS" />-р хэдийн нэвтэрсэн João Browser профайл руугаа сэлгэнэ үү</translation>
<translation id="4222932583846282852">Цуцалж байна...</translation>
<translation id="4224210481850767180">Суулгах үйлдлийг цуцалсан.</translation>
<translation id="8090594705972340646">Та өөрийн João Browser өгөгдлийг энэ хаягтай холбох хүсэлтэй байна уу?</translation>
<translation id="4251772536351901305">Стандарт хамгаалалтаас илүүтэйгээр сайтуудын бусад өгөгдлийг задлан шинжилснээр танд аюултай сайтуудын талаар сануулах бөгөөд эдгээрт Google-н өмнө нь мэдээгүй сайт ч багтана. Та Chromium-н сануулгыг алгасахаар сонгох боломжтой.</translation>
<translation id="5696119579094527589">João Browser-с гарах</translation>
<translation id="4271805377592243930">Chromium-с тусламж авах</translation>
<translation id="4281844954008187215">Үйлчилгээний нөхцөл</translation>
<translation id="1245307320228150348">Гэнэтийн асуудлаас болж суулгах ажиллагаа амжилтгүй боллоо. Хэрвээ João Browser яг одоо ажиллаж байгаа бол хаагаад дахин оролдож үзнэ үү.</translation>
<translation id="7405356088321579627">João Browser-с нууц үг экспортлох</translation>
<translation id="4304713468139749426">Нууц үгний менежер</translation>
<translation id="4334241893986177674">Энэ дэлгэцийн агшнаас хайх</translation>
<translation id="212570256141568951">Windows-г эхлэх үед João Browser-г эхлүүлэх</translation>
<translation id="4400772909124543403">Шинэчлэлт боломжгүй байна</translation>
<translation id="7463042547966071103">Ямар ч байсан João Browser-с гарах уу?</translation>
<translation id="4413205837991854510">Зурган хайлтын товчлолыг үргэлж харуулах</translation>
<translation id="4736206301215400753">João Browser-г цаана ажиллуулахыг зөвшөөрөх</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{João Browser танд үүнийг хасахыг зөвлөж байна. <ph name="BEGIN_LINK" />Дэмжигдсэн өргөтгөлийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK" />}other{João Browser танд эдгээрийг хасахыг зөвлөж байна. <ph name="BEGIN_LINK" />Дэмжигдсэн өргөтгөлийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK" />}}</translation>
<translation id="5305058100936019600">João Browser-ыг гүйцэтгэх ба хянах</translation>
<translation id="4427306783828095590">Сайжруулсан хамгаалалт нь фишинг болон хортой кодыг блоклохын тулд илүү ихийг хийдэг</translation>
<translation id="4434353761996769206">Суулгагчийн алдаа: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3461955321878243607"><ph name="MANAGER" /> João Browser-г удирддаг</translation>
<translation id="3379477508903866078">João Browser-н профайл нэмэх</translation>
<translation id="4447409407328223819">Chrome for Testing-н тухай</translation>
<translation id="4074057296993529937">Google Бүртгэлийнхээ João Browser-н өгөгдлийг ашиглах болон хадгалахын тулд нэвтрэх үгээ оруулна уу</translation>
<translation id="4493028449971051158">Эхлэхэд алдаа гарлаа: суулгагчийг администратораар дахин ажиллуулна уу.</translation>
<translation id="4501471624619070934">Энэ улсад хандалтыг хязгаарласан тул суулгаж чадсангүй.</translation>
<translation id="8624811527667906941">Энэ өргөтгөл өгөгдлийг хэрхэн цуглуулж, ашигладаг гэх мэт нууцлалын практикаа нийтлээгүй байна. João Browser танд үүнийг хасахыг зөвлөж байна.</translation>
<translation id="5571435860030744559">João Browser-д тавтай морилно уу; хөтчийн шинэ цонхыг нээсэн</translation>
<translation id="8132016625974854930">Таны орчин тойрныг зураглаж, гарыг тань тандахад João Browser-д зөвшөөрөл шаардлагатай</translation>
<translation id="6599071882590417739">Та <ph name="USER_EMAIL_ADDRESS" /> хаягаараа João Browser-н өөр профайлд аль хэдийн нэвтэрсэн байна</translation>
<translation id="4548534452171747496">Chromium хуудаснуудыг урьдчилан ачаалах бөгөөд энэ нь үзэх, хайхыг илүү хурдан болгоно. <ph name="BEGIN_LINK" />Хуудас урьдчилан ачаалах талаар нэмэлт мэдээлэл авах<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Хортой гэж бодож буй сайтыг мэдээлж, хүн бүрийн онлайн аюулгүй байдлыг сайжруулахад тусална уу.</translation>
<translation id="202208802191333704">Та Safe Browsing-г унтраасан бөгөөд файлыг баталгаажуулах боломжгүй тул João Browser энэ таталтыг блоклосон</translation>
<translation id="3128308674776200516">Утсан дээрээ João Browser-р Google Lens-г туршиж үзэх</translation>
<translation id="4594305310729380060">Энэ төхөөрөмж дээрх Нууц үгний менежерт</translation>
<translation id="7653380076752216509">João Browser App</translation>
<translation id="4598116752460667024">Жагсаалтаас ямар нэг явцыг хайна уу.</translation>
<translation id="4613863813562375431">ChromiumOS-н хувилбар</translation>
<translation id="4621240073146040695">Удахгүй шинэчилж дууслаа! Chromium-н шинэчлэлийг дуусгахын тулд дахин ачаалж эхлүүлнэ үү.</translation>
<translation id="1497446027991908251">João Browser-н V8 системээр сайтыг хурдасгах ч João Browser-г халдлагад арай тэсвэр багатай болгоно</translation>
<translation id="7523749920868634278">Анхааруулга: João Browser өргөтгөлүүдийг таны хөтчийн түүхийг бичихээс хамгаалж чадахгүй. Энэ өргөтгөлийг Нууцлалтай горимд идэвхгүй болгохын тулд энэ сонголтыг болиулна уу.</translation>
<translation id="4673151026126227699">Хэрэв та мөн Chromium-н ашиглалтын тайланг хуваалцвал тэдгээр тайланд таны зочилсон URL багтана</translation>
<translation id="4673710618874938871"><ph name="USER_NAME" />-р гишүүнчлэлийн эрхтэйгээр нэвтэрсэн. Бүртгэлийн цэсийг нээх</translation>
<translation id="6608258642372806522">Хувийн мэдээллийг (<ph name="HOST_NAME" />) өөр компьютер дээр өөр João Browser үйлдэлд (<ph name="PROCESS_ID" />) ашиглаж байна гэж харагдаж байна. João Browser-аас хувийн мэдээллийг түгжсэн байгаа учраас үүнийг өөр зүйлд ашиглах боломжгүй юм. Хэрэв та өөр ямар ч үйлдэлд энэ хувийн мэдээллийг ашиглахгүй байгаа гэдэгт та итгэлтэй байгаа бол хувийн мэдээллээ цоожилж João Browser-ыг дахин эхлүүлж болно.</translation>
<translation id="4680828127924988555">Суулгахыг цуцлах</translation>
<translation id="3912572071294857936">Таны João Browser-н зарим өгөгдлийг одоогоор Google Бүртгэлд тань хадгалаагүй байна. Гарахаасаа өмнө хэдэн минут хүлээж үзнэ үү. Хэрэв та одоо гарвал энэ өгөгдлийг устгана.</translation>
<translation id="1077152188344040592">Та нэвтэрсэн байхдаа João Browser-д Google Бүртгэлээсээ нууц үг болон бусад зүйлээ ашиглах боломжтой. <ph name="SHORTCUT" /> таны Google-н үйлчилгээний тохиргоог өөрчлөх боломжтой.</translation>
<translation id="5729536702149847030">Хэн нэгэн энэ компьютерт <ph name="ACCOUNT_EMAIL_LAST" /> бүртгэлээр João Browser-д нэвтэрсэн байна. Мэдээллээ тусад нь хадгалахын тулд João Browser-н шинэ хэрэглэгч үүсгэнэ үү.</translation>
<translation id="4724676981607797757">Дэмжигдээгүй протоколын алдааны улмаас суулгалт амжилтгүй болсон.</translation>
<translation id="6273241729694500032">Ямар ч байсан João Browser-г орхих уу?</translation>
<translation id="3239680024825449390">João Browser-н аюулгүй байдлын тусгай шинэчлэлт хийгдэж дууслаа. Одоо дахин эхлүүлнэ үү. Бид таны табыг сэргээх болно.</translation>
<translation id="4771701986670315895">Та ойрын үед зочлоогүй байна. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> болон өөр <ph name="COUNT" /> зөвшөөрлийг хассан.</translation>
<translation id="1908292729364083164">Хэрэв João Browser дахь Gemini нээлттэй бол шинэ таб үүсгэхэд хажуугийн самбар нээлттэй хэвээр байна</translation>
<translation id="479167709087336770">Энэ нь Google хайлтад ашигладаг зөв бичгийн ижил алдаа шалгагчийг ашигладаг. Таны хөтчид бичсэн текстийг Google-д илгээдэг. Та энэ ажиллах төлөвийг хүссэн үедээ тохиргоонд өөрчилж болно</translation>
<translation id="189382710647501724">João Browser-г бүртгэлгүйгээр ашиглах</translation>
<translation id="4456919965836032212">MDNS урсгалыг зөвшөөрөхийн тулд João Browser-д зориулсан хөндлөнгийн дүрэм.</translation>
<translation id="3486986778673504636">&amp;João Browser-г шинэчлэхийн тулд дахин ачаалах</translation>
<translation id="4918086044614829423">Хүлээн зөвшөөрөх</translation>
<translation id="4918844574251943176">Зургийг хуулсан</translation>
<translation id="1571932028747131277">João Browser нь суурь горимд байна.</translation>
<translation id="7612124006067933008">João Browser-н нэвтрэх харилцах цонхыг хаахын тулд товшино уу</translation>
<translation id="2598788273876744576">Та João Browser профайлаар João Browser-н бүх зүйлээ тусгаарлах боломжтой. Найз, гэр бүлийнхэндээ зориулж профайл үүсгэх эсвэл ажил, зугааг ялгаж салгаарай.</translation>
<translation id="2115498792600385171">Зочид João Browser-ийг ашигласнаар хамгийн сүүлийн үеийн мэдээллийг авна.</translation>
<translation id="6870732303439257966">Таны João Browser дахь бүртгэл</translation>
<translation id="4366792189726044065">Өөрийгөө João Browser руу нэмэх</translation>
<translation id="504699503110800016">Урт цэсийг нээх</translation>
<translation id="4340125167559705618"><ph name="DEVICE_TYPE" /> дээрээ João Browser-р Google-н бүх дуртай зүйлдээ хандаарай</translation>
<translation id="4916697359431064123">João Browser-д таны гарыг хянах зөвшөөрөл шаардлагатай</translation>
<translation id="5141988424377517949">Та ойрын үед зочлоогүй байна. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />-г хассан.</translation>
<translation id="5174969993834422967">Та ихэвчлэн мэдэгдлийг блоклодог. Энэ сайтад танд мэдэгдэхийг зөвшөөрөхийн тулд байршлын хэсгийн тань баруун дээд буланд байх мэдэгдлийн дүрс тэмдгийг товшино уу.</translation>
<translation id="5174983315706567306">Дискийн зай хангалтгүй байна.</translation>
<translation id="961070648267203077">João Browser бүртгэл дахин баталгаажуулахыг шаарддаг</translation>
<translation id="69363826605946518">iOS дээрх João Browser-р яг орхисон газраасаа үргэлжлүүлээрэй.</translation>
<translation id="471694954923709047">João Browser-с гарах</translation>
<translation id="5234764350956374838">Хэрэгсэхгүй болго</translation>
<translation id="5782956358171235578">Холбоосыг João Browser-н нууцлалтай цонхонд нээх</translation>
<translation id="903712329052383264">João Browser аппыг аваад явж байх зуураа нууц үгээ хадгалаарай</translation>
<translation id="5277894862589591112">Өөрчлөлтөө хэрэгжүүлэхийн тулд Chromium-г дахин ажиллуулна уу</translation>
<translation id="5286907366254680517">Илэрсэн</translation>
<translation id="5593827909938092728">João Browser аппыг авах</translation>
<translation id="5294316920224716406">Нууцлалын горимд үзэх үед Chromium аюултай холболт ашиглан сайтыг ачаалахаас өмнө танд сануулна</translation>
<translation id="1066981078513393795">João Browser Шинэчлэгч дотоод үйлчилгээ</translation>
<translation id="5324450571874973775">Тэдгээрийг Chromium дахь Gemini-н бусад онцлогийн хамт ашиглана уу</translation>
<translation id="5346389065299425353">Олон таб, файл, хэрэгсэл нэмж хайлтаа гүнзгийрүүлээрэй</translation>
<translation id="1884203704972162365">Энэ баримт бичгийн шуурхай тоймыг авч, João Browser дахь Gemini-р асуулт асуугаарай</translation>
<translation id="5352264705793813212">Chromium таны шалгавал зохих аюулгүй байдлын зарим зөвлөмжийг оллоо</translation>
<translation id="4819697639570429319">João Browser-н бусад профайл</translation>
<translation id="7878591304929138776">Таны бүртгэлийн нэвтрэх дэлгэрэнгүй мэдээлэл хуучирсан тул ChromiumOS таны Google Бүртгэлд João Browser-н өгөгдлийг хадгалж чадсангүй</translation>
<translation id="5249614051186670898">Та удирдан ажиллаж буй хаягт нэвтэрч байгаагаас гадна таны João Browser профайлыг хянах эрхийг системийн ажилтанд шилжүүлж байна. Таны апп, хавчуурга, түүх, нууц үг болон бусад тохиргоо гэх мэт таны João Browser өгөгдлийг <ph name="USER_NAME" />-тэй холбох болно. Та энэхүү өгөгдлийг Google Accounts Dashboard-р дамжуулан устгах боломжтой боловч та энэхүү өгөгдлийн өөр хаягтай холбох боломжгүй байна. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Нэмэлт код: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Хувийн болгох онцлогийг авахын тулд Chromium-г Веб, аппын үйл ажиллагаанд оруулна уу</translation>
<translation id="108952623091824942">João Browser зарим файлыг яагаад блоклодог болохыг мэдэж авах</translation>
<translation id="5386450000063123300">Chromium-г шинэчилж байна (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Chromium-д нэвтрэхийг зөвшөөрөх</translation>
<translation id="1265086181910844216">João Browser-аас устга</translation>
<translation id="1500700851187484222">Гүйцэтгэлийг багасгах ч João Browser-г халдлагад илүү тэсвэртэй болгоно</translation>
<translation id="6665657403278704382">João Browser-ыг өөрийн анхдагч веб хөтөч болгон тохируулах</translation>
<translation id="3520901681432894293"><ph name="PAGE_TITLE" /> - João Browser Бета</translation>
<translation id="5994273394215159270">{NUM_TABS,plural, =1{João Browser таны хөтчийг удаашруулж буй табыг түр зогсоохыг зөвлөж байна}other{João Browser таны хөтчийг удаашруулж буй табуудыг түр зогсоохыг зөвлөж байна}}</translation>
<translation id="646791423998269453">Үүнийг Linux дистрибьютер дээр цаашид дэмжихгүй тул João Browser буруу ажиллаж болзошгүй</translation>
<translation id="7249139852479053716">Файл таны хувийн болон сошиал сүлжээний бүртгэлүүдэд хор хөнөөл учруулах боломжтой тул João Browser энэ таталтыг блоклосон</translation>
<translation id="478612683981218420">João Browser нь хамгийн сүүлийн үеийн системийн шинэчлэлтүүдийг суулгаж байгаа тул түр хүлээнэ үү.</translation>
<translation id="3466187211963597724">João Browser нь нууц үгсийг засах гэж оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="3133978491361824131">João Browser-р Google Драйв, YouTube зэрэг дуртай апп дээрээ явж байх зуураа саадгүй ажиллаарай.</translation>
<translation id="5524890928877629608">хайлтын хэсгийн зүүн дээд булан: зүүн <ph name="LEFT" />%, дээд <ph name="TOP" />%</translation>
<translation id="5527463683072221100">PDF-г Chromium-д нээх</translation>
<translation id="5536164441519929134">Энэ табын талаар<ph name="LINE_BREAK" />асуух</translation>
<translation id="3902123582863904748">Аюулгүй байдлын үүднээс таныг анх удаа сайтад зочлоход João Browser JavaScript-н оновчлолыг унтраадаг.

Хэрэв энэ хуудас хүлээлтийн дагуу ажиллахгүй байвал оновчлолыг зөвшөөрч үзнэ үү.</translation>
<translation id="5924481826213021755">Mac-н цэсийн мөрд João Browser дахь Gemini-г харуулж, товчлуурын шууд холбоосыг асаана уу</translation>
<translation id="4988760628116707723"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд João Browser-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн <ph name="DEVICE" />-с хадгалсан мэдээлэл болон бусад зүйлээ авна.</translation>
<translation id="5579324208890605088">Эхлэхэд алдаа гарлаа: суулгагчийг администратораар бус, энгийн хэрэглэгчээр ажиллуулна уу.</translation>
<translation id="697769674160644707">João Browser-г өгөгдмөлөөр ашиглаж, бэхлээрэй</translation>
<translation id="5596627076506792578">Бусад сонголт</translation>
<translation id="5605834417512968703">Зурган хайлтаар хайхыг хүссэн зүйлээ сонгох эсвэл Зурган хайлтаас гарахын тулд escape-г дарна уу</translation>
<translation id="5618818588972826921">Зурган хайлтаар хайхын тулд дурын текст, зургийг сонгох эсвэл Зурган хайлтаас гарахын тулд escape дээр дарна уу</translation>
<translation id="2497422928854452258">{0,plural, =0{João Browser-н шинэчлэлт боломжтой байна}=1{João Browser-н шинэчлэлт боломжтой байна}other{João Browser-н шинэчлэлт # хоногийн турш боломжтой байсаар байна}}</translation>
<translation id="5643865575100044307">Таныг Chromium-г хаах үед төхөөрөмжөөс тань сайтын өгөгдлийг үргэлж устгана</translation>
<translation id="620465883043431255">João Browser-г одоо дахин эхлүүлнэ үү</translation>
<translation id="5690427481109656848">Google ХХК</translation>
<translation id="5698481217667032250">Chromium-г энэ хэлээр харуулах</translation>
<translation id="569897634095159764">Интернэтэд холбогдох боломжгүй байна. Прокси сервер баталгаажуулалт шаарддаг.</translation>
<translation id="5768371961535086509">Chromium идэвхгүй табуудаас санах ойг суллана. Энэ нь идэвхтэй табууд болон бусад аппад компьютерын илүү их нөөцийг өгч, Chromium-г хурдан байлгана. Таныг идэвхгүй табууд руугаа буцаж очиход тэдгээр таб автоматаар дахин идэвхтэй болно. <ph name="BEGIN_LINK" />Санах ой хэмнэгчийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK" /></translation>
<translation id="8866372822266732235">Хэрэв та нэвтрэх үгээ мартсан эсвэл энэ тохиргоог өөрчлөхийг хүсвэл бүртгэлийнхээ João Browser-н өгөгдлийг <ph name="SETTINGS_LINK" /></translation>
<translation id="2106070764285625641">João Browser-г өөрчилж, хянана уу. João Browser-г өгөгдмөлөөрөө тохируулна уу.</translation>
<translation id="9077878413488413377">João Browser-г өгөгдмөл хөтчөөрөө тохируулснаар нууц үг, хавчуурга, түүхээ төхөөрөмжүүд дээр төгс синк хийсээр байгаарай.</translation>
<translation id="5809516625706423866">Интернэтэд холбогдох боломжгүй байна. HTTP 401 зөвшөөрөлгүй. Прокси тохируулгаа шалгана уу.</translation>
<translation id="614221876503883218">João Browser-н V8 системээр сайтыг хурдасгах ч João Browser-г халдлагад арай тэсвэр багатай болгоно. Энэ тохиргоо унтраалттай байна.</translation>
<translation id="8788365803279840995">Google Бүртгэлдээ João Browser-н өгөгдлийг ашиглах болон хадгалахын тулд João Browser-г шинэчилнэ үү</translation>
<translation id="5824893331272123205">Энэ түр зуурын самбарыг ачаалж чадсангүй. Дахин оролдоно уу</translation>
<translation id="5805760187441013922">João Browser-д тавтай морил</translation>
<translation id="5867606647614813312">Chromium-н хамгийн хүчтэй хамгаалалтаар хангахын тулд нэмэлт онцлогуудыг асаана</translation>
<translation id="5871205389137001634">Зурган хайлтаас гарахын тулд товшино уу</translation>
<translation id="8367098380158627809">Эдгээр зүйл хортой программ агуулж байгааг João Browser олж мэдлээ:</translation>
<translation id="5889361821821684993">Chromium таны хөтөч хамгийн аюулгүй тохиргоотой болохыг баталгаажуулахаар тогтмол шалгадаг. Та ямар нэг зүйлийг шалгах шаардлагатай бол бид танд мэдэгдэнэ.</translation>
<translation id="5895138241574237353">Дахин асаах</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - Сүлжээнд нэвтрэх</translation>
<translation id="5924017743176219022">Интернэтэд холбогдож байна...</translation>
<translation id="7627350220326904504">Таны João Browser-г бэлэн болгоцгооё</translation>
<translation id="5941711191222866238">Багасгах</translation>
<translation id="8680863040348007215">Энэ хавчуурга болон бусад зүйлийг бүх төхөөрөмж дээрээ авахын тулд João Browser-д нэвтэрнэ үү</translation>
<translation id="2008232276062354182">João Browser-г өөрийн болгох</translation>
<translation id="5960071705175224773">Таны тохиргоог тодорхойгүй апп өөрчилсөн</translation>
<translation id="5977420883993828287">Бэхэлсэн! Хэрэгслийн мөрөөс Хам сэдэвт ажлыг дахин ашиглана уу</translation>
<translation id="5889362640603897718">{COUNT,plural, =1{João Browser-г 1 минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана.}other{João Browser-г # минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана.}}</translation>
<translation id="4971097497342057998">Синкийг эхлүүлэхийн тулд João Browser-г шинэчлэх</translation>
<translation id="5990360079535151574">Та үзэх явцдаа асуулт асуухын тулд хэрэгслийн мөр дээрх "Хам сэдэвт ажил" товчноос Хам сэдэвт ажлыг дахин нээх боломжтой</translation>
<translation id="6003112304606738118">Татаж байна... <ph name="HOURS" /> цаг үлдсэн</translation>
<translation id="6009821354356307391">Араас нь лавлаж асуух</translation>
<translation id="6040143037577758943">Хаах</translation>
<translation id="2100398097168307292">Та <ph name="DEVICE_TYPE" /> дээрээ João Browser аппыг ашиглахдаа онлайн худалдан авалтаас илүү ихийг аваарай</translation>
<translation id="6058380562449900225">Өгөгдлөө хамгаалахын тулд Chromium-д таны ойрын хугацаанд зочлоогүй сайтуудаас зөвшөөрлүүдийг хасахыг зөвшөөрнө үү. Мэдэгдлүүдийг зогсоохгүй.</translation>
<translation id="4735359759698689867">&amp;João Browser-д нээх</translation>
<translation id="6069027071882229820">Зургаар хуулах</translation>
<translation id="2274675514456642321"><ph name="EXTENSION_NAME" />-г João Browser-д нэмсэн</translation>
<translation id="147381942282490529">João Browser-г тохируулж, хянана уу. Шинэчлэх боломжтой.</translation>
<translation id="8775234022739879423">Асаалттай • João Browser энэ өргөтгөлийг хаанаас гаралтай болохыг баталгаажуулах боломжгүй</translation>
<translation id="6634821567165410381">Таны João Browser дахь бүртгэл</translation>
<translation id="4398707227122702993">Өргөтгөлд João Browser-н самбарт хандах хүсэлт харуулахыг зөвшөөрнө үү</translation>
<translation id="5370941509199989624"><ph name="FILE_NAME" /> аюултай тул үүнийг João Browser блок хийсэн.</translation>
<translation id="5119118887583954582">João Browser удахгүй хаах бөгөөд өгөгдлийг устгана</translation>
<translation id="576637711620229618">Та энд João Browser-н профайлууд хооронд сэлгэх боломжтой</translation>
<translation id="615103374448673771">Та күүкиг зөвшөөрсөн тохиолдолд Chromium тэдгээрийг урьдчилан ачаалах үед ашиглаж магадгүй</translation>
<translation id="6165508094623778733">Нэмэлт мэдээлэл авах</translation>
<translation id="3738215896821824918">Бүртгэлийнхээ João Browser-н өгөгдлийг арилгана уу</translation>
<translation id="2145111683361496197">Энэ файл аюултай байж магадгүй<ph name="LINE_BREAK" />Хэрэв та нууц үгээр хангавал João Browser энэ татаж авсан файлыг танд шалгаж өгөх боломжтой. Файлын талаарх мэдээллийг Google-н аюулгүй хөтөч рүү илгээдэг хэдий ч тухайн файлын контент болон нууц үг таны төхөөрөмжид үлддэг.</translation>
<translation id="6182736845697986886">Шинэчлэлтийн серверийн дотоод алдааны улмаас суулгалт амжилтгүй болсон.</translation>
<translation id="6050294746023477088">Та João Browser-д өөрийн <ph name="TARGET_DEVICE_NAME" />-с нэвтэрсэн эсэхээ шалгаад, дахин илгээхээр оролдоно уу.</translation>
<translation id="3395167674702947885">Энэ компьютерт João Browser-ийн хамгийн сүүлийн үеийн хувилбар байна. Хэрэв программ ажиллахгүй байвал João Browser-ийг устгаад, дахин суурьлуулж үзнэ үү.</translation>
<translation id="4384214545531685923">{0,plural, =0{João Browser-г одоо дахин ажиллуулна}=1{João Browser-г 1 секундийн дотор дахин ажиллуулна}other{João Browser-г # секундийн дотор дахин ажиллуулна}}</translation>
<translation id="5880255774989397049">Файл татахын тулд João Browser-д хадгалах санд хандах зөвшөөрөл шаардлагатай</translation>
<translation id="6245734527075554892">Chromium-д хадгалсан аюултай сайтын жагсаалттай URL-г шалгана</translation>
<translation id="1959823478027154444">João Browser-ыг анхдагч веб хөтөч болгох</translation>
<translation id="6248988683584659830">Хайлтын тохиргоо</translation>
<translation id="9191635841540101343">Утсан дээрээ João Browser аппыг ашиглан явж байх зуураа Google-н аюулгүй байдлын шилдэг онцлогуудыг аваарай</translation>
<translation id="538350741885862188">João Browser-с гарах уу?</translation>
<translation id="161121067714522736">Эдгээр таб нэмэлт нөөцүүдийг ашиглаж байна. Гүйцэтгэлээ сайжруулахын тулд João Browser-д эдгээр табыг идэвхгүй болгохыг зөвшөөрнө үү.</translation>
<translation id="2095090272560293574">João Browser-н профайлаа өөрчлөх</translation>
<translation id="6290827346642914212">Chromium-н профайлаа нэрлэнэ үү</translation>
<translation id="6472525517562723285">Өргөтгөл таныг João Browser-д нэвтрэхийг хүсэж байна</translation>
<translation id="2069878195899746465"><ph name="FILE_NAME" /> аюултай байж болзошгүй тул үүнийг João Browser блок хийсэн.</translation>
<translation id="1283909912629029170">João Browser таны камерыг ашиглаж байна.</translation>
<translation id="323902744000752306">João Browser-д өөр үйл ажиллагаа явагдаж байна. Дараа дахин оролдоно уу.</translation>
<translation id="1292164882596462877">Одоо та Google хаягаа ашиглан мөн өөр бусад компьютер дээр João Browser-г ашиглахад хялбар боллоо.</translation>
<translation id="6411450594978516531">João Browser-г өгөгдмөл хөтчөөрөө тохируулж мэддэг, дуртай, итгэдэг онцлогууддаа хялбархан хандаарай.</translation>
<translation id="3344301749774719950">João Browser-н товчлол</translation>
<translation id="8395825163097750991">Файлыг ихэвчлэн татдаггүй бөгөөд энэ нь аюултай байж магадгүй тул João Browser энэ таталтыг блоклосон</translation>
<translation id="7683737657427846440">Та João Browser-ыг устгахыг хүсэж байгаадаа итгэлтэй байна уу?</translation>
<translation id="6375219077595103062">Нууц үгний менежерт товчлол нэмэх</translation>
<translation id="6388799252195623474">надад үүнд тусална уу</translation>
<translation id="6966523531135953867">Үргэлжлүүлэхийн тулд João Browser-д <ph name="EMAIL" />-р нэвтэрнэ үү. Энэ нь таныг байгууллагынхаа бодлогыг хүлээн авсныг баталгаажуулна.</translation>
<translation id="5146608242127807773">Компьютерын дэлгэц доторх João Browser-н лого.</translation>
<translation id="6361476216650509195">João Browser бол веб хуудсууд болон аппликейшнуудыг цахилгааны хурдаар ажиллуулдаг веб хөтөч юм. Энэ нь хурдан, найдвартай мөн хэрэглэхэд хялбар. João Browser-д бий болгосон хорт вирус болон фишингийн хамгаалалтыг ашиглан вебээр илүү аюулгүй хайлт хийгээрэй.</translation>
<translation id="7864687914956920860">Та Google Бүртгэлдээ João Browser-н өгөгдлийг үргэлж ашиглах, хадгалах боломжтой болохоо нягтлахын тулд өөрийгөө мөн болохыг баталгаажуулна уу</translation>
<translation id="1160920197193662978">João Browser илүү хурдан ажилладаг бөгөөд JavaScript-г ашигладаг онцлогууд зориулалтын дагуу ажиллах ёстой</translation>
<translation id="6436260184216827876">Зурган хайлт боломжгүй байна. Дараа дахин оролдоно уу.</translation>
<translation id="6442900851116057561">ChromiumOS-г дахин эхлүүлнэ үү</translation>
<translation id="6443470774889161065">Chromium таны зочлох магадлалтай илүү олон хуудсыг урьдчилан ачаалах бөгөөд ингэснээр тэдгээр нь таныг зочлох үед илүү хурдан ачаална</translation>
<translation id="3730564967922511625">Үнэ хянаж, аливаа сайт дээр үнэ буурахад мэдэгдэл авахын тулд утсан дээрээ João Browser-г татаарай</translation>
<translation id="3753019081686930624">Унтраалттай • João Browser энэ өргөтгөлийг хаанаас гаралтай болохыг баталгаажуулах боломжгүй</translation>
<translation id="5444641426058108434">João Browser профайлд тавтай морилно уу</translation>
<translation id="5103470775766355478">Та дараагийн удаа <ph name="DEVICE_TYPE" /> дээрээ João Browser-г нээхэд табын бүлгийг ашиглах сануулга харагдана.</translation>
<translation id="9087231386723579740">João Browser-с бүртгэл хасах</translation>
<translation id="4984395209542302039">Энэ нь мөн таныг João Browser-ыг эхлүүлж байх үед гарч ирсэн хуудсыг хянадаг.</translation>
<translation id="648319183876919572">Сайжруулсан аюулгүй хөтөч нь таныг аюултай вебсайт болон таталтаас хамгаалахын тулд илүү ихийг хийдэг</translation>
<translation id="1524792685704191751">João Browser-ийг устгах</translation>
<translation id="6637504267182028286">João Browser-д нээх товчлол</translation>
<translation id="1478247638436966279">Танай байгууллага João Browser-г <ph name="TIMEOUT_DURATION" />-н турш ашиглаагүй үед хаадаг. Интернэтээр үзсэн өгөгдлийг устгасан. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.</translation>
<translation id="1311233187253046133">Профайл тус бүр João Browser-н өөрийн мэдээллийг агуулах бөгөөд үүнд хавчуурга, түүх, нууц үг болон бусад мэдээлэл багтана</translation>
<translation id="6563921047760808519"><ph name="BEGIN_LINK" />Chromium таны өгөгдлийг хэрхэн хувийн байлгадаг<ph name="END_LINK" /> талаар нэмэлт мэдээлэл авах</translation>
<translation id="1643078533228697915">Энэ тохиргооны өөрчлөлтийг João Browser-г дахин эхлүүлсний дараа оруулна.</translation>
<translation id="1918630514771863338">João Browser-н үндсэн цэс дэх Өргөтгөл дээр товшиж өргөтгөлүүдээ удирдана уу.</translation>
<translation id="4229328298978407243">Та өөр João Browser профайлаас нууц үгнүүдийг харахын тулд шилжих боломжтой</translation>
<translation id="7717252965531997879">Хамгийн сайн ХОУ-ы хэрэгслүүдийг явж байх зуураа ашиглахын тулд João Browser аппыг ашиглаарай</translation>
<translation id="6570579332384693436">Зөв бичгийн алдааг засахын тулд Chromium таны текстийн талбарт бичсэн текстийг Google-д илгээдэг</translation>
<translation id="5374627817618267090">João Browser-н мэдэгдлийн тохиргоо руу очих</translation>
<translation id="6600016381025017075">Энэ хуудсан дээрх дурын зүйлийг хайх</translation>
<translation id="264335610358256197">Таныг João Browser дахин эхлүүлэхэд өөрчлөлт идэвхжинэ.</translation>
<translation id="2657584510687441826">João Browser одоо Windows-г эхлэх үед эхэлдэг болсон тул та шуурхай үзэж эхлэх боломжтой боллоо. Та үүнийг тохиргооноос унтрааж болно.</translation>
<translation id="5482413402708094860">Орхисон газраасаа үргэлжлүүлнэ үү: João Browser таны сүүлийн харилцан үйлдлийн табуудыг сэргээсэн. Та үүнийг дараахаас унтрааж болно</translation>
<translation id="5022765692226673603">Таны эргэн тойрны 3D газрын зургийг үүсгэхийн тулд João Browser-д камерын зөвшөөрөл шаардлагатай</translation>
<translation id="6669284030132180248">Хэрэв та мөн хавчуургаа Google Бүртгэлдээ хадгалдаг бол бүтээгдэхүүний үнийг Chromium-д хянаж, үнэ буурах үед мэдэгдэл авах боломжтой</translation>
<translation id="6676384891291319759">Интернэтэд нэвтрэх</translation>
<translation id="668175097507315160">Нэвтрэх алдааны улмаас ChromiumOS таны өгөгдлийг синк хийж чадсангүй.</translation>
<translation id="3982573751008180181">Энэ аппын өгөгдлийг João Browser-с хасах</translation>
<translation id="5613723096388999601">João Browser-д энэ сайтад зориулж микрофоны зөвшөөрөл шаардлагатай</translation>
<translation id="6712881677154121168">Татахад алдаа гарлаа: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="9190188975825967506">Таны профайлыг ашиглах боломжгүй байна. Учир нь энэ João Browser-ийн шинэ хувилбараас ирсэн байна.

Зарим функц ажиллахгүй байж болно. профайлын өөр зааварчилгааг тодорхойлж өгөх эсвэл João Browser-ийн шинэ хувилбарыг ашиглана уу.</translation>
<translation id="6729124504294600478">Хувийн болгох болон бусад онцлогийг авахын тулд Chromium-г Веб, аппын үйл ажиллагаа болон Google-н холбосон үйлчилгээнүүдэд оруулна уу</translation>
<translation id="6957684879859415418">João Browser-г таны компьютерийн бүх хэрэглэгчид суулгасан байна.</translation>
<translation id="4411262692912917677">Хавчуурга болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд João Browser-д нэвтэрнэ үү. Таныг нэвтэрсний дараа энэ хавчуургыг Google Бүртгэлд тань хадгална.</translation>
<translation id="6064901610880747710">João Browser-н V8 системээр сайтыг хурдасгах ч João Browser-г халдлагад арай тэсвэр багатай болгоно. Энэ тохиргоо асаалттай байна.</translation>
<translation id="4530735110472079436">{count,plural, =1{Таны João Browser-н зарим өгөгдлийг Google Бүртгэлд тань хараахан хадгалаагүй байна. Гарахаасаа өмнө хэдэн минут хүлээж үзнэ үү. Хэрэв та одоо гарвал энэ өгөгдлийг (1 зүйл) устгана.}other{Таны João Browser-н зарим өгөгдлийг Google Бүртгэлд тань хараахан хадгалаагүй байна. Гарахаасаа өмнө хэдэн минут хүлээж үзнэ үү. Хэрэв та одоо гарвал энэ өгөгдлийг ({count} зүйл) устгана.}}</translation>
<translation id="9176853308971176490">Энэ файл аюултай байж магадгүй тул João Browser үүнийг скан хийхийг зөвлөж байна.</translation>
<translation id="6779406956731413166">ChromiumOS-г нэмэлт <ph name="BEGIN_LINK_CROS_OSS" />нээлттэй эх кодын программ хангамжаар<ph name="END_LINK_CROS_OSS" /> боломжтой болгосон.</translation>
<translation id="6831043979455480757">Хөрвүүлэх</translation>
<translation id="6412488898785231889">Хэрэв таны нууц үг алдагдсан байвал João Browser танд мэдэгдэнэ</translation>
<translation id="684888714667046800">Интернэтэд холбогдох боломжгүй байна. Хэрэв та галт хана ашиглавал <ph name="PRODUCT_EXE_NAME" />-г зөвшөөрсөн жагсаалтад байгаа болохыг баталгаажуулна уу.</translation>
<translation id="6750640664545078431">João Browser - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Үргэлжлүүлэхийн тулд Tab дээр дарна уу</translation>
<translation id="6862030660799253820">Зурган хайлтаар энэ зургийг хай</translation>
<translation id="4260365383290377081">"<ph name="EXTENSION_NAME" />" хортой программ агуулж байгааг João Browser олж мэдлээ</translation>
<translation id="6877155553248388166">хайлтын хэсгийн баруун доод булан: баруун <ph name="RIGHT" />%, доод <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">Хуулах</translation>
<translation id="6898028264630240901">Та үзэх явцдаа асуулт асуухын тулд Хам сэдэвт ажлыг бэхлэх боломжтой</translation>
<translation id="6985817498888719203">João Browser-г өгөгдмөл хөтчөөрөө тохируулж, ажлын хэсэгтээ бэхэлнэ үү</translation>
<translation id="5277424858974213042">&amp;João Browser-н профайлуудыг удирдах</translation>
<translation id="2726137364317931343">Энэ үйлдэл:
          <ph name="LINE_BREAKS" />
            • Таны эхлүүлэх хуудас, шинэ таб хуудас, хайлтын систем, бэхэлсэн табыг шинэчилнэ
            <ph name="LINE_BREAK" />
            • Өргөтгөлүүдийг идэвхгүй болгоно
            <ph name="LINE_BREAK" />
            • Күүки болон сайтын бусад түр өгөгдлийг устгана
            <ph name="LINE_BREAK" />
            • João Browser-н товчлолуудыг шинэчилнэ
            <ph name="LINE_BREAKS" />
            Хавчуурга, түүх, хадгалсан нууц үгэнд нөлөөлөхгүй.</translation>
<translation id="2901988969322822496">Та João Browser-н <ph name="BOOKMARK_LIMIT" /> хавчуургын хязгаарт хүрсэн тул таны зарим хавчуургыг Google Бүртгэлд тань хараахан хадгалаагүй байна.

Та зарим хавчуургаа устгах хүртэл бүртгэлдээ шинэ хавчуурга хадгалах боломжгүй. Хэрэв та одоо гарвал хадгалаагүй хавчуургыг устгана.</translation>
<translation id="6203410920314218280">Холбоосыг João Browser-н нууцлалтай цонхонд нээх</translation>
<translation id="6965382102122355670">OK</translation>
<translation id="6985329841647292029">ChromiumOS-н нөхцөл</translation>
<translation id="8064285182627814996"><ph name="ACCOUNT_EMAIL" /> бүртгэлдээ João Browser-н өгөгдлийг ашиглах, хадгалахын тулд нэвтрэх үгээ оруулна уу</translation>
<translation id="7011190694940573312">Үйлдлийн системийн энэ хувилбарыг дэмждэггүй тул суулгалт амжилтгүй боллоо.</translation>
<translation id="7024536598735240744">Задлахад алдаа гарлаа: <ph name="UNPACK_ERROR" />.</translation>
<translation id="181803036615530330">João Browser-г өөрийн болгоoрой</translation>
<translation id="7047386856539490735">Эдгээр илэрц хэрэг болж байна уу?</translation>
<translation id="2478245051737698828">João Browser-г шинэчлэх</translation>
<translation id="452909342278940733">Хэрэв зурагт хэрэгтэй тайлбар байхгүй бол João Browser танд тайлбар өгөхөөр оролдох болно. Тайлбар үүсгэхийн тулд зургийг Google-д илгээнэ.</translation>
<translation id="8606769615526968368"><ph name="DEVICE_TYPE" /> дээрээ João Browser аппыг ашиглахдаа ХОУ-ы хүчийг аваарай</translation>
<translation id="2061960765882453684">Утсан дээрээ João Browser аппыг ашиглан нууц үг, таб болон бусад зүйлээ явж байх зуураа аваарай</translation>
<translation id="7141270731789036260">Chrome for Testing-г өөрчлөх</translation>
<translation id="7147227333672430807">Та мессеж, баримт бичиг болон бусад апп дахь холбоосон дээр товших бүрдээ Chromium-г ашиглах боломжтой</translation>
<translation id="6949173677980969871"><ph name="EXTENSION_NAME" />-г João Browser-с хасах</translation>
<translation id="3556355753960287061">Танай байгууллага João Browser-г <ph name="TIMEOUT_DURATION" />-н турш ашиглаагүй үед өгөгдлийг нь устгадаг. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.</translation>
<translation id="8689006320829658442">João Browser-д энэ сайтад зориулж камерын зөвшөөрөл шаардлагатай</translation>
<translation id="7501884108538572227">João Browser-г эхлүүлж чадсангүй. Дахин оролдоно уу.</translation>
<translation id="5484563502710761706">João Browser дахь Gemini-р байгаа газраасаа хүссэн зүйлээ асуугаарай</translation>
<translation id="3823264355161086552">Хүссэн үедээ João Browser руу түргэн очихын тулд суурилуулагчдаа байлгана уу</translation>
<translation id="9153902741226700840">Та мессеж, документ болон бусад аппын холбоосыг товших бүрдээ João Browser-г ашиглана уу</translation>
<translation id="7216228761061470870">Таныг Зурган хайлтыг компьютер дээр ашиглахад хуудасны гарчиг, URL, PDF зэрэг контентыг сервер лүү илгээдэг</translation>
<translation id="7950844619283784703">Бодлогын менежер - João Browser</translation>
<translation id="133513825972536773"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд João Browser-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн бүх төхөөрөмж дээрээ хадгалсан мэдээлэл болон бусад зүйлээ авна.</translation>
<translation id="4558982617284733740">Шуурхай үзэж эхлээрэй: João Browser одоо Windows-г эхлэх үед эхлэх боломжтой боллоо.</translation>
<translation id="7274695763216404502">Бэхэлсэн! Самбараас Зурган хайлтыг дахин ашиглана уу</translation>
<translation id="7288567540154601580">Таб, өргөтгөл</translation>
<translation id="5494571279964989269">{NUM_EXTENSIONS,plural, =1{João Browser танд үүнийг хасахыг зөвлөж байна}other{João Browser танд тэдгээрийг хасахыг зөвлөж байна}}</translation>
<translation id="2269053214123323740">Системийн аудиог хуваалцахын тулд Системийн тохиргоог нээгээд, João Browser-д 'Зөвхөн системийн аудио бичлэг'-ийг зөвшөөрнө үү. Та дараа нь João Browser-г дахин эхлүүлэх шаардлагатай.</translation>
<translation id="731795002583552498">Chromium-г шинэчилж байна</translation>
<translation id="9065168747010082551">Таны тохиргоо файл алдаатай эсвэл хүчин төгөлдөр бус байна. João Browser таны тохиргоог сэргээх боломжгүй байна.</translation>
<translation id="7324051657739063017">Та үзэх явцдаа асуулт асуухын тулд Хам сэдэвт ажлыг дахин нээх боломжтой</translation>
<translation id="4159250197688136733">Таны веб хуудас, хавчуурга, болон бусад João Browser-ийн зүйлс энд байдаг.</translation>
<translation id="7347827960336370838">Зөвхөн таны нэвтрэх үгтэй хүн шифрлэгдсэн өгөгдлийг тань унших боломжтой. Нэвтрэх үгийг Google-д илгээдэггүй бөгөөд хадгалдаггүй. Хэрэв та нэвтрэх үгээ мартсан эсвэл энэ тохиргоог өөрчилмөөр байвал <ph name="BEGIN_LINK" />бүртгэлийнхээ Chromium-н өгөгдлийг устгах<ph name="END_LINK" /> шаардлагатай болно.</translation>
<translation id="1062903713270840396">Таны системийн админ João Browser-г<ph name="TARGET_URL_HOSTNAME" />-д хандахын тулд <ph name="ALTERNATIVE_BROWSER_NAME" />-г нээхээр тохируулсан байна.</translation>
<translation id="7352651011704765696">Алдаа гарсан байна</translation>
<translation id="5817362738974335084">João Browser-н цаашдын шинэчлэлтийг авахын тулд танд macOS 13 эсвэл түүнээс хойших хувилбар хэрэг болно. Энэ компьютер macOS 12 хувилбарыг ашиглаж байна.</translation>
<translation id="7376384068949534168">Та ойрын үед зочлоогүй байна. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />-г хассан.</translation>
<translation id="73786666777299047">Chrome Веб Дэлгүүр нээх</translation>
<translation id="5724625487458697703">Системийн жижиг тэмдэг бүхий хэсэгт João Browser дахь Gemini-г харуулах</translation>
<translation id="7401687852903179959">Зурган хайлтаар энэ видеоноос хайх</translation>
<translation id="1088684725931971005">João Browser таны өгөгдмөл хөтөч боллоо</translation>
<translation id="7479848806300971661">Орхисон газраасаа үргэлжлүүлнэ үү: João Browser таныг дахин эхлүүлэх бүрд табуудыг тань сэргээнэ. Үүнийг унтраахын тулд дараах руу очно уу</translation>
<translation id="1258077876605261365">Нууц үгийг João Browser руу импортлох</translation>
<translation id="5293062713751091377">1. Доорх <ph name="BUTTON_LABEL" /> дээр товшино уу Windows-н тохиргоондоо <ph name="BUTTON_2" /> дээр товшино уу João Browser-г ажлын хэсэгтээ бэхэлж, шуурхай хандахын тулд Windows-н мэдэгдэлд <ph name="BUTTON_3" /> дээр товшино уу</translation>
<translation id="1941496545060769345"><ph name="PAGE_TITLE" /> - João Browser Дев</translation>
<translation id="7450541714075000668">Текстийг хуулсан</translation>
<translation id="7458892263350425044">Микрофоноо ашиглахын тулд <ph name="BEGIN_LINK" />системийн тохиргоонд<ph name="END_LINK" /> Chromium-д хандах эрх өгнө үү</translation>
<translation id="5422859338435319909">João Browser-н цаашдын шинэчлэлтийг авахын тулд танд Windows 10 эсвэл түүнээс хойших хувилбар хэрэгтэй болно. Энэ компьютер Windows 7-г ашиглаж байна.</translation>
<translation id="7467949745582939695">Chromium-г дахин эхлүүлэх үү?</translation>
<translation id="7707324976708178089">Одоо ажиллаж байгаа João Browser-ын ижил хувилбарыг суулгаж чадахгүй байна. João Browser-аа хаагаад дахин оролдоно уу.</translation>
<translation id="7510190804000607802">Сануулагч: Google-н шилдэг зүйлс таны халаасанд</translation>
<translation id="751935028865900641">Сайтууд тооцоолсноор ажиллах байх. Хэрэв та Chromium-д нэвтэрсэн бол таныг Chromium-н бүх цонхыг хаах үед Google Бүртгэлээс тань бусад ихэнх сайтаас гаргана.</translation>
<translation id="5325102834460669866">{0,plural, =1{João Browser-г 1 минутын дотор дахин ажиллуулна}other{João Browser-г # минутын дотор дахин ажиллуулна}}</translation>
<translation id="7565444033145385702">Өгөгдлөө хамгаалахын тулд Chromium-д таны сүүлийн үед зочлоогүй сайтын зөвшөөрлийг хасахыг зөвшөөрнө үү.</translation>
<translation id="8099958128052689767">Шууд үзэж эхлэхийн тулд João Browser-г автоматаар эхлүүлнэ үү.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> суулгагч</translation>
<translation id="7125257608567714221">João Browser нь таны камер болон микрофоныг ашиглаж байна.</translation>
<translation id="227045421902171569">João Browser сайжирлаа</translation>
<translation id="5356567285381070312">Та одоо João Browser-н бусад онцлогийг ашиглах боломжтой боллоо</translation>
<translation id="7624307931717240213">Бид энэ үйлчилгээг сайжруулахад мэдээллийг ашигладаг. Нууцлалын бодлого, Үйлчилгээний нөхцөлийг харна уу.</translation>
<translation id="7649070708921625228">Тусламж</translation>
<translation id="5714374331629713291">João Browser аппыг авах</translation>
<translation id="7658239707568436148">Болих</translation>
<translation id="549378870470819535">João Browser таны өгөгдмөл хөтөч биш юм</translation>
<translation id="6574348346278803862">Төхөөрөмжүүддээ João Browser-г синк хийж, хувийн болгох</translation>
<translation id="7699779824407626136">Chromium-н шинэчлэлт</translation>
<translation id="3304080024230377341">Таны ажлыг João Browser дээр хамгаалсан</translation>
<translation id="7716950018788545737">Ажил(ууд) дууссан.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME" />-д зориулж системийн ул мөрийн үйлчилгээгээр хангадаг. Хэрэв энэ үйлчилгээг идэвхгүй болгосон бол хөтчийн үүсгэсэн гүйцэтгэлийн ул мөрд хам сэдэв сэлгэх болон дэд процессыг бэлдэх үйл явдал зэрэг систем дээрх үйл явдлуудыг оруулахгүй.</translation>
<translation id="7745317241717453663">Энэ нь төхөөрөмжөөс таны хайлтын түүхийг устгана. Өгөгдлөө дараа сэргээхийн тулд Chromium-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="7747138024166251722">Суулгагч нь түр зуурын хадгалалтын санг үүсгэж чадсангүй. Дискэнд сул зай байгаа эсэхийг мөн программ хангамж суулгах зөвшөөрлийг шалгана уу.</translation>
<translation id="4713120944298974980">João Browser-с хайх</translation>
<translation id="5804390944809171853">Өгөгдмөл João Browser руу шинэчлэх</translation>
<translation id="6930487390575519812">Таны João Browser дээрх ажлыг хамгаалахын тулд таныг João Browser-д нэвтрэхэд танай байгууллага тодорхой мэдээллийг харах, удирдах боломжтой болно.</translation>
<translation id="5214761769821670245">João Browser-г өгөгдмөлөөр тохируулж, ажлын хэсэгт бэхэлнэ үү</translation>
<translation id="1294697217796985566">João Browser-г илүү хурдан болгоорой</translation>
<translation id="1278345486417353853"><ph name="PAGE_TITLE" /> - João Browser Канари</translation>
<translation id="7803986347287457849">Таны интернэтийн ачаалалд хандах эрхтэй хүмүүст таны зочилдог сайтуудыг харахыг илүү хүндрэлтэй болгоно. Chromium DNS-с (Домэйн нэрийн систем) сайтын IP хаягийг хайхад аюулгүй холболт ашигладаг.</translation>
<translation id="7810005234485217901">Та хялбар хандахын тулд Зурган хайлтыг бэхлэх боломжтой</translation>
<translation id="489728561211958943">Энэ бүртгэлтэй João Browser-н профайл аль хэдийн энэ төхөөрөмж дээр байна</translation>
<translation id="7845233973568007926">Суулгасанд баярлалаа. Та <ph name="BUNDLE_NAME" />-г ашиглахаасаа өмнө компьютероо дахин эхлүүлэх ёстой.</translation>
<translation id="5294768452950207882">Таны хайлтын системийг João Browser-с гадуур өөрчилсөн. Таныг хамгаалахын тулд João Browser үүнийг эх өгөгдмөл тохиргоо руу нь шинэчилсэн. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3244974069468656925">João Browser-д шинэ дүр төрх өгөхийн тулд тусгайлан өөрчилнө үү</translation>
<translation id="7859018312476869945">Таныг хаяг оруулах хэсэг эсвэл хайх хэсэгт бичих үед Chromium илүү сайн зөвлөмж авахын тулд таны бичсэн зүйлийг өгөгдмөл хайлтын системд тань илгээдэг. Энэ нь Нууцлалтай горимд унтраалттай.</translation>
<translation id="6517519572778941051">João Browser-г хамгийн сүүлийн хувилбарт шинэчлээгүй тул та шинэ онцлог болон аюулгүй байдлын засвар авах боломжгүй байна.</translation>
<translation id="7872446069773932638">Татаж байна... <ph name="SECONDS" /> секунд үлдсэн</translation>
<translation id="7873537467422636035">Хэрэв та нэвтрэх үгээ мартсан эсвэл энэ тохиргоог өөрчилмөөр байвал <ph name="BEGIN_LINK" />бүртгэлийнхээ Chromium-н өгөгдлийг устгана уу<ph name="END_LINK" /></translation>
<translation id="1722038268139386345">Танд хэрэг болох бүрд João Browser дахь Gemini-г шуурхай нээгээрэй</translation>
<translation id="8344320926817290924">João Browser-г өгөгдмөлөөрөө тохируулах</translation>
<translation id="7934340546140346950">Chromium боломжтой үед аюултай холболтыг HTTPS рүү автоматаар сайжруулдаг</translation>
<translation id="3755057387338907970">Та João Browser-д <ph name="USER_EMAIL_ADDRESS" />-аар нэвтэрсэн байна. Нэвтрэхийн тулд ижил данс хэрэглэнэ үү.</translation>
<translation id="929903348843569380"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд João Browser-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн бүх төхөөрөмж дээрээ хавчуурга болон бусад зүйлээ авна.</translation>
<translation id="7975919845073681630">Энэ нь Chromium-н хоёр дахь суулгалт тул таны өгөгдмөл хөтчөөр сонгох боломжгүй.</translation>
<translation id="8905411496853397218">Тодорхойгүй эх сурвалжийн өргөтгөл, апп болон загвар нь таны төхөөрөмжийг гэмтээх боломжтой. João Browser тэдгээрийг зөвхөн <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-с суулгахыг зөвлөж байна</translation>
<translation id="6306672714476596428"><ph name="DEVICE_TYPE" /> дээрээ João Browser аппаар Google-н шилдэг зүйлсийг аваарай</translation>
<translation id="8004582292198964060">Хөтөч</translation>
<translation id="8010081455002666927">Автоматаар илрүүлэх</translation>
<translation id="2172829664765531568">João Browser-д хандалт олгосны дараа веб сайтууд таны хандалтыг асуух боломжтой болно.</translation>
<translation id="74641100973032765">João Browser-д хүссэн үедээ шуурхай очихын тулд ажлын хэсэгтээ бэхэлнэ үү</translation>
<translation id="80471789339884597">Суулгасанд баярлалаа. Та <ph name="BUNDLE_NAME" />-г ашиглахаасаа өмнө бүх хөтчөө дахин эхлүүлэх ёстой.</translation>
<translation id="8054112667659782652">Зурган хайлтын товчлолыг үргэлж харуулах</translation>
<translation id="8069447462453318634">"Хэрэгслийн мөрд бэхлэх" гэснийг сонгоно уу</translation>
<translation id="5039671129725402518">Аппуудын хувьд João Browser-г дэвсгэрт ажиллуулахыг идэвхгүй болгох</translation>
<translation id="80790299200510644">Зурган хайлт</translation>
<translation id="8086881907087796310">Таны компьютер техник хангамжийн доод шаардлагад нийцэхгүй байгаа тул суулгалт амжилтгүй болсон.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome for Testing</translation>
<translation id="2430877582155731716">João Browser-д энэ сайтад зориулж байршлын зөвшөөрөл шаардлагатай</translation>
<translation id="8298045348217323">Та дараагийн удаа <ph name="DEVICE_TYPE" /> дээрээ João Browser-г нээхэд үнэ мөшгөх дохиог идэвхжүүлэх сануулга харагдана.</translation>
<translation id="3827347991254458074">Утсан дээрээ João Browser аппаар сонирхож буй зүйлсийнхээ үнэ буурсан талаарх сэрэмжлүүлгийг аваарай</translation>
<translation id="8118331347066725040">Lens-р хайхад зориулж санал хүсэлт илгээх</translation>
<translation id="2580039965224265556">João Browser-г өөрийн болгох</translation>
<translation id="8133124826068723441">Синк нь таны домэйнд боломжгүй тул ChromiumOS таны өгөгдлийг синк хийж чадсангүй.</translation>
<translation id="813913629614996137">Эхлүүлж байна…</translation>
<translation id="7940955011992997426">Товчлуурын шууд холбоосоор João Browser дахь Gemini-г нээгээрэй.</translation>
<translation id="7560319627203819845">João Browser-н Үйлчилгээний нэмэлт нөхцөл</translation>
<translation id="7133741820744999589">Энэ файл аюултай тул João Browser блоклосон байна.</translation>
<translation id="8177472873527554730">Хуудаснаас контент олж чадсангүй</translation>
<translation id="8200109504272824693"><ph name="USER_EMAIL" /> бүртгэлдээ Chromium-н өгөгдлийг ашиглах, хадгалахын тулд нэвтрэх үгээ оруулна уу</translation>
<translation id="820759916613250543">Зурган хайлтаар энэ зургаас хайх</translation>
<translation id="8221491193165283816">Та ихэвчлэн мэдэгдлийг хориглодог. Энэ сайтад танд мэдэгдэхийг зөвшөөрөхийн тулд энд товшино уу.</translation>
<translation id="8223363452568144035">Камераа ашиглахын тулд <ph name="BEGIN_LINK" />системийн тохиргоонд<ph name="END_LINK" /> Chromium-д хандах эрх өгнө үү</translation>
<translation id="8132864687089402359">João Browser энэ өргөтгөлийг хаанаас ирсэн болохыг баталгаажуулах боломжгүй ба энэ нь аюултай байж магадгүй. Үүнийг João Browser-с хассанаар энэ нь цаашид хувийн мэдээллийг оруулаад зочилсон сайтуудын тань өгөгдлийг харах болон өөрчлөх боломжгүй болно.</translation>
<translation id="7600652022483599804">Хэрэв зурагт хэрэгтэй тайлбар байхгүй бол João Browser танд тайлбар өгөхөөр оролдох болно. Тайлбар үүсгэхийн тулд зургийг Google-д илгээнэ. Та үүнийг хүссэн үедээ тохиргоонд унтрааж болно.</translation>
<translation id="8703735741562140394">João Browser-д шинэ профайлаар нэвтрэх үү?</translation>
<translation id="2830039647655087365"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд João Browser-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн <ph name="DEVICE" />-с нууц үг болон бусад зүйлээ авна.</translation>
<translation id="1802935470126307750">Системийн жижиг тэмдэг бүхий хэсэгт João Browser дахь Gemini-г харуулж, товчлуурын шууд холбоосыг асаана уу</translation>
<translation id="8286943863733751221">Аюултай сайт болон татаж авсан файлын талаар <ph name="BEGIN_LINK" />Chromium танд сануулна<ph name="END_LINK" /></translation>
<translation id="8295827201165805317">Та ойрын үед зочлоогүй байна. Chromium <ph name="PERMISSION" />-г хассан.</translation>
<translation id="481989138594406896">João Browser iOS апп дээр харж буй зүйлээ камераараа худалдан авч, орчуулж, тодорхойлоорой</translation>
<translation id="5242426961520127942"><ph name="USER_NAME" />-р João Browser-д нэвтрэх QR код</translation>
<translation id="8313851650939857356">Эхлэхэд алдаа гарлаа: <ph name="STARTUP_ERROR" />.</translation>
<translation id="3644336211313412429">Танай байгууллага João Browser-г <ph name="TIMEOUT_DURATION" />-н турш ашиглаагүй үед хаадаг.</translation>
<translation id="8321888067342493336">Зургаар хадгалах</translation>
<translation id="3150519286474936594"><ph name="USER_EMAIL_ADDRESS" /> өмнө нь João Browser-г ашиглаж байсан</translation>
<translation id="8351551329754447960">Chromium-д Ур чадварыг идэвхжүүлэх</translation>
<translation id="4566781614303801262"><ph name="ACCOUNT_EMAIL" /> Google Бүртгэлдээ João Browser-н өгөгдлөө ашигласаар байхын тулд João Browser-г шинэчилнэ үү</translation>
<translation id="8404636483124146663">João Browser-н цаашдын шинэчлэлтийг авахын тулд танд Windows 10 эсвэл түүнээс хойших хувилбар хэрэгтэй болно. Энэ компьютер Windows 8-г ашиглаж байна.</translation>
<translation id="8362914115861174987">Дараах руу орчуулах</translation>
<translation id="8367705492654390392">Хүссэн зүйлээ асуугаарай</translation>
<translation id="8370517070665726704">Зохиогчийн эрх <ph name="YEAR" /> Google ХХК. Бүх эрх хуулиар хамгаалагдсан.</translation>
<translation id="8954225380790220359">Нууц үг болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд João Browser-д нэвтэрнэ үү. Таныг нэвтэрсний дараа энэ нууц үгийг Google Бүртгэлд тань хадгална.</translation>
<translation id="208035402574338948">Та тэгээд João Browser-г дахин эхлүүлэх шаардлагатай болно.</translation>
<translation id="7458698097055456629">João Browser танд үүнийг хасахыг зөвлөж байна. <ph name="BEGIN_LINK" />Дэмжигдсэн өргөтгөлийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK" /></translation>
<translation id="3428558977667883100">Энэ өргөтгөлийг хөгжүүлэгч нь нийтлэхээ больсон бөгөөд энэ нь аюултай байж магадгүй. Үүнийг João Browser-с хассанаар энэ нь цаашид таны хувийн мэдээллийг оруулаад зочилсон сайтуудын тань өгөгдлийг харах болон өөрчлөх боломжгүй болно.</translation>
<translation id="5012944467031125860">Зарим өгөгдлийг таны Google Бүртгэлд хадгалж, бүх төхөөрөмж дээр тань ашиглах боломжтой болохын өмнө João Browser таныг мөн болохыг баталгаажуулах шаардлагатай. Хэрэв та одоо гарвал энэ өгөгдлийг устгана.</translation>
<translation id="8822543678238892300">{0,plural, =1{João Browser-г 1 хоногийн дотор дахин ажиллуулна уу}other{João Browser-г # хоногийн дотор дахин ажиллуулна уу}}</translation>
<translation id="8438543370129609977">Таныг Зурган хайлтыг ашиглахад хуудасны гарчиг, URL, PDF зэрэг контентыг сервер лүү илгээдэг. <ph name="LEARN_MORE" /></translation>
<translation id="4307944272317199640">João Browser-д Зурган хайлтаар хайх талаар нэмэлт мэдээлэл авах</translation>
<translation id="6024135746436350583">Суулгагчийн архив устгагдсан эсвэл хүчингүй болсон байна. João Browser-ыг дахин татаж авна уу.</translation>
<translation id="4933173390191738516">João Browser нь Windows 10 эсвэл түүнээс дээших хувилбарыг шаарддаг.</translation>
<translation id="8463672209299734063">Заавал биш: Оношилгоо болон ашиглалтын өгөгдлийг Google-д автоматаар илгээснээр ChromiumOS-н онцлогууд, гүйцэтгэлийг сайжруулахад тусална уу.</translation>
<translation id="4499703930846496679">Google Бүртгэлдээ João Browser-н өгөгдлийг ашиглах, хадгалахын тулд өөрийгөө мөн болохыг баталгаажуулна уу</translation>
<translation id="8482493977473846331">Chromium-д нэвтрэх заавар харуулна</translation>
<translation id="2129903037617090425">João Browser нь хуучирсан байна</translation>
<translation id="850264194101621529">Chromium-г өгөгдмөл хөтчөөрөө сонгосонд баярлалаа!</translation>
<translation id="8522801943730206384">Таныг нууц үгнүүдээ хадгалах үед Chromium тэдгээрийг шалгах боломжтой</translation>
<translation id="8525579356836940628">Суулгахыг зогсоосон</translation>
<translation id="2445505893586445499"><ph name="DEVICE_TYPE" /> дээрээ João Browser аппыг ашиглан нууц үг, таб болон бусад зүйлээ явж байх зуураа аваарай</translation>
<translation id="8548787790260785208">Хэрэв Chromium таны аль нэг нууц үгийг олон нийтийн өгөгдлийн зөрчлөөс олбол сануулга аваарай</translation>
<translation id="8555465886620020932">Үйлчилгээний алдаа: <ph name="SERVICE_ERROR" />.</translation>
<translation id="8871890913961794658">João Browser-н зарим онцлог, өргөтгөл товчлолтой ирдэг. Та тэдгээрийг буцааж асааж болно.</translation>
<translation id="8556420416730706394">Та хялбар хандахын тулд Зурган хайлтыг бэхлэх боломжтой. Хажуугийн самбарын дээд талд байх Бэхлэх товчийг товшино уу</translation>
<translation id="856656450041460113">Хэлний жагсаалтаас хайх</translation>
<translation id="9044172203094901282">Олон байгууллага João Browser-г удирддаг</translation>
<translation id="8586442755830160949">Chromium-ийн зохиогчийн эрх <ph name="YEAR" />. Бүх эрхийг хуулиар хамгаалсан.</translation>
<translation id="8601359445272098721">Шинэ! Та "дэлгэцийг орчуулах" товчийг сонгож дэлгэц дээрх текст, зургийн аль алиныг орчуулах боломжтой</translation>
<translation id="1071663705626404814">João Browser-г эхлүүлж байна...</translation>
<translation id="8624541899164515475">Тохиргоо, шинэ табд нээгдэнэ.</translation>
<translation id="8648201657708811153">Google Chrome for Testing-г өгөгдмөл хөтчөө болгох боломжгүй.</translation>
<translation id="5975137268566279898">Энэ нь мөн таныг João Browser-ыг эхлүүлж байх үед эсвэл Omnibox-аас хайлт хийж буй үед гарч ирдэг хуудсыг хянаж байдаг.</translation>
<translation id="6358904712334248114">Энэ бол таны João Browser.</translation>
<translation id="8712637175834984815">Ойлголоо</translation>
<translation id="5380190167074430719">João Browser-д нэвтрэх үү?</translation>
<translation id="8747073452963259673">хайлтын хэсгийн зүүн доод булан: зүүн <ph name="LEFT" />%, доод <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">Суулгах үед алдаа гарлаа: Танай сүлжээний админ суулгалтаас сэргийлдэг Бүлгийн бодлогыг хэрэгжүүлсэн: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Надад дараа сануулах</translation>
<translation id="8871607387186266158">Шуурхай тойм авах, араас нь лавлах асуулт асуухын тулд энэ баримт бичгийг João Browser дахь Gemini-тай хуваалцана уу</translation>
<translation id="3009329613270131861">João Browser-д нэвтрэх үү?</translation>
<translation id="8823401858233292222">Chromium-г өгөгдмөл хөтөч болгож, ажлын хэсэгт бэхэлнэ үү</translation>
<translation id="8826492472752484139">“Нууц үгний менежер”-ийг товшино уу</translation>
<translation id="8833697763442816810">ChromiumOS систем</translation>
<translation id="8852026904190808918">Энэ хэлийг Chromium-д цэс, тохиргоо, сэрэмжлүүлэг болон бусад текстийг үзүүлэхэд ашигладаг</translation>
<translation id="8862326446509486874">Танд системийн түвшинд суулгах зохих эрх байхгүй байна. Суулгагчийг админы хувиар дахин ажиллуулахыг оролдож үзнэ үү.</translation>
<translation id="6821836710312478344">João Browser-н профайл нэмэх</translation>
<translation id="5139769635207740615">Нэвтрэх алдааны улмаас ChromiumOS таны Google Бүртгэлд João Browser-н өгөгдлийг хадгалж чадсангүй</translation>
<translation id="6814613825007700341">Танай байгууллага таныг João Browser-д нэвтрэхийг шаардаж байна</translation>
<translation id="1009831347869773172">João Browser нь нууц үгийг харуулахыг оролдож байна. Үүнийг зөвшөөрөхөөр бол  Windows нууц үгээ бичнэ үү.</translation>
<translation id="690637523240192979">João Browser таны өгөгдмөл хөтөч биш болсон байна. João Browser-г өгөгдмөл хөтөч болгох уу?</translation>
<translation id="225046375773654931">João Browser-г шинэчилж чадсангүй</translation>
<translation id="8944232836376404813">Энэ үйлдэл:
          <ph name="LINE_BREAKS" />
            • Таны эхлүүлэх хуудас, шинэ таб хуудас, хайлтын систем, бэхэлсэн табыг шинэчилнэ
            <ph name="LINE_BREAK" />
            • Өргөтгөлүүдийг идэвхгүй болгоно
            <ph name="LINE_BREAK" />
            • Күүки болон сайтын бусад түр өгөгдлийг устгана
            <ph name="LINE_BREAKS" />
            Хавчуурга, түүх, хадгалсан нууц үгэнд нөлөөлөхгүй.</translation>
<translation id="4349474976990059197">João Browser Enterprise-н лого</translation>
<translation id="3227699293368317033"><ph name="DEVICE_TYPE" /> дээрээ João Browser аппыг ашиглан Google-н аюулгүй байдлын онцлогуудыг явж байх зуураа аваарай</translation>
<translation id="6527164294507620103">Таны профайлыг нээхэд ямар нэг алдаа гарсан тул João Browser-г эхлүүлэх боломжгүй. João Browser-г дахин эхлүүлж үзнэ үү.</translation>
<translation id="6741767563284518125">João Browser-н профайлуудыг удирдах</translation>
<translation id="3101491883380219087">João Browser дахь Gemini, нээлттэй табынхаа хооронд шилжихэд гараа ашиглана уу.</translation>
<translation id="9018218886431812662">Суулгаж дууссан</translation>
<translation id="3370247132646333337">João Browser-г илүү аюулгүй болгохын тулд <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> жагсаалтанд байхгүй, танд мэдэгдэлгүйгээр нэмэгдсэн байж болох дараах өргөтгөлийг идэвхгүй болголоо.</translation>
<translation id="1940116386572548863">João Browser дансандаа нэвтрэх</translation>
<translation id="8381652653666868014">Архивын файлд хортой программыг нууж байж магадгүй бусад файл багтдаг тул João Browser энэ таталтыг блоклосон</translation>
<translation id="8374335201144490555">Нууц үг, хавчуурга, түүхээ төхөөрөмжүүд дээр төгс синк хийсээр байгаарай. Та өгөгдмөл хөтчөө João Browser болгон шинэчлээд мэддэг, дуртай онцлогууддаа хялбархан хандаарай. João Browser-г шуурхай хандахад зориулж таны ажлын хэсэгт бэхэлнэ.</translation>
<translation id="6176486087616698123">Утсан дээрээ João Browser аппаар Google-н шилдэг ХОУ-ы хэрэгслүүдийг ашиглаарай</translation>
<translation id="9062666675513499497">Та Google-н бусад үйлчилгээнд нэвтрэх үедээ Chromium-д нэвтэрнэ үү</translation>
<translation id="724802823738504651">João Browser-г автоматаар хаасан</translation>
<translation id="2689333215784698609">João Browser хуучирсан байна</translation>
<translation id="8049510467237146160">{0,plural, =1{João Browser-г 1 цагийн дотор дахин ажиллуулна}other{João Browser-г # цагийн дотор дахин ажиллуулна}}</translation>
<translation id="9106236359747881194">Хайх текстийг сонгоно уу</translation>
<translation id="8558551666630075184">João Browser-н цаашдын шинэчлэлтийг авахын тулд танд Windows 10 эсвэл түүнээс хойших хувилбар хэрэгтэй болно. Энэ компьютер Windows 8.1-г ашиглаж байна.</translation>
<translation id="1194819784870407331">Холбоосыг шинэ João Browser болон табад нээх</translation>
<translation id="911206726377975832">Хайлтын мэдээллээ бас устгамаар байна уу?</translation>
<translation id="9134482777260927479">Гэрийн даалгаврын тусламж</translation>
<translation id="9148058034647219655">гарах</translation>
<translation id="548951409840319583">Орхисон газраасаа үргэлжлүүлнэ үү: João Browser таныг дахин эхлүүлэх бүрд табуудыг тань сэргээж болно. Үүнийг асаахын тулд дараах руу очно уу</translation>
<translation id="7614949510548815395">Таны системийн админ João Browser-г<ph name="TARGET_URL_HOSTNAME" />-д хандахын тулд өөр хөтөч нээхээр тохируулсан байна.</translation>
<translation id="3441698750089879771">&amp;João Browser-г шинэчлэхийн тулд дахин ачаалах</translation>
<translation id="369689859238510548">João Browser (mDNS-In)</translation>
<translation id="8336832914816665097">João Browser-г өөрийн болгоoрой</translation>
<translation id="7698429329590050365">Windows XP болон Windows Vista нь цаашид João Browser-г дэмжихгүй тул буруу ажиллаж болзошгүй</translation>
<translation id="190261805571697214">João Browser-р Google-н аюулгүй байдлын шилдэг онцлогуудыг явж байх зуураа аваарай.</translation>
<translation id="945522503751344254">Санал хүсэлт илгээх</translation>
<translation id="5554799509799759090">João Browser-г хэн ашиглаж байна вэ?</translation>
<translation id="9153108844196984904">João Browser-н хамгийн хүчирхэг аюулгүй байдлыг аваарай</translation>
<translation id="983803489796659991">Шинэчлэлтийн серверт аппликэйшнд зориулсан ямар нэг хэш өгөгдөл байгаагүй тул суулгалт амжилтгүй болсон.</translation>
<translation id="6230710687825107323">João Browser-г бүртгэлгүйгээр ашиглах</translation>
<translation id="985602178874221306">Chromium-ыг бүтээгчид</translation>
<translation id="989970834842471429">Зурган хайлтаар хайхын тулд дурын текст, зургийг сонгоно уу</translation>
<translation id="992780518932311116">Байршлаа ашиглахын тулд <ph name="BEGIN_LINK" />системийн тохиргоонд<ph name="END_LINK" /> Chromium-д хандах эрх өгнө үү</translation>
