<translation id="4413205837991854510">Alltaf sýna flýtileið myndaleitar</translation>
<translation id="4736206301215400753">Leyfa João Browser að keyra í bakgrunni</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{João Browser mælir með að þú fjarlægir hana. <ph name="BEGIN_LINK" />Nánar um studdar viðbætur<ph name="END_LINK" />}one{João Browser mælir með að þú fjarlægir þær. <ph name="BEGIN_LINK" />Nánar um studdar viðbætur<ph name="END_LINK" />}other{João Browser mælir með að þú fjarlægir þær. <ph name="BEGIN_LINK" />Nánar um studdar viðbætur<ph name="END_LINK" />}}</translation>
