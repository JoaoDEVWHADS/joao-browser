<translation id="576637711620229618">ইয়াত আপুনি João Browserৰ প্ৰ’ফাইলসমূহৰ মাজত সালসলনি কৰিব পাৰে</translation>
<translation id="615103374448673771">আপুনি যদি কুকিৰ অনুমতি দিয়ে, আগতীয়াকৈ ল’ড কৰোঁতে Chromiumএ সেয়া ব্যৱহাৰ কৰিব পাৰে</translation>
<translation id="6165508094623778733">অধিক জানক</translation>
<translation id="3738215896821824918">আপোনাৰ একাউণ্টৰ João Browserৰ ডেটা মচক</translation>
<translation id="2145111683361496197">এই ফাইলটো ক্ষতিকাৰক হ’ব পাৰে<ph name="LINE_BREAK" />যদি আপুনি পাছৱৰ্ডটো প্ৰদান কৰে, তেন্তে João Browserএ এই ডাউনল’ডটো আপোনাৰ বাবে পৰীক্ষা কৰিব পাৰে। ফাইলটোৰ বিষয়ে তথ্য Googleৰ সুৰক্ষিত ব্ৰাউজিঙলৈ পঠিওৱা হয়, কিন্তু ফাইলৰ সমল আৰু পাছৱৰ্ড আপোনাৰ ডিভাইচতে থাকে।</translation>
<translation id="6182736845697986886">আপডে’ট ছাৰ্ভাৰৰ অভ্যন্তৰীণ আসোঁৱাহৰ বাবে ইনষ্টলেশ্বন কৰিব পৰা নগ’ল।</translation>
<translation id="6050294746023477088">আপোনাৰ <ph name="TARGET_DEVICE_NAME" />ত João Browserত আপুনি ছাইন ইন হৈ থকাটো নিশ্চিত কৰক আৰু তাৰ পাছত পুনৰ পঠিয়াবলৈ চেষ্টা কৰক।</translation>
<translation id="3395167674702947885">এই কম্পিউটাৰটোত ইতিমধ্যে João Browserৰ অধিক শেহতীয়া সংস্কৰণ আছে। যদি ছফ্টৱেৰটোৱে কাম কৰা নাই তেন্তে João Browser আনইনষ্টল কৰি আকৌ চেষ্টা কৰক।</translation>
<translation id="4384214545531685923">{0,plural, =0{এতিয়া João Browser পুনৰ লঞ্চ হ’ব}=1{১ ছেকেণ্ডত João Browser পুনৰ লঞ্চ হ’ব}one{# ছেকেণ্ডত João Browser পুনৰ লঞ্চ হ’ব}other{# ছেকেণ্ডত João Browser পুনৰ লঞ্চ হ’ব}}</translation>
<translation id="5880255774989397049">João Browserক ফাইল ডাউনল’ড কৰিবলৈ ষ্ট’ৰেজৰ এক্সেছৰ অনুমতিৰ আৱশ্যক</translation>
<translation id="6245734527075554892">Chromiumত ষ্ট’ৰ কৰি ৰখা অসুৰক্ষিত ছাইটসমূহৰ এখন সূচীৰ সৈতে URLসমূহ পৰীক্ষা কৰে</translation>
<translation id="1959823478027154444">João Browserক ডিফ’ল্ট ব্ৰাউজাৰ বনাওক</translation>
<translation id="6248988683584659830">সন্ধান সম্পৰ্কীয় ছেটিংসমূহ</translation>
<translation id="9191635841540101343">আপোনাৰ ফ’নত João Browser এপ্‌টোৰ জৰিয়তে অন্য কামৰ মাজতো Googleৰ শ্ৰেষ্ঠ সুৰক্ষা সম্পৰ্কীয় সুবিধাসমূহ পাওক</translation>
<translation id="538350741885862188">João Browserৰ পৰা ছাইন আউট কৰিবনে?</translation>
<translation id="161121067714522736">এই টেবসমূহে অতিৰিক্ত সম্পদ ব্যৱহাৰ কৰি আছে। আপোনাৰ কাৰ্যদক্ষতা উন্নত কৰিবলৈ João Browserক সেইসমূহ নিষ্ক্ৰিয় কৰিবলৈ দিয়ক।</translation>
<translation id="2095090272560293574">আপোনাৰ João Browser প্ৰ’ফাইল কাষ্টমাইজ কৰক</translation>
<translation id="6290827346642914212">আপোনাৰ Chromium প্ৰ’ফাইল নাম দিয়ক</translation>
<translation id="6472525517562723285">এটা এক্সটেনশ্বনে আপুনি João Browserত ছাইন ইন কৰাটো বিচাৰে</translation>
<translation id="2069878195899746465"><ph name="FILE_NAME" /> বিপজ্জনক হ’ব পাৰে সেয়ে João Browserএ এইটো অৱৰোধ কৰিছে।</translation>
<translation id="1283909912629029170">João Browserএ আপোনাৰ কেমেৰা ব্যৱহাৰ কৰি আছে।</translation>
<translation id="323902744000752306">João Browserত অন্য এটা কার্য চলি আছে। অনুগ্ৰহ কৰি কিছু সময়ৰ পাছত আকৌ চেষ্টা কৰক।</translation>
<translation id="1292164882596462877">বর্তমান আপোনাৰ Google একাউণ্টৰ জৰিয়তে আৰু শ্বেয়াৰ কৰা কম্পিউটাৰসমূহ সহজে João Browser ব্যৱহাৰ কৰিব পৰা যায়।</translation>
<translation id="6411450594978516531">João Browserক আপোনাৰ ডিফ’ল্ট ব্ৰাউজাৰ হিচাপে ছেট কৰি আপুনি জনা, ভালপোৱা আৰু বিশ্বাস কৰা সুবিধাসমূহ সহজে এক্সেছ কৰক।</translation>
<translation id="3344301749774719950">João Browserৰ শ্বৰ্টকাট</translation>
<translation id="8395825163097750991">এই ফাইলটো সাধাৰণতে ডাউনল’ড কৰা নহয় আৰু ই বিপজ্জনক হ’ব পাৰে বাবে João Browserএ এই ডাউনল’ডটো অৱৰোধ কৰিছে</translation>
<translation id="7683737657427846440">আপুনি João Browser আনইনষ্টল কৰিবলৈ বিচৰাটো নিশ্চিতনে?</translation>
<translation id="6375219077595103062">Password Managerৰ এটা শ্বৰ্টকাট যোগ দিয়ক</translation>
<translation id="6388799252195623474">এই ক্ষেত্ৰত মোক সহায় কৰক</translation>
<translation id="6966523531135953867">অব্যাহত ৰাখিবলৈ João Browserত <ph name="EMAIL" /> হিচাপে ছাইন ইন কৰক। এইটোৱে নিশ্চিত কৰে যে আপুনি আপোনাৰ প্ৰতিষ্ঠানৰ নীতিবোৰ জানে।</translation>
<translation id="5146608242127807773">কম্পিউটাৰৰ স্ক্ৰীনত João Browser লগ'।</translation>
<translation id="6361476216650509195">João Browser হৈছে ৱেবপৃষ্ঠা আৰু এপ্লিকেশ্বনসমূহক বিজুলী বেগেৰে চলোৱা এক ৱেব ব্ৰাউজাৰ। এইটো ক্ষিপ্ৰ, স্থিৰ আৰু ব্যৱহাৰৰ বাবে সুবিধাজনক। মালৱেৰ আৰু ফিশ্বিঙৰ পৰা বিশেষভাৱে সুৰক্ষা পোৱা সুবিধাৰে নির্মিত João Browser ৰ জৰিয়তে অতি সুৰক্ষিতভাৱে ৱেব ব্ৰাউজিং কৰক।</translation>
<translation id="7864687914956920860">আপোনাৰ Google একাউণ্টত আপুনি সদায়েই João Browserৰ ডেটা ব্যৱহাৰ আৰু ছেভ কৰিব পৰাটো নিশ্চিত কৰিবলৈ, এয়া আপুনিয়েই বুলি সত্যাপন কৰক</translation>
<translation id="1160920197193662978">João Browser অধিক দ্ৰুততাৰে চলে আৰু JavaScript ব্যৱহাৰ কৰা সুবিধাসমূহে ডিজাইন কৰা অনুসৰি কাম কৰিব লাগে</translation>
<translation id="6436260184216827876">প্ৰতিচ্ছবিৰ সন্ধান সুবিধাটো উপলব্ধ নহয়। পাছত পুনৰ চেষ্টা কৰক।</translation>
<translation id="6442900851116057561">ChromiumOS ৰিষ্টাৰ্ট কৰক</translation>
<translation id="6443470774889161065">Chromiumএ আপুনি চোৱাৰ সম্ভাৱনা থকা অধিক পৃষ্ঠা আগতীয়াকৈ ল’ড কৰে, যাতে আপুনি সেইবোৰ চালে সেইবোৰ অধিক ক্ষিপ্ৰতাৰে ল’ড হয়</translation>
<translation id="3730564967922511625">মূল্য ট্ৰেক কৰিবলৈ আৰু কোনো ছাইটত মূল্য কমিলে সতৰ্কবাৰ্তা পাবলৈ আপোনাৰ ফ’নত João Browser ডাউনল’ড কৰক</translation>
<translation id="3753019081686930624">অফ আছে • এই এক্সটেনশ্বনটো ক’ৰ পৰা আহিছে সেয়া João Browserএ সত্যাপন কৰিব নোৱাৰে</translation>
<translation id="5444641426058108434">João Browserৰ প্ৰ’ফাইললৈ স্বাগতম</translation>
<translation id="5103470775766355478">পৰৱৰ্তী সময়ত আপুনি নিজৰ <ph name="DEVICE_TYPE" />ত João Browser খুলিলে, আপুনি টেবৰ গোট ব্যৱহাৰ কৰিবলৈ কোৱা এটা প্ৰ’ম্পট্‌ দেখা পাব।</translation>
<translation id="9087231386723579740">João Browserৰ পৰা একাউণ্ট আঁতৰাওক</translation>
<translation id="4984395209542302039">আপুনি João Browser আৰম্ভ কৰিলে কি পৃষ্ঠা দেখুওৱা হ'ব সেয়াও ই নিয়ন্ত্ৰণ কৰে।</translation>
<translation id="648319183876919572">বৰ্ধিত সুৰক্ষিত ব্ৰাউজিঙে আপোনাক বিপজ্জনক ৱেবছাইট আৰু ডাউনল’ডৰ পৰা সুৰক্ষিত কৰিবলৈ অধিক কাৰ্য কৰে</translation>
<translation id="1524792685704191751">João Browser আনইনষ্টল কৰক</translation>
<translation id="6637504267182028286">João Browser খুলিবলৈ শ্বৰ্টকাট</translation>
<translation id="1478247638436966279">João Browser <ph name="TIMEOUT_DURATION" />ৰ বাবে ব্যৱহাৰ নকৰিলে আপোনাৰ প্ৰতিষ্ঠানে ইয়াক বন্ধ কৰে। ব্ৰাউজিঙৰ ডেটা মচা হৈছে। ইয়াৰ ভিতৰত ইতিহাস, স্বয়ংক্ৰিয়ভাৱে পূৰ হোৱাৰ সুবিধা আৰু ডাউনল’ড অন্তৰ্ভুক্ত হ’ব পাৰে।</translation>
<translation id="1311233187253046133">প্ৰতিটো প্ৰ'ফাইলে ইয়াৰ নিজৰ João Browserৰ তথ্য ৰাখে, যেনে বুকমাৰ্ক, ইতিহাস, পাছৱৰ্ড আৰু অধিক</translation>
<translation id="6563921047760808519"><ph name="BEGIN_LINK" />Chromiumএ কেনেকৈ আপোনাৰ ডেটা ব্যক্তিগত কৰি ৰাখে<ph name="END_LINK" /> সেই বিষয়ে অধিক জানক</translation>
<translation id="1643078533228697915">João Browser ৰিষ্টাৰ্ট হোৱাৰ পাছত এই ছেটিঙত কৰা সালসলনিসমূহ প্ৰয়োগ কৰা হ’ব।</translation>
<translation id="1918630514771863338">João Browserৰ মুখ্য মেনুৰ এক্সটেনশ্বনত ক্লিক কৰি আপোনাৰ এক্সটেনশ্বনসমূহ পৰিচালনা কৰক।</translation>
<translation id="4229328298978407243">অন্য এটা João Browserৰ প্ৰ’ফাইলৰ পৰা পাছৱৰ্ডসমূহ চাবলৈ আপুনি সলনি কৰিব পাৰে</translation>
<translation id="7717252965531997879">João Browser এপ্‌টোৰ জৰিয়তে শ্ৰেষ্ঠ AI সঁজুলি যিকোনো ঠাইতে ব্যৱহাৰ কৰক</translation>
<translation id="6570579332384693436">বানান শুদ্ধ কৰিবলৈ Chromiumএ আপুনি পাঠ অন্তৰ্ভুক্ত কৰিবলৈ থকা ক্ষেত্ৰসমূহত টাইপ কৰা পাঠখিনি Googleলৈ পঠিয়ায়</translation>
<translation id="5374627817618267090">João Browserৰ জাননীৰ ছেটিংসমূহ-লৈ চাওক</translation>
<translation id="6600016381025017075">এই পৃষ্ঠাখনত যিকোনো বস্তু সন্ধান কৰক</translation>
<translation id="264335610358256197">আপুনি পৰৱৰ্তী সময়ত João Browser পুনৰ লঞ্চ কৰিলে আপুনি কৰা সলনিসমূহ কাৰ্যকৰী হ’ব।</translation>
<translation id="2657584510687441826">João Browser এতিয়া Windows ষ্টাৰ্ট হোৱাৰ লগে লগে লঞ্চ কৰা হয় যাতে আপুনি তাৎক্ষণিকভাৱে ব্ৰাউজ কৰিবলৈ আৰম্ভ কৰিব পাৰে। আপুনি ছেটিঙত এই সুবিধাটো অফ কৰিব পাৰে।</translation>
<translation id="5482413402708094860">আপুনি য’ত এৰিছিল তাৰ পৰা অব্যাহত ৰাখক: João Browserএ আপোনাৰ অন্তিম ছেশ্বনটোৰ পৰা আপোনাৰ টেবসমূহ পুনঃস্থাপন কৰিছে। আপুনি ইয়াত এইটো অফ কৰিব পাৰে</translation>
<translation id="5022765692226673603">আপোনাৰ ওচৰ-পাজৰৰ ঠাইসমূহৰ এখন 3D মেপ সৃষ্টি কৰিবলৈ João Browserক কেমেৰাৰ অনুমতিৰ আৱশ্যক</translation>
<translation id="6669284030132180248">যদি আপুনি নিজৰ Google একাউণ্টত নিজৰ বুকমাৰ্কসমূহো ছেভ কৰে, আপুনি Chromiumত প্ৰ’ডাক্টৰ দামসমূহ ট্ৰেক কৰিব পাৰে আৰু দাম কৰিলে জাননী পাব পাৰে</translation>
<translation id="6676384891291319759">ইণ্টাৰনেট এক্সেছ কৰক</translation>
<translation id="668175097507315160">ছাইন ইন কৰোঁতে আসোঁৱাহ হোৱাৰ কাৰণে ChromiumOSএ আপোনাৰ ডেটা ছিংক কৰিব নোৱাৰিলে।</translation>
<translation id="3982573751008180181">João Browserৰ পৰা এই এপৰ ডেটা আঁতৰাওক</translation>
<translation id="5613723096388999601">João Browserক এই ছাইটটোৰ বাবে মাইক্ৰ’ফ’নৰ অনুমতিৰ আৱশ্যক</translation>
<translation id="6712881677154121168">ডাউনল’ড সম্পর্কীয় আসোঁৱাহ: <ph name="DOWNLOAD_ERROR" /></translation>
<translation id="9190188975825967506">আপোনাৰ প্ৰ’ফাইল ব্যৱহাৰ কৰিব নোৱাৰি কাৰণ এয়া João Browserৰ এক নতুন সংস্কৰণ।

কিছুমান সুবিধা নাথাকিব পাৰে। অনুগ্ৰহ কৰি অন্য কোনো প্ৰ’ফাইল ডাইৰেক্টৰী নির্দিষ্ট কৰক বা João Browserৰ নতুন সংস্কৰণ ব্যৱহাৰ কৰক।</translation>
<translation id="6729124504294600478">ব্যক্তিগতকৰণ আৰু অন্য সুবিধাসমূহ পাবলৈ, ৱেব আৰু এপৰ কাৰ্যকলাপত Chromium আৰু লিংক কৰি থোৱা Google সেৱাসমূহক অন্তৰ্ভুক্ত কৰক</translation>
<translation id="6957684879859415418">João Browser আপোনাৰ কম্পিউটাৰত থকা সকলো ব্যৱহাৰকাৰীৰ বাবে ইতিমধ্যেই ইনষ্টল কৰা হৈছে।</translation>
<translation id="4411262692912917677">আপোনাৰ আটাইবোৰ ডিভাইচত নিজৰ বুকমাৰ্ক আৰু অধিক পাবলৈ, João Browserত ছাইন ইন কৰক। এই বুকমাৰ্কটো আপোনাৰ Google একাউণ্টত আপুনি ছাইন ইন কৰাৰ পাছত ছেভ কৰা হ’ব।</translation>
<translation id="6064901610880747710">João Browserৰ V8 ইঞ্জিনৰ সৈতে ছাইটবোৰ খৰতকীয়া কৰি তোলে কিন্তু João Browserক আক্ৰমণৰ পৰা সামান্য কম প্ৰতিৰোধী কৰে। এই ছেটিংটো অন হৈ আছে।</translation>
<translation id="4530735110472079436">{count,plural, =1{আপোনাৰ কিছুমান João Browser ডেটা এতিয়াও আপোনাৰ Google একাউণ্টত ছেভ কৰা হোৱা নাই। ছাইন আউট কৰাৰ আগতে কেইমিনিটমান অপেক্ষা কৰি চাওক। যদি আপুনি এতিয়াই ছাইন আউট কৰে, এই ডেটাখিনি (১ টা বস্তু) মচি পেলোৱা হ’ব।}one{আপোনাৰ কিছুমান João Browser ডেটা এতিয়াও আপোনাৰ Google একাউণ্টত ছেভ কৰা হোৱা নাই। ছাইন আউট কৰাৰ আগতে কেইমিনিটমান অপেক্ষা কৰি চাওক। যদি আপুনি এতিয়াই ছাইন আউট কৰে, এই ডেটাখিনি ({count} টা বস্তু) মচি পেলোৱা হ'ব।}other{আপোনাৰ কিছুমান João Browser ডেটা এতিয়াও আপোনাৰ Google একাউণ্টত ছেভ কৰা হোৱা নাই। ছাইন আউট কৰাৰ আগতে কেইমিনিটমান অপেক্ষা কৰি চাওক। যদি আপুনি এতিয়াই ছাইন আউট কৰে, এই ডেটাখিনি ({count} টা বস্তু) মচি পেলোৱা হ'ব।}}</translation>
<translation id="9176853308971176490">João Browserএ এই ফাইলটো স্কেন কৰাটো চুপাৰিছ কৰে কাৰণ ই বিপজ্জনক হ’ব পাৰে।</translation>
