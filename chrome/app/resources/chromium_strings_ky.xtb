<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ky">
<translation id="1026101648481255140">Орнотууну улантуу</translation>
<translation id="1029669172902658969">&amp;ChromiumOS системасын жаңыртуу үчүн кайра иштетиңиз</translation>
<translation id="4711726241445951349">João Browser бул кеңейтүүнү карап көрүүнү сунуштайт</translation>
<translation id="1042552502243217427">Cайт барактагы шилтемелерди алдын ала жүктөөнү суранса, Chromium Google'дун серверлерин колдонот. Ушуну менен өздүгүңүз тууралуу маалымат алдын ала жүктөлгөн сайттан жашырылат, бирок Google кайсы сайттар алдын ала жүктөлгөнүн билет.</translation>
<translation id="1051793555070215510">Бул 1 мүнөттүк сурамжылоого катышып, Жашыруун режимди жакшыртууга жардам бериңиз.</translation>
<translation id="1065672644894730302">Жеке жөндөлөөрүңүз окулбай жатат.

Айрым мүмкүнчүлүктөр иштебегендиктен, жеке жөндөөлөрдөгү өзгөрүүлөр сакталбайт.</translation>
<translation id="3937976866851867994">Ата-энең João Browser үчүн "Сайттарга, колдонмолорго жана кеңейтүүлөргө уруксаттарды" өчүрүп койгон</translation>
<translation id="8626021334348319355">João Browser'дун белгилүү бир функциясын же кеңейтүүсүн издөө үчүн дарек тилкесине анын ыкчам баскычын, андан соң тандалган ыкчам баскычты териңиз</translation>
<translation id="9157778882771986870">João Browser сырсөздөрүңүздү экспорттогону жатат. Ага уруксат берүү үчүн Windows аккаунтуңуздун сырсөзүн териңиз.</translation>
<translation id="112640046208448578">Нерселерди же жерлерди аныктап, текстти көчүрүп же которуңуз. Сүрөт издөө функциясын колдонгонуңузда, барактын скриншоту серверге жөнөтүлөт. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium демейки серепчи катары колдонулат</translation>
<translation id="1131805035311359397">Сырсөздөрүңүздүн бекем корголгонун, ошондой эле коопсуздукка байланыштуу көйгөйлөрдү текшерүү үчүн <ph name="BEGIN_LINK" />Chromium'га кириңиз<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">João Browser менюсун чыкылдатыңыз</translation>
<translation id="1157985233335035034">Жакында колдонулган тилдер</translation>
<translation id="1184145431117212167">Орнотулган жок, анткени Windows версияңыз колдоого алынбайт.</translation>
<translation id="1185134272377778587">Chromium жөнүндө</translation>
<translation id="667420476518265356">Телефонуңуздагы João Browser менен бааларга көз салуу тууралуу билдирмелерди алыңыз</translation>
<translation id="1203500561924088507">Орнотуп алганыңыз үчүн рахмат. <ph name="BUNDLE_NAME" /> топтомун колдонуп баштоодон мурда серепчини өчүрүп күйгүзүңүз.</translation>
<translation id="1232234696885483911">Сүрөт издөө функциясын ачканыңызда беттин аталышы, URL жана андагы нерселер, ошондой эле PDF файлдары автоматтык түрдө серверге жөнөтүлөт. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">Кирип турганыңызда João Browser'да Google аккаунтуңуздагы сырсөздөрдү жана башкаларды колдоно аласыз. Муну өзгөртүү үчүн "João Browser'дагы аккаунтуңуз" бөлүмүнө өтүңүз.</translation>
<translation id="4866003137980530528">Mac'тын меню тилкесинде João Browser'дагы Gemini'ды көрсөтүү</translation>
<translation id="2526294198551578217">João Browser'дагы Gemini'да экрандын бир бөлүгүн тандоо үчүн баскычтардын айкалышын колдонуңуз.</translation>
<translation id="7068536367561625920">Бул өтмөк активдүү эмес болгондо, João Browser'ду тез бойдон кармоо үчүн эстутум бошойт. Бул сайтты жигерсиз абалда болуудан ар дайым чыгара аласыз.</translation>
<translation id="3669854427836618143">Файл кооптуу болгондуктан, João Browser бул жүктөп алууну бөгөттөдү</translation>
<translation id="126567311906253476"><ph name="USER_EMAIL" /> менен Gmail же YouTube сыяктуу Google кызматтарына киргенде, Chromium'га ошол эле аккаунт менен автоматтык түрдө кире аласыз</translation>
<translation id="8094399825947986050">João Browser'ду телефонуңузга жүктөп алыңыз</translation>
<translation id="1290883685122687410">Тууралоо катасы: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">Жаңы João Browser профилин жөндөп алыңыз</translation>
<translation id="7591029065989504977">João Browser'да Gemini менен колдонуп көрүңүз</translation>
<translation id="8408989583029959522">João Browser&#32;
Bluetooth түзмөктөрүн изилдөө үчүн Bluetooth'ду пайдаланууга уруксат алышы керек. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">Телефонуңуздагы João Browser'га кириңиз</translation>
<translation id="1330562121671411446">Тил тандоо</translation>
<translation id="6026568602942276348">João Browser'дан да (<ph name="URL" />) дайындарды өчүрүү</translation>
<translation id="1345251407431278948">Кадалды! Эми Сүрөт издөө функциясын куралдар тилкесиндеги жаңы баскыч аркылуу колдоно аласыз</translation>
<translation id="1356661055722410047">Жаңылык! Экрандагы текстти да, сүрөттөрдү да которо аласыз</translation>
<translation id="1383876407941801731">Издөө</translation>
<translation id="5807085300679014096">João Browser колдонмосу менен жолдо жүргөндө да Интернетте издей бересиз</translation>
<translation id="141901961143729572">Ойлоруңузду бөлүшүңүз</translation>
<translation id="3736947618013031173">Терезени бөлүшүү үчүн Тутумдун параметрлеринен João Browser'га экрандан видео жаздырып алууга уруксат бериңиз.</translation>
<translation id="1478370723027452770">Chrome for Testing боюнча жардам алуу</translation>
<translation id="1497802159252041924">Орнотуу катасы: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Бул барак корголгон</translation>
<translation id="4379865404970367448">João Browser өтмөгүн бөлүшүү</translation>
<translation id="4436275659297289591">João Browser'га кирүү</translation>
<translation id="1547469039832541117">Бөлүнүп көрсөтүлгөн тапшырманы бүтүрөт.</translation>
<translation id="449712764049695153">João Browser'ду кадап коюу</translation>
<translation id="1574377791422810894">Chromium'дун коопсуздук куралдары</translation>
<translation id="5480232403718129394">João Browser Сырсөздөрдү башкаргычтагы маалыматтарыңызды өчүргөнү жатат. Ага уруксат берүү үчүн Windows аккаунтуңуздун сырсөзүн териңиз.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{Администраторуңуз жаңыртууну колдонуу үчүн João Browser'ду кайра иштетүүнү талап кылууда}=1{Администраторуңуз жаңыртууну колдонуу үчүн João Browser'ду кайра иштетүүнү талап кылууда. Жашыруун терезеңиз кайра ачылбайт.}other{Администраторуңуз жаңыртууну колдонуу үчүн João Browser'ду кайра иштетүүнү талап кылууда. # жашыруун терезеңиз кайра ачылбайт.}}</translation>
<translation id="980976428162070137">Телефонуңуздагы João Browser колдонмосу менен Google'дун бардык мүмкүнчүлүктөрүн пайдаланыңыз</translation>
<translation id="1625909126243026060">Chromium'дагы негизги купуялык жана коопсуздукту көзөмөлдөө каражаттарын карап көрүңүз</translation>
<translation id="1640672724030957280">Жүктөлүп алынууда...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" /> катары кирдиңиз. Катталгансыз. Аккаунттун менюсун ачуу</translation>
<translation id="1708414395296835197">Эми билдирүүлөрдөгү шилтемелерди, документтерди жана башка колдонмолорду Chromium'да ача аласыз. Ал тапшырмалар тактасына да кадалат.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> серепчисине жогорулатылган артыкчылыктар берилет.</translation>
<translation id="1722488837206509557">Бул сизге жеткиликтүү түзмөктөрдөн ичинен тандоого жана аларда контентти көрсөтүүгө мүмкүндүк берет.</translation>
<translation id="6972087163510342335">João Browser серептөө дайындарын жакында өчүрөт</translation>
<translation id="1736443181683099871">Chromium чабыттоолорду HTTPS'ке жаңыртканга аракет кылат</translation>
<translation id="3879288383593333401">João Browser дайындары тазаланды</translation>
<translation id="656496276885630888">João Browser <ph name="REMAINING_TIME" /> кийин кайра ачылат</translation>
<translation id="1749104137266986751">HTTPS жеткиликсиз болгондо, Chromium кооптуу туташууну сизге эскертпестен колдонот</translation>
<translation id="1226290419185955779">João Browser'го фондо иштөө мүмкүнчүлүгүн берүү</translation>
<translation id="4231366995273072370">Жеке маалыматыңызды коргоо үчүн, айрым João Browser кеңейтүүлөрүн өчүрүп койдук, себеби <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ичинде аларга байланыштуу маалымат жок. Демек, бул курамдык бөлүктөр тымызын орнотулган.</translation>
<translation id="1822049153969905781">Ыкчам ачуу максатында João Browser'ду тапшырмалар тактасына кадоо үчүн Windows билдирмесиндеги <ph name="BEGIN_BOLD" />Ооба<ph name="END_BOLD" /> дегенди басыңыз.</translation>
<translation id="1321831992638405531">João Browser'ду кайра орнотуу</translation>
<translation id="3386967202064865436">João Browser <ph name="AUTHENTICATION_PURPOSE" /> аракет кылып жатат</translation>
<translation id="70054449700528483">Кийинки жолу <ph name="DEVICE_TYPE" /> түзмөгүңүздө João Browser'ду ачканыңызда Сырсөздөрдү башкаргычты колдонуу сунушталат.</translation>
<translation id="1838374766361614909">Изделип жаткан нерсени өчүрүү</translation>
<translation id="5807096362853316123">Серептөө дайындарын ушул түзмөктөн өчүрүп, ал эми Google аккаунтуңузда сактап калуу үчүн <ph name="BEGIN_LINK" />João Browser'дан чыгыңыз<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">Жолдо баратканда жаңы өтмөк топторун ачуу же түзүү үчүн телефонуңузга João Browser'ду жүктөп алыңыз.</translation>
<translation id="185970820835152459">Кирип турган Google аккаунттарыңызды башкара аласыз. Google аккаунттарыңыз Chromium серепчисинде, Play Store'до, Gmail'де жана башка жерлерде колдонулат. Эгер кимдир бирөөнүн, мисалы, үй-бүлөлүк топтун мүчөсүнүн аккаунтун кошкуңуз келсе, жаңы адамды <ph name="DEVICE_TYPE" /> түзмөгүнө кошуп коюңуз. <ph name="LINK_BEGIN" />Кеңири маалымат<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Сүрөт издөө функциясы менен издеңиз</translation>
<translation id="65457771685016683"><ph name="EXISTING_USER" /> мурунтан эле кирип турат. Сиз серептеген нерселерди ажыратуу үчүн <ph name="USER_EMAIL_ADDRESS" /> катары өз профилиңизден João Browser'га кириңиз. Ошондой эле, <ph name="DEVICE" /> аккаунтуңуздагы кыстармаларды жана башка нерселерди аласыз.</translation>
<translation id="1880677175115548835">Текстти тандоо</translation>
<translation id="2634119629547215883">Башкарылган аккаунт менен кирип, анын администраторунун милдетин João Browser профилиңизге өткөрүп берип жатасыз. João Browser дайын-даректериңизди, колдонмолоруңузду, кыстармаларыңызды, таржымалыңызды, сырсөздөрүңүздү жана башка параметрлерди <ph name="USER_NAME" /> менен биротоло байланыштырат. Бул дайындарды Google Каттоо эсептеринин жеке кеңсеси аркылуу жок кылсаңыз болот, бирок бул дайындарды башка аккаунтка байлай албайсыз. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium жылма сыдыруу жана видеодогу кадрлардын жыштыгы сыяктуу визуалдык кубулуштарды жана фондогу аракеттерди чектөө менен батареянын кубатын үнөмдөйт. <ph name="BEGIN_LINK" />Кубатты үнөмдөгүч жөнүндө кеңири маалымат алыңыз<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">João Browser Updater Service</translation>
<translation id="1911763535808217981">Ушуну өчүрүү менен Gmail сыяктуу Google сайттарына Chromium'суз кире аласыз</translation>
<translation id="4037729269678342163">João Browser жооп бербей жатат. Өчүрүп кайра ишке киргизесизби?</translation>
<translation id="7563750688920581112">Уюмуңуз, <ph name="MANAGER" />, João Browser'га кирүүнү талап кылат</translation>
<translation id="193439633299369377">Жаңыртууну колдонуу үчүн ChromiumOS өчүрүлүп күйгүзүлүшү керек.</translation>
<translation id="7099143775283792684">Файл түрү аз жүктөлүп алынып, кооптуу болушу мүмкүн болгондуктан, João Browser бул жүктөп алууну бөгөттөдү</translation>
<translation id="1953553007165777902">Жүктөлүп алынууда... <ph name="MINUTE" /> мүнөт калды</translation>
<translation id="1966382378801805537">Chromium демейки серепчини аныктап же коё албай жатат</translation>
<translation id="197326043290947695">Сүрөт издөө функциясы менен акылдуураак карап чыгыңыз</translation>
<translation id="6185556991023272801">João Browser эмне үчүн айрым файлдарды бөгөттөгөнүн билип алыңыз, жаңы өтмөктө ачылат</translation>
<translation id="4053636705816895911">João Browser программасын жаңыртып турат. Эгер бул кызмат өчүрүлүп же токтотулса, João Browser программаңыз жаңыртылбайт, ал эми коопсуздукка коркунуч жаралса, ал оңдолбой жана функциялар иштебеши мүмкүн. João Browser программасы бул кызматты колдонбосо, ал өзү эле чыгарылып салынат.</translation>
<translation id="2008474315282236005">Ушуну менен түзмөктөгү 1 нерсе өчүрүлөт. Дайын-даректериңизди кийинчерээк чыгарып алуу үчүн Chromium'га <ph name="USER_EMAIL" /> аккаунту менен кириңиз.</translation>
<translation id="2018879682492276940">Орнотулбай калды. Кайталап көрүңүз.</translation>
<translation id="2039417478970545937">Параметрлер.</translation>
<translation id="2049376729098081731">Chromium таржымалын Google кызматтарын жекелештирүү үчүн колдонуп же колдонбоону тандаңыз</translation>
<translation id="6768767091114123654">João Browser'га алдын ала орнотулган жана татаал сырсөздөрдү түзүүгө, сактоого жана автотолтурууга жардам берет. Оңой кирүү үчүн ыкчам баскычты кошуңуз.</translation>
<translation id="3571664229232252557">João Browser'га жаңы көрүнүш берүү үчүн Жаңы өтмөк бетиндеги João Browser'ду ыңгайлаштыруу баскычын басыңыз</translation>
<translation id="4273287215573278663">Файл адаштыруучу болуп, түзмөгүңүзгө күтүлбөгөн өзгөртүүлөрдү киргизиши мүмкүн болгондуктан, João Browser бул жүктөп алууну бөгөттөдү</translation>
<translation id="9063967192437499581">Кийинки жолу João Browser iOS'ту ачканыңызда <ph name="FEATURE_NAME" /> функциясын колдонуп көрүү сунушталат.</translation>
<translation id="8511569826706775962">Сырсөздөрүңүз жана João Browser'дагы башка маалымат Google аккаунтуңузга сакталып, бул түзмөктөн өчүрүлөт. Аларды João Browser'да кайра колдонуу үчүн кайра кириңиз.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{João Browser 1 мүнөткө колдонулбаса, уюмуңуз серептөө дайындарын автоматтык түрдө өчүрөт. Бул таржымалды, автотолтурууну жана жүктөлүп алынгандарды камтышы мүмкүн. Өтмөктөрүңүз ачык бойдон калат.}other{João Browser # мүнөткө колдонулбаса, уюмуңуз серептөө дайындарын автоматтык түрдө өчүрөт. Бул таржымалды, автотолтурууну жана жүктөлүп алынгандарды камтышы мүмкүн. Өтмөктөрүңүз ачык бойдон калат.}}</translation>
<translation id="2125838419757773031">Издөө үчүн экрандагы аймакты тандаңыз</translation>
<translation id="2126108037660393668">Жүктөлүп алынган файл текшерүүдөн өтпөй калды.</translation>
<translation id="2135919691573380097">Бул сайт жөнүндө кабарлоо</translation>
<translation id="2137162749895930932">Которуу экранын жабуу</translation>
<translation id="1308845716497059117">Сайт кооптуу байланышты колдонуп, файл өзгөртүлүшү мүмкүн болгондуктан, João Browser бул жүктөп алууну бөгөттөдү</translation>
<translation id="2170098639895543546">Барактагы каалаган нерсени тандаңыз</translation>
<translation id="6705844023496387932">João Browser'ду ыңгайлаштыруу</translation>
<translation id="2174917724755363426">Орнотулган жок. Чын эле токтотосузбу?</translation>
<translation id="7728290795259244895">João Browser – Тармакка кирүү – <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Жаңыртууну текшерүү катасы: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">Аккаунтту João Browser'дан өчүрүү</translation>
<translation id="4648870374540039667">João Browser колдонмосу менен эң мыкты соода функцияларын жолдо жүргөндө да пайдаланыңыз</translation>
<translation id="2106116820042118250">iOS үчүн João Browser'да Өркүндөтүлгөн коопсуз серептөө менен жолдо коопсуздугуңузду камсыздаңыз</translation>
<translation id="2210682093923538346">Кооптуу сайт. Chromium билдирмелерди өчүрдү.</translation>
<translation id="2236949375853147973">Менин аракеттерим</translation>
<translation id="118764235932893741">Бардык түзмөктөрүңүздө даректерди жана башка нерселерди алуу үчүн João Browser'га кириңиз. Киргенден кийин бул дарек Google аккаунтуңузда сакталат.</translation>
<translation id="7254578863532089400">Компьютерди бөлүшсөңүз, жакындарыңыз өзүнчө серептеп, João Browser'ду өзүлөрү каалагандай орнотуп алышат.</translation>
<translation id="22571759390241347">Chromium'дагы жөндөмдөр</translation>
<translation id="2283803047247799269">Бул өтмөктө Сүрөт издөө функциясы аркылуу издөө</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{João Browser браузерди жайлаткан өтмөктөрдү тындырууну сунуштайт}other{João Browser браузерди жайлаткан өтмөктөрдү тындырууну сунуштайт}}</translation>
<translation id="2307973900865360088">Dock панелине кадап коюу</translation>
<translation id="2313870531055795960">Chromium'дагы кооптуу сайттардын тизмесиндеги URL даректерин текшерет. Эгер сайт сырсөзүңүздү уурдоого аракет кылса же кооптуу файлды жүктөп алсаңыз, Chromium URL даректерди, анын ичинде барактардагы мазмунду Коопсуз серептөөгө жөнөтүшү мүмкүн.</translation>
<translation id="2356070529366658676">Сураңыз</translation>
<translation id="2359808026110333948">Улантуу</translation>
<translation id="3800730051093461113">"<ph name="EXTENSION_NAME" />" кеңейтүүсүн колдонуу үчүн João Browser'га киришиңиз керек</translation>
<translation id="8758735062658446604">Колдонмолор үчүн фондо иштеген João Browser'ду өчүрүү</translation>
<translation id="2623595027619107207">Бул кеңейтүүнү <ph name="USER_EMAIL_ADDRESS" /> аккаунту менен колдонуу үчүн João Browser'га кириңиз.</translation>
<translation id="2384373936468275798">Аккаунтуңуздун кирүү чоо-жайлары эскирип калгандыктан, ChromiumOS дайын-даректериңизди шайкештештире алган жок.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{1 HID түзмөгүн бир же бир нече João Browser кеңейтүүсү пайдаланды}=1{1 HID түзмөгүн бир же бир нече João Browser кеңейтүүсү пайдаланууда}other{# HID түзмөгүн бир же бир нече João Browser кеңейтүүсү пайдаланууда}}</translation>
<translation id="6254788431480237503">João Browser'га бул сайтта камера менен микрофонду колдонууга уруксат бериңиз</translation>
<translation id="2403703063067034158">Ишке киргизүү катасы: Башка тууралоо процесси жүрүп жатат. Кийинчерээк кайталап көрүңүз.</translation>
<translation id="3028975423343897358">Бардык колдонмолордогу шилтемелерди João Browser'да ачып, серепчини тапшырмалар тактасынан жеткиликтүү кылыңыз</translation>
<translation id="579079006139156831">João Browser'дагы Gemini менен бул документти бөлүшүп, анын мазмуну менен таанышып, кошумча суроолорду берүү үчүн "Кыскача маалымат" баскычын басыңыз</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Chromium'дун куралдары<ph name="END_LINK" /> менен коопсуз серептеп, баарын көзөмөлдөй аласыз</translation>
<translation id="7114471809991869757"><ph name="EXISTING_USER" /> мурунтан эле кирип турат. Сиз серептеген нерселерди ажыратуу үчүн <ph name="USER_EMAIL_ADDRESS" /> катары өз профилиңизден João Browser'га кириңиз. Мындан тышкары, сырсөздөрүңүздү жана башкаларды бардык түзмөктөрүңүздө колдоно аласыз.</translation>
<translation id="2451727308784734061">Сырсөздөрдү башкаргычка тез өтүү үчүн ыкчам баскычты колдонуңуз. Ыкчам баскычты компьютердин башкы экранына же колдонмолорду ишке киргизгичке жылдыра аласыз.</translation>
<translation id="2709136733469807397">João Browser жакында жабылат</translation>
<translation id="3652225684487279741">João Browser'да</translation>
<translation id="2485422356828889247">Орнотуудан чыгаруу</translation>
<translation id="2513154137948333830">Өчүрүп-күйгүзүү талап кылынат: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Сүрөт издөө функциясы менен текстти тандаңыз</translation>
<translation id="1527474262707362156">João Browser учурдагы cырсөздөрдү өзгөртүүгө аракет кылууда. Ага уруксат берүү үчүн Windows аккаунтуңуздун сырсөзүн териңиз.</translation>
<translation id="6480371226914552131">Файлдарды жүктөп алуу үчүн João Browser сактагычка мүмкүнчүлүк алышы керек</translation>
<translation id="6318568902186985084">João Browser Жардамчы</translation>
<translation id="2575822587468774919">Сүрөт издөө функциясы менен издөө үчүн каалаган нерсени тандаңыз</translation>
<translation id="4557210258834653476">Бардык түзмөктөрүңүздө сырсөздөрдү жана башка нерселерди алуу үчүн João Browser'га кириңиз</translation>
<translation id="1148164459654218834">João Browser'ду жүктөп алып, Google аккаунтуңузга кирүү үчүн телефонуңуз менен QR кодду скандаңыз.</translation>
<translation id="235892353478111963">João Browser'ду колдоно берүү</translation>
<translation id="259935314519650377">Жүктөлүп алынган орноткучтун кеши түзүлбөй калды. Ката: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Система</translation>
<translation id="8471946631262724853">Уюмуңуз кыстармаларыңыз, таржымалыңыз жана сырсөздөрүңүз сыяктуу серептөө дайындарын көрүп, тескей алат. Ал башка João Browser профилдеринде серептөө дайындарын көрө албайт.</translation>
<translation id="2870759219964376597">Аккаунтуңузга (<ph name="ACCOUNT_EMAIL" />) João Browser маалыматын сактоо жана колдонуу үчүн өзүңүздү ырастаңыз</translation>
<translation id="2955972712254986678">{COUNT,plural, =0{Күчөтүлгөн коргоо жаңыртууну колдонуу үчүн João Browser'ду кайра иштетүүнү талап кылат}=1{Күчөтүлгөн коргоо жаңыртууну колдонуу үчүн João Browser'ду кайра иштетүүнү талап кылат. Жашыруун терезеңиз кайра ачылбайт.}other{Күчөтүлгөн коргоо жаңыртууну колдонуу үчүн João Browser'ду кайра иштетүүнү талап кылат. # жашыруун терезеңиз кайра ачылбайт.}}</translation>
<translation id="8949462882238006192">João Browser'ду иштетүү</translation>
<translation id="4224214204752803768">Орнотулуп жатканда иш системасында ката кетти. João Browser'ду кайра жүктөп алыңыз.</translation>
<translation id="3141414135710372892">Түзмөктү бөлүшсөңүз, жакындарыңыз өзүнчө серептеп, João Browser'ду өздөрү каалагандай тууралап алышат</translation>
<translation id="8838607803339100223">João Browser кичирейтилсе да, Gemini'ды түзмөгүңүздөгү João Browser'да оңой колдонуңуз.</translation>
<translation id="1679364578146271696">João Browser өтмөгү</translation>
<translation id="2718390899429598676">Кошумча коопсуздук үчүн, Chromium дайын-даректериңизди шифрлейт.</translation>
<translation id="1874696651662237927">Google аккаунтуңузду João Browser'дан өчүрүү үчүн чыгыңыз</translation>
<translation id="6850669719663104304">Бардык түзмөктөрүңүздө сырсөздөрдү, кыстармаларды жана башка нерселерди алуу үчүн João Browser'га кириңиз</translation>
<translation id="2738871930057338499">Интернетке туташуу мүмкүн болбой жатат. HTTP 403 Тыюу салынган. Прокси конфигурациясын текшериңиз.</translation>
<translation id="2753623023919742414">Издөө үчүн чыкылдатыңыз</translation>
<translation id="4193420110872590792">João Browser'ду демейки PDF көрүүчү каражаты катары тууралаңыз</translation>
<translation id="6614401181366354261">Бул кеңейтүүдө кесепеттүү программа бар ал жана кооптуу. Сиз кирген сайттардагы дайын-даректериңизди, анын ичинде жеке маалыматыңызды мындан ары көрүп жана өзгөртпөшү үчүн аны João Browser'дан алып салыңыз.</translation>
<translation id="2799223571221894425">Кайра ишке киргизүү</translation>
<translation id="6299858290790311689">Сиздин João Browser</translation>
<translation id="2816462166102338036">Бул видеону Сүрөт издөө функциясы аркылуу издөө</translation>
<translation id="5896458971800337862">iOS'тогу João Browser менен камера аркылуу товарларды таап, баанын арзандашына көз салып жана башка аракеттерди аткарыңыз.</translation>
