<translation id="3047590466164881923">סגירה של תיבת דו-שיח של משוב</translation>
<translation id="6168172692486433600">‏פרופילים אחרים ב-João Browser</translation>
<translation id="884929993636327">‏תוספים הם רכיבים נוספים שמאפשרים לך להתאים אישית את João Browser. תוספים עוזרים לך להתאים את João Browser לצרכים שלך, בין אם זה לשמור על הסדר או לפשט משימות יומיומיות.</translation>
<translation id="1525897524206034002">‏עזרה בשיפור João Browser על ידי שליחת <ph name="UMA_LINK" /> ודוחות קריסה אל Google</translation>
<translation id="2766971658743453990">‏עם אפליקציית João Browser אפשר ליהנות מתכונות הבטיחות של Google בכל מקום</translation>
<translation id="4387884830246074210">{NUM_DEVICES,plural, =0{‏תוסף אחד לפחות ל-João Browser ניגש להתקן USB אחד}=1{‏תוסף אחד לפחות ל-João Browser ניגש להתקן USB אחד}one{‏תוסף אחד לפחות ל-João Browser ניגש ל-# התקני USB}two{‏תוסף אחד לפחות ל-João Browser ניגש ל-# התקני USB}other{‏תוסף אחד לפחות ל-João Browser ניגש ל-# התקני USB}}</translation>
<translation id="3413144813287436446">‏ההיסטוריה ב-João Browser</translation>
<translation id="9192419056064225629">‏המתקין לא הצליח לבטל את דחיסת הארכיון. יש להוריד שוב את João Browser.</translation>
<translation id="310459126943037700">סיום המשימות נכשל.</translation>
<translation id="3104828284009500087">אפשר לחפש משהו בדף הזה</translation>
<translation id="3508468328135806512">‏רוצה לסנכרן את הסיסמאות, הסימניות וההיסטוריה שלך באופן מושלם בין המכשירים? כדי להשתמש בקלות בתכונות המוכרות והאהובות, צריך לעדכן את דפדפן ברירת המחדל ל-João Browser.</translation>
<translation id="3216151988142306917">‏João Browser משתמש במיקרופון שלך.</translation>
<translation id="3130333203120345554">חיפוש חדש</translation>
<translation id="3137969841538672700">צריך לגרור כדי לחפש</translation>
<translation id="7493177208577109722">‏בכרטיסייה הזו נעשה שימוש במשאבים נוספים. כדי לשפר את הביצועים, כדאי לאפשר ל-João Browser להשבית אותה.</translation>
<translation id="7239354789967255675">‏כדי לשתף את המסך, צריך לאפשר הקלטת מסך ב-João Browser בקטע "הגדרות המערכת"</translation>
<translation id="4955872590603594814">‏הפעלה מחדש של João Browser</translation>
<translation id="3161522574479303604">כל השפות</translation>
<translation id="4697739132113629685">‏פתיחת הקישור בחלון &amp;אנונימי של João Browser</translation>
<translation id="1629247860984475766">‏התאמה אישית של פרופיל João Browser החדש</translation>
<translation id="1905008150929775692">‏אפשר להמשיך להתכתב בצ'אט עם מצב AI בלי לעבור בין כרטיסיות. כדי להתחיל, עליך להיכנס לחשבון שלך ב-João Browser. אחרי הכניסה, הסיסמאות ופריטים נוספים יופיעו בכל המכשירים שלך.</translation>
<translation id="4232381420311815141">‏כדי להסיר את החשבון שלך ב-Google מ-João Browser, צריך לצאת מ-João Browser בדף ההגדרות</translation>
<translation id="3234316605225071811">‏בהמשך, תוצג לך שאלה ב-Chromium אם להשתמש במידע השמור כדי למלא בשבילך טפסים באופן אוטומטי</translation>
<translation id="6676749542734993844">‏João Browser אינו יכול לקרוא ולכתוב בספריית הנתונים שלו: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="6632498492152446344">‏עם João Browser ב-iOS, אפשר לקחת את הכלים שמבוססים על Google AI איתך לכל מקום.</translation>
<translation id="3286538390144397061">הפעל מחדש כעת</translation>
<translation id="532528773927600103">‏המפתחות של Google API חסרים. פונקציונליות מסוימת של João Browser תהיה מושבתת.</translation>
<translation id="3296368748942286671">‏המשך הפעלת יישומים ברקע כאשר Chromium סגור</translation>
<translation id="3313189106987092621">‏Chromium יציג אזהרה לפני טעינת אתר כלשהו באמצעות חיבור לא מאובטח</translation>
<translation id="8095477191923518137">‏אם סוגרים את כל החלונות של João Browser, מתבצעת יציאה מהחשבון ברוב האתרים, אבל לא מחשבון Google, אם נכנסת אליו ב-João Browser. כדי לאפשר לאתרים לזכור אותך, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">‏הפינה הימנית העליונה של אזור החיפוש: ‎<ph name="RIGHT" />%‎ מימין, ‎<ph name="TOP" />%‎ מלמעלה</translation>
<translation id="3366305173356742781">‏נתוני Chromium בחשבון שלך</translation>
<translation id="3234882977104294240">‏רוצה להשתמש בסיסמאות שלך ב-João Browser בטלפון?</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="2974199599420431595">‏לעבור לפרופיל קיים של João Browser?</translation>
<translation id="3412460710772753638">עדכון במנהל הסיסמאות במכשיר הזה</translation>
<translation id="3438772217992559640">חיפוש בכרטיסייה בעזרת "חיפוש תמונות"</translation>
<translation id="8318147705317768982">‏רוצה להרחיב את הגרסה המשופרת של גלישה בטוחה ב-João Browser בטלפון?</translation>
<translation id="347392028839310978">‏‫João Browser מבצע התאמה אישית…</translation>
<translation id="3474745554856756813">‏פעולה זו תמחק <ph name="ITEMS_COUNT" /> פריטים מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל Chromium עם <ph name="USER_EMAIL" />.</translation>
<translation id="5805833167703404998">‏ניתן לעבור בין פרופילים של João Browser באמצעות <ph name="SHORTCUT" /></translation>
<translation id="1835124883585653877">‏יש לסגור את כל חלונות João Browser ולנסות שוב.</translation>
<translation id="7106246566966568195">‏כדי לשתף את החלון, צריך לאפשר הקלטת מסך ב-João Browser בקטע "הגדרות המערכת"</translation>
<translation id="6017005873246021363">‏כבר בוצעה כניסה לחשבון על ידי <ph name="EXISTING_USER" />.  כדי להפריד בין פעילויות הגלישה, עליך להיכנס ל-João Browser בפרופיל שלך עם האימייל <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="1146681170626381319">‏קוד QR להורדת הדפדפן João Browser למכשירים ניידים</translation>
<translation id="354621070532799440">‏תזכורת: תכונות הבטיחות הכי טובות של Google – אצלך בכיס</translation>
<translation id="2488701737291439763">‏כדי לשתף את המסך, צריך לאפשר הקלטת מסך ב-João Browser בקטע "הגדרות המערכת".</translation>
<translation id="3588112919289558122">‏הפעלת ההגנה המשופרת משביתה את האופטימיזציה של JavaScript באתרים ש-Chromium לא מזהה</translation>
<translation id="3597003331831379823">הפעלת ההגדרה נכשלה עם הרשאות מורחבות. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="7882299119268334705">‏כניסה ל-João Browser</translation>
<translation id="5985252758124395804">‏נתוני הגלישה של האדם הזה יימחקו מהמכשיר. כדי לשחזר את הנתונים, יש להיכנס ל-João Browser בתור <ph name="USER_EMAIL" />.</translation>
<translation id="3873330960224886843">{COUNT,plural, =0{‏יש עדכון חדש בשביל João Browser והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש.}=1{‏יש עדכון חדש בשביל João Browser והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. החלון האנונימי לא ייפתח מחדש.}one{‏יש עדכון חדש בשביל João Browser והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}two{‏יש עדכון חדש בשביל João Browser והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}other{‏יש עדכון חדש בשביל João Browser והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}}</translation>
<translation id="3667616615096815454">אין אפשרות להתקין, האפליקציה לא מוכרת לשרת.</translation>
<translation id="3675854891107786059">‏שימוש ב<ph name="BEGIN_LINK" />ביטוי סיסמה משלך<ph name="END_LINK" /> כדי להצפין את כל נתוני Chromium בחשבון Google. אמצעי תשלום וכתובות שנשמרו ב-Google Pay לא יוצפנו. היסטוריית הגלישה ב-Chromium לא תסונכרן.</translation>
<translation id="6155809479106644907">{COUNT,plural, =0{‏מנהל המערכת מבקש להפעיל מחדש את João Browser כדי להחיל את העדכון הזה}=1{‏מנהל המערכת מבקש להפעיל מחדש את João Browser כדי להחיל את העדכון הזה. החלון האנונימי לא ייפתח מחדש.}one{‏מנהל המערכת מבקש להפעיל מחדש את João Browser כדי להחיל את העדכון הזה. # החלונות האנונימיים לא ייפתחו מחדש.}two{‏מנהל המערכת מבקש להפעיל מחדש את João Browser כדי להחיל את העדכון הזה. # החלונות האנונימיים לא ייפתחו מחדש.}other{‏מנהל המערכת מבקש להפעיל מחדש את João Browser כדי להחיל את העדכון הזה. # החלונות האנונימיים לא ייפתחו מחדש.}}</translation>
<translation id="4134769722455445399">‏פתיחת הקישור ב&amp;כרטיסיית João Browser חדשה</translation>
<translation id="3728124580182886854">‏אפשר לקשר את Chromium לשירותי Google אחרים לצורך התאמה אישית ולמטרות אחרות</translation>
<translation id="3729187154190517324">כדי להעמיק את החיפוש, אפשר להוסיף כמה כרטיסיות, קבצים וכלים באמצעות הכפתור "הוספת כרטיסייה ועוד".</translation>
<translation id="655691042235349825">‏ניהול הפרופילים ב-João Browser</translation>
<translation id="8494798931804571569">‏למה הורדות מסוימות נחסמות ב-João Browser</translation>
<translation id="379589255253486813">‏Chromium יעדכן אותך אם יש משהו שצריך לבדוק</translation>
<translation id="3802055581630249637">‏כדי שהדפים שבהם מבקרים ייטענו מהר יותר, מערכת Chromium טוענת מראש דפים שיש סיכוי גבוה שייפתחו.</translation>
<translation id="3810973564298564668">ניהול</translation>
<translation id="6945066279282141856">‏כדי להשתמש בסיסמאות השמורות, צריך לסרוק את קוד ה-QR, להוריד את João Browser ל-iOS ולהיכנס לחשבון Google</translation>
<translation id="3846683726093018685">**סיכום:** במשפט אחד של פחות מ-30 מילים, צריך לתאר את הנושא והמטרה העיקריים של התוכן בצילום המסך.

          **הצעת שאלות:** יצירת רשימה של 3-5 שאלות מעוררות מחשבה שהמשתמש יכול לשאול כדי להבין טוב יותר את צילום המסך. לפחות שאלה אחת צריכה להתייחס באופן ספציפי לאובייקט חזותי, לעיצוב שלו או למיקום שלו.</translation>
<translation id="4996569675441627032"><ph name="PAGE_TITLE" /> - João Browser</translation>
<translation id="6008740052107737825">‏לאתר הזה דרושה הרשאת גישה לרשת המקומית מ-João Browser</translation>
<translation id="3885770153807205175">הכלי לבחירת שפה</translation>
<translation id="2390004682597453662">‏התאמה אישית וניהול של João Browser נחוצה פעולה שלך - יש ללחוץ לקבלת פרטים נוספים.</translation>
<translation id="8262407643678629134">‏יש ללחוץ על השם שלך כדי לפתוח את João Browser ולהתחיל לגלוש.</translation>
<translation id="3892148308691398805">העתקת הטקסט</translation>
<translation id="2168201717554927204">‏המשתמש <ph name="EXISTING_USER" /> כבר מחובר לפרופיל João Browser הזה. כדי להפריד בין פעילויות גלישה, João Browser יכול ליצור עבורך פרופיל משלך.</translation>
<translation id="1046732460303790107">‏התוסף הזה מפר את המדיניות של חנות האינטרנט של Chrome, ויכול להיות שהוא לא בטוח. צריך להסיר אותו מ-João Browser כדי לא לאפשר לו יותר להציג ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="3941890832296813527">שגיאת התקנה: שם הקובץ של מנהל ההתקנה לא תקין או לא נתמך.</translation>
<translation id="3879366121647289622">‏João Browser מנסה להעתיק את הסיסמאות. כדי לאפשר למערכת לעשות זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="7332365758981378072">‏הסיסמאות, אמצעי התשלום והכתובות ששמרת בחשבון שלך ב-Google יוסרו מהמכשיר הזה. כדי להשתמש בהם שוב ב-João Browser, צריך להיכנס שוב לחשבון.</translation>
<translation id="395904275706073188">לא ניתן לקרוא דפים מוגנים. כדאי לנסות דף אחר.</translation>
<translation id="3962647064319009959">‏איך מערכת Chromium שומרת על האבטחה שלך</translation>
<translation id="3967822245660637423">ההורדה הושלמה</translation>
<translation id="3971865010372729242">‏כשמקלידים טקסט בסרגל הכתובות או בתיבת החיפוש, Chromium שולח את הטקסט הזה לכלי החיפוש, הבינה המלאכותית והסוכנים של הארגון כדי לקבל הצעות.</translation>
<translation id="3975724895399328945">‏מידע על &amp;Google Chrome for Testing</translation>
<translation id="3997429360543082038">‏מידע על ChromiumOS</translation>
<translation id="4010059961270896984">‏כשמבקרים באתר מסוים, Chromium שולח ל<ph name="BEGIN_LINK" />גלישה בטוחה של Google<ph name="END_LINK" /> קטע קוד מעורפל מכתובת ה-URL דרך שרת פרטיות שמסתיר את כתובת ה-IP. אם האתר פועל באופן שמעורר חשד, יישלחו גם כתובות URL מלאות וקטעי תוכן מדפים.</translation>
<translation id="4016217212818346953">מנהל הסיסמאות עוזר לשמור על הבטיחות שלך</translation>
<translation id="4019629340646866719">‏השימוש ב-ChromiumOS מתאפשר בזכות <ph name="BEGIN_LINK_CROS_OSS" />תוכנות קוד פתוח<ph name="END_LINK_CROS_OSS" /> נוספות כמו <ph name="BEGIN_LINK_LINUX_OSS" />סביבת הפיתוח של Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">תרגום המסך</translation>
<translation id="4023601594785368013">שפה מקורית: <ph name="LANGUAGE" /></translation>
<translation id="6855094093276351199">‏אפשר לפתוח קישורים ב-João Browser מכל אפליקציה. בנוסף João Browser מוצמד לשורת המשימות לגישה נוחה.</translation>
<translation id="4036079820698952681">‏דיווח על <ph name="BEGIN_LINK" />ההגדרות הנוכחיות<ph name="END_LINK" /> יעזור לשפר את Chromium</translation>
<translation id="4050175100176540509">הגרסה החדשה כוללת שיפורי בטיחות חשובים ותכונות חדשות.</translation>
<translation id="4055805654398742145">מנהל הס&amp;יסמאות</translation>
<translation id="615818333141511791">{COUNT,plural, =1{‏לפי הגדרת הארגון, João Browser נסגר אוטומטית כשלא משתמשים בו במשך דקה. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}one{‏לפי הגדרת הארגון, João Browser נסגר אוטומטית כשלא משתמשים בו במשך # דקות. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}two{‏לפי הגדרת הארגון, João Browser נסגר אוטומטית כשלא משתמשים בו במשך # דקות. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}other{‏לפי הגדרת הארגון, João Browser נסגר אוטומטית כשלא משתמשים בו במשך # דקות. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}}</translation>
<translation id="4118474109249235144">‏מצב פרטי ב-Chromium</translation>
<translation id="4122186850977583290">‏מעבר לדף 'מידע על Chromium'</translation>
<translation id="9207280419664362385">‏אפשר להתאים אישית את João Browser כדי לשנות את מראה הדפדפן</translation>
<translation id="3719803995198923598">‏התאמה אישית של João Browser</translation>
<translation id="4148957013307229264">מתקין...</translation>
<translation id="2954462321765112214">‏<ph name="PAGE_TITLE" /> – כניסה לרשת – João Browser</translation>
<translation id="7812363663832111420">‏אפליקציות, משחקים, תוספים ועיצובים מעולים בשביל João Browser.</translation>
<translation id="69200600645763018">‏כדי לקבל גישה לתוסף הזה ולנתונים נוספים בכל המחשבים, צריך להיכנס ל-João Browser</translation>
<translation id="7505863944027312744">‏כדי לשמור על הבטיחות אונליין בהתאם לאפשרויות שנבחרו על ידי ההורה שלך, עליך לעבור לפרופיל João Browser שבו כבר נכנסת לחשבון עם האימייל <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">מבטל…</translation>
<translation id="4224210481850767180">ההתקנה בוטלה.</translation>
<translation id="8090594705972340646">‏האם לקשר את הנתונים שלך ב-João Browser לחשבון זה?</translation>
<translation id="4251772536351901305">‏מקבלים אזהרות לגבי אתרים מסוכנים, גם כאלה שלא היו ידועים ל-Google לפני כן, בעזרת ניתוח של יותר נתונים מאתרים בהשוואה להגנה הרגילה. אפשר לדלג על האזהרות מ-Chromium.</translation>
<translation id="5696119579094527589">‏יציאה מ-João Browser</translation>
<translation id="4271805377592243930">‏עזרה בנושא Chromium</translation>
<translation id="4281844954008187215">תנאי שירות</translation>
<translation id="1245307320228150348">‏ההתקנה נכשלה בשל שגיאה לא צפויה. אם João Browser פועל כעת, יש לסגור אותו ולנסות שוב.</translation>
<translation id="7405356088321579627">‏ייצוא סיסמאות מ-João Browser</translation>
<translation id="4304713468139749426">מנהל הסיסמאות</translation>
<translation id="4334241893986177674">חיפוש צילום המסך הזה</translation>
<translation id="212570256141568951">‏הפעלת João Browser יחד עם Windows</translation>
<translation id="4400772909124543403">אין עדכונים כרגע.</translation>
<translation id="7463042547966071103">‏לסגור את João Browser בכל זאת?</translation>
<translation id="4413205837991854510">תמיד להציג את קיצור הדרך לחיפוש תמונות</translation>
<translation id="4736206301215400753">‏João Browser יכול לפעול ברקע</translation>
<translation id="821847589110998911">{NUM_EXTENSIONS,plural, =1{‏אנחנו ממליצים להסיר אותו מ-João Browser. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}one{‏אנחנו ממליצים להסיר אותם מ-João Browser. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}two{‏אנחנו ממליצים להסיר אותם מ-João Browser. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}other{‏אנחנו ממליצים להסיר אותם מ-João Browser. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}}</translation>
<translation id="5305058100936019600">‏התאמה אישית ושליטה ב-João Browser</translation>
<translation id="4427306783828095590">עם ההגנה המשופרת, החסימה של פישינג ותוכנות זדוניות מקיפה יותר</translation>
<translation id="4434353761996769206">שגיאת מנהל התקנה: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3461955321878243607">‏הארגון '<ph name="MANAGER" />' מנהל את João Browser</translation>
<translation id="3379477508903866078">‏הוספת פרופיל João Browser</translation>
<translation id="4447409407328223819">‏מידע על Chrome for Testing</translation>
<translation id="4074057296993529937">‏כדי להשתמש בנתוני João Browser ולשמור אותם בחשבון Google, עליך להזין את ביטוי הסיסמה שלך</translation>
<translation id="4493028449971051158">שגיאת הפעלה: יש להפעיל את מנהל ההתקנה כאדמין.</translation>
<translation id="4501471624619070934">ההתקנה נכשלה כי הגישה מוגבלת במדינה הזו.</translation>
<translation id="8624811527667906941">‏לתוסף הזה לא פורסמו נוהלי פרטיות, למשל האופן שבו הוא אוסף נתונים ומשתמש בהם. ההמלצה של João Browser היא להסיר אותו.</translation>
<translation id="5571435860030744559">‏ברוך בואך אל João Browser. נפתח חלון חדש בדפדפן</translation>
<translation id="8132016625974854930">‏ל-João Browser נדרשת הרשאה כדי למפות את הסביבה שלך ולעקוב אחרי תנועות הידיים</translation>
<translation id="6599071882590417739">‏כבר נכנסת לחשבון בתור <ph name="USER_EMAIL_ADDRESS" /> בפרופיל João Browser אחר</translation>
<translation id="4548534452171747496">‏‫Chromium טוען מראש דפים וכך ניתן לגלוש ולחפש מהר יותר. <ph name="BEGIN_LINK" />מידע נוסף על טעינה מראש של דפים<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">כדי לשפר את הבטיחות באינטרנט לכולם, אפשר לדווח על אתר שלדעתך עשוי לגרום נזק.</translation>
<translation id="202208802191333704">‏João Browser חסם את ההורדה הזאת כי השבתת את הגלישה הבטוחה ואי אפשר לאמת את הקובץ</translation>
<translation id="3128308674776200516">‏רוצה לנסות את Google Lens ב-João Browser בטלפון?</translation>
<translation id="4594305310729380060">שמירה למנהל הסיסמאות במכשיר הזה</translation>
<translation id="7653380076752216509">‏יישומי João Browser</translation>
<translation id="4598116752460667024">מחפשים תהליך כלשהו מהרשימה.</translation>
<translation id="4613863813562375431">‏גרסת ChromiumOS</translation>
<translation id="4621240073146040695">‏העדכון כמעט הושלם! הפעל מחדש את Chromium‏ כדי לסיים את העדכון.</translation>
<translation id="1497446027991908251">‏אפשר להאיץ ביצועים של אתרים באמצעות מנוע V8 של João Browser, אבל João Browser יהיה קצת פחות עמיד בפני מתקפות.</translation>
<translation id="7523749920868634278">‏אזהרה: João Browser לא יכול למנוע מתוספים לתעד את היסטוריית הגלישה שלך. כדי להשבית את התוסף הזה במצב אנונימי, צריך לבטל את הבחירה של האפשרות הזו.</translation>
<translation id="4673151026126227699">‏אם בנוסף ישותפו דוחות שימוש ב-Chromium, הדוחות האלה יכללו את כתובות ה-URL שבהן ביקרת</translation>
<translation id="4673710618874938871">נכנסת בתור <ph name="USER_NAME" />, עם מינוי. פתיחת תפריט החשבון</translation>
<translation id="6608258642372806522">‏נראה שהפרופיל נמצא בשימוש על ידי תהליך João Browser אחר (<ph name="PROCESS_ID" />) במחשב אחר (<ph name="HOST_NAME" />)‏. João Browser נעל את הפרופיל כדי שלא ייפגם. אם וידאת שאף תהליך אחר אינו משתמש בפרופיל זה, אפשר את נעילת הפרופיל ולהפעיל את João Browser מחדש.</translation>
<translation id="4680828127924988555">ביטול ההתקנה</translation>
<translation id="3912572071294857936">‏חלק מהנתונים ב-João Browser עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו.</translation>
<translation id="1077152188344040592">‏כשמחוברים לחשבון, אפשר להשתמש בסיסמאות ובפרטים נוספים מחשבון Google ב-João Browser. אפשר לשנות את ההגדרות של שירותי Google באמצעות קיצור הדרך <ph name="SHORTCUT" />.</translation>
<translation id="5729536702149847030">‏מישהו נכנס בעבר ל-João Browser מהמחשב הזה כ-<ph name="ACCOUNT_EMAIL_LAST" />. יש ליצור משתמש חדש ל-João Browser כדי לשמור על פרטיות המידע שלך.</translation>
<translation id="4724676981607797757">ההתקנה נכשלה בגלל שגיאת פרוטוקול שלא נתמך.</translation>
<translation id="6273241729694500032">‏לסגור את João Browser בכל זאת?</translation>
<translation id="3239680024825449390">‏בוצע עדכון אבטחה מיוחד של João Browser. עכשיו עליך להפעיל מחדש ואנחנו נשחזר את הכרטיסיות.</translation>
<translation id="4771701986670315895">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות "<ph name="PERMISSION_1" />", "<ph name="PERMISSION_2" />" ועוד <ph name="COUNT" /> הרשאות הוסרו על ידי Chromium.</translation>
<translation id="1908292729364083164">‏אם Gemini פתוח ב-João Browser, החלונית הצדדית נשארת פתוחה כשיוצרים כרטיסיות חדשות</translation>
<translation id="479167709087336770">‏נעשה כאן שימוש בבדיקת האיות של חיפוש Google. הטקסט המוקלד בדפדפן נשלח אל Google. אפשר לשנות את ההתנהגות הזו בכל שלב דרך ההגדרות.</translation>
<translation id="189382710647501724">‏שימוש ב-João Browser ללא חשבון</translation>
<translation id="4456919965836032212">‏כלל נכנס עבור João Browser על מנת לאפשר תנועת mDNS.</translation>
<translation id="3486986778673504636">‏הפעלה מחדש לצורך עדכון &amp;João Browser</translation>
<translation id="4918086044614829423">אישור</translation>
<translation id="4918844574251943176">התמונה הועתקה</translation>
<translation id="1571932028747131277">‏João Browser נמצא במצב רקע.</translation>
<translation id="7612124006067933008">‏אפשר ללחוץ כדי לסגור את תיבת הדו-שיח של הכניסה ל-João Browser</translation>
<translation id="2598788273876744576">‏באמצעות פרופילים ב-João Browser, אפשר להפריד את כל הפריטים ב-João Browser. אפשר ליצור פרופילים שמיועדים לחברים ולבני משפחה או פרופילים נפרדים לעבודה ולבילויים בשעות הפנאי.</translation>
<translation id="2115498792600385171">‏אורחים יכולים להשתמש ב-João Browser בלי להשאיר דבר מאחור.</translation>
<translation id="6870732303439257966">‏החשבון שלך ב-João Browser</translation>
<translation id="4366792189726044065">‏הוספת החשבון שלך ל-João Browser</translation>
<translation id="504699503110800016">פתיחת האפשרויות הנוספות</translation>
<translation id="4340125167559705618">‏עם João Browser במכשיר <ph name="DEVICE_TYPE" /> אפשר להשתמש בכל הפריטים של Google שמעניינים אותך</translation>
<translation id="4916697359431064123">‏צריך לתת ל-João Browser הרשאה כדי לעקוב אחרי תנועות הידיים</translation>
<translation id="5141988424377517949">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות "<ph name="PERMISSION_1" />", "<ph name="PERMISSION_2" />" ו"<ph name="PERMISSION_3" />" הוסרו על ידי Chromium.</translation>
<translation id="5174969993834422967">הבחירה שלך היא בדרך כלל לחסום התראות. כדי לאפשר לאתר הזה להציג התראות, יש ללחוץ על סמל ההתראה בפינה השמאלית של סרגל המיקום.</translation>
<translation id="5174983315706567306">אין מספיק מקום בכונן.</translation>
<translation id="961070648267203077">‏נדרש אימות מחדש לחשבון João Browser</translation>
<translation id="69363826605946518">‏עם João Browser ב-iOS אפשר להמשיך מהמקום שבו הפסקת.</translation>
<translation id="471694954923709047">‏יציאה מ-João Browser</translation>
<translation id="5234764350956374838">סגירה</translation>
<translation id="5782956358171235578">‏פתיחת הקישור בחלון לגלישה &amp;פרטית של João Browser</translation>
<translation id="903712329052383264">‏כדי לשמור סיסמאות תוך כדי תנועה, צריך להוריד את אפליקציית João Browser</translation>
<translation id="5277894862589591112">‏כדי להחיל את השינויים שביצעת, יש להפעיל מחדש את Chromium</translation>
<translation id="5286907366254680517">זוהתה</translation>
<translation id="5593827909938092728">‏הורדת אפליקציית João Browser</translation>
<translation id="5294316920224716406">‏בגלישה במצב פרטי, Chromium יציג אזהרה לפני טעינת אתר באמצעות חיבור לא מאובטח</translation>
<translation id="1066981078513393795">‏שירות פנימי לעדכון של João Browser</translation>
<translation id="5324450571874973775">‏משתמשים בהן עם פיצ'רים אחרים של Gemini ב-Chromium</translation>
<translation id="5346389065299425353">כדי להעמיק את החיפוש, אפשר להוסיף כמה כרטיסיות, קבצים וכלים</translation>
<translation id="1884203704972162365">‏אפשר לקבל סקירה כללית של המסמך הזה ולשאול את Gemini ב-João Browser שאלות.</translation>
<translation id="5352264705793813212">‏יש ל-Chromium כמה המלצות לגבי בטיחות שכדאי לבדוק</translation>
<translation id="4819697639570429319">‏פרופילים אחרים ב-João Browser</translation>
<translation id="7878591304929138776">‏הנתונים מ-João Browser לא נשמרו בחשבון Google שלך ב-ChromiumOS כי פרטי הכניסה לחשבון לא מעודכנים</translation>
<translation id="5249614051186670898">‏הכניסה שלך מתבצעת באמצעות חשבון מנוהל שמעניק למנהל המערכת שלו שליטה על הפרופיל שלך ב-João Browser. הנתונים שלך ב-João Browser, כגון יישומים, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME" />. ניתן למחוק את הנתונים האלה באמצעות לוח הבקרה של חשבונות Google, אבל לא ניתן לשייך את הנתונים האלה לחשבון אחר. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">קוד נוסף: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">‏כדי להשתמש בהתאמה אישית, צריך לכלול את Chromium ב'פעילות באינטרנט ובאפליקציות'</translation>
<translation id="108952623091824942">‏למה קבצים מסוימים נחסמים ב-João Browser</translation>
<translation id="5386450000063123300">‏מתבצע עדכון של Chromium‏ (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">‏התרת כניסה אל Chromium</translation>
<translation id="1265086181910844216">‏להסיר מ-‏João Browser‏</translation>
<translation id="1500700851187484222">‏ירידה ברמת הביצועים בתמורה להגברת העמידות של João Browser בפני מתקפות</translation>
<translation id="6665657403278704382">‏הגדרת João Browser כדפדפן ברירת המחדל שלך</translation>
<translation id="3520901681432894293">‏<ph name="PAGE_TITLE" /> - João Browser בגרסת בטא</translation>
<translation id="5994273394215159270">{NUM_TABS,plural, =1{‏ההמלצה של João Browser היא להשהות את הכרטיסייה שמאטה את הדפדפן}one{‏ההמלצה של João Browser היא להשהות את הכרטיסיות שמאטות את הדפדפן}two{‏ההמלצה של João Browser היא להשהות את הכרטיסיות שמאטות את הדפדפן}other{‏ההמלצה של João Browser היא להשהות את הכרטיסיות שמאטות את הדפדפן}}</translation>
<translation id="646791423998269453">‏יכול להיות ש-João Browser לא יפעל כראוי כי הוא כבר לא נתמך בגרסה הזו של Linux</translation>
<translation id="7249139852479053716">‏‫João Browser חסם את ההורדה הזו כי הקובץ יכול לפגוע בחשבונות האישיים ובחשבונות שלך ברשתות החברתיות</translation>
<translation id="478612683981218420">‏יש להמתין בזמן ש-João Browser מתקין את עדכוני המערכת האחרונים.</translation>
<translation id="3466187211963597724">‏João Browser מנסה לערוך את הסיסמאות. כדי לאפשר זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="3133978491361824131">‏עם João Browser אפשר להשתמש בקלות ומכל מקום באפליקציות שמעניינות אותך, כמו Google Drive ו-YouTube.</translation>
<translation id="5524890928877629608">‏הפינה השמאלית העליונה של אזור החיפוש: ‎<ph name="LEFT" />%‎ משמאל, ‎<ph name="TOP" />%‎ מלמעלה</translation>
<translation id="5527463683072221100">‏פתיחה של קובצי PDF ב-Chromium</translation>
<translation id="5536164441519929134">יש לי שאלה<ph name="LINE_BREAK" />לגבי הכרטיסייה הזו</translation>
<translation id="3902123582863904748">‏אם נכנסת לאתר בפעם הראשונה, João Browser משבית את האופטימיזציה של JavaScript מטעמי אבטחה.

אם הדף הזה לא פועל כמו שצריך, כדאי להפעיל את האופטימיזציה.</translation>
<translation id="5924481826213021755">‏הצגת Gemini ב-João Browser בסרגל התפריטים של Mac והפעלת מקשי הקיצור</translation>
<translation id="4988760628116707723">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-João Browser בתור <ph name="USER_EMAIL_ADDRESS" />. המידע השמור ופריטים נוספים יופיעו במכשיר <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">שגיאת הפעלה: יש להפעיל את מנהל ההתקנה כמשתמש רגיל ולא כאדמין.</translation>
<translation id="697769674160644707">‏שימוש ב-João Browser כברירת מחדל והצמדה שלו</translation>
<translation id="5596627076506792578">אפשרויות נוספות</translation>
<translation id="5605834417512968703">‏אפשר לבחור משהו לחיפוש באמצעות התכונה 'חיפוש תמונות' או ללחוץ על Escape כדי לצאת מחיפוש התמונות</translation>
<translation id="5618818588972826921">‏אפשר לבחור טקסט או תמונה לחיפוש באמצעות התכונה "חיפוש תמונות" או ללחוץ על Escape כדי לצאת מחיפוש התמונות</translation>
<translation id="2497422928854452258">{0,plural, =0{‏יש עדכון ל-João Browser}=1{‏יש עדכון ל-João Browser}one{‏עדכון של João Browser זמין כבר # ימים}two{‏עדכון של João Browser זמין כבר # ימים}other{‏עדכון של João Browser זמין כבר # ימים}}</translation>
<translation id="5643865575100044307">‏מחיקת נתונים מאתרים מהמכשיר בכל פעם שסוגרים את Chromium</translation>
<translation id="620465883043431255">‏יש להפעיל מחדש את João Browser</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">‏הצגת Chromium בשפה זו</translation>
<translation id="569897634095159764">‏לא ניתן להתחבר לאינטרנט. נדרש אימות של שרת ה-proxy.</translation>
<translation id="5768371961535086509">‏‫Chromium מפנה מקום בזיכרון שמוקצה לכרטיסיות לא פעילות. כך, לכרטיסיות הפעילות ולאפליקציות אחרות יש יותר משאבים מהמחשב ו-Chromium פועל מהר. כשחוזרים לכרטיסיות הלא פעילות, הן מופעלות מחדש באופן אוטומטי. <ph name="BEGIN_LINK" />מידע נוסף על מצב חיסכון בזיכרון<ph name="END_LINK" /></translation>
<translation id="8866372822266732235">‏אם שכחת את ביטוי הסיסמה או שברצונך לשנות את ההגדרה הזו, עליך <ph name="SETTINGS_LINK" /> את נתוני João Browser בחשבון</translation>
<translation id="2106070764285625641">‏אפשר להתאים אישית את João Browser ולנהל אותו. הגדרת João Browser כברירת המחדל.</translation>
<translation id="9077878413488413377">‏רוצה סנכרון מושלם של הסיסמאות, הסימניות וההיסטוריה שלך בין מכשירים? כדאי להגדיר את João Browser כדפדפן ברירת המחדל.</translation>
<translation id="5809516625706423866">‏לא ניתן להתחבר לאינטרנט. HTTP 401: אין הרשאה. צריך לבדוק את ההגדרה של שרת ה-proxy.</translation>
<translation id="614221876503883218">‏אפשר להאיץ ביצועים של אתרים באמצעות מנוע V8 של João Browser, אבל João Browser יהיה קצת פחות עמיד בפני מתקפות. ההגדרה הזו מושבתת.</translation>
<translation id="8788365803279840995">‏כדי להשתמש בנתוני João Browser ולשמור אותם בחשבון Google, עליך לעדכן את João Browser</translation>
<translation id="5824893331272123205">לא הצלחנו לטעון את החלונית, אפשר לנסות שוב</translation>
<translation id="5805760187441013922">‏ברוכים הבאים ל-João Browser‏</translation>
<translation id="5867606647614813312">‏מפעילה תכונות נוספות שמספקות את ההגנות החזקות ביותר של Chromium</translation>
<translation id="5871205389137001634">יש ללחוץ כדי לצאת מחיפוש התמונות</translation>
<translation id="8367098380158627809">‏מערכת João Browser גילתה שהפריטים האלה מכילים תוכנה זדונית:</translation>
<translation id="5889361821821684993">‏Chromium בודק בקביעות כדי לוודא שלדפדפן יש את ההגדרות הבטוחות ביותר. נודיע לך אם צריך לבדוק משהו.</translation>
<translation id="5895138241574237353">הפעלה מחדש</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – כניסה לרשת</translation>
<translation id="5924017743176219022">מתבצעת התחברות לאינטרנט…</translation>
<translation id="7627350220326904504">‏עכשיו נגדיר את João Browser</translation>
<translation id="5941711191222866238">מזעור</translation>
<translation id="8680863040348007215">‏כדי לקבל גישה לסימניה הזו ולנתונים נוספים בכל המכשירים שלך, צריך להיכנס ל-João Browser</translation>
<translation id="2008232276062354182">‏התאמה אישית של João Browser</translation>
<translation id="5960071705175224773">ההגדרות שלך שונו על ידי אפליקציה לא ידועה</translation>
<translation id="5977420883993828287">התכונה הוצמדה. מעכשיו אפשר להשתמש ב"משימות לפי הקשר" דרך סרגל הכלים</translation>
<translation id="5889362640603897718">{COUNT,plural, =1{‏לפי הגדרת הארגון, João Browser נסגר אוטומטית כשלא משתמשים בו במשך דקה.}one{‏לפי הגדרת הארגון, João Browser נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}two{‏לפי הגדרת הארגון, João Browser נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}other{‏לפי הגדרת הארגון, João Browser נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}}</translation>
<translation id="4971097497342057998">‏יש לעדכן את João Browser כדי להתחיל את הסנכרון</translation>
<translation id="5990360079535151574">כדי לשאול שאלות תוך כדי גלישה, אפשר ללחוץ על הכפתור משימות לפי הקשר שבסרגל הכלים ולפתוח את החלונית מחדש</translation>
<translation id="6003112304606738118">מתבצעת הורדה… יש עוד <ph name="HOURS" /> שע'</translation>
<translation id="6009821354356307391">הוספה של שאילתת המשך</translation>
<translation id="6040143037577758943">סגירה</translation>
<translation id="2100398097168307292">‏עם אפליקציית João Browser במכשיר <ph name="DEVICE_TYPE" /> אפשר ליהנות עוד יותר מהקניות באינטרנט</translation>
<translation id="6058380562449900225">‏כדי להגן על הנתונים שלך, כדאי לאפשר ל-Chromium להסיר הרשאות מאתרים שלא נכנסת אליהם לאחרונה. המערכת תמשיך לשלוח התראות.</translation>
<translation id="4735359759698689867">‏&amp;פתיחה ב-João Browser</translation>
<translation id="6069027071882229820">העתקה כתמונה</translation>
<translation id="2274675514456642321">‏<ph name="EXTENSION_NAME" /> נוסף ל-‏João Browser‏</translation>
<translation id="147381942282490529">‏כדי להתאים אישית את Google Chrome ולשלוט בו טוב יותר, כדאי להוריד את העדכון החדש.</translation>
<translation id="8775234022739879423">‏מופעל • João Browser לא יכול לאמת את מקור התוסף הזה</translation>
<translation id="6634821567165410381">‏החשבון שלך ב-João Browser</translation>
<translation id="4398707227122702993">‏מתן הרשאה לתוסף להציג בקשות גישה בסרגל הכלים של João Browser</translation>
<translation id="5370941509199989624">‏<ph name="FILE_NAME" /> מסוכן, ולכן João Browser חסם אותו.</translation>
<translation id="5119118887583954582">‏João Browser ייסגר בקרוב והנתונים שבו יימחקו</translation>
<translation id="576637711620229618">‏כאן ניתן לעבור בין פרופילים של João Browser</translation>
<translation id="615103374448673771">‏אם מאפשרים שימוש בקובצי cookie, יכול להיות שמערכת Chromium תשתמש בהם במהלך טעינה מראש.</translation>
<translation id="6165508094623778733">למידע נוסף</translation>
<translation id="3738215896821824918">‏צריך למחוק את נתוני João Browser בחשבון</translation>
<translation id="2145111683361496197">‏הקובץ הזה עלול להיות מסוכן<ph name="LINE_BREAK" />דפדפן João Browser יכול לבדוק את ההורדה הזו אם מזינים את הסיסמה. מידע על הקובץ נשלח אל התכונה 'גלישה בטוחה של Google', אבל הסיסמה והתוכן של הקובץ נשארים במכשיר.</translation>
<translation id="6182736845697986886">ההתקנה נכשלה עקב שגיאה פנימית בשרת העדכון.</translation>
<translation id="6050294746023477088">‏יש לוודא שנכנסת ל-João Browser ב-<ph name="TARGET_DEVICE_NAME" /> שלך ולשלוח שוב.</translation>
<translation id="3395167674702947885">‏במחשב זה קיימת כבר גרסה מתקדמת יותר של João Browser. אם התוכנה אינה פועלת, יש להסיר את ההתקנה של João Browser ולנסות שוב.</translation>
<translation id="4384214545531685923">{0,plural, =0{‏João Browser יופעל מחדש עכשיו}=1{‏João Browser יופעל מחדש בעוד שנייה אחת}one{‏João Browser יופעל מחדש בעוד # שניות}two{‏João Browser יופעל מחדש בעוד # שניות}other{‏João Browser יופעל מחדש בעוד # שניות}}</translation>
<translation id="5880255774989397049">‏נדרשת הרשאת גישה לאחסון ב-João Browser כדי להוריד קבצים</translation>
<translation id="6245734527075554892">‏המערכת בודקת כתובות URL בעזרת רשימה של אתרים לא בטוחים ששמורה ב-Chromium</translation>
<translation id="1959823478027154444">‏יש להפוך את João Browser לדפדפן ברירת המחדל</translation>
<translation id="6248988683584659830">חיפוש בהגדרות</translation>
<translation id="9191635841540101343">‏כשאפליקציית João Browser מותקנת בטלפון שלך, תכונות הבטיחות הטובות ביותר של Google מלוות אותך לכל מקום</translation>
<translation id="538350741885862188">‏האם לצאת מ-João Browser?</translation>
<translation id="161121067714522736">‏הכרטיסיות האלה משתמשות במשאבים נוספים. כדי לשפר את הביצועים, כדאי לאפשר ל-João Browser להשבית אותן.</translation>
<translation id="2095090272560293574">‏התאמה אישית של פרופיל João Browser</translation>
<translation id="6290827346642914212">‏בחירת שם לפרופיל Chromium שלך</translation>
<translation id="6472525517562723285">‏תוסף מבקש ממך להיכנס ל-João Browser</translation>
<translation id="2069878195899746465">‏<ph name="FILE_NAME" /> עלול להיות מסוכן, ולכן João Browser חסם אותו.</translation>
<translation id="1283909912629029170">‏João Browser משתמש במצלמה שלך.</translation>
<translation id="323902744000752306">‏מתבצעת כרגע פעולה אחרת ב-João Browser. כדאי לנסות שוב מאוחר יותר.</translation>
<translation id="1292164882596462877">‏קל יותר כעת להשתמש ב-João Browser באמצעות חשבון Google שלך ובמחשבים משותפים.</translation>
<translation id="6411450594978516531">‏כדי להשתמש בקלות בתכונות המוכרות והאהובות, כדאי להגדיר את João Browser בתור דפדפן ברירת המחדל.</translation>
<translation id="3344301749774719950">‏קיצור דרך ב-João Browser</translation>
<translation id="8395825163097750991">‏João Browser חסם את ההורדה הזאת כי לרוב לא מתבצעת הורדה של קבצים כאלה ויכול להיות שהקובץ מסוכן</translation>
<translation id="7683737657427846440">‏ברצונך באמת להסיר את התקנת João Browser?</translation>
<translation id="6375219077595103062">ניתן להוסיף קיצור דרך למנהל הסיסמאות</translation>
<translation id="6388799252195623474">אני רוצה עזרה בנושא הזה</translation>
<translation id="6966523531135953867">‏כדי להמשיך, עליך להיכנס ל-João Browser באמצעות החשבון <ph name="EMAIL" />. כך המדיניות של הארגון תחול על המכשיר שלך.</translation>
<translation id="5146608242127807773">‏הלוגו של João Browser בתוך מסך מחשב.</translation>
<translation id="6361476216650509195">‏João Browser הוא דפדפן אינטרנט המפעיל דפי אינטרנט ואפליקציות במהירות הבזק. זהו דפדפן מהיר, יציב וקל לשימוש שמאפשר לך לגלוש באינטרנט בצורה מאובטחת יותר הודות להגנה מפני תוכנות זדוניות ופישינג המובנית ב-João Browser.</translation>
<translation id="7864687914956920860">‏כדי שתמיד תהיה לך אפשרות להשתמש בנתונים ב-João Browser ולשמור אותם בחשבון שלך ב-Google, עליך לאמת את הזהות שלך</translation>
<translation id="1160920197193662978">‏דפדפן João Browser פועל מהר יותר ותכונות שמשתמשות ב-JavaScript אמורות לפעול כמו שצריך</translation>
<translation id="6436260184216827876">התכונה 'חיפוש תמונות' לא זמינה. יש לנסות שוב מאוחר יותר.</translation>
<translation id="6442900851116057561">‏הפעלה מחדש של ChromiumOS</translation>
<translation id="6443470774889161065">‏כדי שהדפים שבהם מבקרים ייטענו מהר יותר, מערכת Chromium טוענת מראש עוד יותר דפים שיש סיכוי גבוה שייפתחו.</translation>
<translation id="3730564967922511625">‏כדי לעקוב אחרי מחירים ולקבל התראות על ירידות במחיר באתר מסוים, כדאי להוריד את João Browser לטלפון שלך</translation>
<translation id="3753019081686930624">‏מושבת • João Browser לא יכול לאמת את מקור התוסף הזה</translation>
<translation id="5444641426058108434">‏ברוך בואך לפרופילים של João Browser</translation>
<translation id="5103470775766355478">‏בפתיחה הבאה של João Browser במכשיר <ph name="DEVICE_TYPE" />, תופיע הנחיה להשתמש בקבוצות של כרטיסיות.</translation>
<translation id="9087231386723579740">‏הסרת החשבון מ-João Browser</translation>
<translation id="4984395209542302039">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את João Browser.</translation>
<translation id="648319183876919572">הגרסה המשופרת של הגלישה הבטוחה מגנה עליך טוב יותר מפני הורדות ואתרים מסוכנים</translation>
<translation id="1524792685704191751">‏הסרה של התקנת João Browser</translation>
<translation id="6637504267182028286">‏קיצורי הדרך נפתחים ב-João Browser</translation>
<translation id="1478247638436966279">‏לפי הגדרת הארגון, João Browser נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION" />. נתוני הגלישה נמחקו. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="1311233187253046133">‏בכל פרופיל מאוחסנים נתוני João Browser משלו כמו סימניות, היסטוריה, סיסמאות ועוד</translation>
<translation id="6563921047760808519">‏<ph name="BEGIN_LINK" />מידע נוסף לגבי השמירה על פרטיות הנתונים ב-Chromium<ph name="END_LINK" /></translation>
<translation id="1643078533228697915">‏השינויים בהגדרה הזו ייכנסו לתוקף לאחר הפעלה מחדש של João Browser.</translation>
<translation id="1918630514771863338">‏אפשר לנהל את התוספים בלחיצה על "תוספים" בתפריט הראשי של João Browser.</translation>
<translation id="4229328298978407243">‏אפשר לעבור לפרופיל João Browser אחר כדי לראות סיסמאות</translation>
<translation id="7717252965531997879">‏עם אפליקציית João Browser אפשר ליהנות מכלי ה-AI הכי טובים בכל מקום</translation>
<translation id="6570579332384693436">‏Chromium שולח את הטקסט שמוקלד בשדות טקסט ל-Google כדי לתקן שגיאות כתיב</translation>
<translation id="5374627817618267090">‏מעבר אל הגדרות ההודעות של João Browser</translation>
<translation id="6600016381025017075">אפשר לחפש משהו בדף הזה</translation>
<translation id="264335610358256197">‏השינויים שביצעת ייכנסו לתוקף בפעם הבאה שתפעיל מחדש את João Browser‏.</translation>
<translation id="2657584510687441826">‏‫João Browser מופעל עכשיו יחד עם Windows, כך שאפשר להתחיל לגלוש מיד. ניתן להשבית זאת בהגדרות.</translation>
<translation id="5482413402708094860">‏אפשר להמשיך מהמקום שבו הפסקת: João Browser שחזר את הכרטיסיות מהסשן האחרון שלך. כדי להשבית את האפשרות הזאת, צריך לעבור אל</translation>
<translation id="5022765692226673603">‏נדרשת הרשאת גישה למצלמה ב-João Browser כדי ליצור מפה תלת-ממדית של הסביבה שלך</translation>
<translation id="6669284030132180248">‏אם הסימניות שלך נשמרות גם בחשבון Google, יש לך אפשרות לעקוב אחרי מחירי מוצרים ב-Chromium ולקבל הודעות כשהמחירים יורדים</translation>
<translation id="6676384891291319759">גישה אל האינטרנט</translation>
<translation id="668175097507315160">‏לא בוצע סנכרון של הנתונים ב-ChromiumOS בגלל שגיאה בתהליך הכניסה.</translation>
<translation id="3982573751008180181">‏להסיר את הנתונים של האפליקציה הזאת מ-João Browser?</translation>
<translation id="5613723096388999601">‏נדרשת הרשאת גישה למיקרופון ב-João Browser עבור האתר הזה</translation>
<translation id="6712881677154121168">שגיאה בהורדה: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="9190188975825967506">‏לא ניתן להשתמש בפרופיל שלך משום שהוא מגיע מגרסה חדשה יותר של João Browser.

ייתכן שחלק מהתכונות לא יהיו זמינות. יש לציין ספריית פרופיל אחרת או להשתמש בגרסה חדשה יותר של João Browser.</translation>
<translation id="6729124504294600478">‏כדי להשתמש בהתאמה אישית ובתכונות אחרות, צריך לכלול את Chromium ב'פעילות באינטרנט ובאפליקציות' ובשירותי Google המקושרים</translation>
<translation id="6957684879859415418">‏João Browser כבר מותקן במחשב ונגיש לכל המשתמשים.</translation>
<translation id="4411262692912917677">‏כדי לקבל גישה לסימניות ולנתונים נוספים בכל המכשירים, צריך להיכנס ל-João Browser. לאחר הכניסה, הסימנייה הזו תישמר בחשבון Google.</translation>
<translation id="6064901610880747710">‏אפשר להאיץ ביצועים של אתרים באמצעות מנוע V8 של João Browser, אבל João Browser יהיה קצת פחות עמיד בפני מתקפות. ההגדרה הזו פועלת.</translation>
<translation id="4530735110472079436">{count,plural, =1{‏חלק מהנתונים ב-João Browser עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו (פריט אחד).}one{‏חלק מהנתונים ב-João Browser עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}two{‏חלק מהנתונים ב-João Browser עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}other{‏חלק מהנתונים ב-João Browser עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}}</translation>
<translation id="9176853308971176490">‏ההמלצה של João Browser היא לסרוק את הקובץ הזה כי הוא עלול להיות מסוכן.</translation>
<translation id="6779406956731413166">‏<ph name="BEGIN_LINK_CROS_OSS" />תוכנת קוד פתוח<ph name="END_LINK_CROS_OSS" /> נוספת מאפשרת את השימוש ב-ChromiumOS.</translation>
<translation id="6831043979455480757">תרגום</translation>
<translation id="6412488898785231889">‏João Browser מודיע לך אם הסיסמאות שלך נמצאות בסיכון</translation>
<translation id="684888714667046800">לא ניתן להתחבר לאינטרנט. אם משתמשים בחומת אש, צריך לוודא ש-<ph name="PRODUCT_EXE_NAME" /> ברשימת ההיתרים.</translation>
<translation id="6750640664545078431">‏João Browser‏ - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">צריך ללחוץ כדי להמשיך</translation>
<translation id="6862030660799253820">חיפוש התמונה הזו באמצעות התכונה "חיפוש תמונות"</translation>
<translation id="4260365383290377081">‏הפריט "<ph name="EXTENSION_NAME" />" שנמצא ב-João Browser מכיל תוכנה זדונית</translation>
<translation id="6877155553248388166">‏הפינה הימנית התחתונה של אזור החיפוש: ‎<ph name="RIGHT" />%‎ מימין, ‎<ph name="BOTTOM" />%‎ מלמטה</translation>
<translation id="6896758677409633944">העתקה</translation>
<translation id="6898028264630240901">כדי לשאול שאלות במהלך הגלישה, אפשר להצמיד "משימות לפי הקשר"</translation>
<translation id="6985817498888719203">‏הגדרת João Browser כדפדפן ברירת המחדל והצמדה שלו לסרגל המשימות</translation>
<translation id="5277424858974213042">‏&amp;ניהול הפרופילים ב-João Browser</translation>
<translation id="2726137364317931343">‏בעקבות האיפוס:
          <ph name="LINE_BREAKS" />
            • יתאפסו דף הפתיחה, דף הכרטיסייה החדשה, מנוע החיפוש והכרטיסיות המוצמדות
            <ph name="LINE_BREAK" />
            • התוספים יושבתו
            <ph name="LINE_BREAK" />
            • יימחקו קובצי Cookie ונתונים זמניים אחרים מאתרים
            <ph name="LINE_BREAK" />
            • יתאפסו קיצורי הדרך של João Browser
            <ph name="LINE_BREAKS" />
            לא תהיה השפעה על הסימניות, ההיסטוריה והסיסמאות השמורות.</translation>
<translation id="2901988969322822496">‏הגעת למגבלת הסימניות ב-João Browser (<ph name="BOOKMARK_LIMIT" />), לכן חלק מהסימניות עדיין לא נשמרו בחשבון Google.

כדי לשמור סימניות חדשות בחשבון, צריך למחוק חלק מהסימניות הקיימות. יציאה מהחשבון תמחק את הסימניות שלא נשמרו.</translation>
<translation id="6203410920314218280">‏פתיחת הקישור בחלון &amp;אנונימי של João Browser</translation>
<translation id="6965382102122355670">אישור</translation>
<translation id="6985329841647292029">‏התנאים לשימוש ב-ChromiumOS</translation>
<translation id="8064285182627814996">‏כדי להשתמש בנתונים של João Browser ולשמור אותם בחשבון <ph name="ACCOUNT_EMAIL" />, צריך להזין את ביטוי הסיסמה</translation>
<translation id="7011190694940573312">ההתקנה נכשלה כי הגרסה הזו של מערכת ההפעלה לא נתמכת.</translation>
<translation id="7024536598735240744">שגיאה בפתיחה: <ph name="UNPACK_ERROR" />.</translation>
<translation id="181803036615530330">‏אפשר להתאים אישית את João Browser בדרך שנוחה לך</translation>
<translation id="7047386856539490735">התוצאות האלה מועילות?</translation>
<translation id="2478245051737698828">‏יש לעדכן את João Browser‏</translation>
<translation id="452909342278940733">‏אם אין לתמונה תיאור מועיל, João Browser ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל Google.</translation>
<translation id="8606769615526968368">‏אפליקציית João Browser מביאה את העוצמה של ה-AI למכשיר <ph name="DEVICE_TYPE" /> שלך</translation>
<translation id="2061960765882453684">‏כשאפליקציית João Browser מותקנת אצלך בטלפון, הסיסמאות, הכרטיסיות ופריטים נוספים מלווים אותך לכל מקום</translation>
<translation id="7141270731789036260">‏התאמה אישית של Chrome for Testing</translation>
<translation id="7147227333672430807">‏אפשר להשתמש ב-Chromium בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות</translation>
<translation id="6949173677980969871">‏הסרה של <ph name="EXTENSION_NAME" /> מ-João Browser</translation>
<translation id="3556355753960287061">‏לפי הגדרת הארגון, נתוני João Browser נמחקים אוטומטית כשלא משתמשים בהם במשך <ph name="TIMEOUT_DURATION" />. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="8689006320829658442">‏נדרשת הרשאת גישה למצלמה ב-João Browser עבור האתר הזה</translation>
<translation id="7501884108538572227">‏לא ניתן היה להפעיל את João Browser. יש לנסות שוב.</translation>
<translation id="5484563502710761706">‏עם Gemini ב-João Browser אפשר לשאול כל דבר, מכל מקום</translation>
<translation id="3823264355161086552">‏כדאי להשאיר את João Browser ב-Dock כדי לגשת אליו במהירות מתי שרוצים</translation>
<translation id="9153902741226700840">‏שימוש ב-João Browser בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות.</translation>
<translation id="7216228761061470870">‏כשמשתמשים ב"חיפוש תמונות" במחשב, כותרת הדף, כתובת ה-URL והתוכן שלו, כולל קובצי PDF, נשלחים לשרת</translation>
<translation id="7950844619283784703">‏מנהל המשימות - João Browser</translation>
<translation id="133513825972536773">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-João Browser בתור <ph name="USER_EMAIL_ADDRESS" />. המידע השמור ופריטים נוספים יופיעו בכל המכשירים שלך.</translation>
<translation id="4558982617284733740">‏רוצה לגלוש מיד? עכשיו אפשר להגדיר את João Browser להתחיל לפעול יחד עם Windows.</translation>
<translation id="7274695763216404502">התכונה הוצמדה. מעכשיו אפשר להשתמש בתכונה 'חיפוש תמונות' דרך סרגל הכלים</translation>
<translation id="7288567540154601580">כרטיסיות ותוספים</translation>
<translation id="5494571279964989269">{NUM_EXTENSIONS,plural, =1{‏ההמלצה של João Browser היא להסיר אותו}one{‏ההמלצה של João Browser היא להסיר אותם}two{‏ההמלצה של João Browser היא להסיר אותם}other{‏ההמלצה של João Browser היא להסיר אותם}}</translation>
<translation id="2269053214123323740">‏כדי לשתף אודיו מהמערכת, צריך לפתוח את הגדרות המערכת ולבחור באפשרות "הקלטת אודיו של המערכת בלבד" ל-João Browser. לאחר מכן צריך להפעיל מחדש את João Browser.</translation>
<translation id="731795002583552498">‏העדכון של Chromium‏ מתבצע</translation>
<translation id="9065168747010082551">‏קובץ ההעדפות שלך פגום או לא חוקי.&#32;

João Browser לא יכול לשחזר את ההגדרות שלך.</translation>
<translation id="7324051657739063017">כדי לשאול שאלות תוך כדי גלישה, אפשר לפתוח מחדש את החלונית "משימות לפי הקשר"</translation>
<translation id="4159250197688136733">‏היסטוריית האתרים, הסימניות ונתונים נוספים מ-João Browser נמצאים כאן.</translation>
<translation id="7347827960336370838">‏רק מי שיודע את ביטוי הסיסמה יכול לקרוא את הנתונים המוצפנים. ביטוי הסיסמה לא נשלח אל Google ולא מאוחסן אצלה. אם שכחת את ביטוי הסיסמה או שברצונך לשנות את ההגדרה הזו, עליך <ph name="BEGIN_LINK" />למחוק את נתוני Chromium בחשבון<ph name="END_LINK" />.</translation>
<translation id="1062903713270840396">‏לפי הגדרת מנהל המערכת, João Browser יפתח את<ph name="ALTERNATIVE_BROWSER_NAME" /> כדי לגשת אל <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">משהו השתבש</translation>
<translation id="5817362738974335084">‏כדי לקבל עדכונים של João Browser בעתיד, צריך macOS מגרסה 13 ואילך. במחשב הזה פועלת גרסה 12 של macOS.</translation>
<translation id="7376384068949534168">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות "<ph name="PERMISSION_1" />" ו"<ph name="PERMISSION_2" />" הוסרו על ידי Chromium.</translation>
<translation id="73786666777299047">‏פתיחת חנות האינטרנט של Chrome</translation>
<translation id="5724625487458697703">‏הצגת Gemini ב-João Browser במגש המערכת</translation>
<translation id="7401687852903179959">חיפוש בסרטון בעזרת "חיפוש תמונות"</translation>
<translation id="1088684725931971005">‏‫João Browser מוגדר עכשיו כדפדפן ברירת המחדל</translation>
<translation id="7479848806300971661">‏אפשר להמשיך מהמקום שבו הפסקת: João Browser משחזר את הכרטיסיות שלך בכל הפעלה מחדש. כדי להשבית את האפשרות הזו, צריך לעבור אל</translation>
<translation id="1258077876605261365">‏ייבוא סיסמאות אל João Browser</translation>
<translation id="5293062713751091377">‏1. לוחצים על <ph name="BUTTON_LABEL" /> למטה
2. לוחצים על <ph name="BUTTON_2" /> בהגדרות של Windows
3. לוחצים על <ph name="BUTTON_3" /> בהתראה של Windows כדי להצמיד את João Browser לסרגל האפליקציות לגישה מהירה</translation>
<translation id="1941496545060769345">‏<ph name="PAGE_TITLE" /> - João Browser בגרסת פיתוח</translation>
<translation id="7450541714075000668">הטקסט הועתק</translation>
<translation id="7458892263350425044">‏כדי להשתמש במיקרופון, צריך להיכנס אל <ph name="BEGIN_LINK" />הגדרות המערכת<ph name="END_LINK" /> ולתת ל-Chromium גישה</translation>
<translation id="5422859338435319909">‏כדי לקבל עדכונים של João Browser בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 7.</translation>
<translation id="7467949745582939695">‏להפעיל את Chromium מחדש?</translation>
<translation id="7707324976708178089">‏לא ניתן להתקין את אותה גרסת João Browser שפועלת כרגע. יש לסגור את João Browser ולנסות שוב.</translation>
<translation id="7510190804000607802">‏תזכורת: כל היתרונות של Google – אצלך בכיס</translation>
<translation id="751935028865900641">‏סביר להניח שאתרים יפעלו כצפוי. אם סוגרים את כל החלונות של Chromium, מתבצעת יציאה מהחשבון ברוב האתרים, חוץ מחשבון Google אם הוא מחובר ל-Chromium.</translation>
<translation id="5325102834460669866">{0,plural, =1{‏João Browser יופעל מחדש בעוד דקה}one{‏João Browser יופעל מחדש בעוד # דקות}two{‏João Browser יופעל מחדש בעוד # דקות}other{‏João Browser יופעל מחדש בעוד # דקות}}</translation>
<translation id="7565444033145385702">‏כדי להגן על הנתונים שלך, כדאי לאפשר ל-Chromium להסיר הרשאות מאתרים שלא נכנסת אליהם לאחרונה.</translation>
<translation id="8099958128052689767">‏כדי להתחיל לגלוש מיד, אפשר להפעיל את João Browser באופן אוטומטי.</translation>
<translation id="7583399374488819119">מנהל ההתקנה של <ph name="COMPANY_NAME" /></translation>
<translation id="7125257608567714221">‏João Browser משתמש במצלמה ובמיקרופון שלך.</translation>
<translation id="227045421902171569">‏João Browser השתפר</translation>
<translation id="5356567285381070312">‏עכשיו יש לך יותר תכונות זמינות ב-João Browser</translation>
<translation id="7624307931717240213">אנחנו משתמשים במידע כדי לשפר את השירות הזה. אפשר לקרוא את מדיניות הפרטיות והתנאים וההגבלות.</translation>
<translation id="7649070708921625228">עזרה</translation>
<translation id="5714374331629713291">‏הורדת אפליקציית João Browser</translation>
<translation id="7658239707568436148">ביטול</translation>
<translation id="549378870470819535">‏João Browser אינו דפדפן ברירת המחדל שלך</translation>
<translation id="6574348346278803862">‏סנכרון והתאמה אישית של João Browser בכל המכשירים שברשותך</translation>
<translation id="7699779824407626136">‏עדכון ל-Chromium</translation>
<translation id="3304080024230377341">‏עבודה מאובטחת ב-João Browser</translation>
<translation id="7716950018788545737">המשימות הסתיימו.</translation>
<translation id="77283119132245232">השירות הזה מספק תיעוד של עקבות המערכת ל-<ph name="BROWSER_NAME" />. אם השירות הזה מושבת, נתוני המעקב אחר הביצועים שנוצרים על ידי הדפדפן לא יכללו אירועים כלל-מערכתיים, כמו אירועי החלפת הקשר ואירועי שרשור מוכנים.</translation>
<translation id="7745317241717453663">‏פעולה זו תמחק את נתוני הגלישה מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל Chromium עם <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">המתקין לא הצליח ליצור ספרייה זמנית. יש לבדוק את המקום הפנוי בדיסק ואת האישור להתקנת תוכנה.</translation>
<translation id="4713120944298974980">‏חיפוש ב-João Browser</translation>
<translation id="5804390944809171853">‏איפוס לברירת המחדל של João Browser</translation>
<translation id="6930487390575519812">‏כדי להגן על העבודה שלך ב-João Browser, הארגון יוכל לראות מידע מסוים או לנהל אותו אם התחברת לחשבון בדפדפן.</translation>
<translation id="5214761769821670245">‏הגדרת João Browser כדפדפן ברירת המחדל והצמדה שלו לסרגל האפליקציות</translation>
<translation id="1294697217796985566">‏שיפור המהירות ב-João Browser</translation>
<translation id="1278345486417353853">‏<ph name="PAGE_TITLE" /> – João Browser בגרסת Canary</translation>
<translation id="7803986347287457849">‏לאנשים שיש להם גישה לתעבורת הנתונים שלך יהיה קשה יותר לראות את האתרים שביקרת בהם. ‫Chromium משתמש בחיבור מאובטח לחיפוש כתובות IP של אתרים ב-DNS.</translation>
<translation id="7810005234485217901">אפשר להצמיד את התכונה 'חיפוש תמונות' כדי לאפשר גישה נוחה</translation>
<translation id="489728561211958943">‏כבר קיים במכשיר פרופיל João Browser עם החשבון הזה.</translation>
<translation id="7845233973568007926">תודה שהתקנת. עליך להפעיל מחדש את המחשב לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="5294768452950207882">‏בוצע שינוי מחוץ ל-João Browser במנוע החיפוש שמוגדר כברירת המחדל. כדי להגן עליך, João Browser איפס את ההגדרה לערך ברירת המחדל המקורי. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3244974069468656925">‏אפשר להתאים אישית את João Browser כדי לשנות את המראה שלו.</translation>
<translation id="7859018312476869945">‏כשמקלידים טקסט בסרגל הכתובות או בתיבת החיפוש, Chromium שולח את הטקסט הזה למנוע החיפוש שמוגדר כברירת מחדל כדי לקבל הצעות טובות יותר. האפשרות הזו מושבתת במצב הפרטי.</translation>
<translation id="6517519572778941051">‏עדכון João Browser לגרסה האחרונה לא הצליח, ולכן אין לך גישה אל תכונות חדשות ותיקוני אבטחה.</translation>
<translation id="7872446069773932638">מתבצעת הורדה… יש עוד <ph name="SECONDS" /> שנ'</translation>
<translation id="7873537467422636035">‏אם שכחת את ביטוי הסיסמה או שברצונך לשנות את ההגדרה הזו, <ph name="BEGIN_LINK" />עליך למחוק את נתוני Chromium בחשבון<ph name="END_LINK" /></translation>
<translation id="1722038268139386345">‏אפשר לפתוח את Gemini ב-João Browser במהירות מתי שרוצים</translation>
<translation id="8344320926817290924">‏הגדרת João Browser כדפדפן ברירת המחדל</translation>
<translation id="7934340546140346950">‏‫Chromium משדרג חיבורים לא מאובטחים ל-HTTPS באופן אוטומטי כשאפשר</translation>
<translation id="3755057387338907970">‏נכנסת ל-João Browser כ-<ph name="USER_EMAIL_ADDRESS" />. יש להשתמש באותו חשבון כדי להיכנס שוב.</translation>
<translation id="929903348843569380">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-João Browser בתור <ph name="USER_EMAIL_ADDRESS" />. הסימניות ופריטים נוספים יופיעו בכל המכשירים שלך.</translation>
<translation id="7975919845073681630">‏זוהי התקנה משנית של Chromium, ולא ניתן להפוך אותו לדפדפן ברירת המחדל שלך.</translation>
<translation id="8905411496853397218">‏תוספים, אפליקציות ועיצובים ממקורות לא מוכרים עלולים להזיק למכשיר. ההמלצה של João Browser היא להתקין אותם רק מ<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /></translation>
<translation id="6306672714476596428">‏עם אפליקציית João Browser במכשיר <ph name="DEVICE_TYPE" />, אפשר לקבל כל מה שיש ל-Google להציע</translation>
<translation id="8004582292198964060">דפדפן</translation>
<translation id="8010081455002666927">זיהוי אוטומטי</translation>
<translation id="2172829664765531568">‏אחרי מתן גישה ל-João Browser, אתרים יוכלו לבקש ממך גישה.</translation>
<translation id="74641100973032765">‏אפשר להצמיד את João Browser לסרגל האפליקציות כדי לגשת אליו במהירות מתי שרוצים</translation>
<translation id="80471789339884597">תודה שהתקנת. עליך להפעיל מחדש את כל הדפדפנים לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="8054112667659782652">תמיד להציג את קיצור הדרך לחיפוש תמונות</translation>
<translation id="8069447462453318634">צריך לבחור באפשרות "הצמדה לסרגל הכלים"</translation>
<translation id="5039671129725402518">‏השבתת הפעילות של João Browser ברקע לאפליקציות</translation>
<translation id="80790299200510644">חיפוש באמצעות תמונות</translation>
<translation id="8086881907087796310">ההתקנה נכשלה כי המחשב לא עומד בדרישות החומרה המינימליות.</translation>
<translation id="8096472344908884505">‏<ph name="PAGE_TITLE" /> –‏ Google Chrome for Testing</translation>
<translation id="2430877582155731716">‏נדרשת הרשאת מיקום ב-João Browser עבור האתר הזה</translation>
<translation id="8298045348217323">‏בפתיחה הבאה של João Browser במכשיר <ph name="DEVICE_TYPE" />, תופיע הנחיה להפעיל התראות על מעקב מחירים.</translation>
<translation id="3827347991254458074">‏התראות על ירידות מחירים של פריטים שמעניינים אותך מחכות לך באפליקציית João Browser בטלפון</translation>
<translation id="8118331347066725040">‏שליחת משוב על חיפוש באמצעות Lens</translation>
<translation id="2580039965224265556">‏רוצה ש-João Browser יתאים לך בול?</translation>
<translation id="8133124826068723441">‏לא בוצע סנכרון של הנתונים ב-ChromiumOS כי אפשרות הסנכרון לא זמינה עבור הדומיין שלך.</translation>
<translation id="813913629614996137">מתבצע אתחול...</translation>
<translation id="7940955011992997426">‏אפשר לפתוח את Gemini ב-João Browser באמצעות מקש קיצור.</translation>
<translation id="7560319627203819845">‏תנאים והגבלות נוספים של João Browser</translation>
<translation id="7133741820744999589">‏João Browser‏ חסם את הקובץ הזה כי הוא מסוכן.</translation>
<translation id="8177472873527554730">לא נמצא תוכן בדף</translation>
<translation id="8200109504272824693">‏כדי להשתמש בנתונים של Chromium ולשמור אותם בחשבון <ph name="USER_EMAIL" />, צריך להזין את ביטוי הסיסמה</translation>
<translation id="820759916613250543">חיפוש בתמונה בעזרת "חיפוש תמונות"</translation>
<translation id="8221491193165283816">הבחירה שלך היא בדרך כלל לחסום התראות. כדי לאפשר לאתר הזה להציג התראות יש ללחוץ כאן.</translation>
<translation id="8223363452568144035">‏כדי להשתמש במצלמה, צריך להיכנס אל <ph name="BEGIN_LINK" />הגדרות המערכת<ph name="END_LINK" /> ולתת ל-Chromium גישה</translation>
<translation id="8132864687089402359">‏‫João Browser לא יכול לאמת את מקור התוסף הזה ויכול להיות שהוא לא בטוח. צריך להסיר אותו מ-João Browser כדי לא לאפשר לו יותר לראות ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="7600652022483599804">‏אם אין לתמונה תיאור מועיל, João Browser ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל Google. אפשר להשבית את האפשרות הזו בכל זמן דרך ההגדרות.</translation>
<translation id="8703735741562140394">‏להיכנס ל-João Browser עם פרופיל חדש?</translation>
<translation id="2830039647655087365">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-João Browser בתור <ph name="USER_EMAIL_ADDRESS" />. הסיסמאות שלך ופרטים נוספים יופיעו במכשיר <ph name="DEVICE" />.</translation>
<translation id="1802935470126307750">‏הצגת Gemini ב-João Browser במגש המערכת והפעלת מקשי הקיצור</translation>
<translation id="8286943863733751221">‏<ph name="BEGIN_LINK" />ב-Chromium מוצגות אזהרות<ph name="END_LINK" /> מפני הורדות ואתרים לא בטוחים</translation>
<translation id="8295827201165805317">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאה "<ph name="PERMISSION" />" הוסרה על ידי Chromium.</translation>
<translation id="481989138594406896">‏אפשר לקנות, לתרגם ולזהות את מה שרואים במצלמה באפליקציית João Browser ל-iOS</translation>
<translation id="5242426961520127942">‏קוד QR לכניסה אל João Browser בתור <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">שגיאת הפעלה: <ph name="STARTUP_ERROR" />.</translation>
<translation id="3644336211313412429">‏לפי הגדרת הארגון, João Browser נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8321888067342493336">שמירה כתמונה</translation>
<translation id="3150519286474936594">‏בכתובת <ph name="USER_EMAIL_ADDRESS" /> השתמשו בעבר ב-João Browser</translation>
<translation id="8351551329754447960">‏הפעלה של מיומנויות ב-Chromium</translation>
<translation id="4566781614303801262">‏כדי להמשיך להשתמש בנתונים של João Browser בחשבון שלך ב-Google (<ph name="ACCOUNT_EMAIL" />), צריך לעדכן את João Browser</translation>
<translation id="8404636483124146663">‏כדי לקבל עדכונים של João Browser בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.</translation>
<translation id="8362914115861174987">תרגום ל</translation>
<translation id="8367705492654390392">אפשר לשאול הכל</translation>
<translation id="8370517070665726704">‏Copyright <ph name="YEAR" /> Google LLC.‎ כל הזכויות שמורות.</translation>
<translation id="8954225380790220359">‏כדי לקבל גישה לסיסמאות ולנתונים נוספים בכל המכשירים שלך, כדאי להיכנס ל-João Browser. לאחר הכניסה, הסיסמה הזו תישמר בחשבון שלך ב-Google.</translation>
<translation id="208035402574338948">‏לאחר מכן יהיה עליך להפעיל מחדש את João Browser.</translation>
<translation id="7458698097055456629">‏ההמלצה של João Browser היא להסיר אותו. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" /></translation>
<translation id="3428558977667883100">‏הפרסום של התוסף הזה בוטל על ידי המפתח שלו, ויכול להיות שהתוסף לא בטוח. צריך להסיר אותו מ-João Browser כדי לא לאפשר לו יותר להציג ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="5012944467031125860">‏‫João Browser צריך לאמת את הזהות שלך לפני שאפשר יהיה לשמור חלק מהנתונים בחשבון Google ולהשתמש בהם בכל המכשירים שלך. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו.</translation>
<translation id="8822543678238892300">{0,plural, =1{‏צריך להפעיל מחדש את João Browser בתוך יום אחד}one{‏צריך להפעיל מחדש את João Browser בתוך # ימים}two{‏צריך להפעיל מחדש את João Browser בתוך # ימים}other{‏צריך להפעיל מחדש את João Browser בתוך # ימים}}</translation>
<translation id="8438543370129609977">‏כשמשתמשים בתכונה 'חיפוש תמונות', כותרת הדף, כתובת ה-URL והתוכן שלו, כולל קובצי PDF, נשלחים לשרת. <ph name="LEARN_MORE" /></translation>
<translation id="4307944272317199640">‏מידע נוסף על חיפוש באמצעות התכונה "חיפוש תמונות" ב-João Browser</translation>
<translation id="6024135746436350583">‏הארכיון של המתקין פגום או שאינו חוקי. יש להוריד שוב את João Browser.</translation>
<translation id="4933173390191738516">‏כדי להשתמש ב-João Browser נדרש Windows מגרסה 10 ואילך.</translation>
<translation id="8463672209299734063">‏אופציונלי: שליחה אוטומטית של נתוני אבחון ונתוני שימוש במכשיר אל Google תעזור לשפר את התכונות ואת הביצועים של ChromiumOS.</translation>
<translation id="4499703930846496679">‏כדי להשתמש בנתוני João Browser ולשמור אותם בחשבון Google, עליך לאמת את הזהות שלך</translation>
<translation id="8482493977473846331">‏הצגת פרומפטים לצורך כניסה אל Chromium</translation>
<translation id="2129903037617090425">‏João Browser אינו מעודכן</translation>
<translation id="850264194101621529">‏תודה שבחרת ב-Chromium כדפדפן ברירת המחדל שלך!</translation>
<translation id="8522801943730206384">‏ל-Chromium יש אפשרות לבדוק את הסיסמאות שלך רק אם שמרת אותן</translation>
<translation id="8525579356836940628">ההתקנה נעצרה</translation>
<translation id="2445505893586445499">‏כשאפליקציית João Browser מותקנת במכשיר <ph name="DEVICE_TYPE" /> שלך, הסיסמאות, הכרטיסיות ופריטים נוספים הולכים איתך לכל מקום</translation>
<translation id="8548787790260785208">‏אפשר לקבל אזהרה אם Chromium ימצא שאחת מהסיסמאות שלך דלפה בגלל פרצה באבטחת מידע</translation>
<translation id="8555465886620020932">שגיאה בשירות: <ph name="SERVICE_ERROR" />.</translation>
<translation id="8871890913961794658">‏חלק מהתכונות והתוספים של João Browser מגיעים עם מקשי קיצור. אפשר להפעיל אותם מחדש.</translation>
<translation id="8556420416730706394">אפשר להצמיד את התכונה 'חיפוש תמונות' כדי לאפשר גישה נוחה: פשוט לוחצים על הכפתור 'הצמדה' בחלק העליון של החלונית הצדדית</translation>
<translation id="856656450041460113">רשימת שפות לחיפוש</translation>
<translation id="9044172203094901282">‏מספר ארגונים מנהלים את João Browser</translation>
<translation id="8586442755830160949">‏Copyright <ph name="YEAR" /> The Chromium Authors. כל הזכויות שמורות.</translation>
<translation id="8601359445272098721">חדש! אפשר לתרגם טקסט ותמונות במסך באמצעות לחיצה על הכפתור "תרגום המסך"</translation>
<translation id="1071663705626404814">‏הפעלת João Browser מתבצעת...</translation>
<translation id="8624541899164515475">הגדרות, ייפתחו בכרטיסייה חדשה.</translation>
<translation id="8648201657708811153">‏לא ניתן להגדיר את Google Chrome for Testing כדפדפן ברירת המחדל.</translation>
<translation id="5975137268566279898">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את João Browser או מבצעים חיפוש מסרגל הכתובות.</translation>
<translation id="6358904712334248114">‏זהו ה-João Browser שלך</translation>
<translation id="8712637175834984815">הבנתי</translation>
<translation id="5380190167074430719">‏להיכנס אל João Browser?</translation>
<translation id="8747073452963259673">‏הפינה השמאלית התחתונה של אזור החיפוש: ‎<ph name="LEFT" />%‎ משמאל, ‎<ph name="BOTTOM" />%‎ מלמטה</translation>
<translation id="878572486461146056">שגיאת התקנה: מנהל הרשת החיל מדיניות קבוצתית שמונעת את ההתקנה: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">אני רוצה לקבל תזכורת אחר כך</translation>
<translation id="8871607387186266158">‏כדי לקבל סקירה כללית זריזה ולשאול שאלות המשך, אפשר לשתף את המסמך הזה עם Gemini ב-João Browser</translation>
<translation id="3009329613270131861">‏להיכנס אל João Browser?</translation>
<translation id="8823401858233292222">‏הגדרת Chromium כדפדפן ברירת המחדל והצמדה שלו לסרגל המשימות</translation>
<translation id="8826492472752484139">לוחצים על 'מנהל הסיסמאות'</translation>
<translation id="8833697763442816810">‏מערכת ChromiumOS</translation>
<translation id="8852026904190808918">‏זו השפה שבה מוצגים תפריטים, הגדרות, התראות וטקסטים אחרים ב-Chromium</translation>
<translation id="8862326446509486874">אין לך זכויות שמתאימות להתקנה ברמת המערכת. יש לנסות להפעיל שוב את המתקין כמנהל מערכת.</translation>
<translation id="6821836710312478344">‏הוספת פרופיל João Browser</translation>
<translation id="5139769635207740615">‏הנתונים מ-João Browser לא נשמרו בחשבון Google שלך ב-ChromiumOS בגלל שגיאה בתהליך הכניסה</translation>
<translation id="6814613825007700341">‏לפי דרישת הארגון שלך, עליך להיכנס לחשבון ב-João Browser</translation>
<translation id="1009831347869773172">‏João Browser מנסה להציג סיסמאות. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="690637523240192979">‏‫João Browser כבר לא מוגדר כדפדפן ברירת המחדל שלך. אני רוצה ש-João Browser יהיה דפדפן ברירת המחדל</translation>
<translation id="225046375773654931">‏לא ניתן לעדכן את João Browser</translation>
<translation id="8944232836376404813">‏בעקבות האיפוס:
          <ph name="LINE_BREAKS" />
            • יתאפסו דף הפתיחה, דף הכרטיסייה החדשה, מנוע החיפוש והכרטיסיות המוצמדות
            <ph name="LINE_BREAK" />
            • התוספים יושבתו
            <ph name="LINE_BREAK" />
            • יימחקו קובצי Cookie ונתונים זמניים אחרים מאתרים
            <ph name="LINE_BREAKS" />
            לא תהיה השפעה על הסימניות, ההיסטוריה והסיסמאות השמורות.</translation>
<translation id="4349474976990059197">‏הלוגו של João Browser Enterprise</translation>
<translation id="3227699293368317033">‏עם אפליקציית João Browser במכשיר <ph name="DEVICE_TYPE" />, תכונות הבטיחות של Google הולכות איתך לכל מקום</translation>
<translation id="6527164294507620103">‏אי אפשר להפעיל את João Browser בגלל שמשהו השתבש בפתיחת הפרופיל. כדאי לנסות להפעיל מחדש את João Browser.</translation>
<translation id="6741767563284518125">‏ניהול הפרופילים ב-João Browser</translation>
<translation id="3101491883380219087">‏כדי לעבור בין Gemini ב-João Browser לבין הכרטיסייה הפתוחה, אפשר להשתמש במקלדת.</translation>
<translation id="9018218886431812662">ההתקנה הושלמה</translation>
<translation id="3370247132646333337">‏כדי לשפר את האבטחה של João Browser, השבתנו את התוסף הבא שאינו רשום ב-<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> וייתכן שנוסף ללא ידיעתך.</translation>
<translation id="1940116386572548863">‏כניסה אל João Browser</translation>
<translation id="8381652653666868014">‏‫João Browser חסם את ההורדה הזו כי קובץ הארכיון כולל קבצים אחרים שעלולים להסתיר תוכנות זדוניות</translation>
<translation id="8374335201144490555">‏רוצה לסנכרן את הסיסמאות, הסימניות וההיסטוריה שלך באופן מושלם בין המכשירים? כדי להשתמש בקלות בתכונות המוכרות והאהובות, צריך לעדכן את דפדפן ברירת המחדל ל-João Browser. לגישה מהירה, João Browser יוצמד לסרגל האפליקציות.</translation>
<translation id="6176486087616698123">‏רוצה להשתמש בכלי ה-AI הטובים ביותר של Google? כשאפליקציית João Browser מותקנת בטלפון שלך זה אפשרי</translation>
<translation id="9062666675513499497">‏כניסה אל Chromium כשנכנסים לשירותי Google אחרים</translation>
<translation id="724802823738504651">‏João Browser נסגר באופן אוטומטי</translation>
<translation id="2689333215784698609">‏João Browser אינו מעודכן</translation>
<translation id="8049510467237146160">{0,plural, =1{‏João Browser יופעל מחדש בעוד שעה}one{‏João Browser יופעל מחדש בעוד # שעות}two{‏João Browser יופעל מחדש בעוד # שעות}other{‏João Browser יופעל מחדש בעוד # שעות}}</translation>
<translation id="9106236359747881194">אפשר לבחור טקסט לחיפוש</translation>
<translation id="8558551666630075184">‏כדי לקבל עדכונים של João Browser בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.1.</translation>
<translation id="1194819784870407331">‏פתיחת הקישור &amp;בכרטיסיית João Browser חדשה</translation>
<translation id="911206726377975832">למחוק גם את נתוני הגלישה שלך?</translation>
<translation id="9134482777260927479">עזרה בשיעורי הבית</translation>
<translation id="9148058034647219655">יציאה</translation>
<translation id="548951409840319583">‏רוצה להמשיך מהמקום שבו הפסקת? João Browser יכול לשחזר את הכרטיסיות שלך בכל הפעלה מחדש. כדי להפעיל את האפשרות הזו, צריך לעבור אל</translation>
<translation id="7614949510548815395">‏לפי הגדרת מנהל המערכת, João Browser יפתח דפדפן חלופי כדי לגשת אל <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="3441698750089879771">‏הפעלה מחדש לצורך עדכון &amp;João Browser</translation>
<translation id="369689859238510548">‏João Browser ‏(mDNS-In)</translation>
<translation id="8336832914816665097">‏אפשר להתאים אישית את João Browser בדרך שנוחה לך</translation>
<translation id="7698429329590050365">‏ייתכן ש-João Browser לא יפעל כראוי כי הוא כבר לא נתמך ב-Windows XP וב-Windows Vista</translation>
<translation id="190261805571697214">‏עם João Browser אפשר ליהנות מתכונות הבטיחות הכי טובות של Google.</translation>
<translation id="945522503751344254"> שליחת משוב</translation>
<translation id="5554799509799759090">‏מי משתמש/ת ב-João Browser?</translation>
<translation id="9153108844196984904">‏רוצה להשיג את רמת האבטחה הגבוהה ביותר של João Browser?</translation>
<translation id="983803489796659991">‏ההתקנה נכשלה כי שרת העדכון לא מכיל נתוני גיבוב (hash) של האפליקציה.</translation>
<translation id="6230710687825107323">‏שימוש ב-João Browser ללא חשבון</translation>
<translation id="985602178874221306">‏מחברי Chromium</translation>
<translation id="989970834842471429">אפשר לבחור טקסט או תמונה לחיפוש באמצעות התכונה "חיפוש תמונות"</translation>
<translation id="992780518932311116">‏כדי להשתמש בשירותי המיקום, צריך להיכנס אל <ph name="BEGIN_LINK" />הגדרות המערכת<ph name="END_LINK" /> ולתת ל-Chromium גישה</translation>
</translationbundle>