<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="1026101648481255140">המשך בהתקנה</translation>
<translation id="1029669172902658969">‏הפעלה מחדש לצורך עדכון ‎&amp;ChromiumOS</translation>
<translation id="4711726241445951349">‏לפי המלצת João Browser, כדאי לבדוק את התוסף הזה</translation>
<translation id="1042552502243217427">‏כשאתר מבקש לטעון מראש קישורים בדף שלו באופן פרטי, מערכת Chromium משתמשת בשרתי Google. כך מוסתרת הזהות שלך מהאתר שנטען מראש, אבל Google יכולה לדעת אילו אתרים נטענים מראש.</translation>
<translation id="1051793555070215510">מילוי הסקר הזה ייקח רק דקה ויעזור לנו לשפר את המצב הפרטי.</translation>
<translation id="1065672644894730302">לא הייתה אפשרות לקרוא את ההעדפות שלך. ייתכן שחלק מהתכונות לא יהיו זמינות ושינויים בהעדפות לא יישמרו.</translation>
<translation id="3937976866851867994">‏ההורה שלך השבית ב-João Browser את ההגדרה 'הרשאות לאתרים, לאפליקציות ולתוספים'</translation>
<translation id="8626021334348319355">‏כדי לחפש תכונה או תוסף ספציפיים של João Browser, אפשר להקליד את השם המקוצר שלהם בסרגל הכתובות ואז ללחוץ על מקש המקלדת שנבחר</translation>
<translation id="9157778882771986870">‏João Browser רוצה לייצא את הסיסמאות שלך. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="112640046208448578">אפשר לנסות לזהות דברים או מקומות ולהעתיק או לתרגם טקסטים. כשמשתמשים בחיפוש תמונות, צילום מסך של הדף נשלח לשרת. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">‏Chromium מוגדר כדפדפן ברירת המחדל</translation>
<translation id="1131805035311359397">‏כדי לבדוק אם שאר הסיסמאות מוגנות מפני פרצות באבטחת מידע ובעיות אבטחה אחרות, <ph name="BEGIN_LINK" />יש להיכנס ל-Chromium<ph name="END_LINK" />.</translation>
<translation id="2795895511109336240">‏לוחצים על תפריט João Browser</translation>
<translation id="1157985233335035034">שפות אחרונות</translation>
<translation id="1184145431117212167">‏ההתקנה נכשלה כי הגרסה של Windows לא נתמכת.</translation>
<translation id="1185134272377778587">‏על Chromium</translation>
<translation id="667420476518265356">‏רוצה לקבל התראות על מעקב מחירים באמצעות João Browser בטלפון?</translation>
<translation id="1203500561924088507">תודה שהתקנת. עליך להפעיל מחדש את הדפדפן לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">‏כשפותחים את חיפוש התמונות, כותרת הדף, כתובת ה-URL והתוכן שלו, כולל קובצי PDF, נשלחים באופן אוטומטי לשרת. <ph name="LEARN_MORE" /></translation>
<translation id="3667545935184141183">‏אחרי הכניסה לחשבון, אפשר להשתמש בסיסמאות ובפרטים נוספים מחשבון Google ב-João Browser. כדי לשנות את האפשרות הזאת, כדאי לעבור אל "החשבון שלך ב-João Browser".</translation>
<translation id="4866003137980530528">‏הצגת Gemini ב-João Browser בסרגל התפריטים של Mac</translation>
<translation id="2526294198551578217">‏כדי לבחור חלק מהמסך ב-Gemini ב-João Browser צריך להשתמש במקש קיצור.</translation>
<translation id="7068536367561625920">‏בזמן שהכרטיסייה הזו לא הייתה פעילה, התפנה זיכרון כדי ש-João Browser ימשיך לפעול במהירות. ניתן לבחור להחריג תמיד את האתר הזה כדי שיישאר במצב פעיל.</translation>
<translation id="3669854427836618143">‏João Browser חסם את ההורדה הזאת כי הקובץ מסוכן</translation>
<translation id="126567311906253476">‏כשנכנסים לשירותי Google כמו Gmail או YouTube עם <ph name="USER_EMAIL" />, אפשר להיכנס אוטומטית ל-Chromium עם אותו חשבון</translation>
<translation id="8094399825947986050">‏הורדת João Browser לטלפון</translation>
<translation id="1290883685122687410">שגיאה בהגדרה: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="7781635806686712111">‏הגדרת הפרופיל החדש שלך ב-João Browser</translation>
<translation id="7591029065989504977">‏כדאי לנסות את Gemini ב-João Browser</translation>
<translation id="8408989583029959522">‏ל-João Browser נדרשת גישה ל-Bluetooth כדי למצוא&#32;
 מכשירי Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="4407260690215472946">‏כניסה ל-João Browser בטלפון</translation>
<translation id="1330562121671411446">זיהוי שפה אוטומטי</translation>
<translation id="6026568602942276348">‏אני רוצה למחוק את הנתונים גם מ-João Browser (<ph name="URL" />)</translation>
<translation id="1345251407431278948">התכונה הוצמדה. מעכשיו אפשר לגשת לחיפוש התמונות דרך הכפתור החדש בסרגל הכלים</translation>
<translation id="1356661055722410047">חדש! אפשר לתרגם טקסט ותמונות במסך</translation>
<translation id="1383876407941801731">חיפוש</translation>
<translation id="5807085300679014096">‏עם אפליקציית João Browser אפשר להמשיך לגלוש בכל מקום</translation>
<translation id="141901961143729572">כאן אפשר לשתף את המחשבות שלך</translation>
<translation id="3736947618013031173">‏כדי לשתף את החלון, צריך לאפשר הקלטת מסך ב-João Browser בקטע "הגדרות המערכת".</translation>
<translation id="1478370723027452770">‏קבלת עזרה לגבי Chrome for Testing</translation>
<translation id="1497802159252041924">שגיאת התקנה: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">הדף הזה מוגן</translation>
<translation id="4379865404970367448">‏שיתוף כרטיסיית João Browser</translation>
<translation id="4436275659297289591">‏כניסה ל-João Browser</translation>
<translation id="1547469039832541117">סיום המשימה המודגשת.</translation>
<translation id="449712764049695153">‏הצמדת João Browser</translation>
<translation id="1574377791422810894">‏הכלים לבטיחות של Chromium</translation>
<translation id="5480232403718129394">‏‫João Browser רוצה למחוק את הנתונים שלך במנהל הסיסמאות. כדי לאפשר זאת, צריך להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="5374513512130831872">{COUNT,plural, =0{‏מנהל המערכת מבקש להפעיל מחדש את João Browser כדי להחיל עדכון}=1{‏מנהל המערכת מבקש להפעיל מחדש את João Browser כדי להחיל עדכון. החלון האנונימי לא ייפתח מחדש.}one{‏מנהל המערכת מבקש להפעיל מחדש את João Browser כדי להחיל עדכון. # החלונות האנונימיים לא ייפתחו מחדש.}two{‏מנהל המערכת מבקש להפעיל מחדש את João Browser כדי להחיל עדכון. # החלונות האנונימיים לא ייפתחו מחדש.}other{‏מנהל המערכת מבקש להפעיל מחדש את João Browser כדי להחיל עדכון. # החלונות האנונימיים לא ייפתחו מחדש.}}</translation>
<translation id="980976428162070137">‏מיטב הטכנולוגיות של Google אצלך בידיים עם אפליקציית João Browser לטלפון</translation>
<translation id="1625909126243026060">‏בדיקה של אמצעי הבקרה החשובים ביותר על פרטיות ואבטחה ב-Chromium</translation>
<translation id="1640672724030957280">מוריד...</translation>
<translation id="1665602916345474427">נכנסת בתור <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, עם מינוי. פתיחת תפריט החשבון</translation>
<translation id="1708414395296835197">‏אפשר להשתמש ב-Chromium בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות. הדפדפן גם יוצמד לסרגל האפליקציות.</translation>
<translation id="1709772298389099340">השירות הזה מספק הרשאות מורחבות ל-<ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">כך תהיה לך אפשרות לבחור מבין המכשירים הזמינים ולהציג בהם תוכן.</translation>
<translation id="6972087163510342335">‏נתוני הגלישה ב-João Browser יימחקו בקרוב</translation>
<translation id="1736443181683099871">‏Chromium ינסה לשדרג את הניווטים ל-HTTPS</translation>
<translation id="3879288383593333401">‏נתוני João Browser נמחקו</translation>
<translation id="656496276885630888">‏João Browser יופעל מחדש בעוד <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">‏כש-HTTPS לא יהיה זמין, Chromium ישתמש בחיבור לא מאובטח בלי להציג אזהרה</translation>
<translation id="1226290419185955779">‏התרה ל-João Browser לפעול ברקע</translation>
<translation id="4231366995273072370">‏כדי לשפר את האבטחה של João Browser, השבתנו חלק מהתוספים שלא רשומים ב<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> וייתכן שנוספו ללא ידיעתך.</translation>
<translation id="1822049153969905781">‏כדי להצמיד את João Browser לסרגל האפליקציות לגישה מהירה, צריך ללחוץ על <ph name="BEGIN_BOLD" />כן<ph name="END_BOLD" /> בהתראה של Windows.</translation>
<translation id="1321831992638405531">‏התקנת João Browser מחדש</translation>
<translation id="3386967202064865436">‏João Browser מנסה <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="70054449700528483">‏בפעם הבאה ש-João Browser ייפתח במכשיר <ph name="DEVICE_TYPE" />, תופיע הנחיה להשתמש במנהל הסיסמאות של Google.</translation>
<translation id="1838374766361614909">ניקוי חיפוש</translation>
<translation id="5807096362853316123">‏כדי למחוק את נתוני הגלישה מהמכשיר הזה בלבד ועדיין לשמור אותם בחשבון שלך ב-Google, <ph name="BEGIN_LINK" />עליך לצאת מהחשבון ב-João Browser<ph name="END_LINK" />.</translation>
<translation id="6396384011117650379">‏כדי לפתוח או ליצור קבוצות חדשות של כרטיסיות תוך כדי תנועה, כדאי להוריד את João Browser לטלפון שלך.</translation>
<translation id="185970820835152459">‏יש לך אפשרות לנהל את חשבונות Google שאליהם נכנסת. כדי ליהנות מחיבור לחשבון בדפדפן Chromium, בחנות Play, ב-‏Gmail ובשירותים נוספים, עליך להיכנס עם חשבונות Google שלך. כדי להוסיף חשבון של מישהו אחר, כמו חבר/ה בקבוצה המשפחתית, יש להוסיף משתמש חדש ל-<ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />מידע נוסף<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">חיפוש באמצעות התכונה 'חיפוש תמונות'</translation>
<translation id="65457771685016683">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-João Browser בתור <ph name="USER_EMAIL_ADDRESS" />. הסימניות ופריטים נוספים יופיעו במכשיר <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">בחירת טקסט</translation>
<translation id="2634119629547215883">‏נכנסת עם חשבון מנוהל שנותן למנהל המערכת שלו שליטה על הפרופיל שלך ב-João Browser. הנתונים שלך ב-João Browser, כגון אפליקציות, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME" />. ניתן למחוק את הנתונים האלה באמצעות לוח הבקרה של חשבונות Google, אבל אי אפשר לשייך את הנתונים האלה לחשבון אחר. לחלופין, באפשרותך ליצור פרופיל חדש כדי לשמור את הנתונים הקיימים שלך ב-João Browser בנפרד.<ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">‏‫Chromium חוסך בחיי הסוללה על ידי הגבלת הפעילות ברקע והאפקטים החזותיים, כמו גלילה חלקה וקצב פריימים של סרטונים. <ph name="BEGIN_LINK" />מידע נוסף על מצב חיסכון באנרגיה<ph name="END_LINK" /></translation>
<translation id="6115114251350798456">‏שירות לעדכון של João Browser</translation>
<translation id="1911763535808217981">‏כיבוי הגדרה זו יאפשר לך להיכנס לאתרי Google, כמו Gmail, בלי להיכנס אל Chromium</translation>
<translation id="4037729269678342163">‏João Browser אינו מגיב. להפעיל מחדש עכשיו?</translation>
<translation id="7563750688920581112">‏לפי דרישת הארגון שלך, <ph name="MANAGER" />, עליך להיכנס לחשבון ב-João Browser</translation>
<translation id="193439633299369377">‏צריך להפעיל מחדש את ChromiumOS כדי להחיל את העדכון הזה.</translation>
<translation id="7099143775283792684">‏João Browser חסם את ההורדה הזאת כי לרוב לא מתבצעת הורדה של קבצים מהסוג הזה ויכול להיות שהקובץ מסוכן</translation>
<translation id="1953553007165777902">מתבצעת הורדה… יש עוד <ph name="MINUTE" /> דק'</translation>
<translation id="1966382378801805537">‏ב-Chromium לא ניתן לקבוע או להגדיר את דפדפן ברירת המחדל</translation>
<translation id="197326043290947695">גלישה חכמה יותר עם "חיפוש תמונות"</translation>
<translation id="6185556991023272801">‏מידע על חסימה של קבצים מסוימים ב-João Browser, נפתח בכרטיסייה חדשה</translation>
<translation id="4053636705816895911">‏השירות הזה שומר על תוכנת João Browser עדכנית. אם השירות הזה מושבת או מופסק, תוכנת João Browser לא תתעדכן באופן קבוע. כתוצאה מכך, לא ניתן יהיה לתקן פרצות אבטחה שעלולות להיווצר, וייתכן שחלק מהתכונות לא יפעלו. השירות הזה יוסר באופן אוטומטי אם אין תוכנת João Browser שמשתמשת בו.</translation>
<translation id="2008474315282236005">‏הפעולה הזו תמחק פריט אחד מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, היכנס אל Chromium עם <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">ההתקנה נכשלה. יש לנסות שוב.</translation>
<translation id="2039417478970545937">הגדרות.</translation>
<translation id="2049376729098081731">‏בוחרים אם לכלול את ההיסטוריה ב-Chromium להתאמה אישית מדויקת יותר בשירותי Google</translation>
<translation id="6768767091114123654">‏מנהל הסיסמאות מובנה ב-João Browser ומאפשר לך ליצור סיסמאות חזקות, לשמור אותן ולמלא אותן אוטומטית. כדי להגיע אליו בקלות, אפשר להוסיף את קיצור הדרך.</translation>
<translation id="3571664229232252557">‏אפשר ללחוץ על הכפתור "התאמה אישית של João Browser" בדף הכרטיסייה החדשה כדי לשנות את המראה שלו</translation>
<translation id="4273287215573278663">‏João Browser חסם את ההורדה הזאת כי הקובץ מטעה ועשוי לבצע שינויים לא צפויים במכשיר שלך</translation>
<translation id="9063967192437499581">‏בפעם הבאה ש-João Browser ייפתח ב-iOS, תופיע הנחיה לנסות את <ph name="FEATURE_NAME" />.</translation>
<translation id="8511569826706775962">‏הסיסמאות ונתונים אחרים מ-João Browser ששמרת בחשבון שלך ב-Google יוסרו מהמכשיר הזה. כדי להשתמש בהם שוב ב-João Browser, צריך להיכנס בחזרה לחשבון.</translation>
<translation id="1187540878814389979">{COUNT,plural, =1{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-João Browser במשך דקה. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}one{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-João Browser במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}two{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-João Browser במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}other{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-João Browser במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}}</translation>
