<translation id="2190166659037789668">השגיאה בבדיקת העדכון: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="3486802320473595711">‏הסרת החשבון מ-João Browser</translation>
<translation id="4648870374540039667">‏עם אפליקציית João Browser אפשר ליהנות מהכלים הכי טובים לשופינג בכל מקום</translation>
<translation id="2106116820042118250">‏אפשר ליהנות מאינטרנט בטוח יותר בכל מקום עם הגרסה המשופרת של גלישה בטוחה ב-João Browser ל-iOS</translation>
<translation id="2210682093923538346">‏אתר מסוכן. ‫Chromium הסיר את ההתראות.</translation>
<translation id="2236949375853147973">הפעילות שלי</translation>
<translation id="118764235932893741">‏כדי לקבל גישה לכתובות ולנתונים נוספים בכל המכשירים שלך, כדאי להיכנס ל-João Browser. לאחר הכניסה, הכתובת הזו תישמר בחשבון שלך ב-Google.</translation>
<translation id="7254578863532089400">‏אם משתפים מחשב, חברים ובני משפחה יכולים לגלוש בנפרד ולהגדיר את João Browser בדיוק כפי שהם רוצים.</translation>
<translation id="22571759390241347">‏מיומנויות ב-Chromium</translation>
<translation id="2283803047247799269">חיפוש הכרטיסייה הזו באמצעות התכונה "חיפוש תמונות"</translation>
<translation id="8383041367037966133">{NUM_TABS,plural, =1{‏ההמלצה של João Browser היא להשהות את הכרטיסייה שמאטה את הדפדפן}one{‏ההמלצה של João Browser היא להשהות את הכרטיסיות שמאטות את הדפדפן}two{‏ההמלצה של João Browser היא להשהות את הכרטיסיות שמאטות את הדפדפן}other{‏ההמלצה של João Browser היא להשהות את הכרטיסיות שמאטות את הדפדפן}}</translation>
<translation id="2307973900865360088">‏אני רוצה להשאיר את Chromium ב-Dock</translation>
<translation id="2313870531055795960">‏המערכת בודקת כתובות URL בעזרת רשימה של אתרים לא בטוחים ששמורה ב-Chromium. אם באתר כלשהו מתבצע ניסיון לגנוב את הסיסמה שלך, או אם המערכת מזהה הורדה של קובץ מזיק, Chromium עשוי גם לשלוח כתובות URL לבדיקה באמצעות 'גלישה בטוחה'. הנתונים שנשלחים לבדיקה כוללים ביטים מתוכן של דפים.</translation>
<translation id="2356070529366658676">לשאול</translation>
<translation id="2359808026110333948">המשך</translation>
<translation id="3800730051093461113">‏התוסף "<ph name="EXTENSION_NAME" />" מבקש ממך להיכנס ל-João Browser</translation>
<translation id="8758735062658446604">‏השבתת הפעילות של João Browser ברקע לאפליקציות</translation>
<translation id="2623595027619107207">‏כדי להשתמש בתוסף הזה בתור <ph name="USER_EMAIL_ADDRESS" />, עליך להיכנס ל-João Browser.</translation>
<translation id="2384373936468275798">‏לא בוצע סנכרון של הנתונים שלך ב-ChromiumOS כי פרטי הכניסה לחשבון לא מעודכנים.</translation>
<translation id="5930179096923499335">{NUM_DEVICES,plural, =0{‏תוסף אחד לפחות ל-João Browser ניגש למכשיר ממשק אנושי (HID) אחד}=1{‏תוסף אחד לפחות ל-João Browser ניגש למכשיר ממשק אנושי (HID) אחד}one{‏תוסף אחד לפחות ל-João Browser ניגש ל-# מכשירי ממשק אנושי (HID)}two{‏תוסף אחד לפחות ל-João Browser ניגש ל-# מכשירי ממשק אנושי (HID)}other{‏תוסף אחד לפחות ל-João Browser ניגש ל-# מכשירי ממשק אנושי (HID)}}</translation>
<translation id="6254788431480237503">‏נדרשות הרשאות גישה למצלמה ולמיקרופון ב-João Browser עבור האתר הזה</translation>
<translation id="2403703063067034158">שגיאה בזמן ההפעלה: יש עוד הגדרה שפועלת כרגע. אפשר לנסות שוב מאוחר יותר.</translation>
<translation id="3028975423343897358">‏הגדרת João Browser כברירת מחדל מאפשרת לפתוח קישורים מכל אפליקציה ולהשאיר את הדפדפן נגיש בסרגל האפליקציות</translation>
<translation id="579079006139156831">‏כדי לקבל סקירה כללית מהירה ולשאול שאלות המשך, אפשר ללחוץ על כפתור הסיכום ולשתף את המסמך הזה עם Gemini ב-João Browser.</translation>
<translation id="2440750600860946460">‏בעזרת <ph name="BEGIN_LINK" />הכלים של Chromium<ph name="END_LINK" /> אפשר לגלוש בבטחה ובשליטה</translation>
<translation id="7114471809991869757">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-João Browser בתור <ph name="USER_EMAIL_ADDRESS" />. הסיסמאות ופריטים נוספים יופיעו בכל המכשירים שלך.</translation>
<translation id="2451727308784734061">באמצעות קיצורי הדרך אפשר להגיע מהר למנהל הסיסמאות. ניתן להעביר את קיצור הדרך למרכז האפליקציות או למסך הבית של המחשב.</translation>
